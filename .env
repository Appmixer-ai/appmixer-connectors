# Mailerlite API Configuration
# Replace 'your_actual_mailerlite_token_here' with your real Mailerlite API token
MAILERLITE_ACCESS_TOKEN=your_actual_mailerlite_token_here

# To get your Mailerlite API token:
# 1. Log in to your Mailerlite account
# 2. Go to Integrations > Developer API
# 3. Generate a new API token
# 4. Copy the token and replace the placeholder above
