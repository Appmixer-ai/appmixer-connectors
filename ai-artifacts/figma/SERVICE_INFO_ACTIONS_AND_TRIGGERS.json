{
    "actions": [
        {
            "title": "Make API Call",
            "description": "Performs an arbitrary authorized API call to a Figma endpoint by specifying the resource, HTTP method, and any necessary request body. It can be used for custom operations that are not explicitly defined as a discrete action.",
            "type": "action",
            "documentation": "https://www.figma.com/developers/api",
            "endpointUrl": "https://api.figma.com/v1/{resource}",
            "apiBaseUrl": "https://api.figma.com/v1",
            "method": "POST",
            "sampleResponse": {},
            "inputSchema": {
                "type": "object",
                "properties": {
                    "resource": {
                        "type": "string",
                        "description": "The resource path to call, for example 'files/{file_id}' or 'teams/{team_id}/projects'."
                    },
                    "method": {
                        "type": "string",
                        "description": "HTTP method to use for the call (GET, POST, PUT, PATCH, DELETE)."
                    },
                    "body": {
                        "type": "object",
                        "description": "Optional request body to include in the API call if applicable."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Post Comment",
            "description": "Posts a comment to a specified Figma file.",
            "type": "action",
            "documentation": "https://www.figma.com/developers/api#comments-post",
            "endpointUrl": "https://api.figma.com/v1/files/{file_id}/comments",
            "apiBaseUrl": "https://api.figma.com/v1",
            "method": "POST",
            "sampleResponse": {
                "id": "c1",
                "message": "This is a comment",
                "created_at": "2020-01-01T00:00:00Z"
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "file_id": {
                        "type": "string",
                        "description": "The unique identifier of the Figma file where the comment should be posted."
                    },
                    "message": {
                        "type": "string",
                        "description": "The text content of the comment to be posted."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Find Comments",
            "description": "Fetches all comments for a given Figma file, with support for an optional search query filter.",
            "type": "action",
            "documentation": "https://www.figma.com/developers/api#comments-get",
            "endpointUrl": "https://api.figma.com/v1/files/{file_id}/comments",
            "apiBaseUrl": "https://api.figma.com/v1",
            "method": "GET",
            "sampleResponse": {
                "comments": [
                    {
                        "id": "c1",
                        "message": "Sample comment",
                        "user": {
                            "handle": "user1"
                        }
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "file_id": {
                        "type": "string",
                        "description": "The unique identifier of the Figma file whose comments are to be retrieved."
                    },
                    "query": {
                        "type": "string",
                        "description": "Optional search term to filter comments.",
                        "default": ""
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyLabel": "comments",
                "arrayPropertyValue": "comments"
            }
        },
        {
