                                        ]
                                    },
                                    "code": "// The isolate hands back only JSON-serializable primitives: return the result as a JSON string.\nJSON.stringify((function () {\n    const parse = (v) => (typeof v === 'string' ? JSON.parse(v) : v);\n    const pr = parse($data.pr) || {};\n    if (!pr.number || !pr.repository) {\n        return { label: false, reason: 'pull request not found' };\n    }\n    const ROOT = 'src/appmixer/';\n    const MAX_NAME = 50;    // GitHub's limit on a label name\n    const MAX_LABELS = 5;   // a sweep across more connectors would bury every overview it lands in\n\n    const files = ((pr.files || {}).nodes || []).map(f => f.path);\n    if ((pr.files || {}).totalCount > files.length) {\n        // Only the first page is read; labelling from part of the files could miss connectors and the MAX_LABELS cut.\n        return { label: false, reason: 'changes ' + pr.files.totalCount + ' files, more than ' + files.length + ' can be classified' };\n    }\n\n    // Bundle directories on the PR head and base: one releasable unit each, including a connector the PR adds or removes.\n    const bundleDirs = Array.from(new Set((parse($data.bundles) || []).concat(parse($data.baseBundles) || [])\n        .map(b => b.directory + '/')\n        .filter(d => d.startsWith(ROOT) && d.length > ROOT.length)));\n    const nameOf = dir => 'appmixer:' + dir.slice(ROOT.length, -1).split('/').join(':');\n    const vendorOf = dir => dir.slice(ROOT.length).split('/')[0];\n    // A vendor with a label over the limit (generated MCP server wrappers) gets one label for all its bundles.\n    const collapsed = new Set(bundleDirs.filter(d => nameOf(d).length > MAX_NAME).map(vendorOf));\n    const labelOf = dir => collapsed.has(vendorOf(dir)) ? 'appmixer:' + vendorOf(dir) : nameOf(dir);\n\n    const deepest = (dirs, file) => dirs.filter(d => file.startsWith(d)).sort((a, b) => b.length - a.length)[0];\n    const labels = new Set();\n    for (const file of files) {\n        const bundle = deepest(bundleDirs, file);\n        if (bundle) {\n            labels.add(labelOf(bundle));\n            continue;\n        }\n        // Not inside a bundle: the nearest ancestor that holds bundles is a shared root\n        // (google/auth.js, microsoft/artifacts/...), and a change there reaches all of them.\n        const parts = file.split('/');\n        for (let depth = parts.length - 1; depth > 2; depth--) {\n            const dir = parts.slice(0, depth).join('/') + '/';\n            if (bundleDirs.some(b => b.startsWith(dir))) {\n                labels.add(labelOf(dir));\n                break;\n            }\n        }\n    }\n    const list = Array.from(labels).sort();\n    if (list.length > MAX_LABELS) {\n        return { label: false, reason: 'touches ' + list.length + ' connectors, more than ' + MAX_LABELS };\n    }\n    return {\n        label: list.length > 0,\n        labels: list.join(', '),\n        url: '/repos/' + pr.repository.nameWithOwner + '/issues/' + pr.number + '/labels',\n        body: JSON.stringify({ labels: list })\n    };\n})());"
