{
    "inputSchema": {
        "type": "object",
        "properties": {
            "publicationId": {
                "type": "string",
                "description": "The prefixed ID of the publication object"
            },
            "automationId": {
                "type": "string",
                "description": "The prefixed ID of the automation object"
            },
            "Authorization": {
                "type": "string",
                "description": "Bearer authentication"
            }
        },
        "required": [
            "publicationId",
            "automationId"
        ]
    },
    "outputSchema": {
        "type": "object",
        "properties": {
            "data": {
                "type": "object",
                "required": [
                    "id",
                    "status",
                    "name",
                    "trigger_events"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The prefixed ID of the automation."
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "running",
                            "finishing",
                            "inactive",
                            "live",
                            "draft"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "trigger_events": {
                        "type": "array",
                        "description": "The types of events that can trigger the automation.",
                        "items": {
                            "type": "string",
                            "enum": [
                                "api",
                                "downgrade",
                                "email_submission",
                                "form_submission",
                                "manual",
                                "poll_submission",
                                "purchased_product",
                                "referral_action",
                                "segment_action",
                                "signup",
                                "unengaged",
                                "upgrade"
                            ]
                        }
                    },
                    "description": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
