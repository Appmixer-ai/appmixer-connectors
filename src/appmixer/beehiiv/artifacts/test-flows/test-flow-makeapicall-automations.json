{
    "name": "E2E Beehiiv - MakeAPICall Automations",
    "description": "End-to-end test for Beehiiv connector - tests ListPublications and MakeAPICallAutomations (Index3: list automations) components",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 80,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "list-publications": {
            "type": "appmixer.beehiiv.core.ListPublications",
            "x": 256,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-publication": {
            "type": "appmixer.utils.test.Assert",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-publications": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-publications": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "pub-id": {
                                            "variable": "$.list-publications.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{pub-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "make-api-call-list-automations": {
            "type": "appmixer.beehiiv.core.MakeAPICallAutomations",
            "x": 448,
            "y": 144,
            "version": "1.0.6",
            "source": {
                "in": {
                    "list-publications": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-publications": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {
                                        "var-pub-id": {
                                            "variable": "$.list-publications.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "publicationId": "{{{var-pub-id}}}"
                                }
                            }
                        }
                    }
                },
                "properties": {
                    "method": "Index3"
                }
            }
        },
        "assert-automations": {
            "type": "appmixer.utils.test.Assert",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "make-api-call-list-automations": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "make-api-call-list-automations": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "page-val": {
                                            "variable": "$.make-api-call-list-automations.out.page",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{page-val}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 832,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-publication": [
                        "out"
                    ],
                    "assert-automations": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1024,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Beehiiv - MakeAPICall Automations",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}