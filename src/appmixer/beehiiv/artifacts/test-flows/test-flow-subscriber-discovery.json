{
    "name": "E2E Beehiiv - Subscriber Discovery",
    "description": "End-to-end test for Beehiiv connector - tests subscriber discovery operations: ListSubscribers and GetSubscriberByEmail. Seeds a known subscriber, verifies listing and lookup by email, then cleans up.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "create-subscriber": {
            "type": "appmixer.beehiiv.core.CreateSubscriber",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {},
                                    "email": {},
                                    "reactivate_existing": {},
                                    "send_welcome_email": {},
                                    "tier": {}
                                },
                                "lambda": {
                                    "publicationId": "pub_3ea93462-7fa3-470b-b30b-94700321c358",
                                    "email": "e2e.discovery.test@appmixer.com",
                                    "reactivate_existing": true,
                                    "send_welcome_email": false,
                                    "tier": "free"
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-subscribers": {
            "type": "appmixer.beehiiv.core.FindSubscribers",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-subscriber": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-subscriber": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {},
                                    "limit": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "publicationId": "pub_3ea93462-7fa3-470b-b30b-94700321c358",
                                    "limit": 10,
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-subscriber-by-email": {
            "type": "appmixer.beehiiv.core.GetSubscriberByEmail",
            "x": 448,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-subscriber": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-subscriber": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {},
                                    "email": {}
                                },
                                "lambda": {
                                    "publicationId": "pub_3ea93462-7fa3-470b-b30b-94700321c358",
                                    "email": "e2e.discovery.test@appmixer.com"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list": {
            "type": "appmixer.utils.test.Assert",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-subscribers": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-subscribers": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "list-sub-id": {
                                            "variable": "$.list-subscribers.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{list-sub-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-find": {
            "type": "appmixer.utils.test.Assert",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-subscriber-by-email": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-subscriber-by-email": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "found-email": {
                                            "variable": "$.get-subscriber-by-email.out.data.email",
                                            "functions": []
                                        },
                                        "found-sub-id": {
                                            "variable": "$.get-subscriber-by-email.out.data.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{found-sub-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{found-email}}}",
                                                "assertion": "equal",
                                                "expected": "e2e.discovery.test@appmixer.com"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 832,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-list": [
                        "out"
                    ],
                    "assert-find": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-subscriber": {
            "type": "appmixer.beehiiv.core.DeleteSubscriber",
            "x": 1024,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {},
                                    "subscriberId": {
                                        "var-del-sub-id": {
                                            "variable": "$.create-subscriber.out.data.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "publicationId": "pub_3ea93462-7fa3-470b-b30b-94700321c358",
                                    "subscriberId": "{{{var-del-sub-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1216,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-subscriber": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-subscriber": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Beehiiv - Subscriber Discovery",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}