{
    "name": "E2E Beehiiv - Post Discovery",
    "description": "End-to-end test for Beehiiv connector - tests post discovery: list publications, find posts, get post detail.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "list-publications": {
            "type": "appmixer.beehiiv.core.ListPublications",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-publications": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-publications": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-publications": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-pub-id": {
                                            "variable": "$.list-publications.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-pub-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "find-posts": {
            "type": "appmixer.beehiiv.core.FindPosts",
            "x": 448,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-publications": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-publications": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {
                                        "var-pub-id": {
                                            "variable": "$.list-publications.out.id",
                                            "functions": []
                                        }
                                    },
                                    "limit": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "publicationId": "{{{var-pub-id}}}",
                                    "limit": 10,
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-find-posts": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-posts": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-posts": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-post-id": {
                                            "variable": "$.find-posts.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-post-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-post": {
            "type": "appmixer.beehiiv.core.GetPost",
            "x": 640,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-posts": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-posts": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "publicationId": {
                                        "var-pub-id": {
                                            "variable": "$.list-publications.out.id",
                                            "functions": []
                                        }
                                    },
                                    "postId": {
                                        "var-post-id": {
                                            "variable": "$.find-posts.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "publicationId": "{{{var-pub-id}}}",
                                    "postId": "{{{var-post-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get-post": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-post": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-post": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.get-post.out.data.id",
                                            "functions": []
                                        },
                                        "field-title": {
                                            "variable": "$.get-post.out.data.title",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-title}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-list-publications": [
                        "out"
                    ],
                    "assert-find-posts": [
                        "out"
                    ],
                    "assert-get-post": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Beehiiv - Post Discovery",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
