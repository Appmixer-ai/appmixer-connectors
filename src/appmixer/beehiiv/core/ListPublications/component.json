{
    "name": "appmixer.beehiiv.core.ListPublications",
    "description": "List all publications in the workspace.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Publication ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            ]
        }
    ],
    "icon": ""
}