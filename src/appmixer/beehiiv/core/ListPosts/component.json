{
    "name": "appmixer.beehiiv.core.ListPosts",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List posts for a publication.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "audience": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "number"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Filter by status.",
                        "index": 1,
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Draft",
                                "value": "draft"
                            },
                            {
                                "label": "Confirmed",
                                "value": "confirmed"
                            },
                            {
                                "label": "Archived",
                                "value": "archived"
                            }
                        ]
                    },
                    "audience": {
                        "type": "select",
                        "label": "Audience",
                        "tooltip": "Filter by audience.",
                        "index": 2,
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Free",
                                "value": "free"
                            },
                            {
                                "label": "Premium",
                                "value": "premium"
                            }
                        ]
                    },
                    "limit": {
                        "type": "number",
                        "label": "Limit",
                        "tooltip": "Max results.",
                        "index": 3,
                        "defaultValue": 10
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose output format.",
                        "index": 4,
                        "defaultValue": "array",
                        "options": [
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One by one",
                                "value": "item"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Post ID",
                    "value": "data.id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Title",
                    "value": "data.title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Web URL",
                    "value": "data.web_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    ],
    "icon": ""
}
