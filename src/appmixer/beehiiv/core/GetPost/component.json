{
    "name": "appmixer.beehiiv.core.GetPost",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a post by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "postId": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId",
                    "postId"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "postId": {
                        "type": "text",
                        "label": "Post ID",
                        "tooltip": "The prefixed ID of the post.",
                        "index": 1
                    }
                },
                "groups": {
                    "settings": {
                        "label": "Settings",
                        "index": 1,
                        "fields": [
                            "publicationId",
                            "postId"
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Post ID",
                    "value": "data.id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Title",
                    "value": "data.title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Web URL",
                    "value": "data.web_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}