{
    "name": "appmixer.beehiiv.core.CreatePost",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new post (newsletter).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "subtitle": {
                        "type": "string"
                    },
                    "content_html": {
                        "type": "string"
                    },
                    "audience": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId",
                    "title"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "tooltip": "The title of the post.",
                        "index": 1
                    },
                    "subtitle": {
                        "type": "text",
                        "label": "Subtitle",
                        "tooltip": "The subtitle of the post.",
                        "index": 2
                    },
                    "content_html": {
                        "type": "textarea",
                        "label": "Content (HTML)",
                        "tooltip": "HTML content of the post.",
                        "index": 3
                    },
                    "audience": {
                        "type": "select",
                        "label": "Audience",
                        "tooltip": "Target audience.",
                        "index": 4,
                        "options": [
                            {
                                "label": "All",
                                "value": "all"
                            },
                            {
                                "label": "Free",
                                "value": "free"
                            },
                            {
                                "label": "Premium",
                                "value": "premium"
                            }
                        ]
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Post status.",
                        "index": 5,
                        "options": [
                            {
                                "label": "Draft",
                                "value": "draft"
                            },
                            {
                                "label": "Confirmed",
                                "value": "confirmed"
                            },
                            {
                                "label": "Archived",
                                "value": "archived"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Post ID",
                    "value": "data.id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Title",
                    "value": "data.title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Web URL",
                    "value": "data.web_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    ],
    "icon": ""
}