{
    "name": "appmixer.beehiiv.core.FindPosts",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Find posts for a publication. Fires notFound if no results match.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": { "type": "string" },
                    "status": { "type": "string" },
                    "audience": { "type": "string" },
                    "limit": { "type": "number" },
                    "outputType": { "type": "string" }
                },
                "required": ["publicationId"]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Filter by post status.",
                        "index": 1,
                        "options": [
                            { "label": "All", "value": "all" },
                            { "label": "Draft", "value": "draft" },
                            { "label": "Confirmed", "value": "confirmed" },
                            { "label": "Archived", "value": "archived" }
                        ]
                    },
                    "audience": {
                        "type": "select",
                        "label": "Audience",
                        "tooltip": "Filter by audience.",
                        "index": 2,
                        "options": [
                            { "label": "All", "value": "all" },
                            { "label": "Free", "value": "free" },
                            { "label": "Premium", "value": "premium" }
                        ]
                    },
                    "limit": {
                        "type": "number",
                        "label": "Limit",
                        "tooltip": "Max results (default 10).",
                        "index": 3,
                        "defaultValue": 10
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "index": 4,
                        "defaultValue": "array",
                        "options": [
                            { "label": "First Item Only", "value": "first" },
                            { "label": "All items at once", "value": "array" },
                            { "label": "One item at a time", "value": "object" },
                            { "label": "Store to CSV file", "value": "file" }
                        ]
                    }
                },
                "groups": {
                    "required": {
                        "label": "Required",
                        "index": 1,
                        "fields": ["publicationId"]
                    },
                    "optional": {
                        "label": "Optional",
                        "index": 2,
                        "fields": ["status", "audience", "limit", "outputType"]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/beehiiv/core/FindPosts?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/publicationId": "inputs/in/publicationId"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
