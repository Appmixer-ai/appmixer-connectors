{
    "name": "appmixer.beehiiv.core.FindSubscribers",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Find subscribers for a publication. Fires notFound if no results match.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "status": {
                        "type": ["string", "null"]
                    },
                    "tier": {
                        "type": ["string", "null"]
                    },
                    "limit": {
                        "type": "number"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Filter by status.",
                        "index": 1,
                        "options": [
                            { "label": "All", "value": "" },
                            { "label": "Active", "value": "active" },
                            { "label": "Inactive", "value": "inactive" },
                            { "label": "Pending", "value": "pending" }
                        ]
                    },
                    "tier": {
                        "type": "select",
                        "label": "Tier",
                        "tooltip": "Filter by tier.",
                        "index": 2,
                        "options": [
                            { "label": "All", "value": "" },
                            { "label": "Free", "value": "free" },
                            { "label": "Premium", "value": "premium" }
                        ]
                    },
                    "limit": {
                        "type": "number",
                        "label": "Limit",
                        "tooltip": "Max results (default 10).",
                        "index": 3,
                        "defaultValue": 10
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose output format. \"All at once\" sends an array, \"One by one\" sends each subscriber as a separate message.",
                        "index": 4,
                        "defaultValue": "array",
                        "options": [
                            { "label": "All at once", "value": "array" },
                            { "label": "One by one", "value": "item" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Subscribers",
                    "value": "subscribers",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "string" },
                                "email": { "type": "string" },
                                "status": { "type": "string" },
                                "subscription_tier": { "type": "string" },
                                "created": { "type": "integer" },
                                "referral_code": { "type": "string" }
                            }
                        }
                    }
                },
                {
                    "label": "Subscriber ID",
                    "value": "data.id",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Email",
                    "value": "data.email",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Tier",
                    "value": "data.subscription_tier",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Referral Code",
                    "value": "data.referral_code",
                    "schema": { "type": "string" }
                }
            ]
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
