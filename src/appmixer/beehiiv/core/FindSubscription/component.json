{
    "name": "appmixer.beehiiv.core.FindSubscription",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Find a subscription by email address.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId",
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "Email address to search for.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Subscription ID",
                    "value": "data.id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "data.email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Tier",
                    "value": "data.subscription_tier",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Referral Code",
                    "value": "data.referral_code",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": ""
}
