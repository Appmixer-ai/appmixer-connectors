{
    "name": "appmixer.beehiiv.core.UpdateSubscriber",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update a subscriber by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "quota": {
        "manager": "appmixer:beehiiv",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publicationId": {
                        "type": "string"
                    },
                    "subscriberId": {
                        "type": "string"
                    },
                    "tier": {
                        "type": "string"
                    }
                },
                "required": [
                    "publicationId",
                    "subscriberId"
                ]
            },
            "inspector": {
                "inputs": {
                    "publicationId": {
                        "type": "text",
                        "label": "Publication ID",
                        "tooltip": "The prefixed ID of the publication.",
                        "index": 0
                    },
                    "subscriberId": {
                        "type": "text",
                        "label": "Subscriber ID",
                        "tooltip": "The prefixed ID of the subscriber.",
                        "index": 1
                    },
                    "tier": {
                        "type": "select",
                        "label": "Tier",
                        "tooltip": "Update subscriber tier.",
                        "index": 2,
                        "options": [
                            {
                                "label": "Free",
                                "value": "free"
                            },
                            {
                                "label": "Premium",
                                "value": "premium"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Subscriber ID",
                    "value": "data.id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "data.email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "data.status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Tier",
                    "value": "data.subscription_tier",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "data.created",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Referral Code",
                    "value": "data.referral_code",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
