{
    "name": "appmixer.beehiiv.core.MakeAPICallAutomations",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Make a raw API call to beehiiv Automations endpoints.",
    "label": "Make API Call - Automations",
    "version": "1.0.6",
    "auth": {
        "service": "appmixer:beehiiv"
    },
    "icon": "data:image/svg+xml;base64,",
    "properties": {
        "schema": {
            "properties": {
                "method": {
                    "type": "string"
                }
            },
            "required": [
                "method"
            ]
        },
        "inspector": {
            "inputs": {
                "method": {
                    "type": "select",
                    "label": "API Method",
                    "index": 0,
                    "tooltip": "Select the beehiiv Automations API method to call.",
                    "source": {
                        "url": "/component/appmixer/beehiiv/core/MakeAPICallAutomations?outPort=out&ignoreAuth=true",
                        "data": {
                            "properties": {
                                "variablesFetch": true
                            }
                        }
                    }
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object"
            },
            "source": {
                "url": "/component/appmixer/beehiiv/core/MakeAPICallAutomations?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "method": "properties/method"
                    },
                    "transform": "./MakeAPICallAutomations#getInputParamsInspector"
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Result",
                    "value": "result"
                }
            ],
            "source": {
                "url": "/component/appmixer/beehiiv/core/MakeAPICallAutomations?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "method": "properties/method"
                    },
                    "transform": "./MakeAPICallAutomations#getOutputSchema"
                }
            }
        }
    ]
}
