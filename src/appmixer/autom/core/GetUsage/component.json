{
    "name": "appmixer.autom.core.GetUsage",
    "label": "Get Usage",
    "description": "Get the credit usage of the connected Autom account: credits used and remaining, and the renewal date.",
    "author": "Autom <josselin@autom.dev>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:autom"
    },
    "quota": {
        "manager": "appmixer:autom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "remaining": {
                        "type": "number",
                        "title": "Remaining Credits",
                        "example": 48500
                    },
                    "total_used": {
                        "type": "number",
                        "title": "Credits Used",
                        "example": 1500
                    },
                    "renewal_date": {
                        "type": "string",
                        "title": "Renewal Date",
                        "example": "2026-12-01"
                    },
                    "credits": {
                        "type": "object",
                        "title": "Credits"
                    },
                    "subscription": {
                        "type": "object",
                        "title": "Subscription"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
