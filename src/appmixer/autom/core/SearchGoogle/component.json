{
    "name": "appmixer.autom.core.SearchGoogle",
    "label": "Search Google",
    "description": "Run a live Google search with Autom and return the organic results of the first results page.",
    "author": "Autom <josselin@autom.dev>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:autom"
    },
    "quota": {
        "manager": "appmixer:autom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 1,
                        "label": "Query",
                        "tooltip": "The search query to run on Google. Advanced operators such as <code>site:</code> are supported."
                    },
                    "country": {
                        "type": "text",
                        "index": 2,
                        "label": "Country",
                        "tooltip": "2-letter country code the results come from, for example <code>us</code> or <code>de</code>.",
                        "defaultValue": "us"
                    },
                    "language": {
                        "type": "text",
                        "index": 3,
                        "label": "Language",
                        "tooltip": "Optional language code of the results, for example <code>en</code> or <code>fr</code>."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 4,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/autom/core/SearchGoogle?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/query": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "title": "Query",
                        "example": "example"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
