{
    "name": "appmixer.loops.core.CreateContactProperty",
    "label": "Create Contact Property",
    "description": "Create a custom contact property in Loops.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:loops"
    },
    "quota": {
        "manager": "appmixer:loops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "string",
                            "number",
                            "boolean",
                            "date"
                        ]
                    }
                },
                "required": [
                    "name",
                    "type"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "The name of the property in camelCase, for example <code>planName</code>. Some names are reserved by Loops."
                    },
                    "type": {
                        "type": "select",
                        "index": 2,
                        "label": "Type",
                        "defaultValue": "string",
                        "tooltip": "The type of the property.",
                        "options": [
                            {
                                "label": "String",
                                "value": "string"
                            },
                            {
                                "label": "Number",
                                "value": "number"
                            },
                            {
                                "label": "Boolean",
                                "value": "boolean"
                            },
                            {
                                "label": "Date",
                                "value": "date"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string",
                        "title": "Key",
                        "example": "planName"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "string"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
