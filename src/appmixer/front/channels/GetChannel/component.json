{
    "name": "appmixer.front.channels.GetChannel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Fetch a specific channel by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channelId": {
                        "type": "string"
                    }
                },
                "required": ["channelId"]
            },
            "inspector": {
                "inputs": {
                    "channelId": {
                        "type": "text",
                        "label": "Channel ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the channel"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Channel ID", "value": "id" },
                { "label": "Address", "value": "address" },
                { "label": "Type", "value": "type" },
                { "label": "Send As", "value": "send_as" },
                { "label": "Settings", "value": "settings" },
                { "label": "Is Private", "value": "is_private" },
                { "label": "Is Valid", "value": "is_valid" },
                { "label": "Links", "value": "_links" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
