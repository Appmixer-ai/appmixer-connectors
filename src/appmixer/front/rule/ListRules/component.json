{
    "name": "appmixer.front.rule.ListRules",
    "description": "List automation rules from Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "integer",
                        "title": "Limit",
                        "minimum": 1,
                        "maximum": 100
                    },
                    "outputType": {
                        "type": "string",
                        "title": "Output Type"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "limit": {
                        "type": "number",
                        "index": 1,
                        "label": "Limit",
                        "tooltip": "Maximum number of rules to return (1-100)"
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "tooltip": "How to output the rules",
                        "options": [
                            { "label": "Array", "value": "array" },
                            { "label": "Object", "value": "object" },
                            { "label": "First Item", "value": "first" },
                            { "label": "CSV File", "value": "file" }
                        ],
                        "defaultValue": "array"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Result", "value": "result" },
                { "label": "Count", "value": "count" },
                { "label": "Rule ID", "value": "result.id" },
                { "label": "Rule Name", "value": "result.name" },
                { "label": "Rule Description", "value": "result.description" },
                { "label": "Is Active", "value": "result.is_active" },
                { "label": "Created At", "value": "result.created_at" },
                { "label": "Updated At", "value": "result.updated_at" },
                { "label": "Conditions", "value": "result.conditions" },
                { "label": "Actions", "value": "result.actions" },
                { "label": "Priority", "value": "result.priority" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
