{
    "name": "appmixer.front.rule.GetRule",
    "description": "Get a specific automation rule by ID from Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ruleId": {
                        "type": "string",
                        "title": "Rule ID"
                    }
                },
                "required": ["ruleId"]
            },
            "inspector": {
                "inputs": {
                    "ruleId": {
                        "type": "text",
                        "index": 1,
                        "label": "Rule ID",
                        "tooltip": "The ID of the rule to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Rule ID", "value": "id" },
                { "label": "Rule Name", "value": "name" },
                { "label": "Rule Description", "value": "description" },
                { "label": "Is Active", "value": "is_active" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "Conditions", "value": "conditions" },
                { "label": "Actions", "value": "actions" },
                { "label": "Priority", "value": "priority" },
                { "label": "Owner ID", "value": "owner.id" },
                { "label": "Owner Email", "value": "owner.email" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
