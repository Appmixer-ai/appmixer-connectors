{
    "name": "appmixer.front.message.ReplyMessage",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Reply to a conversation by sending a message and appending it to the existing conversation.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversation_id": {
                        "type": "string"
                    },
                    "to": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "cc": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "bcc": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "subject": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    },
                    "sender_name": {
                        "type": "string"
                    },
                    "attachments": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "options": {
                        "type": "object",
                        "properties": {
                            "reply_all": {
                                "type": "boolean"
                            }
                        }
                    }
                },
                "required": ["conversation_id", "body"]
            },
            "inspector": {
                "inputs": {
                    "conversation_id": {
                        "type": "text",
                        "label": "Conversation ID",
                        "index": 1,
                        "tooltip": "The ID of the conversation to reply to"
                    },
                    "to": {
                        "type": "text",
                        "label": "To (Recipients)",
                        "index": 2,
                        "tooltip": "Comma-separated list of recipient email addresses (optional for replies)"
                    },
                    "cc": {
                        "type": "text",
                        "label": "CC",
                        "index": 3,
                        "tooltip": "Comma-separated list of CC email addresses"
                    },
                    "bcc": {
                        "type": "text",
                        "label": "BCC",
                        "index": 4,
                        "tooltip": "Comma-separated list of BCC email addresses"
                    },
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "index": 5,
                        "tooltip": "The subject line of the reply (optional, uses conversation subject)"
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body (HTML)",
                        "index": 6,
                        "tooltip": "The HTML body of the reply message"
                    },
                    "text": {
                        "type": "textarea",
                        "label": "Text Body",
                        "index": 7,
                        "tooltip": "The plain text body of the reply message"
                    },
                    "author_id": {
                        "type": "text",
                        "label": "Author ID",
                        "index": 8,
                        "tooltip": "The teammate ID of the message author"
                    },
                    "sender_name": {
                        "type": "text",
                        "label": "Sender Name",
                        "index": 9,
                        "tooltip": "Name to display as the sender"
                    },
                    "attachments": {
                        "type": "text",
                        "label": "Attachments",
                        "index": 10,
                        "tooltip": "Comma-separated list of attachment file IDs"
                    },
                    "reply_all": {
                        "type": "toggle",
                        "label": "Reply All",
                        "index": 11,
                        "tooltip": "Whether to reply to all recipients in the conversation"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Message ID", "value": "id" },
                { "label": "Type", "value": "type" },
                { "label": "Is Inbound", "value": "is_inbound" },
                { "label": "Is Draft", "value": "is_draft" },
                { "label": "Subject", "value": "subject" },
                { "label": "Body", "value": "body" },
                { "label": "Text", "value": "text" },
                { "label": "Author", "value": "author" },
                { "label": "Recipients", "value": "recipients" },
                { "label": "Created At", "value": "created_at" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
