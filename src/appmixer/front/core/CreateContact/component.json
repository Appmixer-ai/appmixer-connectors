{
    "name": "appmixer.front.core.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "avatar_url": {
                        "type": "string"
                    },
                    "is_spammer": {
                        "type": "boolean"
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "handles": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                },
                                "handle": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "groups": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "custom_fields": {
                        "type": "object"
                    }
                },
                "required": ["name"]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Full name of the contact (required)",
                        "label": "Name",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "Notes about the contact",
                        "label": "Description",
                        "index": 2
                    },
                    "avatar_url": {
                        "type": "text",
                        "tooltip": "Link to avatar image",
                        "label": "Avatar URL",
                        "index": 3
                    },
                    "is_spammer": {
                        "type": "toggle",
                        "tooltip": "Mark contact as spammer",
                        "label": "Is Spammer",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Avatar Url",
                    "value": "avatar_url",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Is Spammer",
                    "value": "is_spammer",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Handles",
                    "value": "handles",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Handles.Type"
                                },
                                "handle": {
                                    "type": "string",
                                    "title": "Handles.Handle"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Groups",
                    "value": "groups",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "object",
                        "properties": {}
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
