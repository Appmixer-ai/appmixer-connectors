{
    "name": "appmixer.front.core.UpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing contact by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "avatar_url": {
                        "type": "string"
                    },
                    "is_spammer": {
                        "type": "boolean"
                    },
                    "links": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "handlesType": {
                        "type": "string"
                    },
                    "handlesHandle": {
                        "type": "string"
                    },
                    "groups": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "custom_fields": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Contact ID",
                        "label": "Id",
                        "index": 0
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "Full name",
                        "label": "Name",
                        "index": 1
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "Notes",
                        "label": "Description",
                        "index": 2
                    },
                    "avatar_url": {
                        "type": "text",
                        "tooltip": "Avatar URL",
                        "label": "Avatar Url",
                        "index": 3
                    },
                    "is_spammer": {
                        "type": "toggle",
                        "tooltip": "Spam flag",
                        "label": "Is Spammer",
                        "index": 4
                    },
                    "links": {
                        "type": "textarea",
                        "tooltip": "Related URLs (comma-separated)",
                        "label": "Links",
                        "index": 5
                    },
                    "handlesType": {
                        "type": "text",
                        "tooltip": "Handle type",
                        "label": "Handles Type",
                        "index": 6
                    },
                    "handlesHandle": {
                        "type": "text",
                        "tooltip": "Handle value",
                        "label": "Handles Handle",
                        "index": 7
                    },
                    "groups": {
                        "type": "textarea",
                        "tooltip": "Groups (comma-separated)",
                        "label": "Groups",
                        "index": 8
                    },
                    "custom_fields": {
                        "type": "text",
                        "tooltip": "Custom fields",
                        "label": "Custom Fields",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": []
        }
    ],
    "icon": "data:image/png;base64,"
}
