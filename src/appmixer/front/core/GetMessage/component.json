{
    "name": "appmixer.front.core.GetMessage",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a message by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Message ID (e.g., msg_123)",
                        "label": "Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Is Inbound",
                    "value": "is_inbound",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Is Draft",
                    "value": "is_draft",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Text",
                    "value": "text",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Author",
                    "value": "author",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Author.Id"
                            },
                            "email": {
                                "type": "string",
                                "title": "Author.Email"
                            },
                            "name": {
                                "type": "string",
                                "title": "Author.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Recipients",
                    "value": "recipients",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Recipients.Type"
                                },
                                "handle": {
                                    "type": "string",
                                    "title": "Recipients.Handle"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Attachments",
                    "value": "attachments",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}