{
    "name": "appmixer.front.core.ListMessages",
    "description": "List messages from a specific conversation in Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversationId": {
                        "type": "string",
                        "title": "Conversation ID"
                    },
                    "limit": {
                        "type": "integer",
                        "title": "Limit",
                        "minimum": 1,
                        "maximum": 100
                    },
                    "outputType": {
                        "type": "string",
                        "title": "Output Type"
                    }
                },
                "required": ["conversationId"]
            },
            "inspector": {
                "inputs": {
                    "conversationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Conversation ID",
                        "tooltip": "The ID of the conversation to list messages from"
                    },
                    "limit": {
                        "type": "number",
                        "index": 2,
                        "label": "Limit",
                        "tooltip": "Maximum number of messages to return (1-100)"
                    },
                    "outputType": {
                        "type": "select",
                        "index": 3,
                        "label": "Output Type",
                        "tooltip": "How to output the messages",
                        "options": [
                            { "label": "Array", "value": "array" },
                            { "label": "Object", "value": "object" },
                            { "label": "First Item", "value": "first" },
                            { "label": "CSV File", "value": "file" }
                        ],
                        "defaultValue": "array"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Result", "value": "result" },
                { "label": "Count", "value": "count" },
                { "label": "Message ID", "value": "result.id" },
                { "label": "Message Type", "value": "result.type" },
                { "label": "Message Subject", "value": "result.subject" },
                { "label": "Message Body", "value": "result.body" },
                { "label": "Message Text", "value": "result.text" },
                { "label": "Author ID", "value": "result.author.id" },
                { "label": "Author Email", "value": "result.author.email" },
                { "label": "Author First Name", "value": "result.author.first_name" },
                { "label": "Author Last Name", "value": "result.author.last_name" },
                { "label": "Recipients", "value": "result.recipients" },
                { "label": "Created At", "value": "result.created_at" },
                { "label": "Is Inbound", "value": "result.is_inbound" },
                { "label": "Is Draft", "value": "result.is_draft" },
                { "label": "Message Metadata", "value": "result.metadata" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
