{
    "name": "appmixer.front.core.SendMessage",
    "description": "Send a message in a conversation in Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversationId": {
                        "type": "string",
                        "title": "Conversation ID"
                    },
                    "body": {
                        "type": "string",
                        "title": "Message Body"
                    },
                    "text": {
                        "type": "string",
                        "title": "Message Text"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject"
                    },
                    "to": {
                        "type": "array",
                        "title": "To Recipients",
                        "items": {
                            "type": "string"
                        }
                    },
                    "cc": {
                        "type": "array",
                        "title": "CC Recipients",
                        "items": {
                            "type": "string"
                        }
                    },
                    "bcc": {
                        "type": "array",
                        "title": "BCC Recipients",
                        "items": {
                            "type": "string"
                        }
                    },
                    "tag_ids": {
                        "type": "array",
                        "title": "Tag IDs",
                        "items": {
                            "type": "string"
                        }
                    },
                    "archiveAfterSend": {
                        "type": "boolean",
                        "title": "Archive After Send"
                    }
                },
                "required": ["conversationId", "body"]
            },
            "inspector": {
                "inputs": {
                    "conversationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Conversation ID",
                        "tooltip": "The ID of the conversation to send the message to"
                    },
                    "body": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Message Body",
                        "tooltip": "The HTML body of the message"
                    },
                    "text": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Message Text",
                        "tooltip": "The plain text version of the message"
                    },
                    "subject": {
                        "type": "text",
                        "index": 4,
                        "label": "Subject",
                        "tooltip": "The subject of the message (for email messages)"
                    },
                    "to": {
                        "type": "text",
                        "index": 5,
                        "label": "To Recipients",
                        "tooltip": "Comma-separated list of recipient email addresses"
                    },
                    "cc": {
                        "type": "text",
                        "index": 6,
                        "label": "CC Recipients",
                        "tooltip": "Comma-separated list of CC recipient email addresses"
                    },
                    "bcc": {
                        "type": "text",
                        "index": 7,
                        "label": "BCC Recipients",
                        "tooltip": "Comma-separated list of BCC recipient email addresses"
                    },
                    "tag_ids": {
                        "type": "text",
                        "index": 8,
                        "label": "Tag IDs",
                        "tooltip": "Comma-separated list of tag IDs to apply to the message"
                    },
                    "archiveAfterSend": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Archive After Send",
                        "tooltip": "Whether to archive the conversation after sending"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Message ID", "value": "id" },
                { "label": "Message Type", "value": "type" },
                { "label": "Message Subject", "value": "subject" },
                { "label": "Message Body", "value": "body" },
                { "label": "Message Text", "value": "text" },
                { "label": "Author ID", "value": "author.id" },
                { "label": "Author Email", "value": "author.email" },
                { "label": "Recipients", "value": "recipients" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Is Inbound", "value": "is_inbound" },
                { "label": "Is Draft", "value": "is_draft" },
                { "label": "Conversation ID", "value": "conversation.id" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
