{
    "name": "appmixer.front.core.GetConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific conversation by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Conversation ID (e.g., cnv_123)",
                        "label": "Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Assignee",
                    "value": "assignee",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Assignee.Id"
                            },
                            "email": {
                                "type": "string",
                                "title": "Assignee.Email"
                            },
                            "name": {
                                "type": "string",
                                "title": "Assignee.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Recipient",
                    "value": "recipient",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "handle": {
                                "type": "string",
                                "title": "Recipient.Handle"
                            },
                            "type": {
                                "type": "string",
                                "title": "Recipient.Type"
                            }
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Is Private",
                    "value": "is_private",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Draft Mode",
                    "value": "draft_mode",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}