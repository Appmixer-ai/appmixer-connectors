{
    "name": "appmixer.front.core.UpdateConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Assign, tag, move or change status of a conversation.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "assignee_id": {
                        "type": "string"
                    },
                    "inbox_id": {
                        "type": "string"
                    },
                    "tag_ids": {
                        "type": "object",
                        "properties": {
                            "AND": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Conversation ID",
                        "label": "Id",
                        "index": 0
                    },
                    "status": {
                        "type": "select",
                        "tooltip": "New status",
                        "label": "Status",
                        "options": [
                            {
                                "label": "assigned",
                                "value": "assigned"
                            },
                            {
                                "label": "unassigned",
                                "value": "unassigned"
                            },
                            {
                                "label": "archived",
                                "value": "archived"
                            },
                            {
                                "label": "deleted",
                                "value": "deleted"
                            }
                        ],
                        "index": 1
                    },
                    "assignee_id": {
                        "type": "text",
                        "tooltip": "Teammate ID to assign to (or null to unassign)",
                        "label": "Assignee Id",
                        "index": 2
                    },
                    "inbox_id": {
                        "type": "text",
                        "tooltip": "Move conversation to this inbox",
                        "label": "Inbox Id",
                        "index": 3
                    },
                    "tag_ids": {
                        "type": "expression",
                        "tooltip": "Replace tags with these tag IDs",
                        "label": "Tag Ids",
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "tag_ids_item": {
                                "type": "text",
                                "label": "Tag Ids Item"
                            }
                        },
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": []
        }
    ],
    "icon": "data:image/png;base64,"
}