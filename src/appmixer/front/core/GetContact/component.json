{
    "name": "appmixer.front.core.GetContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a single contact by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Contact ID (e.g., cnt_123)",
                        "label": "Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Avatar Url",
                    "value": "avatar_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Is Spammer",
                    "value": "is_spammer",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Handles",
                    "value": "handles",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Handles.Type"
                                },
                                "handle": {
                                    "type": "string",
                                    "title": "Handles.Handle"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Groups",
                    "value": "groups",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "plan": {
                                "type": "string",
                                "title": "Custom Fields.Plan"
                            }
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}