{
    "name": "appmixer.front.core.SendMessageinConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a reply or note in an existing conversation.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "recipients|type": {
                        "type": "string"
                    },
                    "recipients|handle": {
                        "type": "string"
                    },
                    "attachments|file_id": {
                        "type": "string"
                    },
                    "attachments|filename": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Conversation ID to reply to",
                        "label": "Id",
                        "index": 0
                    },
                    "type": {
                        "type": "text",
                        "tooltip": "Message type (email, sms, comment, etc.)",
                        "label": "Type",
                        "index": 1
                    },
                    "subject": {
                        "type": "text",
                        "tooltip": "Subject (emails only)",
                        "label": "Subject",
                        "index": 2
                    },
                    "body": {
                        "type": "text",
                        "tooltip": "HTML body",
                        "label": "Body",
                        "index": 3
                    },
                    "text": {
                        "type": "text",
                        "tooltip": "Plain text body",
                        "label": "Text",
                        "index": 4
                    },
                    "recipients|type": {
                        "type": "text",
                        "tooltip": "to, cc, bcc (for email)",
                        "label": "Recipients|type",
                        "index": 5
                    },
                    "recipients|handle": {
                        "type": "text",
                        "tooltip": "Email, phone, etc.",
                        "label": "Recipients|handle",
                        "index": 6
                    },
                    "attachments|file_id": {
                        "type": "text",
                        "tooltip": "Uploaded file identifier",
                        "label": "Attachments|file Id",
                        "index": 7
                    },
                    "attachments|filename": {
                        "type": "text",
                        "tooltip": "File name",
                        "label": "Attachments|filename",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Is Inbound",
                    "value": "is_inbound",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Is Draft",
                    "value": "is_draft",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Text",
                    "value": "text",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Author",
                    "value": "author",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Author.Id"
                            },
                            "email": {
                                "type": "string",
                                "title": "Author.Email"
                            },
                            "name": {
                                "type": "string",
                                "title": "Author.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Recipients",
                    "value": "recipients",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Recipients.Type"
                                },
                                "handle": {
                                    "type": "string",
                                    "title": "Recipients.Handle"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Attachments",
                    "value": "attachments",
                    "schema": {
                        "type": "array",
                        "items": {}
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
