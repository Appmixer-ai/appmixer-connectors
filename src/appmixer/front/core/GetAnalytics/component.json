{
    "name": "appmixer.front.core.GetAnalytics",
    "description": "Get analytics data from Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "start": {
                        "type": "integer",
                        "title": "Start Time (Unix timestamp)"
                    },
                    "end": {
                        "type": "integer",
                        "title": "End Time (Unix timestamp)"
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Timezone"
                    },
                    "filters": {
                        "type": "object",
                        "title": "Filters"
                    }
                },
                "required": ["start", "end"]
            },
            "inspector": {
                "inputs": {
                    "start": {
                        "type": "number",
                        "index": 1,
                        "label": "Start Time",
                        "tooltip": "Start time as Unix timestamp (e.g., 1625097600 for July 1, 2021)"
                    },
                    "end": {
                        "type": "number",
                        "index": 2,
                        "label": "End Time",
                        "tooltip": "End time as Unix timestamp (e.g., 1625184000 for July 2, 2021)"
                    },
                    "timezone": {
                        "type": "text",
                        "index": 3,
                        "label": "Timezone",
                        "tooltip": "Timezone (e.g., America/New_York, Europe/London). Defaults to UTC"
                    },
                    "filters": {
                        "type": "text",
                        "index": 4,
                        "label": "Filters (JSON)",
                        "tooltip": "Additional filters as JSON object (e.g., {\"inbox_ids\": [\"inb_123\"]})"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Total Messages", "value": "metrics.total_messages" },
                { "label": "Inbound Messages", "value": "metrics.inbound_messages" },
                { "label": "Outbound Messages", "value": "metrics.outbound_messages" },
                { "label": "Conversations", "value": "metrics.conversations" },
                { "label": "New Conversations", "value": "metrics.new_conversations" },
                { "label": "Avg Response Time", "value": "metrics.avg_response_time" },
                { "label": "Avg Resolution Time", "value": "metrics.avg_resolution_time" },
                { "label": "Customer Satisfaction", "value": "metrics.customer_satisfaction" },
                { "label": "Tags Applied", "value": "metrics.tags_applied" },
                { "label": "Full Analytics Data", "value": "." }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
