{
    "name": "appmixer.front.core.CreateComment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Add a comment to a conversation. Comments are internal notes that are not visible to customers.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversationId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    }
                },
                "required": ["conversationId", "body"]
            },
            "inspector": {
                "inputs": {
                    "conversationId": {
                        "type": "text",
                        "label": "Conversation ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the conversation"
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Comment Body",
                        "index": 2,
                        "tooltip": "The content of the comment"
                    },
                    "author_id": {
                        "type": "text",
                        "label": "Author ID",
                        "index": 3,
                        "tooltip": "The ID of the teammate who is creating the comment"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Comment ID", "value": "id" },
                { "label": "Body", "value": "body" },
                { "label": "Posted At", "value": "posted_at" },
                { "label": "Author", "value": "author" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
