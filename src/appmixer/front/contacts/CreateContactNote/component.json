{
    "name": "appmixer.front.contacts.CreateContactNote",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Add a note to a contact.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    }
                },
                "required": ["contactId", "body"]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the contact"
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Note Body",
                        "index": 2,
                        "tooltip": "The content of the note (required)"
                    },
                    "author_id": {
                        "type": "text",
                        "label": "Author ID",
                        "index": 3,
                        "tooltip": "The ID of the teammate who is creating the note"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Note ID", "value": "id" },
                { "label": "Body", "value": "body" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "Author", "value": "author" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
