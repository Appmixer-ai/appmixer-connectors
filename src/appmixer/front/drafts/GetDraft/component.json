{
    "name": "appmixer.front.drafts.GetDraft",
    "description": "Retrieve a specific draft by ID",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "draftId": {
                        "type": "string",
                        "title": "Draft ID"
                    }
                },
                "required": ["draftId"]
            },
            "inspector": {
                "inputs": {
                    "draftId": {
                        "type": "text",
                        "index": 1,
                        "label": "Draft ID",
                        "tooltip": "The ID of the draft to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Draft ID", "value": "id" },
                { "label": "Type", "value": "type" },
                { "label": "Is Inbound", "value": "is_inbound" },
                { "label": "Is Draft", "value": "is_draft" },
                { "label": "Subject", "value": "subject" },
                { "label": "Body", "value": "body" },
                { "label": "Text", "value": "text" },
                { "label": "Blurb", "value": "blurb" },
                { "label": "Author ID", "value": "author.id" },
                { "label": "Author Email", "value": "author.email" },
                { "label": "Author First Name", "value": "author.first_name" },
                { "label": "Author Last Name", "value": "author.last_name" },
                { "label": "Author Username", "value": "author.username" },
                { "label": "Recipients", "value": "recipients" },
                { "label": "Attachments", "value": "attachments" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "Version", "value": "version" },
                { "label": "Conversation ID", "value": "conversation.id" },
                { "label": "Channel ID", "value": "channel.id" },
                { "label": "Channel Type", "value": "channel.type" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
