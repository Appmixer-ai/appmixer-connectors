{
    "name": "appmixer.front.drafts.CreateDraft",
    "description": "Create a message draft in Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversationId": {
                        "type": "string",
                        "title": "Conversation ID"
                    },
                    "channelId": {
                        "type": "string",
                        "title": "Channel ID"
                    },
                    "body": {
                        "type": "string",
                        "title": "Message Body"
                    },
                    "text": {
                        "type": "string",
                        "title": "Message Text"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject"
                    },
                    "to": {
                        "type": "array",
                        "title": "To Recipients",
                        "items": {
                            "type": "string"
                        }
                    },
                    "cc": {
                        "type": "array",
                        "title": "CC Recipients",
                        "items": {
                            "type": "string"
                        }
                    },
                    "bcc": {
                        "type": "array",
                        "title": "BCC Recipients",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": ["body"]
            },
            "inspector": {
                "inputs": {
                    "conversationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Conversation ID",
                        "tooltip": "The ID of the conversation (if replying to existing conversation)"
                    },
                    "channelId": {
                        "type": "text",
                        "index": 2,
                        "label": "Channel ID",
                        "tooltip": "The ID of the channel (if creating new conversation)"
                    },
                    "body": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Message Body",
                        "tooltip": "The HTML body of the draft message"
                    },
                    "text": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Message Text",
                        "tooltip": "The plain text version of the message"
                    },
                    "subject": {
                        "type": "text",
                        "index": 5,
                        "label": "Subject",
                        "tooltip": "The subject of the message (for email messages)"
                    },
                    "to": {
                        "type": "text",
                        "index": 6,
                        "label": "To Recipients",
                        "tooltip": "Comma-separated list of recipient email addresses"
                    },
                    "cc": {
                        "type": "text",
                        "index": 7,
                        "label": "CC Recipients",
                        "tooltip": "Comma-separated list of CC recipient email addresses"
                    },
                    "bcc": {
                        "type": "text",
                        "index": 8,
                        "label": "BCC Recipients",
                        "tooltip": "Comma-separated list of BCC recipient email addresses"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Draft ID", "value": "id" },
                { "label": "Draft Subject", "value": "subject" },
                { "label": "Draft Body", "value": "body" },
                { "label": "Draft Text", "value": "text" },
                { "label": "Author ID", "value": "author.id" },
                { "label": "Author Email", "value": "author.email" },
                { "label": "Author First Name", "value": "author.first_name" },
                { "label": "Author Last Name", "value": "author.last_name" },
                { "label": "Channel ID", "value": "channel.id" },
                { "label": "Channel Type", "value": "channel.type" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "Conversation ID", "value": "conversation.id" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
