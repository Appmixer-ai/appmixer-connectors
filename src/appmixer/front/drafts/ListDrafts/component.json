{
    "name": "appmixer.front.drafts.ListDrafts",
    "description": "List message drafts from Front",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:front"
    },
    "quota": {
        "manager": "appmixer:front",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "integer",
                        "title": "Limit",
                        "minimum": 1,
                        "maximum": 100
                    },
                    "outputType": {
                        "type": "string",
                        "title": "Output Type"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "limit": {
                        "type": "number",
                        "index": 1,
                        "label": "Limit",
                        "tooltip": "Maximum number of drafts to return (1-100)"
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "tooltip": "How to output the drafts",
                        "options": [
                            { "label": "Array", "value": "array" },
                            { "label": "Object", "value": "object" },
                            { "label": "First Item", "value": "first" },
                            { "label": "CSV File", "value": "file" }
                        ],
                        "defaultValue": "array"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Result", "value": "result" },
                { "label": "Count", "value": "count" },
                { "label": "Draft ID", "value": "result.id" },
                { "label": "Draft Subject", "value": "result.subject" },
                { "label": "Draft Body", "value": "result.body" },
                { "label": "Draft Text", "value": "result.text" },
                { "label": "Author ID", "value": "result.author.id" },
                { "label": "Author Email", "value": "result.author.email" },
                { "label": "Author First Name", "value": "result.author.first_name" },
                { "label": "Author Last Name", "value": "result.author.last_name" },
                { "label": "Channel ID", "value": "result.channel.id" },
                { "label": "Channel Type", "value": "result.channel.type" },
                { "label": "Created At", "value": "result.created_at" },
                { "label": "Updated At", "value": "result.updated_at" },
                { "label": "Conversation ID", "value": "result.conversation.id" }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
