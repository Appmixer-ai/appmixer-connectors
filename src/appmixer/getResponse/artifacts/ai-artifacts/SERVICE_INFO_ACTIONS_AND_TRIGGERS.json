{
    "actions": [
        {
            "title": "ListContacts",
            "description": "Retrieve contacts with optional filters. Returns an array of contacts.",
            "type": "action",
            "documentation": "https://apireference.getresponse.com/#contacts",
            "endpointUrl": "/v3/contacts",
            "apiBaseUrl": "https://api.getresponse.com",
            "method": "GET",
            "sampleResponse": [
                {
                    "contactId": "abcd1234",
                    "name": "John Doe",
                    "email": "john.doe@example.com",
                    "state": "active",
                    "dayOfCycle": 0,
                    "campaign": {
                        "campaignId": "cAMp123"
                    },
                    "ipAddress": "127.0.0.1",
                    "createdOn": "2023-09-01T10:00:00Z",
                    "origin": "api",
                    "scoring": 0,
                    "customFieldValues": [
                        {
                            "customFieldId": "cf1",
                            "value": [
                                "Seattle"
                            ]
                        }
                    ],
                    "tags": [
                        {
                            "tagId": "t123",
                            "name": "VIP"
                        }
                    ]
                }
            ],
            "inputSchema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "object",
                        "description": "Query string parameters used to filter the contacts.",
                        "properties": {
                            "email": {
                                "type": "string",
                                "description": "Filter by exact email address (maps to query[email])."
                            },
                            "name": {
                                "type": "string",
                                "description": "Filter by contact name (maps to query[name])."
                            },
                            "campaignId": {
                                "type": "string",
                                "description": "Filter by campaign/list ID to return contacts from a specific list."
                            },
                            "state": {
                                "type": "string",
                                "description": "Filter by contact state (e.g., active, unconfirmed, removed, bounced)."
                            },
                            "createdOnFrom": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Return contacts created on or after this timestamp (ISO 8601)."
                            },
                            "createdOnTo": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Return contacts created on or before this timestamp (ISO 8601)."
                            },
                            "sortBy": {
                                "type": "string",
                                "description": "Field to sort by, e.g., createdOn, name, email."
                            },
                            "sortOrder": {
                                "type": "string",
                                "description": "Sort order: asc or desc."
                            }
                        }
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": ""
            }
        },
