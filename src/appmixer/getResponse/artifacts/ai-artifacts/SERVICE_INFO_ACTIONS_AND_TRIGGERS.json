        {
            "title": "CreateContact",
            "description": "Create a new contact in a specified campaign (list).",
            "type": "action",
            "documentation": "https://apireference.getresponse.com/#contacts",
            "endpointUrl": "/v3/contacts",
            "apiBaseUrl": "https://api.getresponse.com",
            "method": "POST",
            "sampleResponse": {
                "contactId": "newc123",
                "name": "Jane Smith",
                "email": "jane.smith@example.com",
                "state": "active",
                "dayOfCycle": 0,
                "campaign": {
                    "campaignId": "cAMp123"
                },
                "ipAddress": "203.0.113.10",
                "createdOn": "2023-09-15T14:22:18Z",
                "origin": "api",
                "scoring": 0,
                "customFieldValues": [
                    {
                        "customFieldId": "cf1",
                        "value": [
                            "Seattle"
                        ]
                    }
                ],
                "tags": [
                    {
                        "tagId": "t123",
                        "name": "VIP"
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "body": {
                        "type": "object",
                        "description": "Payload for creating a contact.",
                        "properties": {
                            "email": {
                                "type": "string",
                                "description": "Contact email address.",
                                "format": "email"
                            },
                            "name": {
                                "type": "string",
                                "description": "Contact name."
                            },
                            "campaign": {
                                "type": "object",
                                "description": "Target campaign (list).",
                                "properties": {
                                    "campaignId": {
                                        "type": "string",
                                        "description": "ID of the target campaign."
                                    }
                                },
                                "required": [
                                    "campaignId"
                                ]
                            },
                            "dayOfCycle": {
                                "type": "integer",
                                "description": "Day of cycle for autoresponders. 0 means today."
                            },
                            "ipAddress": {
                                "type": "string",
                                "description": "IP address of the contact (optional, for compliance/geo info)."
                            },
                            "note": {
                                "type": "string",
                                "description": "Optional note about the contact."
                            },
                            "scoring": {
                                "type": "integer",
                                "description": "Contact scoring value."
                            },
                            "customFieldValues": {
                                "type": "array",
                                "description": "Array of custom field values to set on the contact.",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "customFieldId": {
                                            "type": "string",
                                            "description": "Custom field ID."
                                        },
                                        "value": {
                                            "type": "array",
                                            "description": "Values for the custom field (string array).",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "customFieldId",
                                        "value"
                                    ]
                                }
                            },
                            "tags": {
                                "type": "array",
                                "description": "Tags to assign to the contact.",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "tagId": {
                                            "type": "string",
                                            "description": "Tag ID to assign."
                                        }
                                    },
                                    "required": [
                                        "tagId"
                                    ]
                                }
                            }
                        },
                        "required": [
                            "email",
                            "campaign"
                        ]
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
