                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "testEmail",
                                                "text": "e2e-test-contact@appmixer.com"
                                            },
                                            {
                                                "type": "text",
                                                "name": "testName",
                                                "text": "E2E Test Contact"
