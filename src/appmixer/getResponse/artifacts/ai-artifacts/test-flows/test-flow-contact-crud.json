        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 976,
            "y": 352,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-contact": {
                            "out": {
                                "type": "json2new",
