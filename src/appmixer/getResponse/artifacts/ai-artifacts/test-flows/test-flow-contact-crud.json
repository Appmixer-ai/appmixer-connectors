                                            {
                                                "field": "{{{email-check}}}",
                                                "assertion": "equal",
                                                "expected": "e2e-test-contact@appmixer.com"
                                            },
                                            {
                                                "field": "{{{name-check}}}",
                                                "assertion": "equal",
                                                "expected": "E2E Test Contact"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
