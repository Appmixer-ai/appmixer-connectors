                                            "functions": []
                                        }
                                    },
                                    "campaignId": {
                                        "campaign-var": {
                                            "variable": "$.set-variables.out.campaignId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "email": "{{{email-var}}}",
                                    "name": "{{{name-var}}}",
                                    "campaignId": "{{{campaign-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 976,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": [
