                                            "variable": "$.create-contact.out.contactId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{contact-id-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-contact": {
            "type": "appmixer.getResponse.core.GetContact",
            "x": 608,
            "y": 352,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": [
