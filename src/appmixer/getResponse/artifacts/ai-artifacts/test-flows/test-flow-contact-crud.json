                                            {
                                                "type": "text",
                                                "name": "updatedName",
                                                "text": "E2E Test Contact Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-contact": {
            "type": "appmixer.getResponse.core.CreateContact",
            "x": 400,
            "y": 192,
