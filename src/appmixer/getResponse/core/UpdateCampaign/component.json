{
    "name": "appmixer.getResponse.core.UpdateCampaign",
    "label": "Update Campaign",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing campaign by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "languageCode": {
                        "type": "string"
                    },
                    "isDefault": {
                        "type": "boolean"
                    },
                    "confirmationSubject": {
                        "type": "string"
                    },
                    "confirmationFromName": {
                        "type": "string"
                    },
                    "confirmationFromEmail": {
                        "type": "string"
                    },
                    "confirmationReplyToEmail": {
                        "type": "string"
                    },
                    "confirmationRedirectUrl": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the campaign to update.",
                        "label": "Campaign ID",
                        "index": 0
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "New name for the campaign.",
                        "label": "Campaign Name",
                        "index": 1
                    },
                    "languageCode": {
                        "type": "text",
                        "tooltip": "Language code (e.g., EN, DE, PL).",
                        "label": "Language Code",
                        "index": 2
                    },
                    "isDefault": {
                        "type": "toggle",
                        "tooltip": "Set as default campaign.",
                        "label": "Is Default",
                        "index": 3
                    },
                    "confirmationSubject": {
                        "type": "text",
                        "tooltip": "Subject for subscription confirmation email.",
                        "label": "Confirmation Subject",
                        "index": 4
                    },
                    "confirmationFromName": {
                        "type": "text",
                        "tooltip": "From name for confirmation email.",
                        "label": "Confirmation From Name",
                        "index": 5
                    },
                    "confirmationFromEmail": {
                        "type": "text",
                        "tooltip": "The From Field ID to use as sender for the confirmation email (not an email address).",
                        "label": "Confirmation From Field ID",
                        "index": 6
                    },
                    "confirmationReplyToEmail": {
                        "type": "text",
                        "tooltip": "The From Field ID to use as reply-to for the confirmation email (not an email address).",
                        "label": "Confirmation Reply-To From Field ID",
                        "index": 7
                    },
                    "confirmationRedirectUrl": {
                        "type": "text",
                        "tooltip": "URL to redirect after subscription confirmation.",
                        "label": "Confirmation Redirect URL",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string",
                        "title": "Campaign ID",
                        "example": "abc123campaign"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "My Campaign"
                    },
                    "languageCode": {
                        "type": "string",
                        "title": "Language Code",
                        "example": "EN"
                    },
                    "isDefault": {
                        "type": "boolean",
                        "title": "Is Default",
                        "example": false
                    },
                    "createdOn": {
                        "type": "string",
                        "title": "Created On",
                        "example": "2024-01-15T10:00:00Z"
                    },
                    "href": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://api.getresponse.com/v3/campaigns/abc123campaign"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
