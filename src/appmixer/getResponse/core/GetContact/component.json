{
    "name": "appmixer.getResponse.core.GetContact",
    "label": "Get Contact",
    "description": "Retrieve a single contact by its unique identifier.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "index": 0,
                        "label": "Contact ID",
                        "tooltip": "The unique identifier of the contact."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string",
                        "example": "abc123contact"
                    },
                    "name": {
                        "type": "string",
                        "example": "My Campaign"
                    },
                    "email": {
                        "type": "string",
                        "example": "contact@example.com"
                    },
                    "state": {
                        "type": "string",
                        "example": "subscribed"
                    },
                    "dayOfCycle": {
                        "type": "number",
                        "example": "0"
                    },
                    "campaign": {
                        "type": "object",
                        "properties": {
                            "campaignId": {
                                "type": "string",
                                "title": "Campaign.Campaign ID",
                                "example": "abc123campaign"
                            }
                        },
                        "example": "{}"
                    },
                    "ipAddress": {
                        "type": "string",
                        "example": "192.168.1.1"
                    },
                    "createdOn": {
                        "type": "string",
                        "example": "2024-01-15T10:00:00Z"
                    },
                    "origin": {
                        "type": "string",
                        "example": "import"
                    },
                    "scoring": {
                        "type": "number",
                        "example": "0"
                    },
                    "customFieldValues": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "customFieldId": {
                                    "type": "string",
                                    "title": "Custom Field Values.Custom Field ID"
                                },
                                "value": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "title": "Custom Field Values.Value"
                                }
                            }
                        },
                        "example": "[]"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "tagId": {
                                    "type": "string",
                                    "title": "Tags.Tag ID"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Tags.Name"
                                }
                            }
                        },
                        "example": "[]"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
