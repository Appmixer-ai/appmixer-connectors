{
    "name": "E2E E2B - Make API Call",
    "flow": {
        "on-start": {
            "config": {},
            "source": {},
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16
        },
        "set-variables": {
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "name": "endpoint",
                                                "text": "/v2/sandboxes",
                                                "type": "text"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "variables": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16
        },
        "make-api-call": {
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "lambda": {
                                    "url": "{{{endpoint-var}}}",
                                    "method": "GET"
                                },
                                "modifiers": {
                                    "url": {
                                        "endpoint-var": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.endpoint"
                                        }
                                    },
                                    "method": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.e2b.core.MakeApiCall",
            "x": 448,
            "y": 16
        },
        "assert-response": {
            "config": {
                "transform": {
                    "in": {
                        "make-api-call": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{status-var}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "status-var": {
                                            "functions": [],
                                            "variable": "$.make-api-call.out.status"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "make-api-call": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 800,
            "y": 16
        },
        "after-all": {
            "config": {
                "properties": {
                    "timeout": 30
                }
            },
            "source": {
                "in": {
                    "assert-response": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.AfterAll",
            "x": 992,
            "y": 16
        },
        "process-results": {
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "result": "{{{result-var}}}",
                                    "testCase": "E2E E2B - Make API Call"
                                },
                                "modifiers": {
                                    "recipients": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    },
                                    "testCase": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1184,
            "y": 16
        }
    },
    "notes": {}
}
