{
    "name": "appmixer.e2b.core.GetSandbox",
    "description": "Retrieve details about a single E2B sandbox by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:e2b"
    },
    "quota": {
        "manager": "appmixer:e2b",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string" }
                },
                "required": ["sandboxID"]
            },
            "inspector": {
                "inputs": {
                    "sandboxID": {
                        "type": "text",
                        "index": 1,
                        "label": "Sandbox ID",
                        "tooltip": "The ID of the sandbox, as returned by Create Sandbox or List Sandboxes."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string", "title": "Sandbox ID", "example": "i3xkz5qz8p6z9r2v4w7yq" },
                    "templateID": { "type": "string", "title": "Template ID", "example": "base" },
                    "alias": { "type": "string", "title": "Alias", "example": "base" },
                    "clientID": { "type": "string", "title": "Client ID", "example": "3d3f5e9a" },
                    "state": { "type": "string", "title": "State", "example": "running" },
                    "cpuCount": { "type": "integer", "title": "CPU Count", "example": 2 },
                    "memoryMB": { "type": "integer", "title": "Memory (MB)", "example": 512 },
                    "startedAt": { "type": "string", "format": "date-time", "title": "Started At", "example": "2026-07-09T10:30:00.000Z" },
                    "endAt": { "type": "string", "format": "date-time", "title": "End At", "example": "2026-07-09T11:30:00.000Z" }
                }
            }
        }
    ]
}
