{
    "name": "appmixer.e2b.core.GetSandboxMetrics",
    "description": "Get CPU and memory usage metrics for a running E2B sandbox.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:e2b"
    },
    "quota": {
        "manager": "appmixer:e2b",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string" }
                },
                "required": ["sandboxID"]
            },
            "inspector": {
                "inputs": {
                    "sandboxID": {
                        "type": "text",
                        "index": 1,
                        "label": "Sandbox ID",
                        "tooltip": "The ID of the sandbox, as returned by Create Sandbox or List Sandboxes."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "metrics": {
                        "type": "array",
                        "title": "Metrics",
                        "example": [
                            { "timestamp": "2026-07-09T10:30:00Z", "timestampUnix": 1783609180, "cpuUsedPct": 12.5, "cpuCount": 2, "memUsed": 48066560, "memTotal": 505303040, "memCache": 72511488, "diskUsed": 1649696768, "diskTotal": 22757814272 }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "timestamp": { "type": "string", "title": "Timestamp", "example": "2026-07-09T10:30:00Z" },
                                "timestampUnix": { "type": "integer", "title": "Timestamp (Unix)", "example": 1783609180 },
                                "cpuUsedPct": { "type": "number", "title": "CPU Used (%)", "example": 12.5 },
                                "cpuCount": { "type": "integer", "title": "CPU Count", "example": 2 },
                                "memUsed": { "type": "integer", "title": "Memory Used (bytes)", "example": 48066560 },
                                "memTotal": { "type": "integer", "title": "Memory Total (bytes)", "example": 505303040 },
                                "memCache": { "type": "integer", "title": "Memory Cache (bytes)", "example": 72511488 },
                                "diskUsed": { "type": "integer", "title": "Disk Used (bytes)", "example": 1649696768 },
                                "diskTotal": { "type": "integer", "title": "Disk Total (bytes)", "example": 22757814272 }
                            }
                        }
                    }
                }
            }
        }
    ]
}
