{
    "name": "appmixer.e2b.core.ResumeSandbox",
    "description": "Resume a previously paused E2B sandbox so it can be used again.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:e2b"
    },
    "quota": {
        "manager": "appmixer:e2b",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string" },
                    "timeout": { "type": "integer" }
                },
                "required": ["sandboxID"]
            },
            "inspector": {
                "inputs": {
                    "sandboxID": {
                        "type": "text",
                        "index": 1,
                        "label": "Sandbox ID",
                        "tooltip": "The ID of the paused sandbox to resume, as returned by Create Sandbox or List Sandboxes."
                    },
                    "timeout": {
                        "type": "number",
                        "index": 2,
                        "label": "Timeout (seconds)",
                        "tooltip": "How long the resumed sandbox should stay alive, in seconds. Defaults to 300 (5 minutes)."
                    }
                }
            }
        }
    ],
    "outPorts": ["out"]
}
