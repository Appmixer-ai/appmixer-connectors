{
    "name": "appmixer.e2b.core.DownloadFile",
    "description": "Download a file from an E2B sandbox and store it in the Appmixer file store.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:e2b"
    },
    "quota": {
        "manager": "appmixer:e2b",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string" },
                    "path": { "type": "string" }
                },
                "required": ["sandboxID", "path"]
            },
            "inspector": {
                "inputs": {
                    "sandboxID": {
                        "type": "text",
                        "index": 1,
                        "label": "Sandbox ID",
                        "tooltip": "The ID of the sandbox to download the file from, as returned by Create Sandbox."
                    },
                    "path": {
                        "type": "text",
                        "index": 2,
                        "label": "File Path",
                        "tooltip": "The absolute path of the file inside the sandbox, e.g. <b>/home/user/result.txt</b>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string", "title": "File ID", "example": "5f8d0d55b54764421b7156c9" },
                    "fileName": { "type": "string", "title": "File Name", "example": "result.txt" }
                }
            }
        }
    ]
}
