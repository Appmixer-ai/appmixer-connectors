{
    "name": "appmixer.e2b.core.KillSandbox",
    "description": "Kill (terminate) an E2B sandbox by its ID. This is irreversible.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:e2b"
    },
    "quota": {
        "manager": "appmixer:e2b",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxID": { "type": "string" }
                },
                "required": ["sandboxID"]
            },
            "inspector": {
                "inputs": {
                    "sandboxID": {
                        "type": "text",
                        "index": 1,
                        "label": "Sandbox ID",
                        "tooltip": "The ID of the sandbox to kill, as returned by Create Sandbox or List Sandboxes."
                    }
                }
            }
        }
    ],
    "outPorts": ["out"]
}
