{
    "name": "appmixer.qliksense.core.AppDeleted",
    "label": "App Deleted",
    "description": "Triggers when an app is deleted in Qlik Cloud. Registers a Qlik Cloud webhook while the flow runs.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "spaceId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "spaceId": {
                    "type": "text",
                    "index": 1,
                    "label": "Space",
                    "tooltip": "Only apps in this space. Pick a space, or type the Space ID. Leave empty for all apps you can access.",
                    "source": {
                        "url": "/component/appmixer/qliksense/core/FindSpaces?outPort=out",
                        "data": {
                            "messages": {
                                "in/outputType": "array"
                            },
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./FindSpaces#toSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "deletedAt"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "App ID",
                        "example": "f34b2a1e-5c7d-4e8f-9a0b-1c2d3e4f5a6b"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Sales Dashboard"
                    },
                    "spaceId": {
                        "type": "string",
                        "title": "Space ID",
                        "example": "62716f4b39b865ece543cd45"
                    },
                    "usage": {
                        "type": "string",
                        "title": "Usage",
                        "example": "ANALYTICS"
                    },
                    "deleteType": {
                        "type": "string",
                        "title": "Delete Type",
                        "example": "hard"
                    },
                    "deletedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Deleted At",
                        "example": "2026-11-16T12:00:00Z"
                    },
                    "deletedBy": {
                        "type": "string",
                        "title": "Deleted By",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
