{
    "name": "appmixer.qliksense.core.GetApp",
    "label": "Get App",
    "description": "Get the attributes of a Qlik Sense app.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "reads",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "appId": {
                        "type": "string"
                    }
                },
                "required": [
                    "appId"
                ]
            },
            "inspector": {
                "inputs": {
                    "appId": {
                        "type": "text",
                        "index": 1,
                        "label": "App",
                        "tooltip": "Pick an app, or type the App ID (a UUID, for example <code>f34b2a1e-5c7d-4e8f-9a0b-1c2d3e4f5a6b</code>). The App ID is in the app URL: <code>/sense/app/&lt;appId&gt;</code>.",
                        "source": {
                            "url": "/component/appmixer/qliksense/core/FindApps?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindApps#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "App ID",
                        "example": "f34b2a1e-5c7d-4e8f-9a0b-1c2d3e4f5a6b"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Sales Dashboard"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Quarterly sales by region."
                    },
                    "spaceId": {
                        "type": "string",
                        "title": "Space ID",
                        "example": "62716f4b39b865ece543cd45"
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "usage": {
                        "type": "string",
                        "title": "Usage",
                        "example": "ANALYTICS"
                    },
                    "createdDate": {
                        "type": "string",
                        "title": "Created Date",
                        "example": "2026-11-16T09:12:44.512Z",
                        "format": "date-time"
                    },
                    "modifiedDate": {
                        "type": "string",
                        "title": "Modified Date",
                        "example": "2026-11-16T10:02:11.003Z",
                        "format": "date-time"
                    },
                    "lastReloadTime": {
                        "type": "string",
                        "title": "Last Reload Time",
                        "example": "2026-11-16T10:01:58.940Z",
                        "format": "date-time"
                    },
                    "publishTime": {
                        "type": "string",
                        "title": "Publish Time",
                        "example": "2026-11-16T11:00:00.000Z",
                        "format": "date-time"
                    },
                    "published": {
                        "type": "boolean",
                        "title": "Published",
                        "example": false
                    },
                    "originAppId": {
                        "type": "string",
                        "title": "Origin App ID",
                        "example": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d"
                    },
                    "hasSectionAccess": {
                        "type": "boolean",
                        "title": "Has Section Access",
                        "example": false
                    },
                    "isDirectQueryMode": {
                        "type": "boolean",
                        "title": "Direct Query Mode",
                        "example": false
                    },
                    "encrypted": {
                        "type": "boolean",
                        "title": "Encrypted",
                        "example": true
                    },
                    "thumbnail": {
                        "type": "string",
                        "title": "Thumbnail",
                        "example": "/api/v1/apps/f34b2a1e-5c7d-4e8f-9a0b-1c2d3e4f5a6b/media/content/thumbnail.png"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
