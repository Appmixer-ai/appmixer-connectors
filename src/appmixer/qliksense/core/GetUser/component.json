{
    "name": "appmixer.qliksense.core.GetUser",
    "label": "Get User",
    "description": "Get a user of the tenant.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "reads",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string"
                    }
                },
                "required": [
                    "userId"
                ]
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "text",
                        "index": 1,
                        "label": "User ID",
                        "tooltip": "The ID of the user, for example from Find Users."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "subject",
                    "tenantId"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "User ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Jane Doe"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "active"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "auth0|a08D000001Lm1qzIAB"
                    },
                    "tenantId": {
                        "type": "string",
                        "title": "Tenant ID",
                        "example": "xqGQ0k66vSR8f9G7J-vYtHZQkiYrCpct"
                    },
                    "locale": {
                        "type": "string",
                        "title": "Locale",
                        "example": "en"
                    },
                    "zoneinfo": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Europe/Prague"
                    },
                    "picture": {
                        "type": "string",
                        "title": "Picture",
                        "example": "https://s.gravatar.com/avatar/abc123.png"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-11-16T09:00:00.000Z",
                        "format": "date-time"
                    },
                    "lastUpdatedAt": {
                        "type": "string",
                        "title": "Last Updated At",
                        "example": "2026-11-16T09:30:00.000Z",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
