{
    "name": "appmixer.qliksense.core.CancelReload",
    "label": "Cancel Reload",
    "description": "Cancel a queued or running app reload. Fails when the reload already finished.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "reloads",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "reloadId": {
                        "type": "string"
                    }
                },
                "required": [
                    "reloadId"
                ]
            },
            "inspector": {
                "inputs": {
                    "reloadId": {
                        "type": "text",
                        "index": 1,
                        "label": "Reload ID",
                        "tooltip": "The ID of the reload to cancel."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
