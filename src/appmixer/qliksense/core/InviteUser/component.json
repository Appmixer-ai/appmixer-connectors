{
    "name": "appmixer.qliksense.core.InviteUser",
    "label": "Invite User",
    "description": "Invite a user to the tenant by email. Requires a tenant admin or user admin. An existing user is not invited again unless Resend Invitation is on.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "resend": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "index": 1,
                        "label": "Email",
                        "tooltip": "The email address to invite."
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The display name of the invitee."
                    },
                    "language": {
                        "type": "text",
                        "index": 3,
                        "label": "Language",
                        "tooltip": "Two-letter ISO 639-1 code of the invitation language, for example <code>de</code>. Defaults to English."
                    },
                    "resend": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Resend Invitation",
                        "defaultValue": false,
                        "tooltip": "Send the invitation again to a user who has not accepted it yet."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "userId",
                    "email",
                    "status"
                ],
                "properties": {
                    "userId": {
                        "type": "string",
                        "title": "User ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "ok"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "2f8e6b4a-9c1d-4e7f-8a3b-5c6d7e8f9a0b"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
