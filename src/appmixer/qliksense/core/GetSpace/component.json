{
    "name": "appmixer.qliksense.core.GetSpace",
    "label": "Get Space",
    "description": "Get a space.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "reads",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "spaceId": {
                        "type": "string"
                    }
                },
                "required": [
                    "spaceId"
                ]
            },
            "inspector": {
                "inputs": {
                    "spaceId": {
                        "type": "text",
                        "index": 1,
                        "label": "Space",
                        "tooltip": "Pick a space, or type the Space ID.",
                        "source": {
                            "url": "/component/appmixer/qliksense/core/FindSpaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSpaces#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "tenantId"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Space ID",
                        "example": "62716f4b39b865ece543cd45"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Finance"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "shared"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Shared analytics for the finance team."
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "tenantId": {
                        "type": "string",
                        "title": "Tenant ID",
                        "example": "xqGQ0k66vSR8f9G7J-vYtHZQkiYrCpct"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-11-16T09:00:00.000Z",
                        "format": "date-time"
                    },
                    "createdBy": {
                        "type": "string",
                        "title": "Created By",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-16T09:30:00.000Z",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
