{
    "name": "appmixer.qliksense.core.DeleteSpace",
    "label": "Delete Space",
    "description": "Delete a space. The space must be empty.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "spaceId": {
                        "type": "string"
                    }
                },
                "required": [
                    "spaceId"
                ]
            },
            "inspector": {
                "inputs": {
                    "spaceId": {
                        "type": "text",
                        "index": 1,
                        "label": "Space",
                        "tooltip": "Pick a space, or type the Space ID.",
                        "source": {
                            "url": "/component/appmixer/qliksense/core/FindSpaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSpaces#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
