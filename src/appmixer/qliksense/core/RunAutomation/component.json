{
    "name": "appmixer.qliksense.core.RunAutomation",
    "label": "Run Automation",
    "description": "Run a Qlik Automate automation and wait until the run finishes. Qlik is checked once a minute; the run is sent on when it reaches a final status (finished, finished with warnings, failed, stopped, exceeded limit), so check Succeeded or Status in the next step. If the run does not finish within the timeout, the component fails.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "automationId": {
                        "type": "string"
                    },
                    "timeoutMinutes": {
                        "type": "integer",
                        "default": 60
                    }
                },
                "required": [
                    "automationId"
                ]
            },
            "inspector": {
                "inputs": {
                    "automationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Automation",
                        "tooltip": "Pick an automation, or type the Automation ID.",
                        "source": {
                            "url": "/component/appmixer/qliksense/core/FindAutomations?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindAutomations#toSelectArray"
                            }
                        }
                    },
                    "timeoutMinutes": {
                        "type": "number",
                        "index": 2,
                        "label": "Timeout (minutes)",
                        "defaultValue": 60,
                        "min": 2,
                        "max": 1440,
                        "tooltip": "How long to wait for the run to finish, in minutes (2 to 1440)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "automationId",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Run ID",
                        "example": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
                    },
                    "automationId": {
                        "type": "string",
                        "title": "Automation ID",
                        "example": "9d1e2f3a-4b5c-4d6e-8f7a-8b9c0d1e2f3a"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Send sales report"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "finished"
                    },
                    "succeeded": {
                        "type": "boolean",
                        "title": "Succeeded",
                        "example": true
                    },
                    "context": {
                        "type": "string",
                        "title": "Context",
                        "example": "api_async"
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "spaceId": {
                        "type": "string",
                        "title": "Space ID",
                        "example": "62716f4b39b865ece543cd45"
                    },
                    "executedById": {
                        "type": "string",
                        "title": "Executed By ID",
                        "example": "5f8a1c2b3d4e5f6a7b8c9d0e"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-11-16T10:00:00.000Z",
                        "format": "date-time"
                    },
                    "startTime": {
                        "type": "string",
                        "title": "Start Time",
                        "example": "2026-11-16T10:00:01.000Z",
                        "format": "date-time"
                    },
                    "stopTime": {
                        "type": "string",
                        "title": "Stop Time",
                        "example": "2026-11-16T10:00:09.000Z",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-16T10:00:09.000Z",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
