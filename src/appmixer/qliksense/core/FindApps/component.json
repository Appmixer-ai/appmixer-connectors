{
    "name": "appmixer.qliksense.core.FindApps",
    "label": "Find Apps",
    "description": "Find Qlik Sense apps you can access, by name or description, space or owner. Newest apps first. Returns at most 100 apps.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:qliksense"
    },
    "quota": {
        "manager": "appmixer:qliksense",
        "resources": "reads",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "spaceId": {
                        "type": "string"
                    },
                    "ownerId": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 1,
                        "label": "Search Query",
                        "tooltip": "Case-insensitive text matched against the app name and description."
                    },
                    "spaceId": {
                        "type": "text",
                        "index": 2,
                        "label": "Space",
                        "tooltip": "Only apps in this space. Pick a space, or type the Space ID. Leave empty for all spaces.",
                        "source": {
                            "url": "/component/appmixer/qliksense/core/FindSpaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSpaces#toSelectArray"
                            }
                        }
                    },
                    "ownerId": {
                        "type": "text",
                        "index": 3,
                        "label": "Owner ID",
                        "tooltip": "Only apps owned by this user ID."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 4,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/qliksense/core/FindApps?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
