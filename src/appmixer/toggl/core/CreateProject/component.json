{
    "name": "appmixer.toggl.core.CreateProject",
    "label": "Create Project",
    "description": "Create a project in the workspace.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "clientId": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "isPrivate": {
                        "type": "string"
                    },
                    "billable": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Name of the project.",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Description of the project. Optional.",
                        "index": 2
                    },
                    "clientId": {
                        "type": "text",
                        "label": "Client ID",
                        "tooltip": "Numeric ID of the client the project belongs to (Create Client returns it). Optional.",
                        "index": 3
                    },
                    "color": {
                        "type": "text",
                        "label": "Color",
                        "tooltip": "Hex color, for example <code>#06aaf5</code>. Optional.",
                        "index": 4
                    },
                    "isPrivate": {
                        "type": "select",
                        "label": "Private",
                        "tooltip": "Private projects are visible only to their members. Leave empty to use the workspace default.",
                        "options": [
                            {
                                "label": "Yes",
                                "value": "true"
                            },
                            {
                                "label": "No",
                                "value": "false"
                            }
                        ],
                        "index": 5
                    },
                    "billable": {
                        "type": "toggle",
                        "label": "Billable",
                        "defaultValue": false,
                        "tooltip": "Mark the project as billable.",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 5302177
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "client_id": {
                        "type": "integer",
                        "title": "Client ID",
                        "example": 953805
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Website Redesign"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Redesign of the marketing site"
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": false
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "#06aaf5"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
