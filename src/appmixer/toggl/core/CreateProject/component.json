{
    "name": "appmixer.toggl.core.CreateProject",
    "label": "Create Project",
    "description": "Create a project in a workspace.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "workspaceId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "clientId": {
                        "type": "string"
                    },
                    "isPrivate": {
                        "type": "boolean"
                    },
                    "color": {
                        "type": "string"
                    },
                    "billable": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace",
                        "index": 1,
                        "tooltip": "Pick a workspace or type its numeric ID. Leave empty to use the default workspace of the connected account.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListWorkspaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListWorkspaces#toSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Project name, unique in the workspace."
                    },
                    "clientId": {
                        "type": "text",
                        "label": "Client ID",
                        "index": 3,
                        "tooltip": "Numeric ID of the client the project belongs to (Create Client returns it). Optional."
                    },
                    "isPrivate": {
                        "type": "toggle",
                        "label": "Private",
                        "index": 4,
                        "defaultValue": true,
                        "tooltip": "Private projects are visible only to their members."
                    },
                    "color": {
                        "type": "text",
                        "label": "Color",
                        "index": 5,
                        "tooltip": "Hex color, for example <code>#06aaf5</code>. Optional."
                    },
                    "billable": {
                        "type": "toggle",
                        "label": "Billable",
                        "index": 6,
                        "defaultValue": false,
                        "tooltip": "Mark the project as billable (paid plans)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "name",
                    "active"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 203456789
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 1234567
                    },
                    "client_id": {
                        "type": "integer",
                        "title": "Client ID",
                        "example": 64123456
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Website Redesign"
                    },
                    "active": {
                        "type": "boolean",
                        "title": "Active",
                        "example": true
                    },
                    "is_private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": true
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "#06aaf5"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-11-18T09:00:00+00:00",
                        "format": "date-time"
                    },
                    "at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-18T09:00:00+00:00",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
