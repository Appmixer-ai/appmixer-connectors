{
    "name": "appmixer.toggl.core.CreateTimeEntry",
    "label": "Create Time Entry",
    "description": "Create a time entry. Leave Stop and Duration empty to start a running timer (Toggl stops any timer that is already running).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "workspaceId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "stop": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "duration": {
                        "type": "integer"
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "taskId": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "billable": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "start"
                ]
            },
            "inspector": {
                "inputs": {
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace",
                        "index": 1,
                        "tooltip": "Pick a workspace or type its numeric ID. Leave empty to use the default workspace of the connected account.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListWorkspaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListWorkspaces#toSelectArray"
                            }
                        }
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "What the time was spent on."
                    },
                    "start": {
                        "type": "date-time",
                        "label": "Start",
                        "index": 3,
                        "tooltip": "When the time entry starts."
                    },
                    "stop": {
                        "type": "date-time",
                        "label": "Stop",
                        "index": 4,
                        "tooltip": "When the time entry ends. Leave empty, together with Duration, to start a running timer."
                    },
                    "duration": {
                        "type": "number",
                        "label": "Duration (seconds)",
                        "index": 5,
                        "tooltip": "Length of the time entry in seconds, used when Stop is empty."
                    },
                    "projectId": {
                        "type": "text",
                        "label": "Project",
                        "index": 6,
                        "tooltip": "Pick a project or type its numeric ID. Optional.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListProjects?outPort=out",
                            "data": {
                                "messages": {
                                    "in/workspaceId": "inputs/in/workspaceId",
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListProjects#toSelectArray"
                            }
                        }
                    },
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "index": 7,
                        "tooltip": "Numeric ID of a task of the project (Create Task returns it). Optional; tasks need a paid plan."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 8,
                        "tooltip": "Comma-separated tag names, for example <code>meeting, client</code>. Tags that do not exist yet are created."
                    },
                    "billable": {
                        "type": "toggle",
                        "label": "Billable",
                        "index": 9,
                        "defaultValue": false,
                        "tooltip": "Mark the time entry as billable (paid plans)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "start",
                    "duration"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Time Entry ID",
                        "example": 4123456789
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 1234567
                    },
                    "project_id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 203456789
                    },
                    "task_id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 98765432
                    },
                    "user_id": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 5551234
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Write release notes"
                    },
                    "start": {
                        "type": "string",
                        "title": "Start",
                        "example": "2026-11-18T09:00:00+00:00",
                        "format": "date-time"
                    },
                    "stop": {
                        "type": "string",
                        "title": "Stop",
                        "example": "2026-11-18T10:30:00+00:00",
                        "format": "date-time"
                    },
                    "duration": {
                        "type": "integer",
                        "title": "Duration (seconds)",
                        "example": 5400
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "release"
                        ]
                    },
                    "tag_ids": {
                        "type": "array",
                        "title": "Tag IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            16123456
                        ]
                    },
                    "at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-18T10:30:05+00:00",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
