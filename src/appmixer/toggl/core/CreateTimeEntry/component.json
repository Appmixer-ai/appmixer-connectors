{
    "name": "appmixer.toggl.core.CreateTimeEntry",
    "label": "Create Time Entry",
    "description": "Create a time entry of the connected user. Leave Stop and Duration empty to start a running timer (Toggl stops a timer that is already running).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "stop": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "duration": {
                        "type": "integer"
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "taskId": {
                        "type": "string"
                    },
                    "tagIds": {
                        "type": "string"
                    },
                    "billable": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "tooltip": "What the time was spent on.",
                        "index": 1
                    },
                    "start": {
                        "type": "date-time",
                        "label": "Start",
                        "tooltip": "When the time entry starts. Required with Stop or Duration. For a running timer, leave empty to start it now.",
                        "index": 2
                    },
                    "stop": {
                        "type": "date-time",
                        "label": "Stop",
                        "tooltip": "When the time entry ends. Leave empty, together with Duration, to start a running timer.",
                        "index": 3
                    },
                    "duration": {
                        "type": "number",
                        "label": "Duration (seconds)",
                        "tooltip": "Length of the time entry in seconds, used when Stop is empty.",
                        "index": 4
                    },
                    "projectId": {
                        "type": "text",
                        "label": "Project",
                        "tooltip": "Pick a project or type its numeric ID. Optional. Ignored when Task ID is set: the entry then belongs to the project of the task.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListProjects?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListProjects#toSelectArray"
                            }
                        },
                        "index": 5
                    },
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "tooltip": "Numeric ID of a task (Create Task returns it). Optional.",
                        "index": 6
                    },
                    "tagIds": {
                        "type": "text",
                        "label": "Tag IDs",
                        "tooltip": "Numeric IDs of tags, separated by commas. Optional.",
                        "index": 7
                    },
                    "billable": {
                        "type": "toggle",
                        "label": "Billable",
                        "defaultValue": false,
                        "tooltip": "Mark the time entry as billable.",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "type"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Time Entry ID",
                        "example": 247977688
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "project_id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 5302177
                    },
                    "task_id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 18514337
                    },
                    "toggl_user_id": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 7987332
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "activity"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Write release notes"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Start",
                        "example": "2026-11-18T09:00:00Z"
                    },
                    "stop": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Stop",
                        "example": "2026-11-18T10:30:00.000Z"
                    },
                    "duration": {
                        "type": "integer",
                        "title": "Duration (seconds)",
                        "example": 5400
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "tag_ids": {
                        "type": "array",
                        "title": "Tag IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            16123
                        ]
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Europe/Prague"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T10:30:05.655129Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T10:30:05.655129Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
