{
    "name": "appmixer.toggl.core.TimeEntryUpdated",
    "label": "Time Entry Updated",
    "description": "Triggers when a time entry of the connected user that covers the last 30 days is changed, a stopped timer included. Deleted entries do not trigger. Toggl has no webhooks, so the trigger checks every 5 minutes.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "type"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Time Entry ID",
                        "example": 247977688
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "project_id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 5302177
                    },
                    "task_id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 18514337
                    },
                    "toggl_user_id": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 7987332
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "activity"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Write release notes"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Start",
                        "example": "2026-11-18T09:00:00Z"
                    },
                    "stop": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Stop",
                        "example": "2026-11-18T10:30:00.000Z"
                    },
                    "duration": {
                        "type": "integer",
                        "title": "Duration (seconds)",
                        "example": 5400
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "tag_ids": {
                        "type": "array",
                        "title": "Tag IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            16123
                        ]
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Europe/Prague"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T10:30:05.655129Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T10:30:05.655129Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
