{
    "name": "appmixer.toggl.core.GetTimeEntry",
    "label": "Get Time Entry",
    "description": "Get one of your time entries by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "timeEntryId": {
                        "type": "string"
                    }
                },
                "required": [
                    "timeEntryId"
                ]
            },
            "inspector": {
                "inputs": {
                    "timeEntryId": {
                        "type": "text",
                        "label": "Time Entry ID",
                        "index": 1,
                        "tooltip": "Numeric ID of the time entry. Find Time Entries and Create Time Entry return it."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "start",
                    "duration"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Time Entry ID",
                        "example": 4123456789
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 1234567
                    },
                    "project_id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 203456789
                    },
                    "task_id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 98765432
                    },
                    "user_id": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 5551234
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Write release notes"
                    },
                    "start": {
                        "type": "string",
                        "title": "Start",
                        "example": "2026-11-18T09:00:00+00:00",
                        "format": "date-time"
                    },
                    "stop": {
                        "type": "string",
                        "title": "Stop",
                        "example": "2026-11-18T10:30:00+00:00",
                        "format": "date-time"
                    },
                    "duration": {
                        "type": "integer",
                        "title": "Duration (seconds)",
                        "example": 5400
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "release"
                        ]
                    },
                    "tag_ids": {
                        "type": "array",
                        "title": "Tag IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            16123456
                        ]
                    },
                    "at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-18T10:30:05+00:00",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
