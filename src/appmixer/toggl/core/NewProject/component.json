{
    "name": "appmixer.toggl.core.NewProject",
    "label": "New Project",
    "description": "Triggers when a project is created in the workspace. Toggl has no webhooks, so the trigger checks every 5 minutes.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 5302177
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "client_id": {
                        "type": "integer",
                        "title": "Client ID",
                        "example": 953805
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Website Redesign"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Redesign of the marketing site"
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": false
                    },
                    "billable": {
                        "type": "boolean",
                        "title": "Billable",
                        "example": false
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "#06aaf5"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    },
                    "archived_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Archived At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    },
                    "completed_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Completed At",
                        "example": "2026-11-18T09:00:00.084772Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
