{
    "name": "appmixer.toggl.core.CreateTask",
    "label": "Create Task",
    "description": "Create a task in the workspace, optionally in a project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "estimatedMinutes": {
                        "type": "integer"
                    },
                    "priority": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Name of the task.",
                        "index": 1
                    },
                    "projectId": {
                        "type": "text",
                        "label": "Project",
                        "tooltip": "Pick a project or type its numeric ID. Optional: a task can exist without a project.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListProjects?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListProjects#toSelectArray"
                            }
                        },
                        "index": 2
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Description of the task. Optional.",
                        "index": 3
                    },
                    "estimatedMinutes": {
                        "type": "number",
                        "label": "Estimate (minutes)",
                        "tooltip": "Estimated time of the task in minutes. Optional.",
                        "index": 4
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority of the task. Optional.",
                        "options": [
                            {
                                "label": "None",
                                "value": "none"
                            },
                            {
                                "label": "Low",
                                "value": "low"
                            },
                            {
                                "label": "Medium",
                                "value": "medium"
                            },
                            {
                                "label": "High",
                                "value": "high"
                            }
                        ],
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 18514337
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "project_id": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 5302177
                    },
                    "status_id": {
                        "type": "integer",
                        "title": "Status ID",
                        "example": 1325348
                    },
                    "toggl_user_id": {
                        "type": "integer",
                        "title": "Creator User ID",
                        "example": 7987332
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Draft the homepage"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "First draft of the new homepage copy"
                    },
                    "estimated_mins": {
                        "type": "integer",
                        "title": "Estimate (minutes)",
                        "example": 90
                    },
                    "priority": {
                        "type": "string",
                        "title": "Priority",
                        "example": "none"
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T14:34:59.052686Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T14:34:59.052686Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
