{
    "name": "appmixer.toggl.core.DeleteTimeEntry",
    "label": "Delete Time Entry",
    "description": "Delete a time entry by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "timeEntryId": {
                        "type": "string"
                    }
                },
                "required": [
                    "timeEntryId"
                ]
            },
            "inspector": {
                "inputs": {
                    "timeEntryId": {
                        "type": "text",
                        "label": "Time Entry ID",
                        "tooltip": "Numeric ID of the time entry to delete.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
