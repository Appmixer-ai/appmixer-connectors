{
    "name": "appmixer.toggl.core.CreateClient",
    "label": "Create Client",
    "description": "Create a client in the workspace.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "contactEmail": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "internalReference": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Name of the client.",
                        "index": 1
                    },
                    "contactEmail": {
                        "type": "text",
                        "label": "Contact Email",
                        "tooltip": "Email address of the contact at the client. Optional.",
                        "index": 2
                    },
                    "address": {
                        "type": "textarea",
                        "label": "Address",
                        "tooltip": "Postal address of the client. Optional.",
                        "index": 3
                    },
                    "internalReference": {
                        "type": "text",
                        "label": "Internal Reference",
                        "tooltip": "Your own reference for the client, for example an ID from the accounting system. Optional.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "workspace_id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Client ID",
                        "example": 953805
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 21808213
                    },
                    "toggl_user_id": {
                        "type": "integer",
                        "title": "Creator User ID",
                        "example": 7987332
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Acme"
                    },
                    "contact_email": {
                        "type": "string",
                        "title": "Contact Email",
                        "example": "billing@acme.com"
                    },
                    "address": {
                        "type": "string",
                        "title": "Address",
                        "example": "1 Main Street, Springfield"
                    },
                    "internal_reference": {
                        "type": "string",
                        "title": "Internal Reference",
                        "example": "CUST-0042"
                    },
                    "active": {
                        "type": "boolean",
                        "title": "Active",
                        "example": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-18T14:34:58.648022Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-18T14:34:58.648022Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
