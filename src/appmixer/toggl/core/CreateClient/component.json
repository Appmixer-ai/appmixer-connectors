{
    "name": "appmixer.toggl.core.CreateClient",
    "label": "Create Client",
    "description": "Create a client in a workspace.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:toggl"
    },
    "quota": {
        "manager": "appmixer:toggl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "workspaceId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace",
                        "index": 1,
                        "tooltip": "Pick a workspace or type its numeric ID. Leave empty to use the default workspace of the connected account.",
                        "source": {
                            "url": "/component/appmixer/toggl/core/ListWorkspaces?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListWorkspaces#toSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Client name, unique in the workspace."
                    },
                    "notes": {
                        "type": "textarea",
                        "label": "Notes",
                        "index": 3,
                        "tooltip": "Optional notes about the client."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "wid",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Client ID",
                        "example": 64123456
                    },
                    "wid": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 1234567
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Acme Inc."
                    },
                    "archived": {
                        "type": "boolean",
                        "title": "Archived",
                        "example": false
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Retainer client"
                    },
                    "creator_id": {
                        "type": "integer",
                        "title": "Creator ID",
                        "example": 5551234
                    },
                    "at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-11-18T09:00:00+00:00",
                        "format": "date-time"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
