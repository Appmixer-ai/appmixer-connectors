{
    "name": "appmixer.teamwork.core.CreateWorkflowStage",
    "description": "Add a stage to a workflow in Teamwork.com. The stage is placed after the existing stages.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:teamwork"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "workflowId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "showCompletedTasks": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "workflowId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "workflowId": {
                        "type": "text",
                        "index": 0,
                        "label": "Workflow",
                        "tooltip": "Select the workflow or enter its ID.",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListWorkflows?outPort=workflows",
                            "data": {
                                "transform": "ListWorkflows#toInspector"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Name of the stage, for example \"Backlog\"."
                    },
                    "color": {
                        "type": "text",
                        "index": 2,
                        "label": "Color",
                        "tooltip": "Hex color of the stage, for example #3B82F6."
                    },
                    "showCompletedTasks": {
                        "type": "toggle",
                        "index": 3,
                        "label": "Show Completed Tasks",
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number",
                        "title": "ID",
                        "example": 81234
                    },
                    "workflowId": {
                        "type": "number",
                        "title": "Workflow ID",
                        "example": 20391
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Backlog"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "#3B82F6"
                    },
                    "displayOrder": {
                        "type": "number",
                        "title": "Display Order",
                        "example": 1
                    },
                    "showCompletedTasks": {
                        "type": "boolean",
                        "title": "Show Completed Tasks",
                        "example": false
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
