{
    "name": "appmixer.teamwork.core.CreateTag",
    "description": "Create a tag in Teamwork.com. Tags can then be added to tasks with Change Task Tags.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:teamwork"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 0,
                        "label": "Name",
                        "tooltip": "Name of the tag, for example \"urgent\"."
                    },
                    "color": {
                        "type": "text",
                        "index": 1,
                        "label": "Color",
                        "tooltip": "Hex color of the tag, for example #9b59b6. Teamwork picks a color when left empty."
                    },
                    "projectId": {
                        "type": "text",
                        "index": 2,
                        "label": "Project",
                        "tooltip": "Restrict the tag to one project. Leave empty for a tag available in all projects.",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListProjects?outPort=projects",
                            "data": {
                                "transform": "ListProjects#toInspector"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number",
                        "title": "ID",
                        "example": 183925
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "urgent"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "#9b59b6"
                    },
                    "projectId": {
                        "type": "number",
                        "title": "Project ID",
                        "example": 0
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
