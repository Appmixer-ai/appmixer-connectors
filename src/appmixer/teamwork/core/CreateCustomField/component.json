{
    "name": "appmixer.teamwork.core.CreateCustomField",
    "description": "Create a custom field for tasks, projects or companies in Teamwork.com.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:teamwork"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "entity": {
                        "type": "string",
                        "enum": [
                            "task",
                            "project",
                            "company"
                        ]
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "text-short",
                            "number-integer",
                            "number-decimal",
                            "checkbox",
                            "date",
                            "url"
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "entity",
                    "type"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 0,
                        "label": "Name"
                    },
                    "entity": {
                        "type": "select",
                        "index": 1,
                        "label": "Entity",
                        "defaultValue": "task",
                        "tooltip": "The kind of item the custom field belongs to.",
                        "options": [
                            {
                                "label": "Task",
                                "value": "task"
                            },
                            {
                                "label": "Project",
                                "value": "project"
                            },
                            {
                                "label": "Company",
                                "value": "company"
                            }
                        ]
                    },
                    "type": {
                        "type": "select",
                        "index": 2,
                        "label": "Type",
                        "defaultValue": "text-short",
                        "options": [
                            {
                                "label": "Text",
                                "value": "text-short"
                            },
                            {
                                "label": "Number (integer)",
                                "value": "number-integer"
                            },
                            {
                                "label": "Number (decimal)",
                                "value": "number-decimal"
                            },
                            {
                                "label": "Checkbox",
                                "value": "checkbox"
                            },
                            {
                                "label": "Date",
                                "value": "date"
                            },
                            {
                                "label": "URL",
                                "value": "url"
                            }
                        ]
                    },
                    "description": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Description"
                    },
                    "projectId": {
                        "type": "text",
                        "index": 4,
                        "label": "Project",
                        "tooltip": "Make the custom field specific to one project. Leave empty for a field available in all projects.",
                        "source": {
                            "url": "/component/appmixer/teamwork/core/ListProjects?outPort=projects",
                            "data": {
                                "transform": "ListProjects#toInspector"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number",
                        "title": "ID",
                        "example": 4521
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Customer reference"
                    },
                    "entity": {
                        "type": "string",
                        "title": "Entity",
                        "example": "task"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "text-short"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Reference number from the CRM"
                    },
                    "projectId": {
                        "type": "number",
                        "title": "Project ID",
                        "example": 0
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-11-20T10:15:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
