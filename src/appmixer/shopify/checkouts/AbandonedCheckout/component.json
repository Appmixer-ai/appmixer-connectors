{
    "name": "appmixer.shopify.checkouts.AbandonedCheckout",
    "author": "Appmixer <info@appmixer.com>",
    "description": "This trigger fires when a checkout (cart) is created and left incomplete, allowing you to track and recover abandoned carts.",
    "icon": "data:image/svg+xml;base64,",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:shopify"
    },
    "outPorts": [
        {
            "name": "checkout",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "title": "ID", "example": 450789469 },
                    "token": { "type": "string", "title": "Token", "example": "bd5a8aa1ecd019dd3f9a420cl8e8c9d1" },
                    "cart_token": { "type": "string", "title": "Cart Token", "example": "68778783 ad298f1c80c3bafcddeea02f" },
                    "email": { "type": "string", "title": "Email", "example": "john.doe@example.com" },
                    "gateway": { "type": "string", "title": "Gateway", "example": "shopify_payments" },
                    "buyer_accepts_marketing": { "type": "boolean", "title": "Buyer Accepts Marketing", "example": false },
                    "created_at": { "type": "string", "format": "date-time", "title": "Date Created", "example": "2024-03-10T09:00:00-04:00" },
                    "updated_at": { "type": "string", "format": "date-time", "title": "Date Updated", "example": "2024-03-10T09:15:00-04:00" },
                    "completed_at": { "type": "string", "format": "date-time", "title": "Date Completed", "example": null },
                    "landing_site": { "type": "string", "title": "Landing Site", "example": "/products/great-product" },
                    "referring_site": { "type": "string", "title": "Referring Site", "example": "https://www.google.com" },
                    "note": { "type": "string", "title": "Note", "example": "Please gift wrap this order" },
                    "currency": { "type": "string", "title": "Currency", "example": "USD" },
                    "presentment_currency": { "type": "string", "title": "Presentment Currency", "example": "USD" },
                    "customer_locale": { "type": "string", "title": "Customer Locale", "example": "en" },
                    "phone": { "type": "string", "title": "Phone", "example": "+15145556789" },
                    "name": { "type": "string", "title": "Name", "example": "#451789469" },
                    "abandoned_checkout_url": { "type": "string", "title": "Abandoned Checkout URL", "example": "https://mystore.myshopify.com/548380009/checkouts/abc123/recover" },
                    "total_price": { "type": "string", "title": "Total Price", "example": "204.99" },
                    "subtotal_price": { "type": "string", "title": "Subtotal Price", "example": "199.00" },
                    "total_tax": { "type": "string", "title": "Total Tax", "example": "11.94" },
                    "total_discounts": { "type": "string", "title": "Total Discounts", "example": "0.00" },
                    "total_weight": { "type": "integer", "title": "Total Weight", "example": 500 },
                    "taxes_included": { "type": "boolean", "title": "Taxes Included", "example": false },
                    "line_items": {
                        "type": "array",
                        "title": "Line Items",
                        "example": [
                            {
                                "id": 466157049,
                                "title": "IPod Nano - 8GB",
                                "quantity": 1,
                                "price": "199.00"
                            }
                        ]
                    },
                    "shipping_lines": {
                        "type": "array",
                        "title": "Shipping Lines",
                        "example": [
                            {
                                "title": "Standard Shipping",
                                "price": "5.99",
                                "code": "standard"
                            }
                        ]
                    },
                    "tax_lines": {
                        "type": "array",
                        "title": "Tax Lines",
                        "example": [
                            {
                                "title": "State Tax",
                                "price": "11.94",
                                "rate": 0.06
                            }
                        ]
                    },
                    "discount_codes": {
                        "type": "array",
                        "title": "Discount Codes",
                        "example": []
                    },
                    "customer": {
                        "type": "object",
                        "title": "Customer",
                        "example": {
                            "id": 207119551,
                            "email": "john@example.com",
                            "first_name": "John",
                            "last_name": "Doe"
                        }
                    },
                    "billing_address": {
                        "type": "object",
                        "title": "Billing Address",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "123 Main St",
                            "city": "New York",
                            "province": "NY",
                            "country": "US",
                            "zip": "10001"
                        }
                    },
                    "shipping_address": {
                        "type": "object",
                        "title": "Shipping Address",
                        "example": {
                            "first_name": "John",
                            "last_name": "Doe",
                            "address1": "456 Oak Ave",
                            "city": "Los Angeles",
                            "province": "CA",
                            "country": "US",
                            "zip": "90001"
                        }
                    },
                    "webhookTopic": { "type": "string", "title": "Webhook Topic", "example": "checkouts/create" }
                }
            }
        }
    ]
}
