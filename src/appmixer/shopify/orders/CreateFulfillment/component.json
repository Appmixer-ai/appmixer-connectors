{
    "name": "appmixer.shopify.orders.CreateFulfillment",
    "description": "Fulfill an order: mark its items as shipped, with optional tracking information. Leave the line items empty to fulfill everything that is left. Returns the fulfillment. Needs the write_merchant_managed_fulfillment_orders access scope on the Shopify app.",
    "author": "Appmixer <info@appmixer.com>",
    "private": false,
    "auth": {
        "service": "appmixer:shopify",
        "scope": [
            "read_orders",
            "write_orders",
            "read_fulfillments"
        ]
    },
    "quota": {
        "manager": "appmixer:shopify",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "orderId": {
                        "type": "string"
                    },
                    "lineItems": {
                        "type": "object"
                    },
                    "trackingNumber": {
                        "type": "string"
                    },
                    "trackingCompany": {
                        "type": "string"
                    },
                    "trackingUrl": {
                        "type": "string"
                    },
                    "notifyCustomer": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "orderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "orderId": {
                        "type": "text",
                        "label": "Order",
                        "index": 1,
                        "tooltip": "Pick an order, or enter its ID: the global ID (gid://shopify/Order/450789469) or the numeric ID from the order's admin URL.",
                        "source": {
                            "url": "/component/appmixer/shopify/orders/FindOrders?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindOrders#ordersToSelectArray"
                            }
                        }
                    },
                    "lineItems": {
                        "type": "expression",
                        "label": "Line Items",
                        "index": 2,
                        "levels": [
                            "ADD"
                        ],
                        "tooltip": "The line items to fulfill. Leave empty to fulfill everything that is left to fulfill.",
                        "fields": {
                            "lineItemId": {
                                "type": "text",
                                "label": "Line Item ID",
                                "index": 1,
                                "tooltip": "The ID of the order's line item (gid://shopify/LineItem/123 or 123), for example from the lineItems of Get Order."
                            },
                            "quantity": {
                                "type": "number",
                                "label": "Quantity",
                                "index": 2,
                                "tooltip": "How many units to fulfill. Leave empty to fulfill all remaining units of the line item."
                            }
                        }
                    },
                    "trackingNumber": {
                        "type": "text",
                        "label": "Tracking Number",
                        "index": 3,
                        "tooltip": "The tracking number of the shipment."
                    },
                    "trackingCompany": {
                        "type": "text",
                        "label": "Carrier",
                        "index": 4,
                        "tooltip": "The shipping carrier, for example <code>UPS</code>, <code>DHL Express</code> or <code>Other</code>. Shopify builds the tracking URL for carriers it knows."
                    },
                    "trackingUrl": {
                        "type": "text",
                        "label": "Tracking URL",
                        "index": 5,
                        "tooltip": "The URL of the tracking page. Needed for carriers Shopify does not know."
                    },
                    "notifyCustomer": {
                        "type": "toggle",
                        "label": "Notify Customer",
                        "index": 6,
                        "defaultValue": false,
                        "tooltip": "Send the customer the shipping confirmation (or shipping update) e-mail."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "legacyResourceId",
                    "name",
                    "status",
                    "totalQuantity",
                    "requiresShipping",
                    "createdAt",
                    "updatedAt",
                    "trackingInfo",
                    "lineItems",
                    "order"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "gid://shopify/Fulfillment/9268311720017"
                    },
                    "legacyResourceId": {
                        "type": "string",
                        "title": "Legacy Resource ID",
                        "example": "9268311720017"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "#1026-F1"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "SUCCESS"
                    },
                    "displayStatus": {
                        "type": "string",
                        "title": "Display Status",
                        "example": "FULFILLED"
                    },
                    "totalQuantity": {
                        "type": "integer",
                        "title": "Total Quantity",
                        "example": 2
                    },
                    "requiresShipping": {
                        "type": "boolean",
                        "title": "Requires Shipping",
                        "example": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-05T08:24:51Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-10-05T08:24:57Z"
                    },
                    "deliveredAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Delivered At",
                        "example": "2026-10-07T12:00:00Z"
                    },
                    "estimatedDeliveryAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Estimated Delivery At",
                        "example": "2026-10-07T12:00:00Z"
                    },
                    "inTransitAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "In Transit At",
                        "example": "2026-10-06T09:00:00Z"
                    },
                    "location": {
                        "type": "object",
                        "title": "Location",
                        "required": [
                            "id",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Location.ID",
                                "example": "gid://shopify/Location/124679880785"
                            },
                            "name": {
                                "type": "string",
                                "title": "Location.Name",
                                "example": "Shop location"
                            }
                        }
                    },
                    "service": {
                        "type": "object",
                        "title": "Service",
                        "required": [
                            "id",
                            "handle",
                            "serviceName"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Service.ID",
                                "example": "gid://shopify/FulfillmentService/manual"
                            },
                            "handle": {
                                "type": "string",
                                "title": "Service.Handle",
                                "example": "manual"
                            },
                            "serviceName": {
                                "type": "string",
                                "title": "Service.Service Name",
                                "example": "Manual"
                            }
                        }
                    },
                    "trackingInfo": {
                        "type": "array",
                        "title": "Tracking Info",
                        "items": {
                            "type": "object",
                            "properties": {
                                "company": {
                                    "type": "string",
                                    "title": "Company",
                                    "example": "Other"
                                },
                                "number": {
                                    "type": "string",
                                    "title": "Number",
                                    "example": "GQL4-TRACK-1"
                                },
                                "url": {
                                    "type": "string",
                                    "title": "URL",
                                    "example": "https://tracking.example.com/GQL4-TRACK-1"
                                }
                            }
                        },
                        "example": [
                            {
                                "company": "Other",
                                "number": "GQL4-TRACK-1",
                                "url": null
                            }
                        ]
                    },
                    "lineItems": {
                        "type": "array",
                        "title": "Line Items",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "lineItem"
                            ],
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID",
                                    "example": "gid://shopify/FulfillmentLineItem/21197927153745"
                                },
                                "quantity": {
                                    "type": "integer",
                                    "title": "Quantity",
                                    "example": 2
                                },
                                "lineItem": {
                                    "type": "object",
                                    "title": "Line Item",
                                    "required": [
                                        "id",
                                        "name"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Line Item.ID",
                                            "example": "gid://shopify/LineItem/46373199315025"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Line Item.Name",
                                            "example": "gql4-probe custom item"
                                        },
                                        "sku": {
                                            "type": "string",
                                            "title": "Line Item.SKU",
                                            "example": "GQL4-1"
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "gid://shopify/FulfillmentLineItem/21197927153745",
                                "quantity": 2,
                                "lineItem": {
                                    "id": "gid://shopify/LineItem/46373199315025",
                                    "name": "gql4-probe custom item",
                                    "sku": "GQL4-1"
                                }
                            }
                        ]
                    },
                    "order": {
                        "type": "object",
                        "title": "Order",
                        "required": [
                            "id",
                            "legacyResourceId",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Order.ID",
                                "example": "gid://shopify/Order/17292422217809"
                            },
                            "legacyResourceId": {
                                "type": "string",
                                "title": "Order.Legacy Resource ID",
                                "example": "17292422217809"
                            },
                            "name": {
                                "type": "string",
                                "title": "Order.Name",
                                "example": "#1026"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
