{
    "name": "appmixer.bluesky.users.GetUserProfile",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Get User Profile",
    "description": "Retrieve the profile of a Bluesky user by their handle or DID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "xrpc",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "actor": {
                        "type": "string"
                    }
                },
                "required": [
                    "actor"
                ]
            },
            "inspector": {
                "inputs": {
                    "actor": {
                        "type": "text",
                        "index": 1,
                        "label": "Handle or DID",
                        "tooltip": "The handle (e.g. user.bsky.social) or DID of the user to look up."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "did": {
                        "type": "string",
                        "title": "DID",
                        "example": "did:plc:abc123xyz456abc123xyz456"
                    },
                    "handle": {
                        "type": "string",
                        "title": "Handle",
                        "example": "alice.bsky.social"
                    },
                    "displayName": {
                        "type": "string",
                        "title": "Display Name",
                        "example": "Alice"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Software engineer and Bluesky enthusiast."
                    },
                    "avatar": {
                        "type": "string",
                        "title": "Avatar URL",
                        "example": "https://cdn.bsky.app/img/avatar/plain/did:plc:abc123/bafkrei123"
                    },
                    "banner": {
                        "type": "string",
                        "title": "Banner URL",
                        "example": "https://cdn.bsky.app/img/banner/plain/did:plc:abc123/bafkrei456"
                    },
                    "followersCount": {
                        "type": "integer",
                        "title": "Followers Count",
                        "example": 42
                    },
                    "followsCount": {
                        "type": "integer",
                        "title": "Follows Count",
                        "example": 100
                    },
                    "postsCount": {
                        "type": "integer",
                        "title": "Posts Count",
                        "example": 500
                    },
                    "indexedAt": {
                        "type": "string",
                        "title": "Indexed At",
                        "example": "2024-01-15T12:00:00.000Z"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2023-06-01T10:00:00.000Z"
                    },
                    "associated": {
                        "type": "object",
                        "title": "Associated",
                        "example": {}
                    },
                    "viewer": {
                        "type": "object",
                        "title": "Viewer",
                        "example": {}
                    },
                    "labels": {
                        "type": "array",
                        "title": "Labels",
                        "example": []
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
