{
    "name": "appmixer.bluesky.users.FollowUser",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Follow User",
    "description": "Follow a user on Bluesky by their handle or DID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "actor": {
                        "type": "string"
                    }
                },
                "required": [
                    "actor"
                ]
            },
            "inspector": {
                "inputs": {
                    "actor": {
                        "type": "text",
                        "index": 1,
                        "label": "Handle or DID",
                        "tooltip": "The handle (e.g. user.bsky.social) or DID (e.g. did:plc:xxx) of the user to follow."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Follow URI",
                    "value": "uri",
                    "schema": {
                        "type": "string",
                        "example": "at://did:plc:abc123/app.bsky.graph.follow/xyz456"
                    }
                },
                {
                    "label": "Follow CID",
                    "value": "cid",
                    "schema": {
                        "type": "string",
                        "example": "bafyreib2abcdefghijklmnopqrstuvwxyz1234567890"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
