{
    "name": "appmixer.bluesky.actions.CreatePost",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Create Post",
    "description": "Create a new post on Bluesky. Text is limited to 300 characters. Facets (mentions and links) are auto-detected from the text.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": { "type": "string" },
                    "langs": { "type": "string" },
                    "replyUri": { "type": "string" }
                },
                "required": ["text"]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text content of the post. Maximum 300 characters. Mentions (@handle) and URLs are auto-detected."
                    },
                    "langs": {
                        "type": "text",
                        "index": 2,
                        "label": "Languages",
                        "tooltip": "Comma-separated BCP-47 language codes (e.g. en, es, fr). Optional."
                    },
                    "replyUri": {
                        "type": "text",
                        "index": 3,
                        "label": "Reply To Post URI",
                        "tooltip": "AT URI of the post to reply to (e.g. at://did:plc:xxx/app.bsky.feed.post/rkey). Leave empty for a top-level post."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Post URI", "value": "uri" },
                { "label": "Post CID", "value": "cid" },
                { "label": "Commit CID", "value": "commit.cid" },
                { "label": "Validation Status", "value": "validationStatus" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
