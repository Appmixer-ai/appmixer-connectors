{
  "name": "appmixer.bluesky.actions.DeletePost",
  "author": "Appmixer <info@appmixer.com>",
  "label": "Delete Post",
  "description": "Delete a post from Bluesky by its AT URI.",
  "version": "1.0.0",
  "auth": {
    "service": "appmixer:bluesky"
  },
  "quota": {
    "manager": "appmixer:bluesky",
    "resources": "writes",
    "scope": {
      "userId": "{{userId}}"
    }
  },
  "inPorts": [
    {
      "name": "in",
      "schema": {
        "type": "object",
        "properties": {
          "postUri": {
            "type": "string"
          }
        },
        "required": [
          "postUri"
        ]
      },
      "inspector": {
        "inputs": {
          "postUri": {
            "type": "text",
            "index": 1,
            "label": "Post URI",
            "tooltip": "The AT URI of the post to delete (e.g. at://did:plc:xxx/app.bsky.feed.post/rkey)."
          }
        }
      }
    }
  ],
  "outPorts": [
    {
      "name": "out",
      "options": [
        {
          "label": "Commit CID",
          "value": "commit.cid"
        }
      ]
    }
  ],
  "icon": "data:image/svg+xml;base64,"
}