{
    "flow": {
        "after-all": {
            "config": {
                "properties": {
                    "timeout": 30
                }
            },
            "source": {
                "in": {
                    "assert-response": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.AfterAll",
            "x": 992,
            "y": 16
        },
        "assert-response": {
            "config": {
                "transform": {
                    "in": {
                        "make-api-call": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{response-var}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "response-var": {
                                            "functions": [],
                                            "variable": "$.make-api-call.out.response"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "make-api-call": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 800,
            "y": 16
        },
        "make-api-call": {
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "lambda": {
                                    "method": "GET",
                                    "nsid": "app.bsky.actor.searchActorsTypeahead",
                                    "params": "{\"q\":\"{{{query-var}}}\",\"limit\":5}"
                                },
                                "modifiers": {
                                    "method": {},
                                    "nsid": {},
                                    "params": {
                                        "query-var": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.searchQuery"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.bluesky.core.MakeApiCall",
            "x": 448,
            "y": 16
        },
        "on-start": {
            "config": {},
            "source": {},
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16
        },
        "process-results": {
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "result": "{{{result-var}}}",
                                    "testCase": "E2E Bluesky - API Call"
                                },
                                "modifiers": {
                                    "recipients": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
