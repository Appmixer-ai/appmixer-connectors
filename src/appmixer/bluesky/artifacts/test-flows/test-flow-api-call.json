            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1184,
            "y": 16
        },
        "set-variables": {
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "name": "searchQuery",
                                                "text": "bsky",
