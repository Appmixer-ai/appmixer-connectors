{
    "name": "appmixer.bluesky.notifications.NewFollower",
    "author": "Appmixer <info@appmixer.com>",
    "label": "New Follower",
    "description": "Triggers when you receive a new follower on Bluesky.",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "xrpc",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Notification URI",
                    "value": "uri",
                    "schema": {
                        "type": "string",
                        "example": "at://did:plc:abc123/app.bsky.notification/xyz456"
                    }
                },
                {
                    "label": "Notification CID",
                    "value": "cid",
                    "schema": {
                        "type": "string",
                        "example": "bafyreib2abcdefghijklmnopqrstuvwxyz1234567890"
                    }
                },
                {
                    "label": "Reason",
                    "value": "reason",
                    "schema": {
                        "type": "string",
                        "example": "follow"
                    }
                },
                {
                    "label": "Follower DID",
                    "value": "author.did",
                    "schema": {
                        "type": "string",
                        "example": "did:plc:abc123xyz456abc123xyz456"
                    }
                },
                {
                    "label": "Follower Handle",
                    "value": "author.handle",
                    "schema": {
                        "type": "string",
                        "example": "alice.bsky.social"
                    }
                },
                {
                    "label": "Follower Display Name",
                    "value": "author.displayName",
                    "schema": {
                        "type": "string",
                        "example": "Alice"
                    }
                },
                {
                    "label": "Follower Avatar",
                    "value": "author.avatar",
                    "schema": {
                        "type": "string",
                        "example": "https://cdn.bsky.app/img/avatar/plain/did:plc:abc123/bafkrei123"
                    }
                },
                {
                    "label": "Indexed At",
                    "value": "indexedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T12:00:00.000Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
