{
    "name": "appmixer.bluesky.posts.LikePost",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Like Post",
    "description": "Like a post on Bluesky.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "writes",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "postUri": {
                        "type": "string"
                    }
                },
                "required": [
                    "postUri"
                ]
            },
            "inspector": {
                "inputs": {
                    "postUri": {
                        "type": "text",
                        "index": 1,
                        "label": "Post URI",
                        "tooltip": "The AT URI of the post to like (e.g. at://did:plc:xxx/app.bsky.feed.post/rkey)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Like URI",
                    "value": "uri",
                    "schema": {
                        "type": "string",
                        "example": "at://did:plc:abc123/app.bsky.feed.like/xyz456"
                    }
                },
                {
                    "label": "Like CID",
                    "value": "cid",
                    "schema": {
                        "type": "string",
                        "example": "bafyreib2abcdefghijklmnopqrstuvwxyz1234567890"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
