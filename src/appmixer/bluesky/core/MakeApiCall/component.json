{
    "name": "appmixer.bluesky.core.MakeApiCall",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Make API Call",
    "description": "Make a custom XRPC API call to the Bluesky/AT Protocol API. Use this for advanced operations not covered by other components.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:bluesky"
    },
    "quota": {
        "manager": "appmixer:bluesky",
        "resources": "xrpc",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "method": {
                        "type": "string"
                    },
                    "nsid": {
                        "type": "string"
                    },
                    "params": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "method",
                    "nsid"
                ]
            },
            "inspector": {
                "inputs": {
                    "method": {
                        "type": "select",
                        "index": 1,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            }
                        ]
                    },
                    "nsid": {
                        "type": "text",
                        "index": 2,
                        "label": "NSID (Endpoint)",
                        "tooltip": "The AT Protocol NSID of the endpoint to call (e.g. app.bsky.actor.getProfile)."
                    },
                    "params": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Query Parameters (JSON)",
                        "tooltip": "JSON object of query parameters for GET requests (e.g. {\"actor\": \"user.bsky.social\"}). Optional."
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Request Body (JSON)",
                        "tooltip": "JSON object for the POST request body. Optional."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Response",
                    "value": "response"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
