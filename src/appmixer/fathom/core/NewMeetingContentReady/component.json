{
    "name": "appmixer.fathom.core.NewMeetingContentReady",
    "label": "New Meeting Content Ready",
    "description": "Triggers when Fathom finishes processing a meeting and its content (summary, transcript, action items) is ready. Registers a Fathom webhook when the flow starts and removes it when the flow stops.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:fathom"
    },
    "quota": {
        "manager": "appmixer:fathom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "triggeredFor": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "includeSummary": { "type": "boolean" },
                "includeTranscript": { "type": "boolean" },
                "includeActionItems": { "type": "boolean" },
                "includeCrmMatches": { "type": "boolean" }
            },
            "required": ["triggeredFor"]
        },
        "inspector": {
            "inputs": {
                "triggeredFor": {
                    "type": "multiselect",
                    "label": "Triggered For",
                    "index": 1,
                    "tooltip": "Which recordings should trigger this webhook.",
                    "options": [
                        { "label": "My recordings", "value": "my_recordings" },
                        { "label": "Shared external recordings", "value": "shared_external_recordings" },
                        { "label": "My recordings shared with team", "value": "my_shared_with_team_recordings" },
                        { "label": "Shared team recordings", "value": "shared_team_recordings" }
                    ]
                },
                "includeSummary": {
                    "type": "toggle",
                    "label": "Include Summary",
                    "index": 2,
                    "tooltip": "Include the AI summary in the webhook payload. May be unavailable for OAuth applications."
                },
                "includeTranscript": {
                    "type": "toggle",
                    "label": "Include Transcript",
                    "index": 3,
                    "tooltip": "Include the transcript in the webhook payload. May be unavailable for OAuth applications."
                },
                "includeActionItems": {
                    "type": "toggle",
                    "label": "Include Action Items",
                    "index": 4,
                    "tooltip": "Include action items in the webhook payload."
                },
                "includeCrmMatches": {
                    "type": "toggle",
                    "label": "Include CRM Matches",
                    "index": 5,
                    "tooltip": "Include CRM matches (contacts, companies, deals) in the webhook payload."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "recording_id": { "type": "integer", "title": "Recording ID", "example": 123456 },
                    "title": { "type": "string", "title": "Title", "example": "Acme <> Fathom — Weekly Sync" },
                    "meeting_title": { "type": "string", "title": "Meeting Title", "example": "Weekly Sync" },
                    "meeting_type": { "type": "string", "title": "Meeting Type", "example": "external" },
                    "url": { "type": "string", "title": "URL", "example": "https://fathom.video/calls/123456" },
                    "share_url": { "type": "string", "title": "Share URL", "example": "https://fathom.video/share/abc123" },
                    "created_at": { "type": "string", "format": "date-time", "title": "Created At", "example": "2026-01-15T10:30:00Z" },
                    "recording_start_time": { "type": "string", "format": "date-time", "title": "Recording Start Time", "example": "2026-01-15T10:02:00Z" },
                    "recording_end_time": { "type": "string", "format": "date-time", "title": "Recording End Time", "example": "2026-01-15T10:29:00Z" },
                    "transcript_language": { "type": "string", "title": "Transcript Language", "example": "en" },
                    "recorded_by": {
                        "type": "object",
                        "title": "Recorded By",
                        "properties": {
                            "name": { "type": "string", "example": "Jane Doe" },
                            "email": { "type": "string", "example": "jane.doe@example.com" }
                        }
                    },
                    "default_summary": { "type": "string", "title": "Default Summary", "example": "## Key Takeaways\n- Renewal on track" },
                    "action_items": {
                        "type": "array",
                        "title": "Action Items",
                        "items": { "type": "object" },
                        "example": [
                            {
                                "description": "Send renewal quote to Acme",
                                "completed": false,
                                "assignee": { "name": "Jane Doe", "email": "jane.doe@example.com" }
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
