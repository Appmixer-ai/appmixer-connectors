{
    "name": "appmixer.fathom.core.GetMeetingSummary",
    "label": "Get Meeting Summary",
    "description": "Retrieve the AI summary for a recording. The summary markdown is English-only. This endpoint is subject to Fathom's heavy rate limit.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fathom"
    },
    "quota": {
        "manager": "appmixer:fathom",
        "resources": "heavy",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "recordingId": { "type": "integer" }
                },
                "required": ["recordingId"]
            },
            "inspector": {
                "inputs": {
                    "recordingId": {
                        "type": "number",
                        "label": "Recording ID",
                        "index": 1,
                        "tooltip": "The recording ID of the meeting (the recording_id field returned by List/Find Meetings)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "template_name": { "type": "string", "title": "Template Name", "example": "General" },
                    "markdown_formatted": { "type": "string", "title": "Summary (Markdown)", "example": "## Meeting Purpose\n- Weekly sync between Acme and Fathom\n\n## Key Takeaways\n- Renewal on track" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
