{
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "taskTitle",
                                                "text": "E2E Test Task"
                                            },
                                            {
                                                "type": "text",
                                                "name": "taskDescription",
                                                "text": "E2E Test Task Description"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedTitle",
                                                "text": "E2E Test Task Updated"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedDescription",
                                                "text": "E2E Test Task Description Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-task": {
            "type": "appmixer.freshsales.core.CreateTask",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "title": {
                                        "var-task-title": {
                                            "variable": "$.set-variables.out.taskTitle",
                                            "functions": []
                                        }
                                    },
                                    "description": {
                                        "var-task-desc": {
                                            "variable": "$.set-variables.out.taskDescription",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "title": "{{{var-task-title}}}",
                                    "description": "{{{var-task-desc}}}",
                                    "task_type": "Follow-up",
                                    "priority": "Medium",
                                    "status": "Open"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-create-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        },
                                        "field-create-title": {
                                            "variable": "$.create-task.out.title",
                                            "functions": []
                                        },
                                        "expected-title": {
                                            "variable": "$.set-variables.out.taskTitle",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-create-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-create-title}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-title}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
