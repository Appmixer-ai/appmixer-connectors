{
    "name": "appmixer.facebook.page.DeletePagePost",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Delete Page Post",
    "description": "Delete a post published by a Facebook Page you manage.",
    "auth": {
        "service": "appmixer:facebook",
        "scope": [
            "pages_manage_posts",
            "pages_read_engagement"
        ]
    },
    "quota": {
        "manager": "appmixer:facebook",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "pageId": {
                        "type": "string"
                    },
                    "postId": {
                        "type": "string"
                    }
                },
                "required": [
                    "postId"
                ]
            },
            "inspector": {
                "inputs": {
                    "pageId": {
                        "type": "text",
                        "label": "Page",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/facebook/page/ListPages?outPort=pages",
                            "data": {
                                "transform": "./ListPages#toSelectArray"
                            }
                        },
                        "tooltip": "The page that published the post. When left empty, the page is taken from the Post ID (its part before the underscore)."
                    },
                    "postId": {
                        "type": "text",
                        "label": "Post ID",
                        "index": 2,
                        "tooltip": "ID of the post to delete, for example <code>107198938765432_122101234567890123</code>. Use the ID output of Create Page Post or Find Page Posts."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
