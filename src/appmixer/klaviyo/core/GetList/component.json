{
    "name": "appmixer.klaviyo.core.GetList",
    "label": "Get List",
    "description": "Retrieve details about a specific list",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "listId": {
                        "type": "string",
                        "title": "List ID"
                    }
                },
                "required": ["listId"]
            },
            "inspector": {
                "inputs": {
                    "listId": {
                        "type": "text",
                        "index": 1,
                        "label": "List ID",
                        "tooltip": "ID of the list to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "List ID", "value": "data.id" },
                { "label": "List Type", "value": "data.type" },
                { "label": "Name", "value": "data.attributes.name" },
                { "label": "Created", "value": "data.attributes.created" },
                { "label": "Updated", "value": "data.attributes.updated" },
                { "label": "Opt In Process", "value": "data.attributes.opt_in_process" }
            ]
        }
    ],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
