{
    "name": "appmixer.klaviyo.core.SendCampaign",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Trigger sending of an email campaign to its target audience.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "sendTime": {
                        "type": "string"
                    }
                },
                "required": ["id"]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Unique identifier of the campaign to send.",
                        "label": "Id",
                        "index": 0
                    },
                    "sendTime": {
                        "type": "text",
                        "tooltip": "Optional scheduled send time in ISO 8601 format.",
                        "label": "Send Time",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sent At",
                    "value": "sentAt",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}