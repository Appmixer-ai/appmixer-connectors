{
    "name": "appmixer.klaviyo.core.CreateList",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new static list for organizing customer profiles.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
