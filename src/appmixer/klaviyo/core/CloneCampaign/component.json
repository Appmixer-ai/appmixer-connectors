{
    "name": "appmixer.klaviyo.core.CloneCampaign",
    "label": "Clone Campaign",
    "description": "Create a copy of an existing campaign",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string",
                        "title": "Campaign ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "New Campaign Name"
                    }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1,
                        "tooltip": "ID of the campaign to clone"
                    },
                    "name": {
                        "type": "text",
                        "label": "New Campaign Name",
                        "index": 2,
                        "tooltip": "Name for the cloned campaign (optional)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Campaign ID", "value": "data.id" },
                { "label": "Campaign Type", "value": "data.type" },
                { "label": "Name", "value": "data.attributes.name" },
                { "label": "Subject", "value": "data.attributes.subject" },
                { "label": "Created", "value": "data.attributes.created_at" },
                { "label": "Updated", "value": "data.attributes.updated_at" }
            ]
        }
    ],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
