{
    "name": "appmixer.klaviyo.core.CreateEvent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Track a custom event for a customer profile, such as a purchase or page view.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "profileId": {
                        "type": "string"
                    },
                    "profileEmail": {
                        "type": "string"
                    },
                    "metricName": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "string"
                    },
                    "time": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "profileId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the customer profile. Either profileId or profileEmail is required.",
                        "label": "Profile Id",
                        "index": 0
                    },
                    "profileEmail": {
                        "type": "text",
                        "tooltip": "Email address of the customer profile (as an alternative to profileId).",
                        "label": "Profile Email",
                        "index": 1
                    },
                    "metricName": {
                        "type": "text",
                        "tooltip": "Name of the event or metric to be tracked.",
                        "label": "Metric Name",
                        "index": 2
                    },
                    "properties": {
                        "type": "text",
                        "tooltip": "Additional event properties in key-value format (optional).",
                        "label": "Properties",
                        "index": 3
                    },
                    "time": {
                        "type": "text",
                        "tooltip": "Timestamp of the event in ISO 8601 format (optional).",
                        "label": "Time",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Metric Name",
                    "value": "metricName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Timestamp",
                    "value": "timestamp",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}