{
    "name": "appmixer.klaviyo.core.CreateCampaign",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new email campaign with specified details including name, subject, template, and target list IDs.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "templateId": {
                        "type": "string"
                    }
                },
                "required": ["name", "subject"]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Name of the campaign.",
                        "label": "Name",
                        "index": 0
                    },
                    "subject": {
                        "type": "text",
                        "tooltip": "Subject line of the email campaign.",
                        "label": "Subject",
                        "index": 1
                    },
                    "templateId": {
                        "type": "text",
                        "tooltip": "Identifier for the email template.",
                        "label": "Template Id",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Subject",
                    "value": "subject",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
