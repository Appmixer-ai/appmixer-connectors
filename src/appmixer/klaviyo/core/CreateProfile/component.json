{
    "name": "appmixer.klaviyo.core.CreateProfile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Add a new customer profile with email, phone number, name, and custom properties.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "tooltip": "Email address of the profile (required).",
                        "label": "Email",
                        "index": 0
                    },
                    "phoneNumber": {
                        "type": "text",
                        "tooltip": "Phone number of the profile (optional).",
                        "label": "Phone Number",
                        "index": 1
                    },
                    "firstName": {
                        "type": "text",
                        "tooltip": "First name of the customer (optional).",
                        "label": "First Name",
                        "index": 2
                    },
                    "lastName": {
                        "type": "text",
                        "tooltip": "Last name of the customer (optional).",
                        "label": "Last Name",
                        "index": 3
                    },
                    "properties": {
                        "type": "text",
                        "tooltip": "A key-value object of custom attributes (optional).",
                        "label": "Properties",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Phone Number",
                    "value": "phoneNumber",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Properties",
                    "value": "properties",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "custom_key": {
                                "type": "string",
                                "title": "Properties.Custom Key"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}