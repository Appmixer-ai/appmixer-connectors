{
    "name": "appmixer.klaviyo.core.GetProfile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific customer profile by its ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Unique identifier of the customer profile.",
                        "label": "Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "last_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Phone Number",
                    "value": "phone_number",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Properties",
                    "value": "properties",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "custom_key": {
                                "type": "string",
                                "title": "Properties.Custom Key"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}