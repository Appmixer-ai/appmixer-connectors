{
    "name": "appmixer.klaviyo.core.CancelCampaignSend",
    "label": "Cancel Campaign Send",
    "description": "Cancel a campaign send job",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string",
                        "title": "Campaign ID"
                    }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1,
                        "tooltip": "ID of the campaign send job to cancel"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Send Job ID", "value": "data.id" },
                { "label": "Send Job Type", "value": "data.type" },
                { "label": "Job Updated", "value": "data.attributes.updated_at" }
            ]
        }
    ],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
