{
    "name": "appmixer.klaviyo.core.ListListProfiles",
    "label": "List List Profiles",
    "description": "Get profiles in a specific list",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "listId": {
                        "type": "string",
                        "title": "List ID"
                    },
                    "pageSize": {
                        "type": "number",
                        "title": "Page Size",
                        "minimum": 1,
                        "maximum": 100,
                        "default": 20
                    }
                },
                "required": ["listId"]
            },
            "inspector": {
                "inputs": {
                    "listId": {
                        "type": "text",
                        "index": 1,
                        "label": "List ID",
                        "tooltip": "ID of the list"
                    },
                    "pageSize": {
                        "type": "number",
                        "index": 2,
                        "label": "Page Size",
                        "tooltip": "Number of profiles to return (1-100, default: 20)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Profiles", "value": "data" },
                { "label": "Links", "value": "links" }
            ]
        }
    ],
    "icon": "data:image/png;base64,",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
