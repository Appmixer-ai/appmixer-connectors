{
    "name": "appmixer.klaviyo.core.ListSegmentProfiles",
    "label": "List Segment Profiles",
    "description": "Get profiles in a specific segment",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "segmentId": {
                        "type": "string",
                        "title": "Segment ID"
                    },
                    "pageSize": {
                        "type": "number",
                        "title": "Page Size",
                        "minimum": 1,
                        "maximum": 100,
                        "default": 20
                    }
                },
                "required": ["segmentId"]
            },
            "inspector": {
                "inputs": {
                    "segmentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Segment ID",
                        "tooltip": "ID of the segment"
                    },
                    "pageSize": {
                        "type": "number",
                        "index": 2,
                        "label": "Page Size",
                        "tooltip": "Number of profiles to return (1-100, default: 20)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Profiles", "value": "data" },
                { "label": "Links", "value": "links" }
            ]
        }
    ],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
