{
    "name": "appmixer.klaviyo.core.DeleteCampaign",
    "label": "Delete Campaign",
    "description": "Delete a campaign permanently",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string",
                        "title": "Campaign ID"
                    }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "ID of the campaign to delete"
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": ["api"],
        "scope": {
            "userId": "{{userId}}"
        }
    }
}
