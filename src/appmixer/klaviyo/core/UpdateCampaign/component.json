{
    "name": "appmixer.klaviyo.core.UpdateCampaign",
    "label": "Update Campaign",
    "description": "Update an existing campaign",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:klaviyo"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string",
                        "title": "Campaign ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Campaign Name"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject"
                    },
                    "fromEmail": {
                        "type": "string",
                        "format": "email",
                        "title": "From Email"
                    },
                    "fromName": {
                        "type": "string",
                        "title": "From Name"
                    },
                    "replyToEmail": {
                        "type": "string",
                        "format": "email",
                        "title": "Reply To Email"
                    },
                    "isSkippable": {
                        "type": "boolean",
                        "title": "Is Skippable"
                    }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "index": 1,
                        "label": "Campaign ID",
                        "tooltip": "ID of the campaign to update"
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Campaign Name",
                        "tooltip": "Campaign name"
                    },
                    "subject": {
                        "type": "text",
                        "index": 3,
                        "label": "Subject",
                        "tooltip": "Email subject line"
                    },
                    "fromEmail": {
                        "type": "text",
                        "index": 4,
                        "label": "From Email",
                        "tooltip": "Sender email address"
                    },
                    "fromName": {
                        "type": "text",
                        "index": 5,
                        "label": "From Name",
                        "tooltip": "Sender name"
                    },
                    "replyToEmail": {
                        "type": "text",
                        "index": 6,
                        "label": "Reply To Email",
                        "tooltip": "Reply-to email address"
                    },
                    "isSkippable": {
                        "type": "checkbox",
                        "index": 7,
                        "label": "Is Skippable",
                        "tooltip": "Whether the campaign can be skipped"
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "https://cdn.appmixer.com/connectors/klaviyo/klaviyo.svg",
    "quota": {
        "manager": "appmixer:klaviyo",
        "resources": "requests"
    }
}
