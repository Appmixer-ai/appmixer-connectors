{
    "actions": [
        {
            "title": "CreateProfile",
            "description": "Add a new customer profile with email, phone number, name, and custom properties.",
            "type": "action",
            "documentation": "https://developers.klaviyo.com/en/reference/api_overview",
            "endpointUrl": "/profiles",
            "apiBaseUrl": "https://a.klaviyo.com/api",
            "method": "POST",
            "sampleResponse": {
                "id": "profile_id",
                "email": "user@example.com",
                "first_name": "John",
                "last_name": "Doe",
                "phone_number": "+1234567890",
                "properties": {
                    "custom_key": "custom_value"
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "Input schema for creating a customer profile.",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email address of the profile (required)."
                    },
                    "phone_number": {
                        "type": "string",
                        "description": "Phone number of the profile (optional)."
                    },
                    "first_name": {
                        "type": "string",
                        "description": "First name of the customer (optional)."
                    },
                    "last_name": {
                        "type": "string",
                        "description": "Last name of the customer (optional)."
                    },
                    "properties": {
                        "type": "object",
                        "description": "A key-value object of custom attributes (optional)."
                    }
                },
                "required": [
                    "email"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
