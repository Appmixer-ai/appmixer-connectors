        {
            "title": "CreateEvent",
            "description": "Track a custom event for a customer profile, such as a purchase or page view.",
            "type": "action",
            "documentation": "https://developers.klaviyo.com/en/reference/api_overview",
            "endpointUrl": "/events",
            "apiBaseUrl": "https://a.klaviyo.com/api",
            "method": "POST",
            "sampleResponse": {
                "id": "event_id",
                "metric_name": "Purchase",
                "timestamp": "2024-10-15T12:00:00Z"
            },
            "inputSchema": {
                "type": "object",
                "description": "Input schema for tracking a custom event.",
                "properties": {
                    "profile_id": {
                        "type": "string",
                        "description": "Unique identifier of the customer profile. Either profile_id or profile_email is required."
                    },
                    "profile_email": {
                        "type": "string",
                        "description": "Email address of the customer profile (as an alternative to profile_id)."
                    },
                    "metric_name": {
                        "type": "string",
                        "description": "Name of the event or metric to be tracked."
                    },
                    "properties": {
                        "type": "object",
                        "description": "Additional event properties in key-value format (optional)."
                    },
                    "time": {
                        "type": "string",
                        "description": "Timestamp of the event in ISO 8601 format (optional)."
                    }
                },
                "required": [
                    "metric_name"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        }
