        {
            "title": "SendCampaign",
            "description": "Trigger sending of an email campaign to its target audience.",
            "type": "action",
            "documentation": "https://developers.klaviyo.com/en/reference/api_overview",
            "endpointUrl": "/campaigns/{id}/send",
            "apiBaseUrl": "https://a.klaviyo.com/api",
            "method": "POST",
            "sampleResponse": {
                "status": "sent",
                "sent_at": "2024-10-15T12:00:00Z"
            },
            "inputSchema": {
                "type": "object",
                "description": "Input schema for sending an email campaign.",
                "properties": {
                    "id": {
                        "type": "string",
