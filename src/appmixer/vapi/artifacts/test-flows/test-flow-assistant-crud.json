                                    },
                                    "firstMessage": {
                                        "var-first-msg": {
                                            "variable": "$.set-variables.out.firstMessage",
                                            "functions": []
                                        }
                                    },
                                    "model": {},
                                    "voice": {}
                                },
                                "lambda": {
                                    "name": "{{{var-name}}}",
                                    "firstMessage": "{{{var-first-msg}}}",
                                    "model": "{\n    \"provider\": \"openai\",\n    \"model\": \"gpt-4o-mini\",\n    \"temperature\": 0.7,\n    \"messages\": [\n      {\n        \"role\": \"system\",\n        \"content\": \"You are a helpful customer support assistant. Answer politely and clearly.\"\n      }\n    ]\n  }",
                                    "voice": "{\n    \"provider\": \"11labs\",\n    \"voiceId\": \"t0jbNlBVZ17f02VDIeMI\"\n  }"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1216,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-assistant": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-assistant": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-id": {
                                            "variable": "$.create-assistant.out.id",
                                            "functions": []
                                        },
                                        "check-name": {
                                            "variable": "$.create-assistant.out.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.assistantName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "type": "string",
                                                "assertion": "notEmpty",
                                                "field": "{{{check-id}}}"
                                            },
                                            {
                                                "expected": "{{{expected-name}}}",
                                                "assertion": "equal",
                                                "field": "{{{check-name}}}",
                                                "type": "string"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
