{
    "name": "E2E Vapi - squad-crud",
    "description": "End-to-end test for Vapi connector - tests squad CRUD operations (Create, Get, Update, Delete)",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 272,
            "y": 16,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "squadName",
                                                "text": "E2E Test Squad"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedSquadName",
                                                "text": "E2E Test Squad Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-squad": {
            "type": "appmixer.vapi.core.CreateSquad",
            "x": 464,
            "y": 16,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {
                                        "var-squad-name": {
                                            "variable": "$.set-variables.out.squadName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "name": "{{{var-squad-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "source": {
                "in": {
                    "create-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "create-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "squad-id-check": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        },
                                        "squad-name-check": {
                                            "variable": "$.create-squad.out.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.squadName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{squad-id-check}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{squad-name-check}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-squad": {
            "type": "appmixer.vapi.core.GetSquad",
            "x": 656,
            "y": 144,
            "source": {
                "in": {
                    "create-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "create-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "squadId": {
                                        "var-squad-id": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "squadId": "{{{var-squad-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "source": {
                "in": {
                    "get-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "get-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "retrieved-id": {
                                            "variable": "$.get-squad.out.id",
                                            "functions": []
                                        },
                                        "created-id": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        },
                                        "retrieved-name": {
                                            "variable": "$.get-squad.out.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.squadName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{retrieved-id}}}",
                                                "assertion": "equal",
                                                "expected": "{{{created-id}}}"
                                            },
                                            {
                                                "field": "{{{retrieved-name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-squad": {
            "type": "appmixer.vapi.core.UpdateSquad",
            "x": 848,
            "y": 272,
            "source": {
                "in": {
                    "get-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "get-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "squadId": {
                                        "var-squad-id": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        }
                                    },
                                    "name": {
                                        "var-updated-name": {
                                            "variable": "$.set-variables.out.updatedSquadName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "squadId": "{{{var-squad-id}}}",
                                    "name": "{{{var-updated-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-updated-squad": {
            "type": "appmixer.vapi.core.GetSquad",
            "x": 1040,
            "y": 400,
            "source": {
                "in": {
                    "update-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "update-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "squadId": {
                                        "var-squad-id": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "squadId": "{{{var-squad-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "source": {
                "in": {
                    "get-updated-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "get-updated-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "updated-name": {
                                            "variable": "$.get-updated-squad.out.name",
                                            "functions": []
                                        },
                                        "expected-updated-name": {
                                            "variable": "$.set-variables.out.updatedSquadName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{updated-name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-updated-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-squad": {
            "type": "appmixer.vapi.core.DeleteSquad",
            "x": 1616,
            "y": 144,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "squadId": {
                                        "var-squad-id": {
                                            "variable": "$.create-squad.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "squadId": "{{{var-squad-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1792,
            "y": 144,
            "source": {
                "in": {
                    "delete-squad": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-squad": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Vapi - squad-crud",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}