{
    "name": "appmixer.vapi.core.CreateAssistant",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new assistant in Vapi.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:vapi"
    },
    "quota": {
        "manager": "appmixer:vapi",
        "resources": "vapi.api",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "firstMessage": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    },
                    "voice": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Name of the assistant"
                    },
                    "firstMessage": {
                        "type": "textarea",
                        "index": 2,
                        "label": "First Message",
                        "tooltip": "The first message the assistant will say"
                    },
                    "model": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Model Configuration (JSON)",
                        "tooltip": "JSON configuration for the AI model"
                    },
                    "voice": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Voice Configuration (JSON)",
                        "tooltip": "JSON configuration for the voice"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Assistant ID",
                    "value": "id"
                },
                {
                    "label": "Organization ID",
                    "value": "orgId"
                },
                {
                    "label": "Assistant Name",
                    "value": "name"
                },
                {
                    "label": "Created At",
                    "value": "createdAt"
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}