{
    "name": "appmixer.vapi.core.CreatePhoneCall",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new phone call with Vapi.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:vapi"
    },
    "quota": {
        "manager": "appmixer:vapi",
        "resources": "vapi.api",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "phoneNumberId": {
                        "type": "string"
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "assistantId": {
                        "type": "string"
                    },
                    "squadId": {
                        "type": "string"
                    }
                },
                "required": [
                    "phoneNumberId",
                    "customerId",
                    "assistantId"
                ]
            },
            "inspector": {
                "inputs": {
                    "phoneNumberId": {
                        "type": "text",
                        "index": 1,
                        "label": "Phone Number ID",
                        "tooltip": "ID of the phone number to use for the call."
                    },
                    "customerId": {
                        "type": "text",
                        "index": 2,
                        "label": "Customer ID",
                        "tooltip": "ID of the customer to call."
                    },
                    "assistantId": {
                        "type": "text",
                        "index": 3,
                        "label": "Assistant ID",
                        "tooltip": "ID of the assistant to use for the call."
                    },
                    "squadId": {
                        "type": "text",
                        "index": 4,
                        "label": "Squad ID",
                        "tooltip": "ID of the squad to use for the call."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "ID", "value": "id" },
                { "label": "Organization ID", "value": "orgId" },
                { "label": "Type", "value": "type" },
                { "label": "Status", "value": "status" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
