{
    "name": "appmixer.vapi.core.FindAssistants",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Search for assistants in your Vapi account. Returns a list of assistants matching the specified criteria. This component will return a maximum of 100 records per request.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vapi"
    },
    "quota": {
        "manager": "appmixer:vapi",
        "resources": "vapi.api",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "orgId": {
                        "type": "string"
                    },
                    "createdAtGt": {
                        "type": "string"
                    },
                    "createdAtLt": {
                        "type": "string"
                    },
                    "updatedAtGt": {
                        "type": "string"
                    },
                    "updatedAtLt": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "orgId": {
                        "type": "text",
                        "tooltip": "Filter assistants by organization ID.",
                        "label": "Org Id",
                        "index": 1
                    },
                    "createdAtGt": {
                        "type": "date-time",
                        "label": "Created At Greater Than",
                        "index": 2,
                        "tooltip": "Return items where createdAt is greater than this datetime (ISO 8601 format)."
                    },
                    "createdAtLt": {
                        "type": "date-time",
                        "label": "Created At Less Than",
                        "index": 3,
                        "tooltip": "Return items where createdAt is less than this datetime (ISO 8601 format)."
                    },
                    "updatedAtGt": {
                        "type": "date-time",
                        "label": "Updated At Greater Than",
                        "index": 4,
                        "tooltip": "Return items where updatedAt is greater than this datetime (ISO 8601 format)."
                    },
                    "updatedAtLt": {
                        "type": "date-time",
                        "label": "Updated At Less Than",
                        "index": 5,
                        "tooltip": "Return items where updatedAt is less than this datetime (ISO 8601 format)."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 6,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/vapi/core/FindAssistants?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
