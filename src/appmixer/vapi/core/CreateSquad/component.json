{
    "name": "appmixer.vapi.core.CreateSquad",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new squad in Vapi.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:vapi"
    },
    "quota": {
        "manager": "appmixer:vapi",
        "resources": "vapi.api",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "members": {
                        "type": "array"
                    }
                },
                "required": ["name"]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Name of the squad"
                    },
                    "members": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Members (JSON Array)",
                        "tooltip": "JSON array of squad members. Example: [{\"id\": \"member-1\", \"name\": \"John\"}]"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "ID", "value": "id" },
                { "label": "Organization ID", "value": "orgId" },
                { "label": "Name", "value": "name" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
