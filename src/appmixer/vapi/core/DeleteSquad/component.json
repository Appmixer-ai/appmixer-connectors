{
    "name": "appmixer.vapi.core.DeleteSquad",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Delete a squad from Vapi.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:vapi"
    },
    "quota": {
        "manager": "appmixer:vapi",
        "resources": "vapi.api",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "squadId": {
                        "type": "string"
                    }
                },
                "required": ["squadId"]
            },
            "inspector": {
                "inputs": {
                    "squadId": {
                        "type": "text",
                        "index": 1,
                        "label": "Squad ID",
                        "tooltip": "The unique identifier of the squad to delete"
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
