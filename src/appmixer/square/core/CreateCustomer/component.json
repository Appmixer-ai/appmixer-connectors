{
    "name": "appmixer.square.core.CreateCustomer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new customer profile in Square.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:square"
    },
    "quota": {
        "manager": "appmixer:square",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "given_name": {
                        "type": "string"
                    },
                    "family_name": {
                        "type": "string"
                    },
                    "email_address": {
                        "type": "string"
                    },
                    "phone_number": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "given_name": {
                        "type": "text",
                        "tooltip": "The first name of the customer.",
                        "label": "Given Name",
                        "index": 0
                    },
                    "family_name": {
                        "type": "text",
                        "tooltip": "The last name of the customer.",
                        "label": "Family Name",
                        "index": 1
                    },
                    "email_address": {
                        "type": "text",
                        "tooltip": "The email address of the customer.",
                        "label": "Email Address",
                        "index": 2
                    },
                    "phone_number": {
                        "type": "text",
                        "tooltip": "The phone number of the customer.",
                        "label": "Phone Number",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Customer",
                    "value": "customer",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Customer.Id"
                            },
                            "given_name": {
                                "type": "string",
                                "title": "Customer.Given Name"
                            },
                            "family_name": {
                                "type": "string",
                                "title": "Customer.Family Name"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}