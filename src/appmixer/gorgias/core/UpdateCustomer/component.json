{
    "name": "appmixer.gorgias.core.UpdateCustomer",
    "label": "Update Customer",
    "description": "Update the email, name, external ID, language or timezone of a customer. Empty fields are left unchanged.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "externalId": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer ID",
                        "tooltip": "The numeric ID of the customer, e.g. from Create Customer or Find Customers."
                    },
                    "email": {
                        "type": "text",
                        "index": 2,
                        "label": "Email",
                        "tooltip": "Primary email address of the customer."
                    },
                    "name": {
                        "type": "text",
                        "index": 3,
                        "label": "Name",
                        "tooltip": "Full name of the customer."
                    },
                    "externalId": {
                        "type": "text",
                        "index": 4,
                        "label": "External ID",
                        "tooltip": "ID of the customer in another system, e.g. your store or CRM."
                    },
                    "language": {
                        "type": "text",
                        "index": 5,
                        "label": "Language",
                        "tooltip": "Preferred language as an ISO 639-1 code, e.g. <code>en</code> or <code>fr</code>."
                    },
                    "timezone": {
                        "type": "text",
                        "index": 6,
                        "label": "Timezone",
                        "tooltip": "Preferred timezone as an IANA name, e.g. <code>Europe/Paris</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
