{
    "name": "appmixer.gorgias.core.FindTickets",
    "label": "Find Tickets",
    "description": "Find tickets of a customer, of a view or with an external ID, newest first. Returns at most 100 tickets (one page); narrow the filters if the ticket you need is not among them.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "viewId": {
                        "type": "string"
                    },
                    "externalId": {
                        "type": "string"
                    },
                    "includeTrashed": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer ID",
                        "tooltip": "Return the tickets of this customer (numeric ID, e.g. from Find Customers)."
                    },
                    "viewId": {
                        "type": "text",
                        "index": 2,
                        "label": "View",
                        "tooltip": "Return the tickets that match the filters of this view. Pick a view or type its numeric ID.",
                        "source": {
                            "url": "/component/appmixer/gorgias/core/ListViews?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListViews#toSelectArray"
                            }
                        }
                    },
                    "externalId": {
                        "type": "text",
                        "index": 3,
                        "label": "External ID",
                        "tooltip": "Return the tickets with this external ID."
                    },
                    "includeTrashed": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Include Trashed Tickets",
                        "defaultValue": false,
                        "tooltip": "Also return tickets that were moved to the trash."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 5,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/gorgias/core/FindTickets?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
