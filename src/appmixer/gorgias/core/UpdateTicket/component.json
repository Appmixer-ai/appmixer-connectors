{
    "name": "appmixer.gorgias.core.UpdateTicket",
    "label": "Update Ticket",
    "description": "Update the subject, status, priority, assignee or external ID of a ticket. Empty fields are left unchanged.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "assigneeUserId": {
                        "type": "string"
                    },
                    "externalId": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "index": 1,
                        "label": "Ticket ID",
                        "tooltip": "The numeric ID of the ticket, e.g. from Create Ticket or Find Tickets."
                    },
                    "subject": {
                        "type": "text",
                        "index": 2,
                        "label": "Subject",
                        "tooltip": "Subject of the ticket."
                    },
                    "status": {
                        "type": "select",
                        "index": 3,
                        "label": "Status",
                        "tooltip": "Status of the ticket.",
                        "options": [
                            {
                                "label": "Open",
                                "value": "open"
                            },
                            {
                                "label": "Closed",
                                "value": "closed"
                            }
                        ]
                    },
                    "priority": {
                        "type": "select",
                        "index": 4,
                        "label": "Priority",
                        "tooltip": "Priority of the ticket.",
                        "options": [
                            {
                                "label": "Critical",
                                "value": "critical"
                            },
                            {
                                "label": "High",
                                "value": "high"
                            },
                            {
                                "label": "Normal",
                                "value": "normal"
                            },
                            {
                                "label": "Low",
                                "value": "low"
                            }
                        ]
                    },
                    "assigneeUserId": {
                        "type": "text",
                        "index": 5,
                        "label": "Assignee",
                        "tooltip": "Pick the agent to assign the ticket to, or type the numeric user ID.",
                        "source": {
                            "url": "/component/appmixer/gorgias/core/ListUsers?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "externalId": {
                        "type": "text",
                        "index": 6,
                        "label": "External ID",
                        "tooltip": "Your own reference of the ticket in another system, e.g. an order number. Up to 255 characters."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
