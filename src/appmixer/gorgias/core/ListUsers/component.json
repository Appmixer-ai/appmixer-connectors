{
    "name": "appmixer.gorgias.core.ListUsers",
    "label": "List Users",
    "description": "Assignee picker source (private): the first 100 users (agents) of the helpdesk, sorted by name (one page).",
    "private": true,
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "result": {
                        "type": "array",
                        "title": "Users",
                        "example": [
                            {
                                "id": 5678,
                                "name": "Jane Doe",
                                "email": "jane@acme.com"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 5678
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Jane Doe"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Email",
                                    "example": "jane@acme.com"
                                }
                            }
                        }
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 12
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
