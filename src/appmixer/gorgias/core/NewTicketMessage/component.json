{
    "name": "appmixer.gorgias.core.NewTicketMessage",
    "label": "New Ticket Message",
    "description": "Triggers when a message is added to a ticket: customer messages, agent replies and internal notes. The flow registers an HTTP integration in Gorgias while it runs and removes it when it stops.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "ticket_id",
                    "channel",
                    "via",
                    "from_agent",
                    "created_datetime"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Message ID",
                        "example": 123456789
                    },
                    "uri": {
                        "type": "string",
                        "title": "URI",
                        "example": "/api/tickets/98765432/messages/123456789/"
                    },
                    "ticket_id": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 98765432
                    },
                    "channel": {
                        "type": "string",
                        "title": "Channel",
                        "example": "internal-note"
                    },
                    "via": {
                        "type": "string",
                        "title": "Via",
                        "example": "api"
                    },
                    "from_agent": {
                        "type": "boolean",
                        "title": "From Agent",
                        "example": true
                    },
                    "public": {
                        "type": "boolean",
                        "title": "Public",
                        "example": false
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Where is my order?"
                    },
                    "body_text": {
                        "type": "string",
                        "title": "Body Text",
                        "example": "The parcel left the warehouse today."
                    },
                    "body_html": {
                        "type": "string",
                        "title": "Body HTML",
                        "example": "<p>The parcel left the warehouse today.</p>"
                    },
                    "stripped_text": {
                        "type": "string",
                        "title": "Stripped Text",
                        "example": "The parcel left the warehouse today."
                    },
                    "sender": {
                        "type": "object",
                        "title": "Sender",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Sender.ID",
                                "example": 7
                            },
                            "email": {
                                "type": "string",
                                "title": "Sender.Email",
                                "example": "agent@example.com"
                            },
                            "name": {
                                "type": "string",
                                "title": "Sender.Name",
                                "example": "Alex Agent"
                            }
                        }
                    },
                    "receiver": {
                        "type": "object",
                        "title": "Receiver",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Receiver.ID",
                                "example": 3924
                            },
                            "email": {
                                "type": "string",
                                "title": "Receiver.Email",
                                "example": "jane.doe@example.com"
                            },
                            "name": {
                                "type": "string",
                                "title": "Receiver.Name",
                                "example": "Jane Doe"
                            }
                        }
                    },
                    "created_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created",
                        "example": "2026-11-20T15:10:21.468912"
                    },
                    "sent_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Sent",
                        "example": "2026-11-20T15:10:22.012345"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
