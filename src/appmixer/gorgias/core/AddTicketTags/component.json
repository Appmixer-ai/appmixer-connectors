{
    "name": "appmixer.gorgias.core.AddTicketTags",
    "label": "Add Ticket Tags",
    "description": "Add tags to a ticket. Tags already on the ticket stay; tag names that do not exist yet are created.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "tags": {
                        "type": [
                            "array",
                            "string"
                        ],
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "ticketId",
                    "tags"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "index": 1,
                        "label": "Ticket ID",
                        "tooltip": "The numeric ID of the ticket, e.g. from Create Ticket or Find Tickets."
                    },
                    "tags": {
                        "type": "multiselect",
                        "index": 2,
                        "label": "Tags",
                        "tooltip": "Tag names. Pick existing tags, or map names from a variable (an array or a comma-separated list). Tags that do not exist yet are created.",
                        "source": {
                            "url": "/component/appmixer/gorgias/core/ListTags?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListTags#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "ticketId",
                    "tags"
                ],
                "properties": {
                    "ticketId": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 98765432
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "urgent",
                            "refund"
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
