{
    "name": "appmixer.gorgias.core.GetTicket",
    "label": "Get Ticket",
    "description": "Retrieve a ticket by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gorgias"
    },
    "quota": {
        "manager": "appmixer:gorgias",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "index": 1,
                        "label": "Ticket ID",
                        "tooltip": "The numeric ID of the ticket, e.g. from Create Ticket or Find Tickets."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "uri",
                    "channel",
                    "via",
                    "from_agent",
                    "created_datetime"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 98765432
                    },
                    "uri": {
                        "type": "string",
                        "title": "URI",
                        "example": "/api/tickets/98765432/"
                    },
                    "external_id": {
                        "type": "string",
                        "title": "External ID",
                        "example": "ORDER-1001"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Where is my order?"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "open"
                    },
                    "priority": {
                        "type": "string",
                        "title": "Priority",
                        "example": "normal"
                    },
                    "channel": {
                        "type": "string",
                        "title": "Channel",
                        "example": "api"
                    },
                    "via": {
                        "type": "string",
                        "title": "Via",
                        "example": "api"
                    },
                    "from_agent": {
                        "type": "boolean",
                        "title": "From Agent",
                        "example": false
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "spam": {
                        "type": "boolean",
                        "title": "Spam",
                        "example": false
                    },
                    "is_unread": {
                        "type": "boolean",
                        "title": "Is Unread",
                        "example": true
                    },
                    "customer": {
                        "type": "object",
                        "title": "Customer",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Customer.ID",
                                "example": 3924
                            },
                            "email": {
                                "type": "string",
                                "title": "Customer.Email",
                                "example": "jane.doe@example.com"
                            },
                            "name": {
                                "type": "string",
                                "title": "Customer.Name",
                                "example": "Jane Doe"
                            }
                        }
                    },
                    "assignee_user": {
                        "type": "object",
                        "title": "Assignee User",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Assignee User.ID",
                                "example": 7
                            },
                            "email": {
                                "type": "string",
                                "title": "Assignee User.Email",
                                "example": "agent@example.com"
                            },
                            "name": {
                                "type": "string",
                                "title": "Assignee User.Name",
                                "example": "Alex Agent"
                            }
                        }
                    },
                    "assignee_team": {
                        "type": "object",
                        "title": "Assignee Team",
                        "required": [
                            "id"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Assignee Team.ID",
                                "example": 12
                            },
                            "name": {
                                "type": "string",
                                "title": "Assignee Team.Name",
                                "example": "Tier 1"
                            }
                        }
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 1,
                                "name": "urgent"
                            }
                        ]
                    },
                    "created_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created",
                        "example": "2026-11-20T14:42:00.384938"
                    },
                    "updated_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated",
                        "example": "2026-11-20T15:10:21.932637"
                    },
                    "opened_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Opened",
                        "example": "2026-11-20T15:02:46.472436"
                    },
                    "last_message_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Message",
                        "example": "2026-11-20T15:10:21.468912"
                    },
                    "last_received_message_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Received Message",
                        "example": "2026-11-20T14:42:00.384938"
                    },
                    "closed_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Closed",
                        "example": "2026-11-21T09:00:00.000000"
                    },
                    "snooze_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Snoozed Until",
                        "example": "2026-11-22T09:00:00.000000"
                    },
                    "trashed_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Trashed",
                        "example": "2026-11-23T09:00:00.000000"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
