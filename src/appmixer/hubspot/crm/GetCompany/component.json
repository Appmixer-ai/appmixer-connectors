{
    "name": "appmixer.hubspot.crm.GetCompany",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a company by its ID or by the value of a unique identifier property.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "companyId": {
                        "type": "string"
                    },
                    "idProperty": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "string"
                    },
                    "associations": {
                        "type": "string"
                    }
                },
                "required": [
                    "companyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "companyId": {
                        "type": "text",
                        "label": "Company ID",
                        "tooltip": "The record ID of the company, or the value of the unique property set in ID Property.",
                        "index": 1
                    },
                    "idProperty": {
                        "type": "text",
                        "label": "ID Property",
                        "tooltip": "Optional. The name of a property with unique values to look the company up by, instead of the record ID. HubSpot only accepts unique identifier properties here; to look a company up by its domain, use Find Companies.",
                        "index": 2
                    },
                    "properties": {
                        "type": "text",
                        "label": "Properties",
                        "tooltip": "A comma separated list of the properties to be returned in the response. If not specified, the default company properties are returned.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/GetCompaniesProperties?outPort=out",
                            "data": {
                                "transform": "./GetCompaniesProperties#companyToLabelNameArray"
                            }
                        },
                        "index": 3
                    },
                    "associations": {
                        "type": "text",
                        "label": "Associations",
                        "tooltip": "A comma separated list of object types to retrieve associated IDs for, e.g. <code>contacts,deals</code>. Learn more about the <a href=\"https://developers.hubspot.com/docs/api-reference/crm-associations-v4/guide\" target=\"_blank\">associations API</a>.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "company",
            "source": {
                "url": "/component/appmixer/hubspot/crm/GetCompaniesProperties?outPort=out",
                "data": {
                    "transform": "./GetCompaniesProperties#companyToSelectArray",
                    "messages": {
                        "in/companyId": "dummy"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Company ID",
                    "value": "companyId",
                    "schema": {
                        "type": "string",
                        "example": "18234567890"
                    }
                }
            ]
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
