{
    "name": "appmixer.hubspot.crm.CreateTicket",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new support ticket, optionally associated with contacts, companies and deals.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "hsPipeline": {
                        "type": "string"
                    },
                    "hsPipelineStage": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "hubSpotOwnerId": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "object"
                    },
                    "contactIds": {
                        "type": "string"
                    },
                    "companyIds": {
                        "type": "string"
                    },
                    "dealIds": {
                        "type": "string"
                    }
                },
                "required": [
                    "subject",
                    "hsPipelineStage"
                ]
            },
            "inspector": {
                "inputs": {
                    "subject": {
                        "type": "text",
                        "label": "Ticket Name",
                        "tooltip": "The name (subject) of the ticket.",
                        "index": 1
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Ticket Description",
                        "tooltip": "The description of the ticket.",
                        "index": 2
                    },
                    "hsPipeline": {
                        "type": "text",
                        "label": "Pipeline",
                        "tooltip": "The ticket pipeline. If not specified, the default ticket pipeline is used.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelines?outPort=out",
                            "data": {
                                "messages": {
                                    "in/objectType": "tickets"
                                },
                                "transform": "./ListPipelines#toSelectArray"
                            }
                        },
                        "index": 3
                    },
                    "hsPipelineStage": {
                        "type": "text",
                        "label": "Ticket Status",
                        "tooltip": "The pipeline stage (status) of the ticket, e.g. <code>1</code> for New in the default Support Pipeline. Select a pipeline first to choose a stage from the list.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelineStages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/pipelineId": "inputs/in/hsPipeline",
                                    "in/objectType": "tickets",
                                    "in/isSource": true
                                },
                                "transform": "./ListPipelineStages#toSelectArray"
                            }
                        },
                        "index": 4
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "The priority of the ticket.",
                        "options": [
                            {
                                "label": "Low",
                                "value": "LOW"
                            },
                            {
                                "label": "Medium",
                                "value": "MEDIUM"
                            },
                            {
                                "label": "High",
                                "value": "HIGH"
                            },
                            {
                                "label": "Urgent",
                                "value": "URGENT"
                            }
                        ],
                        "index": 5
                    },
                    "hubSpotOwnerId": {
                        "type": "text",
                        "label": "Owner",
                        "tooltip": "The HubSpot user the ticket is assigned to.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListOwners?outPort=owners",
                            "data": {
                                "transform": "./ListOwners#ownersToSelectArray"
                            }
                        },
                        "index": 6
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Other HubSpot or custom ticket properties to set.",
                        "exclusiveFields": [
                            "name"
                        ],
                        "index": 7,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "name": {
                                "type": "text",
                                "label": "Property",
                                "tooltip": "The internal name of the ticket property.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/hubspot/crm/GetTicketsProperties?outPort=out",
                                    "data": {
                                        "transform": "./GetTicketsProperties#additionalFieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    },
                    "contactIds": {
                        "type": "text",
                        "label": "Contact IDs",
                        "tooltip": "A comma separated list of contact IDs to associate the ticket with.",
                        "group": "associations",
                        "index": 8
                    },
                    "companyIds": {
                        "type": "text",
                        "label": "Company IDs",
                        "tooltip": "A comma separated list of company IDs to associate the ticket with.",
                        "group": "associations",
                        "index": 9
                    },
                    "dealIds": {
                        "type": "text",
                        "label": "Deal IDs",
                        "tooltip": "A comma separated list of deal IDs to associate the ticket with.",
                        "group": "associations",
                        "index": 10
                    }
                },
                "groups": {
                    "associations": {
                        "label": "Associations",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "ticket",
            "source": {
                "url": "/component/appmixer/hubspot/crm/GetTicketsProperties?outPort=out",
                "data": {
                    "transform": "./GetTicketsProperties#ticketToSelectArray",
                    "messages": {
                        "in/subject": "dummy",
                        "in/hsPipelineStage": "dummy"
                    }
                }
            }
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
