{
    "name": "appmixer.hubspot.crm.UpdateTicket",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Update the properties of a ticket, such as its status, priority or owner. Empty inputs keep the current values.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "hsPipeline": {
                        "type": "string"
                    },
                    "hsPipelineStage": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "hubSpotOwnerId": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "object"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "tooltip": "The ID of the ticket to update.",
                        "index": 1
                    },
                    "subject": {
                        "type": "text",
                        "label": "Ticket Name",
                        "tooltip": "The new name (subject) of the ticket.",
                        "index": 2
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Ticket Description",
                        "tooltip": "The description of the ticket.",
                        "index": 3
                    },
                    "hsPipeline": {
                        "type": "text",
                        "label": "Pipeline",
                        "tooltip": "The ticket pipeline. If not specified, the default ticket pipeline is used.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelines?outPort=out",
                            "data": {
                                "messages": {
                                    "in/objectType": "tickets"
                                },
                                "transform": "./ListPipelines#toSelectArray"
                            }
                        },
                        "index": 4
                    },
                    "hsPipelineStage": {
                        "type": "text",
                        "label": "Ticket Status",
                        "tooltip": "The new pipeline stage (status) of the ticket. Select a pipeline first to choose a stage from the list.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListPipelineStages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/pipelineId": "inputs/in/hsPipeline",
                                    "in/objectType": "tickets",
                                    "in/isSource": true
                                },
                                "transform": "./ListPipelineStages#toSelectArray"
                            }
                        },
                        "index": 5
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "The priority of the ticket.",
                        "options": [
                            {
                                "label": "Low",
                                "value": "LOW"
                            },
                            {
                                "label": "Medium",
                                "value": "MEDIUM"
                            },
                            {
                                "label": "High",
                                "value": "HIGH"
                            },
                            {
                                "label": "Urgent",
                                "value": "URGENT"
                            }
                        ],
                        "index": 6
                    },
                    "hubSpotOwnerId": {
                        "type": "text",
                        "label": "Owner",
                        "tooltip": "The HubSpot user the ticket is assigned to.",
                        "source": {
                            "url": "/component/appmixer/hubspot/crm/ListOwners?outPort=owners",
                            "data": {
                                "transform": "./ListOwners#ownersToSelectArray"
                            }
                        },
                        "index": 7
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Other HubSpot or custom ticket properties to set.",
                        "exclusiveFields": [
                            "name"
                        ],
                        "index": 8,
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "name": {
                                "type": "text",
                                "label": "Property",
                                "tooltip": "The internal name of the ticket property.",
                                "index": 1,
                                "source": {
                                    "url": "/component/appmixer/hubspot/crm/GetTicketsProperties?outPort=out",
                                    "data": {
                                        "transform": "./GetTicketsProperties#additionalFieldsToSelectArray"
                                    }
                                }
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
