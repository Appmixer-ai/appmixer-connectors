{
    "name": "appmixer.hubspot.crm.AddCompanyToList",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Add one or more companies to a HubSpot static list.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "listId": {
                        "type": "string"
                    },
                    "companyIds": {
                        "type": "string"
                    }
                },
                "required": [
                    "listId",
                    "companyIds"
                ]
            },
            "inspector": {
                "inputs": {
                    "listId": {
                        "type": "text",
                        "label": "List ID",
                        "tooltip": "The HubSpot static list ID to add companies to.",
                        "index": 1
                    },
                    "companyIds": {
                        "type": "text",
                        "label": "Company IDs",
                        "tooltip": "Single company ID or multiple IDs separated by commas (e.g., 123456 or 123456,789012,345678).",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Success",
                    "value": "success",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "List ID",
                    "value": "listId",
                    "schema": {
                        "type": "string",
                        "example": "12345"
                    }
                },
                {
                    "label": "Company IDs",
                    "value": "companyIds",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "987654321",
                            "987654322"
                        ]
                    }
                },
                {
                    "label": "Count",
                    "value": "count",
                    "schema": {
                        "type": "number",
                        "example": 2
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "Companies added to list successfully"
                    }
                },
                {
                    "label": "API Version",
                    "value": "apiVersion",
                    "schema": {
                        "type": "string",
                        "example": "v3"
                    }
                }
            ]
        }
    ]
}
