{
    "name": "appmixer.hubspot.crm.ListPipelineStages",
    "author": "David Durman <david@client.io>",
    "icon": "data:image/svg+xml;base64,",
    "description": "List pipeline stages.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "pipelineId": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "pipelineId": {
                    "type": "text",
                    "label": "Pipeline ID",
                    "tooltip": "The ID of the pipeline to list stages for.",
                    "index": 1
                }
            }
        }
    }],
    "outPorts": ["out"],
    "version": "1.0.0",
    "dependencies": {
        "service": "1.0.1"
    }
}

