{
    "name": "appmixer.hubspot.crm.CreateCompany",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/png;base64,",
    "description": "Create a new company in HubSpot CRM.",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "domain": { "type": "string" },
                    "name": { "type": "string" },
                    "clearbit_company_name": { "type": "string" },
                    "numberofemployees": { "type": "string" },
                    "hs_employee_range": { "type": "string" },
                    "industry": { "type": "string" },
                    "clearbit_company_sector": { "type": "string" },
                    "clearbit_company_industry_group": { "type": "string" },
                    "clearbit_company_sub_industry": { "type": "string" },
                    "last_pageview_at": { "type": "string" },
                    "pageviews_current_day": { "type": "string" },
                    "pageviews_current_month": { "type": "string" },
                    "pageviews_current_week": { "type": "string" },
                    "change_pageviews_week_over_week": { "type": "string" },
                    "additionalProperties": { "type": "object" }
                },
                "required": [
                    "domain"
                ]
            },
            "inspector": {
                "inputs": {
                    "domain": {
                        "type": "text",
                        "label": "Domain",
                        "tooltip": "The company's domain (required).",
                        "index": 1
                    },
                    "name": {
                        "type": "text",
                        "label": "Company Name",
                        "tooltip": "The company's name.",
                        "index": 2
                    },
                    "clearbit_company_name": {
                        "type": "text",
                        "label": "Clearbit Company Name",
                        "tooltip": "Company name from Clearbit enrichment.",
                        "index": 3
                    },
                    "numberofemployees": {
                        "type": "text",
                        "label": "Number of Employees",
                        "tooltip": "Total number of employees.",
                        "index": 4
                    },
                    "hs_employee_range": {
                        "type": "text",
                        "label": "Employee Range",
                        "tooltip": "Employee count range.",
                        "index": 5
                    },
                    "industry": {
                        "type": "text",
                        "label": "Industry",
                        "tooltip": "The company's industry.",
                        "index": 6
                    },
                    "clearbit_company_sector": {
                        "type": "text",
                        "label": "Clearbit Sector",
                        "tooltip": "Company sector from Clearbit.",
                        "index": 7
                    },
                    "clearbit_company_industry_group": {
                        "type": "text",
                        "label": "Clearbit Industry Group",
                        "tooltip": "Industry group classification from Clearbit.",
                        "index": 8
                    },
                    "clearbit_company_sub_industry": {
                        "type": "text",
                        "label": "Clearbit Sub Industry",
                        "tooltip": "Sub-industry classification from Clearbit.",
                        "index": 9
                    },
                    "last_pageview_at": {
                        "type": "text",
                        "label": "Last Pageview At",
                        "tooltip": "Timestamp of last pageview (intent signal).",
                        "index": 10
                    },
                    "pageviews_current_day": {
                        "type": "text",
                        "label": "Pageviews Current Day",
                        "tooltip": "Pageviews in current day.",
                        "index": 11
                    },
                    "pageviews_current_month": {
                        "type": "text",
                        "label": "Pageviews Current Month",
                        "tooltip": "Pageviews in current month.",
                        "index": 12
                    },
                    "pageviews_current_week": {
                        "type": "text",
                        "label": "Pageviews Current Week",
                        "tooltip": "Pageviews in current week.",
                        "index": 13
                    },
                    "change_pageviews_week_over_week": {
                        "type": "text",
                        "label": "Change Pageviews Week Over Week",
                        "tooltip": "Week-over-week change in pageviews.",
                        "index": 14
                    },
                    "additionalProperties": {
                        "type": "expression",
                        "label": "Additional Properties",
                        "tooltip": "Additional HubSpot or custom properties to add to the company.",
                        "exclusiveFields": ["name"],
                        "index": 15,
                        "levels": ["AND"],
                        "fields": {
                            "name": {
                                "type": "text",
                                "label": "Property Name",
                                "tooltip": "The property name to add to the company.",
                                "index": 1
                            },
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "The value for the property.",
                                "index": 2
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Company ID", "value": "id" },
                { "label": "Domain", "value": "domain" },
                { "label": "Company Name", "value": "name" },
                { "label": "Clearbit Company Name", "value": "clearbit_company_name" },
                { "label": "Number of Employees", "value": "numberofemployees" },
                { "label": "Employee Range", "value": "hs_employee_range" },
                { "label": "Industry", "value": "industry" },
                { "label": "Clearbit Sector", "value": "clearbit_company_sector" },
                { "label": "Clearbit Industry Group", "value": "clearbit_company_industry_group" },
                { "label": "Clearbit Sub Industry", "value": "clearbit_company_sub_industry" },
                { "label": "Last Pageview At", "value": "last_pageview_at" },
                { "label": "Pageviews Current Day", "value": "pageviews_current_day" },
                { "label": "Pageviews Current Month", "value": "pageviews_current_month" },
                { "label": "Pageviews Current Week", "value": "pageviews_current_week" },
                { "label": "Change Pageviews Week Over Week", "value": "change_pageviews_week_over_week" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" }
            ]
        }
    ]
}


