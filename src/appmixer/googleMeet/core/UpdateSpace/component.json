{
    "name": "appmixer.googleMeet.core.UpdateSpace",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update settings of a Meet space. Requires OAuth 2.0; scope: https://www.googleapis.com/auth/meetings.space.settings.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleMeet"
    },
    "quota": {
        "manager": "appmixer:googleMeet",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "updateMask": {
                        "type": "string"
                    },
                    "space|spaceType": {
                        "type": "string"
                    },
                    "space|config": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Resource name of the space to update. Format: spaces/{space}",
                        "label": "Name",
                        "index": 0
                    },
                    "updateMask": {
                        "type": "text",
                        "tooltip": "Comma-separated list of fields to update. Example: spaceType,config.accessType",
                        "label": "Update Mask",
                        "index": 1
                    },
                    "space|spaceType": {
                        "type": "text",
                        "tooltip": "Updated space type, e.g., MEETING.",
                        "label": "Space|space Type",
                        "index": 2
                    },
                    "space|config": {
                        "type": "text",
                        "tooltip": "Space configuration to update (see API docs for supported fields).",
                        "label": "Space|config",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Meeting Code",
                    "value": "meetingCode",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Meeting Uri",
                    "value": "meetingUri",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Space Type",
                    "value": "spaceType",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Config",
                    "value": "config",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "exampleSetting": {
                                "type": "boolean",
                                "title": "Config.Example Setting"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}