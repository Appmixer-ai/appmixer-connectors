{
    "name": "appmixer.googleMeet.core.CreateSpace",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new Google Meet space (meeting). Requires OAuth 2.0; scope: https://www.googleapis.com/auth/meetings.space.created.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleMeet"
    },
    "quota": {
        "manager": "appmixer:googleMeet",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "space|spaceType": {
                        "type": "string"
                    },
                    "space|config": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "space|spaceType": {
                        "type": "text",
                        "tooltip": "Type of the space to create, for example MEETING.",
                        "label": "Space|space Type",
                        "index": 0
                    },
                    "space|config": {
                        "type": "text",
                        "tooltip": "Optional space configuration and settings (see API docs for supported fields).",
                        "label": "Space|config",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Meeting Code",
                    "value": "meetingCode",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Meeting Uri",
                    "value": "meetingUri",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Space Type",
                    "value": "spaceType",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}