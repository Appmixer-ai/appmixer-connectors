{
    "name": "appmixer.googleMeet.core.GetTranscript",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a specific transcript resource. Requires OAuth 2.0.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleMeet"
    },
    "quota": {
        "manager": "appmixer:googleMeet",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conferenceRecord": {
                        "type": "string"
                    },
                    "transcript": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "conferenceRecord": {
                        "type": "text",
                        "tooltip": "ID of the conference record. Used in path: conferenceRecords/{conferenceRecord}",
                        "label": "Conference Record",
                        "index": 0
                    },
                    "transcript": {
                        "type": "text",
                        "tooltip": "ID of the transcript. Used in path: transcripts/{transcript}",
                        "label": "Transcript",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "State",
                    "value": "state",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Start Time",
                    "value": "startTime",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "End Time",
                    "value": "endTime",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Language Code",
                    "value": "languageCode",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}