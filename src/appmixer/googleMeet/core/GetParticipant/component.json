{
    "name": "appmixer.googleMeet.core.GetParticipant",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a specific participant by resource name. Requires OAuth 2.0; typical scope: https://www.googleapis.com/auth/meetings.space.readonly.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleMeet"
    },
    "quota": {
        "manager": "appmixer:googleMeet",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conferenceRecord": {
                        "type": "string"
                    },
                    "participant": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "conferenceRecord": {
                        "type": "text",
                        "tooltip": "ID of the conference record. Used in path: conferenceRecords/{conferenceRecord}",
                        "label": "Conference Record",
                        "index": 0
                    },
                    "participant": {
                        "type": "text",
                        "tooltip": "ID of the participant. Used in path: participants/{participant}",
                        "label": "Participant",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Earliest Join Time",
                    "value": "earliestJoinTime",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Latest Leave Time",
                    "value": "latestLeaveTime",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "displayName": {
                                "type": "string",
                                "title": "User.Display Name"
                            },
                            "email": {
                                "type": "string",
                                "title": "User.Email"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}