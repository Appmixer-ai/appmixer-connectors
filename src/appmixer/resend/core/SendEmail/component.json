{
    "name": "appmixer.resend.core.SendEmail",
    "label": "Send Email",
    "description": "Send an email through the Resend Email API.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:resend"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "properties": {
                    "from": {
                        "type": "string",
                        "title": "From",
                        "description": "Sender email address. To include a friendly name, use the format 'Your Name <sender@domain.com>'."
                    },
                    "to": {
                        "type": ["string", "array"],
                        "title": "To",
                        "description": "Recipient email address. For multiple addresses, send as an array of strings. Max 50."
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "description": "Email subject."
                    },
                    "bcc": {
                        "type": ["string", "array"],
                        "title": "BCC",
                        "description": "BCC recipient email address. For multiple addresses, send as an array of strings."
                    },
                    "cc": {
                        "type": ["string", "array"],
                        "title": "CC",
                        "description": "CC recipient email address. For multiple addresses, send as an array of strings."
                    },
                    "scheduled_at": {
                        "type": "string",
                        "title": "Schedule At",
                        "description": "Schedule email to be sent later. The date should be in natural language (e.g.: 'in 1 min') or ISO 8601 format."
                    },
                    "reply_to": {
                        "type": ["string", "array"],
                        "title": "Reply To",
                        "description": "Reply-to email address. For multiple addresses, send as an array of strings."
                    },
                    "html": {
                        "type": "string",
                        "title": "HTML Body",
                        "description": "The HTML version of the message."
                    },
                    "text": {
                        "type": "string",
                        "title": "Text Body",
                        "description": "The plain text version of the message."
                    },
                    "headers": {
                        "type": "object",
                        "title": "Headers",
                        "description": "Custom headers to add to the email."
                    },
                    "attachments": {
                        "type": "array",
                        "title": "Attachments",
                        "description": "Filename and content of attachments (max 40MB per email, after Base64 encoding of the attachments)."
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "description": "Custom data passed in key/value pairs."
                    },
                    "idempotency_key": {
                        "type": "string",
                        "title": "Idempotency Key",
                        "description": "Add an idempotency key to prevent duplicated emails. Should be unique per API request."
                    }
                },
                "required": ["from", "to", "subject"]
            },
            "inspector": {
                "inputs": {
                    "from": {
                        "type": "text",
                        "index": 1
                    },
                    "to": {
                        "type": "text",
                        "index": 2
                    },
                    "subject": {
                        "type": "text",
                        "index": 3
                    },
                    "html": {
                        "type": "textarea",
                        "index": 4
                    },
                    "text": {
                        "type": "textarea",
                        "index": 5
                    },
                    "cc": {
                        "type": "text",
                        "index": 6
                    },
                    "bcc": {
                        "type": "text",
                        "index": 7
                    },
                    "reply_to": {
                        "type": "text",
                        "index": 8
                    },
                    "scheduled_at": {
                        "type": "text",
                        "index": 9
                    },
                    "headers": {
                        "type": "code",
                        "index": 10
                    },
                    "attachments": {
                        "type": "code",
                        "index": 11
                    },
                    "tags": {
                        "type": "code",
                        "index": 12
                    },
                    "idempotency_key": {
                        "type": "text",
                        "index": 13
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Email ID"
                    }
                }
            }
        }
    ]
}
