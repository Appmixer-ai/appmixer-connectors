{
	"name": "appmixer.resend.core.DeleteDomain",
	"label": "Delete Domain",
	"description": "Delete a domain through the Resend API.",
	"author": "Appmixer <info@appmixer.com>",
	"version": "1.0.0",
	"auth": {
		"service": "appmixer.resend"
	},
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"properties": {
					"key": {
						"type": "string"
					}
				}
			},
			"inspector": {
				"inputs": {
					"key": {
						"type": "text",
						"label": "Domain ID",
						"description": "The ID of the domain to delete.",
						"index": 0
					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "out",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"title": "Item ID"
					}
				}
			}
		}
