{
    "name": "appmixer.resend.core.UpdateDomain",
    "label": "Update Domain",
    "description": "Update an existing domain in Resend.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:resend"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
					"id": {
						"type": "string"
					},
					"open_tracking": {
						"type": "boolean"
					},
					"click_tracking": {
						"type": "boolean"
					},
					"tls": {
						"type": "string",
						"enum": [
							"opportunistic",
							"enforced"
						]
					}
				}
            },
            "inspector": {
                "inputs": {
                    "id": { "type": "text", "name": "Domain ID", "tooltip": "The Domain ID to update.", "index": 1 },
                    "open_tracking": { "type": "checkbox", "name": "Open Tracking", "tooltip": "Track the open rate of each email.", "index": 2 },
                    "click_tracking": { "type": "checkbox", "name": "Click Tracking", "tooltip": "Track clicks within the body of each HTML email.", "index": 3 },
                    "tls": { "type": "select", "name": "TLS Mode", "options": [ { "label": "Opportunistic", "value": "opportunistic" }, { "label": "Enforced", "value": "enforced" } ], "tooltip": "TLS mode for email delivery.", "index": 4 }
                }
            }
        }
    ],
    "outPorts": [{
			"name": "out",
			"schema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"title": "Item ID"
					}
				}
			}
		}]
}
