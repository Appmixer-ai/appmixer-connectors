{
	"name": "appmixer.resend.core.CreateContact",
	"label": "Create Contact",
	"description": "Create a contact inside an audience.",
	"author": "Appmixer <info@appmixer.com>",
	"version": "1.0.0",
	"auth": {
		"service": "appmixer:resend"
	},
	"inPorts": [
		{
			"name": "in",
			"schema": {
				"properties": {
					"audience_id": {
						"type": "string",
						"title": "Audience ID",
						"description": "The Audience ID."
					},
					"email": {
						"type": "string",
						"title": "Email",
						"description": "The email address of the contact."
					},
					"first_name": {
						"type": "string",
						"title": "First Name",
						"description": "The first name of the contact."
					},
					"last_name": {
						"type": "string",
						"title": "Last Name",
						"description": "The last name of the contact."
					},
					"unsubscribed": {
						"type": "boolean",
						"title": "Unsubscribed",
						"description": "The subscription status."
					}
				},
				"required": [
					"audience_id",
					"email"
				]
			},
			"inspector": {
				"inputs": {
					"audience_id": {
						"type": "text",
						"index": 1,
						"tooltip": "The Audience ID."
					},
					"email": {
						"type": "text",
						"index": 2,
						"tooltip": "The email address of the contact."
					},
					"first_name": {
						"type": "text",
						"index": 3,
						"tooltip": "The first name of the contact."
					},
					"last_name": {
						"type": "text",
						"index": 4,
						"tooltip": "The last name of the contact."
					},
					"unsubscribed": {
						"type": "checkbox",
						"index": 5,
						"tooltip": "The subscription status."
					}
				}
			}
		}
	],
	"outPorts": [
		{
			"name": "out",
			"options": [
				{
					"label": "Contact ID",
					"value": "id"
				},
				{
					"label": "Object Type",
					"value": "object"
				}
			]
		}
	],
	"icon": "data:image/svg+xml;base64,"
}
