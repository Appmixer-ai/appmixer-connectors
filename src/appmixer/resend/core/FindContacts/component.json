{
    "name": "appmixer.resend.core.FindContacts",
    "label": "Find Contacts",
    "description": "Show all contacts from an audience.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:resend"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "audience_id": {
                        "type": "string",
                        "title": "Audience ID",
                        "description": "The Audience ID."
                    }
                },
                "required": [
                    "audience_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "audience_id": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "The Audience ID.",
                        "label": "Audience ID"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Email"
                                },
                                "first_name": {
                                    "type": "string",
                                    "title": "First Name"
                                },
                                "last_name": {
                                    "type": "string",
                                    "title": "Last Name"
                                },
                                "created_at": {
                                    "type": "string",
                                    "title": "Created At"
                                },
                                "unsubscribed": {
                                    "type": "boolean",
                                    "title": "Unsubscribed"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
