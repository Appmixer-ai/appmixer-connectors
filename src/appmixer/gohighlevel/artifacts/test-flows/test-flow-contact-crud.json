{
    "name": "E2E Gohighlevel - Contact CRUD",
    "description": "End-to-end test for Gohighlevel connector - tests Contact CRUD operations (Create, Get, Update, Delete).",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "contactEmail",
                                                "text": "e2e-ghl-contact@appmixer-test.com"
                                            },
                                            {
                                                "type": "text",
                                                "name": "contactFirstName",
                                                "text": "E2ETest"
                                            },
                                            {
                                                "type": "text",
                                                "name": "contactLastName",
                                                "text": "GHLContact"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedFirstName",
                                                "text": "E2EUpdated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-contact": {
            "type": "appmixer.gohighlevel.core.CreateContact",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "email": {
                                        "var-email": {
                                            "variable": "$.set-variables.out.contactEmail",
                                            "functions": []
                                        }
                                    },
                                    "firstName": {
                                        "var-first-name": {
                                            "variable": "$.set-variables.out.contactFirstName",
                                            "functions": []
                                        }
                                    },
                                    "lastName": {
                                        "var-last-name": {
                                            "variable": "$.set-variables.out.contactLastName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "email": "{{{var-email}}}",
                                    "firstName": "{{{var-first-name}}}",
                                    "lastName": "{{{var-last-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        },
                                        "field-email": {
                                            "variable": "$.create-contact.out.email",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-email}}}",
                                                "assertion": "equal",
                                                "expected": "e2e-ghl-contact@appmixer-test.com"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-contact": {
            "type": "appmixer.gohighlevel.core.GetContact",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "contactId": {
                                        "var-contact-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "contactId": "{{{var-contact-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-get-email": {
                                            "variable": "$.get-contact.out.email",
                                            "functions": []
                                        },
                                        "field-get-first-name": {
                                            "variable": "$.get-contact.out.firstName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-get-email}}}",
                                                "assertion": "equal",
                                                "expected": "e2e-ghl-contact@appmixer-test.com"
                                            },
                                            {
                                                "field": "{{{field-get-first-name}}}",
                                                "assertion": "equal",
                                                "expected": "E2ETest"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-contact": {
            "type": "appmixer.gohighlevel.core.UpdateContact",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "contactId": {
                                        "var-update-contact-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        }
                                    },
                                    "firstName": {
                                        "var-updated-first-name": {
                                            "variable": "$.set-variables.out.updatedFirstName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "contactId": "{{{var-update-contact-id}}}",
                                    "firstName": "{{{var-updated-first-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-updated-first-name": {
                                            "variable": "$.update-contact.out.firstName",
                                            "functions": []
                                        },
                                        "field-updated-id": {
                                            "variable": "$.update-contact.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-updated-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-updated-first-name}}}",
                                                "assertion": "equal",
                                                "expected": "E2EUpdated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-contact": {
            "type": "appmixer.gohighlevel.core.DeleteContact",
            "x": 1584,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "contactId": {
                                        "var-delete-contact-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "contactId": "{{{var-delete-contact-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1776,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-contact": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Gohighlevel - Contact CRUD",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}