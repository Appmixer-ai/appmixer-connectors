{
    "name": "appmixer.gohighlevel.core.CreateAppointment",
    "label": "Create Appointment",
    "description": "Create a new calendar appointment/event in GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "calendarId": { "type": "string" },
                    "locationId": { "type": "string" },
                    "contactId": { "type": "string" },
                    "startTime": { "type": "string", "format": "date-time" },
                    "endTime": { "type": "string", "format": "date-time" },
                    "title": { "type": "string" },
                    "appointmentStatus": { "type": "string" },
                    "assignedUserId": { "type": "string" },
                    "address": { "type": "string" }
                },
                "required": ["calendarId", "locationId", "contactId", "startTime", "endTime"]
            },
            "inspector": {
                "inputs": {
                    "calendarId": {
                        "type": "text",
                        "label": "Calendar ID",
                        "index": 1,
                        "tooltip": "The ID of the calendar to create the appointment in."
                    },
                    "locationId": {
                        "type": "text",
                        "label": "Location ID",
                        "index": 2,
                        "tooltip": "The ID of the GoHighLevel location (sub-account)."
                    },
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 3,
                        "tooltip": "The ID of the contact for the appointment."
                    },
                    "startTime": {
                        "type": "date-time",
                        "label": "Start Time",
                        "index": 4,
                        "tooltip": "The start date and time of the appointment (ISO 8601 format)."
                    },
                    "endTime": {
                        "type": "date-time",
                        "label": "End Time",
                        "index": 5,
                        "tooltip": "The end date and time of the appointment (ISO 8601 format)."
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "index": 6,
                        "tooltip": "Title/name of the appointment."
                    },
                    "appointmentStatus": {
                        "type": "select",
                        "label": "Appointment Status",
                        "index": 7,
                        "tooltip": "Status of the appointment.",
                        "defaultValue": "new",
                        "options": [
                            { "label": "New", "value": "new" },
                            { "label": "Confirmed", "value": "confirmed" },
                            { "label": "Cancelled", "value": "cancelled" },
                            { "label": "Showed", "value": "showed" },
                            { "label": "No Show", "value": "noshow" },
                            { "label": "Invalid", "value": "invalid" }
                        ]
                    },
                    "assignedUserId": {
                        "type": "text",
                        "label": "Assigned User ID",
                        "index": 8,
                        "tooltip": "The user ID to assign the appointment to."
                    },
                    "address": {
                        "type": "text",
                        "label": "Address",
                        "index": 9,
                        "tooltip": "Location/address of the appointment."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Appointment ID", "value": "id" },
                { "label": "Title", "value": "title" },
                { "label": "Calendar ID", "value": "calendarId" },
                { "label": "Location ID", "value": "locationId" },
                { "label": "Contact ID", "value": "contactId" },
                { "label": "Start Time", "value": "startTime" },
                { "label": "End Time", "value": "endTime" },
                { "label": "Status", "value": "appointmentStatus" },
                { "label": "Assigned User ID", "value": "assignedUserId" },
                { "label": "Address", "value": "address" },
                { "label": "Date Created", "value": "dateAdded" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
