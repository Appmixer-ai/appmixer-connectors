{
    "name": "appmixer.gohighlevel.core.ListCalendars",
    "label": "List Calendars",
    "description": "List all calendars in a GoHighLevel location.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": { "userId": "{{userId}}" }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "locationId": { "type": "string" }
                },
                "required": ["locationId"]
            },
            "inspector": {
                "inputs": {
                    "locationId": {
                        "type": "text",
                        "label": "Location ID",
                        "index": 1,
                        "tooltip": "The GoHighLevel location (sub-account) ID."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Calendars", "value": "calendars" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
