{
    "name": "appmixer.gohighlevel.core.UpdateContact",
    "label": "Update Contact",
    "description": "Update an existing contact in GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "address1": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "companyName": {
                        "type": "string"
                    },
                    "website": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique ID of the contact to update."
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "index": 2,
                        "tooltip": "Updated first name of the contact."
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "index": 3,
                        "tooltip": "Updated last name of the contact."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 4,
                        "tooltip": "Updated email address of the contact."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 5,
                        "tooltip": "Updated phone number of the contact."
                    },
                    "companyName": {
                        "type": "text",
                        "label": "Company Name",
                        "index": 6,
                        "tooltip": "Updated company name of the contact."
                    },
                    "address1": {
                        "type": "text",
                        "label": "Address",
                        "index": 7,
                        "tooltip": "Updated street address of the contact."
                    },
                    "city": {
                        "type": "text",
                        "label": "City",
                        "index": 8,
                        "tooltip": "Updated city of the contact."
                    },
                    "state": {
                        "type": "text",
                        "label": "State",
                        "index": 9,
                        "tooltip": "Updated state of the contact."
                    },
                    "postalCode": {
                        "type": "text",
                        "label": "Postal Code",
                        "index": 10,
                        "tooltip": "Updated postal/ZIP code of the contact."
                    },
                    "country": {
                        "type": "text",
                        "label": "Country",
                        "index": 11,
                        "tooltip": "Updated country of the contact."
                    },
                    "website": {
                        "type": "text",
                        "label": "Website",
                        "index": 12,
                        "tooltip": "Updated website URL of the contact."
                    },
                    "source": {
                        "type": "text",
                        "label": "Source",
                        "index": 13,
                        "tooltip": "Updated source of the contact."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 14,
                        "tooltip": "Comma-separated list of tags to assign to the contact (replaces existing tags)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id"
                },
                {
                    "label": "First Name",
                    "value": "firstName"
                },
                {
                    "label": "Last Name",
                    "value": "lastName"
                },
                {
                    "label": "Full Name",
                    "value": "contactName"
                },
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "Phone",
                    "value": "phone"
                },
                {
                    "label": "Company Name",
                    "value": "companyName"
                },
                {
                    "label": "Location ID",
                    "value": "locationId"
                },
                {
                    "label": "Date Updated",
                    "value": "dateUpdated"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}