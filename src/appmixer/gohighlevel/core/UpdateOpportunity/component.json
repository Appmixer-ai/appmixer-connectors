{
    "name": "appmixer.gohighlevel.core.UpdateOpportunity",
    "label": "Update Opportunity",
    "description": "Update an existing opportunity in GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "opportunityId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "pipelineStageId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "monetaryValue": {
                        "type": "number"
                    },
                    "assignedTo": {
                        "type": "string"
                    }
                },
                "required": [
                    "opportunityId"
                ]
            },
            "inspector": {
                "inputs": {
                    "opportunityId": {
                        "type": "text",
                        "label": "Opportunity ID",
                        "index": 1,
                        "tooltip": "The unique ID of the opportunity to update."
                    },
                    "name": {
                        "type": "text",
                        "label": "Opportunity Name",
                        "index": 2,
                        "tooltip": "Updated name/title of the opportunity."
                    },
                    "pipelineStageId": {
                        "type": "text",
                        "label": "Pipeline Stage ID",
                        "index": 3,
                        "tooltip": "Updated pipeline stage ID for the opportunity."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 4,
                        "tooltip": "Updated status of the opportunity.",
                        "options": [
                            {
                                "label": "Open",
                                "value": "open"
                            },
                            {
                                "label": "Won",
                                "value": "won"
                            },
                            {
                                "label": "Lost",
                                "value": "lost"
                            },
                            {
                                "label": "Abandoned",
                                "value": "abandoned"
                            }
                        ]
                    },
                    "monetaryValue": {
                        "type": "number",
                        "label": "Monetary Value",
                        "index": 5,
                        "tooltip": "Updated monetary value of the opportunity."
                    },
                    "assignedTo": {
                        "type": "text",
                        "label": "Assigned To (User ID)",
                        "index": 6,
                        "tooltip": "Updated user ID to assign the opportunity to."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Opportunity ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Pipeline ID",
                    "value": "pipelineId"
                },
                {
                    "label": "Pipeline Stage ID",
                    "value": "pipelineStageId"
                },
                {
                    "label": "Monetary Value",
                    "value": "monetaryValue"
                },
                {
                    "label": "Assigned To",
                    "value": "assignedTo"
                },
                {
                    "label": "Date Updated",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}