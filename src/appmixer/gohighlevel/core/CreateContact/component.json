{
    "name": "appmixer.gohighlevel.core.CreateContact",
    "label": "Create Contact",
    "description": "Create a new contact in GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "locationId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "address1": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "companyName": {
                        "type": "string"
                    },
                    "website": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "locationId",
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "locationId": {
                        "type": "text",
                        "label": "Location ID",
                        "index": 1,
                        "tooltip": "The ID of the GoHighLevel location (sub-account) to create the contact in."
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "index": 2,
                        "tooltip": "First name of the contact."
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "index": 3,
                        "tooltip": "Last name of the contact."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 4,
                        "tooltip": "Email address of the contact."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 5,
                        "tooltip": "Phone number of the contact (e.g. +1-555-555-5555)."
                    },
                    "companyName": {
                        "type": "text",
                        "label": "Company Name",
                        "index": 6,
                        "tooltip": "Company name associated with the contact."
                    },
                    "address1": {
                        "type": "text",
                        "label": "Address",
                        "index": 7,
                        "tooltip": "Street address of the contact."
                    },
                    "city": {
                        "type": "text",
                        "label": "City",
                        "index": 8,
                        "tooltip": "City of the contact."
                    },
                    "state": {
                        "type": "text",
                        "label": "State",
                        "index": 9,
                        "tooltip": "State of the contact."
                    },
                    "postalCode": {
                        "type": "text",
                        "label": "Postal Code",
                        "index": 10,
                        "tooltip": "Postal/ZIP code of the contact."
                    },
                    "country": {
                        "type": "text",
                        "label": "Country",
                        "index": 11,
                        "tooltip": "Country of the contact (e.g. US)."
                    },
                    "website": {
                        "type": "text",
                        "label": "Website",
                        "index": 12,
                        "tooltip": "Website URL of the contact."
                    },
                    "source": {
                        "type": "text",
                        "label": "Source",
                        "index": 13,
                        "tooltip": "Source where the contact came from (e.g. 'API', 'Website')."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 14,
                        "tooltip": "Comma-separated list of tags to assign to the contact."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id"
                },
                {
                    "label": "First Name",
                    "value": "firstName"
                },
                {
                    "label": "Last Name",
                    "value": "lastName"
                },
                {
                    "label": "Full Name",
                    "value": "contactName"
                },
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "Phone",
                    "value": "phone"
                },
                {
                    "label": "Company Name",
                    "value": "companyName"
                },
                {
                    "label": "Address",
                    "value": "address1"
                },
                {
                    "label": "City",
                    "value": "city"
                },
                {
                    "label": "State",
                    "value": "state"
                },
                {
                    "label": "Postal Code",
                    "value": "postalCode"
                },
                {
                    "label": "Country",
                    "value": "country"
                },
                {
                    "label": "Website",
                    "value": "website"
                },
                {
                    "label": "Source",
                    "value": "source"
                },
                {
                    "label": "Location ID",
                    "value": "locationId"
                },
                {
                    "label": "Date Added",
                    "value": "dateAdded"
                },
                {
                    "label": "Date Updated",
                    "value": "dateUpdated"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}