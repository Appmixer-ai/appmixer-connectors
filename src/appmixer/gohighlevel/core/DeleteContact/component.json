{
    "name": "appmixer.gohighlevel.core.DeleteContact",
    "label": "Delete Contact",
    "description": "Delete a contact from GoHighLevel by their ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique ID of the contact to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}