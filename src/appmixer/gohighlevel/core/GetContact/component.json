{
    "name": "appmixer.gohighlevel.core.GetContact",
    "label": "Get Contact",
    "description": "Retrieve a contact by their ID from GoHighLevel.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 1,
                        "tooltip": "The unique ID of the contact to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "id"
                },
                {
                    "label": "First Name",
                    "value": "firstName"
                },
                {
                    "label": "Last Name",
                    "value": "lastName"
                },
                {
                    "label": "Full Name",
                    "value": "contactName"
                },
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "Phone",
                    "value": "phone"
                },
                {
                    "label": "Company Name",
                    "value": "companyName"
                },
                {
                    "label": "Address",
                    "value": "address1"
                },
                {
                    "label": "City",
                    "value": "city"
                },
                {
                    "label": "State",
                    "value": "state"
                },
                {
                    "label": "Postal Code",
                    "value": "postalCode"
                },
                {
                    "label": "Country",
                    "value": "country"
                },
                {
                    "label": "Website",
                    "value": "website"
                },
                {
                    "label": "Source",
                    "value": "source"
                },
                {
                    "label": "Location ID",
                    "value": "locationId"
                },
                {
                    "label": "Date Added",
                    "value": "dateAdded"
                },
                {
                    "label": "Date Updated",
                    "value": "dateUpdated"
                },
                {
                    "label": "Tags",
                    "value": "tags"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}