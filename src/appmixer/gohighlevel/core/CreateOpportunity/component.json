{
    "name": "appmixer.gohighlevel.core.CreateOpportunity",
    "label": "Create Opportunity",
    "description": "Create a new opportunity (deal) in a GoHighLevel pipeline.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gohighlevel"
    },
    "quota": {
        "manager": "appmixer:gohighlevel",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "pipelineId": { "type": "string" },
                    "locationId": { "type": "string" },
                    "name": { "type": "string" },
                    "pipelineStageId": { "type": "string" },
                    "status": { "type": "string" },
                    "contactId": { "type": "string" },
                    "monetaryValue": { "type": "number" },
                    "assignedTo": { "type": "string" }
                },
                "required": ["pipelineId", "locationId", "name", "pipelineStageId", "status", "contactId"]
            },
            "inspector": {
                "inputs": {
                    "pipelineId": {
                        "type": "select",
                        "label": "Pipeline",
                        "index": 1,
                        "tooltip": "Select the pipeline to create the opportunity in.",
                        "source": {
                            "url": "/component/appmixer/gohighlevel/core/ListPipelines?outPort=out",
                            "data": {
                                "properties": { "locationId": "{{locationId}}" },
                                "transform": "./ListPipelines#toSelectArray"
                            }
                        }
                    },
                    "locationId": {
                        "type": "text",
                        "label": "Location ID",
                        "index": 2,
                        "tooltip": "The ID of the GoHighLevel location (sub-account)."
                    },
                    "name": {
                        "type": "text",
                        "label": "Opportunity Name",
                        "index": 3,
                        "tooltip": "Name/title of the opportunity."
                    },
                    "pipelineStageId": {
                        "type": "text",
                        "label": "Pipeline Stage ID",
                        "index": 4,
                        "tooltip": "The ID of the pipeline stage for the opportunity."
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 5,
                        "tooltip": "The status of the opportunity.",
                        "defaultValue": "open",
                        "options": [
                            { "label": "Open", "value": "open" },
                            { "label": "Won", "value": "won" },
                            { "label": "Lost", "value": "lost" },
                            { "label": "Abandoned", "value": "abandoned" }
                        ]
                    },
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 6,
                        "tooltip": "The ID of the contact associated with this opportunity."
                    },
                    "monetaryValue": {
                        "type": "number",
                        "label": "Monetary Value",
                        "index": 7,
                        "tooltip": "The monetary value of the opportunity."
                    },
                    "assignedTo": {
                        "type": "text",
                        "label": "Assigned To (User ID)",
                        "index": 8,
                        "tooltip": "The ID of the user to assign this opportunity to."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Opportunity ID", "value": "id" },
                { "label": "Name", "value": "name" },
                { "label": "Status", "value": "status" },
                { "label": "Pipeline ID", "value": "pipelineId" },
                { "label": "Pipeline Stage ID", "value": "pipelineStageId" },
                { "label": "Pipeline Stage Name", "value": "pipelineStageName" },
                { "label": "Contact ID", "value": "contactId" },
                { "label": "Monetary Value", "value": "monetaryValue" },
                { "label": "Assigned To", "value": "assignedTo" },
                { "label": "Location ID", "value": "locationId" },
                { "label": "Date Added", "value": "createdAt" },
                { "label": "Date Updated", "value": "updatedAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
