{
    "name": "appmixer.miro.core.ListItems",
    "label": "List Items",
    "description": "List the items on a board, optionally only items of one type. Returns up to 50 items.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:miro"
    },
    "quota": {
        "manager": "appmixer:miro",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "sticky_note",
                            "card",
                            "app_card",
                            "shape",
                            "text",
                            "image",
                            "document",
                            "embed",
                            "frame",
                            "preview",
                            "doc_format",
                            "data_table_format"
                        ]
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": [
                    "boardId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "index": 1,
                        "label": "Board",
                        "tooltip": "Pick a board, or type its Board ID (the part after <code>/board/</code> in the board URL).",
                        "source": {
                            "url": "/component/appmixer/miro/core/FindBoards?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindBoards#toSelectArray"
                            }
                        }
                    },
                    "type": {
                        "type": "select",
                        "index": 2,
                        "label": "Item Type",
                        "tooltip": "List only items of this type. Leave empty for all items.",
                        "options": [
                            {
                                "label": "Sticky note",
                                "value": "sticky_note"
                            },
                            {
                                "label": "Card",
                                "value": "card"
                            },
                            {
                                "label": "App card",
                                "value": "app_card"
                            },
                            {
                                "label": "Shape",
                                "value": "shape"
                            },
                            {
                                "label": "Text",
                                "value": "text"
                            },
                            {
                                "label": "Image",
                                "value": "image"
                            },
                            {
                                "label": "Document",
                                "value": "document"
                            },
                            {
                                "label": "Embed",
                                "value": "embed"
                            },
                            {
                                "label": "Frame",
                                "value": "frame"
                            },
                            {
                                "label": "Preview",
                                "value": "preview"
                            },
                            {
                                "label": "Doc format",
                                "value": "doc_format"
                            },
                            {
                                "label": "Data table format",
                                "value": "data_table_format"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 3,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/miro/core/ListItems?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/boardId": "dummy",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
