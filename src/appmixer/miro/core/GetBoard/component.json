{
    "name": "appmixer.miro.core.GetBoard",
    "label": "Get Board",
    "description": "Get the details of a board.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:miro"
    },
    "quota": {
        "manager": "appmixer:miro",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    }
                },
                "required": [
                    "boardId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "index": 1,
                        "label": "Board",
                        "tooltip": "Pick a board, or type its Board ID (the part after <code>/board/</code> in the board URL).",
                        "source": {
                            "url": "/component/appmixer/miro/core/FindBoards?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindBoards#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Board ID",
                        "example": "uXjVLmJ9b1E="
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Q4 Planning"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Roadmap brainstorm for Q4"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "board"
                    },
                    "viewLink": {
                        "type": "string",
                        "title": "View Link",
                        "example": "https://miro.com/app/board/uXjVLmJ9b1E="
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-20T09:15:00Z"
                    },
                    "modifiedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Modified At",
                        "example": "2026-11-20T10:42:31Z"
                    },
                    "team": {
                        "type": "object",
                        "title": "Team",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Team.ID",
                                "example": "3458764512345678000"
                            },
                            "name": {
                                "type": "string",
                                "title": "Team.Name",
                                "example": "Product Team"
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "project": {
                        "type": "object",
                        "title": "Project",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Project.ID",
                                "example": "3458764598765432100"
                            }
                        },
                        "required": []
                    },
                    "owner": {
                        "type": "object",
                        "title": "Owner",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Owner.ID",
                                "example": "3458764512345678901"
                            },
                            "name": {
                                "type": "string",
                                "title": "Owner.Name",
                                "example": "Jane Doe"
                            },
                            "type": {
                                "type": "string",
                                "title": "Owner.Type",
                                "example": "user"
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "createdBy": {
                        "type": "object",
                        "title": "Created By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Created By.ID",
                                "example": "3458764512345678901"
                            },
                            "name": {
                                "type": "string",
                                "title": "Created By.Name",
                                "example": "Jane Doe"
                            },
                            "type": {
                                "type": "string",
                                "title": "Created By.Type",
                                "example": "user"
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "modifiedBy": {
                        "type": "object",
                        "title": "Modified By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Modified By.ID",
                                "example": "3458764512345678901"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By.Name",
                                "example": "Jane Doe"
                            },
                            "type": {
                                "type": "string",
                                "title": "Modified By.Type",
                                "example": "user"
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "currentUserMembership": {
                        "type": "object",
                        "title": "Current User Membership",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Current User Membership.ID",
                                "example": "3458764512345678901"
                            },
                            "name": {
                                "type": "string",
                                "title": "Current User Membership.Name",
                                "example": "Jane Doe"
                            },
                            "role": {
                                "type": "string",
                                "title": "Current User Membership.Role",
                                "example": "owner"
                            }
                        },
                        "required": [
                            "id"
                        ]
                    },
                    "policy": {
                        "type": "object",
                        "title": "Policy",
                        "properties": {
                            "sharingPolicy": {
                                "type": "object",
                                "title": "Policy.Sharing Policy",
                                "properties": {
                                    "access": {
                                        "type": "string",
                                        "title": "Policy.Sharing Policy.Access",
                                        "example": "private"
                                    },
                                    "teamAccess": {
                                        "type": "string",
                                        "title": "Policy.Sharing Policy.Team Access",
                                        "example": "edit"
                                    },
                                    "organizationAccess": {
                                        "type": "string",
                                        "title": "Policy.Sharing Policy.Organization Access",
                                        "example": "private"
                                    },
                                    "inviteToAccountAndBoardLinkAccess": {
                                        "type": "string",
                                        "title": "Policy.Sharing Policy.Invite Link Access",
                                        "example": "no_access"
                                    }
                                },
                                "required": []
                            },
                            "permissionsPolicy": {
                                "type": "object",
                                "title": "Policy.Permissions Policy",
                                "properties": {
                                    "collaborationToolsStartAccess": {
                                        "type": "string",
                                        "title": "Policy.Permissions Policy.Collaboration Tools Start Access",
                                        "example": "all_editors"
                                    },
                                    "copyAccess": {
                                        "type": "string",
                                        "title": "Policy.Permissions Policy.Copy Access",
                                        "example": "anyone"
                                    },
                                    "sharingAccess": {
                                        "type": "string",
                                        "title": "Policy.Permissions Policy.Sharing Access",
                                        "example": "team_members_with_editing_rights"
                                    }
                                },
                                "required": []
                            }
                        },
                        "required": []
                    }
                },
                "required": [
                    "id",
                    "name",
                    "description",
                    "type"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
