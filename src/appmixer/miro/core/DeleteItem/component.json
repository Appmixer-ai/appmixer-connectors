{
    "name": "appmixer.miro.core.DeleteItem",
    "label": "Delete Item",
    "description": "Delete an item from a board, of any type.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:miro"
    },
    "quota": {
        "manager": "appmixer:miro",
        "resources": [
            "requests",
            "heavy"
        ],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    },
                    "itemId": {
                        "type": "string"
                    }
                },
                "required": [
                    "boardId",
                    "itemId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "text",
                        "index": 1,
                        "label": "Board",
                        "tooltip": "Pick a board, or type its Board ID (the part after <code>/board/</code> in the board URL).",
                        "source": {
                            "url": "/component/appmixer/miro/core/FindBoards?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindBoards#toSelectArray"
                            }
                        }
                    },
                    "itemId": {
                        "type": "text",
                        "index": 2,
                        "label": "Item",
                        "tooltip": "The item to delete. Pick an item, or type its Item ID.",
                        "source": {
                            "url": "/component/appmixer/miro/core/ListItems?outPort=out",
                            "data": {
                                "messages": {
                                    "in/boardId": "inputs/in/boardId"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListItems#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
