{
    "name": "appmixer.piloterr.core.GetWebsiteHtml",
    "label": "Get Website HTML",
    "description": "Fetch the HTML of a public web page with Piloterr. Choose the crawler (plain HTTP), rendering (headless browser for JavaScript pages) or web unlocker (anti-bot protection) engine.",
    "author": "Piloterr <josselin.liebe@piloterr.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:piloterr"
    },
    "quota": {
        "manager": "appmixer:piloterr",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "engine": {
                        "type": "string"
                    }
                },
                "required": [
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "URL",
                        "tooltip": "Public URL of the page, starting with <code>http://</code> or <code>https://</code>."
                    },
                    "engine": {
                        "type": "select",
                        "index": 2,
                        "label": "Engine",
                        "tooltip": "<code>crawler</code> is the cheapest; <code>rendering</code> runs a headless browser; <code>webunlocker</code> gets past anti-bot protection.",
                        "defaultValue": "crawler",
                        "options": [
                            {
                                "label": "Crawler",
                                "value": "crawler"
                            },
                            {
                                "label": "Rendering",
                                "value": "rendering"
                            },
                            {
                                "label": "Web Unlocker",
                                "value": "webunlocker"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://example.com"
                    },
                    "engine": {
                        "type": "string",
                        "title": "Engine",
                        "example": "crawler"
                    },
                    "html": {
                        "type": "string",
                        "title": "HTML",
                        "example": "<!doctype html><html>...</html>"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
