{
    "name": "appmixer.linkedin.shares.CreateCompanyPost",
    "author": "Appmixer",
    "description": "Create a new post on LinkedIn on behalf of a company page you manage.",
    "private": false,
    "version": "1.0.0",
    "dependencies": {
        "service": "2.0.0"
    },
    "auth": {
        "service": "appmixer:linkedin",
        "scope": [ "w_organization_social" ]
    },
    "quota": {
        "manager": "appmixer:linkedin:shares",
        "resources": "shares",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organizationId": {
                        "type": "string"
                    },
                    "visibility": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "specificLink": {
                        "type": "boolean"
                    },
                    "url": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [ "organizationId", "text" ]
            },
            "inspector": {
                "inputs": {
                    "organizationId": {
                        "type": "text",
                        "label": "Organization",
                        "index": 1,
                        "tooltip": "Select a company page to post as. You must be an administrator of the page. If the list is empty, enter the numeric organization ID manually (found in the company page URL: linkedin.com/company/{id}/).",
                        "source": {
                            "url": "/component/appmixer/linkedin/shares/ListAdminOrganizations?outPort=out",
                            "data": {
                                "transform": "./ListAdminOrganizations#organizationsToSelectArray",
                                "messages": {
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "visibility": {
                        "type": "select",
                        "label": "Visibility",
                        "options": [
                            { "label": "Public", "value": "PUBLIC" },
                            { "label": "Logged In Members Only", "value": "LOGGED_IN" }
                        ],
                        "defaultValue": "PUBLIC",
                        "index": 2,
                        "tooltip": "Select who can see this post. Note: 'Connections Only' is not available for company page posts."
                    },
                    "text": {
                        "type": "text",
                        "tooltip": "Text content of the post.",
                        "label": "Text",
                        "index": 3
                    },
                    "specificLink": {
                        "type": "toggle",
                        "tooltip": "Enable to attach a URL article link to the post.",
                        "label": "Share specific link",
                        "defaultValue": false,
                        "index": 4
                    },
                    "url": {
                        "type": "text",
                        "tooltip": "A fully qualified URL for the content being shared.",
                        "label": "URL",
                        "index": 5,
                        "when": { "eq": { "specificLink": true } }
                    },
                    "title": {
                        "type": "text",
                        "tooltip": "The title of the content being shared.",
                        "label": "Title",
                        "index": 6,
                        "when": { "eq": { "specificLink": true } }
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "The description of the content being shared.",
                        "label": "Description",
                        "index": 7,
                        "when": { "eq": { "specificLink": true } }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Status", "value": "status" },
                { "label": "Post ID", "value": "postId" }
            ]
        }
    ],
    "properties": {},
    "icon": "data:image/svg+xml;base64,"
}
