{
    "name": "appmixer.freshservice.core.CreateChange",
    "label": "Create Change",
    "description": "Create a change request.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "requesterId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "impact": {
                        "type": "integer"
                    },
                    "risk": {
                        "type": "integer"
                    },
                    "changeType": {
                        "type": "integer"
                    },
                    "plannedStartDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "plannedEndDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "agentId": {
                        "type": "string"
                    },
                    "groupId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "subCategory": {
                        "type": "string"
                    },
                    "itemCategory": {
                        "type": "string"
                    },
                    "workspaceId": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "subject",
                    "description",
                    "status",
                    "priority",
                    "impact",
                    "risk",
                    "changeType"
                ]
            },
            "inspector": {
                "inputs": {
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "Subject of the change.",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Content of the change. HTML is allowed.",
                        "index": 2
                    },
                    "email": {
                        "type": "text",
                        "label": "Requester Email",
                        "tooltip": "Email of the user who requests the change. Fill in this or Requester ID.",
                        "index": 3
                    },
                    "requesterId": {
                        "type": "text",
                        "label": "Requester ID",
                        "tooltip": "Numeric ID of the user who requests the change. Fill in this or Requester Email.",
                        "index": 4
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Status of the change.",
                        "options": [
                            {
                                "label": "Open",
                                "value": 1
                            },
                            {
                                "label": "Planning",
                                "value": 2
                            },
                            {
                                "label": "Approval",
                                "value": 3
                            },
                            {
                                "label": "Pending Release",
                                "value": 4
                            },
                            {
                                "label": "Pending Review",
                                "value": 5
                            },
                            {
                                "label": "Closed",
                                "value": 6
                            }
                        ],
                        "defaultValue": 1,
                        "index": 5
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority of the change.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            },
                            {
                                "label": "Urgent",
                                "value": 4
                            }
                        ],
                        "defaultValue": 1,
                        "index": 6
                    },
                    "impact": {
                        "type": "select",
                        "label": "Impact",
                        "tooltip": "Impact of the change.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "defaultValue": 1,
                        "index": 7
                    },
                    "risk": {
                        "type": "select",
                        "label": "Risk",
                        "tooltip": "Risk of the change.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            },
                            {
                                "label": "Very High",
                                "value": 4
                            }
                        ],
                        "defaultValue": 1,
                        "index": 8
                    },
                    "changeType": {
                        "type": "select",
                        "label": "Change Type",
                        "tooltip": "Type of the change.",
                        "options": [
                            {
                                "label": "Minor",
                                "value": 1
                            },
                            {
                                "label": "Standard",
                                "value": 2
                            },
                            {
                                "label": "Major",
                                "value": 3
                            },
                            {
                                "label": "Emergency",
                                "value": 4
                            }
                        ],
                        "defaultValue": 1,
                        "index": 9
                    },
                    "plannedStartDate": {
                        "type": "date-time",
                        "label": "Planned Start Date",
                        "tooltip": "Optional. When the change starts.",
                        "index": 10
                    },
                    "plannedEndDate": {
                        "type": "date-time",
                        "label": "Planned End Date",
                        "tooltip": "Optional. When the change ends.",
                        "index": 11
                    },
                    "agentId": {
                        "type": "text",
                        "label": "Agent ID",
                        "tooltip": "Optional. Numeric ID of the agent to assign the change to.",
                        "index": 12
                    },
                    "groupId": {
                        "type": "text",
                        "label": "Group ID",
                        "tooltip": "Optional. Numeric ID of the agent group to assign the change to.",
                        "index": 13
                    },
                    "departmentId": {
                        "type": "text",
                        "label": "Department ID",
                        "tooltip": "Optional. Numeric ID of the department requesting the change.",
                        "index": 14
                    },
                    "category": {
                        "type": "text",
                        "label": "Category",
                        "tooltip": "Optional. A category of the change form, e.g. Hardware.",
                        "index": 15
                    },
                    "subCategory": {
                        "type": "text",
                        "label": "Sub Category",
                        "tooltip": "Optional.",
                        "index": 16
                    },
                    "itemCategory": {
                        "type": "text",
                        "label": "Item Category",
                        "tooltip": "Optional.",
                        "index": 17
                    },
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace ID",
                        "tooltip": "Optional, for accounts with workspaces. Without it the primary workspace is used.",
                        "index": 18
                    },
                    "customFields": {
                        "type": "textarea",
                        "label": "Custom Fields",
                        "tooltip": "Optional. A JSON object of custom field names (as in Admin > Form Fields) and values, e.g. {\"asset_tag\": \"LAP-042\"}.",
                        "index": 19
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "status",
                    "priority",
                    "impact",
                    "risk",
                    "change_type",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Change ID",
                        "example": 7
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Replace Exchange Server ES3"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description (HTML)",
                        "example": "<div>ES3 keeps failing; replace it.</div>"
                    },
                    "description_text": {
                        "type": "string",
                        "title": "Description",
                        "example": "ES3 keeps failing; replace it."
                    },
                    "requester_id": {
                        "type": "integer",
                        "title": "Requester ID",
                        "example": 1000000675
                    },
                    "agent_id": {
                        "type": "integer",
                        "title": "Agent ID",
                        "example": 1000000493
                    },
                    "group_id": {
                        "type": "integer",
                        "title": "Group ID",
                        "example": 1000000712
                    },
                    "department_id": {
                        "type": "integer",
                        "title": "Department ID",
                        "example": 1000000554
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 2
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 1
                    },
                    "impact": {
                        "type": "integer",
                        "title": "Impact",
                        "example": 1
                    },
                    "status": {
                        "type": "integer",
                        "title": "Status",
                        "example": 1
                    },
                    "risk": {
                        "type": "integer",
                        "title": "Risk",
                        "example": 1
                    },
                    "change_type": {
                        "type": "integer",
                        "title": "Change Type",
                        "example": 1
                    },
                    "approval_status": {
                        "type": "integer",
                        "title": "Approval Status",
                        "example": 4
                    },
                    "planned_start_date": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Planned Start Date",
                        "example": "2026-11-25T16:00:00Z"
                    },
                    "planned_end_date": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Planned End Date",
                        "example": "2026-11-25T18:00:00Z"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "example": "Hardware"
                    },
                    "sub_category": {
                        "type": "string",
                        "title": "Sub Category",
                        "example": "Server"
                    },
                    "item_category": {
                        "type": "string",
                        "title": "Item Category",
                        "example": "Mail server"
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "properties": {},
                        "example": {
                            "rollback_plan": "Switch back to ES2"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-21T06:30:45Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-21T06:30:45Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
