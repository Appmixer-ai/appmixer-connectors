{
    "name": "appmixer.freshservice.core.FindRequesters",
    "label": "Find Requesters",
    "description": "Find requesters by email, or with a Freshservice requester query, e.g. job_title:'Accountant'. Without either it lists the requesters. Returns at most 1,000 requesters. Query results come from a search index that can lag a few minutes behind changes; the email lookup does not.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "query": {
                        "type": "string"
                    },
                    "includeAgents": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "Optional. The exact email of the requester.",
                        "index": 1
                    },
                    "query": {
                        "type": "text",
                        "label": "Query",
                        "tooltip": "Optional. A Freshservice requester filter, e.g. <code>first_name:'Ron' AND language:'en'</code> or <code>~[first_name|last_name]:'wea'</code> for \"starts with\". Fields: first_name, last_name, name, job_title, primary_email, work_phone_number, mobile_phone_number, department_id, reporting_manager_id, time_zone, language, location_id, created_at, updated_at and custom fields. Used instead of Email when both are set.",
                        "index": 2
                    },
                    "includeAgents": {
                        "type": "toggle",
                        "label": "Include Agents",
                        "tooltip": "Include agents in the results. Needs the Manage Agents permission.",
                        "defaultValue": false,
                        "index": 3
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ],
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/freshservice/core/FindRequesters?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
