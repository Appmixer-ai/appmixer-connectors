{
    "name": "appmixer.freshservice.core.CreateRequester",
    "label": "Create Requester",
    "description": "Create a requester (an employee who raises tickets). It needs a first name and one of primary email, work phone or mobile phone.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "primaryEmail": {
                        "type": "string"
                    },
                    "workPhoneNumber": {
                        "type": "string"
                    },
                    "mobilePhoneNumber": {
                        "type": "string"
                    },
                    "jobTitle": {
                        "type": "string"
                    },
                    "departmentIds": {
                        "type": "string"
                    },
                    "reportingManagerId": {
                        "type": "string"
                    },
                    "locationId": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    },
                    "backgroundInformation": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "firstName"
                ]
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "tooltip": "First name of the requester.",
                        "index": 1
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "tooltip": "Optional. Last name of the requester.",
                        "index": 2
                    },
                    "primaryEmail": {
                        "type": "text",
                        "label": "Primary Email",
                        "tooltip": "Primary email of the requester. Fill in this, Work Phone Number or Mobile Phone Number.",
                        "index": 3
                    },
                    "workPhoneNumber": {
                        "type": "text",
                        "label": "Work Phone Number",
                        "tooltip": "Optional. Work phone number.",
                        "index": 4
                    },
                    "mobilePhoneNumber": {
                        "type": "text",
                        "label": "Mobile Phone Number",
                        "tooltip": "Optional. Mobile phone number.",
                        "index": 5
                    },
                    "jobTitle": {
                        "type": "text",
                        "label": "Job Title",
                        "tooltip": "Optional.",
                        "index": 6
                    },
                    "departmentIds": {
                        "type": "text",
                        "label": "Department IDs",
                        "tooltip": "Optional. Comma-separated numeric IDs of the departments of the requester.",
                        "index": 7
                    },
                    "reportingManagerId": {
                        "type": "text",
                        "label": "Reporting Manager ID",
                        "tooltip": "Optional. User ID of the requester's reporting manager.",
                        "index": 8
                    },
                    "locationId": {
                        "type": "text",
                        "label": "Location ID",
                        "tooltip": "Optional. Numeric ID of the location of the requester.",
                        "index": 9
                    },
                    "address": {
                        "type": "text",
                        "label": "Address",
                        "tooltip": "Optional.",
                        "index": 10
                    },
                    "timeZone": {
                        "type": "text",
                        "label": "Time Zone",
                        "tooltip": "Optional. A Freshservice time zone name, e.g. Eastern Time (US & Canada).",
                        "index": 11
                    },
                    "language": {
                        "type": "text",
                        "label": "Language",
                        "tooltip": "Optional. Language code, e.g. en or ja-JP. Freshservice uses en when it is empty.",
                        "index": 12
                    },
                    "backgroundInformation": {
                        "type": "textarea",
                        "label": "Background Information",
                        "tooltip": "Optional.",
                        "index": 13
                    },
                    "customFields": {
                        "type": "textarea",
                        "label": "Custom Fields",
                        "tooltip": "Optional. A JSON object of custom field names (as in Admin > Form Fields) and values, e.g. {\"asset_tag\": \"LAP-042\"}.",
                        "index": 14
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "first_name",
                    "active"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Requester ID",
                        "example": 1000000888
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Ron"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Weasley"
                    },
                    "job_title": {
                        "type": "string",
                        "title": "Job Title",
                        "example": "Accountant"
                    },
                    "primary_email": {
                        "type": "string",
                        "title": "Primary Email",
                        "example": "ron.weasley@example.com"
                    },
                    "secondary_emails": {
                        "type": "array",
                        "title": "Secondary Emails",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "ron@example.org"
                        ]
                    },
                    "work_phone_number": {
                        "type": "string",
                        "title": "Work Phone Number",
                        "example": "62443"
                    },
                    "mobile_phone_number": {
                        "type": "string",
                        "title": "Mobile Phone Number",
                        "example": "77762443"
                    },
                    "department_ids": {
                        "type": "array",
                        "title": "Department IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            1000000554
                        ]
                    },
                    "reporting_manager_id": {
                        "type": "integer",
                        "title": "Reporting Manager ID",
                        "example": 1000000656
                    },
                    "location_id": {
                        "type": "integer",
                        "title": "Location ID",
                        "example": 1000000023
                    },
                    "address": {
                        "type": "string",
                        "title": "Address",
                        "example": "12 Grimmauld Place, London"
                    },
                    "time_zone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Edinburgh"
                    },
                    "time_format": {
                        "type": "string",
                        "title": "Time Format",
                        "example": "12h"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "background_information": {
                        "type": "string",
                        "title": "Background Information",
                        "example": "Joined the finance team in 2024."
                    },
                    "active": {
                        "type": "boolean",
                        "title": "Active",
                        "example": true
                    },
                    "has_logged_in": {
                        "type": "boolean",
                        "title": "Has Logged In",
                        "example": false
                    },
                    "is_agent": {
                        "type": "boolean",
                        "title": "Is Agent",
                        "example": false
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "properties": {},
                        "example": {
                            "employee_number": "E-1042"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-21T08:30:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-21T08:30:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
