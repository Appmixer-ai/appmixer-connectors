{
    "name": "appmixer.freshservice.core.UpdateTicket",
    "label": "Update Ticket",
    "description": "Update a ticket. Only the fields you fill in are changed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "urgency": {
                        "type": "integer"
                    },
                    "impact": {
                        "type": "integer"
                    },
                    "groupId": {
                        "type": "string"
                    },
                    "responderId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "subCategory": {
                        "type": "string"
                    },
                    "itemCategory": {
                        "type": "string"
                    },
                    "dueBy": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "tooltip": "Numeric ID of the ticket, e.g. 265. Find Tickets and Create Ticket return it.",
                        "index": 1
                    },
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "New subject.",
                        "index": 2
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "New content of the ticket. HTML is allowed.",
                        "index": 3
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "New status.",
                        "options": [
                            {
                                "label": "Open",
                                "value": 2
                            },
                            {
                                "label": "Pending",
                                "value": 3
                            },
                            {
                                "label": "Resolved",
                                "value": 4
                            },
                            {
                                "label": "Closed",
                                "value": 5
                            }
                        ],
                        "index": 4
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "New priority.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            },
                            {
                                "label": "Urgent",
                                "value": 4
                            }
                        ],
                        "index": 5
                    },
                    "urgency": {
                        "type": "select",
                        "label": "Urgency",
                        "tooltip": "New urgency.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "index": 6
                    },
                    "impact": {
                        "type": "select",
                        "label": "Impact",
                        "tooltip": "New impact.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "index": 7
                    },
                    "groupId": {
                        "type": "text",
                        "label": "Group ID",
                        "tooltip": "Numeric ID of the agent group to assign the ticket to.",
                        "index": 8
                    },
                    "responderId": {
                        "type": "text",
                        "label": "Agent ID",
                        "tooltip": "Numeric ID of the agent to assign the ticket to.",
                        "index": 9
                    },
                    "departmentId": {
                        "type": "text",
                        "label": "Department ID",
                        "tooltip": "Numeric ID of the department of the ticket.",
                        "index": 10
                    },
                    "category": {
                        "type": "text",
                        "label": "Category",
                        "tooltip": "A category of the ticket form, e.g. Hardware.",
                        "index": 11
                    },
                    "subCategory": {
                        "type": "text",
                        "label": "Sub Category",
                        "tooltip": "A sub category of the chosen category.",
                        "index": 12
                    },
                    "itemCategory": {
                        "type": "text",
                        "label": "Item Category",
                        "tooltip": "An item of the chosen sub category.",
                        "index": 13
                    },
                    "dueBy": {
                        "type": "date-time",
                        "label": "Due By",
                        "tooltip": "When the ticket is due to be resolved.",
                        "index": 14
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "tooltip": "Comma-separated tags. They replace all tags of the ticket.",
                        "index": 15
                    },
                    "customFields": {
                        "type": "textarea",
                        "label": "Custom Fields",
                        "tooltip": "Optional. A JSON object of custom field names (as in Admin > Form Fields) and values, e.g. {\"asset_tag\": \"LAP-042\"}.",
                        "index": 16
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
