{
    "name": "appmixer.freshservice.core.CreateProblem",
    "label": "Create Problem",
    "description": "Create a problem: the underlying cause of one or more incidents.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "requesterId": {
                        "type": "string"
                    },
                    "dueBy": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "impact": {
                        "type": "integer"
                    },
                    "knownError": {
                        "type": "boolean"
                    },
                    "agentId": {
                        "type": "string"
                    },
                    "groupId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "subCategory": {
                        "type": "string"
                    },
                    "itemCategory": {
                        "type": "string"
                    },
                    "workspaceId": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "subject",
                    "description",
                    "dueBy",
                    "status",
                    "priority",
                    "impact"
                ]
            },
            "inspector": {
                "inputs": {
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "Subject of the problem.",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Content of the problem. HTML is allowed.",
                        "index": 2
                    },
                    "email": {
                        "type": "text",
                        "label": "Requester Email",
                        "tooltip": "Email of the user who raises the problem. Fill in this or Requester ID.",
                        "index": 3
                    },
                    "requesterId": {
                        "type": "text",
                        "label": "Requester ID",
                        "tooltip": "Numeric ID of the user who raises the problem. Fill in this or Requester Email.",
                        "index": 4
                    },
                    "dueBy": {
                        "type": "date-time",
                        "label": "Due By",
                        "tooltip": "When the problem is due to be resolved.",
                        "index": 5
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Status of the problem.",
                        "options": [
                            {
                                "label": "Open",
                                "value": 1
                            },
                            {
                                "label": "Change Requested",
                                "value": 2
                            },
                            {
                                "label": "Closed",
                                "value": 3
                            }
                        ],
                        "defaultValue": 1,
                        "index": 6
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority of the problem.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            },
                            {
                                "label": "Urgent",
                                "value": 4
                            }
                        ],
                        "defaultValue": 1,
                        "index": 7
                    },
                    "impact": {
                        "type": "select",
                        "label": "Impact",
                        "tooltip": "Impact of the problem.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "defaultValue": 1,
                        "index": 8
                    },
                    "knownError": {
                        "type": "toggle",
                        "label": "Known Error",
                        "tooltip": "Mark the problem as a known error.",
                        "defaultValue": false,
                        "index": 9
                    },
                    "agentId": {
                        "type": "text",
                        "label": "Agent ID",
                        "tooltip": "Optional. Numeric ID of the agent to assign the problem to.",
                        "index": 10
                    },
                    "groupId": {
                        "type": "text",
                        "label": "Group ID",
                        "tooltip": "Optional. Numeric ID of the agent group to assign the problem to.",
                        "index": 11
                    },
                    "departmentId": {
                        "type": "text",
                        "label": "Department ID",
                        "tooltip": "Optional. Numeric ID of the department raising the problem.",
                        "index": 12
                    },
                    "category": {
                        "type": "text",
                        "label": "Category",
                        "tooltip": "Optional. A category of the problem form, e.g. Hardware.",
                        "index": 13
                    },
                    "subCategory": {
                        "type": "text",
                        "label": "Sub Category",
                        "tooltip": "Optional.",
                        "index": 14
                    },
                    "itemCategory": {
                        "type": "text",
                        "label": "Item Category",
                        "tooltip": "Optional.",
                        "index": 15
                    },
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace ID",
                        "tooltip": "Optional, for accounts with workspaces. Without it the primary workspace is used.",
                        "index": 16
                    },
                    "customFields": {
                        "type": "textarea",
                        "label": "Custom Fields",
                        "tooltip": "Optional. A JSON object of custom field names (as in Admin > Form Fields) and values, e.g. {\"asset_tag\": \"LAP-042\"}.",
                        "index": 17
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "subject",
                    "status",
                    "priority",
                    "impact"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Problem ID",
                        "example": 12
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Unable to reach email server"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description (HTML)",
                        "example": "<div>Email Server 3 does not answer.</div>"
                    },
                    "description_text": {
                        "type": "string",
                        "title": "Description",
                        "example": "Email Server 3 does not answer."
                    },
                    "requester_id": {
                        "type": "integer",
                        "title": "Requester ID",
                        "example": 1000000675
                    },
                    "agent_id": {
                        "type": "integer",
                        "title": "Agent ID",
                        "example": 1000000493
                    },
                    "group_id": {
                        "type": "integer",
                        "title": "Group ID",
                        "example": 1000000712
                    },
                    "department_id": {
                        "type": "integer",
                        "title": "Department ID",
                        "example": 1000000554
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 2
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 2
                    },
                    "status": {
                        "type": "integer",
                        "title": "Status",
                        "example": 1
                    },
                    "impact": {
                        "type": "integer",
                        "title": "Impact",
                        "example": 1
                    },
                    "known_error": {
                        "type": "boolean",
                        "title": "Known Error",
                        "example": false
                    },
                    "due_by": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Due By",
                        "example": "2026-11-28T16:00:00Z"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "example": "Hardware"
                    },
                    "sub_category": {
                        "type": "string",
                        "title": "Sub Category",
                        "example": "Peripherals"
                    },
                    "item_category": {
                        "type": "string",
                        "title": "Item Category",
                        "example": "Router"
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "properties": {},
                        "example": {
                            "root_cause_owner": "Network team"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-21T05:50:57Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-21T05:50:57Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
