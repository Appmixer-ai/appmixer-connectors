{
    "name": "appmixer.freshservice.core.CreateTicket",
    "label": "Create Ticket",
    "description": "Create an incident ticket. Give the requester by email (a new requester is created when no user has it) or by Requester ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "requesterId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "source": {
                        "type": "integer"
                    },
                    "urgency": {
                        "type": "integer"
                    },
                    "impact": {
                        "type": "integer"
                    },
                    "groupId": {
                        "type": "string"
                    },
                    "responderId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "subCategory": {
                        "type": "string"
                    },
                    "itemCategory": {
                        "type": "string"
                    },
                    "dueBy": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "tags": {
                        "type": "string"
                    },
                    "ccEmails": {
                        "type": "string"
                    },
                    "workspaceId": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "subject",
                    "description",
                    "status",
                    "priority"
                ]
            },
            "inspector": {
                "inputs": {
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "Subject of the ticket.",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Content of the ticket. HTML is allowed.",
                        "index": 2
                    },
                    "email": {
                        "type": "text",
                        "label": "Requester Email",
                        "tooltip": "Email of the requester. Freshservice creates the requester when no user has this email. Fill in this or Requester ID.",
                        "index": 3
                    },
                    "requesterId": {
                        "type": "text",
                        "label": "Requester ID",
                        "tooltip": "Numeric ID of an existing requester (Find Requesters returns it). Fill in this or Requester Email.",
                        "index": 4
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Status of the ticket.",
                        "options": [
                            {
                                "label": "Open",
                                "value": 2
                            },
                            {
                                "label": "Pending",
                                "value": 3
                            },
                            {
                                "label": "Resolved",
                                "value": 4
                            },
                            {
                                "label": "Closed",
                                "value": 5
                            }
                        ],
                        "defaultValue": 2,
                        "index": 5
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority of the ticket.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            },
                            {
                                "label": "Urgent",
                                "value": 4
                            }
                        ],
                        "defaultValue": 1,
                        "index": 6
                    },
                    "source": {
                        "type": "select",
                        "label": "Source",
                        "tooltip": "Optional. The channel the ticket came from. Freshservice uses Portal when it is empty.",
                        "options": [
                            {
                                "label": "Email",
                                "value": 1
                            },
                            {
                                "label": "Portal",
                                "value": 2
                            },
                            {
                                "label": "Phone",
                                "value": 3
                            },
                            {
                                "label": "Chat",
                                "value": 4
                            },
                            {
                                "label": "Feedback widget",
                                "value": 5
                            },
                            {
                                "label": "Yammer",
                                "value": 6
                            },
                            {
                                "label": "AWS Cloudwatch",
                                "value": 7
                            },
                            {
                                "label": "Pagerduty",
                                "value": 8
                            },
                            {
                                "label": "Walkup",
                                "value": 9
                            },
                            {
                                "label": "Slack",
                                "value": 10
                            }
                        ],
                        "index": 7
                    },
                    "urgency": {
                        "type": "select",
                        "label": "Urgency",
                        "tooltip": "Optional.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "index": 8
                    },
                    "impact": {
                        "type": "select",
                        "label": "Impact",
                        "tooltip": "Optional.",
                        "options": [
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ],
                        "index": 9
                    },
                    "groupId": {
                        "type": "text",
                        "label": "Group ID",
                        "tooltip": "Optional. Numeric ID of the agent group to assign the ticket to.",
                        "index": 10
                    },
                    "responderId": {
                        "type": "text",
                        "label": "Agent ID",
                        "tooltip": "Optional. Numeric ID of the agent to assign the ticket to.",
                        "index": 11
                    },
                    "departmentId": {
                        "type": "text",
                        "label": "Department ID",
                        "tooltip": "Optional. Numeric ID of the department of the ticket.",
                        "index": 12
                    },
                    "category": {
                        "type": "text",
                        "label": "Category",
                        "tooltip": "Optional. A category of the ticket form, e.g. Hardware.",
                        "index": 13
                    },
                    "subCategory": {
                        "type": "text",
                        "label": "Sub Category",
                        "tooltip": "Optional. A sub category of the chosen category.",
                        "index": 14
                    },
                    "itemCategory": {
                        "type": "text",
                        "label": "Item Category",
                        "tooltip": "Optional. An item of the chosen sub category.",
                        "index": 15
                    },
                    "dueBy": {
                        "type": "date-time",
                        "label": "Due By",
                        "tooltip": "Optional. When the ticket is due to be resolved. Freshservice computes it from the SLA when it is empty.",
                        "index": 16
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "tooltip": "Optional. Comma-separated tags, e.g. laptop, hardware.",
                        "index": 17
                    },
                    "ccEmails": {
                        "type": "text",
                        "label": "CC Emails",
                        "tooltip": "Optional. Comma-separated email addresses to copy on the ticket.",
                        "index": 18
                    },
                    "workspaceId": {
                        "type": "text",
                        "label": "Workspace ID",
                        "tooltip": "Optional, for accounts with workspaces. Without it the primary workspace is used.",
                        "index": 19
                    },
                    "customFields": {
                        "type": "textarea",
                        "label": "Custom Fields",
                        "tooltip": "Optional. A JSON object of custom field names (as in Admin > Form Fields) and values, e.g. {\"asset_tag\": \"LAP-042\"}.",
                        "index": 20
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "subject",
                    "status",
                    "priority",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 265
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Laptop does not start"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description (HTML)",
                        "example": "<div>My laptop does not start since this morning.</div>"
                    },
                    "description_text": {
                        "type": "string",
                        "title": "Description",
                        "example": "My laptop does not start since this morning."
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "Incident"
                    },
                    "status": {
                        "type": "integer",
                        "title": "Status",
                        "example": 2
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 1
                    },
                    "source": {
                        "type": "integer",
                        "title": "Source",
                        "example": 2
                    },
                    "urgency": {
                        "type": "integer",
                        "title": "Urgency",
                        "example": 1
                    },
                    "impact": {
                        "type": "integer",
                        "title": "Impact",
                        "example": 1
                    },
                    "requester_id": {
                        "type": "integer",
                        "title": "Requester ID",
                        "example": 1000000675
                    },
                    "requested_for_id": {
                        "type": "integer",
                        "title": "Requested For ID",
                        "example": 1000000670
                    },
                    "responder_id": {
                        "type": "integer",
                        "title": "Agent ID",
                        "example": 1000000493
                    },
                    "group_id": {
                        "type": "integer",
                        "title": "Group ID",
                        "example": 1000000712
                    },
                    "department_id": {
                        "type": "integer",
                        "title": "Department ID",
                        "example": 1000000554
                    },
                    "workspace_id": {
                        "type": "integer",
                        "title": "Workspace ID",
                        "example": 2
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "example": "Hardware"
                    },
                    "sub_category": {
                        "type": "string",
                        "title": "Sub Category",
                        "example": "Computer"
                    },
                    "item_category": {
                        "type": "string",
                        "title": "Item Category",
                        "example": "Laptop"
                    },
                    "due_by": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Due By",
                        "example": "2026-11-24T10:34:28Z"
                    },
                    "fr_due_by": {
                        "type": "string",
                        "format": "date-time",
                        "title": "First Response Due By",
                        "example": "2026-11-22T10:34:28Z"
                    },
                    "is_escalated": {
                        "type": "boolean",
                        "title": "Is Escalated",
                        "example": false
                    },
                    "fr_escalated": {
                        "type": "boolean",
                        "title": "First Response Escalated",
                        "example": false
                    },
                    "spam": {
                        "type": "boolean",
                        "title": "Spam",
                        "example": false
                    },
                    "deleted": {
                        "type": "boolean",
                        "title": "Deleted",
                        "example": false
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "laptop",
                            "hardware"
                        ]
                    },
                    "cc_emails": {
                        "type": "array",
                        "title": "CC Emails",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "ram@example.com"
                        ]
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "properties": {},
                        "example": {
                            "asset_tag": "LAP-042"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-21T10:34:28Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-21T10:34:28Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
