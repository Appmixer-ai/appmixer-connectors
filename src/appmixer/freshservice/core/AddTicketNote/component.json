{
    "name": "appmixer.freshservice.core.AddTicketNote",
    "label": "Add Ticket Note",
    "description": "Add a note to a ticket. Notes are private (agents only) unless you turn Private off.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshservice"
    },
    "quota": {
        "manager": "appmixer:freshservice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "private": {
                        "type": "boolean"
                    },
                    "notifyEmails": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId",
                    "body"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "tooltip": "Numeric ID of the ticket, e.g. 265. Find Tickets and Create Ticket return it.",
                        "index": 1
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body",
                        "tooltip": "Content of the note. HTML is allowed.",
                        "index": 2
                    },
                    "private": {
                        "type": "toggle",
                        "label": "Private",
                        "tooltip": "Private notes are visible to agents only. Turn off for a public note the requester sees.",
                        "defaultValue": true,
                        "index": 3
                    },
                    "notifyEmails": {
                        "type": "text",
                        "label": "Notify Emails",
                        "tooltip": "Optional. Comma-separated emails of agents or users to notify about the note.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "ticket_id",
                    "body",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Conversation ID",
                        "example": 1000005176
                    },
                    "ticket_id": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 265
                    },
                    "user_id": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 1000000493
                    },
                    "body": {
                        "type": "string",
                        "title": "Body (HTML)",
                        "example": "<div>Restarted the print server.</div>"
                    },
                    "body_text": {
                        "type": "string",
                        "title": "Body",
                        "example": "Restarted the print server."
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": true
                    },
                    "incoming": {
                        "type": "boolean",
                        "title": "Incoming",
                        "example": false
                    },
                    "to_emails": {
                        "type": "array",
                        "title": "To Emails",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "tom@example.com"
                        ]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-21T09:54:36Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-21T09:54:36Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
