{
    "name": "appmixer.ideas.core.SendGroupBlocks",
    "label": "Send Group Blocks",
    "description": "Send group blocks (group masters with their daily room blocks and pickup) of the connected property to IDeaS RMS (POST /api/public/v1/groups). IDeaS stores each group by its group code; the action COMMIT, MODIFY or CANCEL and the group status say what changed. IDeaS acknowledges the message at once (Out) and processes it later; its result, SUCCESS or FAILED with the reasons, arrives on Done. The connector gives IDeaS the address for the result itself (the ReplyTo header) and accepts only a result signed for this component and account. If IDeaS never reports back, Done does not fire; the schema validation service never reports back.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:ideas"
    },
    "quota": {
        "manager": "appmixer:ideas",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "groups": {
                        "type": "string"
                    },
                    "correlationId": {
                        "type": "string"
                    }
                },
                "required": [
                    "groups"
                ]
            },
            "inspector": {
                "inputs": {
                    "groups": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Group Blocks",
                        "tooltip": "One or more group block masters as a JSON array in the IDeaS format (a single object is accepted too). Each needs <code>groupCode</code>, <code>name</code>, <code>groupStatusCode</code> (DEFINITE, TENTATIVE, CANCELLED, PROSPECT, LOST/REGRET), <code>marketSegmentCode</code>, <code>startDate</code>, <code>endDate</code>, <code>groupTypeCode</code> (TRANSIENT, GROUP), <code>bookingDate</code> and <code>lastModifiedDateTime</code>; <code>groupBlocks</code> holds one item per date and room type (<code>occupancyDate</code>, <code>roomTypeCode</code>, <code>blocks</code>, <code>pickup</code>, <code>currencyCode</code>, <code>singlePersonRate</code>). <code>clientCode</code>, <code>propertyCode</code> and <code>correlationId</code> are filled in from the account and the Correlation ID when an item leaves them out. See the <a href=\"https://developers.ideas.com/group-api/operations/savegroupblockmasters\" target=\"_blank\">field reference</a>."
                    },
                    "correlationId": {
                        "type": "text",
                        "index": 2,
                        "label": "Correlation ID",
                        "tooltip": "Optional. Your own ID for this message, for example a batch number of your PMS (at most 128 characters). It is filled into every item that has no <code>correlationId</code> of its own, and it comes back on both output ports so that you can match the processing result to what you sent. Leave empty to use a new UUID."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "trackerId": {
                        "type": "string",
                        "title": "Tracker ID",
                        "example": "5b0e7c52-1f0a-4c55-9a43-0d3c8e2b7f11"
                    },
                    "statusCode": {
                        "type": "integer",
                        "title": "Status Code",
                        "example": 202
                    },
                    "correlationId": {
                        "type": "string",
                        "title": "Correlation ID",
                        "example": "pms-batch-20261127-0001"
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 1
                    },
                    "responseBody": {
                        "type": "string",
                        "title": "Response Body",
                        "example": "5b0e7c52-1f0a-4c55-9a43-0d3c8e2b7f11"
                    }
                },
                "required": [
                    "statusCode",
                    "correlationId",
                    "count"
                ]
            }
        },
        {
            "name": "done",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "SUCCESS"
                    },
                    "trackerId": {
                        "type": "string",
                        "title": "Tracker ID",
                        "example": "5b0e7c52-1f0a-4c55-9a43-0d3c8e2b7f11"
                    },
                    "correlationId": {
                        "type": "string",
                        "title": "Correlation ID",
                        "example": "pms-batch-20261127-0001"
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 1
                    },
                    "message": {
                        "type": "string",
                        "title": "Message",
                        "example": "Room type SGC is not configured for the property."
                    },
                    "messages": {
                        "type": "array",
                        "title": "Messages",
                        "example": [
                            {
                                "code": "INVALID_ROOM_TYPE",
                                "text": "Room type SGC is not configured for the property."
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "code": {
                                    "type": "string",
                                    "title": "Messages.Code",
                                    "example": "INVALID_ROOM_TYPE"
                                },
                                "text": {
                                    "type": "string",
                                    "title": "Messages.Text",
                                    "example": "Room type SGC is not configured for the property."
                                }
                            }
                        }
                    }
                },
                "required": [
                    "status",
                    "correlationId",
                    "count"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
