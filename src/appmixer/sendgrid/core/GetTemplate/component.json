{
    "name": "appmixer.sendgrid.core.GetTemplate",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific transactional template by its ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "template_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "template_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "template_id": {
                        "type": "text",
                        "label": "Template Id",
                        "tooltip": "Template ID (dynamic templates start with 'd-').",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Generation",
                    "value": "generation",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Versions",
                    "value": "versions",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}