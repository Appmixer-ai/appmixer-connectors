{
    "name": "appmixer.sendgrid.core.SendEmail",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a transactional email via SendGrid. Supports multiple recipients (To/CC/BCC), plain text and HTML content, attachments (Base64), templates (standard and dynamic), custom headers, categories, custom_args, and scheduled sending (up to 72 hours ahead). Note: the API returns 202 Accepted with no JSON body on success.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "toEmail": {
                        "type": "string"
                    },
                    "toName": {
                        "type": "string"
                    },
                    "ccEmail": {
                        "type": "string"
                    },
                    "ccName": {
                        "type": "string"
                    },
                    "bccEmail": {
                        "type": "string"
                    },
                    "bccName": {
                        "type": "string"
                    },
                    "personalizationSubject": {
                        "type": "string"
                    },
                    "personalizationHeaders": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "personalizationCustomArgs": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "personalizationDynamicTemplateData": {
                        "type": "object",
                        "additionalProperties": true
                    },
                    "personalizationSendAt": {
                        "type": "integer"
                    },
                    "fromEmail": {
                        "type": "string"
                    },
                    "fromName": {
                        "type": "string"
                    },
                    "replyToEmail": {
                        "type": "string"
                    },
                    "replyToName": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string"
                    },
                    "contentValue": {
                        "type": "string"
                    },
                    "attachmentContent": {
                        "type": "string"
                    },
                    "attachmentType": {
                        "type": "string"
                    },
                    "attachmentFilename": {
                        "type": "string"
                    },
                    "attachmentDisposition": {
                        "type": "string"
                    },
                    "attachmentContentId": {
                        "type": "string"
                    },
                    "templateId": {
                        "type": "string"
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "customArgs": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "sendAt": {
                        "type": "integer"
                    },
                    "batchId": {
                        "type": "string"
                    },
                    "sandboxModeEnable": {
                        "type": "boolean"
                    },
                    "clickTrackingEnable": {
                        "type": "boolean"
                    },
                    "clickTrackingEnableText": {
                        "type": "boolean"
                    },
                    "openTrackingEnable": {
                        "type": "boolean"
                    },
                    "openTrackingSubstitutionTag": {
                        "type": "string"
                    },
                    "subscriptionTrackingEnable": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "fromEmail",
                    "toEmail"
                ]
            },
            "inspector": {
                "inputs": {
                    "toEmail": {
                        "type": "text",
                        "tooltip": "Recipient email address.",
                        "label": "To Email",
                        "index": 0
                    },
                    "toName": {
                        "type": "text",
                        "tooltip": "Recipient display name.",
                        "label": "To Name",
                        "index": 1
                    },
                    "ccEmail": {
                        "type": "text",
                        "tooltip": "CC recipient email address.",
                        "label": "CC Email",
                        "index": 2
                    },
                    "ccName": {
                        "type": "text",
                        "tooltip": "CC recipient display name.",
                        "label": "CC Name",
                        "index": 3
                    },
                    "bccEmail": {
                        "type": "text",
                        "tooltip": "BCC recipient email address.",
                        "label": "BCC Email",
                        "index": 4
                    },
                    "bccName": {
                        "type": "text",
                        "tooltip": "BCC recipient display name.",
                        "label": "BCC Name",
                        "index": 5
                    },
                    "personalizationSubject": {
                        "type": "text",
                        "tooltip": "Overrides top-level subject for this personalization only.",
                        "label": "Personalization Subject",
                        "index": 6
                    },
                    "personalizationHeaders": {
                        "type": "text",
                        "tooltip": "Custom headers for this personalization.",
                        "label": "Personalization Headers",
                        "index": 7
                    },
                    "personalizationCustomArgs": {
                        "type": "text",
                        "tooltip": "Custom key-value pairs for tracking on this personalization.",
                        "label": "Personalization Custom Args",
                        "index": 8
                    },
                    "personalizationDynamicTemplateData": {
                        "type": "text",
                        "tooltip": "Data for dynamic templates (Handlebars).",
                        "label": "Personalization Dynamic Template Data",
                        "index": 9
                    },
                    "personalizationSendAt": {
                        "type": "number",
                        "tooltip": "UNIX timestamp to schedule send (max 72 hours in future).",
                        "label": "Personalization Send At",
                        "index": 10
                    },
                    "fromEmail": {
                        "type": "text",
                        "tooltip": "Sender email address.",
                        "label": "From Email",
                        "index": 11
                    },
                    "fromName": {
                        "type": "text",
                        "tooltip": "Sender display name.",
                        "label": "From Name",
                        "index": 12
                    },
                    "replyToEmail": {
                        "type": "text",
                        "tooltip": "Reply-To email address.",
                        "label": "Reply To Email",
                        "index": 13
                    },
                    "replyToName": {
                        "type": "text",
                        "tooltip": "Reply-To display name.",
                        "label": "Reply To Name",
                        "index": 14
                    },
                    "subject": {
                        "type": "text",
                        "tooltip": "Email subject line.",
                        "label": "Subject",
                        "index": 15
                    },
                    "contentType": {
                        "type": "text",
                        "tooltip": "MIME type (e.g., text/plain, text/html).",
                        "label": "Content Type",
                        "index": 16
                    },
                    "contentValue": {
                        "type": "text",
                        "tooltip": "Content value for the given MIME type.",
                        "label": "Content Value",
                        "index": 17
                    },
                    "attachmentContent": {
                        "type": "text",
                        "tooltip": "Base64-encoded file content.",
                        "label": "Attachment Content",
                        "index": 18
                    },
                    "attachmentType": {
                        "type": "text",
                        "tooltip": "MIME type of the attachment.",
                        "label": "Attachment Type",
                        "index": 19
                    },
                    "attachmentFilename": {
                        "type": "text",
                        "tooltip": "Filename including extension.",
                        "label": "Attachment Filename",
                        "index": 20
                    },
                    "attachmentDisposition": {
                        "type": "text",
                        "tooltip": "inline or attachment.",
                        "label": "Attachment Disposition",
                        "index": 21
                    },
                    "attachmentContentId": {
                        "type": "text",
                        "tooltip": "CID for inline attachments.",
                        "label": "Attachment Content Id",
                        "index": 22
                    },
                    "templateId": {
                        "type": "text",
                        "tooltip": "Template ID (dynamic templates start with 'd-').",
                        "label": "Template Id",
                        "index": 23
                    },
                    "categories": {
                        "type": "text",
                        "tooltip": "Categories for analytics and grouping.",
                        "label": "Categories",
                        "index": 24
                    },
                    "customArgs": {
                        "type": "text",
                        "tooltip": "Custom key-value pairs for tracking.",
                        "label": "Custom Args",
                        "index": 25
                    },
                    "sendAt": {
                        "type": "number",
                        "tooltip": "UNIX timestamp for scheduled sending (<= 72 hours).",
                        "label": "Send At",
                        "index": 26
                    },
                    "batchId": {
                        "type": "text",
                        "tooltip": "Batch identifier for bulk emails.",
                        "label": "Batch Id",
                        "index": 27
                    },
                    "sandboxModeEnable": {
                        "type": "toggle",
                        "tooltip": "If true, email is not actually sent.",
                        "label": "Sandbox Mode Enable",
                        "index": 28
                    },
                    "clickTrackingEnable": {
                        "type": "toggle",
                        "tooltip": "Enable click tracking.",
                        "label": "Click Tracking Enable",
                        "index": 29
                    },
                    "clickTrackingEnableText": {
                        "type": "toggle",
                        "tooltip": "Enable click tracking for text.",
                        "label": "Click Tracking Enable Text",
                        "index": 30
                    },
                    "openTrackingEnable": {
                        "type": "toggle",
                        "tooltip": "Enable open tracking.",
                        "label": "Open Tracking Enable",
                        "index": 31
                    },
                    "openTrackingSubstitutionTag": {
                        "type": "text",
                        "tooltip": "Substitution tag for open tracking.",
                        "label": "Open Tracking Substitution Tag",
                        "index": 32
                    },
                    "subscriptionTrackingEnable": {
                        "type": "toggle",
                        "tooltip": "Enable subscription tracking.",
                        "label": "Subscription Tracking Enable",
                        "index": 33
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "data:image/png;base64,"
}
