{
    "name": "appmixer.sendgrid.core.GetContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific contact by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contact_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "contact_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "contact_id": {
                        "type": "text",
                        "label": "Contact ID",
                        "index": 0,
                        "tooltip": "The unique identifier of the contact."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "last_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Custom Fields",
                    "value": "custom_fields",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "List IDs",
                    "value": "list_ids",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}