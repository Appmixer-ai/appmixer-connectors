{
    "name": "appmixer.sendgrid.core.CreateorUpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create or update a contact in Marketing Campaigns. Returns a job_id indicating an async import operation. You can optionally add the contact to lists and set custom fields.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:sendgrid"
    },
    "quota": {
        "manager": "appmixer:sendgrid",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "address_line_1": {
                        "type": "string"
                    },
                    "address_line_2": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state_province_region": {
                        "type": "string"
                    },
                    "postal_code": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "custom_fields": {
                        "type": "object",
                        "additionalProperties": true
                    },
                    "list_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "tooltip": "Contact email address.",
                        "label": "Email",
                        "index": 1
                    },
                    "first_name": {
                        "type": "text",
                        "tooltip": "First name.",
                        "label": "First Name",
                        "index": 2
                    },
                    "last_name": {
                        "type": "text",
                        "tooltip": "Last name.",
                        "label": "Last Name",
                        "index": 3
                    },
                    "address_line_1": {
                        "type": "text",
                        "tooltip": "Address line 1.",
                        "label": "Address Line 1",
                        "index": 4
                    },
                    "address_line_2": {
                        "type": "text",
                        "tooltip": "Address line 2.",
                        "label": "Address Line 2",
                        "index": 5
                    },
                    "city": {
                        "type": "text",
                        "tooltip": "City.",
                        "label": "City",
                        "index": 6
                    },
                    "state_province_region": {
                        "type": "text",
                        "tooltip": "State/Province/Region.",
                        "label": "State Province Region",
                        "index": 7
                    },
                    "postal_code": {
                        "type": "text",
                        "tooltip": "Postal/ZIP code.",
                        "label": "Postal Code",
                        "index": 8
                    },
                    "country": {
                        "type": "text",
                        "tooltip": "Country.",
                        "label": "Country",
                        "index": 9
                    },
                    "list_ids": {
                        "type": "text",
                        "tooltip": "IDs of lists to add the contact to (comma-separated).",
                        "label": "List IDs",
                        "index": 10
                    },
                    "custom_fields": {
                        "type": "text",
                        "tooltip": "Custom field values as JSON object, keyed by custom field ID.",
                        "label": "Custom Fields",
                        "index": 11
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Job ID",
                    "value": "job_id",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}