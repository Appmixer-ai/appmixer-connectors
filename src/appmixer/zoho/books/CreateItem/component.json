{
    "name": "appmixer.zoho.books.CreateItem",
    "label": "Create Item",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a product or service item in Zoho Books that invoice, estimate and sales order line items can refer to.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:zoho:books",
        "scope": [
            "ZohoBooks.settings.CREATE"
        ]
    },
    "quota": {
        "manager": "appmixer:zoho:books",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organizationId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "rate": {
                        "type": "number"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "sku": {
                        "type": "string"
                    },
                    "productType": {
                        "type": "string"
                    },
                    "itemType": {
                        "type": "string"
                    },
                    "taxId": {
                        "type": "string"
                    },
                    "accountId": {
                        "type": "string"
                    },
                    "purchaseRate": {
                        "type": "number"
                    },
                    "purchaseDescription": {
                        "type": "string"
                    },
                    "purchaseAccountId": {
                        "type": "string"
                    },
                    "inventoryAccountId": {
                        "type": "string"
                    },
                    "vendorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "rate"
                ]
            },
            "inspector": {
                "inputs": {
                    "organizationId": {
                        "type": "text",
                        "label": "Organization ID",
                        "index": 0,
                        "tooltip": "Select the organization, or enter its ID. When empty, the default organization of the connected account is used.",
                        "source": {
                            "url": "/component/appmixer/zoho/books/ListOrganizations?outPort=out",
                            "data": {
                                "transform": "./transformers#organizationsToSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 1,
                        "tooltip": "Name of the item."
                    },
                    "rate": {
                        "type": "number",
                        "label": "Rate",
                        "index": 2,
                        "tooltip": "Selling price of the item."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "Sales description of the item."
                    },
                    "sku": {
                        "type": "text",
                        "label": "SKU",
                        "index": 4,
                        "tooltip": "Stock keeping unit. Must be unique across your items."
                    },
                    "productType": {
                        "type": "select",
                        "label": "Product Type",
                        "index": 5,
                        "tooltip": "Whether the item is goods or a service.",
                        "options": [
                            {
                                "label": "Goods",
                                "value": "goods"
                            },
                            {
                                "label": "Service",
                                "value": "service"
                            },
                            {
                                "label": "Digital Service",
                                "value": "digital_service"
                            }
                        ]
                    },
                    "itemType": {
                        "type": "select",
                        "label": "Item Type",
                        "index": 6,
                        "tooltip": "Where the item is used. Defaults to Sales. Purchases, Sales and Purchases and Inventory need a Purchase Account ID.",
                        "options": [
                            {
                                "label": "Sales",
                                "value": "sales"
                            },
                            {
                                "label": "Purchases",
                                "value": "purchases"
                            },
                            {
                                "label": "Sales and Purchases",
                                "value": "sales_and_purchases"
                            },
                            {
                                "label": "Inventory",
                                "value": "inventory"
                            }
                        ]
                    },
                    "taxId": {
                        "type": "text",
                        "label": "Tax ID",
                        "index": 7,
                        "tooltip": "ID of the tax applied to the item."
                    },
                    "accountId": {
                        "type": "text",
                        "label": "Sales Account ID",
                        "index": 8,
                        "tooltip": "ID of the income account the item's sales are posted to."
                    },
                    "purchaseRate": {
                        "type": "number",
                        "label": "Purchase Rate",
                        "index": 9,
                        "tooltip": "Purchase price of the item."
                    },
                    "purchaseDescription": {
                        "type": "textarea",
                        "label": "Purchase Description",
                        "index": 10,
                        "tooltip": "Description used on purchase transactions."
                    },
                    "purchaseAccountId": {
                        "type": "text",
                        "label": "Purchase Account ID",
                        "index": 11,
                        "tooltip": "ID of the expense (COGS) account the item's purchases are posted to."
                    },
                    "inventoryAccountId": {
                        "type": "text",
                        "label": "Inventory Account ID",
                        "index": 12,
                        "tooltip": "ID of the stock account. Required for the Inventory item type."
                    },
                    "vendorId": {
                        "type": "text",
                        "label": "Preferred Vendor ID",
                        "index": 13,
                        "tooltip": "ID of the preferred vendor of the item."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "item_id": {
                        "type": "string",
                        "title": "Item ID",
                        "example": "460000000017088"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Hard Drive"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "active"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "500GB, USB 2.0"
                    },
                    "rate": {
                        "type": "number",
                        "title": "Rate",
                        "example": 120
                    },
                    "unit": {
                        "type": "string",
                        "title": "Unit",
                        "example": "pcs"
                    },
                    "sku": {
                        "type": "string",
                        "title": "SKU",
                        "example": "HD-500-USB"
                    },
                    "product_type": {
                        "type": "string",
                        "title": "Product Type",
                        "example": "goods"
                    },
                    "item_type": {
                        "type": "string",
                        "title": "Item Type",
                        "example": "sales"
                    },
                    "tax_id": {
                        "type": "string",
                        "title": "Tax ID",
                        "example": "460000000027005"
                    },
                    "tax_name": {
                        "type": "string",
                        "title": "Tax Name",
                        "example": "VAT"
                    },
                    "tax_percentage": {
                        "type": "number",
                        "title": "Tax Percentage",
                        "example": 12.5
                    },
                    "account_id": {
                        "type": "string",
                        "title": "Sales Account ID",
                        "example": "460000000000388"
                    },
                    "account_name": {
                        "type": "string",
                        "title": "Sales Account Name",
                        "example": "Sales"
                    },
                    "purchase_rate": {
                        "type": "number",
                        "title": "Purchase Rate",
                        "example": 80
                    },
                    "purchase_account_id": {
                        "type": "string",
                        "title": "Purchase Account ID",
                        "example": "460000000000507"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
