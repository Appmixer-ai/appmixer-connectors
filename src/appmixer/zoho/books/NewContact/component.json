{
    "name": "appmixer.zoho.books.NewContact",
    "label": "New Contact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when a new contact (customer or vendor) is created in Zoho Books.",
    "version": "1.0.0",
    "tick": true,
    "trigger": true,
    "auth": {
        "service": "appmixer:zoho:books",
        "scope": [
            "ZohoBooks.contacts.READ"
        ]
    },
    "quota": {
        "manager": "appmixer:zoho:books",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "organizationId": {
                    "type": "string"
                },
                "contactType": {
                    "type": "string"
                }
            },
            "required": [
                "organizationId"
            ]
        },
        "inspector": {
            "inputs": {
                "organizationId": {
                    "type": "text",
                    "label": "Organization ID",
                    "index": 0,
                    "tooltip": "Select the organization to watch for new contacts, or enter its ID.",
                    "source": {
                        "url": "/component/appmixer/zoho/books/ListOrganizations?outPort=out",
                        "data": {
                            "transform": "./transformers#organizationsToSelectArray"
                        }
                    }
                },
                "contactType": {
                    "type": "select",
                    "label": "Contact Type",
                    "index": 1,
                    "tooltip": "Optionally only trigger for customers or for vendors.",
                    "options": [
                        {
                            "clearItem": true,
                            "content": "-- Clear selection --"
                        },
                        {
                            "label": "Customer",
                            "value": "customer"
                        },
                        {
                            "label": "Vendor",
                            "value": "vendor"
                        }
                    ]
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "contact_id": {
                        "type": "string",
                        "title": "Contact ID",
                        "example": "460000000026049"
                    },
                    "contact_name": {
                        "type": "string",
                        "title": "Contact Name",
                        "example": "Bowman Furniture"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name",
                        "example": "Bowman Furniture"
                    },
                    "contact_type": {
                        "type": "string",
                        "title": "Contact Type",
                        "example": "customer"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "active"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Benjamin"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "George"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "benjamin.george@bowmanfurniture.com"
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "+1-925-921-9201"
                    },
                    "mobile": {
                        "type": "string",
                        "title": "Mobile",
                        "example": "+1-4054439562"
                    },
                    "currency_id": {
                        "type": "string",
                        "title": "Currency ID",
                        "example": "460000000000097"
                    },
                    "currency_code": {
                        "type": "string",
                        "title": "Currency Code",
                        "example": "USD"
                    },
                    "payment_terms": {
                        "type": "number",
                        "title": "Payment Terms",
                        "example": 15
                    },
                    "payment_terms_label": {
                        "type": "string",
                        "title": "Payment Terms Label",
                        "example": "Net 15"
                    },
                    "outstanding_receivable_amount": {
                        "type": "number",
                        "title": "Outstanding Receivable Amount",
                        "example": 250
                    },
                    "created_time": {
                        "type": "string",
                        "title": "Created Time",
                        "example": "2026-11-13T10:30:00+0000"
                    },
                    "last_modified_time": {
                        "type": "string",
                        "title": "Last Modified Time",
                        "example": "2026-11-13T10:30:00+0000"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
