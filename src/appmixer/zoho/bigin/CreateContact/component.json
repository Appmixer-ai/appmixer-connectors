{
    "name": "appmixer.zoho.bigin.CreateContact",
    "label": "Create Contact",
    "description": "Create a contact in Bigin.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:zoho:bigin"
    },
    "quota": {
        "manager": "appmixer:zoho:bigin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "mobile": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "mailingStreet": {
                        "type": "string"
                    },
                    "mailingCity": {
                        "type": "string"
                    },
                    "mailingState": {
                        "type": "string"
                    },
                    "mailingZip": {
                        "type": "string"
                    },
                    "mailingCountry": {
                        "type": "string"
                    }
                },
                "required": [
                    "lastName"
                ]
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "index": 1,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 2,
                        "label": "Last Name"
                    },
                    "email": {
                        "type": "text",
                        "index": 3,
                        "label": "Email"
                    },
                    "phone": {
                        "type": "text",
                        "index": 4,
                        "label": "Phone"
                    },
                    "mobile": {
                        "type": "text",
                        "index": 5,
                        "label": "Mobile"
                    },
                    "title": {
                        "type": "text",
                        "index": 6,
                        "label": "Title",
                        "tooltip": "Job title of the contact."
                    },
                    "companyId": {
                        "type": "text",
                        "index": 7,
                        "label": "Company ID",
                        "tooltip": "ID of the company (Accounts module) the contact belongs to."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 8,
                        "label": "Description"
                    },
                    "mailingStreet": {
                        "type": "text",
                        "index": 9,
                        "label": "Mailing Street"
                    },
                    "mailingCity": {
                        "type": "text",
                        "index": 10,
                        "label": "Mailing City"
                    },
                    "mailingState": {
                        "type": "text",
                        "index": 11,
                        "label": "Mailing State"
                    },
                    "mailingZip": {
                        "type": "text",
                        "index": 12,
                        "label": "Mailing Zip"
                    },
                    "mailingCountry": {
                        "type": "text",
                        "index": 13,
                        "label": "Mailing Country"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Record ID",
                        "example": "2034020000000644029"
                    },
                    "Created_Time": {
                        "type": "string",
                        "title": "Created Time",
                        "example": "2026-06-27T13:14:19+05:30"
                    },
                    "Modified_Time": {
                        "type": "string",
                        "title": "Modified Time",
                        "example": "2026-06-27T13:14:19+05:30"
                    },
                    "Created_By": {
                        "type": "object",
                        "title": "Created By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Created By.ID",
                                "example": "2034020000000457001"
                            },
                            "name": {
                                "type": "string",
                                "title": "Created By.Name",
                                "example": "Zylker Travels"
                            }
                        }
                    },
                    "Modified_By": {
                        "type": "object",
                        "title": "Modified By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Modified By.ID",
                                "example": "2034020000000457001"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By.Name",
                                "example": "Zylker Travels"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
