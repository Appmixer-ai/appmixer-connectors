{
    "name": "appmixer.zoho.bigin.FindRecords",
    "label": "Find Records",
    "description": "Search the records of a Bigin module by criteria, email, phone or word. Fill in one of them; the first one filled in is used. Returns at most 2000 records.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:zoho:bigin"
    },
    "quota": {
        "manager": "appmixer:zoho:bigin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "generateOutputPortOptions": {
                    "type": "boolean"
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "module": {
                        "type": "string",
                        "enum": [
                            "Contacts",
                            "Pipelines",
                            "Accounts",
                            "Products",
                            "Tasks",
                            "Events",
                            "Calls"
                        ]
                    },
                    "criteria": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "word": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": [
                    "module"
                ]
            },
            "inspector": {
                "inputs": {
                    "module": {
                        "type": "select",
                        "index": 1,
                        "label": "Module",
                        "defaultValue": "Contacts",
                        "tooltip": "The Bigin module. Companies are <code>Accounts</code> and pipeline records (deals) are <code>Pipelines</code> in the API.",
                        "options": [
                            {
                                "label": "Contacts",
                                "value": "Contacts"
                            },
                            {
                                "label": "Pipelines",
                                "value": "Pipelines"
                            },
                            {
                                "label": "Companies",
                                "value": "Accounts"
                            },
                            {
                                "label": "Products",
                                "value": "Products"
                            },
                            {
                                "label": "Tasks",
                                "value": "Tasks"
                            },
                            {
                                "label": "Events",
                                "value": "Events"
                            },
                            {
                                "label": "Calls",
                                "value": "Calls"
                            }
                        ]
                    },
                    "criteria": {
                        "type": "text",
                        "index": 2,
                        "label": "Criteria",
                        "tooltip": "Search criteria in the form <code>(({field_api_name}:{comparator}:{value})and(...))</code>, for example <code>((Last_Name:equals:Brooks)and(Mailing_City:starts_with:San))</code>. Comparators: equals, not_equal, starts_with, in, and for numbers and dates also greater_than, greater_equal, less_than, less_equal, between."
                    },
                    "email": {
                        "type": "text",
                        "index": 3,
                        "label": "Email",
                        "tooltip": "Search all email fields of the module."
                    },
                    "phone": {
                        "type": "text",
                        "index": 4,
                        "label": "Phone",
                        "tooltip": "Search all phone fields of the module."
                    },
                    "word": {
                        "type": "text",
                        "index": 5,
                        "label": "Word",
                        "tooltip": "Search the records for a word."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 6,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/zoho/bigin/FindRecords?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/module": "inputs/in/module",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
