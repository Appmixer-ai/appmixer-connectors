{
    "name": "appmixer.zoho.bigin.CreatePipelineRecord",
    "label": "Create Pipeline Record",
    "description": "Create a pipeline record (deal) in Bigin.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:zoho:bigin"
    },
    "quota": {
        "manager": "appmixer:zoho:bigin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "dealName": {
                        "type": "string"
                    },
                    "subPipeline": {
                        "type": "string"
                    },
                    "stage": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "closingDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "dealName",
                    "subPipeline",
                    "stage"
                ]
            },
            "inspector": {
                "inputs": {
                    "dealName": {
                        "type": "text",
                        "index": 1,
                        "label": "Pipeline Record Name"
                    },
                    "subPipeline": {
                        "type": "text",
                        "index": 2,
                        "label": "Sub-Pipeline",
                        "tooltip": "The sub-pipeline, for example <code>Sales Pipeline Standard</code>. Pick one or type its name.",
                        "source": {
                            "url": "/component/appmixer/zoho/bigin/ListFields?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/module": "Pipelines",
                                    "in/outputType": "array"
                                },
                                "transform": "./ListFields#toSubPipelineOptions"
                            }
                        }
                    },
                    "stage": {
                        "type": "text",
                        "index": 3,
                        "label": "Stage",
                        "tooltip": "A stage of the sub-pipeline, for example <code>Qualification</code>. Pick one or type its name.",
                        "source": {
                            "url": "/component/appmixer/zoho/bigin/ListFields?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/module": "Pipelines",
                                    "in/outputType": "array"
                                },
                                "transform": "./ListFields#toStageOptions"
                            }
                        }
                    },
                    "amount": {
                        "type": "number",
                        "index": 4,
                        "label": "Amount"
                    },
                    "closingDate": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Closing Date",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "companyId": {
                        "type": "text",
                        "index": 6,
                        "label": "Company ID",
                        "tooltip": "ID of the company (Accounts module)."
                    },
                    "contactId": {
                        "type": "text",
                        "index": 7,
                        "label": "Contact ID",
                        "tooltip": "ID of the primary contact."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 8,
                        "label": "Description"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Record ID",
                        "example": "2034020000000644029"
                    },
                    "Created_Time": {
                        "type": "string",
                        "title": "Created Time",
                        "example": "2026-06-27T13:14:19+05:30"
                    },
                    "Modified_Time": {
                        "type": "string",
                        "title": "Modified Time",
                        "example": "2026-06-27T13:14:19+05:30"
                    },
                    "Created_By": {
                        "type": "object",
                        "title": "Created By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Created By.ID",
                                "example": "2034020000000457001"
                            },
                            "name": {
                                "type": "string",
                                "title": "Created By.Name",
                                "example": "Zylker Travels"
                            }
                        }
                    },
                    "Modified_By": {
                        "type": "object",
                        "title": "Modified By",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Modified By.ID",
                                "example": "2034020000000457001"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By.Name",
                                "example": "Zylker Travels"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
