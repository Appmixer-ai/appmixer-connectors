{
    "name": "appmixer.zoho.bigin.NewRecordPolling",
    "label": "New Record (Polling)",
    "description": "Fires when a record is created in the selected Bigin module. Checks for new records periodically; use New Record for instant notifications.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:zoho:bigin"
    },
    "quota": {
        "manager": "appmixer:zoho:bigin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "module": {
                    "type": "string",
                    "enum": [
                        "Contacts",
                        "Pipelines",
                        "Accounts",
                        "Products",
                        "Tasks",
                        "Events",
                        "Calls"
                    ]
                }
            },
            "required": [
                "module"
            ]
        },
        "inspector": {
            "inputs": {
                "module": {
                    "type": "select",
                    "index": 1,
                    "label": "Module",
                    "defaultValue": "Contacts",
                    "tooltip": "The Bigin module. Companies are <code>Accounts</code> and pipeline records (deals) are <code>Pipelines</code> in the API.",
                    "options": [
                        {
                            "label": "Contacts",
                            "value": "Contacts"
                        },
                        {
                            "label": "Pipelines",
                            "value": "Pipelines"
                        },
                        {
                            "label": "Companies",
                            "value": "Accounts"
                        },
                        {
                            "label": "Products",
                            "value": "Products"
                        },
                        {
                            "label": "Tasks",
                            "value": "Tasks"
                        },
                        {
                            "label": "Events",
                            "value": "Events"
                        },
                        {
                            "label": "Calls",
                            "value": "Calls"
                        }
                    ]
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/zoho/bigin/GetRecord?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/module": "properties/module",
                        "in/recordId": "0"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
