{
    "name": "appmixer.zoho.bigin.ListRecords",
    "label": "List Records",
    "description": "List the records of a Bigin module. Returns at most 2000 records (the most the Bigin records API pages through).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:zoho:bigin"
    },
    "quota": {
        "manager": "appmixer:zoho:bigin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "generateOutputPortOptions": {
                    "type": "boolean"
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "module": {
                        "type": "string",
                        "enum": [
                            "Contacts",
                            "Pipelines",
                            "Accounts",
                            "Products",
                            "Tasks",
                            "Events",
                            "Calls"
                        ]
                    },
                    "fields": {
                        "type": "string"
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ]
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": [
                    "module"
                ]
            },
            "inspector": {
                "inputs": {
                    "module": {
                        "type": "select",
                        "index": 1,
                        "label": "Module",
                        "defaultValue": "Contacts",
                        "tooltip": "The Bigin module. Companies are <code>Accounts</code> and pipeline records (deals) are <code>Pipelines</code> in the API.",
                        "options": [
                            {
                                "label": "Contacts",
                                "value": "Contacts"
                            },
                            {
                                "label": "Pipelines",
                                "value": "Pipelines"
                            },
                            {
                                "label": "Companies",
                                "value": "Accounts"
                            },
                            {
                                "label": "Products",
                                "value": "Products"
                            },
                            {
                                "label": "Tasks",
                                "value": "Tasks"
                            },
                            {
                                "label": "Events",
                                "value": "Events"
                            },
                            {
                                "label": "Calls",
                                "value": "Calls"
                            }
                        ]
                    },
                    "fields": {
                        "type": "text",
                        "index": 2,
                        "label": "Fields",
                        "tooltip": "Comma separated field API names to return, for example <code>Last_Name,Email</code> (at most 50). Leave empty to return the fields of the module (the first 50 from its field metadata)."
                    },
                    "sortBy": {
                        "type": "text",
                        "index": 3,
                        "label": "Sort By",
                        "tooltip": "The field API name to sort by, for example <code>Created_Time</code>. Pick a field or type its API name.",
                        "source": {
                            "url": "/component/appmixer/zoho/bigin/ListFields?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/module": "inputs/in/module",
                                    "in/outputType": "array"
                                },
                                "transform": "./ListFields#toSelectArray"
                            }
                        }
                    },
                    "sortOrder": {
                        "type": "select",
                        "index": 4,
                        "label": "Sort Order",
                        "defaultValue": "desc",
                        "tooltip": "Used with Sort By.",
                        "options": [
                            {
                                "label": "Descending",
                                "value": "desc"
                            },
                            {
                                "label": "Ascending",
                                "value": "asc"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 5,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/zoho/bigin/ListRecords?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/module": "inputs/in/module",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
