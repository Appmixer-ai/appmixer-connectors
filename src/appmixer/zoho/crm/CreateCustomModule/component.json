{
    "name": "appmixer.zoho.crm.CreateCustomModule",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a custom module in Zoho CRM. Custom modules allow you to extend Zoho CRM with your own data structures tailored to your business needs. Note: Custom module creation is available only in paid Zoho CRM subscriptions.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:zoho",
        "scope": [
            "ZohoCRM.modules.ALL",
            "ZohoCRM.settings.modules.ALL"
        ]
    },
    "quota": {
        "manager": "appmixer:zoho",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "moduleName": {
                        "type": "string"
                    },
                    "singularLabel": {
                        "type": "string"
                    },
                    "pluralLabel": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "enableRecordDuplicateCheck": {
                        "type": "boolean"
                    },
                    "enableApprovalWorkflow": {
                        "type": "boolean"
                    },
                    "enableWebForm": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "moduleName",
                    "singularLabel",
                    "pluralLabel"
                ]
            },
            "inspector": {
                "inputs": {
                    "moduleName": {
                        "type": "text",
                        "tooltip": "The name of the custom module to create. Must be unique within the organization. Alphanumeric characters and underscores only.",
                        "label": "Module Name",
                        "index": 0
                    },
                    "singularLabel": {
                        "type": "text",
                        "tooltip": "The singular display name for the module (e.g., 'Product', 'Service'). Used in the UI.",
                        "label": "Singular Label",
                        "index": 1
                    },
                    "pluralLabel": {
                        "type": "text",
                        "tooltip": "The plural display name for the module (e.g., 'Products', 'Services'). Used in the UI.",
                        "label": "Plural Label",
                        "index": 2
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "A detailed description of the custom module's purpose and usage.",
                        "label": "Description",
                        "index": 3
                    },
                    "enableRecordDuplicateCheck": {
                        "type": "toggle",
                        "tooltip": "Enable duplicate record detection for this module.",
                        "label": "Enable Record Duplicate Check",
                        "index": 4
                    },
                    "enableApprovalWorkflow": {
                        "type": "toggle",
                        "tooltip": "Enable approval workflows for records in this module.",
                        "label": "Enable Approval Workflow",
                        "index": 5
                    },
                    "enableWebForm": {
                        "type": "toggle",
                        "tooltip": "Allow web forms to be created for this module.",
                        "label": "Enable Web Form",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Module ID",
                    "value": "moduleId",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                {
                    "label": "Module API Name",
                    "value": "apiName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Singular Label",
                    "value": "singularLabel",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Plural Label",
                    "value": "pluralLabel",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                {
                    "label": "Created Time",
                    "value": "createdTime",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}