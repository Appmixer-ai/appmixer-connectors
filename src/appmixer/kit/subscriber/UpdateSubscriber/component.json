{
    "name": "appmixer.kit.subscriber.UpdateSubscriber",
    "label": "Update Subscriber",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new subscriber or update an existing one based on a unique email (upsert behavior).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:kit"
    },
    "quota": {
        "manager": "appmixer:kit",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "object"
                    }
                },
                "required": ["subscriberId"]
            },
            "inspector": {
                "inputs": {
                    "subscriberId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the subscriber.",
                        "label": "Subscriber ID",
                        "index": 0,
                        "source": {
                            "url": "/component/appmixer/kit/subscriber/FindSubscribers?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSubscribers#toSelectArray"
                            }
                        }
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "Subscriber's email address.",
                        "label": "Email",
                        "index": 1
                    },
                    "firstName": {
                        "type": "text",
                        "tooltip": "Subscriber's first name.",
                        "label": "First Name",
                        "index": 2
                    },
                    "customFields": {
                        "type": "key-value",
                        "tooltip": "Optional key/value pairs for custom subscriber information.",
                        "label": "Custom Fields",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "data:image/png;base64,"
}
