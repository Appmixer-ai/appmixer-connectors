{
    "name": "appmixer.kit.tag.RemoveTagFromSubscriber",
    "label": "Remove Tag from Subscriber",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Removes a tag from a specified subscriber.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:kit"
    },
    "quota": {
        "manager": "appmixer:kit",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "tagId": {
                        "type": "string"
                    },
                    "subscriberId": {
                        "type": "string"
                    }
                },
                "required": ["tagId", "subscriberId"]
            },
            "inspector": {
                "inputs": {
                    "tagId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the tag.",
                        "label": "Tag ID",
                        "index": 0,
                        "source": {
                            "url": "/component/appmixer/kit/tag/ListTags?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListTags#toSelectArray"
                            }
                        }
                    },
                    "subscriberId": {
                        "type": "text",
                        "tooltip": "Unique identifier of the subscriber.",
                        "label": "Subscriber ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/kit/subscriber/FindSubscribers?outPort=out",
                            "data": {
                                "message": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSubscribers#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "data:image/png;base64,"
}
