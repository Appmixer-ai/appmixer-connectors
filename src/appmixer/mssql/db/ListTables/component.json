{
    "name": "appmixer.mssql.db.ListTables",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "List all non-system tables in your mssql database.",
    "private": true,
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:mssql"
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "tables",
            "options": [
                { "label": "Tables", "value": "tables", "schema": { "type": "array", "example": [{ "table_name": "users" }, { "table_name": "orders" }] } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
