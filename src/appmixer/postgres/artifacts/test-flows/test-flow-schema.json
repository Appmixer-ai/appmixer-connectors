{
    "name": "E2E PostgreSQL - Schema Inspection",
    "description": "End-to-end test for PostgreSQL connector - tests schema inspection components: ListTables and ListColumns. Creates a test table, verifies it appears in ListTables, verifies columns appear in ListColumns, then cleans up.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 144,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "create-table": {
            "type": "appmixer.postgres.db.Query",
            "x": 256,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "CREATE TABLE IF NOT EXISTS appmixer_e2e_schema_test (id SERIAL PRIMARY KEY, label TEXT, value NUMERIC)",
                                    "outputType": "rows"
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-tables": {
            "type": "appmixer.postgres.db.ListTables",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-table": ["out", "emptyResult"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-table": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {},
                                "lambda": {}
                            },
                            "emptyResult": {
                                "type": "json2new",
                                "modifiers": {},
                                "lambda": {}
                            }
                        }
                    }
                }
            }
        },
        "assert-list-tables": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-tables": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-tables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "tables": {
                                            "variable": "$.list-tables.out.tables",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{tables}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-columns": {
            "type": "appmixer.postgres.db.ListColumns",
            "x": 448,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-table": ["out", "emptyResult"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-table": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_schema_test"
                                }
                            },
                            "emptyResult": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_schema_test"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-columns": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-columns": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-columns": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "columns": {
                                            "variable": "$.list-columns.out.columns",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{columns}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-list-tables": ["out"],
                    "assert-list-columns": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "drop-table": {
            "type": "appmixer.postgres.db.Query",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "DROP TABLE IF EXISTS appmixer_e2e_schema_test",
                                    "outputType": "rows"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1408,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "drop-table": ["out", "emptyResult"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "drop-table": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E PostgreSQL - Schema Inspection",
                                    "result": "{{{result-var}}}"
                                }
                            },
                            "emptyResult": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E PostgreSQL - Schema Inspection",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
