{
    "name": "E2E PostgreSQL - CRUD Lifecycle",
    "description": "End-to-end test for PostgreSQL connector - tests full CRUD lifecycle: creates a test table via Query, inserts a row via CreateRow, reads it back via Query, updates it via UpdateRow, deletes it via DeleteRow, then drops the table. Asserts each step.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 144,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "create-table": {
            "type": "appmixer.postgres.db.Query",
            "x": 256,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "CREATE TABLE IF NOT EXISTS appmixer_e2e_test (id SERIAL PRIMARY KEY, name TEXT NOT NULL, score INTEGER DEFAULT 0)",
                                    "outputType": "rows"
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-row": {
            "type": "appmixer.postgres.db.CreateRow",
            "x": 448,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-table": ["out", "emptyResult"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-table": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {},
                                    "data": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_test",
                                    "data": "{\"name\": \"E2E Test Row\", \"score\": 42}"
                                }
                            },
                            "emptyResult": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {},
                                    "data": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_test",
                                    "data": "{\"name\": \"E2E Test Row\", \"score\": 42}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-row": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-row": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "row-id": {
                                            "variable": "$.create-row.out.id",
                                            "functions": []
                                        },
                                        "row-name": {
                                            "variable": "$.create-row.out.name",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{row-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{row-name}}}",
                                                "assertion": "equal",
                                                "expected": "E2E Test Row"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "query-rows": {
            "type": "appmixer.postgres.db.Query",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-row": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-row": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "SELECT * FROM appmixer_e2e_test WHERE name = 'E2E Test Row'",
                                    "outputType": "rows"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-query": {
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "query-rows": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "query-rows": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "first-score": {
                                            "variable": "$.query-rows.out.rows[0].score",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{first-score}}}",
                                                "assertion": "equal",
                                                "expected": "42"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-row": {
            "type": "appmixer.postgres.db.UpdateRow",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "query-rows": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "query-rows": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {},
                                    "filters": {},
                                    "data": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_test",
                                    "filters": "{\"AND\": [{\"column\": \"name\", \"operator\": \"=\", \"value\": \"E2E Test Row\"}]}",
                                    "data": "{\"score\": 99}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-row": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-row": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "updated-score": {
                                            "variable": "$.update-row.out.score",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{updated-score}}}",
                                                "assertion": "equal",
                                                "expected": "99"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "delete-row": {
            "type": "appmixer.postgres.db.DeleteRow",
            "x": 1192,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-row": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-row": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "tableName": {},
                                    "filters": {}
                                },
                                "lambda": {
                                    "tableName": "appmixer_e2e_test",
                                    "filters": "{\"AND\": [{\"column\": \"name\", \"operator\": \"=\", \"value\": \"E2E Test Row\"}]}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-delete": {
            "type": "appmixer.utils.test.Assert",
            "x": 1384,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-row": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "delete-row": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "deleted-count": {
                                            "variable": "$.delete-row.out.rowCount",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{deleted-count}}}",
                                                "assertion": "equal",
                                                "expected": "1"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1576,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": ["out"],
                    "assert-query": ["out"],
                    "assert-update": ["out"],
                    "assert-delete": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "drop-table": {
            "type": "appmixer.postgres.db.Query",
            "x": 1768,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "DROP TABLE IF EXISTS appmixer_e2e_test",
                                    "outputType": "rows"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1960,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "drop-table": ["out", "emptyResult"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "drop-table": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E PostgreSQL - CRUD Lifecycle",
                                    "result": "{{{result-var}}}"
                                }
                            },
                            "emptyResult": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E PostgreSQL - CRUD Lifecycle",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
