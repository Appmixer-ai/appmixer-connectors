                "data": [
                    {
                        "id": "1",
                        "attributes": {
                            "name": "My Store",
                            "domain": "mystore.example.com"
                        }
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "No additional input parameters are required for this endpoint.",
                "properties": {}
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
        {
            "title": "Find Products",
            "description": "Retrieves a paginated list of product objects ordered by name. You can filter products by providing a store_id.",
            "type": "action",
            "documentation": "https://docs.lemonsqueezy.com/api/products",
            "endpointUrl": "/products",
            "apiBaseUrl": "https://api.lemonsqueezy.com/v1/",
