                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
        {
            "title": "Find Customers",
            "description": "Retrieves a paginated list of customer objects. Use the query parameter to search for customers based on name or email.",
            "type": "action",
            "documentation": "https://docs.lemonsqueezy.com/api/customers",
            "endpointUrl": "/customers",
            "apiBaseUrl": "https://api.lemonsqueezy.com/v1/",
            "method": "GET",
            "sampleResponse": {
                "data": [
                    {
                        "id": "501",
                        "attributes": {
                            "email": "customer@example.com",
                            "name": "John Doe"
                        }
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional search parameter to filter customers.",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Search term to filter customers by name or email."
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
        {
            "title": "Find Orders",
            "description": "Retrieves a paginated list of order objects. Filter orders by store ID, customer ID, or customer email.",
            "type": "action",
            "documentation": "https://docs.lemonsqueezy.com/api/orders",
            "endpointUrl": "/orders",
            "apiBaseUrl": "https://api.lemonsqueezy.com/v1/",
            "method": "GET",
            "sampleResponse": {
                "data": [
                    {
                        "id": "9001",
                        "attributes": {
                            "status": "completed",
                            "total": "49.99"
                        }
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional filters to narrow down order results.",
                "properties": {
                    "store_id": {
                        "type": "string",
                        "description": "ID of the store to filter orders."
                    },
                    "customer_id": {
                        "type": "string",
                        "description": "ID of the customer associated with the order."
                    },
                    "user_email": {
                        "type": "string",
                        "description": "Email of the customer for order filtering."
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
        {
            "title": "Find Subscriptions",
            "description": "Retrieves a paginated list of subscription objects. Use various filter parameters to refine subscription search, such as store ID, customer ID, order ID, product ID, variant ID, or subscription status.",
            "type": "action",
            "documentation": "https://docs.lemonsqueezy.com/api/subscriptions",
            "endpointUrl": "/subscriptions",
            "apiBaseUrl": "https://api.lemonsqueezy.com/v1/",
            "method": "GET",
            "sampleResponse": {
                "data": [
                    {
                        "id": "3001",
                        "attributes": {
                            "status": "active",
                            "billing_interval": "monthly"
                        }
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional filters to search subscriptions.",
                "properties": {
                    "store_id": {
                        "type": "string",
                        "description": "ID of the store associated with the subscription."
                    },
                    "customer_id": {
                        "type": "string",
                        "description": "ID of the customer who owns the subscription."
                    },
                    "order_id": {
                        "type": "string",
                        "description": "ID of the order that created the subscription."
                    },
                    "product_id": {
                        "type": "string",
                        "description": "ID of the product for the subscription."
                    },
                    "variant_id": {
                        "type": "string",
                        "description": "ID of the product variant for the subscription."
                    },
                    "status": {
                        "type": "string",
                        "description": "Status of the subscription (e.g., active, cancelled)."
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
