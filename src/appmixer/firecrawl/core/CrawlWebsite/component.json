{
    "name": "appmixer.firecrawl.core.CrawlWebsite",
    "label": "Crawl Website",
    "description": "Start an asynchronous crawl of a website and scrape every discovered page into markdown. By default the component waits for the crawl to finish and returns the scraped pages; turn off waiting to only get the job ID and fetch results later with Get Crawl Status.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:firecrawl"
    },
    "quota": {
        "manager": "appmixer:firecrawl",
        "resources": "jobs",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": { "type": "string" },
                    "maxPages": { "type": "number" },
                    "maxDiscoveryDepth": { "type": "number" },
                    "includePaths": { "type": "string" },
                    "excludePaths": { "type": "string" },
                    "crawlEntireDomain": { "type": "boolean" },
                    "allowSubdomains": { "type": "boolean" },
                    "onlyMainContent": { "type": "boolean" },
                    "wait": { "type": "boolean" },
                    "pollingTimeout": { "type": "number" }
                },
                "required": ["url"]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 0,
                        "label": "URL",
                        "tooltip": "The base URL to start crawling from, e.g. <code>https://example.com/docs</code>."
                    },
                    "maxPages": {
                        "type": "number",
                        "index": 1,
                        "label": "Max Pages",
                        "defaultValue": 100,
                        "tooltip": "Maximum number of pages to crawl. Defaults to 100. Each crawled page consumes Firecrawl credits."
                    },
                    "maxDiscoveryDepth": {
                        "type": "number",
                        "index": 2,
                        "label": "Max Discovery Depth",
                        "tooltip": "Maximum depth to follow links from the base URL. Leave empty for no depth limit."
                    },
                    "includePaths": {
                        "type": "text",
                        "index": 3,
                        "label": "Include Paths",
                        "tooltip": "Optional comma separated list of URL path regex patterns to include, e.g. <code>blog/.*, docs/.*</code>. Only matching URLs are crawled."
                    },
                    "excludePaths": {
                        "type": "text",
                        "index": 4,
                        "label": "Exclude Paths",
                        "tooltip": "Optional comma separated list of URL path regex patterns to exclude from the crawl."
                    },
                    "crawlEntireDomain": {
                        "type": "toggle",
                        "index": 5,
                        "label": "Crawl Entire Domain",
                        "defaultValue": false,
                        "tooltip": "Also follow links to sibling and parent pages of the base URL, not only its children."
                    },
                    "allowSubdomains": {
                        "type": "toggle",
                        "index": 6,
                        "label": "Allow Subdomains",
                        "defaultValue": false,
                        "tooltip": "Also follow links to subdomains of the website."
                    },
                    "onlyMainContent": {
                        "type": "toggle",
                        "index": 7,
                        "label": "Only Main Content",
                        "defaultValue": true,
                        "tooltip": "Scrape only the main content of each page, excluding headers, navigation and footers."
                    },
                    "wait": {
                        "type": "toggle",
                        "index": 8,
                        "label": "Wait For Completion",
                        "defaultValue": true,
                        "tooltip": "Wait for the crawl to finish and return the scraped pages. When off, the component returns the job ID immediately; use Get Crawl Status to fetch the result later."
                    },
                    "pollingTimeout": {
                        "type": "number",
                        "index": 9,
                        "label": "Polling Timeout (seconds)",
                        "defaultValue": 1800,
                        "tooltip": "How long to wait for the crawl to finish before giving up. Defaults to 1800 seconds (30 minutes). Only applies when waiting for completion."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "3f8c2a1e-5b7d-4e0a-9c6f-2d1b8e4a7c9d"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "completed"
                    },
                    "total": {
                        "type": "number",
                        "title": "Total Pages",
                        "example": 42
                    },
                    "completed": {
                        "type": "number",
                        "title": "Completed Pages",
                        "example": 42
                    },
                    "creditsUsed": {
                        "type": "number",
                        "title": "Credits Used",
                        "example": 42
                    },
                    "data": {
                        "type": "array",
                        "title": "Pages",
                        "example": [
                            {
                                "markdown": "# Getting Started\n\nWelcome to the documentation.",
                                "metadata": {
                                    "title": "Getting Started",
                                    "sourceURL": "https://example.com/docs/getting-started",
                                    "statusCode": 200
                                }
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "markdown": {
                                    "type": "string",
                                    "title": "Markdown",
                                    "example": "# Getting Started\n\nWelcome to the documentation."
                                },
                                "metadata": {
                                    "type": "object",
                                    "title": "Metadata",
                                    "properties": {
                                        "title": {
                                            "type": "string",
                                            "title": "Page Title",
                                            "example": "Getting Started"
                                        },
                                        "sourceURL": {
                                            "type": "string",
                                            "title": "Source URL",
                                            "example": "https://example.com/docs/getting-started"
                                        },
                                        "statusCode": {
                                            "type": "number",
                                            "title": "Status Code",
                                            "example": 200
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
