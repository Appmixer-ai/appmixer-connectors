{
    "name": "appmixer.greenhouse.core.RejectApplication",
    "label": "Reject Application",
    "description": "Reject an application with a rejection reason and optional notes.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "applicationId": {
                        "type": "string"
                    },
                    "rejectionReasonId": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "required": [
                    "applicationId",
                    "rejectionReasonId"
                ]
            },
            "inspector": {
                "inputs": {
                    "applicationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Application ID",
                        "tooltip": "The ID of the application. Use Find Applications to look it up."
                    },
                    "rejectionReasonId": {
                        "type": "text",
                        "index": 2,
                        "label": "Rejection Reason",
                        "tooltip": "Pick a rejection reason, or type its ID.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/ListRejectionReasons?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListRejectionReasons#toSelectArray"
                            }
                        }
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Notes",
                        "tooltip": "Notes about the rejection, visible to the hiring team."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
