{
    "name": "appmixer.greenhouse.core.CreateCandidate",
    "label": "Create Candidate",
    "description": "Create a candidate. When you pick a job, the candidate is created with an application on that job, in its first interview stage. Without a job the candidate is created as a prospect.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "preferredName": {
                        "type": "string"
                    },
                    "company": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "emailType": {
                        "type": "string",
                        "enum": [
                            "personal",
                            "work",
                            "other"
                        ]
                    },
                    "phone": {
                        "type": "string"
                    },
                    "phoneType": {
                        "type": "string",
                        "enum": [
                            "mobile",
                            "home",
                            "work",
                            "skype",
                            "other"
                        ]
                    },
                    "tags": {
                        "type": "string"
                    },
                    "jobId": {
                        "type": "string"
                    }
                },
                "required": [
                    "firstName",
                    "lastName"
                ]
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "index": 1,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 2,
                        "label": "Last Name"
                    },
                    "preferredName": {
                        "type": "text",
                        "index": 3,
                        "label": "Preferred Name",
                        "tooltip": "The name the candidate goes by, when different from the first name."
                    },
                    "company": {
                        "type": "text",
                        "index": 4,
                        "label": "Company",
                        "tooltip": "The candidate's current company."
                    },
                    "title": {
                        "type": "text",
                        "index": 5,
                        "label": "Title",
                        "tooltip": "The candidate's current job title."
                    },
                    "email": {
                        "type": "text",
                        "index": 6,
                        "label": "Email"
                    },
                    "emailType": {
                        "type": "select",
                        "index": 7,
                        "label": "Email Type",
                        "defaultValue": "personal",
                        "options": [
                            {
                                "label": "Personal",
                                "value": "personal"
                            },
                            {
                                "label": "Work",
                                "value": "work"
                            },
                            {
                                "label": "Other",
                                "value": "other"
                            }
                        ]
                    },
                    "phone": {
                        "type": "text",
                        "index": 8,
                        "label": "Phone"
                    },
                    "phoneType": {
                        "type": "select",
                        "index": 9,
                        "label": "Phone Type",
                        "defaultValue": "mobile",
                        "options": [
                            {
                                "label": "Mobile",
                                "value": "mobile"
                            },
                            {
                                "label": "Home",
                                "value": "home"
                            },
                            {
                                "label": "Work",
                                "value": "work"
                            },
                            {
                                "label": "Skype",
                                "value": "skype"
                            },
                            {
                                "label": "Other",
                                "value": "other"
                            }
                        ]
                    },
                    "tags": {
                        "type": "text",
                        "index": 10,
                        "label": "Tags",
                        "tooltip": "Comma-separated tag names, for example <code>referral, backend</code>. Tags that do not exist yet are created."
                    },
                    "jobId": {
                        "type": "text",
                        "index": 11,
                        "label": "Job",
                        "tooltip": "Pick a job, or type the Job ID, to create the candidate with an application on it. Leave empty to create a prospect.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/FindJobs?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindJobs#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Candidate ID",
                        "example": 41352870003
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jane"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "preferred_name": {
                        "type": "string",
                        "title": "Preferred Name",
                        "example": "Janie"
                    },
                    "company": {
                        "type": "string",
                        "title": "Company",
                        "example": "Acme Inc."
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Senior Backend Engineer"
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": false
                    },
                    "can_email": {
                        "type": "boolean",
                        "title": "Can Email",
                        "example": true
                    },
                    "time_zone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Eastern Time (US & Canada)"
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "referral",
                            "backend"
                        ]
                    },
                    "linked_user_ids": {
                        "type": "array",
                        "title": "Linked User IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            4080539003
                        ]
                    },
                    "email_addresses": {
                        "type": "array",
                        "title": "Email Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "jane.doe@example.com"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "personal"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "jane.doe@example.com",
                                "type": "personal"
                            }
                        ]
                    },
                    "phone_numbers": {
                        "type": "array",
                        "title": "Phone Numbers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "+1 555 0100"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "mobile"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "+1 555 0100",
                                "type": "mobile"
                            }
                        ]
                    },
                    "addresses": {
                        "type": "array",
                        "title": "Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "455 Broadway, New York, NY"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "home"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "455 Broadway, New York, NY",
                                "type": "home"
                            }
                        ]
                    },
                    "website_addresses": {
                        "type": "array",
                        "title": "Website Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "https://janedoe.dev"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "personal"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "https://janedoe.dev",
                                "type": "personal"
                            }
                        ]
                    },
                    "social_media_addresses": {
                        "type": "array",
                        "title": "Social Media Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "linkedin.com/in/janedoe"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "linkedin.com/in/janedoe"
                            }
                        ]
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "example": {
                            "desired_salary": {
                                "name": "Desired Salary",
                                "type": "short_text",
                                "value": "120000"
                            }
                        }
                    },
                    "last_activity_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Activity At",
                        "example": "2026-11-10T14:22:05.000Z"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-02T09:15:30.000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-10T14:22:05.000Z"
                    },
                    "applicationId": {
                        "type": "integer",
                        "title": "Application ID",
                        "example": 57193664003
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
