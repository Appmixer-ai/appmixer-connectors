{
    "name": "appmixer.greenhouse.core.NewCandidate",
    "label": "New Candidate",
    "description": "Triggers when a candidate is added in Greenhouse: applicants, prospects and candidates added by your team. Checks for new candidates every minute.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Candidate ID",
                        "example": 41352870003
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jane"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "preferred_name": {
                        "type": "string",
                        "title": "Preferred Name",
                        "example": "Janie"
                    },
                    "company": {
                        "type": "string",
                        "title": "Company",
                        "example": "Acme Inc."
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Senior Backend Engineer"
                    },
                    "private": {
                        "type": "boolean",
                        "title": "Private",
                        "example": false
                    },
                    "can_email": {
                        "type": "boolean",
                        "title": "Can Email",
                        "example": true
                    },
                    "time_zone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Eastern Time (US & Canada)"
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "referral",
                            "backend"
                        ]
                    },
                    "linked_user_ids": {
                        "type": "array",
                        "title": "Linked User IDs",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            4080539003
                        ]
                    },
                    "email_addresses": {
                        "type": "array",
                        "title": "Email Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "jane.doe@example.com"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "personal"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "jane.doe@example.com",
                                "type": "personal"
                            }
                        ]
                    },
                    "phone_numbers": {
                        "type": "array",
                        "title": "Phone Numbers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "+1 555 0100"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "mobile"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "+1 555 0100",
                                "type": "mobile"
                            }
                        ]
                    },
                    "addresses": {
                        "type": "array",
                        "title": "Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "455 Broadway, New York, NY"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "home"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "455 Broadway, New York, NY",
                                "type": "home"
                            }
                        ]
                    },
                    "website_addresses": {
                        "type": "array",
                        "title": "Website Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "https://janedoe.dev"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "personal"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "https://janedoe.dev",
                                "type": "personal"
                            }
                        ]
                    },
                    "social_media_addresses": {
                        "type": "array",
                        "title": "Social Media Addresses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "linkedin.com/in/janedoe"
                                }
                            }
                        },
                        "example": [
                            {
                                "value": "linkedin.com/in/janedoe"
                            }
                        ]
                    },
                    "custom_fields": {
                        "type": "object",
                        "title": "Custom Fields",
                        "example": {
                            "desired_salary": {
                                "name": "Desired Salary",
                                "type": "short_text",
                                "value": "120000"
                            }
                        }
                    },
                    "last_activity_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Activity At",
                        "example": "2026-11-10T14:22:05.000Z"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-02T09:15:30.000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-10T14:22:05.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
