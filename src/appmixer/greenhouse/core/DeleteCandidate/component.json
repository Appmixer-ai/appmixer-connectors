{
    "name": "appmixer.greenhouse.core.DeleteCandidate",
    "label": "Delete Candidate",
    "description": "Permanently delete a candidate with all of their applications, attachments, scorecards and notes. This cannot be undone.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "candidateId": {
                        "type": "string"
                    }
                },
                "required": [
                    "candidateId"
                ]
            },
            "inspector": {
                "inputs": {
                    "candidateId": {
                        "type": "text",
                        "index": 1,
                        "label": "Candidate ID",
                        "tooltip": "The ID of the candidate to delete. Use Find Candidates to look it up."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
