{
    "name": "appmixer.greenhouse.core.MoveApplication",
    "label": "Move Application",
    "description": "Move an application to another interview stage. Leave Stage and Transfer To Job empty to advance the application to the next stage of its job. Pick a stage to move it within its job, or a job to transfer it to the first stage of that job. Stage transition rules configured in Greenhouse, such as automated emails, run as usual.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "applicationId": {
                        "type": "string"
                    },
                    "jobId": {
                        "type": "string"
                    },
                    "toStageId": {
                        "type": "string"
                    },
                    "toJobId": {
                        "type": "string"
                    },
                    "fromStageId": {
                        "type": "string"
                    }
                },
                "required": [
                    "applicationId"
                ]
            },
            "inspector": {
                "inputs": {
                    "applicationId": {
                        "type": "text",
                        "index": 1,
                        "label": "Application ID",
                        "tooltip": "The ID of the application. Use Find Applications to look it up."
                    },
                    "jobId": {
                        "type": "text",
                        "index": 2,
                        "label": "Job Of The Stage List",
                        "tooltip": "Only used to load the stage list of the Stage field below: pick the job of the application (or the job you transfer it to). It is not sent to Greenhouse.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/FindJobs?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindJobs#toSelectArray"
                            }
                        }
                    },
                    "toStageId": {
                        "type": "text",
                        "index": 3,
                        "label": "Stage",
                        "tooltip": "The interview stage to move the application to. Pick a stage (choose the job above first), or type the Job Interview Stage ID. Leave empty to advance to the next stage.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/ListJobStages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array",
                                    "in/jobId": "inputs/in/jobId"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListJobStages#toSelectArray"
                            }
                        }
                    },
                    "toJobId": {
                        "type": "text",
                        "index": 4,
                        "label": "Transfer To Job",
                        "tooltip": "Transfer the application to another job. It lands on that job's first interview stage, or on Stage when you pick one of the new job's stages.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/FindJobs?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindJobs#toSelectArray"
                            }
                        }
                    },
                    "fromStageId": {
                        "type": "text",
                        "index": 5,
                        "label": "Current Stage ID",
                        "tooltip": "Greenhouse moves the application only when this matches its current stage, a guard against moving it twice. Leave empty to use the application's current job interview stage."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
