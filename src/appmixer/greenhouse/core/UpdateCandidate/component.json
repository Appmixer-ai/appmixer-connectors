{
    "name": "appmixer.greenhouse.core.UpdateCandidate",
    "label": "Update Candidate",
    "description": "Update the profile of a candidate. Only the fields you fill in are changed. A new email, phone or tag list replaces the existing list of the candidate.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "candidateId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "preferredName": {
                        "type": "string"
                    },
                    "company": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "emailType": {
                        "type": "string",
                        "enum": [
                            "personal",
                            "work",
                            "other"
                        ]
                    },
                    "phone": {
                        "type": "string"
                    },
                    "phoneType": {
                        "type": "string",
                        "enum": [
                            "mobile",
                            "home",
                            "work",
                            "skype",
                            "other"
                        ]
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "candidateId"
                ]
            },
            "inspector": {
                "inputs": {
                    "candidateId": {
                        "type": "text",
                        "index": 1,
                        "label": "Candidate ID",
                        "tooltip": "The ID of the candidate. Use Find Candidates to look it up."
                    },
                    "firstName": {
                        "type": "text",
                        "index": 2,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 3,
                        "label": "Last Name"
                    },
                    "preferredName": {
                        "type": "text",
                        "index": 4,
                        "label": "Preferred Name",
                        "tooltip": "The name the candidate goes by, when different from the first name."
                    },
                    "company": {
                        "type": "text",
                        "index": 5,
                        "label": "Company",
                        "tooltip": "The candidate's current company."
                    },
                    "title": {
                        "type": "text",
                        "index": 6,
                        "label": "Title",
                        "tooltip": "The candidate's current job title."
                    },
                    "email": {
                        "type": "text",
                        "index": 7,
                        "label": "Email",
                        "tooltip": "Replaces all email addresses of the candidate with this one."
                    },
                    "emailType": {
                        "type": "select",
                        "index": 8,
                        "label": "Email Type",
                        "options": [
                            {
                                "label": "Personal",
                                "value": "personal"
                            },
                            {
                                "label": "Work",
                                "value": "work"
                            },
                            {
                                "label": "Other",
                                "value": "other"
                            }
                        ]
                    },
                    "phone": {
                        "type": "text",
                        "index": 9,
                        "label": "Phone",
                        "tooltip": "Replaces all phone numbers of the candidate with this one."
                    },
                    "phoneType": {
                        "type": "select",
                        "index": 10,
                        "label": "Phone Type",
                        "options": [
                            {
                                "label": "Mobile",
                                "value": "mobile"
                            },
                            {
                                "label": "Home",
                                "value": "home"
                            },
                            {
                                "label": "Work",
                                "value": "work"
                            },
                            {
                                "label": "Skype",
                                "value": "skype"
                            },
                            {
                                "label": "Other",
                                "value": "other"
                            }
                        ]
                    },
                    "tags": {
                        "type": "text",
                        "index": 11,
                        "label": "Tags",
                        "tooltip": "Comma-separated tag names. Replaces all tags of the candidate. Tags that do not exist yet are created."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
