{
    "name": "appmixer.greenhouse.core.ListJobStages",
    "label": "List Job Stages",
    "description": "List the interview stages of a job, for example Application Review, Phone Interview, Onsite and Offer. Returns up to 500 stages.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:greenhouse"
    },
    "quota": {
        "manager": "appmixer:greenhouse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": [
                    "jobId"
                ]
            },
            "inspector": {
                "inputs": {
                    "jobId": {
                        "type": "text",
                        "index": 1,
                        "label": "Job",
                        "tooltip": "Pick a job, or type the Job ID.",
                        "source": {
                            "url": "/component/appmixer/greenhouse/core/FindJobs?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindJobs#toSelectArray"
                            }
                        }
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/greenhouse/core/ListJobStages?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/jobId": "dummy"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
