{
    "name": "appmixer.openmeteo.core.GetCurrentWeather",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get current weather for a given location using latitude and longitude.",
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "latitude": { "type": "number" },
                    "longitude": { "type": "number" }
                },
                "required": ["latitude", "longitude"]
            },
            "inspector": {
                "inputs": {
                    "latitude": {
                        "type": "number",
                        "label": "Latitude",
                        "tooltip": "Latitude of the location (e.g. 48.8566).",
                        "index": 1
                    },
                    "longitude": {
                        "type": "number",
                        "label": "Longitude",
                        "tooltip": "Longitude of the location (e.g. 2.3522).",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Latitude", "value": "latitude" },
                { "label": "Longitude", "value": "longitude" },
                { "label": "Elevation", "value": "elevation" },
                { "label": "Timezone", "value": "timezone" },
                { "label": "Timezone Abbreviation", "value": "timezone_abbreviation" },
                { "label": "UTC Offset Seconds", "value": "utc_offset_seconds" },
                { "label": "Current Weather", "value": "current_weather" },
                { "label": "Temperature", "value": "current_weather.temperature" },
                { "label": "Wind Speed", "value": "current_weather.windspeed" },
                { "label": "Wind Direction", "value": "current_weather.winddirection" },
                { "label": "Weather Code", "value": "current_weather.weathercode" },
                { "label": "Is Day", "value": "current_weather.is_day" },
                { "label": "Time", "value": "current_weather.time" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2NCA2NCI+PGNpcmNsZSBjeD0iMzIiIGN5PSIzMiIgcj0iMzIiIGZpbGw9IiMyYjZjYjAiLz48dGV4dCB4PSI1MCUiIHk9IjUwJSIgZG9taW5hbnQtYmFzZWxpbmU9Im1pZGRsZSIgdGV4dC1hbmNob3I9Im1pZGRsZSIgZm9udC1zaXplPSIzMCIgZmlsbD0id2hpdGUiPuKYgTwvdGV4dD48L3N2Zz4="
