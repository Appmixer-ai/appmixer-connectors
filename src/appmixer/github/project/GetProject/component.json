{
    "name": "appmixer.github.project.GetProject",
    "label": "Get Project",
    "description": "Retrieve detailed information for a specific GitHub project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "read:project"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests-projects",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string",
                        "description": "The unique identifier of the project"
                    }
                },
                "required": [
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the project.",
                        "label": "Project ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "PVT_abc123"
                    }
                },
                {
                    "label": "Number",
                    "value": "number",
                    "schema": {
                        "type": "number",
                        "example": 5
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string",
                        "example": "Q1 2026 Roadmap"
                    }
                },
                {
                    "label": "Short Description",
                    "value": "shortDescription",
                    "schema": {
                        "type": "string",
                        "example": "Planning and tracking for Q1 deliverables"
                    }
                },
                {
                    "label": "Readme",
                    "value": "readme",
                    "schema": {
                        "type": "string",
                        "example": "# Project README"
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/orgs/acme-corp/projects/5"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string",
                        "example": "2025-12-01T08:00:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:00:00Z"
                    }
                },
                {
                    "label": "Closed At",
                    "value": "closedAt",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00.000Z"
                    }
                },
                {
                    "label": "Public",
                    "value": "public",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Owner",
                    "value": "owner",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "__typename": {
                                "type": "string",
                                "title": "Owner.Typename"
                            },
                            "login": {
                                "type": "string",
                                "title": "Owner.Login"
                            }
                        },
                        "example": {}
                    }
                },
                {
                    "label": "Fields",
                    "value": "fields",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Fields.Id"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Fields.Name"
                                },
                                "dataType": {
                                    "type": "string",
                                    "title": "Fields.Data Type"
                                },
                                "options": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    },
                                    "title": "Fields.Options"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "field-uuid-1234",
                                "name": "Status",
                                "dataType": "SINGLE_SELECT",
                                "options": [
                                    {
                                        "id": "opt-uuid-1234",
                                        "name": "In Progress"
                                    }
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
