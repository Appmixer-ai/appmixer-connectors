{
    "name": "appmixer.github.list.GetUser",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Fetches an user by name.",
    "version": "1.0.1",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Login",
                    "value": "login",
                    "schema": {
                        "type": "string",
                        "example": "jane-developer"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number",
                        "example": 11223344
                    }
                },
                {
                    "label": "Node Id",
                    "value": "node_id",
                    "schema": {
                        "type": "string",
                        "example": "MDQ6VXNlcjExMjIzMzQ0"
                    }
                },
                {
                    "label": "Avatar Url",
                    "value": "avatar_url",
                    "schema": {
                        "type": "string",
                        "example": "https://avatars.githubusercontent.com/u/11223344"
                    }
                },
                {
                    "label": "Gravatar Id",
                    "value": "gravatar_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Html Url",
                    "value": "html_url",
                    "schema": {
                        "type": "string",
                        "example": "https://github.com/jane-developer"
                    }
                },
                {
                    "label": "Followers Url",
                    "value": "followers_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Following Url",
                    "value": "following_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Gists Url",
                    "value": "gists_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Starred Url",
                    "value": "starred_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Subscriptions Url",
                    "value": "subscriptions_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Organizations Url",
                    "value": "organizations_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Repos Url",
                    "value": "repos_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Events Url",
                    "value": "events_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Received Events Url",
                    "value": "received_events_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "User"
                    }
                },
                {
                    "label": "User View Type",
                    "value": "user_view_type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Site Admin",
                    "value": "site_admin",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "null",
                        "example": "Jane Developer"
                    }
                },
                {
                    "label": "Company",
                    "value": "company",
                    "schema": {
                        "type": "null",
                        "example": "Acme Corp"
                    }
                },
                {
                    "label": "Blog",
                    "value": "blog",
                    "schema": {
                        "type": "string",
                        "example": "https://jane.dev"
                    }
                },
                {
                    "label": "Location",
                    "value": "location",
                    "schema": {
                        "type": "null",
                        "example": "Berlin, Germany"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "null",
                        "example": "jane@example.com"
                    }
                },
                {
                    "label": "Hireable",
                    "value": "hireable",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Bio",
                    "value": "bio",
                    "schema": {
                        "type": "null",
                        "example": "Full-stack developer passionate about open source"
                    }
                },
                {
                    "label": "Twitter Username",
                    "value": "twitter_username",
                    "schema": {
                        "type": "null",
                        "example": "janedev"
                    }
                },
                {
                    "label": "Public Repos",
                    "value": "public_repos",
                    "schema": {
                        "type": "number",
                        "example": 28
                    }
                },
                {
                    "label": "Public Gists",
                    "value": "public_gists",
                    "schema": {
                        "type": "number",
                        "example": 12
                    }
                },
                {
                    "label": "Followers",
                    "value": "followers",
                    "schema": {
                        "type": "number",
                        "example": 450
                    }
                },
                {
                    "label": "Following",
                    "value": "following",
                    "schema": {
                        "type": "number",
                        "example": 120
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2019-06-20T08:00:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:00:00Z"
                    }
                },
                {
                    "label": "Private Gists",
                    "value": "private_gists",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Total Private Repos",
                    "value": "total_private_repos",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Owned Private Repos",
                    "value": "owned_private_repos",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Disk Usage",
                    "value": "disk_usage",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Collaborators",
                    "value": "collaborators",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Two Factor Authentication",
                    "value": "two_factor_authentication",
                    "schema": {
                        "type": "boolean"
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "user": {
                    "type": "string"
                }
            },
            "required": [
                "user"
            ]
        },
        "inspector": {
            "inputs": {
                "user": {
                    "type": "text",
                    "group": "config",
                    "label": "User Name (login)",
                    "index": 2,
                    "tooltip": "Enter the name of the user to get."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
