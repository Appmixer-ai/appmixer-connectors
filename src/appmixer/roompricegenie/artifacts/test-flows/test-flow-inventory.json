            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "version": "1.0.0",
            "source": {},
            "config": {},
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "05abdee9-ee55-4035-bfe9-f42d548c5f04": {
