{
    "name": "appmixer.roompricegenie.core.NewRateUpdate",
    "label": "New Rate Update",
    "description": "Triggers when RoomPriceGenie sends new prices for a room type (and rate plan) of the connected property (rates.update). Each calendar item is a date range with either one price or a price per occupancy. RoomPriceGenie pushes all updates of all your properties to one endpoint of this connector (see the setup guide); the flow receives those of the property of the connected account, after RoomPriceGenie's signature on the request has been verified. One push can cover several room types and rate plans: the trigger fires once for each of them, and Index and Count tell which one of how many it is. Only changed values are sent, so an update is a change, not the whole calendar. Do not send these prices back to RoomPriceGenie with Send Rates.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:roompricegenie"
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "event": {
                        "type": "string",
                        "title": "Event",
                        "example": "rates.update"
                    },
                    "tracking_id": {
                        "type": "string",
                        "title": "Tracking ID",
                        "example": "3cc216d5-3a7a-4d3b-acc8-7af2ec0019ae"
                    },
                    "property_code": {
                        "type": "string",
                        "title": "Property Code",
                        "example": "HOTEL123"
                    },
                    "room_type_code": {
                        "type": "string",
                        "title": "Room Type Code",
                        "example": "DBL"
                    },
                    "room_type_name": {
                        "type": "string",
                        "title": "Room Type Name",
                        "example": "Double Room"
                    },
                    "rate_plan_code": {
                        "type": "string",
                        "title": "Rate Plan Code",
                        "example": "BAR"
                    },
                    "rate_plan_name": {
                        "type": "string",
                        "title": "Rate Plan Name",
                        "example": "Best Available Rate"
                    },
                    "calendar": {
                        "type": "array",
                        "title": "Calendar",
                        "items": {
                            "type": "object",
                            "properties": {
                                "start_date": {
                                    "type": "string",
                                    "title": "Start Date",
                                    "example": "2027-01-02"
                                },
                                "end_date": {
                                    "type": "string",
                                    "title": "End Date",
                                    "example": "2027-01-07"
                                },
                                "price": {
                                    "type": "integer",
                                    "title": "Price",
                                    "example": 100
                                },
                                "prices": {
                                    "type": "array",
                                    "title": "Occupancy Prices",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "occupancy": {
                                                "type": "integer",
                                                "title": "Occupancy",
                                                "example": 2
                                            },
                                            "price": {
                                                "type": "integer",
                                                "title": "Price",
                                                "example": 150
                                            }
                                        }
                                    },
                                    "example": [
                                        {
                                            "occupancy": 1,
                                            "price": 120
                                        },
                                        {
                                            "occupancy": 2,
                                            "price": 150
                                        }
                                    ]
                                }
                            },
                            "required": [
                                "start_date",
                                "end_date"
                            ]
                        },
                        "example": [
                            {
                                "start_date": "2027-01-01",
                                "end_date": "2027-01-01",
                                "price": 100
                            },
                            {
                                "start_date": "2027-01-02",
                                "end_date": "2027-01-07",
                                "price": 120
                            }
                        ]
                    },
                    "index": {
                        "type": "integer",
                        "title": "Index",
                        "example": 0
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 2
                    }
                },
                "required": [
                    "event",
                    "tracking_id",
                    "property_code",
                    "room_type_code",
                    "room_type_name",
                    "calendar",
                    "index",
                    "count"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
