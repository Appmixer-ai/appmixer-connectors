{
    "name": "appmixer.roompricegenie.core.SendRestrictions",
    "label": "Send Restrictions",
    "description": "Send the minimum stay restriction of a room type (and rate plan) for a date range of the connected property to RoomPriceGenie (restrictions.update). Send only dates that have a restriction; a value of 0 or 1 means no restriction. Fill in the fields for one room type and one date range, or Restriction Updates (JSON) for several at once. Do not send back restrictions you have just received from RoomPriceGenie.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:roompricegenie"
    },
    "quota": {
        "manager": "appmixer:roompricegenie",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "roomTypeCode": {
                        "type": "string"
                    },
                    "roomTypeName": {
                        "type": "string"
                    },
                    "ratePlanCode": {
                        "type": "string"
                    },
                    "ratePlanName": {
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "minStayArrival": {
                        "type": "integer"
                    },
                    "minStayThrough": {
                        "type": "integer"
                    },
                    "data": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "roomTypeCode": {
                        "type": "text",
                        "index": 1,
                        "label": "Room Type Code",
                        "tooltip": "Your immutable code of the room type, as sent in the inventory (<code>room_type_code</code>), for example <code>DBL</code>."
                    },
                    "roomTypeName": {
                        "type": "text",
                        "index": 2,
                        "label": "Room Type Name",
                        "tooltip": "The name of the room type, for example <code>Double Room</code>."
                    },
                    "ratePlanCode": {
                        "type": "text",
                        "index": 3,
                        "label": "Rate Plan Code",
                        "tooltip": "Your immutable code of the rate plan (<code>rate_plan_code</code>), for example <code>BAR</code>. Fill it in only when your integration uses rate plans; leave it empty otherwise."
                    },
                    "ratePlanName": {
                        "type": "text",
                        "index": 4,
                        "label": "Rate Plan Name",
                        "tooltip": "The name of the rate plan, for example <code>Best Available Rate</code>. Required together with Rate Plan Code."
                    },
                    "startDate": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Start Date",
                        "tooltip": "The first date the restriction applies to (YYYY-MM-DD).",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "endDate": {
                        "type": "date-time",
                        "index": 6,
                        "label": "End Date",
                        "tooltip": "The last date the restriction applies to (YYYY-MM-DD), the same as Start Date or later. The restriction is applied to every date in the range. RoomPriceGenie asks for date ranges instead of one message per day.",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "minStayArrival": {
                        "type": "number",
                        "index": 7,
                        "label": "Minimum Stay (Arrival)",
                        "tooltip": "Arrival-based minimum stay in nights: applies to guests who arrive on the date. Fill it in when your system supports this kind; 0 or 1 removes the restriction."
                    },
                    "minStayThrough": {
                        "type": "number",
                        "index": 8,
                        "label": "Minimum Stay (Stay-Through)",
                        "tooltip": "Stay-through minimum stay in nights: applies to every stay that includes the date. Fill it in when your system supports this kind; 0 or 1 removes the restriction."
                    },
                    "data": {
                        "type": "textarea",
                        "index": 9,
                        "label": "Restriction Updates (JSON)",
                        "tooltip": "Use this instead of the fields above to send several room types or date ranges in one message. A JSON array in the form RoomPriceGenie documents as <code>data</code>, for example <code>[{\"room_type_code\":\"DBL\",\"room_type_name\":\"Double Room\",\"calendar\":[{\"start_date\":\"2027-01-02\",\"end_date\":\"2027-01-05\",\"min_stay_arrival\":2}]}]</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "event": {
                        "type": "string",
                        "title": "Event",
                        "example": "restrictions.update"
                    },
                    "tracking_id": {
                        "type": "string",
                        "title": "Tracking ID",
                        "example": "3cc216d5-3a7a-4d3b-acc8-7af2ec0019ae"
                    },
                    "property_code": {
                        "type": "string",
                        "title": "Property Code",
                        "example": "HOTEL123"
                    }
                },
                "required": [
                    "event",
                    "tracking_id",
                    "property_code"
                ]
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
