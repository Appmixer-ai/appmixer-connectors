{
    "name": "appmixer.tldv.core.DownloadRecording",
    "label": "Download Recording",
    "description": "Downloads a tl;dv meeting recording and stores it as a file, returning its file ID. Recordings can be large; the file is streamed rather than buffered.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tldv"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "meetingId": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "meetingId"
                ]
            },
            "inspector": {
                "inputs": {
                    "meetingId": {
                        "type": "text",
                        "index": 1,
                        "label": "Meeting ID",
                        "tooltip": "The unique identifier of the tl;dv meeting whose recording you want to download."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 2,
                        "label": "File Name",
                        "tooltip": "Optional name for the stored file. Defaults to tldv-recording-<meetingId>.mp4."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string", "title": "File ID", "example": "6a7b8c9d0e1f2a3b4c5d6e7f" },
                    "fileName": { "type": "string", "title": "File Name", "example": "tldv-recording-657f1e2b9a1c4d0012ab34cd.mp4" },
                    "meetingId": { "type": "string", "title": "Meeting ID", "example": "657f1e2b9a1c4d0012ab34cd" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
