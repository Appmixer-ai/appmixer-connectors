{
    "name": "appmixer.tldv.core.GetRecordingDownloadUrl",
    "label": "Get Recording Download URL",
    "description": "Returns a temporary signed URL for downloading a tl;dv meeting recording. The URL is valid for about 6 hours — use it promptly or fetch a fresh one.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tldv"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "meetingId": {
                        "type": "string"
                    }
                },
                "required": [
                    "meetingId"
                ]
            },
            "inspector": {
                "inputs": {
                    "meetingId": {
                        "type": "text",
                        "index": 1,
                        "label": "Meeting ID",
                        "tooltip": "The unique identifier of the tl;dv meeting whose recording URL you want."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "downloadUrl": { "type": "string", "title": "Download URL", "example": "https://storage.tldv.io/recordings/657f1e2b9a1c4d0012ab34cd.mp4?signature=..." },
                    "expiresInSeconds": { "type": "integer", "title": "Expires In (seconds)", "example": 21600 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
