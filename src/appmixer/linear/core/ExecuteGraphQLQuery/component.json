{
    "name": "appmixer.linear.core.ExecuteGraphQLQuery",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Performs an arbitrary authorized GraphQL query. Use with caution.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:linear"
    },
    "quota": {
        "manager": "appmixer:linear",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "variables": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "tooltip": "Enter your GraphQL query string (e.g., query GetIssue($id: String!) { issue(id: $id) { id title } }). Define parameters with $ that can be passed in the Variables field below.",
                        "label": "Query",
                        "index": 0
                    },
                    "variables": {
                        "type": "text",
                        "tooltip": "Optional variables for the GraphQL query in JSON format, e.g., { \"issueId\": \"abc123\" }",
                        "label": "Variables",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "object",
                        "properties": {}
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}