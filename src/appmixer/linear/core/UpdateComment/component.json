{
    "name": "appmixer.linear.core.UpdateComment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Updates an existing comment with new content.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:linear"
    },
    "quota": {
        "manager": "appmixer:linear",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "commentId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "commentId": {
                        "type": "text",
                        "tooltip": "The ID of the comment to update",
                        "label": "Comment Id",
                        "index": 0
                    },
                    "body": {
                        "type": "text",
                        "tooltip": "The new content for the comment",
                        "label": "Body",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "updateComment": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "title": "Data.Update Comment.Id"
                                    },
                                    "body": {
                                        "type": "string",
                                        "title": "Data.Update Comment.Body"
                                    }
                                },
                                "title": "Data.Update Comment"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,",
    "genv2": true
}