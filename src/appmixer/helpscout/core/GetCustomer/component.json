{
    "name": "appmixer.helpscout.core.GetCustomer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a single customer by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "number",
                        "tooltip": "Customer ID.",
                        "label": "Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Photo Url",
                    "value": "photoUrl",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Emails",
                    "value": "emails",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "value": {
                                    "type": "string",
                                    "title": "Emails.Value"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Emails.Type"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Address",
                    "value": "address",
                    "schema": {
                        "type": "object",
                        "properties": {}
                    }
                },
                {
                    "label": "Social Profiles",
                    "value": "socialProfiles",
                    "schema": {
                        "type": "object",
                        "properties": {}
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}