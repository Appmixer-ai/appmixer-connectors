{
    "name": "appmixer.helpscout.core.CreateCustomer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new customer profile.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "photoUrl": {
                        "type": "string"
                    },
                    "emails|value": {
                        "type": "string"
                    },
                    "emails|type": {
                        "type": "string"
                    },
                    "background": {
                        "type": "string"
                    }
                },
                "required": ["firstName", "emails|value"]
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "tooltip": "First name.",
                        "label": "First Name",
                        "index": 0
                    },
                    "lastName": {
                        "type": "text",
                        "tooltip": "Last name.",
                        "label": "Last Name",
                        "index": 1
                    },
                    "photoUrl": {
                        "type": "text",
                        "tooltip": "URL to profile photo.",
                        "label": "Photo URL",
                        "index": 2
                    },
                    "emails|value": {
                        "type": "text",
                        "tooltip": "Email address.",
                        "label": "Emails|value",
                        "index": 3
                    },
                    "emails|type": {
                        "type": "text",
                        "tooltip": "Type (work, home, other).",
                        "label": "Emails|type",
                        "index": 4
                    },
                    "background": {
                        "type": "text",
                        "tooltip": "Internal notes/background.",
                        "label": "Background",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Customer ID",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}