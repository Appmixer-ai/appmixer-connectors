{
    "name": "appmixer.helpscout.core.UpdateConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update conversation properties such as status, assignee, tags, and custom fields.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string"
                    },
                    "assignTo|id": {
                        "type": "integer"
                    },
                    "assignTo|type": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "object",
                        "properties": {
                            "AND": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "customFields|id": {
                        "type": "integer"
                    },
                    "customFields|value": {
                        "type": "string"
                    }
                },
                "required": ["id"]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "number",
                        "tooltip": "Conversation ID.",
                        "label": "Conversation ID",
                        "index": 0
                    },
                    "status": {
                        "type": "text",
                        "tooltip": "open, pending, closed, spam.",
                        "label": "Status",
                        "index": 1
                    },
                    "assignTo|id": {
                        "type": "number",
                        "tooltip": "User ID to assign to.",
                        "label": "Assign To|id",
                        "index": 2
                    },
                    "assignTo|type": {
                        "type": "text",
                        "tooltip": "Assignee type (user or team).",
                        "label": "Assign To|type",
                        "index": 3
                    },
                    "tags": {
                        "type": "expression",
                        "tooltip": "Replace tags with provided list.",
                        "label": "Tags",
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "tags_item": {
                                "type": "text",
                                "label": "Tags Item"
                            }
                        },
                        "index": 4
                    },
                    "customFields|id": {
                        "type": "number",
                        "tooltip": "Custom field ID.",
                        "label": "Custom Fields|id",
                        "index": 5
                    },
                    "customFields|value": {
                        "type": "text",
                        "tooltip": "Value for the field.",
                        "label": "Custom Fields|value",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": []
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}