{
    "name": "appmixer.helpscout.core.ManageWebhooks",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create and manage webhooks for real-time events (convo.created, convo.status, customer.created, etc.).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:helpscout"
    },
    "quota": {
        "manager": "appmixer:helpscout",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "events": {
                        "type": "object",
                        "properties": {
                            "AND": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "secret": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "tooltip": "Public HTTPS webhook URL.",
                        "label": "Url",
                        "index": 0
                    },
                    "events": {
                        "type": "expression",
                        "tooltip": "Array of event keys to subscribe to.",
                        "label": "Events",
                        "levels": [
                            "AND"
                        ],
                        "fields": {
                            "events_item": {
                                "type": "text",
                                "label": "Events Item"
                            }
                        },
                        "index": 1
                    },
                    "secret": {
                        "type": "text",
                        "tooltip": "Shared secret used for HMAC-SHA1 signatures.",
                        "label": "Secret",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Webhook ID",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Events",
                    "value": "events",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Shared Secret",
                    "value": "sharedSecret",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}