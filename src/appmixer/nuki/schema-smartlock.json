{
    "type": "object",
    "required": ["smartlockId", "accountId", "type", "authId", "name", "favorite", "serverState", "adminPinState"],
    "properties": {
        "smartlockId": { "type": "integer", "title": "Smartlock ID", "example": 21913877581 },
        "accountId": { "type": "integer", "title": "Account ID", "example": 504567890 },
        "type": { "type": "integer", "title": "Device Type", "example": 4 },
        "name": { "type": "string", "title": "Name", "example": "Apartment 12 Front Door" },
        "favorite": { "type": "boolean", "title": "Favorite", "example": false },
        "authId": { "type": "integer", "title": "Device Authorization ID", "example": 7 },
        "serverState": { "type": "integer", "title": "Server State", "example": 0 },
        "adminPinState": { "type": "integer", "title": "Admin PIN State", "example": 0 },
        "firmwareVersion": { "type": "integer", "title": "Firmware Version", "example": 197635 },
        "hardwareVersion": { "type": "integer", "title": "Hardware Version", "example": 1284 },
        "virtualDevice": { "type": "boolean", "title": "Virtual Device", "example": false },
        "region": { "type": "integer", "title": "Region", "example": 0 },
        "operationId": { "type": "string", "title": "Operation ID", "example": "68b1422f9c3a4e17a584f1aa" },
        "error": { "type": "string", "title": "Error", "example": "" },
        "creationDate": { "type": "string", "format": "date-time", "title": "Creation Date", "example": "2026-03-02T10:15:42.000Z" },
        "updateDate": { "type": "string", "format": "date-time", "title": "Update Date", "example": "2026-11-20T08:01:13.000Z" },
        "state": {
            "type": "object",
            "title": "State",
            "required": ["mode", "state", "trigger", "lastAction", "batteryCritical", "doorState", "nightMode"],
            "properties": {
                "mode": { "type": "integer", "title": "State.Mode", "example": 2 },
                "state": { "type": "integer", "title": "State.Lock State", "example": 1 },
                "trigger": { "type": "integer", "title": "State.Trigger", "example": 0 },
                "lastAction": { "type": "integer", "title": "State.Last Action", "example": 2 },
                "batteryCritical": { "type": "boolean", "title": "State.Battery Critical", "example": false },
                "batteryCharging": { "type": "boolean", "title": "State.Battery Charging", "example": false },
                "batteryCharge": { "type": "integer", "title": "State.Battery Charge", "example": 84 },
                "keypadBatteryCritical": { "type": "boolean", "title": "State.Keypad Battery Critical", "example": false },
                "doorsensorBatteryCritical": { "type": "boolean", "title": "State.Door Sensor Battery Critical", "example": false },
                "doorState": { "type": "integer", "title": "State.Door State", "example": 2 },
                "nightMode": { "type": "boolean", "title": "State.Night Mode", "example": false },
                "ringToOpenEnd": { "type": "string", "format": "date-time", "title": "State.Ring To Open End", "example": "2026-11-20T08:31:13.000Z" }
            }
        },
        "config": {
            "type": "object",
            "title": "Config",
            "required": ["name", "latitude", "longitude", "timezoneId"],
            "properties": {
                "name": { "type": "string", "title": "Config.Name", "example": "Front Door" },
                "latitude": { "type": "number", "title": "Config.Latitude", "example": 47.0707 },
                "longitude": { "type": "number", "title": "Config.Longitude", "example": 15.4395 },
                "timezoneId": { "type": "integer", "title": "Config.Time Zone ID", "example": 37 },
                "keypadPaired": { "type": "boolean", "title": "Config.Keypad Paired", "example": true },
                "keypad2Paired": { "type": "boolean", "title": "Config.Keypad 2 Paired", "example": false },
                "fobPaired": { "type": "boolean", "title": "Config.Fob Paired", "example": false },
                "wifiEnabled": { "type": "boolean", "title": "Config.Wi-Fi Enabled", "example": true },
                "deviceType": { "type": "integer", "title": "Config.Device Type", "example": 4 },
                "productVariant": { "type": "integer", "title": "Config.Product Variant", "example": 2 }
            }
        },
        "currentSubscription": {
            "type": "object",
            "title": "Current Subscription",
            "required": [],
            "properties": {
                "type": { "type": "string", "title": "Current Subscription.Type", "example": "B2C" },
                "state": { "type": "string", "title": "Current Subscription.State", "example": "ACTIVE" },
                "shsSubscriptionType": { "type": "string", "title": "Current Subscription.Plan", "example": "STANDARD" },
                "creationDate": { "type": "string", "format": "date-time", "title": "Current Subscription.Creation Date", "example": "2026-03-02T10:20:00.000Z" },
                "expirationDate": { "type": "string", "format": "date-time", "title": "Current Subscription.Expiration Date", "example": "2027-03-02T10:20:00.000Z" }
            }
