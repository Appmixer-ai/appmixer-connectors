{
    "name": "appmixer.nuki.core.CreateAccountUser",
    "label": "Create Account User",
    "description": "Create an account user: the person (for example a guest) an app invitation is assigned to. Use the returned Account User ID in Create App Invite. Keypad codes need no account user. Needs the token scope smartlock.auth or account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:nuki"
    },
    "quota": {
        "manager": "appmixer:nuki",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string",
                        "enum": [
                            "en",
                            "de",
                            "es",
                            "fr",
                            "it",
                            "nl",
                            "cs",
                            "sk"
                        ]
                    }
                },
                "required": [
                    "name",
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "The name of the person."
                    },
                    "email": {
                        "type": "text",
                        "index": 2,
                        "label": "Email",
                        "tooltip": "The e-mail address Nuki sends app invitations to."
                    },
                    "language": {
                        "type": "select",
                        "index": 3,
                        "label": "Language",
                        "tooltip": "The language of the e-mails Nuki sends to the person.",
                        "options": [
                            {
                                "label": "English",
                                "value": "en"
                            },
                            {
                                "label": "German",
                                "value": "de"
                            },
                            {
                                "label": "Spanish",
                                "value": "es"
                            },
                            {
                                "label": "French",
                                "value": "fr"
                            },
                            {
                                "label": "Italian",
                                "value": "it"
                            },
                            {
                                "label": "Dutch",
                                "value": "nl"
                            },
                            {
                                "label": "Czech",
                                "value": "cs"
                            },
                            {
                                "label": "Slovak",
                                "value": "sk"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "accountUserId",
                    "accountId",
                    "email",
                    "name",
                    "creationDate",
                    "updateDate"
                ],
                "properties": {
                    "accountUserId": {
                        "type": "integer",
                        "title": "Account User ID",
                        "example": 1284511
                    },
                    "accountId": {
                        "type": "integer",
                        "title": "Account ID",
                        "example": 504567890
                    },
                    "type": {
                        "type": "integer",
                        "title": "Type",
                        "example": 0
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Jane Doe"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "operationId": {
                        "type": "string",
                        "title": "Operation ID",
                        "example": "68b1422f9c3a4e17a584f1aa"
                    },
                    "creationDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Creation Date",
                        "example": "2026-12-01T09:28:00.000Z"
                    },
                    "updateDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Update Date",
                        "example": "2026-12-01T09:28:00.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
