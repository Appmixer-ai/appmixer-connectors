{
    "name": "appmixer.nuki.core.RunSmartlockAction",
    "label": "Run Smartlock Action",
    "description": "Send any action to a Nuki device: unlatch (open the door), Lock 'n' Go, or the Opener actions. Devices sold in the United States do not support unlatch. Nuki accepts the command and carries it out a moment later, so this component reports that the command was sent, not that the device executed it. The output holds the lock and door state the device reported before the command. To react to the result, use the New Log Entry or Smartlock State Changed trigger. The device must be online; an offline device is refused with an error. Needs the token scopes smartlock.readOnly and smartlock.action.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:nuki"
    },
    "quota": {
        "manager": "appmixer:nuki",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "smartlockId": {
                        "type": "string"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "1",
                            "2",
                            "3",
                            "4",
                            "5",
                            "6",
                            "7"
                        ]
                    },
                    "option": {
                        "type": "string",
                        "enum": [
                            "2",
                            "4"
                        ]
                    }
                },
                "required": [
                    "smartlockId",
                    "action"
                ]
            },
            "inspector": {
                "inputs": {
                    "smartlockId": {
                        "type": "text",
                        "index": 1,
                        "label": "Smartlock",
                        "tooltip": "Pick a device, or type its Smartlock ID (the number in the address of the device page in Nuki Web).",
                        "source": {
                            "url": "/component/appmixer/nuki/core/FindSmartlocks?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSmartlocks#toSelectArray"
                            }
                        }
                    },
                    "action": {
                        "type": "select",
                        "index": 2,
                        "label": "Action",
                        "tooltip": "What the device should do. The same number means a different action on an Opener, shown in brackets.",
                        "options": [
                            {
                                "label": "Unlock (Opener: activate Ring to Open)",
                                "value": "1"
                            },
                            {
                                "label": "Lock (Opener: deactivate Ring to Open)",
                                "value": "2"
                            },
                            {
                                "label": "Unlatch (Opener: open the door)",
                                "value": "3"
                            },
                            {
                                "label": "Lock 'n' Go (Smart Lock, Smart Door)",
                                "value": "4"
                            },
                            {
                                "label": "Lock 'n' Go with unlatch (Smart Lock, Smart Door)",
                                "value": "5"
                            },
                            {
                                "label": "Activate continuous mode (Opener only)",
                                "value": "6"
                            },
                            {
                                "label": "Deactivate continuous mode (Opener only)",
                                "value": "7"
                            }
                        ]
                    },
                    "option": {
                        "type": "select",
                        "index": 3,
                        "label": "Option",
                        "tooltip": "An optional modifier of the action. Leave empty for none.",
                        "options": [
                            {
                                "label": "Force",
                                "value": "2"
                            },
                            {
                                "label": "Full lock",
                                "value": "4"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "smartlockId"
                ],
                "properties": {
                    "smartlockId": {
                        "type": "integer",
                        "title": "Smartlock ID",
                        "example": 21913877581
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Apartment 12 Front Door"
                    },
                    "previousLockState": {
                        "type": "integer",
                        "title": "Previous Lock State",
                        "example": 1
                    },
                    "previousDoorState": {
                        "type": "integer",
                        "title": "Previous Door State",
                        "example": 2
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
