{
    "name": "appmixer.nuki.core.CreateKeypadCode",
    "label": "Create Keypad Code",
    "description": "Create a 6-digit code for the Nuki Keypad of a device, optionally valid only between two moments (for example check-in and check-out). Nuki does not e-mail keypad codes, so send the code from the output to the guest yourself. Nuki answers a create request before the device has stored the access and returns no ID, so the component looks the new authorization up in the list of the device: within a few seconds, then once a minute for up to 5 minutes. The \"out\" port fires when Nuki Web lists the authorization and carries its ID, which you need to update or delete it later. It does not prove that the device has stored it. The \"notConfirmed\" port fires when the authorization has not appeared after 5 minutes; check the device before trying again. An offline device is refused with an error before anything is sent. Short-term rental use needs a Nuki Smart Hosting subscription on the device. Needs the token scopes smartlock.readOnly and smartlock.auth.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:nuki"
    },
    "quota": {
        "manager": "appmixer:nuki",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "smartlockId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "code": {
                        "type": "string"
                    },
                    "allowedFromDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "allowedUntilDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "allowedWeekDays": {
                        "type": [
                            "array",
                            "string"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "allowedFromTime": {
                        "type": "string"
                    },
                    "allowedUntilTime": {
                        "type": "string"
                    }
                },
                "required": [
                    "smartlockId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "smartlockId": {
                        "type": "text",
                        "index": 1,
                        "label": "Smartlock",
                        "tooltip": "The device the Keypad is paired with. Pick a device, or type its Smartlock ID.",
                        "source": {
                            "url": "/component/appmixer/nuki/core/FindSmartlocks?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindSmartlocks#toSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The name of the code, at most 32 characters. It appears in the activity log. Use something unique such as the reservation number, so that the code can be found again."
                    },
                    "code": {
                        "type": "text",
                        "index": 3,
                        "label": "Keypad Code",
                        "tooltip": "Exactly 6 digits, using the digits 1-9 only (no 0), not starting with 12, and not used by another code on the same Keypad. Leave empty to have a random code generated; the output contains it."
                    },
                    "allowedFromDate": {
                        "type": "date-time",
                        "index": 4,
                        "label": "Allowed From",
                        "tooltip": "The moment from which the code works, for example the check-in time. Sent to Nuki in UTC. Leave empty for no start limit."
                    },
                    "allowedUntilDate": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Allowed Until",
                        "tooltip": "The moment after which the code stops working, for example the check-out time. Sent to Nuki in UTC. Leave empty for no end limit."
                    },
                    "allowedWeekDays": {
                        "type": "multiselect",
                        "index": 6,
                        "label": "Allowed Weekdays",
                        "tooltip": "The days of the week on which the code works. Leave empty for every day.",
                        "options": [
                            {
                                "label": "Monday",
                                "value": "monday"
                            },
                            {
                                "label": "Tuesday",
                                "value": "tuesday"
                            },
                            {
                                "label": "Wednesday",
                                "value": "wednesday"
                            },
                            {
                                "label": "Thursday",
                                "value": "thursday"
                            },
                            {
                                "label": "Friday",
                                "value": "friday"
                            },
                            {
                                "label": "Saturday",
                                "value": "saturday"
                            },
                            {
                                "label": "Sunday",
                                "value": "sunday"
                            }
                        ]
                    },
                    "allowedFromTime": {
                        "type": "text",
                        "index": 7,
                        "label": "Allowed From Time",
                        "tooltip": "Start of the daily time window as <code>HH:mm</code> (for example <code>09:00</code>) or as minutes from midnight. Leave empty for the whole day. Set it together with Allowed Until Time."
                    },
                    "allowedUntilTime": {
                        "type": "text",
                        "index": 8,
                        "label": "Allowed Until Time",
                        "tooltip": "End of the daily time window as <code>HH:mm</code> (for example <code>17:00</code>) or as minutes from midnight. Leave empty for the whole day."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "smartlockId",
                    "type",
                    "name",
                    "enabled",
                    "remoteAllowed",
                    "lockCount"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Authorization ID",
                        "example": "68b1422f9c3a4e17a584f104"
                    },
                    "smartlockId": {
                        "type": "integer",
                        "title": "Smartlock ID",
                        "example": 21913877581
                    },
                    "type": {
                        "type": "integer",
                        "title": "Type",
                        "example": 13
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Reservation 48213"
                    },
                    "code": {
                        "type": "integer",
                        "title": "Keypad Code",
                        "example": 352961
                    },
                    "accountUserId": {
                        "type": "integer",
                        "title": "Account User ID",
                        "example": 1284511
                    },
                    "authId": {
                        "type": "integer",
                        "title": "Device Authorization ID",
                        "example": 23
                    },
                    "enabled": {
                        "type": "boolean",
                        "title": "Enabled",
                        "example": true
                    },
                    "remoteAllowed": {
                        "type": "boolean",
                        "title": "Remote Allowed",
                        "example": false
                    },
                    "lockCount": {
                        "type": "integer",
                        "title": "Lock Count",
                        "example": 0
                    },
                    "allowedFromDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Allowed From",
                        "example": "2026-12-12T14:00:00.000Z"
                    },
                    "allowedUntilDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Allowed Until",
                        "example": "2026-12-15T10:00:00.000Z"
                    },
                    "allowedWeekDays": {
                        "type": "integer",
                        "title": "Allowed Weekdays Bitmask",
                        "example": 127
                    },
                    "allowedFromTime": {
                        "type": "integer",
                        "title": "Allowed From Time",
                        "example": 0
                    },
                    "allowedUntilTime": {
                        "type": "integer",
                        "title": "Allowed Until Time",
                        "example": 0
                    },
                    "lastActiveDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Active Date",
                        "example": "2026-12-12T15:04:11.000Z"
                    },
                    "creationDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Creation Date",
                        "example": "2026-12-01T09:30:00.000Z"
                    },
                    "updateDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Update Date",
                        "example": "2026-12-01T09:30:05.000Z"
                    },
                    "operationId": {
                        "type": "string",
                        "title": "Operation ID",
                        "example": "68b1422f9c3a4e17a584f1aa"
                    },
                    "error": {
                        "type": "string",
                        "title": "Error",
                        "example": ""
                    }
                }
            }
        },
        {
            "name": "notConfirmed",
            "schema": {
                "type": "object",
                "required": [
                    "smartlockId",
                    "type",
                    "name",
                    "waitedMinutes"
                ],
                "properties": {
                    "smartlockId": {
                        "type": "integer",
                        "title": "Smartlock ID",
                        "example": 21913877581
                    },
                    "type": {
                        "type": "integer",
                        "title": "Type",
                        "example": 13
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Reservation 48213"
                    },
                    "code": {
                        "type": "integer",
                        "title": "Keypad Code",
                        "example": 352961
                    },
                    "accountUserId": {
                        "type": "integer",
                        "title": "Account User ID",
                        "example": 1284511
                    },
                    "waitedMinutes": {
                        "type": "integer",
                        "title": "Waited Minutes",
                        "example": 5
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
