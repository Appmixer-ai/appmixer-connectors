{
    "type": "object",
    "required": [
        "code"
    ],
    "properties": {
        "code": {
            "type": "string",
            "title": "Rate Plan Code",
            "example": "BAR"
        },
        "name": {
            "type": "string",
            "title": "Name",
            "example": "Best Available Rate"
        },
        "description": {
            "type": "string",
            "title": "Description",
            "example": "Flexible rate, breakfast included"
        },
        "start": {
            "type": "string",
            "title": "Sell Start Date",
            "example": "2026-01-01"
        },
        "end": {
            "type": "string",
            "title": "Sell End Date",
            "example": "2027-01-01"
        },
        "category": {
            "type": "string",
            "title": "Category",
            "example": "Consumer"
        },
        "marketCode": {
            "type": "string",
            "title": "Market Code",
            "example": "Leisure"
        },
        "yieldable": {
            "type": "boolean",
            "title": "Yieldable",
            "example": true
        },
        "confidential": {
            "type": "boolean",
            "title": "Confidential",
            "example": false
        },
        "commissionable": {
            "type": "boolean",
            "title": "Commissionable",
            "example": true
        },
        "commission": {
            "type": "object",
            "title": "Commission",
            "properties": {
                "percentage": {
                    "type": "number",
                    "title": "Commission.Percentage",
                    "example": 12.5
                },
                "amount": {
                    "type": "number",
                    "title": "Commission.Amount",
                    "example": 20
                }
            }
        },
        "minimumAdvancedBookingOffset": {
            "type": "integer",
            "title": "Minimum Advance Booking (Days)",
            "example": 0
        },
        "maximumAdvancedBookingOffset": {
            "type": "integer",
            "title": "Maximum Advance Booking (Days)",
            "example": 365
        },
        "minLOS": {
            "type": "integer",
            "title": "Minimum Length of Stay",
            "example": 1
        },
        "maxLOS": {
            "type": "integer",
            "title": "Maximum Length of Stay",
            "example": 14
        },
        "arrivalWeekDays": {
            "type": "array",
            "title": "Arrival Week Days",
            "items": {
                "type": "string"
            },
            "example": [
                "Fri",
                "Sat"
            ]
        },
        "availableWeekDays": {
            "type": "array",
            "title": "Available Week Days",
            "items": {
                "type": "string"
            },
            "example": [
                "Mon",
                "Tue",
                "Wed",
                "Thur",
                "Fri",
                "Sat",
                "Sun"
            ]
        },
        "names": {
            "type": "array",
            "title": "Names",
            "items": {
                "type": "object",
                "properties": {
                    "lang": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Best Available Rate"
                    }
                }
            },
            "example": [
                {
                    "lang": "en",
                    "name": "Best Available Rate"
                }
            ]
        },
        "descriptions": {
            "type": "array",
            "title": "Descriptions",
            "items": {
                "type": "object",
                "properties": {
                    "lang": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Flexible rate, breakfast included"
                    }
                }
            },
            "example": [
                {
                    "lang": "en",
                    "description": "Flexible rate, breakfast included"
                }
            ]
        },
        "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Last Modified At",
            "example": "2026-10-02T08:15:30Z"
        }
    }
}
