{
    "type": "object",
    "required": [
        "date",
        "currencyCode",
        "roomTypeCode",
        "ratePlanCode",
        "status",
        "baseGuestAmount"
    ],
    "properties": {
        "date": {
            "type": "string",
            "title": "Date",
            "example": "2026-12-01"
        },
        "currencyCode": {
            "type": "string",
            "title": "Currency",
            "example": "AUD"
        },
        "roomTypeCode": {
            "type": "string",
            "title": "Room Type Code",
            "example": "DLX"
        },
        "ratePlanCode": {
            "type": "string",
            "title": "Rate Plan Code",
            "example": "BAR"
        },
        "status": {
            "type": "string",
            "title": "Status",
            "example": "Open"
        },
        "minLOS": {
            "type": "integer",
            "title": "Minimum Length of Stay",
            "example": 1
        },
        "maxLOS": {
            "type": "integer",
            "title": "Maximum Length of Stay",
            "example": 14
        },
        "baseGuestAmount": {
            "type": "array",
            "title": "Base Guest Amounts",
            "items": {
                "type": "object",
                "properties": {
                    "ageQualifier": {
                        "type": "string",
                        "title": "Age Qualifier",
                        "example": "Adult"
                    },
                    "guestCount": {
                        "type": "integer",
                        "title": "Guest Count",
                        "example": 2
                    },
                    "amountBeforeTax": {
                        "type": "number",
                        "title": "Amount Before Tax",
                        "example": 180
                    },
                    "amountAfterTax": {
                        "type": "number",
                        "title": "Amount After Tax",
                        "example": 198
                    }
                }
            },
            "example": [
                {
                    "ageQualifier": "Adult",
                    "guestCount": 2,
                    "amountBeforeTax": 180,
                    "amountAfterTax": 198
                }
            ]
        },
        "additionalGuestAmounts": {
            "type": "array",
            "title": "Additional Guest Amounts",
            "items": {
                "type": "object",
                "properties": {
                    "ageQualifier": {
                        "type": "string",
                        "title": "Age Qualifier",
                        "example": "Child"
                    },
                    "amount": {
                        "type": "number",
                        "title": "Amount",
                        "example": 25
                    }
                }
            },
            "example": [
                {
                    "ageQualifier": "Child",
                    "amount": 25
                }
            ]
        },
        "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Last Modified At",
            "example": "2026-10-02T08:15:30Z"
        }
    }
}
