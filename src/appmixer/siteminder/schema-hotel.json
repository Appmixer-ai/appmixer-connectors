{
    "type": "object",
    "required": [
        "code",
        "name",
        "currency",
        "timezone",
        "messageTypes"
    ],
    "properties": {
        "code": {
            "type": "string",
            "title": "Hotel Code",
            "example": "HOTEL-1042"
        },
        "name": {
            "type": "string",
            "title": "Hotel Name",
            "example": "Golden River Hotel"
        },
        "currency": {
            "type": "string",
            "title": "Currency",
            "example": "AUD"
        },
        "timezone": {
            "type": "string",
            "title": "Time Zone",
            "example": "Australia/Sydney"
        },
        "messageTypes": {
            "type": "array",
            "title": "Message Types",
            "items": {
                "type": "string"
            },
            "example": [
                "Reservations",
                "ARI"
            ]
        }
    }
}
