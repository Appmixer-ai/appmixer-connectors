{
    "type": "object",
    "required": [
        "date"
    ],
    "properties": {
        "date": {
            "type": "string",
            "title": "Date",
            "example": "2026-12-01"
        },
        "bookingLimit": {
            "type": "integer",
            "title": "Rooms Available",
            "example": 4
        },
        "roomTypeCode": {
            "type": "string",
            "title": "Room Type Code",
            "example": "DLX"
        },
        "ratePlanCode": {
            "type": "string",
            "title": "Rate Plan Code",
            "example": "BAR"
        },
        "minLOS": {
            "type": "integer",
            "title": "Minimum Length of Stay",
            "example": 2
        },
        "maxLOS": {
            "type": "integer",
            "title": "Maximum Length of Stay",
            "example": 14
        },
        "restriction": {
            "type": "string",
            "title": "Restriction",
            "example": "Arrival"
        },
        "status": {
            "type": "string",
            "title": "Restriction Status",
            "example": "Open"
        },
        "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Last Modified At",
            "example": "2026-10-02T08:15:30Z"
        }
    }
}
