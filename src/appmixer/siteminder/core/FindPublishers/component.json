{
    "name": "appmixer.siteminder.core.FindPublishers",
    "label": "Find Publishers",
    "description": "Find the property publishers (the hotels' PMS, Little Hotelier, SiteMinder Channel Manager) connected to your SiteMinder Exchange application, optionally by a part of the name. SiteMinder returns the whole list in one answer; the API has no paging and no filters.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:siteminder"
    },
    "quota": {
        "manager": "appmixer:siteminder",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name Contains",
                        "tooltip": "Find only publishers whose name or code contains this text (case-insensitive). The API has no filter, so the text is matched within the list SiteMinder returns. Leave empty for all publishers."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 2,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/siteminder/core/FindPublishers?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": []
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
