{
    "name": "appmixer.siteminder.core.GetRoomType",
    "label": "Get Room Type",
    "description": "Get one room type of a hotel by its code: names and descriptions in the languages the publisher sent. Little Hotelier and SiteMinder Channel Manager hotels provide reservations only, no availability or rates.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:siteminder"
    },
    "quota": {
        "manager": "appmixer:siteminder",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "publisherCode": {
                        "type": "string"
                    },
                    "hotelCode": {
                        "type": "string"
                    },
                    "roomTypeCode": {
                        "type": "string"
                    }
                },
                "required": [
                    "publisherCode",
                    "hotelCode",
                    "roomTypeCode"
                ]
            },
            "inspector": {
                "inputs": {
                    "publisherCode": {
                        "type": "text",
                        "index": 1,
                        "label": "Publisher",
                        "tooltip": "The property publisher (the hotel's PMS) the data comes from. Pick one, or type its publisher code.",
                        "source": {
                            "url": "/component/appmixer/siteminder/core/FindPublishers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindPublishers#toSelectArray"
                            }
                        }
                    },
                    "hotelCode": {
                        "type": "text",
                        "index": 2,
                        "label": "Hotel",
                        "tooltip": "Pick a hotel of the publisher, or type its hotel code. The hotel code is the code your application assigned to the property when it was activated in SiteMinder Exchange.",
                        "source": {
                            "url": "/component/appmixer/siteminder/core/FindHotels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/publisherCode": "inputs/in/publisherCode"
                                },
                                "transform": "./FindHotels#toSelectArray"
                            }
                        }
                    },
                    "roomTypeCode": {
                        "type": "text",
                        "index": 3,
                        "label": "Room Type",
                        "tooltip": "Pick a room type of the hotel, or type its room type code.",
                        "source": {
                            "url": "/component/appmixer/siteminder/core/FindRoomTypes?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/publisherCode": "inputs/in/publisherCode",
                                    "in/hotelCode": "inputs/in/hotelCode"
                                },
                                "transform": "./FindRoomTypes#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "code"
                ],
                "properties": {
                    "code": {
                        "type": "string",
                        "title": "Room Type Code",
                        "example": "DLX"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Deluxe Room"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Deluxe room with a view over the harbour"
                    },
                    "names": {
                        "type": "array",
                        "title": "Names",
                        "items": {
                            "type": "object",
                            "properties": {
                                "lang": {
                                    "type": "string",
                                    "title": "Language",
                                    "example": "en"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Deluxe Room"
                                }
                            }
                        },
                        "example": [
                            {
                                "lang": "en",
                                "name": "Deluxe Room"
                            }
                        ]
                    },
                    "descriptions": {
                        "type": "array",
                        "title": "Descriptions",
                        "items": {
                            "type": "object",
                            "properties": {
                                "lang": {
                                    "type": "string",
                                    "title": "Language",
                                    "example": "en"
                                },
                                "description": {
                                    "type": "string",
                                    "title": "Description",
                                    "example": "Deluxe room with a view over the harbour"
                                }
                            }
                        },
                        "example": [
                            {
                                "lang": "en",
                                "description": "Deluxe room with a view over the harbour"
                            }
                        ]
                    },
                    "lastModifiedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Modified At",
                        "example": "2026-10-02T08:15:30Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
