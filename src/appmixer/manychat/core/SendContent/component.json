{
    "name": "appmixer.manychat.core.SendContent",
    "label": "Send Content",
    "description": "Send a text, image, video, audio or file message to a Manychat subscriber on Messenger, Instagram, WhatsApp or Telegram. Outside Meta's 24-hour window Messenger delivers only with a message tag.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string"
                    },
                    "channel": {
                        "type": "string",
                        "enum": [
                            "facebook",
                            "instagram",
                            "whatsapp",
                            "telegram"
                        ]
                    },
                    "contentType": {
                        "type": "string",
                        "enum": [
                            "text",
                            "image",
                            "video",
                            "audio",
                            "file"
                        ]
                    },
                    "text": {
                        "type": "string"
                    },
                    "mediaUrl": {
                        "type": "string"
                    },
                    "messageTag": {
                        "type": "string"
                    }
                },
                "required": [
                    "subscriberId",
                    "contentType"
                ]
            },
            "inspector": {
                "inputs": {
                    "subscriberId": {
                        "type": "text",
                        "index": 1,
                        "label": "Subscriber ID",
                        "tooltip": "The Manychat subscriber (contact) ID. Get it from Find Subscribers, Create Subscriber or a Manychat External Request."
                    },
                    "channel": {
                        "type": "select",
                        "index": 2,
                        "label": "Channel",
                        "defaultValue": "facebook",
                        "options": [
                            {
                                "label": "Messenger",
                                "value": "facebook"
                            },
                            {
                                "label": "Instagram",
                                "value": "instagram"
                            },
                            {
                                "label": "WhatsApp",
                                "value": "whatsapp"
                            },
                            {
                                "label": "Telegram",
                                "value": "telegram"
                            }
                        ]
                    },
                    "contentType": {
                        "type": "select",
                        "index": 3,
                        "label": "Content Type",
                        "defaultValue": "text",
                        "options": [
                            {
                                "label": "Text",
                                "value": "text"
                            },
                            {
                                "label": "Image",
                                "value": "image"
                            },
                            {
                                "label": "Video",
                                "value": "video"
                            },
                            {
                                "label": "Audio",
                                "value": "audio"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    },
                    "text": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Text",
                        "tooltip": "The message text. Required when Content Type is Text."
                    },
                    "mediaUrl": {
                        "type": "text",
                        "index": 5,
                        "label": "Media URL",
                        "tooltip": "Public HTTPS URL of the image, video, audio or file. Required for every content type except Text. Files may be up to 25 MB."
                    },
                    "messageTag": {
                        "type": "select",
                        "index": 6,
                        "label": "Message Tag",
                        "tooltip": "Messenger only: a message tag lets you message a subscriber outside the 24-hour window for the stated purpose. See Meta's message tag policy.",
                        "options": [
                            {
                                "label": "None",
                                "value": ""
                            },
                            {
                                "label": "Account Update",
                                "value": "ACCOUNT_UPDATE"
                            },
                            {
                                "label": "Confirmed Event Update",
                                "value": "CONFIRMED_EVENT_UPDATE"
                            },
                            {
                                "label": "Post Purchase Update",
                                "value": "POST_PURCHASE_UPDATE"
                            },
                            {
                                "label": "Human Agent",
                                "value": "HUMAN_AGENT"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string",
                        "title": "Subscriber ID",
                        "example": "1234567890"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "success"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
