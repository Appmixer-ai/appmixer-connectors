{
    "name": "appmixer.manychat.core.CreateSubscriber",
    "label": "Create Subscriber",
    "description": "Create a Manychat subscriber (contact) from an email address, a phone number or a WhatsApp phone number. At least one of them is required.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "hasOptInEmail": {
                        "type": "boolean"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "hasOptInSms": {
                        "type": "boolean"
                    },
                    "consentPhrase": {
                        "type": "string"
                    },
                    "gender": {
                        "type": "string"
                    },
                    "whatsappPhone": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "firstName": {
                        "type": "text",
                        "index": 1,
                        "label": "First Name"
                    },
                    "lastName": {
                        "type": "text",
                        "index": 2,
                        "label": "Last Name"
                    },
                    "email": {
                        "type": "text",
                        "index": 3,
                        "label": "Email",
                        "tooltip": "Email address. Set Email Opt-in when you have the subscriber's consent."
                    },
                    "hasOptInEmail": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Email Opt-in",
                        "defaultValue": false,
                        "tooltip": "Whether the subscriber agreed to receive emails. Sent only when Email is set."
                    },
                    "phone": {
                        "type": "text",
                        "index": 5,
                        "label": "Phone",
                        "tooltip": "Phone number for SMS in international format, for example <code>+15550100123</code>."
                    },
                    "hasOptInSms": {
                        "type": "toggle",
                        "index": 6,
                        "label": "SMS Opt-in",
                        "defaultValue": false,
                        "tooltip": "Whether the subscriber agreed to receive SMS. Sent only when Phone is set. Requires Consent Phrase."
                    },
                    "consentPhrase": {
                        "type": "text",
                        "index": 7,
                        "label": "Consent Phrase",
                        "tooltip": "The phrase the subscriber agreed to. Manychat requires it when SMS Opt-in is on."
                    },
                    "gender": {
                        "type": "text",
                        "index": 8,
                        "label": "Gender",
                        "tooltip": "For example <code>male</code> or <code>female</code>."
                    },
                    "whatsappPhone": {
                        "type": "text",
                        "index": 9,
                        "label": "WhatsApp Phone",
                        "tooltip": "WhatsApp phone number in international format, for example <code>+15550100123</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Subscriber ID",
                        "example": "1234567890"
                    },
                    "page_id": {
                        "type": "string",
                        "title": "Page ID",
                        "example": "106123456789012"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jane"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Jane Doe"
                    },
                    "gender": {
                        "type": "string",
                        "title": "Gender",
                        "example": "female"
                    },
                    "profile_pic": {
                        "type": "string",
                        "title": "Profile Picture",
                        "example": "https://manychat.com/avatar/1234567890.jpg"
                    },
                    "locale": {
                        "type": "string",
                        "title": "Locale",
                        "example": "en_US"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "English"
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Timezone",
                        "example": "UTC+01"
                    },
                    "live_chat_url": {
                        "type": "string",
                        "title": "Live Chat URL",
                        "example": "https://app.manychat.com/fb106123456789012/chat/1234567890"
                    },
                    "last_input_text": {
                        "type": "string",
                        "title": "Last Input Text",
                        "example": "Hello"
                    },
                    "optin_phone": {
                        "type": "boolean",
                        "title": "SMS Opt-in",
                        "example": false
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "+15550100123"
                    },
                    "optin_email": {
                        "type": "boolean",
                        "title": "Email Opt-in",
                        "example": true
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "subscribed": {
                        "type": "string",
                        "title": "Subscribed",
                        "example": "2026-01-15T10:30:00+00:00"
                    },
                    "last_interaction": {
                        "type": "string",
                        "title": "Last Interaction",
                        "example": "2026-01-16T08:12:00+00:00"
                    },
                    "last_seen": {
                        "type": "string",
                        "title": "Last Seen",
                        "example": "2026-01-16T08:15:00+00:00"
                    },
                    "is_followup_enabled": {
                        "type": "boolean",
                        "title": "Follow-up Enabled",
                        "example": true
                    },
                    "ig_username": {
                        "type": "string",
                        "title": "Instagram Username",
                        "example": "janedoe"
                    },
                    "ig_id": {
                        "type": "integer",
                        "title": "Instagram ID",
                        "example": 6384638
                    },
                    "whatsapp_phone": {
                        "type": "string",
                        "title": "WhatsApp Phone",
                        "example": "+15550100123"
                    },
                    "optin_whatsapp": {
                        "type": "boolean",
                        "title": "WhatsApp Opt-in",
                        "example": false
                    },
                    "custom_fields": {
                        "type": "array",
                        "title": "Custom Fields",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 11234
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Favorite Color"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "text"
                                },
                                "description": {
                                    "type": "string",
                                    "title": "Description",
                                    "example": "Color the subscriber picked"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "blue"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 11234,
                                "name": "Favorite Color",
                                "type": "text",
                                "description": "Color the subscriber picked",
                                "value": "blue"
                            }
                        ]
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 98765
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "VIP"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 98765,
                                "name": "VIP"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
