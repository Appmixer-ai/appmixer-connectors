{
    "name": "appmixer.manychat.core.SetCustomField",
    "label": "Set Custom Field",
    "description": "Set the value of a custom user field for a Manychat subscriber. The value is converted to the field type: a number, true/false, a date (YYYY-MM-DD) or a date and time (ISO 8601).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string"
                    },
                    "fieldId": {
                        "type": "string"
                    },
                    "fieldValue": {
                        "type": "string"
                    }
                },
                "required": [
                    "subscriberId",
                    "fieldId",
                    "fieldValue"
                ]
            },
            "inspector": {
                "inputs": {
                    "subscriberId": {
                        "type": "text",
                        "index": 1,
                        "label": "Subscriber ID",
                        "tooltip": "The Manychat subscriber (contact) ID. Get it from Find Subscribers, Create Subscriber or a Manychat External Request."
                    },
                    "fieldId": {
                        "type": "text",
                        "index": 2,
                        "label": "Custom Field",
                        "source": {
                            "url": "/component/appmixer/manychat/core/ListCustomFields?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListCustomFields#toSelectArray"
                            }
                        },
                        "tooltip": "Pick a custom user field, or enter its numeric Custom Field ID."
                    },
                    "fieldValue": {
                        "type": "text",
                        "index": 3,
                        "label": "Value",
                        "tooltip": "Text, a number (<code>123</code>), <code>true</code>/<code>false</code>, a date (<code>2026-07-18</code>) or a date and time with a timezone (<code>2026-07-02T10:00:00+00:00</code>), matching the field type."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string",
                        "title": "Subscriber ID",
                        "example": "1234567890"
                    },
                    "fieldId": {
                        "type": "string",
                        "title": "Custom Field ID",
                        "example": "11234"
                    },
                    "fieldValue": {
                        "type": "string",
                        "title": "Value",
                        "example": "blue"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
