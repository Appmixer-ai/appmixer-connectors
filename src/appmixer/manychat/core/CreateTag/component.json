{
    "name": "appmixer.manychat.core.CreateTag",
    "label": "Create Tag",
    "description": "Create a tag in the Manychat account. Tag names are unique.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "The tag name. Manychat rejects a name that already exists."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Tag ID",
                        "example": 98765
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "VIP"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
