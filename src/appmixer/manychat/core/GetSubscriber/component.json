{
    "name": "appmixer.manychat.core.GetSubscriber",
    "label": "Get Subscriber",
    "description": "Get a Manychat subscriber with their tags and custom fields by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string"
                    }
                },
                "required": [
                    "subscriberId"
                ]
            },
            "inspector": {
                "inputs": {
                    "subscriberId": {
                        "type": "text",
                        "index": 1,
                        "label": "Subscriber ID",
                        "tooltip": "The Manychat subscriber (contact) ID. Get it from Find Subscribers, Create Subscriber or a Manychat External Request."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Subscriber ID",
                        "example": "1234567890"
                    },
                    "page_id": {
                        "type": "string",
                        "title": "Page ID",
                        "example": "106123456789012"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "Jane"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Jane Doe"
                    },
                    "gender": {
                        "type": "string",
                        "title": "Gender",
                        "example": "female"
                    },
                    "profile_pic": {
                        "type": "string",
                        "title": "Profile Picture",
                        "example": "https://manychat.com/avatar/1234567890.jpg"
                    },
                    "locale": {
                        "type": "string",
                        "title": "Locale",
                        "example": "en_US"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "English"
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Timezone",
                        "example": "UTC+01"
                    },
                    "live_chat_url": {
                        "type": "string",
                        "title": "Live Chat URL",
                        "example": "https://app.manychat.com/fb106123456789012/chat/1234567890"
                    },
                    "last_input_text": {
                        "type": "string",
                        "title": "Last Input Text",
                        "example": "Hello"
                    },
                    "optin_phone": {
                        "type": "boolean",
                        "title": "SMS Opt-in",
                        "example": false
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "+15550100123"
                    },
                    "optin_email": {
                        "type": "boolean",
                        "title": "Email Opt-in",
                        "example": true
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "jane.doe@example.com"
                    },
                    "subscribed": {
                        "type": "string",
                        "title": "Subscribed",
                        "example": "2026-01-15T10:30:00+00:00"
                    },
                    "last_interaction": {
                        "type": "string",
                        "title": "Last Interaction",
                        "example": "2026-01-16T08:12:00+00:00"
                    },
                    "last_seen": {
                        "type": "string",
                        "title": "Last Seen",
                        "example": "2026-01-16T08:15:00+00:00"
                    },
                    "is_followup_enabled": {
                        "type": "boolean",
                        "title": "Follow-up Enabled",
                        "example": true
                    },
                    "ig_username": {
                        "type": "string",
                        "title": "Instagram Username",
                        "example": "janedoe"
                    },
                    "ig_id": {
                        "type": "integer",
                        "title": "Instagram ID",
                        "example": 6384638
                    },
                    "whatsapp_phone": {
                        "type": "string",
                        "title": "WhatsApp Phone",
                        "example": "+15550100123"
                    },
                    "optin_whatsapp": {
                        "type": "boolean",
                        "title": "WhatsApp Opt-in",
                        "example": false
                    },
                    "custom_fields": {
                        "type": "array",
                        "title": "Custom Fields",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 11234
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Favorite Color"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "text"
                                },
                                "description": {
                                    "type": "string",
                                    "title": "Description",
                                    "example": "Color the subscriber picked"
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "blue"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 11234,
                                "name": "Favorite Color",
                                "type": "text",
                                "description": "Color the subscriber picked",
                                "value": "blue"
                            }
                        ]
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 98765
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "VIP"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 98765,
                                "name": "VIP"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
