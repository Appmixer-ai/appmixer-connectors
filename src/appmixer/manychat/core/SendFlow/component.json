{
    "name": "appmixer.manychat.core.SendFlow",
    "label": "Send Flow",
    "description": "Start a Manychat flow (automation) for a subscriber. Meta's 24-hour messaging window applies to Messenger and Instagram. Manychat allows 100 calls per subscriber per hour.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:manychat"
    },
    "quota": {
        "manager": "appmixer:manychat",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string"
                    },
                    "flowNs": {
                        "type": "string"
                    }
                },
                "required": [
                    "subscriberId",
                    "flowNs"
                ]
            },
            "inspector": {
                "inputs": {
                    "subscriberId": {
                        "type": "text",
                        "index": 1,
                        "label": "Subscriber ID",
                        "tooltip": "The Manychat subscriber (contact) ID. Get it from Find Subscribers, Create Subscriber or a Manychat External Request."
                    },
                    "flowNs": {
                        "type": "text",
                        "index": 2,
                        "label": "Flow",
                        "source": {
                            "url": "/component/appmixer/manychat/core/ListFlows?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListFlows#toSelectArray"
                            }
                        },
                        "tooltip": "Pick a flow, or enter its Flow ID (namespace), for example <code>content20260115103000_123456</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriberId": {
                        "type": "string",
                        "title": "Subscriber ID",
                        "example": "1234567890"
                    },
                    "flowNs": {
                        "type": "string",
                        "title": "Flow ID",
                        "example": "content20260115103000_123456"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
