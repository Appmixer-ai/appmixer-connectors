{
    "name": "appmixer.calcom.core.MeetingEnded",
    "label": "Meeting Ended",
    "description": "Triggers when a booked meeting reaches its scheduled end time (event MEETING_ENDED).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:calcom"
    },
    "quota": {
        "manager": "appmixer:calcom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "triggerEvent",
                    "id",
                    "uid",
                    "title",
                    "startTime",
                    "endTime",
                    "eventTypeId",
                    "attendees"
                ],
                "properties": {
                    "triggerEvent": {
                        "type": "string",
                        "title": "Trigger Event",
                        "example": "MEETING_ENDED"
                    },
                    "id": {
                        "type": "integer",
                        "title": "Booking ID",
                        "example": 4567890
                    },
                    "uid": {
                        "type": "string",
                        "title": "Booking UID",
                        "example": "k3b7Xq9ZpR2mN8vT4wYc1a"
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "30 Min Meeting between Jane Doe and John Smith"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Quarterly planning call."
                    },
                    "eventTypeId": {
                        "type": "integer",
                        "title": "Event Type ID",
                        "example": 1234567
                    },
                    "startTime": {
                        "type": "string",
                        "title": "Start Time",
                        "example": "2026-12-01T09:00:00.000Z",
                        "format": "date-time"
                    },
                    "endTime": {
                        "type": "string",
                        "title": "End Time",
                        "example": "2026-12-01T09:30:00.000Z",
                        "format": "date-time"
                    },
                    "location": {
                        "type": "string",
                        "title": "Location",
                        "example": "integrations:daily"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "ACCEPTED"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Booking Created At",
                        "example": "2026-11-16T10:15:00.000Z",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Booking Updated At",
                        "example": "2026-12-01T09:31:00.000Z",
                        "format": "date-time"
                    },
                    "userPrimaryEmail": {
                        "type": "string",
                        "title": "Organizer Email",
                        "example": "jane@example.com"
                    },
                    "user": {
                        "type": "object",
                        "title": "Organizer",
                        "properties": {
                            "name": {
                                "type": "string",
                                "title": "Organizer.Name",
                                "example": "Jane Doe"
                            },
                            "email": {
                                "type": "string",
                                "title": "Organizer.Email",
                                "example": "jane@example.com"
                            },
                            "username": {
                                "type": "string",
                                "title": "Organizer.Username",
                                "example": "jane"
                            },
                            "timeZone": {
                                "type": "string",
                                "title": "Organizer.Time Zone",
                                "example": "Europe/Prague"
                            }
                        }
                    },
                    "attendees": {
                        "type": "array",
                        "title": "Attendees",
                        "example": [
                            {
                                "name": "John Smith",
                                "email": "john@example.com",
                                "timeZone": "America/New_York"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Attendees.Name",
                                    "example": "John Smith"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Attendees.Email",
                                    "example": "john@example.com"
                                },
                                "timeZone": {
                                    "type": "string",
                                    "title": "Attendees.Time Zone",
                                    "example": "America/New_York"
                                }
                            }
                        }
                    },
                    "metadata": {
                        "type": "object",
                        "title": "Metadata",
                        "properties": {
                            "videoCallUrl": {
                                "type": "string",
                                "title": "Metadata.Video Call URL",
                                "example": "https://app.cal.com/video/k3b7Xq9ZpR2mN8vT4wYc1a"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
