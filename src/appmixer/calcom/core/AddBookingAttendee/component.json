{
    "name": "appmixer.calcom.core.AddBookingAttendee",
    "label": "Add Booking Attendee",
    "description": "Add an attendee to an existing booking. Seated bookings are not supported: create a new booking for the same slot instead.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:calcom"
    },
    "quota": {
        "manager": "appmixer:calcom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "bookingUid": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "language": {
                        "type": "string"
                    }
                },
                "required": [
                    "bookingUid",
                    "name",
                    "email",
                    "timeZone"
                ]
            },
            "inspector": {
                "inputs": {
                    "bookingUid": {
                        "type": "text",
                        "index": 1,
                        "label": "Booking UID",
                        "tooltip": "The UID of the booking (not the numeric booking ID). Use Find Bookings to look it up."
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "Full name of the attendee."
                    },
                    "email": {
                        "type": "text",
                        "index": 3,
                        "label": "Email",
                        "tooltip": "Email of the attendee."
                    },
                    "timeZone": {
                        "type": "text",
                        "index": 4,
                        "label": "Time Zone",
                        "tooltip": "IANA time zone of the attendee, for example <code>Europe/London</code>."
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 5,
                        "label": "Phone Number",
                        "tooltip": "Phone number in international format, for example <code>+447700900123</code>."
                    },
                    "language": {
                        "type": "text",
                        "index": 6,
                        "label": "Language",
                        "tooltip": "Preferred language of the attendee, for example <code>en</code>. Defaults to English."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "bookingId",
                    "name",
                    "email",
                    "timeZone"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Attendee ID",
                        "example": 8765432
                    },
                    "bookingId": {
                        "type": "integer",
                        "title": "Booking ID",
                        "example": 4567890
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Alex Brown"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "alex@example.com"
                    },
                    "displayEmail": {
                        "type": "string",
                        "title": "Display Email",
                        "example": "alex@example.com"
                    },
                    "timeZone": {
                        "type": "string",
                        "title": "Time Zone",
                        "example": "Europe/London"
                    },
                    "language": {
                        "type": "string",
                        "title": "Language",
                        "example": "en"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "title": "Phone Number",
                        "example": "+447700900123"
                    },
                    "absent": {
                        "type": "boolean",
                        "title": "Absent",
                        "example": false
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
