{
    "name": "appmixer.calcom.core.FindBookings",
    "label": "Find Bookings",
    "description": "Find bookings of the connected Cal.com user by status, attendee, event type and dates. This component returns at most 100 bookings.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:calcom"
    },
    "quota": {
        "manager": "appmixer:calcom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "",
                            "upcoming",
                            "recurring",
                            "past",
                            "cancelled",
                            "unconfirmed"
                        ]
                    },
                    "attendeeEmail": {
                        "type": "string"
                    },
                    "attendeeName": {
                        "type": "string"
                    },
                    "eventTypeId": {
                        "type": "string"
                    },
                    "afterStart": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "beforeEnd": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "afterCreatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "beforeCreatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sortStart": {
                        "type": "string",
                        "enum": [
                            "",
                            "asc",
                            "desc"
                        ]
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "status": {
                        "type": "select",
                        "index": 1,
                        "label": "Status",
                        "tooltip": "Only bookings with this status. Leave on All to search every status.",
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Upcoming",
                                "value": "upcoming"
                            },
                            {
                                "label": "Recurring",
                                "value": "recurring"
                            },
                            {
                                "label": "Past",
                                "value": "past"
                            },
                            {
                                "label": "Cancelled",
                                "value": "cancelled"
                            },
                            {
                                "label": "Unconfirmed",
                                "value": "unconfirmed"
                            }
                        ]
                    },
                    "attendeeEmail": {
                        "type": "text",
                        "index": 2,
                        "label": "Attendee Email",
                        "tooltip": "Only bookings with an attendee of this email."
                    },
                    "attendeeName": {
                        "type": "text",
                        "index": 3,
                        "label": "Attendee Name",
                        "tooltip": "Only bookings with an attendee of this name."
                    },
                    "eventTypeId": {
                        "type": "text",
                        "index": 4,
                        "label": "Event Type",
                        "tooltip": "Only bookings of this event type. Pick one, or type its Event Type ID.",
                        "source": {
                            "url": "/component/appmixer/calcom/core/ListEventTypes?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListEventTypes#toSelectArray"
                            }
                        }
                    },
                    "afterStart": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Starts After",
                        "tooltip": "Only bookings that start after this time."
                    },
                    "beforeEnd": {
                        "type": "date-time",
                        "index": 6,
                        "label": "Ends Before",
                        "tooltip": "Only bookings that end before this time."
                    },
                    "afterCreatedAt": {
                        "type": "date-time",
                        "index": 7,
                        "label": "Created After",
                        "tooltip": "Only bookings made after this time."
                    },
                    "beforeCreatedAt": {
                        "type": "date-time",
                        "index": 8,
                        "label": "Created Before",
                        "tooltip": "Only bookings made before this time."
                    },
                    "sortStart": {
                        "type": "select",
                        "index": 9,
                        "label": "Sort by Start",
                        "tooltip": "Order the bookings by their start time.",
                        "options": [
                            {
                                "label": "Default",
                                "value": ""
                            },
                            {
                                "label": "Ascending",
                                "value": "asc"
                            },
                            {
                                "label": "Descending",
                                "value": "desc"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 10,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/calcom/core/FindBookings?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
