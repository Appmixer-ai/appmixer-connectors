{
    "name": "appmixer.calcom.core.CreateEventType",
    "label": "Create Event Type",
    "description": "Create an event type (a bookable meeting kind) for the connected Cal.com user.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:calcom"
    },
    "quota": {
        "manager": "appmixer:calcom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "lengthInMinutes": {
                        "type": "integer"
                    },
                    "description": {
                        "type": "string"
                    },
                    "minimumBookingNotice": {
                        "type": "integer"
                    },
                    "slotInterval": {
                        "type": "integer"
                    },
                    "beforeEventBuffer": {
                        "type": "integer"
                    },
                    "afterEventBuffer": {
                        "type": "integer"
                    },
                    "hidden": {
                        "type": "boolean"
                    },
                    "requiresConfirmation": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "title",
                    "slug",
                    "lengthInMinutes"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "index": 1,
                        "label": "Title",
                        "tooltip": "Name of the event type shown on the booking page, for example <code>30 Min Meeting</code>."
                    },
                    "slug": {
                        "type": "text",
                        "index": 2,
                        "label": "Slug",
                        "tooltip": "URL part of the booking page, unique for your account, for example <code>30min</code> for cal.com/you/30min."
                    },
                    "lengthInMinutes": {
                        "type": "number",
                        "index": 3,
                        "label": "Length (Minutes)",
                        "tooltip": "Length of the meeting in minutes."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Description",
                        "tooltip": "Description shown on the booking page."
                    },
                    "minimumBookingNotice": {
                        "type": "number",
                        "index": 5,
                        "label": "Minimum Booking Notice (Minutes)",
                        "tooltip": "How many minutes before the start a booking can still be made."
                    },
                    "slotInterval": {
                        "type": "number",
                        "index": 6,
                        "label": "Slot Interval (Minutes)",
                        "tooltip": "Distance between the start times offered. Defaults to the length of the event."
                    },
                    "beforeEventBuffer": {
                        "type": "number",
                        "index": 7,
                        "label": "Buffer Before (Minutes)",
                        "tooltip": "Time blocked in your calendar before each meeting."
                    },
                    "afterEventBuffer": {
                        "type": "number",
                        "index": 8,
                        "label": "Buffer After (Minutes)",
                        "tooltip": "Time blocked in your calendar after each meeting."
                    },
                    "hidden": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Hidden",
                        "defaultValue": false,
                        "tooltip": "Hide the event type from your public profile page. It can still be booked through its link."
                    },
                    "requiresConfirmation": {
                        "type": "toggle",
                        "index": 10,
                        "label": "Requires Confirmation",
                        "defaultValue": false,
                        "tooltip": "New bookings stay pending until you confirm them (Confirm Booking). Unconfirmed bookings still block the slot."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "slug",
                    "lengthInMinutes",
                    "hidden",
                    "ownerId"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Event Type ID",
                        "example": 1234567
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "30 Min Meeting"
                    },
                    "slug": {
                        "type": "string",
                        "title": "Slug",
                        "example": "30min"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "A short call to get to know each other."
                    },
                    "lengthInMinutes": {
                        "type": "integer",
                        "title": "Length (Minutes)",
                        "example": 30
                    },
                    "hidden": {
                        "type": "boolean",
                        "title": "Hidden",
                        "example": false
                    },
                    "minimumBookingNotice": {
                        "type": "integer",
                        "title": "Minimum Booking Notice (Minutes)",
                        "example": 120
                    },
                    "slotInterval": {
                        "type": "integer",
                        "title": "Slot Interval (Minutes)",
                        "example": 30
                    },
                    "beforeEventBuffer": {
                        "type": "integer",
                        "title": "Before Event Buffer (Minutes)",
                        "example": 0
                    },
                    "afterEventBuffer": {
                        "type": "integer",
                        "title": "After Event Buffer (Minutes)",
                        "example": 0
                    },
                    "scheduleId": {
                        "type": "integer",
                        "title": "Schedule ID",
                        "example": 98765
                    },
                    "price": {
                        "type": "number",
                        "title": "Price",
                        "example": 0
                    },
                    "currency": {
                        "type": "string",
                        "title": "Currency",
                        "example": "usd"
                    },
                    "ownerId": {
                        "type": "integer",
                        "title": "Owner ID",
                        "example": 112233
                    },
                    "bookingUrl": {
                        "type": "string",
                        "title": "Booking URL",
                        "example": "https://cal.com/jane/30min"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
