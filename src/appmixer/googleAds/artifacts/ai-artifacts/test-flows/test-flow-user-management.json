{
    "name": "E2E GoogleAds - User Management",
    "description": "End-to-end test for GoogleAds connector - tests user list management operations (Create, Add, Remove, Delete)",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 272,
            "y": 16,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "customerId",
                                                "text": "1234567890"
                                            },
                                            {
                                                "type": "text",
                                                "name": "userListName",
                                                "text": "E2E Test User List"
                                            },
                                            {
                                                "type": "text",
                                                "name": "userEmail",
                                                "text": "test.user@example.com"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 480,
            "y": 16,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0"
        },
        "create-user-list": {
            "type": "appmixer.googleAds.core.CreateUserList",
            "x": 688,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "customerId": {
                                        "var-customer-id": {
                                            "variable": "$.set-variables.out.customerId",
                                            "functions": []
                                        }
                                    },
                                    "name": {
                                        "var-list-name": {
                                            "variable": "$.set-variables.out.userListName",
                                            "functions": []
                                        }
                                    },
                                    "description": {}
                                },
                                "lambda": {
                                    "customerId": "{{{var-customer-id}}}",
                                    "name": "{{{var-list-name}}}",
                                    "description": "E2E test user list for automated testing"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-user-list": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-user-list": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-id": {
                                            "variable": "$.create-user-list.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "add-user": {
            "type": "appmixer.googleAds.core.AddUserToUserList",
            "x": 880,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-user-list": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-user-list": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "customerId": {
                                        "var-customer-id": {
                                            "variable": "$.set-variables.out.customerId",
                                            "functions": []
                                        }
                                    },
                                    "userListId": {
                                        "var-list-id": {
                                            "variable": "$.create-user-list.out.id",
                                            "functions": []
                                        }
                                    },
                                    "email": {
                                        "var-email": {
                                            "variable": "$.set-variables.out.userEmail",
                                            "functions": []
                                        }
                                    },
                                    "operation": {},
                                    "adUserDataConsent": {},
                                    "adPersonalizationConsent": {}
                                },
                                "lambda": {
                                    "customerId": "{{{var-customer-id}}}",
                                    "userListId": "{{{var-list-id}}}",
                                    "email": "{{{var-email}}}",
                                    "operation": "create",
                                    "adUserDataConsent": "GRANTED",
                                    "adPersonalizationConsent": "GRANTED"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-add": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "add-user": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "add-user": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-count": {
                                            "variable": "$.add-user.out.receivedOperationsCount",
                                            "functions": []
                                        },
                                        "check-operation": {
                                            "variable": "$.add-user.out.operation",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-count}}}",
                                                "assertion": "equal",
                                                "expected": "1"
                                            },
                                            {
                                                "field": "{{{check-operation}}}",
                                                "assertion": "equal",
                                                "expected": "create"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "remove-user": {
            "type": "appmixer.googleAds.core.RemoveUserFromUserList",
            "x": 1072,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "add-user": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "add-user": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "customerId": {
                                        "var-customer-id": {
                                            "variable": "$.set-variables.out.customerId",
                                            "functions": []
                                        }
                                    },
                                    "userListId": {
                                        "var-list-id": {
                                            "variable": "$.create-user-list.out.id",
                                            "functions": []
                                        }
                                    },
                                    "email": {
                                        "var-email": {
                                            "variable": "$.set-variables.out.userEmail",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "customerId": "{{{var-customer-id}}}",
                                    "userListId": "{{{var-list-id}}}",
                                    "email": "{{{var-email}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-remove": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "remove-user": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "remove-user": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-count": {
                                            "variable": "$.remove-user.out.receivedOperationsCount",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-count}}}",
                                                "assertion": "equal",
                                                "expected": "1"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "delete-user-list": {
            "type": "appmixer.googleAds.core.DeleteUserList",
            "x": 1264,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "remove-user": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "remove-user": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "customerId": {
                                        "var-customer-id": {
                                            "variable": "$.set-variables.out.customerId",
                                            "functions": []
                                        }
                                    },
                                    "userListId": {
                                        "var-list-id": {
                                            "variable": "$.create-user-list.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "customerId": "{{{var-customer-id}}}",
                                    "userListId": "{{{var-list-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-delete": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-user-list": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "delete-user-list": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-success": {
                                            "variable": "$.delete-user-list.out.success",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{check-success}}}",
                                                "assertion": "equal",
                                                "expected": "true"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-add": [
                        "out"
                    ],
                    "assert-remove": [
                        "out"
                    ],
                    "assert-delete": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 60
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1584,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E GoogleAds - User Management",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}