{
    "name": "E2E GoogleAds - Customer Access",
    "description": "End-to-end test for GoogleAds connector - tests customer access functionality",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "loginCustomerId",
                                                "text": ""
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {}
        },
        "list-accessible-customers": {
            "type": "appmixer.googleAds.core.ListAccessibleCustomers",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "loginCustomerId": {}
                                },
                                "lambda": {
                                    "loginCustomerId": ""
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-customers-returned": {
            "type": "appmixer.utils.test.Assert",
            "x": 1024,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-accessible-customers": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-accessible-customers": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "resource-names-check": {
                                            "variable": "$.list-accessible-customers.out.resourceNames",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{resource-names-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-count-valid": {
            "type": "appmixer.utils.test.Assert",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-accessible-customers": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-accessible-customers": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "count-check": {
                                            "variable": "$.list-accessible-customers.out.count",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{count-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1216,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-customers-returned": [
                        "out"
                    ],
                    "assert-count-valid": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1408,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E GoogleAds - Customer Access",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}