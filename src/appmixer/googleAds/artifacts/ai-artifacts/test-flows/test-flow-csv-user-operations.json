            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "remove-users-from-csv": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "remove-users-from-csv": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "check-success": {
                                            "variable": "$.remove-users-from-csv.out.success",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
