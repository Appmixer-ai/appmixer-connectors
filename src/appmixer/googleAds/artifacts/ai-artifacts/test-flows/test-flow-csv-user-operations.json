                                            "functions": []
                                        }
                                    },
                                    "schema": {},
                                    "uploadMode": {}
                                },
                                "lambda": {
                                    "fileId": "test-file-id",
                                    "customerId": "{{{var-customer-id}}}",
                                    "userListId": "{{{var-list-id}}}",
                                    "schema": [
                                        {
                                            "csvHeader": "email",
                                            "googleAdsType": "email"
                                        }
                                    ],
                                    "uploadMode": "ADD"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-add-users": {
