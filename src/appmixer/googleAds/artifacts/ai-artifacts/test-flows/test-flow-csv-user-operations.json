            "type": "appmixer.utils.controls.SetVariable",
            "x": 272,
            "y": 16,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "customerId",
                                                "text": "1234567890"
                                            },
                                            {
                                                "type": "text",
                                                "name": "userListName",
                                                "text": "E2E Test User List"
                                            },
                                            {
                                                "type": "text",
                                                "name": "userListDescription",
                                                "text": "Test user list for E2E testing"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
