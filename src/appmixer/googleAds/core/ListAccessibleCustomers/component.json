{
    "name": "appmixer.googleAds.core.ListAccessibleCustomers",
    "description": "Lists Google Ads customers accessible by the authenticated user.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource Names",
                    "value": "resourceNames",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Count",
                    "value": "count",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
