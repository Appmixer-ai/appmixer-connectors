{
    "name": "appmixer.googleAds.core.ListAccessibleCustomers",
    "description": "Lists Google Ads customers accessible by the authenticated user.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    }
                },
                "required": [
                    "developerToken"
                ]
            },
            "inspector": {
                "inputs": {
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "tooltip": "Google Ads API developer token.",
                        "index": 1
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "Optional manager account customer ID, with or without dashes.",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource Names",
                    "value": "resourceNames",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Count",
                    "value": "count",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    ]
}
