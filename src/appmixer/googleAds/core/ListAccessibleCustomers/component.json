{
    "name": "appmixer.googleAds.core.ListAccessibleCustomers",
    "description": "Lists Google Ads customers accessible by the authenticated user.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "loginCustomerId": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "The Google Ads Manager Account (MCC) ID. Required when accessing accounts managed through an MCC hierarchy. Format: 10-digit number, e.g. 1234567890. See https://developers.google.com/google-ads/api/docs/concepts/call-structure#login-customer-id",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "example": {
                    "customers": [
                        {
                            "id": "1234567890",
                            "resourceName": "customers/1234567890"
                        }
                    ],
                    "count": 3
                },
                "properties": {
                    "customers": {
                        "type": "array",
                        "title": "Customers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Customer ID"
                                },
                                "resourceName": {
                                    "type": "string",
                                    "title": "Resource Name"
                                }
                            }
                        }
                    },
                    "count": {
                        "type": "integer",
                        "title": "Total Count"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}