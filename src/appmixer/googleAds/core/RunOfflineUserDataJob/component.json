{
    "name": "appmixer.googleAds.core.RunOfflineUserDataJob",
    "description": "Runs an existing OfflineUserDataJob in Google Ads.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "offlineUserDataJobId": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken",
                    "offlineUserDataJobId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "index": 3
                    },
                    "offlineUserDataJobId": {
                        "type": "text",
                        "label": "Offline User Data Job ID",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Offline User Data Job ID",
                    "value": "offlineUserDataJobId",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ]
}
