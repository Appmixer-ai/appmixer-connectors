{
    "name": "appmixer.googleAds.core.CreateUserList",
    "description": "Creates a CRM-based Google Ads user list for Customer Match uploads.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "membershipLifeSpan": {
                        "type": "integer"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "index": 3
                    },
                    "name": {
                        "type": "text",
                        "label": "User List Name",
                        "index": 4
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 5
                    },
                    "membershipLifeSpan": {
                        "type": "number",
                        "label": "Membership Life Span",
                        "tooltip": "Optional membership duration in days.",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource Name",
                    "value": "resourceName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Result",
                    "value": "result",
                    "schema": {
                        "type": "object"
                    }
                }
            ]
        }
    ]
}
