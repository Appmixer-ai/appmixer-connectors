{
    "name": "appmixer.googleAds.core.AddUsersFromCSVToUserList",
    "description": "Upload a CSV file of users to a Google Ads Customer Match user list via the Offline User Data Job API. Supports large files by processing them in batches across multiple continuations. Each row must contain at least one identifier: email, phone, first_name+last_name+country_code, mobile_id, or third_party_user_id. Column names are matched case-insensitively.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListId": {
                        "type": "string"
                    },
                    "uploadMode": {
                        "type": "string"
                    },
                    "columnSeparator": {
                        "type": "string"
                    },
                    "adPersonalization": {
                        "type": "string"
                    },
                    "adUserData": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "customerId",
                    "developerToken",
                    "userListId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "label": "CSV File",
                        "tooltip": "A CSV file containing user data. The header row must name the identifier columns (e.g. email, phone, first_name, last_name, country_code, mobile_id, third_party_user_id). Each data row must have at least one usable identifier.",
                        "index": 1
                    },
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "tooltip": "Google Ads customer ID (digits only, e.g. 1234567890). Hyphens are ignored.",
                        "index": 2
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "tooltip": "Your Google Ads API developer token.",
                        "index": 3
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "Required when authenticating via a manager (MCC) account. Leave blank if you are using the customer account directly.",
                        "index": 4
                    },
                    "userListId": {
                        "type": "text",
                        "label": "User List ID",
                        "tooltip": "Numeric ID of the Customer Match user list to upload users into.",
                        "index": 5
                    },
                    "uploadMode": {
                        "type": "select",
                        "label": "Upload Mode",
                        "tooltip": "ADD appends users to the list. REPLACE removes all existing users and replaces them with this upload.",
                        "index": 6,
                        "defaultValue": "ADD",
                        "options": [
                            { "label": "Add (append)", "value": "ADD" },
                            { "label": "Replace (overwrite)", "value": "REPLACE" }
                        ]
                    },
                    "columnSeparator": {
                        "type": "text",
                        "label": "Column Separator",
                        "tooltip": "Character used to separate columns in the CSV file. Default is a comma (,).",
                        "index": 7,
                        "defaultValue": ","
                    },
                    "adPersonalization": {
                        "type": "select",
                        "label": "Ad Personalization Consent",
                        "tooltip": "Consent status for ad personalization. Required by EU User Consent Policy.",
                        "index": 8,
                        "options": [
                            { "label": "Unspecified", "value": "" },
                            { "label": "Granted", "value": "GRANTED" },
                            { "label": "Denied", "value": "DENIED" }
                        ]
                    },
                    "adUserData": {
                        "type": "select",
                        "label": "Ad User Data Consent",
                        "tooltip": "Consent status for use of user data for ads. Required by EU User Consent Policy.",
                        "index": 9,
                        "options": [
                            { "label": "Unspecified", "value": "" },
                            { "label": "Granted", "value": "GRANTED" },
                            { "label": "Denied", "value": "DENIED" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Total Users Uploaded",
                    "value": "totalUsers",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Total Rows Skipped",
                    "value": "totalSkipped",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Total Rows in File",
                    "value": "totalRows",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Job Resource Name",
                    "value": "jobResourceName",
                    "schema": { "type": "string" }
                },
                {
                    "label": "API Errors",
                    "value": "errors",
                    "schema": { "type": "array", "items": { "type": "string" } }
                },
                {
                    "label": "Internal Errors",
                    "value": "internalErrors",
                    "schema": { "type": "array", "items": { "type": "string" } }
                },
                {
                    "label": "Success",
                    "value": "success",
                    "schema": { "type": "boolean" }
                }
            ]
        },
        {
            "name": "progress",
            "options": [
                {
                    "label": "Status",
                    "value": "status",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Total Rows",
                    "value": "totalRows",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Last Processed Row",
                    "value": "lastProcessedRow",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Total Users Uploaded",
                    "value": "totalUsersUploaded",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Percentage",
                    "value": "percentage",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "Elapsed Seconds",
                    "value": "elapsedSeconds",
                    "schema": { "type": "integer" }
                },
                {
                    "label": "ETA (seconds)",
                    "value": "eta",
                    "schema": { "type": "integer" }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
