{
    "name": "appmixer.googleAds.core.CreateOfflineUserDataJob",
    "description": "Creates an OfflineUserDataJob for uploading users into a Customer Match user list.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListResourceName": {
                        "type": "string"
                    },
                    "adUserDataConsent": {
                        "type": "string"
                    },
                    "adPersonalizationConsent": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken",
                    "userListResourceName"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "index": 3
                    },
                    "userListResourceName": {
                        "type": "text",
                        "label": "User List Resource Name",
                        "index": 4
                    },
                    "adUserDataConsent": {
                        "type": "select",
                        "label": "Ad User Data Consent",
                        "index": 5,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    },
                    "adPersonalizationConsent": {
                        "type": "select",
                        "label": "Ad Personalization Consent",
                        "index": 6,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource Name",
                    "value": "resourceName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Offline User Data Job ID",
                    "value": "offlineUserDataJobId",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ]
}
