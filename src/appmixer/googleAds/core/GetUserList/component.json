{
    "name": "appmixer.googleAds.core.GetUserList",
    "description": "Gets a single Google Ads user list by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListId": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "userListId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "The Google Ads Manager Account (MCC) ID. Required when accessing accounts managed through an MCC hierarchy. Format: 10-digit number, e.g. 1234567890. See https://developers.google.com/google-ads/api/docs/concepts/call-structure#login-customer-id",
                        "index": 2
                    },
                    "userListId": {
                        "type": "text",
                        "label": "User List ID",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "resourceName": {
                        "type": "string",
                        "example": "customers/1234567890/userLists/9876543210"
                    },
                    "id": {
                        "type": "string",
                        "example": "9876543210"
                    },
                    "name": {
                        "type": "string",
                        "example": "High-Value Customers Q3"
                    },
                    "description": {
                        "type": "string",
                        "example": "Customers who made purchases over $500 in Q3"
                    },
                    "membershipStatus": {
                        "type": "string",
                        "example": "OPEN"
                    },
                    "sizeForSearch": {
                        "type": "string",
                        "example": 15000
                    },
                    "sizeForDisplay": {
                        "type": "string",
                        "example": 12000
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}