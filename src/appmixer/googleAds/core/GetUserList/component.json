{
    "name": "appmixer.googleAds.core.GetUserList",
    "description": "Gets a single Google Ads user list by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListId": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken",
                    "userListId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "index": 3
                    },
                    "userListId": {
                        "type": "text",
                        "label": "User List ID",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Resource Name",
                    "value": "resourceName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Membership Status",
                    "value": "membershipStatus",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Size For Search",
                    "value": "sizeForSearch",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Size For Display",
                    "value": "sizeForDisplay",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ]
}
