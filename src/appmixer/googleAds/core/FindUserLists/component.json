{
    "name": "appmixer.googleAds.core.FindUserLists",
    "description": "Finds up to 200 Google Ads user lists for a customer account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "searchQuery": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "tooltip": "Google Ads customer ID, with or without dashes.",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "tooltip": "Google Ads API developer token.",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "Optional manager account customer ID, with or without dashes.",
                        "index": 3
                    },
                    "searchQuery": {
                        "type": "textarea",
                        "label": "GAQL Query",
                        "tooltip": "Optional GAQL query override. Leave empty to use the default user list query.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Result",
                    "value": "result",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    }
                },
                {
                    "label": "Count",
                    "value": "count",
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        },
        {
            "name": "notFound"
        }
    ]
}
