{
    "name": "appmixer.googleAds.core.RemoveUsersInCSVFromUserList",
    "description": "Remove users listed in a CSV file from a Google Ads Customer Match user list via the Offline User Data Job API. Supports large files by processing them in batches across multiple continuations. Provide a schema mapping for each upload so different CSV headers can be mapped explicitly.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListId": {
                        "type": "string"
                    },
                    "schema": {
                        "type": "object"
                    },
                    "columnSeparator": {
                        "type": "string"
                    },
                    "adPersonalization": {
                        "type": "string"
                    },
                    "adUserData": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "customerId",
                    "userListId",
                    "schema"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "label": "CSV File",
                        "tooltip": "A CSV file containing user data. Use the Schema field below to map each CSV header to the Google Ads identifier it represents.",
                        "index": 1
                    },
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "tooltip": "Google Ads customer ID (digits only, e.g. 1234567890). Hyphens are ignored.",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "The Google Ads Manager Account (MCC) ID. Required when accessing accounts managed through an MCC hierarchy. Format: 10-digit number, e.g. 1234567890. See https://developers.google.com/google-ads/api/docs/concepts/call-structure#login-customer-id",
                        "index": 3
                    },
                    "userListId": {
                        "type": "text",
                        "label": "User List ID",
                        "tooltip": "Numeric ID of the Customer Match user list to remove users from.",
                        "index": 4
                    },
                    "schema": {
                        "type": "expression",
                        "levels": ["ADD"],
                        "index": 5,
                        "label": "Schema",
                        "tooltip": "Required mapping between CSV headers and Google Ads identifiers. This component does not infer identifiers from header names.",
                        "fields": {
                            "csvHeader": {
                                "type": "text",
                                "label": "CSV Header",
                                "tooltip": "The header name in the CSV file. Matching is case-insensitive."
                            },
                            "googleAdsType": {
                                "type": "select",
                                "label": "Google Ads Type",
                                "tooltip": "The Google Ads identifier type represented by this CSV column.",
                                "options": [
                                    { "value": "email", "label": "Email" },
                                    { "value": "phoneNumber", "label": "Phone Number" },
                                    { "value": "firstName", "label": "First Name" },
                                    { "value": "lastName", "label": "Last Name" },
                                    { "value": "countryCode", "label": "Country Code" },
                                    { "value": "postalCode", "label": "Postal Code" },
                                    { "value": "mobileId", "label": "Mobile Device ID" },
                                    { "value": "thirdPartyUserId", "label": "Third Party User ID" }
                                ]
                            }
                        }
                    },
                    "columnSeparator": {
                        "type": "text",
                        "label": "Column Separator",
                        "tooltip": "Character used to separate columns in the CSV file. Default is a comma (,).",
                        "index": 6,
                        "defaultValue": ","
                    },
                    "adPersonalization": {
                        "type": "select",
                        "label": "Ad Personalization Consent",
                        "tooltip": "Consent status for ad personalization. Required by EU User Consent Policy.",
                        "index": 7,
                        "options": [
                            { "label": "Unspecified", "value": "" },
                            { "label": "Granted", "value": "GRANTED" },
                            { "label": "Denied", "value": "DENIED" }
                        ]
                    },
                    "adUserData": {
                        "type": "select",
                        "label": "Ad User Data Consent",
                        "tooltip": "Consent status for use of user data for ads. Required by EU User Consent Policy.",
                        "index": 8,
                        "options": [
                            { "label": "Unspecified", "value": "" },
                            { "label": "Granted", "value": "GRANTED" },
                            { "label": "Denied", "value": "DENIED" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "example": {
                    "totalUsers": 150,
                    "totalSkipped": 3,
                    "totalRows": 153,
                    "jobResourceName": "customers/1234567890/offlineUserDataJobs/456",
                    "errors": [],
                    "internalErrors": [],
                    "success": true
                },
                "properties": {
                    "totalUsers": {
                        "type": "integer",
                        "title": "Total Users Removed"
                    },
                    "totalSkipped": {
                        "type": "integer",
                        "title": "Total Rows Skipped"
                    },
                    "totalRows": {
                        "type": "integer",
                        "title": "Total Rows in File"
                    },
                    "jobResourceName": {
                        "type": "string",
                        "title": "Job Resource Name"
                    },
                    "errors": {
                        "type": "array",
                        "title": "API Errors",
                        "items": {
                            "type": "string"
                        }
                    },
                    "internalErrors": {
                        "type": "array",
                        "title": "Internal Errors",
                        "items": {
                            "type": "string"
                        }
                    },
                    "success": {
                        "type": "boolean",
                        "title": "Success"
                    }
                }
            }
        },
        {
            "name": "progress",
            "schema": {
                "type": "object",
                "example": {
                    "status": "in-progress",
                    "message": "Removed 75 users (50%)",
                    "totalRows": 153,
                    "lastProcessedRow": 75,
                    "totalUsersRemoved": 75,
                    "percentage": 50,
                    "elapsedSeconds": 120,
                    "eta": 120
                },
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "message": {
                        "type": "string",
                        "title": "Message"
                    },
                    "totalRows": {
                        "type": "integer",
                        "title": "Total Rows"
                    },
                    "lastProcessedRow": {
                        "type": "integer",
                        "title": "Last Processed Row"
                    },
                    "totalUsersRemoved": {
                        "type": "integer",
                        "title": "Total Users Removed"
                    },
                    "percentage": {
                        "type": "integer",
                        "title": "Percentage"
                    },
                    "elapsedSeconds": {
                        "type": "integer",
                        "title": "Elapsed Seconds"
                    },
                    "eta": {
                        "type": "integer",
                        "title": "ETA (seconds)"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
