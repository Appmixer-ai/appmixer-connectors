{
    "name": "appmixer.googleAds.core.RemoveUserFromUserList",
    "description": "Removes a single user from a Customer Match user list via UserDataService.UploadUserData. Best for sporadic, real-time updates (e.g. CRM webhook). Limit: 1 user per call. Note: updates do not appear in the Google Ads UI upload history.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "userListId": {
                        "type": "string"
                    },
                    "userListResourceName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "countryCode": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    },
                    "mobileId": {
                        "type": "string"
                    },
                    "thirdPartyUserId": {
                        "type": "string"
                    },
                    "adUserDataConsent": {
                        "type": "string"
                    },
                    "adPersonalizationConsent": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "tooltip": "The Google Ads Manager Account (MCC) ID. Required when accessing accounts managed through an MCC hierarchy. Format: 10-digit number, e.g. 1234567890. See https://developers.google.com/google-ads/api/docs/concepts/call-structure#login-customer-id",
                        "index": 2
                    },
                    "userListId": {
                        "type": "text",
                        "label": "User List ID",
                        "tooltip": "Numeric ID of the Customer Match user list. Use either User List ID or User List Resource Name.",
                        "index": 3
                    },
                    "userListResourceName": {
                        "type": "text",
                        "label": "User List Resource Name",
                        "tooltip": "Full resource name, e.g. customers/123/userLists/456. Use either this or User List ID.",
                        "index": 4
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "Email address of the user. Provide either email OR phone OR (firstName + lastName + countryCode) OR mobileId OR thirdPartyUserId.",
                        "index": 5
                    },
                    "phoneNumber": {
                        "type": "text",
                        "label": "Phone Number",
                        "tooltip": "Phone number in E.164 format (e.g., +1234567890). Provide either email OR phone OR (firstName + lastName + countryCode) OR mobileId OR thirdPartyUserId.",
                        "index": 6
                    },
                    "firstName": {
                        "type": "text",
                        "label": "First Name",
                        "tooltip": "First name. Use with lastName and countryCode for address-based matching.",
                        "index": 7
                    },
                    "lastName": {
                        "type": "text",
                        "label": "Last Name",
                        "tooltip": "Last name. Use with firstName and countryCode for address-based matching.",
                        "index": 8
                    },
                    "countryCode": {
                        "type": "text",
                        "label": "Country Code",
                        "tooltip": "2-letter ISO-3166-1 alpha-2 country code (e.g., US, CA, GB). Use with firstName and lastName for address-based matching.",
                        "index": 9
                    },
                    "postalCode": {
                        "type": "text",
                        "label": "Postal Code",
                        "tooltip": "Postal/ZIP code. Optional with address-based matching.",
                        "index": 10
                    },
                    "mobileId": {
                        "type": "text",
                        "label": "Mobile Device ID",
                        "tooltip": "Mobile device ID (IDFA for iOS or Google Advertising ID for Android). Provide either email OR phone OR (firstName + lastName + countryCode) OR mobileId OR thirdPartyUserId.",
                        "index": 11
                    },
                    "thirdPartyUserId": {
                        "type": "text",
                        "label": "Third Party User ID",
                        "tooltip": "Advertiser-assigned user ID. Provide either email OR phone OR (firstName + lastName + countryCode) OR mobileId OR thirdPartyUserId.",
                        "index": 12
                    },
                    "adUserDataConsent": {
                        "type": "select",
                        "label": "Ad User Data Consent",
                        "tooltip": "User consent status for ad user data. Optional.",
                        "index": 13,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    },
                    "adPersonalizationConsent": {
                        "type": "select",
                        "label": "Ad Personalization Consent",
                        "tooltip": "User consent status for ad personalization. Optional.",
                        "index": 14,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "receivedOperationsCount": {
                        "type": "integer",
                        "title": "Received Operations Count",
                        "example": 1
                    },
                    "uploadDateTime": {
                        "type": "string",
                        "title": "Upload Date Time",
                        "example": "2024-03-15 10:30:00"
                    },
                    "userListResourceName": {
                        "type": "string",
                        "title": "User List Resource Name",
                        "example": "customers/1234567890/userLists/9876543210"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
