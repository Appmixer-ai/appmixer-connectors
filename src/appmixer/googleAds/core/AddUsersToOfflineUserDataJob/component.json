{
    "name": "appmixer.googleAds.core.AddUsersToOfflineUserDataJob",
    "description": "Adds hashed email user records to an OfflineUserDataJob for Customer Match uploads.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleAds",
        "scope": [
            "https://www.googleapis.com/auth/adwords"
        ]
    },
    "quota": {
        "manager": "appmixer:googleAds",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "developerToken": {
                        "type": "string"
                    },
                    "loginCustomerId": {
                        "type": "string"
                    },
                    "offlineUserDataJobResourceName": {
                        "type": "string"
                    },
                    "emails": {
                        "type": "string"
                    },
                    "adUserDataConsent": {
                        "type": "string"
                    },
                    "adPersonalizationConsent": {
                        "type": "string"
                    }
                },
                "required": [
                    "customerId",
                    "developerToken",
                    "offlineUserDataJobResourceName",
                    "emails"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 1
                    },
                    "developerToken": {
                        "type": "text",
                        "label": "Developer Token",
                        "index": 2
                    },
                    "loginCustomerId": {
                        "type": "text",
                        "label": "Login Customer ID",
                        "index": 3
                    },
                    "offlineUserDataJobResourceName": {
                        "type": "text",
                        "label": "Offline User Data Job Resource Name",
                        "index": 4
                    },
                    "emails": {
                        "type": "textarea",
                        "label": "Emails",
                        "tooltip": "Comma, semicolon, or newline separated email addresses.",
                        "index": 5
                    },
                    "adUserDataConsent": {
                        "type": "select",
                        "label": "Ad User Data Consent",
                        "index": 6,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    },
                    "adPersonalizationConsent": {
                        "type": "select",
                        "label": "Ad Personalization Consent",
                        "index": 7,
                        "options": [
                            {
                                "label": "Unspecified",
                                "value": "UNSPECIFIED"
                            },
                            {
                                "label": "Unknown",
                                "value": "UNKNOWN"
                            },
                            {
                                "label": "Granted",
                                "value": "GRANTED"
                            },
                            {
                                "label": "Denied",
                                "value": "DENIED"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Received Operations",
                    "value": "receivedOperations",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Partial Failure Error",
                    "value": "partialFailureError",
                    "schema": {
                        "type": "object"
                    }
                }
            ]
        }
    ]
}
