{
    "name": "appmixer.asin.core.GetPriceHistory",
    "label": "Get Price History",
    "description": "Get the price history Asin has recorded for a product: lowest, highest and average price, and the dated price points. Empty when Asin has no history for the product yet.",
    "author": "Asin <josselin@asin.dev>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:asin"
    },
    "quota": {
        "manager": "appmixer:asin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "asin": {
                        "type": "string"
                    },
                    "marketplace": {
                        "type": "string"
                    },
                    "days": {
                        "type": "number"
                    }
                },
                "required": [
                    "asin"
                ]
            },
            "inspector": {
                "inputs": {
                    "asin": {
                        "type": "text",
                        "index": 1,
                        "label": "ASIN",
                        "tooltip": "10-character ASIN of the product."
                    },
                    "marketplace": {
                        "type": "select",
                        "index": 2,
                        "label": "Marketplace",
                        "tooltip": "Amazon store.",
                        "defaultValue": "com",
                        "options": [
                            {
                                "label": "com",
                                "value": "com"
                            },
                            {
                                "label": "co.uk",
                                "value": "co.uk"
                            },
                            {
                                "label": "de",
                                "value": "de"
                            },
                            {
                                "label": "fr",
                                "value": "fr"
                            },
                            {
                                "label": "it",
                                "value": "it"
                            },
                            {
                                "label": "es",
                                "value": "es"
                            },
                            {
                                "label": "ca",
                                "value": "ca"
                            },
                            {
                                "label": "co.jp",
                                "value": "co.jp"
                            }
                        ]
                    },
                    "days": {
                        "type": "number",
                        "index": 3,
                        "label": "Days",
                        "tooltip": "History period in days."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "asin": {
                        "type": "string",
                        "title": "ASIN",
                        "example": "B0CZY1LRT4"
                    },
                    "currency": {
                        "type": "string",
                        "title": "Currency",
                        "example": "USD"
                    },
                    "lowest_price": {
                        "type": "number",
                        "title": "Lowest Price",
                        "example": 99.99
                    },
                    "highest_price": {
                        "type": "number",
                        "title": "Highest Price",
                        "example": 179.99
                    },
                    "average_price": {
                        "type": "number",
                        "title": "Average Price",
                        "example": 139.5
                    },
                    "history": {
                        "type": "array",
                        "title": "History"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
