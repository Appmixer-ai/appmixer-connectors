{
    "name": "appmixer.asin.core.GetAccount",
    "label": "Get Account",
    "description": "Get the connected Asin account: plan, remaining credits, renewal date and tracked products.",
    "author": "Asin <josselin@asin.dev>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:asin"
    },
    "quota": {
        "manager": "appmixer:asin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "plan_name": {
                        "type": "string",
                        "title": "Plan",
                        "example": "Starter"
                    },
                    "credits": {
                        "type": "integer",
                        "title": "Credits",
                        "example": 29588
                    },
                    "renews_at": {
                        "type": "string",
                        "title": "Renews At",
                        "example": "2026-12-01T09:12:44.000Z"
                    },
                    "products": {
                        "type": "integer",
                        "title": "Tracked Products",
                        "example": 42
                    },
                    "product_limit": {
                        "type": "integer",
                        "title": "Product Limit",
                        "example": 50000
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
