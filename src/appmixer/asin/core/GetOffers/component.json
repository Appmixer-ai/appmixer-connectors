{
    "name": "appmixer.asin.core.GetOffers",
    "label": "Get Offers",
    "description": "Get the offers Asin has already collected for a product: Amazon's price, the lowest new and used prices, and each seller's offer.",
    "author": "Asin <josselin@asin.dev>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:asin"
    },
    "quota": {
        "manager": "appmixer:asin",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "asin": {
                        "type": "string"
                    },
                    "marketplace": {
                        "type": "string"
                    }
                },
                "required": [
                    "asin"
                ]
            },
            "inspector": {
                "inputs": {
                    "asin": {
                        "type": "text",
                        "index": 1,
                        "label": "ASIN",
                        "tooltip": "10-character ASIN of the product."
                    },
                    "marketplace": {
                        "type": "select",
                        "index": 2,
                        "label": "Marketplace",
                        "tooltip": "Amazon store.",
                        "defaultValue": "com",
                        "options": [
                            {
                                "label": "com",
                                "value": "com"
                            },
                            {
                                "label": "co.uk",
                                "value": "co.uk"
                            },
                            {
                                "label": "de",
                                "value": "de"
                            },
                            {
                                "label": "fr",
                                "value": "fr"
                            },
                            {
                                "label": "it",
                                "value": "it"
                            },
                            {
                                "label": "es",
                                "value": "es"
                            },
                            {
                                "label": "ca",
                                "value": "ca"
                            },
                            {
                                "label": "co.jp",
                                "value": "co.jp"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "asin": {
                        "type": "string",
                        "title": "ASIN",
                        "example": "B0CZY1LRT4"
                    },
                    "amazon_price": {
                        "type": "number",
                        "title": "Amazon Price",
                        "example": 177.99
                    },
                    "lowest_new_price": {
                        "type": "number",
                        "title": "Lowest New Price",
                        "example": 169.99
                    },
                    "lowest_used_price": {
                        "type": "number",
                        "title": "Lowest Used Price",
                        "example": 120
                    },
                    "offers": {
                        "type": "array",
                        "title": "Offers"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
