{
    "name": "E2E Convex - deployment-management",
    "description": "End-to-end test for Convex connector - tests deployment management operations",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 200,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectId",
                                                "text": "test-project-id"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 400,
            "y": 200,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {}
        },
        "list-deployments": {
            "type": "appmixer.convex.core.ListDeployments",
            "x": 550,
            "y": 100,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectId": {
                                        "var-project-id": {
                                            "variable": "$.set-variables.out.projectId",
                                            "functions": []
                                        }
                                    },
                                    "outputType": {}
                                },
                                "lambda": {
                                    "projectId": "{{{var-project-id}}}",
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-deployments": {
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 100,
            "source": {
                "in": {
                    "list-deployments": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "list-deployments": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "result-check": {
                                            "variable": "$.list-deployments.out.result",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{result-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "delete-deployment": {
            "type": "appmixer.convex.core.DeleteDeployment",
            "x": 550,
            "y": 300,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "deploymentName": {}
                                },
                                "lambda": {
                                    "deploymentName": "test-deployment-to-delete"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-delete-deployment": {
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 300,
            "source": {
                "in": {
                    "delete-deployment": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "delete-deployment": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {}
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "true",
                                                "assertion": "equal",
                                                "expected": "true"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 850,
            "y": 200,
            "source": {
                "in": {
                    "assert-list-deployments": [
                        "out"
                    ],
                    "assert-delete-deployment": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1000,
            "y": 200,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Convex - deployment-management",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}