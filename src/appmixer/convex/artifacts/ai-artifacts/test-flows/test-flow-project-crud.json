{
    "name": "E2E Convex - project-crud",
    "description": "End-to-end test for Convex connector - tests project CRUD operations",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 200,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectName",
                                                "text": "E2E Test Project"
                                            },
                                            {
                                                "type": "text",
                                                "name": "deploymentType",
                                                "text": "dev"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-project": {
            "type": "appmixer.convex.core.CreateProject",
            "x": 400,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectName": {
                                        "var-project-name": {
                                            "variable": "$.set-variables.out.projectName",
                                            "functions": []
                                        }
                                    },
                                    "deploymentType": {
                                        "var-deployment-type": {
                                            "variable": "$.set-variables.out.deploymentType",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "projectName": "{{{var-project-name}}}",
                                    "deploymentType": "{{{var-deployment-type}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 550,
            "y": 100,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "project-id-check": {
                                            "variable": "$.create-project.out.projectId",
                                            "functions": []
                                        },
                                        "deployment-name-check": {
                                            "variable": "$.create-project.out.deploymentName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{project-id-check}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{deployment-name-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-projects": {
            "type": "appmixer.convex.core.ListProjects",
            "x": 550,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list": {
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-projects": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-projects": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "result-check": {
                                            "variable": "$.list-projects.out.result",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{result-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 850,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-list": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-project": {
            "type": "appmixer.convex.core.DeleteProject",
            "x": 1000,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectId": {
                                        "var-project-id": {
                                            "variable": "$.create-project.out.projectId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "projectId": "{{{var-project-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1150,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64cb41824421780007381f86",
                    "failedStoreId": "64cb41969751560007caf0bf"
                },
                "transform": {
                    "in": {
                        "delete-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Convex - project-crud",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}