            "source": {
                "in": {
                    "start-time-entry": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "start-time-entry": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "start-entry-id": {
                                            "variable": "$.start-time-entry.out.data.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{start-entry-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "stop-time-entry": {
