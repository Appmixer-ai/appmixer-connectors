{
    "name": "E2E Utils Timers - Scheduler timezone conversion",
    "description": "End-to-end test for appmixer.utils.timers.SchedulerTrigger - two daily schedules at 09:00 with Immediate on, in Asia/Kolkata (+05:30, no DST) and Europe/Prague (DST), assert the local and GMT times of the next run. Exercises moment-timezone on top of the installed moment version.",
    "type": "automation",
    "flow": {
        "f3a1c2d4-0001-4a6b-9c11-5c7e8a9b0001": {
            "type": "appmixer.utils.controls.OnStart",
            "label": "On Start",
            "x": 64,
            "y": 16,
            "source": {},
            "config": {},
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0002-4a6b-9c11-5c7e8a9b0002": {
            "type": "appmixer.utils.controls.SetVariable",
            "label": "Set Variables",
            "x": 288,
            "y": 16,
            "source": {
                "in": {
                    "f3a1c2d4-0001-4a6b-9c11-5c7e8a9b0001": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "f3a1c2d4-0001-4a6b-9c11-5c7e8a9b0001": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "marker",
                                                "text": "utils-timers-scheduler-timezone"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003": {
            "type": "appmixer.utils.timers.SchedulerTrigger",
            "label": "Scheduler Kolkata",
            "x": 64,
            "y": 208,
            "source": {},
            "config": {
                "properties": {
                    "scheduleType": "days",
                    "time": "09:00",
                    "timezone": "Asia/Kolkata",
                    "immediate": true
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004": {
            "type": "appmixer.utils.timers.SchedulerTrigger",
            "label": "Scheduler Prague",
            "x": 64,
            "y": 400,
            "source": {},
            "config": {
                "properties": {
                    "scheduleType": "days",
                    "time": "09:00",
                    "timezone": "Europe/Prague",
                    "immediate": true
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0005-4a6b-9c11-5c7e8a9b0005": {
            "type": "appmixer.utils.test.Assert",
            "label": "Assert Kolkata +05:30",
            "x": 512,
            "y": 208,
            "source": {
                "in": {
                    "f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "ref-tz": {
                                            "variable": "$.f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003.out.timezone",
                                            "functions": []
                                        },
                                        "ref-local": {
                                            "variable": "$.f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003.out.nextDateLocal",
                                            "functions": []
                                        },
                                        "ref-gmt": {
                                            "variable": "$.f3a1c2d4-0003-4a6b-9c11-5c7e8a9b0003.out.nextDateGMT",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{ref-tz}}}",
                                                "assertion": "equal",
                                                "expected": "Asia/Kolkata",
                                                "type": "string",
                                                "label": "Timezone is Asia/Kolkata"
                                            },
                                            {
                                                "field": "{{{ref-local}}}",
                                                "assertion": "regex",
                                                "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T09:00:00\\.000$",
                                                "label": "Next run local time is 09:00"
                                            },
                                            {
                                                "field": "{{{ref-gmt}}}",
                                                "assertion": "regex",
                                                "regex": "T03:30:00\\.000Z$",
                                                "label": "Next run GMT time matches the Asia/Kolkata offset"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0006-4a6b-9c11-5c7e8a9b0006": {
            "type": "appmixer.utils.test.Assert",
            "label": "Assert Prague CET/CEST",
            "x": 512,
            "y": 400,
            "source": {
                "in": {
                    "f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "ref-tz": {
                                            "variable": "$.f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004.out.timezone",
                                            "functions": []
                                        },
                                        "ref-local": {
                                            "variable": "$.f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004.out.nextDateLocal",
                                            "functions": []
                                        },
                                        "ref-gmt": {
                                            "variable": "$.f3a1c2d4-0004-4a6b-9c11-5c7e8a9b0004.out.nextDateGMT",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{ref-tz}}}",
                                                "assertion": "equal",
                                                "expected": "Europe/Prague",
                                                "type": "string",
                                                "label": "Timezone is Europe/Prague"
                                            },
                                            {
                                                "field": "{{{ref-local}}}",
                                                "assertion": "regex",
                                                "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T09:00:00\\.000$",
                                                "label": "Next run local time is 09:00"
                                            },
                                            {
                                                "field": "{{{ref-gmt}}}",
                                                "assertion": "regex",
                                                "regex": "T0[78]:00:00\\.000Z$",
                                                "label": "Next run GMT time matches the Europe/Prague offset"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0007-4a6b-9c11-5c7e8a9b0007": {
            "type": "appmixer.utils.test.AfterAll",
            "label": "After All",
            "x": 736,
            "y": 208,
            "source": {
                "in": {
                    "f3a1c2d4-0002-4a6b-9c11-5c7e8a9b0002": [
                        "out"
                    ],
                    "f3a1c2d4-0005-4a6b-9c11-5c7e8a9b0005": [
                        "out"
                    ],
                    "f3a1c2d4-0006-4a6b-9c11-5c7e8a9b0006": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 180
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        },
        "f3a1c2d4-0008-4a6b-9c11-5c7e8a9b0008": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "label": "Process E2E Results",
            "x": 960,
            "y": 208,
            "source": {
                "in": {
                    "f3a1c2d4-0007-4a6b-9c11-5c7e8a9b0007": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "f3a1c2d4-0007-4a6b-9c11-5c7e8a9b0007": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "ref-result": {
                                            "variable": "$.f3a1c2d4-0007-4a6b-9c11-5c7e8a9b0007.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E Utils Timers - Scheduler timezone conversion",
                                    "result": "{{{ref-result}}}"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": {
                "autoRetry": false,
                "onError": "stopFlow"
            }
        }
    }
}
