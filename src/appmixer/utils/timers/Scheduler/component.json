                        "format": "date-time"
                    },
                    "now": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "nextDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [ "lastTick", "elapsed", "now" ]
