{
    "name": "appmixer.arcmira.core.ResolveEntity",
    "label": "Resolve Entity",
    "description": "Resolve a name, @handle, YouTube URL or channel ID to one Arcmira entity ID for use in Find Transcripts filters. Returns the best match when the name is certain, a suggested match when one entity stands out, or the candidates to choose from. Resolving uses no credits.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:arcmira"
    },
    "quota": {
        "manager": "appmixer:arcmira",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "minLength": 2
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "",
                            "person",
                            "organization",
                            "product",
                            "topic",
                            "channel"
                        ]
                    },
                    "context": {
                        "type": "string",
                        "maxLength": 300
                    },
                    "maxCandidates": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Name",
                        "index": 1,
                        "tooltip": "A name, @handle, YouTube URL or channel ID (<code>UC...</code>). One thing per call."
                    },
                    "type": {
                        "type": "select",
                        "label": "Entity Type",
                        "index": 2,
                        "tooltip": "Restrict candidates to one type. Use Channel for a show and read the YouTube Channel ID of the result.",
                        "options": [
                            {
                                "label": "Any",
                                "value": ""
                            },
                            {
                                "label": "Person",
                                "value": "person"
                            },
                            {
                                "label": "Organization",
                                "value": "organization"
                            },
                            {
                                "label": "Product",
                                "value": "product"
                            },
                            {
                                "label": "Topic",
                                "value": "topic"
                            },
                            {
                                "label": "Channel",
                                "value": "channel"
                            }
                        ]
                    },
                    "context": {
                        "type": "text",
                        "label": "Context",
                        "index": 3,
                        "tooltip": "Optional words describing the name, e.g. \"the startup bank\" or \"on My First Million\" (2–300 characters). Helps pick the right entity."
                    },
                    "maxCandidates": {
                        "type": "number",
                        "label": "Max Candidates",
                        "index": 4,
                        "min": 1,
                        "max": 15,
                        "defaultValue": 8,
                        "tooltip": "Candidates to return, 1 to 15 (default 8)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "query",
                    "confidence",
                    "candidates"
                ],
                "properties": {
                    "query": {
                        "type": "string",
                        "title": "Query",
                        "example": "OpenAI"
                    },
                    "confidence": {
                        "type": "string",
                        "title": "Confidence",
                        "example": "exact"
                    },
                    "entityId": {
                        "type": "string",
                        "title": "Entity ID",
                        "example": "ent_10234"
                    },
                    "entityName": {
                        "type": "string",
                        "title": "Entity Name",
                        "example": "OpenAI"
                    },
                    "assumed": {
                        "type": "boolean",
                        "title": "Assumed",
                        "example": false
                    },
                    "best": {
                        "type": "object",
                        "title": "Best",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Best.ID",
                                "example": "ent_10234"
                            },
                            "name": {
                                "type": "string",
                                "title": "Best.Name",
                                "example": "OpenAI"
                            },
                            "type": {
                                "type": "string",
                                "title": "Best.Type",
                                "example": "organization"
                            },
                            "slug": {
                                "type": "string",
                                "title": "Best.Slug",
                                "example": "openai"
                            },
                            "appearanceCount": {
                                "type": "integer",
                                "title": "Best.Appearance Count",
                                "example": 18342
                            },
                            "youtubeChannelId": {
                                "type": "string",
                                "title": "Best.YouTube Channel ID",
                                "example": "UCXZCJLdBC09xxGZ6gcdrc6A"
                            },
                            "description": {
                                "type": "string",
                                "title": "Best.Description",
                                "example": "AI research and deployment company behind ChatGPT."
                            },
                            "page": {
                                "type": "string",
                                "title": "Best.Page",
                                "example": "https://arcmira.com/organization/openai"
                            },
                            "match": {
                                "type": "string",
                                "title": "Best.Match",
                                "example": "exact"
                            }
                        }
                    },
                    "suggested": {
                        "type": "object",
                        "title": "Suggested",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Suggested.ID",
                                "example": "ent_10234"
                            },
                            "name": {
                                "type": "string",
                                "title": "Suggested.Name",
                                "example": "OpenAI"
                            },
                            "type": {
                                "type": "string",
                                "title": "Suggested.Type",
                                "example": "organization"
                            },
                            "slug": {
                                "type": "string",
                                "title": "Suggested.Slug",
                                "example": "openai"
                            },
                            "appearanceCount": {
                                "type": "integer",
                                "title": "Suggested.Appearance Count",
                                "example": 18342
                            },
                            "youtubeChannelId": {
                                "type": "string",
                                "title": "Suggested.YouTube Channel ID",
                                "example": "UCXZCJLdBC09xxGZ6gcdrc6A"
                            },
                            "description": {
                                "type": "string",
                                "title": "Suggested.Description",
                                "example": "AI research and deployment company behind ChatGPT."
                            },
                            "page": {
                                "type": "string",
                                "title": "Suggested.Page",
                                "example": "https://arcmira.com/organization/openai"
                            },
                            "match": {
                                "type": "string",
                                "title": "Suggested.Match",
                                "example": "exact"
                            },
                            "reason": {
                                "type": "string",
                                "title": "Suggested.Reason",
                                "example": "dominant"
                            },
                            "evidence": {
                                "type": "string",
                                "title": "Suggested.Evidence",
                                "example": "it has 4,399 appearances, 11x the next match (Sam Dunning, 397)"
                            }
                        }
                    },
                    "askQuestion": {
                        "type": "string",
                        "title": "Ask Question",
                        "example": "Which Jordan do you mean?"
                    },
                    "askOptions": {
                        "type": "array",
                        "title": "Ask Options",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string"
                                },
                                "label": {
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "ent_5521",
                                "name": "Michael Jordan",
                                "type": "person",
                                "label": "Michael Jordan (person), basketball player, 2,113 appearances"
                            }
                        ]
                    },
                    "candidates": {
                        "type": "array",
                        "title": "Candidates",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string"
                                },
                                "slug": {
                                    "type": "string"
                                },
                                "appearance_count": {
                                    "type": "integer"
                                },
                                "youtube_channel_id": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                },
                                "page": {
                                    "type": "string"
                                },
                                "match": {
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "ent_10234",
                                "name": "OpenAI",
                                "type": "organization",
                                "slug": "openai",
                                "appearance_count": 18342,
                                "youtube_channel_id": null,
                                "description": "AI research and deployment company behind ChatGPT.",
                                "page": "https://arcmira.com/organization/openai",
                                "match": "exact"
                            }
                        ]
                    },
                    "note": {
                        "type": "string",
                        "title": "Note",
                        "example": "OpenAI is exact. Use ent_10234."
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "title": "Query",
                        "example": "Xyzzyq"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
