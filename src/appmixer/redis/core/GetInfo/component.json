{
    "name": "appmixer.redis.core.GetInfo",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Returns information and statistics about the Redis server including server version, memory usage, connected clients, and other server metrics.",
    "auth": {
        "service": "appmixer:redis"
    },
    "private": false,
    "quota": {},
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Info - All Information",
                    "value": "info",
                    "schema": { "type": "string", "example": "# Server\nredis_version:7.0.12\nredis_mode:standalone\n..." }
                },
                {
                    "label": "Redis Version",
                    "value": "redis_version",
                    "schema": { "type": "string", "example": "7.0.12" }
                },
                {
                    "label": "Redis Mode",
                    "value": "redis_mode",
                    "schema": { "type": "string", "example": "standalone" }
                },
                {
                    "label": "Operating System",
                    "value": "os",
                    "schema": { "type": "string", "example": "Linux 5.15.0-75-generic x86_64" }
                },
                {
                    "label": "Memory Used (Human)",
                    "value": "used_memory_human",
                    "schema": { "type": "string", "example": "1.25M" }
                },
                {
                    "label": "Maxmemory Policy",
                    "value": "maxmemory_policy",
                    "schema": { "type": "string", "example": "noeviction" }
                },
                {
                    "label": "Connected Clients",
                    "value": "connected_clients",
                    "schema": { "type": "string", "example": "3" }
                },
                {
                    "label": "Total Commands Processed",
                    "value": "total_commands_processed",
                    "schema": { "type": "string", "example": "15234" }
                },
                {
                    "label": "Uptime (Seconds)",
                    "value": "uptime_in_seconds",
                    "schema": { "type": "string", "example": "86400" }
                },
                {
                    "label": "Replication Role",
                    "value": "role",
                    "schema": { "type": "string", "example": "master" }
                },
                {
                    "label": "Cluster Enabled",
                    "value": "cluster_enabled",
                    "schema": { "type": "string", "example": "0" }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
