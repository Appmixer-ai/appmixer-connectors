{
    "name": "E2E MSPowerBI - Dashboards",
    "description": "End-to-end test for MSPowerBI connector - tests dashboard operations: ListDashboards, GetDashboard, GetTiles",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "groupId",
                                                "text": ""
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-dashboards": {
            "type": "appmixer.MSPowerBI.core.ListDashboards",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {}
        },
        "assert-list-dashboards": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-dashboards": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-dashboards": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-dashboards": {
                                            "variable": "$.list-dashboards.out.dashboards",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-dashboards}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-dashboard": {
            "type": "appmixer.MSPowerBI.core.GetDashboard",
            "x": 1024,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-dashboards": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-dashboards": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "dashboardId": {
                                        "var-dashboard-id": {
                                            "variable": "$.list-dashboards.out.dashboards.0.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "dashboardId": "{{{var-dashboard-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get-dashboard": {
            "type": "appmixer.utils.test.Assert",
            "x": 1216,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-dashboard": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-dashboard": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.get-dashboard.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-tiles": {
            "type": "appmixer.MSPowerBI.core.GetTiles",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-dashboard": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-dashboard": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "dashboardId": {
                                        "var-dashboard-id": {
                                            "variable": "$.get-dashboard.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "dashboardId": "{{{var-dashboard-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get-tiles": {
            "type": "appmixer.utils.test.Assert",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-tiles": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-tiles": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-value": {
                                            "variable": "$.get-tiles.out.value",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-value}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1408,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-list-dashboards": [
                        "out"
                    ],
                    "assert-get-dashboard": [
                        "out"
                    ],
                    "assert-get-tiles": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 60
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1600,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64cb41824421780007381f86",
                    "failedStoreId": "64cb41969751560007caf0bf"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E MSPowerBI - Dashboards",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
