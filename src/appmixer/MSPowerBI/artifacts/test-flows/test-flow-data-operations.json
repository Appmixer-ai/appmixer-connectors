{
    "name": "E2E MSPowerBI - Data Operations",
    "description": "End-to-end test for MSPowerBI connector - tests data operations: ExecuteQueries, RefreshDataset, ExportReport. NOTE: Set datasetId and reportId variables to real IDs before running.",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "datasetId",
                                                "text": "SET_ME"
                                            },
                                            {
                                                "type": "text",
                                                "name": "reportId",
                                                "text": "SET_ME"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "execute-queries": {
            "type": "appmixer.MSPowerBI.core.ExecuteQueries",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-dataset-id": {
                                            "variable": "$.set-variables.out.datasetId",
                                            "functions": []
                                        }
                                    },
                                    "query": {}
                                },
                                "lambda": {
                                    "datasetId": "{{{var-dataset-id}}}",
                                    "query": "EVALUATE ROW(\"TestValue\", 1)"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-execute-queries": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "execute-queries": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "execute-queries": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-results": {
                                            "variable": "$.execute-queries.out.results",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-results}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "refresh-dataset": {
            "type": "appmixer.MSPowerBI.core.RefreshDataset",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-dataset-id": {
                                            "variable": "$.set-variables.out.datasetId",
                                            "functions": []
                                        }
                                    },
                                    "notifyOption": {}
                                },
                                "lambda": {
                                    "datasetId": "{{{var-dataset-id}}}",
                                    "notifyOption": "NoNotification"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-refresh-dataset": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "refresh-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "refresh-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-status": {
                                            "variable": "$.refresh-dataset.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-status}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "export-report": {
            "type": "appmixer.MSPowerBI.core.ExportReport",
            "x": 640,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "reportId": {
                                        "var-report-id": {
                                            "variable": "$.set-variables.out.reportId",
                                            "functions": []
                                        }
                                    },
                                    "format": {}
                                },
                                "lambda": {
                                    "reportId": "{{{var-report-id}}}",
                                    "format": "PDF"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-export-report": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "export-report": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "export-report": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.export-report.out.id",
                                            "functions": []
                                        },
                                        "field-status": {
                                            "variable": "$.export-report.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-status}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-execute-queries": [
                        "out"
                    ],
                    "assert-refresh-dataset": [
                        "out"
                    ],
                    "assert-export-report": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 120
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64cb41824421780007381f86",
                    "failedStoreId": "64cb41969751560007caf0bf"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E MSPowerBI - Data Operations",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
