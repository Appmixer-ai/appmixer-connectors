{
    "name": "appmixer.fireflies.core.ShareMeeting",
    "label": "Share Meeting",
    "description": "Share a Fireflies meeting transcript with one or more email addresses. Rate limited by Fireflies to 10 requests per hour and up to 50 emails per call.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" },
                    "emails": { "type": "string" },
                    "expiry": { "type": "integer" }
                },
                "required": ["transcriptId", "emails"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 1,
                        "label": "Transcript ID",
                        "tooltip": "The ID of the transcript/meeting to share."
                    },
                    "emails": {
                        "type": "text",
                        "index": 2,
                        "label": "Emails",
                        "tooltip": "Comma-separated list of email addresses to share the meeting with (max 50)."
                    },
                    "expiry": {
                        "type": "select",
                        "index": 3,
                        "label": "Expiry (days)",
                        "tooltip": "How long the shared access remains valid.",
                        "options": [
                            { "label": "7 days", "value": 7 },
                            { "label": "14 days", "value": 14 },
                            { "label": "30 days", "value": 30 }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "title": "Success", "example": true }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
