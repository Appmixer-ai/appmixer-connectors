{
    "name": "appmixer.fireflies.core.NewTranscript",
    "label": "New Transcript",
    "description": "Triggers when a new meeting transcript becomes available in your Fireflies account (polling). Note Fireflies' restrictive rate limits: Free 50 requests/day, Pro 500 requests/day. Keep the polling interval conservative.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Transcript ID", "example": "01HXY2ZK9QF3M4N5P6Q7R8S9T" },
                    "title": { "type": "string", "title": "Title", "example": "Weekly Sync — Product" },
                    "host_email": { "type": "string", "title": "Host Email", "example": "host@example.com" },
                    "organizer_email": { "type": "string", "title": "Organizer Email", "example": "organizer@example.com" },
                    "transcript_url": { "type": "string", "title": "Transcript URL", "example": "https://app.fireflies.ai/view/01HXY2ZK9QF3M4N5P6Q7R8S9T" },
                    "meeting_link": { "type": "string", "title": "Meeting Link", "example": "https://zoom.us/j/123456789" },
                    "duration": { "type": "number", "title": "Duration (minutes)", "example": 32.5 },
                    "dateString": { "type": "string", "format": "date-time", "title": "Date", "example": "2026-08-01T14:00:00.000Z" },
                    "date": { "type": "number", "title": "Date (epoch ms)", "example": 1754056800000 },
                    "participants": {
                        "type": "array",
                        "title": "Participants",
                        "items": { "type": "string" },
                        "example": ["organizer@example.com", "guest@example.com"]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
