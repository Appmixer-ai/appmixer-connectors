{
    "name": "appmixer.fireflies.core.UpdateMeetingTitle",
    "label": "Update Meeting Title",
    "description": "Rename a Fireflies meeting/transcript.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" },
                    "title": { "type": "string" }
                },
                "required": ["transcriptId", "title"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 1,
                        "label": "Transcript ID",
                        "tooltip": "The ID of the transcript/meeting to rename."
                    },
                    "title": {
                        "type": "text",
                        "index": 2,
                        "label": "Title",
                        "tooltip": "The new title for the meeting."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
