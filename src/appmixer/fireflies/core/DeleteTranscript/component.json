{
    "name": "appmixer.fireflies.core.DeleteTranscript",
    "label": "Delete Transcript",
    "description": "Permanently delete a Fireflies meeting transcript by its ID. This action is irreversible. Rate limited by Fireflies to 10 requests per minute.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" }
                },
                "required": ["transcriptId"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 0,
                        "label": "Transcript ID",
                        "tooltip": "The ID of the transcript to permanently delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
