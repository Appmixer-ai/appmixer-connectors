{
    "name": "appmixer.fireflies.core.CreateBite",
    "label": "Create Soundbite",
    "description": "Create a soundbite (highlight clip) from a section of a Fireflies transcript using start and end offsets in seconds.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" },
                    "start": { "type": "number" },
                    "end": { "type": "number" },
                    "name": { "type": "string" }
                },
                "required": ["transcriptId", "start", "end"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 1,
                        "label": "Transcript ID",
                        "tooltip": "The ID of the transcript to create a soundbite from."
                    },
                    "start": {
                        "type": "number",
                        "index": 2,
                        "label": "Start (seconds)",
                        "tooltip": "Start offset of the soundbite in seconds."
                    },
                    "end": {
                        "type": "number",
                        "index": 3,
                        "label": "End (seconds)",
                        "tooltip": "End offset of the soundbite in seconds."
                    },
                    "name": {
                        "type": "text",
                        "index": 4,
                        "label": "Name",
                        "tooltip": "Optional name/title for the soundbite."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "string", "title": "Soundbite ID", "example": "01HXY3AB4CD5EF6GH7JK8MN9PQ" },
                    "name": { "type": "string", "title": "Name", "example": "Key decision" },
                    "status": { "type": "string", "title": "Status", "example": "processing" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
