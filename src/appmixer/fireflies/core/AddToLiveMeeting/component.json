{
    "name": "appmixer.fireflies.core.AddToLiveMeeting",
    "label": "Add To Live Meeting",
    "description": "Send the Fireflies notetaker bot to join and record a live meeting (Zoom, Google Meet, Teams, Webex). Rate limited by Fireflies to 3 requests per 20 minutes.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:fireflies"
    },
    "quota": {
        "manager": "appmixer:fireflies",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "meetingLink": { "type": "string" },
                    "title": { "type": "string" },
                    "password": { "type": "string" },
                    "duration": { "type": "integer" },
                    "language": { "type": "string" }
                },
                "required": ["meetingLink"]
            },
            "inspector": {
                "inputs": {
                    "meetingLink": {
                        "type": "text",
                        "index": 1,
                        "label": "Meeting Link",
                        "tooltip": "URL of the live meeting the bot should join."
                    },
                    "title": {
                        "type": "text",
                        "index": 2,
                        "label": "Title",
                        "tooltip": "Optional title for the meeting."
                    },
                    "password": {
                        "type": "text",
                        "index": 3,
                        "label": "Password",
                        "tooltip": "Optional meeting password/passcode if required to join."
                    },
                    "duration": {
                        "type": "number",
                        "index": 4,
                        "label": "Duration (minutes)",
                        "tooltip": "Optional maximum time in minutes the bot should stay in the meeting."
                    },
                    "language": {
                        "type": "text",
                        "index": 5,
                        "label": "Language",
                        "tooltip": "Optional language code for transcription (e.g. 'en')."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "success": { "type": "boolean", "title": "Success", "example": true }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
