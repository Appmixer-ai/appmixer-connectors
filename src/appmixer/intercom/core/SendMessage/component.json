{
    "name": "appmixer.intercom.core.SendMessage",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a targeted message (such as an in-app or email message) to a contact.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:intercom"
    },
    "quota": {
        "manager": "appmixer:intercom",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "recipient_id": {
                        "type": "string"
                    },
                    "message_type": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "recipient_id": {
                        "type": "text",
                        "tooltip": "The unique identifier of the contact to whom the message is sent",
                        "label": "Recipient Id",
                        "index": 0
                    },
                    "message_type": {
                        "type": "text",
                        "tooltip": "Type of the message (e.g., inapp, email)",
                        "label": "Message Type",
                        "index": 1
                    },
                    "body": {
                        "type": "text",
                        "tooltip": "The content of the message",
                        "label": "Body",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Message Type",
                    "value": "message_type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Body",
                    "value": "body",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Recipient",
                    "value": "recipient",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Recipient.Id"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}