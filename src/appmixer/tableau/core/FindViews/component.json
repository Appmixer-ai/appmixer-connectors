{
    "name": "appmixer.tableau.core.FindViews",
    "label": "Find Views",
    "description": "Find views (sheets and dashboards) on the site by name, workbook, project, tag or last update. Returns up to 1000 views the connected user can see; without filters it returns all of them.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "workbookName": {
                        "type": "string"
                    },
                    "projectName": {
                        "type": "string"
                    },
                    "tag": {
                        "type": "string"
                    },
                    "updatedAfter": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Exact view name."
                    },
                    "workbookName": {
                        "type": "text",
                        "index": 2,
                        "label": "Workbook Name",
                        "tooltip": "Exact name of the workbook the view belongs to."
                    },
                    "projectName": {
                        "type": "text",
                        "index": 3,
                        "label": "Project Name",
                        "tooltip": "Exact name of the project the view is in."
                    },
                    "tag": {
                        "type": "text",
                        "index": 4,
                        "label": "Tag",
                        "tooltip": "Return views that have this tag."
                    },
                    "updatedAfter": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Updated After",
                        "tooltip": "Return views updated at or after this time."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/tableau/core/FindViews?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
