{
    "name": "appmixer.tableau.core.RunExtractRefreshTask",
    "label": "Run Extract Refresh Task",
    "description": "Run a scheduled extract refresh task now. The component waits until Tableau finishes the job (it checks once a minute) and then outputs the job: check Status (Success, Failed or Cancelled). Requires the owner of the content, its project leader or a site administrator.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "string"
                    },
                    "timeout": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 120
                    }
                },
                "required": [
                    "taskId"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "type": "text",
                        "index": 1,
                        "label": "Task ID",
                        "tooltip": "The ID of the extract refresh task. Use List Extract Refresh Tasks to get it."
                    },
                    "timeout": {
                        "type": "number",
                        "index": 2,
                        "label": "Timeout (minutes)",
                        "tooltip": "How long to wait for the job to finish before the component fails. A single Tableau Cloud refresh is stopped after 120 minutes. Default: 120.",
                        "defaultValue": 120
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "RefreshExtract"
                    },
                    "mode": {
                        "type": "string",
                        "title": "Mode",
                        "example": "Asynchronous"
                    },
                    "progress": {
                        "type": "integer",
                        "title": "Progress",
                        "example": 100
                    },
                    "finishCode": {
                        "type": "integer",
                        "title": "Finish Code",
                        "example": 0
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "Success"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-17T10:00:00Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-17T10:03:10Z"
                    },
                    "completedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Completed At",
                        "example": "2026-11-17T10:03:10Z"
                    },
                    "workbookId": {
                        "type": "string",
                        "title": "Workbook ID",
                        "example": "5a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
                    },
                    "workbookName": {
                        "type": "string",
                        "title": "Workbook Name",
                        "example": "Sales Overview"
                    },
                    "datasourceId": {
                        "type": "string",
                        "title": "Data Source ID",
                        "example": "3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f"
                    },
                    "datasourceName": {
                        "type": "string",
                        "title": "Data Source Name",
                        "example": "Superstore Orders"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Finished refresh of extracts (new extract) for Workbook 'Sales Overview'"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
