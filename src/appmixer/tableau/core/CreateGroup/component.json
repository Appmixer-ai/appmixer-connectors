{
    "name": "appmixer.tableau.core.CreateGroup",
    "label": "Create Group",
    "description": "Create a local group on the site. Requires a site administrator account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "The name of the new group."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Group ID",
                        "example": "7d6c5b4a-3f2e-4d1c-8b0a-9f8e7d6c5b4a"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Analysts"
                    },
                    "domainName": {
                        "type": "string",
                        "title": "Domain Name",
                        "example": "local"
                    },
                    "minimumSiteRole": {
                        "type": "string",
                        "title": "Minimum Site Role",
                        "example": "Explorer"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
