{
    "name": "appmixer.tableau.core.GetViewCrosstab",
    "label": "Get View Crosstab",
    "description": "Export the crosstab of a view as an Excel (.xlsx) file. A dashboard returns the crosstab of its first sheet only.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "viewId": {
                        "type": "string"
                    },
                    "viewFilters": {
                        "type": "string"
                    },
                    "maxAge": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "viewId"
                ]
            },
            "inspector": {
                "inputs": {
                    "viewId": {
                        "type": "text",
                        "index": 1,
                        "label": "View ID",
                        "tooltip": "The ID of the view. Use Find Views to get it."
                    },
                    "viewFilters": {
                        "type": "key-value",
                        "index": 2,
                        "label": "View Filters",
                        "tooltip": "Filter the view by fields of its data: the field name (e.g. Region) and the value (e.g. West). Several values of one field are separated by commas. Names and values must match the data exactly.",
                        "keyLabel": "Field",
                        "valueLabel": "Value",
                        "addLabel": "Add filter",
                        "removeLabel": "Remove filter"
                    },
                    "maxAge": {
                        "type": "number",
                        "index": 3,
                        "label": "Max Age (minutes)",
                        "tooltip": "Tableau caches exports. Return a cached export only when it is at most this many minutes old. Minimum 1."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 4,
                        "label": "File Name",
                        "tooltip": "The name of the file to save, e.g. sales.xlsx. Default: generated from the ID."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "fileId",
                    "fileName",
                    "fileSize"
                ],
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File ID",
                        "example": "6f5e4d3c-2b1a-4098-8f7e-6d5c4b3a2918"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "view-sales-by-region.png"
                    },
                    "fileSize": {
                        "type": "integer",
                        "title": "File Size (bytes)",
                        "example": 48213
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
