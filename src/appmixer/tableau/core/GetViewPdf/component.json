{
    "name": "appmixer.tableau.core.GetViewPdf",
    "label": "Get View PDF",
    "description": "Export a view as a PDF file.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "viewId": {
                        "type": "string"
                    },
                    "pageType": {
                        "type": "string"
                    },
                    "orientation": {
                        "type": "string"
                    },
                    "viewFilters": {
                        "type": "string"
                    },
                    "maxAge": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "viewId"
                ]
            },
            "inspector": {
                "inputs": {
                    "viewId": {
                        "type": "text",
                        "index": 1,
                        "label": "View ID",
                        "tooltip": "The ID of the view. Use Find Views to get it."
                    },
                    "pageType": {
                        "type": "select",
                        "index": 2,
                        "label": "Page Type",
                        "tooltip": "The page size of the PDF. Default: Legal.",
                        "options": [
                            {
                                "label": "A3",
                                "value": "A3"
                            },
                            {
                                "label": "A4",
                                "value": "A4"
                            },
                            {
                                "label": "A5",
                                "value": "A5"
                            },
                            {
                                "label": "B5",
                                "value": "B5"
                            },
                            {
                                "label": "Executive",
                                "value": "Executive"
                            },
                            {
                                "label": "Folio",
                                "value": "Folio"
                            },
                            {
                                "label": "Ledger",
                                "value": "Ledger"
                            },
                            {
                                "label": "Legal",
                                "value": "Legal"
                            },
                            {
                                "label": "Letter",
                                "value": "Letter"
                            },
                            {
                                "label": "Note",
                                "value": "Note"
                            },
                            {
                                "label": "Quarto",
                                "value": "Quarto"
                            },
                            {
                                "label": "Tabloid",
                                "value": "Tabloid"
                            }
                        ]
                    },
                    "orientation": {
                        "type": "select",
                        "index": 3,
                        "label": "Orientation",
                        "tooltip": "Default: Portrait.",
                        "options": [
                            {
                                "label": "Portrait",
                                "value": "Portrait"
                            },
                            {
                                "label": "Landscape",
                                "value": "Landscape"
                            }
                        ]
                    },
                    "viewFilters": {
                        "type": "key-value",
                        "index": 4,
                        "label": "View Filters",
                        "tooltip": "Filter the view by fields of its data: the field name (e.g. Region) and the value (e.g. West). Several values of one field are separated by commas. Names and values must match the data exactly.",
                        "keyLabel": "Field",
                        "valueLabel": "Value",
                        "addLabel": "Add filter",
                        "removeLabel": "Remove filter"
                    },
                    "maxAge": {
                        "type": "number",
                        "index": 5,
                        "label": "Max Age (minutes)",
                        "tooltip": "Tableau caches exports. Return a cached export only when it is at most this many minutes old. Minimum 1."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 6,
                        "label": "File Name",
                        "tooltip": "The name of the file to save, e.g. sales.pdf. Default: generated from the ID."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "fileId",
                    "fileName",
                    "fileSize"
                ],
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File ID",
                        "example": "6f5e4d3c-2b1a-4098-8f7e-6d5c4b3a2918"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "view-sales-by-region.png"
                    },
                    "fileSize": {
                        "type": "integer",
                        "title": "File Size (bytes)",
                        "example": 48213
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
