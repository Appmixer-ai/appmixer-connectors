{
    "name": "appmixer.tableau.core.JobFinished",
    "label": "Job Finished",
    "description": "Triggers when a background job of the site finishes: an extract refresh (also one started by a schedule or in the Tableau UI), a flow run, a subscription. Checks the jobs created in the last 24 hours. Works without a site administrator account, but a non-administrator sees only the jobs of their own content.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "tick": true,
    "trigger": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "jobType": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "jobType": {
                    "type": "select",
                    "index": 1,
                    "label": "Job Type",
                    "tooltip": "Trigger only for jobs of this type. Empty: all types.",
                    "options": [
                        {
                            "label": "Extract refresh (full)",
                            "value": "refresh_extracts"
                        },
                        {
                            "label": "Extract refresh (incremental)",
                            "value": "increment_extracts"
                        },
                        {
                            "label": "Flow run",
                            "value": "run_flow"
                        }
                    ]
                },
                "status": {
                    "type": "select",
                    "index": 2,
                    "label": "Status",
                    "tooltip": "Trigger only for jobs that finished with this status. Empty: any finished job.",
                    "options": [
                        {
                            "label": "Success",
                            "value": "Success"
                        },
                        {
                            "label": "Failed",
                            "value": "Failed"
                        },
                        {
                            "label": "Cancelled",
                            "value": "Cancelled"
                        }
                    ]
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e"
                    },
                    "jobType": {
                        "type": "string",
                        "title": "Job Type",
                        "example": "refresh_extracts"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "Success"
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 50
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Sales Overview"
                    },
                    "subtitle": {
                        "type": "string",
                        "title": "Subtitle",
                        "example": "Workbook"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-11-17T10:00:00Z"
                    },
                    "startedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Started At",
                        "example": "2026-11-17T10:00:05Z"
                    },
                    "endedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Ended At",
                        "example": "2026-11-17T10:03:10Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
