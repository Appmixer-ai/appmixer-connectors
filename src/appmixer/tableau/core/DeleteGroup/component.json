{
    "name": "appmixer.tableau.core.DeleteGroup",
    "label": "Delete Group",
    "description": "Delete a group from the site. The users of the group stay on the site. Requires a site administrator account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "groupId": {
                        "type": "string"
                    }
                },
                "required": [
                    "groupId"
                ]
            },
            "inspector": {
                "inputs": {
                    "groupId": {
                        "type": "text",
                        "index": 1,
                        "label": "Group ID",
                        "tooltip": "The ID of the group. Use Find Groups to get it."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
