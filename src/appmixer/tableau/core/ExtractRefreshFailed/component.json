{
    "name": "appmixer.tableau.core.ExtractRefreshFailed",
    "label": "Extract Refresh Failed",
    "description": "Triggers when an extract refresh of a workbook or a data source fails. The output carries the IDs and the name of the workbook or data source; use Get Workbook or Get Data Source for details. Registers a Tableau webhook while the flow runs, which requires a site administrator account. Tableau does not sign webhook requests; the trigger accepts only events of the connected site.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "webhook": true,
    "trigger": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "contentType": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "contentType": {
                    "type": "select",
                    "index": 1,
                    "label": "Content Type",
                    "defaultValue": "all",
                    "tooltip": "Trigger for workbook extracts, data source extracts, or both.",
                    "options": [
                        {
                            "label": "Workbooks and data sources",
                            "value": "all"
                        },
                        {
                            "label": "Workbooks",
                            "value": "workbook"
                        },
                        {
                            "label": "Data sources",
                            "value": "datasource"
                        }
                    ]
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "eventType",
                    "resourceId"
                ],
                "properties": {
                    "eventType": {
                        "type": "string",
                        "title": "Event Type",
                        "example": "WorkbookRefreshFailed"
                    },
                    "resource": {
                        "type": "string",
                        "title": "Resource",
                        "example": "WORKBOOK"
                    },
                    "resourceId": {
                        "type": "string",
                        "title": "Resource ID",
                        "example": "5a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
                    },
                    "resourceName": {
                        "type": "string",
                        "title": "Resource Name",
                        "example": "Sales Overview"
                    },
                    "siteId": {
                        "type": "string",
                        "title": "Site ID",
                        "example": "a946d998-2ead-4894-bb50-1054a91dcab3"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Event Created At",
                        "example": "2026-11-17T10:03:10Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
