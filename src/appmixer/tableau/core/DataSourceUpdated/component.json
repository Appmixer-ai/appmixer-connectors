{
    "name": "appmixer.tableau.core.DataSourceUpdated",
    "label": "Data Source Updated",
    "description": "Triggers when a data source is updated (republished or its properties changed). Registers a Tableau webhook while the flow runs, which requires a site administrator account. Tableau does not sign webhook requests; the trigger accepts only events of the connected site.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "webhook": true,
    "trigger": true,
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "eventType"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Data Source ID",
                        "example": "3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Superstore Orders"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Orders extract refreshed nightly"
                    },
                    "contentUrl": {
                        "type": "string",
                        "title": "Content URL",
                        "example": "SuperstoreOrders"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "hyper"
                    },
                    "webpageUrl": {
                        "type": "string",
                        "title": "Webpage URL",
                        "example": "https://10ay.online.tableau.com/#/site/mysite/datasources/67890"
                    },
                    "isCertified": {
                        "type": "boolean",
                        "title": "Certified",
                        "example": false
                    },
                    "certificationNote": {
                        "type": "string",
                        "title": "Certification Note",
                        "example": "Approved by the BI team"
                    },
                    "hasExtracts": {
                        "type": "boolean",
                        "title": "Has Extracts",
                        "example": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-10-01T09:30:00Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-11-02T14:05:00Z"
                    },
                    "projectId": {
                        "type": "string",
                        "title": "Project ID",
                        "example": "1f2e3d4c-5b6a-4978-8a9b-0c1d2e3f4a5b"
                    },
                    "projectName": {
                        "type": "string",
                        "title": "Project Name",
                        "example": "Default"
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b"
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "finance"
                        ]
                    },
                    "eventType": {
                        "type": "string",
                        "title": "Event Type",
                        "example": "DatasourceUpdated"
                    },
                    "eventCreatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Event Created At",
                        "example": "2026-11-17T10:03:10Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
