{
    "name": "appmixer.tableau.core.UpdateUser",
    "label": "Update User",
    "description": "Change the site role of a user. Requires a site administrator account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string"
                    },
                    "siteRole": {
                        "type": "string"
                    }
                },
                "required": [
                    "userId",
                    "siteRole"
                ]
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "text",
                        "index": 1,
                        "label": "User ID",
                        "tooltip": "The ID of the user. Use Find Users to get it."
                    },
                    "siteRole": {
                        "type": "select",
                        "index": 2,
                        "label": "Site Role",
                        "tooltip": "The new site role of the user.",
                        "options": [
                            {
                                "label": "Creator",
                                "value": "Creator"
                            },
                            {
                                "label": "Explorer",
                                "value": "Explorer"
                            },
                            {
                                "label": "ExplorerCanPublish",
                                "value": "ExplorerCanPublish"
                            },
                            {
                                "label": "SiteAdministratorExplorer",
                                "value": "SiteAdministratorExplorer"
                            },
                            {
                                "label": "SiteAdministratorCreator",
                                "value": "SiteAdministratorCreator"
                            },
                            {
                                "label": "Viewer",
                                "value": "Viewer"
                            },
                            {
                                "label": "Unlicensed",
                                "value": "Unlicensed"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
