{
    "name": "appmixer.tableau.core.FindUsers",
    "label": "Find Users",
    "description": "Find users of the site by name, site role or last sign-in. Returns up to 1000 users; without filters it returns all of them. Requires a site administrator account to see other users.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:tableau"
    },
    "quota": {
        "manager": "appmixer:tableau",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "siteRole": {
                        "type": "string"
                    },
                    "lastLoginAfter": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Name",
                        "tooltip": "Exact user name (on Tableau Cloud the email address)."
                    },
                    "siteRole": {
                        "type": "select",
                        "index": 2,
                        "label": "Site Role",
                        "tooltip": "Return users with this site role.",
                        "options": [
                            {
                                "label": "Creator",
                                "value": "Creator"
                            },
                            {
                                "label": "Explorer",
                                "value": "Explorer"
                            },
                            {
                                "label": "ExplorerCanPublish",
                                "value": "ExplorerCanPublish"
                            },
                            {
                                "label": "SiteAdministratorExplorer",
                                "value": "SiteAdministratorExplorer"
                            },
                            {
                                "label": "SiteAdministratorCreator",
                                "value": "SiteAdministratorCreator"
                            },
                            {
                                "label": "Viewer",
                                "value": "Viewer"
                            },
                            {
                                "label": "Unlicensed",
                                "value": "Unlicensed"
                            }
                        ]
                    },
                    "lastLoginAfter": {
                        "type": "date-time",
                        "index": 3,
                        "label": "Last Sign-In After",
                        "tooltip": "Return users who signed in at or after this time."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 4,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/tableau/core/FindUsers?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
