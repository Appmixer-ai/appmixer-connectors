{
    "name": "appmixer.vercel.teams.UpdateTeam",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update the details of an existing team, such as name, description, avatar, and configuration settings.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vercel"
    },
    "quota": {
        "manager": "appmixer:vercel",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "example": "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                    },
                    "avatar": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 140
                    },
                    "emailDomain": {
                        "type": "string",
                        "example": "example.com"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "previewDeploymentSuffix": {
                        "type": "string",
                        "example": "example.dev"
                    },
                    "regenerateInviteCode": {
                        "type": "boolean"
                    },
                    "saml": {
                        "type": "object",
                        "properties": {
                            "enforced": {
                                "type": "boolean"
                            }
                        }
                    },
                    "slug": {
                        "type": "string",
                        "example": "my-team"
                    },
                    "enablePreviewFeedback": {
                        "type": "string",
                        "example": "on"
                    },
                    "enableProductionFeedback": {
                        "type": "string",
                        "example": "on"
                    },
                    "sensitiveEnvironmentVariablePolicy": {
                        "type": "string",
                        "example": "on"
                    },
                    "remoteCaching": {
                        "type": "object",
                        "properties": {
                            "enabled": {
                                "type": "boolean"
                            }
                        }
                    },
                    "hideIpAddresses": {
                        "type": "boolean"
                    },
                    "hideIpAddressesInLogDrains": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "tooltip": "The unique team identifier",
                        "label": "Team Id",
                        "index": 0
                    },
                    "avatar": {
                        "type": "text",
                        "tooltip": "Hash of an uploaded image used as the team avatar",
                        "label": "Avatar",
                        "index": 1
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "A short description of the team",
                        "label": "Description",
                        "index": 2
                    },
                    "emailDomain": {
                        "type": "text",
                        "tooltip": "Email domain for automatic team membership",
                        "label": "Email Domain",
                        "index": 3
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "The team name",
                        "label": "Name",
                        "index": 4
                    },
                    "previewDeploymentSuffix": {
                        "type": "text",
                        "tooltip": "Suffix for preview deployments",
                        "label": "Preview Deployment Suffix",
                        "index": 5
                    },
                    "regenerateInviteCode": {
                        "type": "toggle",
                        "tooltip": "Flag to generate a new team invite code",
                        "label": "Regenerate Invite Code",
                        "index": 6
                    },
                    "saml|enforced": {
                        "type": "toggle",
                        "tooltip": "Require SAML SSO for team interactions",
                        "label": "Saml|enforced",
                        "index": 7
                    },
                    "slug": {
                        "type": "text",
                        "tooltip": "A new team slug",
                        "label": "Slug",
                        "index": 8
                    },
                    "enablePreviewFeedback": {
                        "type": "text",
                        "tooltip": "Enable preview deployment feedback (on, off, default)",
                        "label": "Enable Preview Feedback",
                        "index": 9
                    },
                    "enableProductionFeedback": {
                        "type": "text",
                        "tooltip": "Enable production deployment feedback (on, off, default)",
                        "label": "Enable Production Feedback",
                        "index": 10
                    },
                    "sensitiveEnvironmentVariablePolicy": {
                        "type": "text",
                        "tooltip": "Policy for sensitive environment variables (on, off, default)",
                        "label": "Sensitive Environment Variable Policy",
                        "index": 11
                    },
                    "remoteCaching|enabled": {
                        "type": "toggle",
                        "tooltip": "Enable or disable remote caching",
                        "label": "Remote Caching|enabled",
                        "index": 12
                    },
                    "hideIpAddresses": {
                        "type": "toggle",
                        "tooltip": "Whether to hide IP addresses in monitoring queries",
                        "label": "Hide Ip Addresses",
                        "index": 13
                    },
                    "hideIpAddressesInLogDrains": {
                        "type": "toggle",
                        "tooltip": "Whether to hide IP addresses in log drain outputs",
                        "label": "Hide Ip Addresses In Log Drains",
                        "index": 14
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Avatar",
                    "value": "avatar",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTE1NSIgaGVpZ2h0PSIxMDAwIiB2aWV3Qm94PSIwIDAgMTE1NSAxMDAwIiBmaWxsPSJub25lIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNNTc3LjM0NCAwTDExNTQuNjkgMTAwMEgwTDU3Ny4zNDQgMFoiIGZpbGw9ImJsYWNrIi8+Cjwvc3ZnPgo="
}
