{
    "name": "appmixer.vercel.teams.InviteUsertoTeam",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Invite a user to join a team using their user ID or email. The action requires team owner privileges.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vercel"
    },
    "quota": {
        "manager": "appmixer:vercel",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "example": "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                    },
                    "uid": {
                        "type": "string",
                        "example": "kr1PsOIzqEL5Xg6M4VZcZosf"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "role": {
                        "type": "string",
                        "default": "MEMBER"
                    },
                    "projects|projectId": {
                        "type": "string",
                        "example": "prj_ndlgr43fadlPyCtREAqxxdyFK"
                    },
                    "projects|role": {
                        "type": "string",
                        "example": "ADMIN"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "tooltip": "The unique team identifier",
                        "label": "Team Id",
                        "index": 0
                    },
                    "uid": {
                        "type": "text",
                        "tooltip": "The ID of the user to invite",
                        "label": "Uid",
                        "index": 1
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "The email address of the user to invite",
                        "label": "Email",
                        "index": 2
                    },
                    "role": {
                        "type": "select",
                        "tooltip": "The role for the invited user",
                        "label": "Role",
                        "options": [
                            {
                                "label": "OWNER",
                                "value": "OWNER"
                            },
                            {
                                "label": "MEMBER",
                                "value": "MEMBER"
                            },
                            {
                                "label": "DEVELOPER",
                                "value": "DEVELOPER"
                            },
                            {
                                "label": "SECURITY",
                                "value": "SECURITY"
                            },
                            {
                                "label": "BILLING",
                                "value": "BILLING"
                            },
                            {
                                "label": "VIEWER",
                                "value": "VIEWER"
                            },
                            {
                                "label": "CONTRIBUTOR",
                                "value": "CONTRIBUTOR"
                            }
                        ],
                        "index": 3
                    },
                    "projects|projectId": {
                        "type": "text",
                        "tooltip": "The ID of the project",
                        "label": "Projects|project Id",
                        "index": 4
                    },
                    "projects|role": {
                        "type": "select",
                        "tooltip": "Project role for the invited user",
                        "label": "Projects|role",
                        "options": [
                            {
                                "label": "ADMIN",
                                "value": "ADMIN"
                            },
                            {
                                "label": "PROJECT_DEVELOPER",
                                "value": "PROJECT_DEVELOPER"
                            },
                            {
                                "label": "PROJECT_VIEWER",
                                "value": "PROJECT_VIEWER"
                            }
                        ],
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Uid",
                    "value": "uid",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Username",
                    "value": "username",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Role",
                    "value": "role",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Team Roles",
                    "value": "teamRoles",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Team Permissions",
                    "value": "teamPermissions",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTE1NSIgaGVpZ2h0PSIxMDAwIiB2aWV3Qm94PSIwIDAgMTE1NSAxMDAwIiBmaWxsPSJub25lIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNNTc3LjM0NCAwTDExNTQuNjkgMTAwMEgwTDU3Ny4zNDQgMFoiIGZpbGw9ImJsYWNrIi8+Cjwvc3ZnPgo="
}
