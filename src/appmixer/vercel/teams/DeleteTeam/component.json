{
    "name": "appmixer.vercel.teams.DeleteTeam",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Delete an existing team. Optionally specify a new default team ID and reasons for deletion.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vercel"
    },
    "quota": {
        "manager": "appmixer:vercel",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "example": "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                    },
                    "newDefaultTeamId": {
                        "type": "string",
                        "example": "team_LLHUOMOoDlqOp8wPE4kFo9pE"
                    },
                    "slug": {
                        "type": "string",
                        "example": "my-team-url-slug"
                    },
                    "reasons": {
                        "type": "object",
                        "properties": {
                            "slug": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "tooltip": "The identifier of the team to delete",
                        "label": "Team Id",
                        "index": 0
                    },
                    "newDefaultTeamId": {
                        "type": "text",
                        "tooltip": "Optional: New default team ID if applicable",
                        "label": "New Default Team Id",
                        "index": 1
                    },
                    "slug": {
                        "type": "text",
                        "tooltip": "Team slug",
                        "label": "Slug",
                        "index": 2
                    },
                    "reasons|slug": {
                        "type": "text",
                        "tooltip": "Identifier slug for the deletion reason",
                        "label": "Reasons|slug",
                        "index": 3
                    },
                    "reasons|description": {
                        "type": "text",
                        "tooltip": "Description explaining why the team is being deleted",
                        "label": "Reasons|description",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "New Default Team Id Error",
                    "value": "newDefaultTeamIdError",
                    "schema": {
                        "type": "boolean"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTE1NSIgaGVpZ2h0PSIxMDAwIiB2aWV3Qm94PSIwIDAgMTE1NSAxMDAwIiBmaWxsPSJub25lIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNNTc3LjM0NCAwTDExNTQuNjkgMTAwMEgwTDU3Ny4zNDQgMFoiIGZpbGw9ImJsYWNrIi8+Cjwvc3ZnPgo="
}
