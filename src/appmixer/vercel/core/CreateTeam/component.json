{
    "name": "appmixer.vercel.core.CreateTeam",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new team under your account. Provide a unique team slug and an optional name.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vercel"
    },
    "quota": {
        "manager": "appmixer:vercel",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string",
                        "maxLength": 48,
                        "example": "a-random-team"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 256,
                        "example": "A Random Team"
                    },
                    "attribution|sessionReferrer": {
                        "type": "string"
                    },
                    "attribution|landingPage": {
                        "type": "string"
                    },
                    "attribution|pageBeforeConversionPage": {
                        "type": "string"
                    },
                    "attribution|utm|utmSource": {
                        "type": "string"
                    },
                    "attribution|utm|utmMedium": {
                        "type": "string"
                    },
                    "attribution|utm|utmCampaign": {
                        "type": "string"
                    },
                    "attribution|utm|utmTerm": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "slug": {
                        "type": "text",
                        "tooltip": "Desired slug for the team",
                        "label": "Slug",
                        "index": 0
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "Desired team name",
                        "label": "Name",
                        "index": 1
                    },
                    "attribution|sessionReferrer": {
                        "type": "text",
                        "tooltip": "Session referrer",
                        "label": "Attribution|session Referrer",
                        "index": 2
                    },
                    "attribution|landingPage": {
                        "type": "text",
                        "tooltip": "Landing page URL",
                        "label": "Attribution|landing Page",
                        "index": 3
                    },
                    "attribution|pageBeforeConversionPage": {
                        "type": "text",
                        "tooltip": "Referrer page before conversion",
                        "label": "Attribution|page Before Conversion Page",
                        "index": 4
                    },
                    "attribution|utm|utmSource": {
                        "type": "text",
                        "tooltip": "UTM source",
                        "label": "Attribution|utm|utm Source",
                        "index": 5
                    },
                    "attribution|utm|utmMedium": {
                        "type": "text",
                        "tooltip": "UTM medium",
                        "label": "Attribution|utm|utm Medium",
                        "index": 6
                    },
                    "attribution|utm|utmCampaign": {
                        "type": "text",
                        "tooltip": "UTM campaign",
                        "label": "Attribution|utm|utm Campaign",
                        "index": 7
                    },
                    "attribution|utm|utmTerm": {
                        "type": "text",
                        "tooltip": "UTM term",
                        "label": "Attribution|utm|utm Term",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Slug",
                    "value": "slug",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTE1NSIgaGVpZ2h0PSIxMDAwIiB2aWV3Qm94PSIwIDAgMTE1NSAxMDAwIiBmaWxsPSJub25lIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNNTc3LjM0NCAwTDExNTQuNjkgMTAwMEgwTDU3Ny4zNDQgMFoiIGZpbGw9ImJsYWNrIi8+Cjwvc3ZnPgo=",
    "genv2": true
}