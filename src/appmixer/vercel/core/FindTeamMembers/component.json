{
    "name": "appmixer.vercel.core.FindTeamMembers",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve team members for a specified team. Filter results using team role or search query.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:vercel"
    },
    "quota": {
        "manager": "appmixer:vercel",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "example": "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                    },
                    "role": {
                        "type": "string"
                    },
                    "search": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "teamId": {
                        "type": "text",
                        "tooltip": "The unique team identifier",
                        "label": "Team Id",
                        "index": 0
                    },
                    "role": {
                        "type": "select",
                        "tooltip": "Filter members by their team role",
                        "label": "Role",
                        "options": [
                            {
                                "label": "OWNER",
                                "value": "OWNER"
                            },
                            {
                                "label": "MEMBER",
                                "value": "MEMBER"
                            },
                            {
                                "label": "DEVELOPER",
                                "value": "DEVELOPER"
                            },
                            {
                                "label": "VIEWER",
                                "value": "VIEWER"
                            },
                            {
                                "label": "BILLING",
                                "value": "BILLING"
                            },
                            {
                                "label": "CONTRIBUTOR",
                                "value": "CONTRIBUTOR"
                            }
                        ],
                        "index": 1
                    },
                    "search": {
                        "type": "text",
                        "tooltip": "Search team members by name, username, or email",
                        "label": "Search",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Members",
                    "value": "members",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "uid": {
                                    "type": "string",
                                    "title": "Members.Uid"
                                },
                                "username": {
                                    "type": "string",
                                    "title": "Members.Username"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Members.Email"
                                },
                                "role": {
                                    "type": "string",
                                    "title": "Members.Role"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTE1NSIgaGVpZ2h0PSIxMDAwIiB2aWV3Qm94PSIwIDAgMTE1NSAxMDAwIiBmaWxsPSJub25lIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPgo8cGF0aCBkPSJNNTc3LjM0NCAwTDExNTQuNjkgMTAwMEgwTDU3Ny4zNDQgMFoiIGZpbGw9ImJsYWNrIi8+Cjwvc3ZnPgo=",
    "genv2": true
}