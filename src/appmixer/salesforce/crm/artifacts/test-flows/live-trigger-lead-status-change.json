{
    "name": "LIVE Salesforce - LeadStatusChange trigger (tick test)",
    "description": "HELPER (manual live tick test, not auto-run). Verifies the LeadStatusChange trigger fires when the monitored Status field changes on a Lead: start the flow, wait ~1 tick (baseline seeds the known Status per Lead), change an existing Lead's Status in the same org, then the next tick emits the Lead -> Assert(Id & Status notEmpty). Not auto-runnable (needs the external field change between ticks).",
    "type": "automation",
    "notes": {},
    "flow": {
        "lead-status": {
            "type": "appmixer.salesforce.crm.LeadStatusChange",
            "x": 256,
            "y": 192,
            "version": "1.1.2",
            "source": {},
            "config": {
                "properties": {
                    "fieldName": "Status"
                }
            }
        },
        "assert-status": {
            "type": "appmixer.utils.test.Assert",
            "x": 448,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "lead-status": [
                        "lead"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "lead-status": {
                            "lead": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.lead-status.lead.Id",
                                            "functions": []
                                        },
                                        "field-status": {
                                            "variable": "$.lead-status.lead.Status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-status}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 640,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-status": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 300
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 832,
            "y": 192,
            "version": "1.0.1",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {
                                        "var-tc": {
                                            "functions": [
                                                {
                                                    "name": "g_flowName"
                                                }
                                            ]
                                        }
                                    },
                                    "result": {
                                        "var-res": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "{{{var-tc}}}",
                                    "result": "{{{var-res}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
