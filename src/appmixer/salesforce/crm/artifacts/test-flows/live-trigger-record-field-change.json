{
    "name": "LIVE Salesforce - RecordFieldChange trigger (tick test)",
    "description": "HELPER (manual live tick test, not auto-run). Verifies the generic RecordFieldChange trigger fires when the chosen field (StageName on Opportunity here) changes on any record of the selected object: start the flow, wait ~1 tick (baseline seeds the known StageName per Opportunity), change an existing Opportunity's StageName in the same org, then the next tick emits the record -> Assert(Id & StageName notEmpty). Not auto-runnable (needs the external field change between ticks).",
    "type": "automation",
    "notes": {},
    "flow": {
        "record-change": {
            "type": "appmixer.salesforce.crm.RecordFieldChange",
            "x": 256,
            "y": 192,
            "version": "1.1.2",
            "source": {},
            "config": {
                "properties": {
                    "objectName": "Opportunity",
                    "fieldName": "StageName"
                }
            }
        },
        "assert-change": {
            "type": "appmixer.utils.test.Assert",
            "x": 448,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "record-change": [
                        "record"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "record-change": {
                            "record": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.record-change.record.Id",
                                            "functions": []
                                        },
                                        "field-stage": {
                                            "variable": "$.record-change.record.StageName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-stage}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 640,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-change": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 300
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 832,
            "y": 192,
            "version": "1.0.1",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {
                                        "var-tc": {
                                            "functions": [
                                                {
                                                    "name": "g_flowName"
                                                }
                                            ]
                                        }
                                    },
                                    "result": {
                                        "var-res": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "{{{var-tc}}}",
                                    "result": "{{{var-res}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
