{
    "name": "appmixer.salesforce.crm.GetContactsByField",
    "author": "Appmixer <info@appmixer.ai>",
    "description": "Get all contacts related to a chosen Contact field value, for example every contact matching a specific Campaign ID, Account or custom field.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fieldName": { "type": "string" },
                    "fieldValue": { "type": "string" },
                    "outputType": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "fieldName": {
                        "type": "text",
                        "label": "Field",
                        "index": 1,
                        "tooltip": "The Contact field to filter on, for example AccountId, LeadSource or a custom field.",
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/GetObjectFields?outPort=out&ignoreAuth=true",
                            "data": {
                                "messages": {
                                    "in": {
                                        "objectName": "Contact"
                                    }
                                },
                                "transform": "./transformers#fieldsToSelectOptions"
                            }
                        }
                    },
                    "fieldValue": {
                        "type": "text",
                        "label": "Field Value",
                        "index": 2,
                        "tooltip": "The value the chosen field must equal, for example the Campaign ID or Account ID."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 3,
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file. For large datasets, streaming the items to a file is the most efficient method.",
                        "options": [
                            {
                                "content": "All items at once",
                                "value": "array"
                            },
                            {
                                "content": "One item at a time",
                                "value": "object"
                            },
                            {
                                "content": "Save items to file",
                                "value": "file"
                            }
                        ],
                        "defaultValue": "array"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/salesforce/crm/GetContactsByField?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/fieldName": "inputs/in/fieldName",
                        "in/fieldValue": "inputs/in/fieldValue",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
