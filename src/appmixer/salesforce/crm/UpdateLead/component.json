                            { "value": "Construction", "content": "Construction" },
                            { "value": "Consulting", "content": "Consulting" },
                            { "value": "Education", "content": "Education" },
                            { "value": "Electronics", "content": "Electronics" },
                            { "value": "Energy", "content": "Energy" },
