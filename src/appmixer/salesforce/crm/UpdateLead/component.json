{
    "name": "appmixer.salesforce.crm.UpdateLead",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "Update a lead in Salesforce.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "lead",
            "schema": {
                "type": "object",
                "properties": {
                    "leadId": { "type": "string" },
                    "website": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "salutation": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "firstName": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "email": {
                        "type": "string",
                        "maxLength": 80,
                        "format": "email"
                    },
                    "industry": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 40,
                        "pattern": "\\(?([0-9]{1,})\\)?([ .-]?)([0-9]{1,})\\2([0-9]{1,})$"
                    },
                    "numberOfEmployees": {
                        "type": "integer",
                        "maxLength": 40
                    },
                    "mobile": {
                        "type": "string",
                        "maxLength": 40,
                        "pattern": "\\(?([0-9]{1,})\\)?([ .-]?)([0-9]{1,})\\2([0-9]{1,})$"
                    },
                    "leadSource": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "rating": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "street": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "state": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "postalCode": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "country": {
                        "type": "string",
                        "maxLength": 80
                    }
                },
                "required": [ "leadId" ]
            },
            "inspector": {
                "inputs": {
                    "leadId": {
                        "type": "select",
                        "label": "Lead",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListLeads?outPort=leads",
                            "data": {
                                "transform": "./transformers#leadsToSelectArray"
                            }
                        },
                        "tooltip": "Select lead to update."
                    },
                    "website": {
                        "type": "text",
                        "tooltip": "Website for the lead.",
                        "label": "Website",
                        "index": 2
                    },
                    "salutation": {
                        "type": "select",
                        "options": [
                            { "value": "none", "content": "none" },
                            { "value": "Mr.", "content": "Mr." },
                            { "value": "Ms.", "content": "Ms." },
                            { "value": "Mrs.", "content": "Mrs." },
                            { "value": "Dr.", "content": "Dr." },
                            { "value": "Prof.", "content": "Prof." }
                        ],
                        "defaultValue": "none",
                        "tooltip": "Salutation for the lead.",
                        "label": "Salutation",
                        "index": 3
                    },
                    "firstName": {
                        "type": "text",
                        "tooltip": "First name of the lead.",
                        "label": "First name",
                        "index": 4
                    },
                    "title": {
                        "type": "text",
                        "tooltip": "Title for the lead, for example CFO or CEO.",
                        "label": "Title",
                        "index": 5
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "Email address for the lead.",
                        "label": "Email",
                        "index": 6
                    },
                    "industry": {
