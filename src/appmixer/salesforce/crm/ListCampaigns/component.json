{
    "name": "appmixer.salesforce.crm.ListCampaigns",
    "author": "Appmixer <info@appmixer.ai>",
    "description": "List all campaigns in Salesforce.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.1.2",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "campaigns",
            "schema": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "Id": {
                            "type": "string",
                            "title": "Campaign ID",
                            "example": "7017R000001MObMQAW"
                        },
                        "Name": {
                            "type": "string",
                            "title": "Campaign Name",
                            "example": "User Conference - Jun 17-19, 2002"
                        },
                        "IsActive": {
                            "type": "boolean",
                            "title": "Active",
                            "example": true
                        },
                        "Status": {
                            "type": "string",
                            "title": "Status",
                            "example": "Completed"
                        },
                        "Type": {
                            "type": "string",
                            "title": "Type",
                            "example": "Conference"
                        },
                        "StartDate": {
                            "type": "string",
                            "title": "Start Date",
                            "example": "2026-06-17"
                        },
                        "EndDate": {
                            "type": "string",
                            "title": "End Date",
                            "example": "2026-06-19"
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
