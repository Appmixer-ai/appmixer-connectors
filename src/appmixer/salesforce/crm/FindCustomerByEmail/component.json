{
    "name": "appmixer.salesforce.crm.FindCustomerByEmail",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Find a Salesforce Contact by email address. Returns contact details or fires the <b>notFound</b> port when no match exists.",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.0.0",
    "dependencies": {
        "service": "1.1.2"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "index": 0,
                        "label": "Email",
                        "tooltip": "The email address to search for. Case-insensitive match against the Contact Email field."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "Id",
                    "schema": {
                        "type": "string"
                    },
                    "example": "0032w00000AbCdEAAV"
                },
                {
                    "label": "FirstName",
                    "value": "FirstName",
                    "schema": {
                        "type": "string"
                    },
                    "example": "Jane"
                },
                {
                    "label": "LastName",
                    "value": "LastName",
                    "schema": {
                        "type": "string"
                    },
                    "example": "Doe"
                },
                {
                    "label": "Email",
                    "value": "Email",
                    "schema": {
                        "type": "string"
                    },
                    "example": "jane.doe@example.com"
                },
                {
                    "label": "Phone",
                    "value": "Phone",
                    "schema": {
                        "type": "string"
                    },
                    "example": "+1-555-0100"
                },
                {
                    "label": "AccountId",
                    "value": "AccountId",
                    "schema": {
                        "type": "string"
                    },
                    "example": "0012w00000XyZaBAAV"
                },
                {
                    "label": "OwnerId",
                    "value": "OwnerId",
                    "schema": {
                        "type": "string"
                    },
                    "example": "0052w00000GhIjKAAV"
                },
                {
                    "label": "CreatedDate",
                    "value": "CreatedDate",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "example": "2024-01-15T09:00:00.000Z"
                },
                {
                    "label": "LastModifiedDate",
                    "value": "LastModifiedDate",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "example": "2024-06-01T14:30:00.000Z"
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    },
                    "example": "jane.doe@example.com"
                }
            ]
        }
    ]
}