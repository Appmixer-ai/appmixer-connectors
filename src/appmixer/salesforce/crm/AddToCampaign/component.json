{
    "name": "appmixer.salesforce.crm.AddToCampaign",
    "author": "Appmixer <info@appmixer.ai>",
    "description": "Add a contact or a lead to a campaign in Salesforce (creates a campaign member).",
    "private": false,
    "auth": {
        "service": "appmixer:salesforce"
    },
    "quota": {
        "manager": "appmixer:salesforce",
        "resources": "requests"
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "leadId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign",
                        "index": 1,
                        "tooltip": "The campaign to add the member to. Select a campaign or enter a campaign ID, for example 701Dn000001AbCdIAK.",
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListCampaigns?outPort=out",
                            "data": {
                                "transform": "./transformers#campaignsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    },
                    "contactId": {
                        "type": "text",
                        "label": "Contact",
                        "index": 2,
                        "tooltip": "The contact to add to the campaign. Fill in either Contact or Lead.",
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListContacts?outPort=contacts",
                            "data": {
                                "transform": "./transformers#contactsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    },
                    "leadId": {
                        "type": "text",
                        "label": "Lead",
                        "index": 3,
                        "tooltip": "The lead to add to the campaign. Fill in either Contact or Lead.",
                        "source": {
                            "url": "/component/appmixer/salesforce/crm/ListLeads?outPort=leads",
                            "data": {
                                "transform": "./transformers#leadsToSelectArray",
                                "properties": {
                                    "isSource": true
                                }
                            }
                        }
                    },
                    "status": {
                        "type": "text",
                        "label": "Member Status",
                        "index": 4,
                        "tooltip": "Optional. The campaign member status, for example <code>Sent</code> or <code>Responded</code>. Must be one of the member statuses defined on the campaign. Leave empty to use the campaign's default status."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "Id": {
                        "type": "string",
                        "title": "Campaign Member ID",
                        "example": "00vDn000002XyZaIAK"
                    },
                    "CampaignId": {
                        "type": "string",
                        "title": "Campaign ID",
                        "example": "701Dn000001AbCdIAK"
                    },
                    "ContactId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Contact ID",
                        "example": "003Dn00000QwErTIAV"
                    },
                    "LeadId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Lead ID",
                        "example": null
                    },
                    "Status": {
                        "type": "string",
                        "title": "Status",
                        "example": "Responded"
                    },
                    "HasResponded": {
                        "type": "boolean",
                        "title": "Has Responded",
                        "example": true
                    },
                    "FirstRespondedDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "First Responded Date",
                        "example": "2026-11-20"
                    },
                    "Name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Appmixer Tester"
                    },
                    "FirstName": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "First Name",
                        "example": "Appmixer"
                    },
                    "LastName": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Tester"
                    },
                    "Email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Email",
                        "example": "tester@example.com"
                    },
                    "CreatedDate": {
                        "type": "string",
                        "title": "Created Date",
                        "example": "2026-11-20T10:15:30.000+0000"
                    },
                    "LastModifiedDate": {
                        "type": "string",
                        "title": "Last Modified Date",
                        "example": "2026-11-20T10:15:30.000+0000"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
