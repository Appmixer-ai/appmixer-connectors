{
    "name": "appmixer.docusign.esignature.WatchEvents",
    "author": "Harsha Surisetty <Harsha@client.io>",
    "description": "Watch for events in your Docusign account. Note: Connect <a target=\"blank\" href=\"https://support.docusign.com/en/guides/ndse-admin-guide-connect\">must be enabled</a> in your DocuSign account. It is not enabled by default.",
    "icon": "data:image/svg+xml;base64,",    
    "private": false,
    "auth": {
        "service": "appmixer:docusign"
    },
    "version": "1.1.2",
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Event",
                    "value": "event",
                    "schema": {
                        "type": "string",
                        "example": "envelope-completed"
                    }
                },
                {
                    "label": "Api Version",
                    "value": "apiVersion",
                    "schema": {
                        "type": "string",
                        "example": "v2.1"
                    }
                },
                {
                    "label": "Uri",
                    "value": "uri",
                    "schema": {
                        "type": "string",
                        "example": "/restapi/v2.1/accounts/a4b1c2d3-e4f5-6789-abcd-ef0123456789/envelopes/1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                    }
                },
                {
                    "label": "Retry Count",
                    "value": "retryCount",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Configuration ID",
                    "value": "configurationId",
                    "schema": {
                        "type": "number",
                        "example": 12345678
                    }
                },
                {
                    "label": "Generated Date Time",
                    "value": "generatedDateTime",
                    "schema": {
                        "type": "string",
                        "example": "2025-03-15T14:30:00.0000000Z"
                    }
                },
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "accountId": {
                                "type": "string",
                                "title": "Account ID",
                                "example": "a4b1c2d3-e4f5-6789-abcd-ef0123456789"
                            },
                            "userId": {
                                "type": "string",
                                "title": "User ID",
                                "example": "b5c2d3e4-f5a6-7890-bcde-f01234567890"
                            },
                            "envelopeId": {
                                "type": "string",
                                "title": "Envelope ID",
                                "example": "1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                            }
                        },
                        "example": {
                            "accountId": "a4b1c2d3-e4f5-6789-abcd-ef0123456789",
                            "userId": "b5c2d3e4-f5a6-7890-bcde-f01234567890",
                            "envelopeId": "1a2b3c4d-5e6f-7890-abcd-ef1234567890"
                        }
                    }
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "events": {
                    "type": ["array", "string"]
                }
            }
        },
        "inspector": {
            "inputs": {
                "events": {
                    "type": "multiselect",
                    "label": "Events",
                    "index": 1,
                    "tooltip": "Select a specific event you're interested in watching. Leave blank if you want to listen for all events.",
                    "options": [
                        {
                            "label": "Envelope Sent",
                            "value": "envelope-sent"
                        },
                        {
                            "label": "Envelope Resent",
                            "value": "envelope-resent"
                        },
                        {
                            "label": "Envelope Delivered",
                            "value": "envelope-delivered"
                        },
                        {
                            "label": "Envelope Completed",
                            "value": "envelope-completed"
                        },
                        {
                            "label": "Envelope Declined",
                            "value": "envelope-declined"
                        },
                        {
                            "label": "Envelope Voided",
                            "value": "envelope-voided"
                        },
                        {
                            "label": "Envelope Corrected",
                            "value": "envelope-corrected"
                        },
                        {
                            "label": "Envelope Purge",
                            "value": "envelope-purge"
                        },
                        {
                            "label": "Envelope Deleted",
                            "value": "envelope-deleted"
                        }
                    ]
                }
            }
        }
    }
}