{
    "name": "appmixer.quickbooks.accounting.CreateBill",
    "author": "Jiří Hofman <jirka@client.io>",
    "description": "Create a new bill.",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "inspector": {
                "inputs": {
                    "vendorId": {
                        "type": "text",
                        "index": 1,
                        "label": "Vendor ID",
                        "tooltip": "Reference to the vendor for this transaction."
                    },
                    "minorVersion": {
                        "type": "number",
                        "index": 2,
                        "label": "Minor Version",
                        "defaultValue": 75,
                        "tooltip": "Minor version of the request. Note: Versions below 75 are ignored and will default to version 75. Use version 75 or higher for current features. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/learn/explore-the-quickbooks-online-api/minor-versions'>docs</a> for more details."
                    },
                    "currency": {
                        "type": "text",
                        "index": 3,
                        "label": "Currency",
                        "tooltip": "A three letter string representing the ISO 4217 code for the currency. For example, USD, AUD, EUR, and so on."
                    },
                    "dueDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 4,
                        "label": "Due Date",
                        "tooltip": "Date when the payment of the transaction is due."
                    },
                    "lineItemsJSON": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Line Items JSON",
                        "tooltip": "Line items in a raw JSON format. This is only for an advanced use. See <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/api/accounting/most-commonly-used/invoice#create-an-invoice'>Quickbooks documentation</a> for more details. An example: <code>[{ \"DetailType\": \"AccountBasedExpenseLineDetail\", \"Amount\": 50, \"Description\": \"My service\", \"AccountBasedExpenseLineDetail\": { \"AccountRef\": {\"value\":7} } }]</code>."
                    },
                    "txnDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 6,
                        "label": "TxnDate",
                        "tooltip": "The date entered by the user when this transaction occurred. For posting transactions, this is the posting date that affects the financial statements. If the date is not supplied, the current date on the server is used."
                    },
                    "docNumber": {
                        "type": "text",
                        "index": 7,
                        "label": "Doc Number",
                        "tooltip": "Reference number for the transaction. If not explicitly provided at create time, this field is populated based on the setting of Preferences:CustomTxnNumber."
                    },
                    "privateNote": {
                        "type": "text",
                        "index": 8,
                        "label": "Private Note",
                        "tooltip": "User entered, organization-private note about the transaction. This note does not appear on the invoice to the customer. This field maps to the Statement Memo field on the Invoice form in the QuickBooks Online UI."
                    },
                    "apAccountId": {
                        "type": "text",
                        "index": 9,
                        "label": "AP Account ID",
                        "tooltip": "Specifies to which AP account the bill is credited."
                    },
                    "salesTermId": {
                        "type": "text",
                        "index": 10,
                        "label": "Sales Term ID",
                        "tooltip": "Reference to the Term associated with the transaction."
                    },
                    "departmentId": {
                        "type": "text",
                        "index": 11,
                        "label": "Department ID",
                        "tooltip": "Reference to the Department associated with the transaction."
                    },
                    "linkedTxnJSON": {
                        "type": "textarea",
                        "index": 12,
                        "label": "Linked transactions JSON",
                        "tooltip": "Linked transactions in a raw JSON format. This is only for an advanced use. Zero or more transactions linked to this Bill object. The LinkedTxn.TxnType can be set to PurchaseOrder, BillPaymentCheck or if using Minor Version 55 and above ReimburseCharge. Use LinkedTxn.TxnId as the ID of the transaction."
                    },
                    "exchangeRate": {
                        "type": "number",
                        "index": 13,
                        "label": "Exchange Rate",
                        "tooltip": "The number of home currency units it takes to equal one unit of currency specified by Currency. Applicable if multicurrency is enabled for the company."
                    }
                }
            },
            "schema": {
                "type": "object",
                "properties": {
                    "vendorId": {
                        "type": "string"
                    },
                    "minorVersion": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "dueDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "lineItemsJSON": {
                        "type": "string"
                    },
                    "txnDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "docNumber": {
                        "type": "string"
                    },
                    "privateNote": {
                        "type": "string"
                    },
                    "apAccountId": {
                        "type": "string"
                    },
                    "salesTermId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "linkedTxnJSON": {
                        "type": "string"
                    },
                    "exchangeRate": {
                        "type": "number"
                    }
                },
                "required": [
                    "vendorId",
                    "lineItemsJSON"
                ]
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "Id": {
                        "type": "string",
                        "title": "Bill ID",
                        "example": "301"
                    },
                    "SyncToken": {
                        "type": "string",
                        "title": "Sync Token",
                        "example": "0"
                    },
                    "domain": {
                        "type": "string",
                        "title": "Domain",
                        "example": "QBO"
                    },
                    "sparse": {
                        "type": "boolean",
                        "title": "Sparse",
                        "example": false
                    },
                    "DocNumber": {
                        "type": "string",
                        "title": "Doc Number",
                        "example": "BILL-2026-042"
                    },
                    "TxnDate": {
                        "type": "string",
                        "title": "Transaction Date",
                        "example": "2026-01-15"
                    },
                    "DueDate": {
                        "type": "string",
                        "title": "Due Date",
                        "example": "2026-02-15"
                    },
                    "PrivateNote": {
                        "type": "string",
                        "title": "Private Note",
                        "example": "Monthly office supplies"
                    },
                    "TotalAmt": {
                        "type": "number",
                        "title": "Total Amount",
                        "example": 1500
                    },
                    "Balance": {
                        "type": "number",
                        "title": "Balance",
                        "example": 1500
                    },
                    "HomeBalance": {
                        "type": "number",
                        "title": "Home Balance",
                        "example": 1500
                    },
                    "ExchangeRate": {
                        "type": "number",
                        "title": "Exchange Rate",
                        "example": 1
                    },
                    "VendorRef": {
                        "type": "object",
                        "title": "Vendor",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Vendor.ID",
                                "example": "42"
                            },
                            "name": {
                                "type": "string",
                                "title": "Vendor.Name",
                                "example": "Office Supplies Inc"
                            }
                        }
                    },
                    "APAccountRef": {
                        "type": "object",
                        "title": "AP Account",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "AP Account.ID",
                                "example": "33"
                            },
                            "name": {
                                "type": "string",
                                "title": "AP Account.Name",
                                "example": "Accounts Payable"
                            }
                        }
                    },
                    "SalesTermRef": {
                        "type": "object",
                        "title": "Sales Term",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Sales Term.ID",
                                "example": "3"
                            },
                            "name": {
                                "type": "string",
                                "title": "Sales Term.Name",
                                "example": "Net 30"
                            }
                        }
                    },
                    "DepartmentRef": {
                        "type": "object",
                        "title": "Department",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Department.ID",
                                "example": "1"
                            },
                            "name": {
                                "type": "string",
                                "title": "Department.Name",
                                "example": "Operations"
                            }
                        }
                    },
                    "CurrencyRef": {
                        "type": "object",
                        "title": "Currency",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Currency.ID",
                                "example": "USD"
                            },
                            "name": {
                                "type": "string",
                                "title": "Currency.Name",
                                "example": "United States Dollar"
                            }
                        }
                    },
                    "VendorAddr": {
                        "type": "object",
                        "title": "Vendor Address",
                        "properties": {
                            "Id": {
                                "type": "string",
                                "title": "Vendor Address.ID",
                                "example": "25"
                            },
                            "Line1": {
                                "type": "string",
                                "title": "Vendor Address.Line 1",
                                "example": "123 Vendor Street"
                            },
                            "Line2": {
                                "type": "string",
                                "title": "Vendor Address.Line 2",
                                "example": "Suite 400"
                            },
                            "City": {
                                "type": "string",
                                "title": "Vendor Address.City",
                                "example": "San Jose"
                            },
                            "CountrySubDivisionCode": {
                                "type": "string",
                                "title": "Vendor Address.State",
                                "example": "CA"
                            },
                            "PostalCode": {
                                "type": "string",
                                "title": "Vendor Address.Postal Code",
                                "example": "95131"
                            }
                        }
                    },
                    "MetaData": {
                        "type": "object",
                        "title": "Metadata",
                        "properties": {
                            "CreateTime": {
                                "type": "string",
                                "title": "Metadata.Create Time",
                                "example": "2026-01-15T10:30:00-08:00"
                            },
                            "LastUpdatedTime": {
                                "type": "string",
                                "title": "Metadata.Last Updated Time",
                                "example": "2026-01-15T10:30:00-08:00"
                            }
                        }
                    },
                    "Line": {
                        "type": "array",
                        "title": "Line Items",
                        "items": {
                            "type": "object",
                            "properties": {
                                "Id": {
                                    "type": "string",
                                    "title": "Line ID",
                                    "example": "1"
                                },
                                "LineNum": {
                                    "type": "number",
                                    "title": "Line Number",
                                    "example": 1
                                },
                                "Description": {
                                    "type": "string",
                                    "title": "Line Description",
                                    "example": "Printer paper"
                                },
                                "Amount": {
                                    "type": "number",
                                    "title": "Line Amount",
                                    "example": 1500
                                },
                                "DetailType": {
                                    "type": "string",
                                    "title": "Line Detail Type",
                                    "example": "AccountBasedExpenseLineDetail"
                                },
                                "AccountBasedExpenseLineDetail": {
                                    "type": "object",
                                    "title": "Account Based Expense Line Detail",
                                    "properties": {
                                        "AccountRef": {
                                            "type": "object",
                                            "title": "Line Account",
                                            "properties": {
                                                "value": {
                                                    "type": "string",
                                                    "title": "Line Account ID",
                                                    "example": "7"
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "title": "Line Account Name",
                                                    "example": "Office Expenses"
                                                }
                                            }
                                        },
                                        "BillableStatus": {
                                            "type": "string",
                                            "title": "Line Billable Status",
                                            "example": "NotBillable"
                                        },
                                        "TaxCodeRef": {
                                            "type": "object",
                                            "title": "Line Tax Code",
                                            "properties": {
                                                "value": {
                                                    "type": "string",
                                                    "title": "Line Tax Code ID",
                                                    "example": "NON"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "example": [
                            {
                                "Id": "1",
                                "LineNum": 1,
                                "Description": "Printer paper",
                                "Amount": 1500,
                                "DetailType": "AccountBasedExpenseLineDetail",
                                "AccountBasedExpenseLineDetail": {
                                    "AccountRef": {
                                        "value": "7",
                                        "name": "Office Expenses"
                                    },
                                    "BillableStatus": "NotBillable",
                                    "TaxCodeRef": {
                                        "value": "NON"
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
