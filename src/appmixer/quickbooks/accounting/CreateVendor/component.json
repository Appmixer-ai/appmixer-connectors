{
    "name": "appmixer.quickbooks.accounting.CreateVendor",
    "author": "Jiří Hofman <jirka@client.io>",
    "description": "Create a new vendor.",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "minorVersion": {"type": "string"},
                    "primaryEmailAddrAddress": {"type": "string", "format": "email"},
                    "webAddrURI": {"type": "string", "maxLength": 1000},
                    "primaryPhoneFreeFormNumber": {"type": "string", "maxLength": 30},
                    "displayName": {"type": "string", "maxLength": 500},
                    "suffix": {"type": "string"},
                    "title": {"type": "string", "maxLength": 16},
                    "mobileFreeFormNumber": {"type": "string", "maxLength": 30},
                    "familyName": {"type": "string", "maxLength": 100},
                    "taxIdentifier": {"type": "string", "maxLength": 20},
                    "acctNum": {"type": "string", "maxLength": 100},
                    "companyName": {"type": "string"},
                    "billAddrCountry": {"type": "string", "maxLength": 255},
                    "billAddrCity": {"type": "string", "maxLength": 255},
                    "billAddrLine1": {"type": "string", "maxLength": 500},
                    "billAddrPostalCode": {"type": "string", "maxLength": 30},
                    "billAddrCountrySubDivisionCode": {"type": "string", "maxLength": 255},
                    "givenName": {"type": "string", "maxLength": 100},
                    "printOnCheckName": {"type": "string", "maxLength": 100}
                },
                "anyOf": [
                    { "required": ["displayName"]},
                    { "required": ["title"]},
                    { "required": ["givenName"]},
                    { "required": ["familyName"]},
                    { "required": ["suffix"]}
                ]
            },
            "inspector": {
                "inputs": {
                    "minorVersion": {
                        "type": "number",
                        "index": 1,
                        "label": "Minor Version",
                        "defaultValue": 75,
                        "tooltip": "Minor version of the request. Note: Versions below 75 are ignored and will default to version 75. Use version 75 or higher for current features. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/learn/explore-the-quickbooks-online-api/minor-versions'>docs</a> for more details."
                    },
                    "primaryEmailAddrAddress": {
                        "type": "text",
                        "label": "Primary email address",
                        "tooltip": "An email address. The address format must follow the RFC 822 standard.",
                        "index": 2
                    },
                    "webAddrURI": {
                        "type": "text",
                        "label": "Website address",
                        "tooltip": "Uniform Resource Identifier for the web site.",
                        "index": 3
                    },
                    "primaryPhoneFreeFormNumber": {
                        "type": "text",
                        "label": "Primary phone number",
                        "index": 4
                    },
                    "displayName": {
                        "type": "text",
                        "label": "DisplayName",
                        "tooltip": "The name of the vendor as displayed. Must be unique across all Vendor, Customer, and Employee objects. Cannot be removed with sparse update. If not supplied, the system generates DisplayName by concatenating vendor name components supplied in the request from the following list: Title, GivenName, MiddleName, FamilyName, and Suffix.",
                        "index": 5
                    },
                    "suffix": {
                        "type": "text",
                        "label": "Suffix",
                        "tooltip": "Suffix of the name. For example, Jr. The DisplayName attribute or at least one of Title, GivenName, MiddleName, FamilyName, or Suffix attributes is required for object create.",
                        "index": 6
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "tooltip": "Title of the person. This tag supports i18n, all locales. The DisplayName attribute or at least one of Title, GivenName, MiddleName, FamilyName, or Suffix attributes are required during create.",
                        "index": 7
                    },
                    "mobileFreeFormNumber": {
                        "type": "text",
                        "label": "Mobile phone number",
                        "index": 8
                    },
                    "familyName": {
                        "type": "text",
                        "label": "FamilyName",
                        "index": 9
                    },
                    "taxIdentifier": {
                        "type": "text",
                        "label": "TaxIdentifier",
                        "tooltip": "The tax ID of the Person or Organization. The value is masked in responses, exposing only last four characters. For example, the ID of 123-45-6789 is returned as XXXXXXX6789.",
                        "index": 10
                    },
                    "acctNum": {
                        "type": "text",
                        "label": "AcctNum",
                        "tooltip": "Name or number of the account associated with this vendor.",
                        "index": 11
                    },
                    "companyName": {
                        "type": "text",
                        "label": "CompanyName",
                        "tooltip": "The name of the company associated with the person or organization.",
                        "index": 12
                    },
                    "billAddrCountry": {
                        "type": "text",
                        "label": "Country",
                        "tooltip": "Country name. For international addresses - countries should be passed as 3 ISO alpha-3 characters or the full name of the country.",
                        "group": "address",
                        "index": 13
                    },
                    "billAddrCity": {
                        "type": "text",
                        "label": "City",
                        "group": "address",
                        "index": 14
                    },
                    "billAddrLine1": {
                        "type": "text",
                        "label": "Street",
                        "group": "address",
                        "index": 15
                    },
                    "billAddrPostalCode": {
                        "type": "text",
                        "label": "PostalCode",
                        "group": "address",
                        "index": 16
                    },
                    "billAddrCountrySubDivisionCode": {
                        "type": "text",
                        "label": "CountrySubDivisionCode",
                        "tooltip": "Region within a country. For example, state name for USA, province name for Canada.",
                        "group": "address",
                        "index": 17
                    },
                    "givenName": {
                        "type": "text",
                        "label": "GivenName",
                        "tooltip": "Given name or first name of a person. The DisplayName attribute or at least one of Title, GivenName, MiddleName, FamilyName, or Suffix attributes is required for object create.",
                        "index": 18
                    },
                    "printOnCheckName": {
                        "type": "text",
                        "label": "PrintOnCheckName",
                        "tooltip": "Name of the person or organization as printed on a check. If not provided, this is populated from DisplayName.",
                        "index": 19
                    }
                },
                "groups": {
                    "vendor": {
                        "label": "Vendor Info",
                        "index": 1
                    },
                    "address": {
                        "label": "Billing Address",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/quickbooks/accounting/ListVendors?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "item"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
