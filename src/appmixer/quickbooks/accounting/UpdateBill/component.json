{
    "name": "appmixer.quickbooks.accounting.UpdateBill",
    "label": "Update Bill",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing bill. Only the fields you fill in are changed; the current Sync Token and vendor are read automatically.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "billId": {
                        "type": "string"
                    },
                    "vendorId": {
                        "type": "string"
                    },
                    "dueDate": {
                        "type": "string"
                    },
                    "txnDate": {
                        "type": "string"
                    },
                    "docNumber": {
                        "type": "string",
                        "maxLength": 21
                    },
                    "privateNote": {
                        "type": "string",
                        "maxLength": 4000
                    },
                    "apAccountId": {
                        "type": "string"
                    },
                    "salesTermId": {
                        "type": "string"
                    },
                    "departmentId": {
                        "type": "string"
                    },
                    "lineItemsJSON": {
                        "type": "string"
                    }
                },
                "required": [
                    "billId"
                ]
            },
            "inspector": {
                "inputs": {
                    "billId": {
                        "type": "text",
                        "index": 1,
                        "label": "Bill ID",
                        "tooltip": "ID of the bill to update, e.g. the <b>Id</b> output of Create Bill or New Bill."
                    },
                    "vendorId": {
                        "type": "text",
                        "index": 2,
                        "label": "Vendor ID",
                        "tooltip": "ID of a vendor to move the bill to. Leave empty to keep the current vendor."
                    },
                    "dueDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 3,
                        "label": "Due Date",
                        "tooltip": "Date when the payment of the bill is due."
                    },
                    "txnDate": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "index": 4,
                        "label": "Bill Date",
                        "tooltip": "Date of the bill (TxnDate)."
                    },
                    "docNumber": {
                        "type": "text",
                        "index": 5,
                        "label": "Doc Number",
                        "tooltip": "Reference number of the bill. Maximum 21 characters."
                    },
                    "privateNote": {
                        "type": "textarea",
                        "index": 6,
                        "label": "Private Note",
                        "tooltip": "Internal note about the bill. Maximum 4000 characters."
                    },
                    "apAccountId": {
                        "type": "text",
                        "index": 7,
                        "label": "AP Account ID",
                        "tooltip": "ID of the accounts payable account the bill is credited to."
                    },
                    "salesTermId": {
                        "type": "text",
                        "index": 8,
                        "label": "Sales Term ID",
                        "tooltip": "ID of the payment term of the bill."
                    },
                    "departmentId": {
                        "type": "text",
                        "index": 9,
                        "label": "Department ID",
                        "tooltip": "ID of the department (location) of the bill."
                    },
                    "lineItemsJSON": {
                        "type": "textarea",
                        "index": 10,
                        "label": "Line Items JSON",
                        "tooltip": "Replaces <b>all</b> lines of the bill with this JSON array. Leave empty to keep the current lines. Example: [{ \"DetailType\": \"AccountBasedExpenseLineDetail\", \"Amount\": 100, \"Description\": \"Office supplies\", \"AccountBasedExpenseLineDetail\": { \"AccountRef\": { \"value\": \"7\" } } }]. See the <a target='_blank' rel='noopener noreferrer' href='https://developer.intuit.com/app/developer/qbo/docs/api/accounting/all-entities/bill#sparse-update-a-bill'>QuickBooks documentation</a>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
