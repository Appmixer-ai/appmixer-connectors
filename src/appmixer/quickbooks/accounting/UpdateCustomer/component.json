{
    "name": "appmixer.quickbooks.accounting.UpdateCustomer",
    "label": "Update Customer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing customer. Only the fields you fill in are changed; the current Sync Token is read automatically.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:quickbooks",
        "scope": [
            "com.intuit.quickbooks.accounting",
            "openid",
            "profile",
            "email",
            "phone",
            "address"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customerId": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 16
                    },
                    "givenName": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "middleName": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "familyName": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "suffix": {
                        "type": "string",
                        "maxLength": 16
                    },
                    "companyName": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "primaryEmailAddrAddress": {
                        "type": "string"
                    },
                    "primaryPhoneFreeFormNumber": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "mobileFreeFormNumber": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "webAddrURI": {
                        "type": "string",
                        "maxLength": 1000
                    },
                    "printOnCheckName": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "billAddrLine1": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "billAddrCity": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "billAddrCountrySubDivisionCode": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "billAddrPostalCode": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "billAddrCountry": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "notes": {
                        "type": "string",
                        "maxLength": 2000
                    }
                },
                "required": [
                    "customerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "customerId": {
                        "type": "text",
                        "index": 1,
                        "label": "Customer ID",
                        "tooltip": "ID of the customer to update, e.g. the <b>Id</b> output of Create Customer, Find Customer or New Customer."
                    },
                    "displayName": {
                        "type": "text",
                        "index": 2,
                        "label": "Display Name",
                        "tooltip": "Name of the person or organization as displayed. Must be unique across all customers, vendors and employees. Maximum 500 characters."
                    },
                    "title": {
                        "type": "text",
                        "index": 3,
                        "label": "Title",
                        "tooltip": "Title of the person, e.g. Mr. or Dr. Maximum 16 characters."
                    },
                    "givenName": {
                        "type": "text",
                        "index": 4,
                        "label": "First Name",
                        "tooltip": "Given (first) name of the person. Maximum 100 characters."
                    },
                    "middleName": {
                        "type": "text",
                        "index": 5,
                        "label": "Middle Name",
                        "tooltip": "Middle name of the person. Maximum 100 characters."
                    },
                    "familyName": {
                        "type": "text",
                        "index": 6,
                        "label": "Last Name",
                        "tooltip": "Family (last) name of the person. Maximum 100 characters."
                    },
                    "suffix": {
                        "type": "text",
                        "index": 7,
                        "label": "Suffix",
                        "tooltip": "Suffix of the name, e.g. Jr. Maximum 16 characters."
                    },
                    "companyName": {
                        "type": "text",
                        "index": 8,
                        "label": "Company Name",
                        "tooltip": "Name of the company associated with the customer. Maximum 100 characters."
                    },
                    "primaryEmailAddrAddress": {
                        "type": "text",
                        "index": 9,
                        "label": "Email",
                        "tooltip": "Primary email address of the customer."
                    },
                    "primaryPhoneFreeFormNumber": {
                        "type": "text",
                        "index": 10,
                        "label": "Phone",
                        "tooltip": "Primary phone number. Maximum 30 characters."
                    },
                    "mobileFreeFormNumber": {
                        "type": "text",
                        "index": 11,
                        "label": "Mobile Phone",
                        "tooltip": "Mobile phone number. Maximum 30 characters."
                    },
                    "webAddrURI": {
                        "type": "text",
                        "index": 12,
                        "label": "Website",
                        "tooltip": "Website address of the customer. Maximum 1000 characters."
                    },
                    "printOnCheckName": {
                        "type": "text",
                        "index": 13,
                        "label": "Print On Check Name",
                        "tooltip": "Name of the person or organization as printed on a check. Maximum 100 characters."
                    },
                    "billAddrLine1": {
                        "type": "text",
                        "index": 14,
                        "label": "Billing Street",
                        "tooltip": "Street of the billing address. Address fields you leave empty keep their current value."
                    },
                    "billAddrCity": {
                        "type": "text",
                        "index": 15,
                        "label": "Billing City",
                        "tooltip": "City of the billing address."
                    },
                    "billAddrCountrySubDivisionCode": {
                        "type": "text",
                        "index": 16,
                        "label": "Billing State/Region",
                        "tooltip": "Region within a country of the billing address, e.g. state for the USA or province for Canada."
                    },
                    "billAddrPostalCode": {
                        "type": "text",
                        "index": 17,
                        "label": "Billing Postal Code",
                        "tooltip": "Postal code of the billing address."
                    },
                    "billAddrCountry": {
                        "type": "text",
                        "index": 18,
                        "label": "Billing Country",
                        "tooltip": "Country of the billing address."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 19,
                        "label": "Notes",
                        "tooltip": "Free-form notes about the customer. Replaces the current notes. Maximum 2000 characters."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
