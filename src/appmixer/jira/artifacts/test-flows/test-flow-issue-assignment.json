{
    "flow": {
        "after-all": {
            "config": {
                "properties": {
                    "timeout": 30
                }
            },
            "source": {
                "in": {
                    "assert-issue-assigned": [
                        "out"
                    ],
                    "assert-issue-created": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.AfterAll",
            "x": 1000,
            "y": 200
        },
        "assert-issue-assigned": {
            "config": {
                "transform": {
                    "in": {
                        "get-issue": {
                            "issue": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{assignee-check}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "assignee-check": {
                                            "functions": [],
                                            "variable": "$.get-issue.issue.fields.assignee"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-issue": [
                        "issue"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 850,
            "y": 250
        },
        "assert-issue-created": {
            "config": {
                "transform": {
                    "in": {
                        "get-issue": {
                            "issue": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{issue-id-check}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "issue-id-check": {
                                            "functions": [],
                                            "variable": "$.get-issue.issue.key"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-issue": [
                        "issue"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 850,
            "y": 100
        },
        "assign-issue": {
            "config": {
                "transform": {
                    "in": {
                        "create-issue": {
                            "out": {
                                "lambda": {
                                    "accountId": "{{{var-assignee-id}}}",
                                    "id": "{{{var-issue-id}}}"
                                },
                                "modifiers": {
                                    "accountId": {
                                        "var-assignee-id": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.assigneeId"
                                        }
                                    },
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "create-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.AssignIssue",
            "x": 550,
            "y": 200
        },
        "create-issue": {
            "config": {
                "properties": {
                    "issueType": "10001",
                    "project": "10000"
                },
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "lambda": {
                                    "summary": "{{{var-summary}}}"
                                },
                                "modifiers": {
                                    "summary": {
                                        "var-summary": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.summary"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.CreateIssue",
            "x": 400,
            "y": 200
        },
        "delete-issue": {
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "id": "{{{var-issue-id}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.key"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.DeleteIssue",
            "x": 1150,
            "y": 200
        },
        "get-issue": {
            "config": {
                "transform": {
                    "in": {
                        "assign-issue": {
                            "issue": {
                                "lambda": {
                                    "id": "{{{var-issue-id}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.assign-issue.issue.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "assign-issue": [
                        "issue"
                    ]
                }
            },
            "type": "appmixer.jira.issues.GetIssue",
            "x": 700,
            "y": 200
        },
        "on-start": {
            "config": {},
            "source": {},
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200
        },
        "process-results": {
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "result": "{{{result-var}}}",
                                    "testCase": "E2E Jira - issue-assignment"
                                },
                                "modifiers": {
                                    "recipients": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    },
                                    "testCase": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1300,
            "y": 200
        },
        "set-variables": {
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "name": "projectId",
                                                "text": "10000",
                                                "type": "text"
                                            },
                                            {
                                                "name": "issueType",
                                                "text": "10001",
                                                "type": "text"
                                            },
                                            {
                                                "name": "summary",
                                                "text": "E2E Test Issue Assignment",
                                                "type": "text"
                                            },
                                            {
                                                "name": "assigneeId",
                                                "text": "557058:12345678-1234-1234-1234-123456789012",
                                                "type": "text"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "variables": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 200
        }
    },
    "name": "E2E Jira - issue-assignment",
    "notes": {},
    "wizard": {
        "fields": []
    }
}