{
    "flow": {
        "after-all": {
            "config": {
                "properties": {
                    "timeout": 60
                }
            },
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-delete": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-list": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.AfterAll",
            "x": 1300,
            "y": 300
        },
        "assert-create": {
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "project": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{project-id}}}"
                                            },
                                            {
                                                "assertion": "equal",
                                                "expected": "ETEST",
                                                "field": "{{{project-key}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "project-id": {
                                            "functions": [],
                                            "variable": "$.create-project.project.id"
                                        },
                                        "project-key": {
                                            "functions": [],
                                            "variable": "$.create-project.project.key"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "create-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 550,
            "y": 150
        },
        "assert-delete": {
            "config": {
                "transform": {
                    "in": {
                        "delete-project": {
                            "deleted": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{deleted-id}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "deleted-id": {
                                            "functions": [],
                                            "variable": "$.delete-project.deleted.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "delete-project": [
                        "deleted"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 1150,
            "y": 150
        },
        "assert-get": {
            "config": {
                "transform": {
                    "in": {
                        "get-project": {
                            "project": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}",
                                                "field": "{{{project-name}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "expected-name": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.projectName"
                                        },
                                        "project-name": {
                                            "functions": [],
                                            "variable": "$.get-project.project.name"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 150
        },
        "assert-list": {
            "config": {
                "transform": {
                    "in": {
                        "list-projects": {
                            "projects": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{projects-list}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "projects-list": {
                                            "functions": [],
                                            "variable": "$.list-projects.projects"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "list-projects": [
                        "projects"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 150
        },
        "assert-update": {
            "config": {
                "transform": {
                    "in": {
                        "update-project": {
                            "project": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "equal",
                                                "expected": "{{{expected-updated}}}",
                                                "field": "{{{updated-name}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "expected-updated": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.updatedProjectName"
                                        },
                                        "updated-name": {
                                            "functions": [],
                                            "variable": "$.update-project.project.name"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "update-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 850,
            "y": 150
        },
        "create-project": {
            "config": {
                "properties": {
                    "projectType": "software"
                },
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "lambda": {
                                    "description": "{{{var-desc}}}",
                                    "key": "{{{var-key}}}",
                                    "leadAccountId": "557058:12345678-1234-1234-1234-123456789012",
                                    "name": "{{{var-name}}}",
                                    "projectTemplateKey": "com.pyxis.greenhopper.jira:gh-simplified-agile-kanban"
                                },
                                "modifiers": {
                                    "description": {
                                        "var-desc": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.projectDescription"
                                        }
                                    },
                                    "key": {
                                        "var-key": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.projectKey"
                                        }
                                    },
                                    "leadAccountId": {},
                                    "name": {
                                        "var-name": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.projectName"
                                        }
                                    },
                                    "projectTemplateKey": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.projects.CreateProject",
            "x": 400,
            "y": 300
        },
        "delete-project": {
            "config": {
                "transform": {
                    "in": {
                        "list-projects": {
                            "projects": {
                                "lambda": {
                                    "id": "{{{var-id}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-id": {
                                            "functions": [],
                                            "variable": "$.create-project.project.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "list-projects": [
                        "projects"
                    ]
                }
            },
            "type": "appmixer.jira.projects.DeleteProject",
            "x": 1000,
            "y": 300
        },
        "get-project": {
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "project": {
                                "lambda": {
                                    "id": "{{{var-id}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-id": {
                                            "functions": [],
                                            "variable": "$.create-project.project.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "create-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.jira.projects.GetProject",
            "x": 550,
            "y": 300
        },
        "list-projects": {
            "config": {},
            "source": {
                "in": {
                    "update-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.jira.projects.ListProjects",
            "x": 850,
            "y": 300
        },
        "on-start": {
            "config": {},
            "source": {},
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 300
        },
        "process-results": {
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "result": "{{{result-var}}}",
                                    "testCase": "E2E Jira - project-crud"
                                },
                                "modifiers": {
                                    "recipients": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    },
                                    "testCase": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1450,
            "y": 300
        },
        "set-variables": {
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "name": "projectKey",
                                                "text": "ETEST",
                                                "type": "text"
                                            },
                                            {
                                                "name": "projectName",
                                                "text": "E2E Test Project",
                                                "type": "text"
                                            },
                                            {
                                                "name": "updatedProjectName",
                                                "text": "E2E Test Project Updated",
                                                "type": "text"
                                            },
                                            {
                                                "name": "projectDescription",
                                                "text": "This is a test project for E2E testing",
                                                "type": "text"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "variables": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 300
        },
        "update-project": {
            "config": {
                "transform": {
                    "in": {
                        "get-project": {
                            "project": {
                                "lambda": {
                                    "id": "{{{var-id}}}",
                                    "name": "{{{var-updated-name}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-id": {
                                            "functions": [],
                                            "variable": "$.get-project.project.id"
                                        }
                                    },
                                    "name": {
                                        "var-updated-name": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.updatedProjectName"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-project": [
                        "project"
                    ]
                }
            },
            "type": "appmixer.jira.projects.UpdateProject",
            "x": 700,
            "y": 300
        }
    },
    "name": "E2E Jira - project-crud",
    "notes": {},
    "wizard": {
        "fields": []
    }
}