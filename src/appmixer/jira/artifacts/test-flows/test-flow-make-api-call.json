                                            "functions": [
                                                {
                                                    "name": "g_javascript",
                                                    "params": [
                                                        {
                                                            "value": "'/issue/' + input"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    },
                                    "method": {}
                                },
                                "lambda": {
                                    "url": "{{{key-var}}}",
                                    "method": "GET"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get-myself": {
            "type": "appmixer.utils.test.Assert",
            "x": 1040,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "make-api-call-get-myself": [
                        "out"
                    ]
                }
