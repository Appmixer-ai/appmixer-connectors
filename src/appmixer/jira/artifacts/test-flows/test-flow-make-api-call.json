                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectKey",
                                                "text": "TEST"
                                            },
                                            {
                                                "type": "text",
                                                "name": "issueSummary",
                                                "text": "E2E Test Issue"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "make-api-call-get-myself": {
            "type": "appmixer.jira.core.MakeApiCall",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
