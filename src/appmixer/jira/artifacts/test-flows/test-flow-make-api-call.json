                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "url": {},
                                    "method": {}
                                },
                                "lambda": {
                                    "url": "/myself",
                                    "method": "GET"
                                }
                            }
                        }
                    }
                }
            }
