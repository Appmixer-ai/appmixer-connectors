{
    "name": "E2E Jira - make-api-call",
    "description": "End-to-end test for Jira connector - tests MakeApiCall component using GET, POST, and DELETE HTTP operations including create, verify, and cleanup of a Jira issue",
    "flow": {
        "on-start": {
