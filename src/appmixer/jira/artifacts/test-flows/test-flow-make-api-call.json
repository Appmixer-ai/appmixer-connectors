                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1616,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "make-api-call-delete-issue": [
                        "out"
                    ]
