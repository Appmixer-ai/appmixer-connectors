{
    "flow": {
        "after-all": {
            "config": {
                "properties": {
                    "timeout": 60
                }
            },
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-delete": [
                        "out"
                    ],
                    "assert-transitions": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.AfterAll",
            "x": 1150,
            "y": 300
        },
        "assert-create": {
            "config": {
                "transform": {
                    "in": {
                        "create-issue": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{issue-id}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "create-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 550,
            "y": 150
        },
        "assert-delete": {
            "config": {
                "transform": {
                    "in": {
                        "delete-issue": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{deleted-id}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "deleted-id": {
                                            "functions": [],
                                            "variable": "$.delete-issue.out.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "delete-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 600
        },
        "assert-transitions": {
            "config": {
                "transform": {
                    "in": {
                        "get-transitions": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{transitions-result}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "transitions-result": {
                                            "functions": [],
                                            "variable": "$.get-transitions.out.result"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-transitions": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 300
        },
        "assert-update": {
            "config": {
                "transform": {
                    "in": {
                        "update-issue": {
                            "out": {
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{updated-id}}}"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "expression": {
                                        "updated-id": {
                                            "functions": [],
                                            "variable": "$.update-issue.out.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "update-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.Assert",
            "x": 850,
            "y": 450
        },
        "create-issue": {
            "config": {
                "properties": {
                    "issueType": "10001",
                    "project": "10000"
                },
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "lambda": {
                                    "summary": "{{{var-summary}}}"
                                },
                                "modifiers": {
                                    "summary": {
                                        "var-summary": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.issueSummary"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.CreateIssue",
            "x": 400,
            "y": 300
        },
        "delete-issue": {
            "config": {
                "transform": {
                    "in": {
                        "update-issue": {
                            "out": {
                                "lambda": {
                                    "id": "{{{var-issue-id}}}"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.id"
                                        }
                                    }
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "update-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.DeleteIssue",
            "x": 850,
            "y": 600
        },
        "get-transitions": {
            "config": {
                "transform": {
                    "in": {
                        "create-issue": {
                            "out": {
                                "lambda": {
                                    "id": "{{{var-issue-id}}}",
                                    "outputType": "array"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.id"
                                        }
                                    },
                                    "outputType": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "create-issue": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.GetIssueTransitions",
            "x": 550,
            "y": 300
        },
        "on-start": {
            "config": {},
            "source": {},
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 300
        },
        "process-results": {
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "result": "{{{result-var}}}",
                                    "testCase": "E2E Jira - issue-transitions"
                                },
                                "modifiers": {
                                    "recipients": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    },
                                    "testCase": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1300,
            "y": 300
        },
        "set-variables": {
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "name": "projectId",
                                                "text": "10000",
                                                "type": "text"
                                            },
                                            {
                                                "name": "issueType",
                                                "text": "10001",
                                                "type": "text"
                                            },
                                            {
                                                "name": "issueSummary",
                                                "text": "E2E Test Issue",
                                                "type": "text"
                                            }
                                        ]
                                    }
                                },
                                "modifiers": {
                                    "variables": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 300
        },
        "update-issue": {
            "config": {
                "properties": {
                    "issueType": "10001",
                    "project": "10000"
                },
                "transform": {
                    "in": {
                        "get-transitions": {
                            "out": {
                                "lambda": {
                                    "id": "{{{var-issue-id}}}",
                                    "summary": "E2E Test Issue Updated"
                                },
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "functions": [],
                                            "variable": "$.create-issue.out.id"
                                        }
                                    },
                                    "summary": {}
                                },
                                "type": "json2new"
                            }
                        }
                    }
                }
            },
            "source": {
                "in": {
                    "get-transitions": [
                        "out"
                    ]
                }
            },
            "type": "appmixer.jira.issues.UpdateIssue",
            "x": 700,
            "y": 450
        }
    },
    "name": "E2E Jira - issue-transitions",
    "notes": {}
}