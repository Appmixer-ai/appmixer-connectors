{
    "name": "E2E Jira - templates",
    "description": "End-to-end test for Jira connector - tests ListTemplates component",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 250,
            "y": 200,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectType",
                                                "text": "software"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-templates": {
            "type": "appmixer.jira.projects.ListTemplates",
            "x": 400,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "projectType": "software"
                }
            }
        },
        "assert-templates-exist": {
            "type": "appmixer.utils.test.Assert",
            "x": 550,
            "y": 100,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-templates": [
                        "templates"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-templates": {
                            "templates": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "templates-var": {
                                            "variable": "$.list-templates.templates",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{templates-var}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-template-structure": {
            "type": "appmixer.utils.test.Assert",
            "x": 550,
            "y": 250,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-templates": [
                        "templates"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-templates": {
                            "templates": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "first-template": {
                                            "variable": "$.list-templates.templates[0].label",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{first-template}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 700,
            "y": 175,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-templates-exist": [
                        "out"
                    ],
                    "assert-template-structure": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 850,
            "y": 175,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Jira - templates",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}