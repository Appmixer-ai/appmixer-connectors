{
    "name": "E2E Jira - issue-metadata",
    "description": "End-to-end test for Jira connector - tests issue metadata, field listing, and CRUD operations",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 320,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 240,
            "y": 320,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectId",
                                                "text": "10000"
                                            },
                                            {
                                                "type": "text",
                                                "name": "issueTypeId",
                                                "text": "10001"
                                            },
                                            {
                                                "type": "text",
                                                "name": "issueSummary",
                                                "text": "E2E Test Issue"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 380,
            "y": 320,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {}
        },
        "issue-metadata": {
            "type": "appmixer.jira.issues.IssueMetadata",
            "x": 520,
            "y": 200,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "project": {
                                        "var-project": {
                                            "variable": "$.set-variables.out.projectId",
                                            "functions": []
                                        }
                                    },
                                    "issueType": {
                                        "var-issue-type": {
                                            "variable": "$.set-variables.out.issueTypeId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "project": "{{{var-project}}}",
                                    "issueType": "{{{var-issue-type}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-metadata": {
            "type": "appmixer.utils.test.Assert",
            "x": 660,
            "y": 200,
            "source": {
                "in": {
                    "issue-metadata": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "issue-metadata": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "metadata-check": {
                                            "variable": "$.issue-metadata.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{metadata-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-field": {
            "type": "appmixer.jira.issues.ListField",
            "x": 520,
            "y": 320,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "type": {},
                                    "endpoint": {}
                                },
                                "lambda": {
                                    "type": "assignee",
                                    "endpoint": "/rest/api/3/users/search"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-field": {
            "type": "appmixer.utils.test.Assert",
            "x": 660,
            "y": 320,
            "source": {
                "in": {
                    "list-field": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "list-field": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-check": {
                                            "variable": "$.list-field.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-check}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-issue": {
            "type": "appmixer.jira.issues.CreateIssue",
            "x": 520,
            "y": 440,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "project": "10000",
                    "issueType": "10001"
                },
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "summary": {
                                        "var-summary": {
                                            "variable": "$.set-variables.out.issueSummary",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "summary": "{{{var-summary}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create-issue": {
            "type": "appmixer.utils.test.Assert",
            "x": 660,
            "y": 440,
            "source": {
                "in": {
                    "create-issue": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "create-issue": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "issue-id": {
                                            "variable": "$.create-issue.out.id",
                                            "functions": []
                                        },
                                        "issue-key": {
                                            "variable": "$.create-issue.out.key",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{issue-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{issue-key}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "delete-issue": {
            "type": "appmixer.jira.issues.DeleteIssue",
            "x": 800,
            "y": 440,
            "source": {
                "in": {
                    "create-issue": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "create-issue": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-issue-id": {
                                            "variable": "$.create-issue.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "id": "{{{var-issue-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-delete-issue": {
            "type": "appmixer.utils.test.Assert",
            "x": 940,
            "y": 440,
            "source": {
                "in": {
                    "delete-issue": [
                        "deleted"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "delete-issue": {
                            "deleted": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "deleted-id": {
                                            "variable": "$.delete-issue.deleted.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{deleted-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1080,
            "y": 320,
            "source": {
                "in": {
                    "assert-metadata": [
                        "out"
                    ],
                    "assert-list-field": [
                        "out"
                    ],
                    "assert-create-issue": [
                        "out"
                    ],
                    "assert-delete-issue": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1220,
            "y": 320,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "properties": {
                    "successStoreId": "64cb41824421780007381f86",
                    "failedStoreId": "64cb41969751560007caf0bf"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Jira - issue-metadata",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}