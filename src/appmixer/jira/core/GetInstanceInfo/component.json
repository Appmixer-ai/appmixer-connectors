{
    "name": "appmixer.jira.core.GetInstanceInfo",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves information about the Jira instance including version, build details, server time, and health status. This component is useful for getting basic server information and verifying instance connectivity.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:jira"
    },
    "quota": {
        "manager": "appmixer:jira",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Base Url",
                    "value": "baseUrl",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Version",
                    "value": "version",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Version Numbers",
                    "value": "versionNumbers",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    }
                },
                {
                    "label": "Deployment Type",
                    "value": "deploymentType",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Build Number",
                    "value": "buildNumber",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Build Date",
                    "value": "buildDate",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Database Build Number",
                    "value": "databaseBuildNumber",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Server Time",
                    "value": "serverTime",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Scm Info",
                    "value": "scmInfo",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Server Title",
                    "value": "serverTitle",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Health Checks",
                    "value": "healthChecks",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Health Checks.Name"
                                },
                                "description": {
                                    "type": "string",
                                    "title": "Health Checks.Description"
                                },
                                "passed": {
                                    "type": "boolean",
                                    "title": "Health Checks.Passed"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PD94"
}