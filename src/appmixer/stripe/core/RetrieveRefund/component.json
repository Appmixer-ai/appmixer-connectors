{
    "name": "appmixer.stripe.core.RetrieveRefund",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves details about an existing refund using its ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:stripe"
    },
    "quota": {
        "manager": "appmixer:stripe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "refundId": {
                        "type": "string"
                    }
                },
                "required": [
                    "refundId"
                ]
            },
            "inspector": {
                "inputs": {
                    "refundId": {
                        "type": "text",
                        "tooltip": "The identifier of the Refund to retrieve.",
                        "label": "Refund Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "re_1RET789DEF012"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "refund"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "number",
                        "example": 1500
                    }
                },
                {
                    "label": "Balance Transaction",
                    "value": "balance_transaction",
                    "schema": {
                        "type": "string",
                        "example": "txn_1Mt0Zr2eZvKYlo2C"
                    }
                },
                {
                    "label": "Charge",
                    "value": "charge",
                    "schema": {
                        "type": "string",
                        "example": "ch_3OLD456GHI789"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number",
                        "example": 1737024600
                    }
                },
                {
                    "label": "Currency",
                    "value": "currency",
                    "schema": {
                        "type": "string",
                        "example": "usd"
                    }
                },
                {
                    "label": "Destination Details",
                    "value": "destination_details",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "card": {
                                "type": "object",
                                "properties": {
                                    "reference": {
                                        "type": "string",
                                        "title": "Destination Details.Card.Reference"
                                    },
                                    "reference_status": {
                                        "type": "string",
                                        "title": "Destination Details.Card.Reference Status"
                                    },
                                    "reference_type": {
                                        "type": "string",
                                        "title": "Destination Details.Card.Reference Type"
                                    },
                                    "type": {
                                        "type": "string",
                                        "title": "Destination Details.Card.Type"
                                    }
                                },
                                "title": "Destination Details.Card"
                            },
                            "type": {
                                "type": "string",
                                "title": "Destination Details.Type"
                            }
                        },
                        "example": {
                            "card": {
                                "reference": "74850124324000123456789",
                                "reference_status": "available",
                                "reference_type": "acquirer_reference_number",
                                "type": "refund"
                            },
                            "type": "card"
                        }
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {
                            "order_id": "6735"
                        }
                    }
                },
                {
                    "label": "Payment Intent",
                    "value": "payment_intent",
                    "schema": {
                        "type": "string",
                        "example": "pi_3OLD456GHI789"
                    }
                },
                {
                    "label": "Reason",
                    "value": "reason",
                    "schema": {
                        "type": "string",
                        "example": "duplicate"
                    }
                },
                {
                    "label": "Receipt Number",
                    "value": "receipt_number",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Source Transfer Reversal",
                    "value": "source_transfer_reversal",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "succeeded"
                    }
                },
                {
                    "label": "Transfer Reversal",
                    "value": "transfer_reversal",
                    "schema": {
                        "type": "string",
                        "example": null
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
