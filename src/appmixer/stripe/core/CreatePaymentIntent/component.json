{
    "name": "appmixer.stripe.core.CreatePaymentIntent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a Payment Intent to initiate a payment process with specified parameters like amount and currency.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:stripe"
    },
    "quota": {
        "manager": "appmixer:stripe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "paymentMethod": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "customer": {
                        "type": "string"
                    },
                    "paymentMethodTypes": {
                        "type": "string"
                    },
                    "automaticPaymentMethodsEnabled": {
                        "type": "boolean"
                    },
                    "automaticPaymentMethodsAllowRedirects": {
                        "type": "string",
                        "enum": [
                            "always",
                            "never"
                        ]
                    },
                    "captureMethod": {
                        "type": "string",
                        "enum": [
                            "automatic",
                            "manual",
                            "automatic_async"
                        ]
                    },
                    "confirm": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "amount",
                    "currency"
                ]
            },
            "inspector": {
                "inputs": {
                    "amount": {
                        "type": "number",
                        "tooltip": "Amount intended to be collected by this Payment Intent, measured in the smallest currency unit.",
                        "label": "Amount",
                        "index": 0
                    },
                    "currency": {
                        "type": "text",
                        "tooltip": "Three-letter ISO currency code, in lowercase.",
                        "label": "Currency",
                        "index": 1
                    },
                    "paymentMethod": {
                        "type": "text",
                        "tooltip": "The payment method ID to attach to this Payment Intent.",
                        "label": "Payment Method Id",
                        "index": 2
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "An arbitrary string to attach to the Payment Intent for additional information",
                        "label": "Description",
                        "index": 3
                    },
                    "customer": {
                        "type": "text",
                        "tooltip": "The identifier of the customer for whom this Payment Intent is created.",
                        "label": "Customer Id",
                        "index": 4
                    },
                    "paymentMethodTypes": {
                        "type": "text",
                        "tooltip": "Comma-separated list of payment method types (e.g., card, ideal, sepa_debit). If not provided, Stripe will dynamically show relevant payment methods. See all types: <a href=\"https://docs.stripe.com/api/payment_methods/object#payment_method_object-type\" target=\"_blank\">Payment Method Types</a>",
                        "label": "Payment Method Types",
                        "index": 5
                    },
                    "captureMethod": {
                        "type": "select",
                        "tooltip": "Controls when the funds will be captured from the customer's account. 'automatic_async' (default) captures asynchronously with better latency. 'manual' requires calling capture separately. 'automatic' captures instantly.",
                        "label": "Capture Method",
                        "index": 6,
                        "defaultValue": "automatic_async",
                        "options": [
                            {
                                "label": "Automatic",
                                "value": "automatic"
                            },
                            {
                                "label": "Manual",
                                "value": "manual"
                            },
                            {
                                "label": "Automatic Async",
                                "value": "automatic_async"
                            }
                        ]
                    },
                    "automaticPaymentMethodsEnabled": {
                        "type": "toggle",
                        "tooltip": "Whether automatic payment methods feature is enabled. When enabled, this PaymentIntent accepts payment methods that you enable in the Dashboard.",
                        "label": "Enable Automatic Payment Methods",
                        "index": 7,
                        "defaultValue": false
                    },
                    "automaticPaymentMethodsAllowRedirects": {
                        "type": "select",
                        "tooltip": "Controls whether this PaymentIntent will accept redirect-based payment methods. 'always' (default) accepts redirects, 'never' filters out redirect-based methods.",
                        "label": "Allow Redirects for Automatic Payment Methods",
                        "index": 8,
                        "defaultValue": "always",
                        "options": [
                            {
                                "label": "Always",
                                "value": "always"
                            },
                            {
                                "label": "Never",
                                "value": "never"
                            }
                        ]
                    },
                    "confirm": {
                        "type": "toggle",
                        "tooltip": "Set to true to attempt to confirm this PaymentIntent immediately. When false, the PaymentIntent is created in requires_confirmation status and must be confirmed separately.",
                        "label": "Confirm Payment Intent",
                        "index": 9,
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "pi_3NEW456GHI789JKL"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "payment_intent"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "number",
                        "example": 7500
                    }
                },
                {
                    "label": "Currency",
                    "value": "currency",
                    "schema": {
                        "type": "string",
                        "example": "usd"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "requires_payment_method"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
