{
    "name": "appmixer.stripe.core.FinalizeDraftInvoice",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Finalizes a draft invoice, making it ready for payment.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:stripe"
    },
    "quota": {
        "manager": "appmixer:stripe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "invoiceId": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "invoiceId": {
                        "type": "text",
                        "tooltip": "The identifier of the draft invoice to finalize.",
                        "label": "Invoice Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "in_1ABC123DEF456"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "invoice"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "open"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
