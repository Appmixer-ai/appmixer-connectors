{
    "name": "appmixer.stripe.core.RetrievePaymentIntent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves the details of a previously created Payment Intent.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:stripe"
    },
    "quota": {
        "manager": "appmixer:stripe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "paymentIntentId": {
                        "type": "string"
                    }
                },
                "required": [
                    "paymentIntentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "paymentIntentId": {
                        "type": "text",
                        "tooltip": "The identifier of the Payment Intent to retrieve.",
                        "label": "Payment Intent Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "pi_3RET123ABC456DEF"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string",
                        "example": "payment_intent"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
