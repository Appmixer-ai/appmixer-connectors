                            }
                        },
                        "example": {
                            "tip": {}
                        }
                    }
                },
                {
                    "label": "Amount Received",
                    "value": "amount_received",
                    "schema": {
                        "type": "number",
                        "example": 3500
                    }
                },
                {
                    "label": "Application",
                    "value": "application",
                    "schema": {
                        "type": "string",
                        "example": null
