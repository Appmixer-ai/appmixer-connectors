                    "value": "payment_method_options",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "card": {
                                "type": "object",
                                "properties": {
                                    "installments": {
                                        "type": "string",
                                        "title": "Payment Method Options.Card.Installments"
                                    },
                                    "mandate_options": {
                                        "type": "string",
                                        "title": "Payment Method Options.Card.Mandate Options"
                                    },
                                    "network": {
                                        "type": "string",
                                        "title": "Payment Method Options.Card.Network"
                                    },
                                    "request_three_d_secure": {
                                        "type": "string",
                                        "title": "Payment Method Options.Card.Request Three D Secure"
                                    }
                                },
                                "title": "Payment Method Options.Card"
                            },
                            "link": {
                                "type": "object",
                                "properties": {
                                    "persistent_token": {
                                        "type": "string",
                                        "title": "Payment Method Options.Link.Persistent Token"
                                    }
                                },
                                "title": "Payment Method Options.Link"
                            }
                        },
                        "example": {
                            "card": {
                                "installments": null,
                                "mandate_options": null,
                                "network": null,
                                "request_three_d_secure": "automatic"
                            },
                            "link": {
                                "persistent_token": null
                            }
                        }
