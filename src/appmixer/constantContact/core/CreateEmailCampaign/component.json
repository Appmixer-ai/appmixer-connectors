{
    "name": "appmixer.constantContact.core.CreateEmailCampaign",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new email campaign in Constant Contact.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests",
        "scope": {
            "userId": ""
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "fromName": {
                        "type": "string"
                    },
                    "fromEmail": {
                        "type": "string"
                    },
                    "replyToEmail": {
                        "type": "string"
                    },
                    "htmlContent": {
                        "type": "string"
                    },
                    "textContent": {
                        "type": "string"
                    },
                    "listIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "name",
                    "subject",
                    "fromEmail",
                    "htmlContent",
                    "listIds"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Campaign Name",
                        "tooltip": "Human-readable name for the campaign"
                    },
                    "subject": {
                        "type": "text",
                        "index": 2,
                        "label": "Subject Line",
                        "tooltip": "Email subject line"
                    },
                    "fromName": {
                        "type": "text",
                        "index": 3,
                        "label": "From Name",
                        "tooltip": "Sender's display name"
                    },
                    "fromEmail": {
                        "type": "text",
                        "index": 4,
                        "label": "From Email",
                        "tooltip": "Sender's email address"
                    },
                    "replyToEmail": {
                        "type": "text",
                        "index": 5,
                        "label": "Reply-To Email",
                        "tooltip": "Reply-to email address (optional)"
                    },
                    "htmlContent": {
                        "type": "textarea",
                        "index": 6,
                        "label": "HTML Content",
                        "tooltip": "HTML body content"
                    },
                    "textContent": {
                        "type": "textarea",
                        "index": 7,
                        "label": "Text Content",
                        "tooltip": "Plain text body content (optional)"
                    },
                    "listIds": {
                        "type": "expression",
                        "index": 8,
                        "label": "Target List IDs",
                        "tooltip": "Array of list IDs for campaign audience"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Campaign ID",
                    "value": "campaign_id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Updated At",
                    "value": "updated_at"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}