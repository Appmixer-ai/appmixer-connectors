{
    "name": "appmixer.constantContact.core.UpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing contact by Id.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contact_id": {
                        "type": "string"
                    },
                    "email_address": {
                        "type": "string"
                    },
                    "permission_to_send": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name"
                    },
                    "job_title": {
                        "type": "string",
                        "title": "Job Title"
                    },
                    "list_memberships": {
                        "type": [
                            "array",
                            "string"
                        ],
                        "items": {
                            "type": "string"
                        },
                        "title": "List Memberships"
                    },
                    "tags": {
                        "type": [
                            "array",
                            "string"
                        ],
                        "items": {
                            "type": "string"
                        },
                        "title": "Tags"
                    },
                    "update_source": {
                        "type": "string",
                        "title": "Update Source"
                    }
                },
                "required": [
                    "contact_id",
                    "update_source"
                ]
            },
            "inspector": {
                "inputs": {
                    "contact_id": {
                        "type": "text",
                        "tooltip": "The unique Id of the contact to update.",
                        "label": "Contact Id",
                        "index": 0
                    },
                    "email_address": {
                        "type": "text",
                        "label": "Email Address",
                        "tooltip": "Email address of the contact.",
                        "index": 1
                    },
                    "permission_to_send": {
                        "type": "select",
                        "label": "Permission To Send",
                        "tooltip": "Identifies the type of permission that the Constant Contact account has been granted to send email to the contact.",
                        "options": [
                            {
                                "label": "Explicit",
                                "value": "explicit"
                            },
                            {
                                "label": "Implicit",
                                "value": "implicit"
                            },
                            {
                                "label": "Pending Confirmation",
                                "value": "pending_confirmation"
                            },
                            {
                                "label": "Unsubscribed",
                                "value": "unsubscribed"
                            },
                            {
                                "label": "Temporary Hold",
                                "value": "temp_hold"
                            },
                            {
                                "label": "Not Set",
                                "value": "not_set"
                            }
                        ],
                        "index": 2
                    },
                    "first_name": {
                        "type": "text",
                        "tooltip": "First name of the contact.",
                        "label": "First Name",
                        "index": 3
                    },
                    "last_name": {
                        "type": "text",
                        "tooltip": "Last name of the contact.",
                        "label": "Last Name",
                        "index": 4
                    },
                    "company_name": {
                        "type": "text",
                        "tooltip": "Company name.",
                        "label": "Company Name",
                        "index": 5
                    },
                    "job_title": {
                        "type": "text",
                        "tooltip": "Job title.",
                        "label": "Job Title",
                        "index": 6
                    },
                    "list_memberships": {
                        "type": "multiselect",
                        "tooltip": "List IDs to subscribe the contact to.",
                        "label": "List Memberships",
                        "index": 7,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/FindContactLists?outPort=out",
                            "data": {
                                "transform": "./FindContactLists#listsToSelectArray"
                            }
                        }
                    },
                    "tags": {
                        "type": "multiselect",
                        "tooltip": "Tags to apply to the contact.",
                        "label": "Tags",
                        "index": 8,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/ListTags?outPort=out",
                            "data": {
                                "transform": "./ListTags#tagsToSelectArray"
                            }
                        }
                    },
                    "update_source": {
                        "type": "select",
                        "tooltip": "Source of the update operation.",
                        "label": "Update Source",
                        "options": [
                            {
                                "clearItem": true,
                                "content": "-- Clear selection --"
                            },
                            {
                                "label": "Account",
                                "value": "Account"
                            },
                            {
                                "label": "Contact",
                                "value": "Contact"
                            }
                        ],
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}