{
    "name": "appmixer.constantContact.core.UpdateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing contact by ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "email_address": {
                        "type": "string"
                    },
                    "permission_to_send": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "company_name": {
                        "type": "string"
                    },
                    "job_title": {
                        "type": "string"
                    },
                    "list_memberships": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "update_source": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "tooltip": "The unique ID of the contact to update.",
                        "label": "Contact ID",
                        "index": 0
                    },
                    "email_address": {
                        "type": "text",
                        "tooltip": "Email address.",
                        "label": "Email Address",
                        "index": 1
                    },
                    "permission_to_send": {
                        "type": "select",
                        "tooltip": "Permission level for sending. Common values: explicit, implicit, not_set.",
                        "label": "Permission To Send",
                        "options": [
                            {
                                "label": "explicit",
                                "value": "explicit"
                            },
                            {
                                "label": "implicit",
                                "value": "implicit"
                            },
                            {
                                "label": "not_set",
                                "value": "not_set"
                            }
                        ],
                        "index": 2
                    },
                    "first_name": {
                        "type": "text",
                        "tooltip": "First name of the contact.",
                        "label": "First Name",
                        "index": 3
                    },
                    "last_name": {
                        "type": "text",
                        "tooltip": "Last name of the contact.",
                        "label": "Last Name",
                        "index": 4
                    },
                    "company_name": {
                        "type": "text",
                        "tooltip": "Company name.",
                        "label": "Company Name",
                        "index": 5
                    },
                    "job_title": {
                        "type": "text",
                        "tooltip": "Job title.",
                        "label": "Job Title",
                        "index": 6
                    },
                    "list_memberships": {
                        "type": "textarea",
                        "tooltip": "Array of list IDs to set as this contact's memberships (replaces existing). Enter one list ID per line.",
                        "label": "List Memberships",
                        "index": 7
                    },
                    "tags": {
                        "type": "textarea",
                        "tooltip": "Tags to set for the contact. Enter one tag per line.",
                        "label": "Tags",
                        "index": 8
                    },
                    "update_source": {
                        "type": "select",
                        "tooltip": "Source of the update operation.",
                        "label": "Update Source",
                        "options": [
                            {
                                "label": "Account",
                                "value": "Account"
                            },
                            {
                                "label": "Contact",
                                "value": "Contact"
                            }
                        ],
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contact_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email Address",
                    "value": "email_address",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "last_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Company Name",
                    "value": "company_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Job Title",
                    "value": "job_title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "List Memberships",
                    "value": "list_memberships",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Update Source",
                    "value": "update_source",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}