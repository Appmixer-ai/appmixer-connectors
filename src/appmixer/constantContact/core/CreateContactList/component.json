{
    "name": "appmixer.constantContact.core.CreateContactList",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact list.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "favorite": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Name of the contact list.",
                        "label": "Name",
                        "index": 0
                    },
                    "favorite": {
                        "type": "toggle",
                        "tooltip": "Mark the list as a favorite.",
                        "label": "Favorite",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "List Id",
                    "value": "list_id",
                    "schema": {
                        "type": "string",
                        "example": "8c5e34f0-7b2a-11ec-90d6-0242ac120003"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Spring Campaign Subscribers"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Subscribers for the spring 2026 email campaign"
                    }
                },
                {
                    "label": "Favorite",
                    "value": "favorite",
                    "schema": {
                        "type": "boolean",
                        "example": true
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-02-20T14:45:00Z"
                    }
                },
                {
                    "label": "Deleted At",
                    "value": "deleted_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-03-10T09:00:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}