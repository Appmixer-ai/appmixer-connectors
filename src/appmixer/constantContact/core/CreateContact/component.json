{
    "name": "appmixer.constantContact.core.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact. At minimum, provide an email address and a create source.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email_address": {
                        "type": "string",
                        "title": "Email Address"
                    },
                    "permission_to_send": {
                        "type": "string",
                        "title": "Permission To Send"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name"
                    },
                    "job_title": {
                        "type": "string",
                        "title": "Job Title"
                    },
                    "list_memberships": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "title": "List Memberships"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "title": "Tags"
                    },
                    "create_source": {
                        "type": "string",
                        "title": "Create Source"
                    }
                },
                "required": [
                    "email_address",
                    "permission_to_send",
                    "create_source"
                ]
            },
            "inspector": {
                "inputs": {
                    "email_address": {
                        "type": "text",
                        "tooltip": "Email address (required).",
                        "label": "Email Address",
                        "index": 0
                    },
                    "permission_to_send": {
                        "type": "select",
                        "tooltip": "Permission level for sending.",
                        "label": "Permission To Send",
                        "options": [
                            {
                                "label": "Explicit",
                                "value": "explicit"
                            },
                            {
                                "label": "Implicit",
                                "value": "implicit"
                            },
                            {
                                "label": "Not Set",
                                "value": "not_set"
                            }
                        ],
                        "index": 1
                    },
                    "first_name": {
                        "type": "text",
                        "tooltip": "First name of the contact.",
                        "label": "First Name",
                        "index": 2
                    },
                    "last_name": {
                        "type": "text",
                        "tooltip": "Last name of the contact.",
                        "label": "Last Name",
                        "index": 3
                    },
                    "company_name": {
                        "type": "text",
                        "tooltip": "Company name.",
                        "label": "Company Name",
                        "index": 4
                    },
                    "job_title": {
                        "type": "text",
                        "tooltip": "Job title.",
                        "label": "Job Title",
                        "index": 5
                    },
                    "list_memberships": {
                        "type": "textarea",
                        "tooltip": "Array of list IDs to subscribe the contact to (one per line or JSON array format).",
                        "label": "List Memberships",
                        "index": 6
                    },
                    "tags": {
                        "type": "textarea",
                        "tooltip": "Tags to apply to the contact (one per line or JSON array format).",
                        "label": "Tags",
                        "index": 7
                    },
                    "create_source": {
                        "type": "select",
                        "tooltip": "Source of the create operation.",
                        "label": "Create Source",
                        "options": [
                            {
                                "label": "Account",
                                "value": "Account"
                            },
                            {
                                "label": "Contact",
                                "value": "Contact"
                            }
                        ],
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contact_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email Address",
                    "value": "email_address",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "first_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "last_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Company Name",
                    "value": "company_name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Job Title",
                    "value": "job_title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "List Memberships",
                    "value": "list_memberships",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Create Source",
                    "value": "create_source",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}