{
    "name": "appmixer.constantContact.core.FindContacts",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Search and list contacts. Returns a maximum of 500 contacts per request.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:constantContact"
    },
    "quota": {
        "manager": "appmixer:constantContact",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {"type": ["array", "string"]
                    },
                    "email": {
                        "type": "string"
                    },
                    "lists": {"type": ["array", "string"]
                    },
                    "tags": {"type": ["array", "string"]
                    },
                    "updated_after": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_before": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_after": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_before": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "optout_after": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "optout_before": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sms_status": {"type": ["array", "string"]
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "status": {
                        "type": "multiselect",
                        "tooltip": "Filter by subscription status. Accepts one or more values.",
                        "label": "Status",
                        "options": [
                            {
                                "label": "All",
                                "value": "all"
                            },
                            {
                                "label": "Active",
                                "value": "active"
                            },
                            {
                                "label": "Deleted",
                                "value": "deleted"
                            },
                            {
                                "label": "Not Set",
                                "value": "not_set"
                            },
                            {
                                "label": "Pending Confirmation",
                                "value": "pending_confirmation"
                            },
                            {
                                "label": "Temp Hold",
                                "value": "temp_hold"
                            },
                            {
                                "label": "Unsubscribed",
                                "value": "unsubscribed"
                            }
                        ],
                        "index": 1
                    },
                    "email": {
                        "type": "text",
                        "tooltip": "Filter by an exact email address.",
                        "label": "Email",
                        "index": 2
                    },
                    "lists": {
                        "type": "multiselect",
                        "tooltip": "Filter by contacts that are members of one or more specified lists. Up to 25 list IDs.",
                        "label": "Lists",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/FindContactLists?outPort=out",
                            "data": {
                                "transform": "./FindContactLists#listsToSelectArray"
                            }
                        }
                    },
                    "tags": {
                        "type": "multiselect",
                        "tooltip": "Get contact details for up to 50 specified tags.",
                        "label": "Tags",
                        "index": 5,
                        "source": {
                            "url": "/component/appmixer/constantContact/core/ListTags?outPort=out",
                            "data": {
                                "transform": "./ListTags#tagsToSelectArray"
                            }
                        }
                    },
                    "updated_after": {
                        "type": "date-time",
                        "tooltip": "Return contacts updated after this date and time (ISO-8601 format).",
                        "label": "Updated After",
                        "index": 6
                    },
                    "updated_before": {
                        "type": "date-time",
                        "tooltip": "Return contacts updated before this date and time (ISO-8601 format).",
                        "label": "Updated Before",
                        "index": 7
                    },
                    "created_after": {
                        "type": "date-time",
                        "tooltip": "Return contacts created after this date and time (ISO-8601 format).",
                        "label": "Created After",
                        "index": 8
                    },
                    "created_before": {
                        "type": "date-time",
                        "tooltip": "Return contacts created before this date and time (ISO-8601 format).",
                        "label": "Created Before",
                        "index": 9
                    },
                    "optout_after": {
                        "type": "date-time",
                        "tooltip": "Return contacts that unsubscribed after this date and time (ISO-8601 format).",
                        "label": "Optout After",
                        "index": 10
                    },
                    "optout_before": {
                        "type": "date-time",
                        "tooltip": "Return contacts that unsubscribed before this date and time (ISO-8601 format).",
                        "label": "Optout Before",
                        "index": 11
                    },
                    "sms_status": {
                        "type": "multiselect",
                        "tooltip": "Get contacts by their SMS status.",
                        "label": "SMS Status",
                        "index": 12,
                        "options": [
                            {
                                "label": "All",
                                "value": "all"
                            },
                            {
                                "label": "Explicit",
                                "value": "explicit"
                            },
                            {
                                "label": "Unsubscribed",
                                "value": "unsubscribed"
                            },
                            {
                                "label": "Pending Confirmation",
                                "value": "pending_confirmation"
                            },
                            {
                                "label": "Not Set",
                                "value": "not_set"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 13,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/constantContact/core/FindContacts?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}