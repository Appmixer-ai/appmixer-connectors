{
    "actions": [
        {
            "title": "Find Contacts",
            "description": "Search and list contacts. Returns an array of contacts. Constant Contact paginates responses; retrieve the maximum available per page internally and follow next links as needed.",
            "type": "action",
            "documentation": "https://v3.developer.constantcontact.com/api_reference/index.html#!/Contacts/getContacts",
            "endpointUrl": "/v3/contacts",
            "apiBaseUrl": "https://api.cc.email",
            "method": "GET",
            "sampleResponse": {
                "contacts": [
                    {
                        "contact_id": "3f9a9e10-6b8d-11ee-8c99-fa163e8f9c2a",
                        "email_address": {
                            "address": "jane.doe@example.com",
                            "permission_to_send": "implicit",
                            "created_at": "2024-01-15T13:43:12Z",
                            "updated_at": "2024-05-10T09:22:11Z"
                        },
                        "first_name": "Jane",
                        "last_name": "Doe",
                        "job_title": "Marketing Manager",
                        "company_name": "Example Inc.",
                        "list_memberships": [
                            "f2a1c0e0-1234-5678-9abc-112233445566"
                        ],
                        "tags": [
                            "vip",
                            "newsletter"
                        ],
                        "create_source": "Account",
                        "created_at": "2024-01-15T13:43:12Z",
                        "updated_at": "2024-05-10T09:22:11Z"
                    }
                ],
                "links": {
                    "next": "https://api.cc.email/v3/contacts?cursor=eyJwIjoxfQ=="
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "Query parameters to filter contacts. Do not include limit/offset; the integration should handle pagination internally.",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Filter by an exact email address."
                    },
                    "status": {
                        "type": "string",
                        "description": "Filter by subscription status. Common values: all, subscribed, unsubscribed, not_set, archived.",
                        "enum": [
                            "all",
                            "subscribed",
                            "unsubscribed",
                            "not_set",
                            "archived"
                        ]
                    },
                    "listId": {
                        "type": "string",
                        "description": "Filter by contacts that are members of the specified list ID."
                    },
                    "createdAfter": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Return contacts created after this ISO 8601 timestamp."
                    },
                    "updatedAfter": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Return contacts updated after this ISO 8601 timestamp."
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "contacts"
            }
