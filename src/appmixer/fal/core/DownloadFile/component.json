{
    "name": "appmixer.fal.core.DownloadFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Download a fal CDN media URL into file storage. fal outputs expire per account settings, so use this to persist generated media.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:fal"
    },
    "quota": {
        "manager": "appmixer:fal",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "example": "https://v3b.fal.media/files/penguin/abc123.jpeg"
                    },
                    "fileName": {
                        "type": "string",
                        "example": "generated-image.jpeg"
                    }
                },
                "required": [
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 0,
                        "label": "Media URL",
                        "tooltip": "The fal CDN URL of the media to download."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 1,
                        "label": "File Name",
                        "tooltip": "Optional. Defaults to the last path segment of the URL."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File Id",
                        "example": "5f8d0d55b54764421b7156c9"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "generated-image.jpeg"
                    },
                    "contentType": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "image/jpeg"
                    },
                    "size": {
                        "type": "integer",
                        "title": "Size",
                        "example": 20481
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
