{
    "name": "appmixer.fal.core.FindModels",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Search fal's model catalogue. Filter by query, category and status. Uses cursor-based pagination (no offset).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:fal"
    },
    "quota": {
        "manager": "appmixer:fal",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "example": "flux"
                    },
                    "category": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 0,
                        "label": "Query",
                        "tooltip": "Free-text search over model names and descriptions."
                    },
                    "category": {
                        "type": "select",
                        "index": 1,
                        "label": "Category",
                        "tooltip": "Filter models by category.",
                        "options": [
                            {
                                "label": "Text to Image",
                                "value": "text-to-image"
                            },
                            {
                                "label": "Image to Image",
                                "value": "image-to-image"
                            },
                            {
                                "label": "Image to Video",
                                "value": "image-to-video"
                            },
                            {
                                "label": "Text to Video",
                                "value": "text-to-video"
                            },
                            {
                                "label": "Video to Video",
                                "value": "video-to-video"
                            },
                            {
                                "label": "Text to Audio",
                                "value": "text-to-audio"
                            },
                            {
                                "label": "Text to Speech",
                                "value": "text-to-speech"
                            },
                            {
                                "label": "Speech to Text",
                                "value": "speech-to-text"
                            },
                            {
                                "label": "Image to 3D",
                                "value": "image-to-3d"
                            },
                            {
                                "label": "Vision",
                                "value": "vision"
                            },
                            {
                                "label": "LLM",
                                "value": "llm"
                            },
                            {
                                "label": "Training",
                                "value": "training"
                            }
                        ]
                    },
                    "status": {
                        "type": "text",
                        "index": 2,
                        "label": "Status",
                        "tooltip": "Filter models by status, for example <code>active</code>."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 3,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether to receive the result set as one complete list, first item only, or one item at a time.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/fal/core/FindModels?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
