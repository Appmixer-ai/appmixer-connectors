{
    "name": "appmixer.fal.core.CancelRequest",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Cancel a queued fal request (best-effort). Provide the Cancel URL returned by Submit Request, or the Model Endpoint Id together with the Request Id. A request already in progress may not stop.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:fal"
    },
    "quota": {
        "manager": "appmixer:fal",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "cancelUrl": {
                        "type": "string",
                        "example": "https://queue.fal.run/fal-ai/flux/schnell/requests/764cabcf-b745-4b3e-ae38-1200304cf45b/cancel"
                    },
                    "endpointId": {
                        "type": "string",
                        "example": "fal-ai/flux/schnell"
                    },
                    "requestId": {
                        "type": "string",
                        "example": "764cabcf-b745-4b3e-ae38-1200304cf45b"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "cancelUrl": {
                        "type": "text",
                        "index": 0,
                        "label": "Cancel URL",
                        "tooltip": "The cancel_url returned by Submit Request. If provided, Model Endpoint Id and Request Id are ignored."
                    },
                    "endpointId": {
                        "type": "text",
                        "index": 1,
                        "label": "Model Endpoint Id",
                        "tooltip": "Required if Cancel URL is not provided."
                    },
                    "requestId": {
                        "type": "text",
                        "index": 2,
                        "label": "Request Id",
                        "tooltip": "Required if Cancel URL is not provided."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
