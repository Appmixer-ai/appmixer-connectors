{
    "name": "appmixer.fal.core.GetRequestStatus",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get the status of a queued fal request. Provide the Status URL returned by Submit Request, or the Model Endpoint Id together with the Request Id.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:fal"
    },
    "quota": {
        "manager": "appmixer:fal",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "statusUrl": {
                        "type": "string",
                        "example": "https://queue.fal.run/fal-ai/flux/schnell/requests/764cabcf-b745-4b3e-ae38-1200304cf45b/status"
                    },
                    "endpointId": {
                        "type": "string",
                        "example": "fal-ai/flux/schnell"
                    },
                    "requestId": {
                        "type": "string",
                        "example": "764cabcf-b745-4b3e-ae38-1200304cf45b"
                    },
                    "includeLogs": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "statusUrl": {
                        "type": "text",
                        "index": 0,
                        "label": "Status URL",
                        "tooltip": "The status_url returned by Submit Request. If provided, Model Endpoint Id and Request Id are ignored."
                    },
                    "endpointId": {
                        "type": "text",
                        "index": 1,
                        "label": "Model Endpoint Id",
                        "tooltip": "Required if Status URL is not provided."
                    },
                    "requestId": {
                        "type": "text",
                        "index": 2,
                        "label": "Request Id",
                        "tooltip": "Required if Status URL is not provided."
                    },
                    "includeLogs": {
                        "type": "toggle",
                        "index": 3,
                        "label": "Include Logs",
                        "defaultValue": false,
                        "tooltip": "Include execution logs in the response (adds ?logs=1)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "IN_PROGRESS"
                    },
                    "queuePosition": {
                        "type": "integer",
                        "title": "Queue Position",
                        "example": 3
                    },
                    "logs": {
                        "type": "array",
                        "title": "Logs",
                        "example": [
                            {
                                "message": "Generating image..."
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "title": "Message",
                                    "example": "Generating image..."
                                }
                            }
                        }
                    },
                    "responseUrl": {
                        "type": "string",
                        "title": "Response URL",
                        "example": "https://queue.fal.run/fal-ai/flux/schnell/requests/764cabcf-b745-4b3e-ae38-1200304cf45b"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
