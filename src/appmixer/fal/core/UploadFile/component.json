{
    "name": "appmixer.fal.core.UploadFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Upload a file to the fal CDN and return a public URL that can be passed as a model input (for image, audio or video inputs).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:fal"
    },
    "quota": {
        "manager": "appmixer:fal",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string",
                        "example": "image/png"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "index": 0,
                        "label": "File",
                        "tooltip": "The file to upload to the fal CDN."
                    },
                    "contentType": {
                        "type": "text",
                        "index": 1,
                        "label": "Content Type",
                        "tooltip": "Optional MIME type override, for example <code>image/png</code>. Defaults to the file's stored content type."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://v3.fal.media/files/penguin/abc123.png"
                    },
                    "contentType": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "image/png"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "photo.png"
                    },
                    "size": {
                        "type": "integer",
                        "title": "Size",
                        "example": 20481
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
