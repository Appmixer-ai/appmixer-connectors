{
    "name": "appmixer.azuredevops.core.CreateWorkItem",
    "label": "Create Work Item",
    "description": "Create a new work item (Bug, Task, User Story, etc.) in an Azure DevOps project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organization": {
                        "type": "string"
                    },
                    "project": {
                        "type": "string"
                    },
                    "workItemType": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "assignedTo": {
                        "type": "string"
                    },
                    "areaPath": {
                        "type": "string"
                    },
                    "iterationPath": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": ["organization", "project", "workItemType", "title"]
            },
            "inspector": {
                "inputs": {
                    "organization": {
                        "type": "text",
                        "index": 1,
                        "label": "Organization",
                        "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                    },
                    "project": {
                        "type": "text",
                        "index": 2,
                        "label": "Project",
                        "tooltip": "The name or ID of the Azure DevOps project."
                    },
                    "workItemType": {
                        "type": "select",
                        "index": 3,
                        "label": "Work Item Type",
                        "tooltip": "The type of work item to create.",
                        "options": [
                            { "label": "Bug", "value": "Bug" },
                            { "label": "Task", "value": "Task" },
                            { "label": "User Story", "value": "User Story" },
                            { "label": "Feature", "value": "Feature" },
                            { "label": "Epic", "value": "Epic" },
                            { "label": "Issue", "value": "Issue" },
                            { "label": "Test Case", "value": "Test Case" }
                        ]
                    },
                    "title": {
                        "type": "text",
                        "index": 4,
                        "label": "Title",
                        "tooltip": "The title of the work item."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Description",
                        "tooltip": "A detailed description of the work item. HTML is supported."
                    },
                    "priority": {
                        "type": "number",
                        "index": 6,
                        "label": "Priority",
                        "tooltip": "Priority of the work item. Common values: 1 (Critical), 2 (High), 3 (Medium), 4 (Low)."
                    },
                    "assignedTo": {
                        "type": "text",
                        "index": 7,
                        "label": "Assigned To",
                        "tooltip": "Email address or display name of the user to assign the work item to."
                    },
                    "areaPath": {
                        "type": "text",
                        "index": 8,
                        "label": "Area Path",
                        "tooltip": "The area path for the work item (e.g. <b>MyProject\\TeamA</b>). Defaults to the project root if not specified."
                    },
                    "iterationPath": {
                        "type": "text",
                        "index": 9,
                        "label": "Iteration Path",
                        "tooltip": "The iteration path (sprint) for the work item (e.g. <b>MyProject\\Sprint 1</b>)."
                    },
                    "tags": {
                        "type": "text",
                        "index": 10,
                        "label": "Tags",
                        "tooltip": "Semicolon-separated list of tags to add to the work item (e.g. <b>security; api; critical</b>)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Work Item ID", "value": "id", "schema": { "type": "integer" } },
                { "label": "Revision", "value": "rev", "schema": { "type": "integer" } },
                { "label": "API URL", "value": "url", "schema": { "type": "string" } },
                { "label": "Title", "value": "fields.System.Title", "schema": { "type": "string" } },
                { "label": "State", "value": "fields.System.State", "schema": { "type": "string" } },
                { "label": "Work Item Type", "value": "fields.System.WorkItemType", "schema": { "type": "string" } },
                { "label": "Project", "value": "fields.System.TeamProject", "schema": { "type": "string" } },
                { "label": "Area Path", "value": "fields.System.AreaPath", "schema": { "type": "string" } },
                { "label": "Iteration Path", "value": "fields.System.IterationPath", "schema": { "type": "string" } },
                { "label": "Description", "value": "fields.System.Description", "schema": { "type": "string" } },
                { "label": "Tags", "value": "fields.System.Tags", "schema": { "type": "string" } },
                { "label": "Priority", "value": "fields.Microsoft.VSTS.Common.Priority", "schema": { "type": "integer" } },
                { "label": "Assigned To (Display Name)", "value": "fields.System.AssignedTo.displayName", "schema": { "type": "string" } },
                { "label": "Assigned To (Email)", "value": "fields.System.AssignedTo.uniqueName", "schema": { "type": "string" } },
                { "label": "Created Date", "value": "fields.System.CreatedDate", "schema": { "type": "string" } },
                { "label": "Changed Date", "value": "fields.System.ChangedDate", "schema": { "type": "string" } },
                { "label": "Created By (Display Name)", "value": "fields.System.CreatedBy.displayName", "schema": { "type": "string" } },
                { "label": "Web URL", "value": "_links.html.href", "schema": { "type": "string" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
