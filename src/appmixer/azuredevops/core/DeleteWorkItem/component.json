{
    "name": "appmixer.azuredevops.core.DeleteWorkItem",
    "label": "Delete Work Item",
    "description": "Delete a work item from Azure DevOps. The work item is moved to the recycle bin and can be restored unless permanently destroyed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organization": {
                        "type": "string"
                    },
                    "project": {
                        "type": "string"
                    },
                    "workItemId": {
                        "type": "integer"
                    }
                },
                "required": ["organization", "project", "workItemId"]
            },
            "inspector": {
                "inputs": {
                    "organization": {
                        "type": "text",
                        "index": 1,
                        "label": "Organization",
                        "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                    },
                    "project": {
                        "type": "text",
                        "index": 2,
                        "label": "Project",
                        "tooltip": "The name or ID of the Azure DevOps project."
                    },
                    "workItemId": {
                        "type": "number",
                        "index": 3,
                        "label": "Work Item ID",
                        "tooltip": "The unique numeric ID of the work item to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
