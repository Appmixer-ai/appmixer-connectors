{
    "name": "appmixer.azuredevops.core.GetWorkItem",
    "label": "Get Work Item",
    "description": "Retrieve a single work item from Azure DevOps by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:azuredevops"
    },
    "quota": {
        "manager": "appmixer:azuredevops",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organization": {
                        "type": "string"
                    },
                    "project": {
                        "type": "string"
                    },
                    "workItemId": {
                        "type": "integer"
                    }
                },
                "required": ["organization", "project", "workItemId"]
            },
            "inspector": {
                "inputs": {
                    "organization": {
                        "type": "text",
                        "index": 1,
                        "label": "Organization",
                        "tooltip": "The name of your Azure DevOps organization (e.g. <b>mycompany</b> from <i>https://dev.azure.com/mycompany</i>)."
                    },
                    "project": {
                        "type": "text",
                        "index": 2,
                        "label": "Project",
                        "tooltip": "The name or ID of the Azure DevOps project."
                    },
                    "workItemId": {
                        "type": "number",
                        "index": 3,
                        "label": "Work Item ID",
                        "tooltip": "The unique numeric ID of the work item to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Work Item ID", "value": "id" },
                { "label": "Revision", "value": "rev" },
                { "label": "API URL", "value": "url" },
                { "label": "Title", "value": "fields.System.Title" },
                { "label": "State", "value": "fields.System.State" },
                { "label": "Work Item Type", "value": "fields.System.WorkItemType" },
                { "label": "Project", "value": "fields.System.TeamProject" },
                { "label": "Area Path", "value": "fields.System.AreaPath" },
                { "label": "Iteration Path", "value": "fields.System.IterationPath" },
                { "label": "Description", "value": "fields.System.Description" },
                { "label": "Tags", "value": "fields.System.Tags" },
                { "label": "Priority", "value": "fields.Microsoft.VSTS.Common.Priority" },
                { "label": "Assigned To (Display Name)", "value": "fields.System.AssignedTo.displayName" },
                { "label": "Assigned To (Email)", "value": "fields.System.AssignedTo.uniqueName" },
                { "label": "Created Date", "value": "fields.System.CreatedDate" },
                { "label": "Changed Date", "value": "fields.System.ChangedDate" },
                { "label": "Created By (Display Name)", "value": "fields.System.CreatedBy.displayName" },
                { "label": "Reason", "value": "fields.System.Reason" },
                { "label": "Web URL", "value": "_links.html.href" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
