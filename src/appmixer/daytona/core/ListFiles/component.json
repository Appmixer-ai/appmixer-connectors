{
    "name": "appmixer.daytona.core.ListFiles",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Lists all files in a sandbox directory. Returns all files found in the specified path.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxId": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": [
                    "sandboxId"
                ]
            },
            "inspector": {
                "inputs": {
                    "sandboxId": {
                        "type": "text",
                        "label": "Sandbox ID",
                        "tooltip": "The unique identifier of the sandbox",
                        "index": 0
                    },
                    "path": {
                        "type": "text",
                        "label": "Directory Path",
                        "tooltip": "The directory path to list files from (default: /workspace)",
                        "index": 1
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, or one item at a time.",
                        "options": [
                            { "label": "First Item Only", "value": "first" },
                            { "label": "All items at once", "value": "array" },
                            { "label": "One item at a time", "value": "object" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/daytona/core/ListFiles?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
