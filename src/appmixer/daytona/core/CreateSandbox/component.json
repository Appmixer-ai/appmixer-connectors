{
    "name": "appmixer.daytona.core.CreateSandbox",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new sandbox instance with specified configuration. Sandboxes are isolated environments for running code securely.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": ""
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "language": {
                        "type": "string"
                    },
                    "image": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "env": {
                        "type": "string"
                    }
                },
                "required": [
                    "language"
                ]
            },
            "inspector": {
                "inputs": {
                    "language": {
                        "type": "select",
                        "label": "Language",
                        "tooltip": "Programming language for the sandbox",
                        "index": 0,
                        "defaultValue": "python",
                        "options": [
                            {
                                "label": "Python",
                                "value": "python"
                            },
                            {
                                "label": "Node.js",
                                "value": "node"
                            },
                            {
                                "label": "Go",
                                "value": "go"
                            },
                            {
                                "label": "Java",
                                "value": "java"
                            },
                            {
                                "label": "Ruby",
                                "value": "ruby"
                            },
                            {
                                "label": "PHP",
                                "value": "php"
                            },
                            {
                                "label": "Rust",
                                "value": "rust"
                            }
                        ]
                    },
                    "image": {
                        "type": "text",
                        "label": "Docker Image",
                        "tooltip": "Optional custom Docker/OCI image to use for the sandbox",
                        "index": 1
                    },
                    "name": {
                        "type": "text",
                        "label": "Sandbox Name",
                        "tooltip": "Optional name for the sandbox",
                        "index": 2
                    },
                    "env": {
                        "type": "textarea",
                        "label": "Environment Variables",
                        "tooltip": "Environment variables as JSON object (e.g., {\"VAR1\": \"value1\", \"VAR2\": \"value2\"})",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sandbox ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Sandbox Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Language",
                    "value": "language",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Image",
                    "value": "image",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}