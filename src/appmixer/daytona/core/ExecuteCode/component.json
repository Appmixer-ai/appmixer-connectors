{
    "name": "appmixer.daytona.core.ExecuteCode",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Executes code in a sandbox and returns the result. Supports multiple programming languages.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxId": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "timeout": {
                        "type": "integer"
                    }
                },
                "required": [
                    "sandboxId",
                    "code"
                ]
            },
            "inspector": {
                "inputs": {
                    "sandboxId": {
                        "type": "text",
                        "label": "Sandbox ID",
                        "tooltip": "The unique identifier of the sandbox where code will be executed",
                        "index": 0
                    },
                    "code": {
                        "type": "textarea",
                        "label": "Code",
                        "tooltip": "The code to execute in the sandbox",
                        "index": 1
                    },
                    "timeout": {
                        "type": "number",
                        "label": "Timeout (seconds)",
                        "tooltip": "Maximum execution time in seconds (optional)",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Result", "value": "result", "schema": { "type": "string" } },
                { "label": "Exit Code", "value": "exitCode", "schema": { "type": "integer" } },
                { "label": "Stdout", "value": "stdout", "schema": { "type": "string" } },
                { "label": "Stderr", "value": "stderr", "schema": { "type": "string" } },
                { "label": "Execution Time", "value": "executionTime", "schema": { "type": "number" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
