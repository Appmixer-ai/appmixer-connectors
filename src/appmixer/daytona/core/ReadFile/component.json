{
    "name": "appmixer.daytona.core.ReadFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Reads the content of a file from the sandbox filesystem.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxId": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    }
                },
                "required": [
                    "sandboxId",
                    "path"
                ]
            },
            "inspector": {
                "inputs": {
                    "sandboxId": {
                        "type": "text",
                        "label": "Sandbox ID",
                        "tooltip": "The unique identifier of the sandbox",
                        "index": 0
                    },
                    "path": {
                        "type": "text",
                        "label": "File Path",
                        "tooltip": "The path of the file to read (e.g., /workspace/file.txt)",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Content", "value": "content", "schema": { "type": "string" } },
                { "label": "Path", "value": "path", "schema": { "type": "string" } },
                { "label": "Size", "value": "size", "schema": { "type": "integer" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
