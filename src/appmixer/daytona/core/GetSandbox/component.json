{
    "name": "appmixer.daytona.core.GetSandbox",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves detailed information about a specific sandbox by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": ""
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxId": {
                        "type": "string"
                    }
                },
                "required": [
                    "sandboxId"
                ]
            },
            "inspector": {
                "inputs": {
                    "sandboxId": {
                        "type": "text",
                        "label": "Sandbox ID",
                        "tooltip": "The unique identifier of the sandbox",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sandbox ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Sandbox Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Language",
                    "value": "language",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Image",
                    "value": "image",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}