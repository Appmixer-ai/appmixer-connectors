{
    "name": "appmixer.daytona.core.StartSandbox",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Starts a stopped sandbox, making it available for code execution.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:daytona"
    },
    "quota": {
        "manager": "appmixer:daytona",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sandboxId": {
                        "type": "string"
                    }
                },
                "required": [
                    "sandboxId"
                ]
            },
            "inspector": {
                "inputs": {
                    "sandboxId": {
                        "type": "text",
                        "label": "Sandbox ID",
                        "tooltip": "The unique identifier of the sandbox to start",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Sandbox ID", "value": "id", "schema": { "type": "string" } },
                { "label": "Status", "value": "status", "schema": { "type": "string" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
