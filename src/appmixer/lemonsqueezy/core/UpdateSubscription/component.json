{
    "name": "appmixer.lemonsqueezy.core.UpdateSubscription",
    "label": "Update Subscription",
    "description": "Update an existing subscription's billing information, pause/unpause, or change other settings.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:lemonsqueezy"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subscriptionId": {
                        "type": "string",
                        "title": "Subscription ID",
                        "description": "The ID of the subscription to update"
                    },
                    "paused": {
                        "type": "boolean",
                        "title": "Paused",
                        "description": "Whether the subscription should be paused"
                    },
                    "billingAnchor": {
                        "type": "integer",
                        "title": "Billing Anchor",
                        "description": "Day of the month for billing anchor (1-31)"
                    },
                    "proration": {
                        "type": "boolean",
                        "title": "Proration",
                        "description": "Whether to apply proration when changing billing anchor"
                    }
                },
                "required": ["subscriptionId"]
            },
            "inspector": {
                "inputs": {
                    "subscriptionId": {
                        "label": "Subscription ID",
                        "type": "text",
                        "index": 1,
                        "tooltip": "Enter the ID of the subscription you want to update"
                    },
                    "paused": {
                        "label": "Paused",
                        "type": "toggle",
                        "index": 2,
                        "tooltip": "Toggle to pause or unpause the subscription"
                    },
                    "billingAnchor": {
                        "label": "Billing Anchor",
                        "type": "number",
                        "index": 3,
                        "tooltip": "Day of the month for billing anchor (1-31)"
                    },
                    "proration": {
                        "label": "Proration",
                        "type": "toggle",
                        "index": 4,
                        "tooltip": "Whether to apply proration when changing billing anchor"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Subscription ID", "value": "id" },
                { "label": "Store ID", "value": "storeId" },
                { "label": "Customer ID", "value": "customerId" },
                { "label": "Order ID", "value": "orderId" },
                { "label": "Product ID", "value": "productId" },
                { "label": "Variant ID", "value": "variantId" },
                { "label": "Status", "value": "status" },
                { "label": "Paused", "value": "paused" },
                { "label": "Billing Anchor", "value": "billingAnchor" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" },
                { "label": "Ends At", "value": "endsAt" },
                { "label": "Renews At", "value": "renewsAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
