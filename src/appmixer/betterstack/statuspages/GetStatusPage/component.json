{
    "name": "appmixer.betterstack.statuspages.GetStatusPage",
    "description": "Retrieve a specific status page by ID from Better Stack Uptime.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "statusPageId": { "type": "string" }
                },
                "required": ["statusPageId"]
            },
            "inspector": {
                "inputs": {
                    "statusPageId": {
                        "type": "text",
                        "index": 1,
                        "label": "Status Page ID",
                        "tooltip": "The ID of the status page to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Status Page ID", "value": "id" },
                { "label": "Company Name", "value": "company_name" },
                { "label": "Company URL", "value": "company_url" },
                { "label": "Contact URL", "value": "contact_url" },
                { "label": "Logo URL", "value": "logo_url" },
                { "label": "Timezone", "value": "timezone" },
                { "label": "Subdomain", "value": "subdomain" },
                { "label": "Custom Domain", "value": "custom_domain" },
                { "label": "Custom CSS", "value": "custom_css" },
                { "label": "Custom JavaScript", "value": "custom_javascript" },
                { "label": "Google Analytics ID", "value": "google_analytics_id" },
                { "label": "Min Incident Length", "value": "min_incident_length" },
                { "label": "Announcement", "value": "announcement" },
                { "label": "Announcement Embed Visible", "value": "announcement_embed_visible" },
                { "label": "Announcement Embed CSS", "value": "announcement_embed_css" },
                { "label": "Announcement Embed Link", "value": "announcement_embed_link" },
                { "label": "Automatic Reports", "value": "automatic_reports" },
                { "label": "Status Page Group ID", "value": "status_page_group_id" },
                { "label": "Subscribable", "value": "subscribable" },
                { "label": "Hide from Search Engines", "value": "hide_from_search_engines" },
                { "label": "Password Enabled", "value": "password_enabled" },
                { "label": "History Days", "value": "history" },
                { "label": "Aggregate State", "value": "aggregate_state" },
                { "label": "Design", "value": "design" },
                { "label": "Theme", "value": "theme" },
                { "label": "Layout", "value": "layout" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" }
            ]
        }
    ]
}
