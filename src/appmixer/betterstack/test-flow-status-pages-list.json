{
    "name": "E2E Better Stack - status pages list",
    "description": "End-to-end test for Better Stack - tests status pages list and find operations",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "list-first": {
            "type": "appmixer.betterstack.statuspages.ListStatusPages",
            "x": 300,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-first": {
            "type": "appmixer.utils.test.Assert",
            "x": 500,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-first": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-first": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "id-check": {
                                            "variable": "$.list-first.out.id",
                                            "functions": []
                                        },
                                        "index-check": {
                                            "variable": "$.list-first.out.index",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{id-check}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{index-check}}}",
                                                "assertion": "equal",
                                                "expected": "0"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-array": {
            "type": "appmixer.betterstack.statuspages.ListStatusPages",
            "x": 300,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-array": {
            "type": "appmixer.utils.test.Assert",
            "x": 500,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-array": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-array": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "count-check": {
                                            "variable": "$.list-array.out.count",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{count-check}}}",
                                                "assertion": "regex",
                                                "expected": "^[0-9]+$"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 700,
            "y": 300,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-first": ["out"],
                    "assert-array": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 900,
            "y": 300,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Better Stack - status pages list",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
