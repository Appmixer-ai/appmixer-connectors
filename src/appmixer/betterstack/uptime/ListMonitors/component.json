{
    "name": "appmixer.betterstack.uptime.ListMonitors",
    "description": "List Better Stack Uptime monitors (first page from API).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Monitors",
                    "value": "monitors"
                },
                {
                    "label": "Count",
                    "value": "count"
                }
            ]
        }
    ],
    "icon": "https://betterstack.com/favicon.ico"
}
