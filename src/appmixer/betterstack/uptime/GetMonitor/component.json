{
    "name": "appmixer.betterstack.uptime.GetMonitor",
    "description": "Get a Better Stack Uptime monitor by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "monitorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Monitor ID", "value": "id" },
                { "label": "Monitor Name", "value": "pronounceable_name" },
                { "label": "URL", "value": "url" },
                { "label": "Monitor Type", "value": "monitor_type" },
                { "label": "Paused", "value": "paused" },
                { "label": "Check Frequency", "value": "check_frequency" }
            ]
        }
    ],
    "icon": "https://betterstack.com/favicon.ico"
}
