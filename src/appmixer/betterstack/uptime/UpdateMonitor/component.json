{
    "name": "appmixer.betterstack.uptime.UpdateMonitor",
    "description": "Update an existing Better Stack Uptime monitor.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    },
                    "monitorName": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "monitorType": {
                        "type": "string"
                    },
                    "checkFrequency": {
                        "type": "integer"
                    },
                    "paused": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "monitorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1
                    },
                    "monitorName": {
                        "type": "text",
                        "label": "Monitor Name",
                        "index": 2
                    },
                    "url": {
                        "type": "text",
                        "label": "URL",
                        "index": 3
                    },
                    "monitorType": {
                        "type": "select",
                        "label": "Monitor Type",
                        "index": 4,
                        "options": [
                            {
                                "label": "Status",
                                "value": "status"
                            },
                            {
                                "label": "Expected Status Code",
                                "value": "expected_status_code"
                            },
                            {
                                "label": "Keyword",
                                "value": "keyword"
                            },
                            {
                                "label": "Ping",
                                "value": "ping"
                            }
                        ]
                    },
                    "checkFrequency": {
                        "type": "number",
                        "label": "Check Frequency (seconds)",
                        "index": 5
                    },
                    "paused": {
                        "type": "toggle",
                        "label": "Paused",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Monitor ID", "value": "id" },
                { "label": "Monitor Name", "value": "pronounceable_name" },
                { "label": "URL", "value": "url" },
                { "label": "Monitor Type", "value": "monitor_type" },
                { "label": "Paused", "value": "paused" },
                { "label": "Check Frequency", "value": "check_frequency" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
