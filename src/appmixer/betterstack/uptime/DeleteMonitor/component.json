{
    "name": "appmixer.betterstack.uptime.DeleteMonitor",
    "description": "Delete a Better Stack Uptime monitor by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    }
                },
                "required": [
                    "monitorId"
                ]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "https://betterstack.com/favicon.ico"
}
