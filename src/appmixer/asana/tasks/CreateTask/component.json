{
    "name": "appmixer.asana.tasks.CreateTask",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "This component create a new task.",
    "private": false,
    "auth": {
        "service": "appmixer:asana"
    },
    "quota": {
        "manager": "appmixer:asana",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "task",
            "schema": {
                "type": "object",
                "properties": {
                    "workspace": { "type": "string" },
                    "name": { "type": "string" },
                    "project": { "type": "string" },
                    "assignee": { "type": "string" },
                    "note": { "type": "string" },
                    "dueOnDate": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/Date"
                            },
                            {
                                "$ref": "#/definitions/DateTime"
                            }
                        ]
                    },
                    "hearted": { "type": "boolean" },
                    "completed": { "type": "boolean" }
                },
                "required": [
                    "workspace", "name", "project"
                ],
                "definitions": {
                    "Date": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0|1][0-9]-[0-3][0-9]$"
                    },
                    "DateTime": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "workspace": {
                        "type": "select",
                        "label": "Workspace",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/asana/tasks/ListWorkspaces?outPort=workspaces",
                            "data": {
                                "transform": "./transformers#workspacesToSelectArray"
                            }
                        },
                        "tooltip": "Select workspace."
                    },
                    "project": {
                        "type": "select",
                        "label": "Project",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/asana/tasks/ListProjects?outPort=projects",
                            "data": {
                                "messages": {
                                    "in/workspace": "inputs/task/workspace"
                                },
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        },
                        "tooltip": "Select project."
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "Task name.",
                        "label": "Name",
                        "index": 3
                    },
                    "assignee": {
                        "type": "select",
                        "label": "Assignee",
                        "index": 4,
                        "source": {
                            "url": "/component/appmixer/asana/tasks/ListUsers?outPort=users",
                            "data": {
                                "properties": {
                                    "ignoreErrors": true
                                },
                                "messages": {
                                    "in/workspace": "inputs/task/workspace"
                                },
                                "transform": "./transformers#usersToSelectArray"
                            }
                        },
                        "tooltip": "Select assignee."
                    },
                    "note": {
                        "type": "textarea",
                        "tooltip": "Task note.",
                        "label": "Note",
                        "index": 5
                    },
                    "dueOnDate": {
                        "type": "date-time",
                        "tooltip": "The day on which this task is due.",
                        "label": "Due on date",
                        "index": 6
                    },
                    "hearted": {
                        "type": "toggle",
                        "label": "Hearted",
                        "index": 7,
                        "tooltip": "Turn it on to heart the task by the authorized user."
                    },
                    "completed": {
                        "type": "toggle",
                        "label": "Completed",
                        "index": 8,
                        "tooltip": "Turn it on to mark the task complete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newTask",
            "options": [
                { "label": "assignee.gid", "value": "assignee.gid", "schema": { "type": "string", "example": "1200000000000099" } },
                { "label": "assignee.name", "value": "assignee.name", "schema": { "type": "string", "example": "Emma Davis" } },
                { "label": "assignee_status", "value": "assignee_status", "schema": { "type": "string", "example": "upcoming" } },
                { "label": "completed", "value": "completed", "schema": { "type": "boolean", "example": false } },
                { "label": "completed_at", "value": "completed_at", "schema": { "type": "string", "example": "2024-02-20T14:45:00.000Z" } },
                { "label": "created_at", "value": "created_at", "schema": { "type": "string", "example": "2024-01-15T10:30:00.000Z" } },
                { "label": "due_at", "value": "due_at", "schema": { "type": "string", "example": "2024-03-15T17:00:00.000Z" } },
                { "label": "due_on", "value": "due_on", "schema": { "type": "string", "example": "2024-03-15" } },
                { "label": "hearted", "value": "hearted", "schema": { "type": "boolean", "example": false } },
                { "label": "gid", "value": "gid", "schema": { "type": "string", "example": "1205329708123456" } },
                { "label": "modified_at", "value": "modified_at", "schema": { "type": "string", "example": "2024-02-20T14:45:00.000Z" } },
                { "label": "name", "value": "name", "schema": { "type": "string", "example": "Implement login page" } },
                { "label": "notes", "value": "notes", "schema": { "type": "string", "example": "Build the authentication flow for the web app." } },
                { "label": "num_hearts", "value": "num_hearts", "schema": { "type": "number", "example": 3 } },
                { "label": "parent", "value": "parent", "schema": { "type": "object", "example": null } },
                { "label": "workspace.gid", "value": "workspace.gid", "schema": { "type": "string", "example": "1200000000000001" } },
                { "label": "workspace.name", "value": "workspace.name", "schema": { "type": "string", "example": "My Workspace" } }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
