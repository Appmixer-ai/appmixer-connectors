{
    "name": "appmixer.asana.projects.NewProject",
    "author": "Tomasz Hencel <thencel@ntrc.eu>",
    "description": "This trigger fires every time a new project is added.",
    "private": false,
    "auth": {
        "service": "appmixer:asana"
    },
    "tick": true,
    "quota": {
        "manager": "appmixer:asana",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "project",
            "options": [
                { "label": "archived", "value": "archived", "schema": { "type": "boolean", "example": false } },
                { "label": "color", "value": "color", "schema": { "type": "string", "example": "dark-blue" } },
                { "label": "created_at", "value": "created_at", "schema": { "type": "string", "example": "2024-01-15T10:30:00.000Z" } },
                { "label": "current_status.author.gid", "value": "current_status.author.gid", "schema": { "type": "string", "example": "1200000000000099" } },
                { "label": "current_status.author.name", "value": "current_status.author.name", "schema": { "type": "string", "example": "Emma Davis" } },
                { "label": "current_status.color", "value": "current_status.color", "schema": { "type": "string", "example": "green" } },
                { "label": "current_status.modified_at", "value": "current_status.modified_at", "schema": { "type": "string", "example": "2024-02-20T14:45:00.000Z" } },
                { "label": "current_status.text", "value": "current_status.text", "schema": { "type": "string", "example": "On track" } },
                { "label": "due_date", "value": "due_on", "schema": { "type": "string", "example": "2024-03-31" } },
                { "label": "gid", "value": "gid", "schema": { "type": "string", "example": "1205329708123456" } },
                { "label": "modified_at", "value": "modified_at", "schema": { "type": "string", "example": "2024-02-20T14:45:00.000Z" } },
                { "label": "name", "value": "name", "schema": { "type": "string", "example": "Website Redesign" } },
                { "label": "notes", "value": "notes", "schema": { "type": "string", "example": "Project notes and details go here." } },
                { "label": "owner.gid", "value": "owner.gid", "schema": { "type": "string", "example": "1200000000000099" } },
                { "label": "owner.name", "value": "owner.name", "schema": { "type": "string", "example": "Emma Davis" } },
                { "label": "public", "value": "public", "schema": { "type": "boolean", "example": true } },
                { "label": "workspace.gid", "value": "workspace.gid", "schema": { "type": "string", "example": "1200000000000001" } },
                { "label": "workspace.name", "value": "workspace.name", "schema": { "type": "string", "example": "My Workspace" } }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "workspace": { "type": "string" }
            },
            "required": [
                "workspace"
            ]
        },
        "inspector": {
            "inputs": {
                "workspace": {
                    "type": "select",
                    "group": "config",
                    "label": "Workspace",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/asana/tasks/ListWorkspaces?outPort=workspaces",
                        "data": {
                            "transform": "./transformers#workspacesToSelectArray"
                        }
                    },
                    "tooltip": "Select a workspace."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
