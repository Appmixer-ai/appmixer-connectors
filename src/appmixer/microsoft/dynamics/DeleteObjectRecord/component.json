{
    "name": "appmixer.microsoft.dynamics.DeleteObjectRecord",
    "author": "AppMixer <info@appmixer.com>",
    "label": "Delete Object Record",
    "description": "Deletes an existing object based on Entity type you select using API v9.2.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft:dynamics",
        "scope": []
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "source": {
                "url": "/component/appmixer/microsoft/dynamics/DeleteObjectRecord?outPort=out",
                "data": {
                    "properties": {
                        "generateInspector": true,
                        "objectName": "inputs/in/objectName"
                    }
                },
                "messages": {
                    "in/objectName": {
                        "source": {
                            "url": "/component/appmixer/microsoft/dynamics/DeleteObjectRecord?outPort=out",
                            "data": {
                                "properties": {
                                    "listDefaultEntities": true
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "example": "e5f6a7b8-c9d0-1234-efab-456789012345"
                    }
                },
                {
                    "label": "Object Name",
                    "value": "objectName",
                    "schema": {
                        "example": "account"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "example": "204"
                    }
                },
                {
                    "label": "Status Text",
                    "value": "statusText",
                    "schema": {
                        "example": "No Content"
                    }
                },
                {
                    "label": "Errors",
                    "value": "errors",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {}
                        },
                        "example": []
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
