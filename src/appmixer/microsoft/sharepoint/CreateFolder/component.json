{
    "name": "appmixer.microsoft.sharepoint.CreateFolder",
    "label": "Create Folder",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Create a folder in Microsoft SharePoint.",
    "private": false,
    "auth": {
        "service": "appmixer:microsoft",
        "scope": ["Files.ReadWrite.All"]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "driveId": {
                        "type": "string"
                    },
                    "siteId": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "parentPath": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": ["driveId", "siteId", "name"]
            },
            "inspector": {
                "inputs": {
                    "siteId": {
                        "type": "text",
                        "label": " Site ID",
                        "group": "drive",
                        "index": 1,
                        "tooltip": "Provide a site ID.",
                        "source": {
                            "url": "/component/appmixer/microsoft/sharepoint/ListSites?outPort=out",
                            "data": {
                                "transform": "./ListSites#sitesToSelectArray"
                            }
                        }
                    },
                    "driveId": {
                        "type": "text",
                        "index": 2,
                        "label": "Drive ID",
                        "group": "drive",
                        "tooltip": "ID of the drive where the file is located.",
                        "source": {
                            "url": "/component/appmixer/microsoft/sharepoint/ListDrives?outPort=out",
                            "data": {
                                "messages": {
                                    "in/siteId": "inputs/in/siteId"
                                },
                                "transform": "./ListDrives#drivesToSelectArray"
                            }
                        }
                    },
                    "parentId": {
                        "type": "text",
                        "index": 3,
                        "label": "Parent ID",
                        "group": "parent",
                        "tooltip": "Specify the ID of the parent folder. Leave empty to use 'root' as the parent."
                    },
                    "parentPath": {
                        "type": "text",
                        "index": 4,
                        "label": "Parent Path",
                        "group": "parent",
                        "tooltip": "Specify the path of the parent folder<b>(Ignored if 'Parent ID' is set)</b>. Leave empty to use 'root' as the parent. Example: <code>path/to/parent/folder</code>"
                    },
                    "name": {
                        "type": "text",
                        "index": 5,
                        "label": "Folder Name",
                        "tooltip": "Specify the name of the folder to create."
                    }
                },
                "groups": {
                    "drive": {
                      "label": "Drive",
                      "index": 1
                    },
                    "parent": {
                      "label": "Parent",
                      "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Folder ID", "value": "id" },
                { "label": "Name", "value": "name" },
                { "label": "Created Date Time", "value": "createdDateTime" },
                { "label": "C Tag", "value": "cTag" },
                { "label": "E Tag", "value": "eTag" },
                { "label": "Last Modified Date Time", "value": "lastModifiedDateTime" },
                { "label": "Size", "value": "size" },
                { "label": "Web URL", "value": "webUrl" },
                { "label": "created By User ID", "value": "createdBy.user.id" },
                { "label": "created By User DisplayName", "value": "createdBy.user.displayName" },
                { "label": "Last Modified By ID", "value": "lastModifiedBy.user.id" },
                {
                    "label": "Last Modified By DisplayName",
                    "value": "lastModifiedBy.user.displayName"
                },
                { "label": "Parent Reference Drive ID", "value": "parentReference.driveId" },
                { "label": "Parent Reference Drive Type", "value": "parentReference.driveType" },
                { "label": "Parent Reference Drive Path", "value": "parentReference.path" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
