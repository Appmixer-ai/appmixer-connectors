{
    "name": "appmixer.microsoft.teams.DeleteMessage",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Delete Message",
    "description": "Deletes a message in a team channel or in a chat. Microsoft Teams shows \"This message has been deleted\" in its place. Requires tenant admin consent for the ChannelMessage.ReadWrite permission when deleting channel messages.",
    "auth": {
        "service": "appmixer:microsoft",
        "scope": [
            "ChannelMessage.ReadWrite",
            "Chat.ReadWrite"
        ]
    },
    "quota": {
        "manager": "appmixer:microsoft:teams",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "location": {
                        "type": "string",
                        "enum": [
                            "channel",
                            "chat"
                        ]
                    },
                    "teamId": {
                        "type": "string"
                    },
                    "channelId": {
                        "type": "string"
                    },
                    "chatId": {
                        "type": "string"
                    },
                    "messageId": {
                        "type": "string"
                    },
                    "parentMessageId": {
                        "type": "string"
                    }
                },
                "required": [
                    "messageId"
                ]
            },
            "inspector": {
                "inputs": {
                    "location": {
                        "type": "select",
                        "label": "Location",
                        "index": 1,
                        "defaultValue": "channel",
                        "tooltip": "Whether the message is in a team channel or in a chat. Deleting a channel message requires tenant admin consent for the ChannelMessage.ReadWrite permission.",
                        "options": [
                            {
                                "label": "Channel",
                                "value": "channel"
                            },
                            {
                                "label": "Chat",
                                "value": "chat"
                            }
                        ]
                    },
                    "teamId": {
                        "type": "text",
                        "label": "Team",
                        "index": 2,
                        "tooltip": "Required for a channel message. Pick a team, or enter a Team ID directly.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListTeams?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListTeams#toSelectArray"
                            }
                        }
                    },
                    "channelId": {
                        "type": "text",
                        "label": "Channel",
                        "index": 3,
                        "tooltip": "Required for a channel message. Pick a channel of the selected team, or enter a Channel ID directly.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListChannels?outPort=out",
                            "data": {
                                "messages": {
                                    "in/teamId": "inputs/in/teamId",
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListChannels#toSelectArray"
                            }
                        }
                    },
                    "chatId": {
                        "type": "text",
                        "label": "Chat",
                        "index": 4,
                        "tooltip": "Required for a chat message. Pick a chat, or enter a Chat ID directly.",
                        "when": {
                            "eq": {
                                "./location": "chat"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListChats?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListChats#toSelectArray"
                            }
                        }
                    },
                    "messageId": {
                        "type": "text",
                        "label": "Message ID",
                        "index": 5,
                        "tooltip": "Required. The ID of the message to delete, for example <code>1616990032035</code>. You can delete only messages you sent."
                    },
                    "parentMessageId": {
                        "type": "text",
                        "label": "Parent Message ID",
                        "index": 6,
                        "tooltip": "Optional. Set this when the message is a reply in a channel: the ID of the message the reply belongs to.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
