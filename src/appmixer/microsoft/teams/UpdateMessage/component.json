{
    "name": "appmixer.microsoft.teams.UpdateMessage",
    "author": "Appmixer <info@appmixer.com>",
    "label": "Update Message",
    "description": "Edits the text of a message in a team channel or in a chat. Requires tenant admin consent for the ChannelMessage.ReadWrite permission when editing channel messages. Works only in the global Microsoft cloud, and fails for chats that include a Skype user.",
    "auth": {
        "service": "appmixer:microsoft",
        "scope": [
            "ChannelMessage.ReadWrite",
            "Chat.ReadWrite"
        ]
    },
    "quota": {
        "manager": "appmixer:microsoft:teams",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "location": {
                        "type": "string",
                        "enum": [
                            "channel",
                            "chat"
                        ]
                    },
                    "teamId": {
                        "type": "string"
                    },
                    "channelId": {
                        "type": "string"
                    },
                    "chatId": {
                        "type": "string"
                    },
                    "messageId": {
                        "type": "string"
                    },
                    "parentMessageId": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string",
                        "enum": [
                            "text",
                            "html"
                        ]
                    }
                },
                "required": [
                    "messageId",
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "location": {
                        "type": "select",
                        "label": "Location",
                        "index": 1,
                        "defaultValue": "channel",
                        "tooltip": "Whether the message is in a team channel or in a chat. Editing a channel message requires tenant admin consent for the ChannelMessage.ReadWrite permission.",
                        "options": [
                            {
                                "label": "Channel",
                                "value": "channel"
                            },
                            {
                                "label": "Chat",
                                "value": "chat"
                            }
                        ]
                    },
                    "teamId": {
                        "type": "text",
                        "label": "Team",
                        "index": 2,
                        "tooltip": "Required for a channel message. Pick a team, or enter a Team ID directly.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListTeams?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListTeams#toSelectArray"
                            }
                        }
                    },
                    "channelId": {
                        "type": "text",
                        "label": "Channel",
                        "index": 3,
                        "tooltip": "Required for a channel message. Pick a channel of the selected team, or enter a Channel ID directly.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListChannels?outPort=out",
                            "data": {
                                "messages": {
                                    "in/teamId": "inputs/in/teamId",
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListChannels#toSelectArray"
                            }
                        }
                    },
                    "chatId": {
                        "type": "text",
                        "label": "Chat",
                        "index": 4,
                        "tooltip": "Required for a chat message. Pick a chat, or enter a Chat ID directly.",
                        "when": {
                            "eq": {
                                "./location": "chat"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/microsoft/teams/ListChats?outPort=out",
                            "data": {
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                },
                                "transform": "./ListChats#toSelectArray"
                            }
                        }
                    },
                    "messageId": {
                        "type": "text",
                        "label": "Message ID",
                        "index": 5,
                        "tooltip": "Required. The ID of the message to edit, for example <code>1616990032035</code>. You can edit only messages you sent."
                    },
                    "parentMessageId": {
                        "type": "text",
                        "label": "Parent Message ID",
                        "index": 6,
                        "tooltip": "Optional. Set this when the message is a reply in a channel: the ID of the message the reply belongs to.",
                        "when": {
                            "eq": {
                                "./location": "channel"
                            }
                        }
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Content",
                        "index": 7,
                        "tooltip": "Required. The new text of the message; it replaces the whole message. Set Content Type to HTML to send rich text, for example a clickable link <code>&lt;a href=\"https://example.com\"&gt;Example&lt;/a&gt;</code>. Microsoft Teams does not support Markdown."
                    },
                    "contentType": {
                        "type": "select",
                        "label": "Content Type",
                        "index": 8,
                        "defaultValue": "text",
                        "tooltip": "The format of Content. Use HTML for rich text and clickable links.",
                        "options": [
                            {
                                "label": "Text",
                                "value": "text"
                            },
                            {
                                "label": "HTML",
                                "value": "html"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
