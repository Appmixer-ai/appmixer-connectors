{
    "name": "appmixer.pdfco.core.GetPDFInfo",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves metadata and details about a PDF file such as page count, author, and more.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:pdfco"
    },
    "quota": {
        "manager": "appmixer:pdfco",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string"
                    }
                },
                "required": [
                    "file"
                ]
            },
            "inspector": {
                "inputs": {
                    "file": {
                        "type": "text",
                        "tooltip": "The URL of the PDF file to inspect or its Base64 content.",
                        "label": "File",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Error",
                    "value": "error",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Credits",
                    "value": "credits",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Remaining Credits",
                    "value": "remainingCredits",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Duration",
                    "value": "duration",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Info",
                    "value": "info",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Page Count",
                    "value": "info.PageCount",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Author",
                    "value": "info.Author",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Title",
                    "value": "info.Title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Producer",
                    "value": "info.Producer",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Subject",
                    "value": "info.Subject",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Creation Date",
                    "value": "info.CreationDate",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Creator",
                    "value": "info.Creator",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Encrypted",
                    "value": "info.Encrypted",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Password Protected",
                    "value": "info.PasswordProtected",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,",
    "genv2": true
}