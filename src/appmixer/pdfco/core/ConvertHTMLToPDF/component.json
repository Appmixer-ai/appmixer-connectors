{
    "name": "appmixer.pdfco.core.ConvertHTMLToPDF",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Converts raw HTML code or a public URL to a PDF document.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:pdfco"
    },
    "quota": {
        "manager": "appmixer:pdfco",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "html": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "paperSize": {
                        "type": "string"
                    },
                    "orientation": {
                        "type": "string"
                    }
                },
                "required": [
                    "html",
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "html": {
                        "type": "text",
                        "tooltip": "Raw HTML content. Optional if 'url' is provided.",
                        "label": "Html",
                        "index": 0
                    },
                    "url": {
                        "type": "text",
                        "tooltip": "A public URL pointing to the HTML content. Optional if 'html' is provided.",
                        "label": "Url",
                        "index": 1
                    },
                    "paperSize": {
                        "type": "text",
                        "tooltip": "Paper size for the generated PDF (e.g., A4, Letter).",
                        "label": "Paper Size",
                        "index": 2
                    },
                    "orientation": {
                        "type": "text",
                        "tooltip": "Page orientation for the PDF (Portrait or Landscape).",
                        "label": "Orientation",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Url",
                    "value": "url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Page Count",
                    "value": "pageCount",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Error",
                    "value": "error",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Credits",
                    "value": "credits",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Remaining Credits",
                    "value": "remainingCredits",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Duration",
                    "value": "duration",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Output Link Valid Till",
                    "value": "outputLinkValidTill",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,",
    "genv2": true
}