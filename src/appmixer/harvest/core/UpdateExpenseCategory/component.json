{
    "name": "appmixer.harvest.core.UpdateExpenseCategory",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an expense category.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:harvest"
    },
    "quota": {
        "manager": "appmixer:harvest",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "expense_category_id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "unit_name": {
                        "type": "string"
                    },
                    "unit_price": {
                        "type": "number"
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "expense_category_id": {
                        "type": "number",
                        "tooltip": "The expense category ID.",
                        "label": "Expense Category Id",
                        "index": 0
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "Category name.",
                        "label": "Name",
                        "index": 1
                    },
                    "unit_name": {
                        "type": "text",
                        "tooltip": "Unit name if unit-based.",
                        "label": "Unit Name",
                        "index": 2
                    },
                    "unit_price": {
                        "type": "number",
                        "tooltip": "Unit price if unit-based.",
                        "label": "Unit Price",
                        "index": 3
                    },
                    "is_active": {
                        "type": "toggle",
                        "tooltip": "Active status.",
                        "label": "Is Active",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}