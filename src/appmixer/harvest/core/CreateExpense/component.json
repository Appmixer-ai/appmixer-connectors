{
    "name": "appmixer.harvest.core.CreateExpense",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new expense entry.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:harvest"
    },
    "quota": {
        "manager": "appmixer:harvest",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "user_id": {
                        "type": "integer"
                    },
                    "project_id": {
                        "type": "integer"
                    },
                    "expense_category_id": {
                        "type": "integer"
                    },
                    "spent_date": {
                        "type": "string"
                    },
                    "total_cost": {
                        "type": "number"
                    },
                    "units": {
                        "type": "number"
                    },
                    "is_billable": {
                        "type": "boolean"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "receipt": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "user_id": {
                        "type": "number",
                        "tooltip": "User ID. If omitted, uses authenticated user.",
                        "label": "User Id",
                        "index": 0
                    },
                    "project_id": {
                        "type": "number",
                        "tooltip": "Project ID.",
                        "label": "Project Id",
                        "index": 1
                    },
                    "expense_category_id": {
                        "type": "number",
                        "tooltip": "Expense category ID.",
                        "label": "Expense Category Id",
                        "index": 2
                    },
                    "spent_date": {
                        "type": "text",
                        "tooltip": "Date (YYYY-MM-DD).",
                        "label": "Spent Date",
                        "index": 3
                    },
                    "total_cost": {
                        "type": "number",
                        "tooltip": "Total cost amount.",
                        "label": "Total Cost",
                        "index": 4
                    },
                    "units": {
                        "type": "number",
                        "tooltip": "Units (if unit-based category).",
                        "label": "Units",
                        "index": 5
                    },
                    "is_billable": {
                        "type": "toggle",
                        "tooltip": "Billable flag.",
                        "label": "Is Billable",
                        "index": 6
                    },
                    "notes": {
                        "type": "text",
                        "tooltip": "Notes.",
                        "label": "Notes",
                        "index": 7
                    },
                    "receipt": {
                        "type": "text",
                        "tooltip": "Optional receipt file info when using uploads.",
                        "label": "Receipt",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Spent Date",
                    "value": "spent_date",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "User.Id"
                            }
                        }
                    }
                },
                {
                    "label": "Project",
                    "value": "project",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "Project.Id"
                            }
                        }
                    }
                },
                {
                    "label": "Category",
                    "value": "category",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "Category.Id"
                            }
                        }
                    }
                },
                {
                    "label": "Total Cost",
                    "value": "total_cost",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Is Billable",
                    "value": "is_billable",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Notes",
                    "value": "notes",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}