{
    "name": "appmixer.harvest.core.GetUninvoicedReport",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve uninvoiced time and expenses over a date range.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:harvest"
    },
    "quota": {
        "manager": "appmixer:harvest",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "from": {
                        "type": "string"
                    },
                    "to": {
                        "type": "string"
                    },
                    "client_id": {
                        "type": "integer"
                    },
                    "project_id": {
                        "type": "integer"
                    },
                    "user_id": {
                        "type": "integer"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "from": {
                        "type": "text",
                        "tooltip": "Start date (YYYY-MM-DD).",
                        "label": "From",
                        "index": 0
                    },
                    "to": {
                        "type": "text",
                        "tooltip": "End date (YYYY-MM-DD).",
                        "label": "To",
                        "index": 1
                    },
                    "client_id": {
                        "type": "number",
                        "tooltip": "Filter by client ID.",
                        "label": "Client Id",
                        "index": 2
                    },
                    "project_id": {
                        "type": "number",
                        "tooltip": "Filter by project ID.",
                        "label": "Project Id",
                        "index": 3
                    },
                    "user_id": {
                        "type": "number",
                        "tooltip": "Filter by user ID.",
                        "label": "User Id",
                        "index": 4
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/harvest/core/GetUninvoicedReport?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/png;base64,"
}