{
    "name": "appmixer.harvest.timeEntry.CreateTimeEntry",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new time entry. You can create entries via duration (hours) or by start and end time.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:harvest"
    },
    "quota": {
        "manager": "appmixer:harvest",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "integer"
                    },
                    "taskId": {
                        "type": "integer"
                    },
                    "spentDate": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "integer"
                    },
                    "hours": {
                        "type": "number"
                    },
                    "startedTime": {
                        "type": "string"
                    },
                    "endedTime": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "required": ["projectId", "taskId", "spentDate"]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "number",
                        "tooltip": "The ID of the project to associate with the time entry.",
                        "label": "Project ID",
                        "index": 0
                    },
                    "taskId": {
                        "type": "number",
                        "tooltip": "The ID of the task to associate with the time entry.",
                        "label": "Task ID",
                        "index": 1
                    },
                    "spentDate": {
                        "type": "date",
                        "tooltip": "The ISO 8601 formatted date the time entry was spent.",
                        "label": "Spent Date",
                        "index": 2
                    },
                    "userId": {
                        "type": "number",
                        "tooltip": "The ID of the user to associate with the time entry. Defaults to the currently authenticated user.",
                        "label": "User ID",
                        "index": 3
                    },
                    "hours": {
                        "type": "number",
                        "tooltip": "The current amount of time tracked (in decimal hours). Use this for duration-based tracking.",
                        "label": "Hours",
                        "index": 4
                    },
                    "startedTime": {
                        "type": "text",
                        "tooltip": "The time the entry started (e.g., '8:00am'). Use this for time-based tracking.",
                        "label": "Started Time",
                        "index": 5
                    },
                    "endedTime": {
                        "type": "text",
                        "tooltip": "The time the entry ended (e.g., '5:00pm'). Use this for time-based tracking.",
                        "label": "Ended Time",
                        "index": 6
                    },
                    "notes": {
                        "type": "textarea",
                        "tooltip": "Any notes to be associated with the time entry.",
                        "label": "Notes",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Spent Date",
                    "value": "spent_date",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Hours",
                    "value": "hours",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Rounded Hours",
                    "value": "rounded_hours",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Notes",
                    "value": "notes",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "User",
                    "value": "user",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "User.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "User.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Project",
                    "value": "project",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "Project.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Project.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Task",
                    "value": "task",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number",
                                "title": "Task.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Task.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Billable",
                    "value": "billable",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Billable Rate",
                    "value": "billable_rate",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Cost Rate",
                    "value": "cost_rate",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
