{
    "name": "appmixer.harvest.timeEntry.UpdateTimeEntry",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing time entry.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:harvest"
    },
    "quota": {
        "manager": "appmixer:harvest",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "timeEntryId": {
                        "type": "integer"
                    },
                    "projectId": {
                        "type": "integer"
                    },
                    "taskId": {
                        "type": "integer"
                    },
                    "spentDate": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "integer"
                    },
                    "hours": {
                        "type": "number"
                    },
                    "startedTime": {
                        "type": "string"
                    },
                    "endedTime": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    }
                },
                "required": ["timeEntryId"]
            },
            "inspector": {
                "inputs": {
                    "timeEntryId": {
                        "type": "number",
                        "label": "Time Entry ID",
                        "index": 0
                    },
                    "projectId": {
                        "type": "number",
                        "tooltip": "The ID of the project to associate with the time entry.",
                        "label": "Project ID",
                        "index": 1
                    },
                    "taskId": {
                        "type": "number",
                        "tooltip": "The ID of the task to associate with the time entry.",
                        "label": "Task ID",
                        "index": 2
                    },
                    "spentDate": {
                        "type": "date",
                        "tooltip": "The ISO 8601 formatted date the time entry was spent.",
                        "label": "Spent Date",
                        "index": 3
                    },
                    "userId": {
                        "type": "number",
                        "tooltip": "The ID of the user to associate with the time entry.",
                        "label": "User ID",
                        "index": 4
                    },
                    "hours": {
                        "type": "number",
                        "tooltip": "The current amount of time tracked (in decimal hours).",
                        "label": "Hours",
                        "index": 5
                    },
                    "startedTime": {
                        "type": "text",
                        "tooltip": "The time the entry started (e.g., '8:00am').",
                        "label": "Started Time",
                        "index": 6
                    },
                    "endedTime": {
                        "type": "text",
                        "tooltip": "The time the entry ended (e.g., '5:00pm').",
                        "label": "Ended Time",
                        "index": 7
                    },
                    "notes": {
                        "type": "textarea",
                        "tooltip": "Any notes to be associated with the time entry.",
                        "label": "Notes",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": ["out"],
    "icon": "data:image/png;base64,"
}
