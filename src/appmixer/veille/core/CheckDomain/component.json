{
    "name": "appmixer.veille.core.CheckDomain",
    "label": "Check Domain",
    "description": "Check a domain: MX records and mail provider, disposable or temporary domain, and risk signals.",
    "author": "Veille <josselin@veille.io>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:veille"
    },
    "quota": {
        "manager": "appmixer:veille",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "domain": {
                        "type": "string"
                    }
                },
                "required": [
                    "domain"
                ]
            },
            "inspector": {
                "inputs": {
                    "domain": {
                        "type": "text",
                        "index": 1,
                        "label": "Domain",
                        "tooltip": "The domain name, for example <code>example.com</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "dns": {
                        "type": "object",
                        "title": "DNS"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
