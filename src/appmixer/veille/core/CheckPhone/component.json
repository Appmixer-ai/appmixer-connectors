{
    "name": "appmixer.veille.core.CheckPhone",
    "label": "Check Phone Number",
    "description": "Check a phone number: validity, country, line type, carrier and risk score.",
    "author": "Veille <josselin@veille.io>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:veille"
    },
    "quota": {
        "manager": "appmixer:veille",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string"
                    }
                },
                "required": [
                    "phone"
                ]
            },
            "inspector": {
                "inputs": {
                    "phone": {
                        "type": "text",
                        "index": 1,
                        "label": "Phone Number",
                        "tooltip": "Phone number in international format, for example <code>+33612345678</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "is_valid": {
                        "type": "boolean",
                        "title": "Valid",
                        "example": true
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "FR"
                    },
                    "line_type": {
                        "type": "string",
                        "title": "Line Type",
                        "example": "mobile"
                    },
                    "carrier": {
                        "type": "string",
                        "title": "Carrier",
                        "example": "SFR"
                    },
                    "risk_score": {
                        "type": "number",
                        "title": "Risk Score",
                        "example": 30
                    },
                    "e164_format": {
                        "type": "string",
                        "title": "E.164 Format",
                        "example": "+33612345678"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
