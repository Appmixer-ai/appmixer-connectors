{
    "name": "appmixer.upsales.core.CreateTicket",
    "label": "Create Ticket",
    "description": "Create a support ticket with a status and a type. Requires the Customer Support product in Upsales.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": [
            "requests",
            "writes"
        ],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "statusId": {
                        "type": "string"
                    },
                    "typeId": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "number"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "statusId",
                    "typeId"
                ]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "index": 1,
                        "label": "Title",
                        "tooltip": "What the ticket is about, up to 150 characters."
                    },
                    "statusId": {
                        "type": "text",
                        "index": 2,
                        "label": "Status ID",
                        "tooltip": "The status of the new ticket. Status IDs are listed through Make API Call <code>GET /ticketStatus</code>."
                    },
                    "typeId": {
                        "type": "text",
                        "index": 3,
                        "label": "Type ID",
                        "tooltip": "The ticket type. Type IDs are listed through Make API Call <code>GET /ticketTypes</code>."
                    },
                    "companyId": {
                        "type": "text",
                        "index": 4,
                        "label": "Company ID",
                        "tooltip": "The company the ticket belongs to."
                    },
                    "contactId": {
                        "type": "text",
                        "index": 5,
                        "label": "Contact ID",
                        "tooltip": "The person who raised the ticket."
                    },
                    "userId": {
                        "type": "text",
                        "index": 6,
                        "label": "Assigned User",
                        "tooltip": "The agent the ticket is assigned to. The user needs a support licence, otherwise Upsales rejects the request. Pick one, or type the user ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "priority": {
                        "type": "number",
                        "index": 7,
                        "label": "Priority",
                        "tooltip": "The priority of the ticket as a number; Upsales uses 0 when it is not set."
                    },
                    "customFields": {
                        "type": "textarea",
                        "index": 8,
                        "label": "Custom Fields",
                        "tooltip": "Optional custom field values of the ticket as a JSON array, e.g. <code>[{\"fieldId\": 1, \"value\": \"Mobile\"}]</code>. The field IDs are in the <code>custom</code> array of a ticket read with Get Ticket."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "title"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Ticket ID",
                        "example": 101
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Cannot log in to the mobile app"
                    },
                    "status": {
                        "type": "object",
                        "title": "Status",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Status.ID",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "title": "Status.Name",
                                "example": "Open"
                            }
                        }
                    },
                    "type": {
                        "type": "object",
                        "title": "Type",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Type.ID",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "title": "Type.Name",
                                "example": "Question"
                            }
                        }
                    },
                    "user": {
                        "type": "object",
                        "title": "Assigned User",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Assigned User.ID",
                                "example": 5
                            },
                            "name": {
                                "type": "string",
                                "title": "Assigned User.Name",
                                "example": "Gustav Petterson"
                            },
                            "email": {
                                "type": "string",
                                "title": "Assigned User.Email",
                                "example": "gustav@example.com"
                            }
                        }
                    },
                    "client": {
                        "type": "object",
                        "title": "Company",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Company.ID",
                                "example": 12
                            },
                            "name": {
                                "type": "string",
                                "title": "Company.Name",
                                "example": "Pied Piper"
                            }
                        }
                    },
                    "contact": {
                        "type": "object",
                        "title": "Contact",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Contact.ID",
                                "example": 340
                            },
                            "name": {
                                "type": "string",
                                "title": "Contact.Name",
                                "example": "Erlich Bachman"
                            }
                        }
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 0
                    },
                    "source": {
                        "type": "string",
                        "title": "Source",
                        "example": "manual"
                    },
                    "isArchived": {
                        "type": "boolean",
                        "title": "Archived",
                        "example": false
                    },
                    "isPending": {
                        "type": "boolean",
                        "title": "Pending",
                        "example": false
                    },
                    "isRead": {
                        "type": "boolean",
                        "title": "Read",
                        "example": true
                    },
                    "custom": {
                        "type": "array",
                        "title": "Custom Fields",
                        "items": {
                            "type": "object",
                            "properties": {
                                "fieldId": {
                                    "type": "integer",
                                    "title": "Field ID",
                                    "example": 1
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "Mobile"
                                }
                            }
                        },
                        "example": [
                            {
                                "fieldId": 1,
                                "value": "Mobile"
                            }
                        ]
                    },
                    "comments": {
                        "type": "array",
                        "title": "Comments",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 41
                                },
                                "description": {
                                    "type": "string",
                                    "title": "Description",
                                    "example": "We have reset the account, please try again."
                                },
                                "isPublic": {
                                    "type": "boolean",
                                    "title": "Public",
                                    "example": true
                                },
                                "regDate": {
                                    "type": "string",
                                    "format": "date-time",
                                    "title": "Created At",
                                    "example": "2026-05-12T09:14:00.000Z"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 41,
                                "description": "We have reset the account, please try again.",
                                "isPublic": true,
                                "regDate": "2026-05-12T09:14:00.000Z"
                            }
                        ]
                    },
                    "regDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-05-12T09:00:00.000Z"
                    },
                    "modDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Modified At",
                        "example": "2026-05-12T09:14:00.000Z"
                    },
                    "resolveDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Resolved At",
                        "example": "2026-05-13T10:00:00.000Z"
                    },
                    "firstReplyDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "First Reply At",
                        "example": "2026-05-12T09:14:00.000Z"
                    },
                    "snoozeDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Snoozed Until",
                        "example": "2026-05-20T08:00:00.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
