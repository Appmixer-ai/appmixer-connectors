{
    "name": "appmixer.upsales.core.CreateActivity",
    "label": "Create Task",
    "description": "Create a task: a to-do or a phone call assigned to a user. A phone call needs a company.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": [
            "requests",
            "writes"
        ],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "type",
                    "description",
                    "userId"
                ]
            },
            "inspector": {
                "inputs": {
                    "type": {
                        "type": "select",
                        "index": 1,
                        "label": "Type",
                        "tooltip": "A to-do or a phone call.",
                        "options": [
                            {
                                "label": "To-do",
                                "value": "todo"
                            },
                            {
                                "label": "Phone call",
                                "value": "phoneCall"
                            }
                        ],
                        "defaultValue": "todo"
                    },
                    "description": {
                        "type": "text",
                        "index": 2,
                        "label": "Description",
                        "tooltip": "What has to be done."
                    },
                    "userId": {
                        "type": "text",
                        "index": 3,
                        "label": "Assigned User",
                        "tooltip": "The user who should complete the task. Pick one, or type the user ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "companyId": {
                        "type": "text",
                        "index": 4,
                        "label": "Company ID",
                        "tooltip": "The company the task is about. Required for a phone call."
                    },
                    "contactId": {
                        "type": "text",
                        "index": 5,
                        "label": "Contact ID",
                        "tooltip": "The contact to call or to meet."
                    },
                    "date": {
                        "type": "date-time",
                        "index": 6,
                        "label": "Due Date",
                        "tooltip": "When the task should be completed.",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "priority": {
                        "type": "select",
                        "index": 7,
                        "label": "Priority",
                        "tooltip": "High or normal priority.",
                        "options": [
                            {
                                "label": "Normal",
                                "value": "0"
                            },
                            {
                                "label": "High",
                                "value": "3"
                            }
                        ]
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 8,
                        "label": "Notes",
                        "tooltip": "Notes for the task."
                    },
                    "customFields": {
                        "type": "textarea",
                        "index": 9,
                        "label": "Custom Fields",
                        "tooltip": "Optional custom field values as a JSON array, e.g. <code>[{\"fieldId\": 3, \"value\": \"2210\"}]</code>. Field IDs are listed in Upsales under Settings &rarr; Activity custom fields, or through Make API Call <code>GET /customfields/activity</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Task ID",
                        "example": 1
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Book a meeting"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "No answer, follow up tomorrow"
                    },
                    "date": {
                        "type": "string",
                        "title": "Date",
                        "example": "2022-04-23"
                    },
                    "time": {
                        "type": "string",
                        "title": "Time",
                        "example": "10:30"
                    },
                    "closeDate": {
                        "type": "string",
                        "title": "Close Date",
                        "example": "2022-04-24"
                    },
                    "priority": {
                        "type": "integer",
                        "title": "Priority",
                        "example": 3
                    },
                    "isAppointment": {
                        "type": "integer",
                        "title": "Is Appointment",
                        "example": 0
                    },
                    "activityType": {
                        "type": "object",
                        "title": "Task Type",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Task Type.ID",
                                "example": 11
                            },
                            "name": {
                                "type": "string",
                                "title": "Task Type.Name",
                                "example": "Phone call"
                            }
                        }
                    },
                    "client": {
                        "type": "object",
                        "title": "Company",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Company.ID",
                                "example": 2
                            },
                            "name": {
                                "type": "string",
                                "title": "Company.Name",
                                "example": "Pied Piper"
                            }
                        }
                    },
                    "users": {
                        "type": "array",
                        "title": "Users",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 1
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Gustav Petterson"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Email",
                                    "example": "gustav@example.com"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 1,
                                "name": "Gustav Petterson",
                                "email": "gustav@example.com"
                            }
                        ]
                    },
                    "contacts": {
                        "type": "array",
                        "title": "Contacts",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 5
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Erlich Bachman"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 5,
                                "name": "Erlich Bachman"
                            }
                        ]
                    },
                    "custom": {
                        "type": "array",
                        "title": "Custom Fields",
                        "items": {
                            "type": "object",
                            "properties": {
                                "fieldId": {
                                    "type": "integer",
                                    "title": "Field ID",
                                    "example": 3
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "2210"
                                }
                            }
                        },
                        "example": [
                            {
                                "fieldId": 3,
                                "value": "2210"
                            }
                        ]
                    },
                    "regDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2021-09-29T06:40:28.000Z"
                    },
                    "modDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Modified At",
                        "example": "2021-09-29T06:40:28.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
