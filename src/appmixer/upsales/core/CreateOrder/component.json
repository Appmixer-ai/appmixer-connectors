{
    "name": "appmixer.upsales.core.CreateOrder",
    "label": "Create Order",
    "description": "Create a won order (an /orders record with a probability of 100 %) with one or more order rows.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": [
            "requests",
            "writes"
        ],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "companyId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "stageId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "productId": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "number"
                    },
                    "price": {
                        "type": "number"
                    },
                    "orderRows": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "string"
                    }
                },
                "required": [
                    "companyId",
                    "userId",
                    "stageId",
                    "description",
                    "date"
                ]
            },
            "inspector": {
                "inputs": {
                    "companyId": {
                        "type": "text",
                        "index": 1,
                        "label": "Company ID",
                        "tooltip": "The company the deal is with. Use Find Companies to look it up."
                    },
                    "userId": {
                        "type": "text",
                        "index": 2,
                        "label": "User",
                        "tooltip": "The user who owns the deal. Pick one, or type the user ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "stageId": {
                        "type": "text",
                        "index": 3,
                        "label": "Stage",
                        "tooltip": "The opportunity/order stage. Pick one, or type the stage ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListOrderStages?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListOrderStages#toSelectArray"
                            }
                        }
                    },
                    "description": {
                        "type": "text",
                        "index": 4,
                        "label": "Description",
                        "tooltip": "What is being sold, e.g. \"10 licenses\"."
                    },
                    "date": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Date",
                        "tooltip": "The order date.",
                        "config": {
                            "enableTime": false
                        }
                    },
                    "productId": {
                        "type": "text",
                        "index": 6,
                        "label": "Product",
                        "tooltip": "The product of a single order row. Pick one, or type the product ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListProducts?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListProducts#toSelectArray"
                            }
                        }
                    },
                    "quantity": {
                        "type": "number",
                        "index": 7,
                        "label": "Quantity",
                        "tooltip": "The quantity of the single order row. Defaults to 1."
                    },
                    "price": {
                        "type": "number",
                        "index": 8,
                        "label": "Price",
                        "tooltip": "The unit price of the single order row."
                    },
                    "orderRows": {
                        "type": "textarea",
                        "index": 9,
                        "label": "Order Rows",
                        "tooltip": "Optional. Several order rows as a JSON array, e.g. <code>[{\"productId\": 1, \"quantity\": 2, \"price\": 9000}]</code>. When set, Product, Quantity and Price are ignored."
                    },
                    "contactId": {
                        "type": "text",
                        "index": 10,
                        "label": "Contact ID",
                        "tooltip": "The contact at the company."
                    },
                    "notes": {
                        "type": "textarea",
                        "index": 11,
                        "label": "Notes",
                        "tooltip": "Notes about the deal."
                    },
                    "customFields": {
                        "type": "textarea",
                        "index": 12,
                        "label": "Custom Fields",
                        "tooltip": "Optional custom field values as a JSON array, e.g. <code>[{\"fieldId\": 3, \"value\": \"2210\"}]</code>. Field IDs are listed in Upsales under Settings &rarr; Order custom fields, or through Make API Call <code>GET /customfields/order</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Order ID",
                        "example": 2
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "10 licenses"
                    },
                    "date": {
                        "type": "string",
                        "title": "Date",
                        "example": "2018-07-23"
                    },
                    "closeDate": {
                        "type": "string",
                        "title": "Close Date",
                        "example": "2018-07-30"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Decision in Q3"
                    },
                    "probability": {
                        "type": "integer",
                        "title": "Probability",
                        "example": 25
                    },
                    "value": {
                        "type": "number",
                        "title": "Value",
                        "example": 10000
                    },
                    "weightedValue": {
                        "type": "number",
                        "title": "Weighted Value",
                        "example": 2500
                    },
                    "currency": {
                        "type": "string",
                        "title": "Currency",
                        "example": "SEK"
                    },
                    "user": {
                        "type": "object",
                        "title": "User",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "User.ID",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "title": "User.Name",
                                "example": "Gustav Petterson"
                            },
                            "email": {
                                "type": "string",
                                "title": "User.Email",
                                "example": "gustav@example.com"
                            }
                        }
                    },
                    "client": {
                        "type": "object",
                        "title": "Company",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Company.ID",
                                "example": 2
                            },
                            "name": {
                                "type": "string",
                                "title": "Company.Name",
                                "example": "Pied Piper"
                            }
                        }
                    },
                    "contact": {
                        "type": "object",
                        "title": "Contact",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Contact.ID",
                                "example": 5
                            },
                            "name": {
                                "type": "string",
                                "title": "Contact.Name",
                                "example": "Erlich Bachman"
                            }
                        }
                    },
                    "stage": {
                        "type": "object",
                        "title": "Stage",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Stage.ID",
                                "example": 9
                            },
                            "name": {
                                "type": "string",
                                "title": "Stage.Name",
                                "example": "Prospect 1"
                            }
                        }
                    },
                    "orderRow": {
                        "type": "array",
                        "title": "Order Rows",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 2
                                },
                                "quantity": {
                                    "type": "number",
                                    "title": "Quantity",
                                    "example": 1
                                },
                                "price": {
                                    "type": "number",
                                    "title": "Price",
                                    "example": 9000
                                },
                                "listPrice": {
                                    "type": "number",
                                    "title": "List Price",
                                    "example": 10000
                                },
                                "discount": {
                                    "type": "number",
                                    "title": "Discount",
                                    "example": 0
                                },
                                "productId": {
                                    "type": "integer",
                                    "title": "Product ID",
                                    "example": 1
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 2,
                                "quantity": 1,
                                "price": 9000,
                                "listPrice": 10000,
                                "discount": 0,
                                "productId": 1
                            }
                        ]
                    },
                    "custom": {
                        "type": "array",
                        "title": "Custom Fields",
                        "items": {
                            "type": "object",
                            "properties": {
                                "fieldId": {
                                    "type": "integer",
                                    "title": "Field ID",
                                    "example": 3
                                },
                                "value": {
                                    "type": "string",
                                    "title": "Value",
                                    "example": "2210"
                                }
                            }
                        },
                        "example": [
                            {
                                "fieldId": 3,
                                "value": "2210"
                            }
                        ]
                    },
                    "regDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2018-05-22T11:15:30.000Z"
                    },
                    "modDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Modified At",
                        "example": "2018-05-22T11:15:30.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
