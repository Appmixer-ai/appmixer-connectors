{
    "name": "appmixer.upsales.core.FindTickets",
    "label": "Find Tickets",
    "description": "Find support tickets by status, company, contact, assigned user or modification time. Returns at most 2000 tickets (one page); narrow the filters if the ticket you need is not among them. Requires the Customer Support product in Upsales.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "statusId": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "contactId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "modifiedAfter": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "statusId": {
                        "type": "text",
                        "index": 1,
                        "label": "Status ID",
                        "tooltip": "Only tickets in this status. Status IDs are listed through Make API Call <code>GET /ticketStatus</code>."
                    },
                    "companyId": {
                        "type": "text",
                        "index": 2,
                        "label": "Company ID",
                        "tooltip": "Only tickets of this company."
                    },
                    "contactId": {
                        "type": "text",
                        "index": 3,
                        "label": "Contact ID",
                        "tooltip": "Only tickets raised by this contact."
                    },
                    "userId": {
                        "type": "text",
                        "index": 4,
                        "label": "Assigned User",
                        "tooltip": "Only tickets assigned to this user. Pick one, or type the user ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "modifiedAfter": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Modified After",
                        "tooltip": "Return only tickets created or modified at or after this time."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/upsales/core/FindTickets?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
