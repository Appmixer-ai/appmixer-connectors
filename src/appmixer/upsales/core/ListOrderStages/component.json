{
    "name": "appmixer.upsales.core.ListOrderStages",
    "label": "stage",
    "description": "Private: the options of the stage dropdowns.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "title": "Items",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "title": "ID",
                                    "example": 1
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Example"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 1,
                                "name": "Example"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
