{
    "name": "appmixer.upsales.core.AddTicketComment",
    "label": "Add Ticket Comment",
    "description": "Add a message to the conversation of a support ticket: a public reply sent to the customer or an internal note. Requires the Customer Support product in Upsales.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:upsales"
    },
    "quota": {
        "manager": "appmixer:upsales",
        "resources": [
            "requests",
            "writes"
        ],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "isPublic": {
                        "type": "boolean"
                    },
                    "userId": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId",
                    "description"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "index": 1,
                        "label": "Ticket ID",
                        "tooltip": "The ID of the ticket."
                    },
                    "description": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "The text of the comment."
                    },
                    "isPublic": {
                        "type": "toggle",
                        "index": 3,
                        "label": "Public",
                        "tooltip": "On: the comment is sent to the customer. Off: it stays an internal note.",
                        "defaultValue": false
                    },
                    "userId": {
                        "type": "text",
                        "index": 4,
                        "label": "Author",
                        "tooltip": "The user the comment is written as. Pick one, or type the user ID.",
                        "source": {
                            "url": "/component/appmixer/upsales/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Comment ID",
                        "example": 41
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "We have reset the account, please try again."
                    },
                    "isPublic": {
                        "type": "boolean",
                        "title": "Public",
                        "example": true
                    },
                    "user": {
                        "type": "object",
                        "title": "User",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "User.ID",
                                "example": 8
                            },
                            "name": {
                                "type": "string",
                                "title": "User.Name",
                                "example": "Gustav Petterson"
                            }
                        }
                    },
                    "regDate": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2026-05-12T09:14:00.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
