{
    "actions": [
        {
            "title": "Find Apps",
            "description": "Fetch a list of all applications along with their metadata.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/apps",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "GET",
            "sampleResponse": {
                "apps": [
                    {
                        "id": "app_123",
                        "name": "Sales Dashboard",
                        "description": "Dashboard for sales analytics",
                        "createdAt": "2023-01-01T12:00:00Z"
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional search filters for finding apps",
                "properties": {
                    "search": {
                        "type": "string",
                        "description": "Optional search query to filter apps by name or description."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Get App Details",
            "description": "Retrieve detailed information about a specific app using its ID.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/apps/{app_id}",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "GET",
            "sampleResponse": {
                "id": "app_123",
                "name": "Sales Dashboard",
                "description": "Dashboard for sales analytics",
                "configuration": {}
            },
            "inputSchema": {
                "type": "object",
                "description": "Input required to fetch app details.",
                "properties": {
                    "app_id": {
                        "type": "string",
                        "description": "Unique identifier of the app."
                    }
                },
                "required": [
                    "app_id"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Find Users",
            "description": "Retrieve a list of users in the organization with their roles and permissions.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/users",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "GET",
            "sampleResponse": {
                "users": [
                    {
                        "id": "user_001",
                        "email": "jane.doe@example.com",
                        "role": "admin"
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional search criteria for finding users.",
                "properties": {
                    "search": {
                        "type": "string",
                        "description": "Optional search query to filter users by name or email."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Find Resources",
            "description": "Retrieve a list of connected resources such as databases, APIs, and other data sources.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/resources",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "GET",
            "sampleResponse": {
                "resources": [
                    {
                        "id": "res_001",
                        "name": "Main Database",
                        "type": "postgres"
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional filters for retrieving resources.",
                "properties": {
                    "search": {
                        "type": "string",
                        "description": "Optional query string to filter resources by name or type."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Create App",
            "description": "Programmatically create a new Retool application.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/apps",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "POST",
            "sampleResponse": {
                "id": "app_124",
                "name": "New App",
                "description": "A newly created app",
                "configuration": {}
            },
            "inputSchema": {
                "type": "object",
                "description": "Input required to create a new app",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the new application."
                    },
                    "description": {
                        "type": "string",
                        "description": "A short description of the application."
                    },
                    "configuration": {
                        "type": "object",
                        "description": "Configuration settings for the application."
                    }
                },
                "required": [
                    "name"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Invite User",
            "description": "Send an invitation to join the Retool organization.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/users/invite",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "POST",
            "sampleResponse": {
                "invitationId": "inv_001",
                "email": "new.user@example.com",
                "status": "pending"
            },
            "inputSchema": {
                "type": "object",
                "description": "Information required to invite a new user.",
                "properties": {
                    "email": {
                        "type": "string",
                        "description": "Email address of the user to invite."
                    },
                    "role": {
                        "type": "string",
                        "description": "Optional role to assign to the new user."
                    }
                },
                "required": [
                    "email"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Run Query",
            "description": "Execute a query within a specific app and retrieve the results.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/apps/{app_id}/queries/{query_id}/run",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "POST",
            "sampleResponse": {
                "queryId": "query_001",
                "results": {
                    "data": []
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "Inputs needed to run a query in a specific app.",
                "properties": {
                    "app_id": {
                        "type": "string",
                        "description": "Unique identifier of the app."
                    },
                    "query_id": {
                        "type": "string",
                        "description": "Unique identifier of the query to run."
                    },
                    "parameters": {
                        "type": "object",
                        "description": "Optional parameters to pass to the query."
                    }
                },
                "required": [
                    "app_id",
                    "query_id"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Update App",
            "description": "Modify properties of an existing Retool application such as its name, description, or configuration.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/apps/{app_id}",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "PATCH",
            "sampleResponse": {
                "id": "app_123",
                "name": "Updated App",
                "description": "Updated description",
                "configuration": {}
            },
            "inputSchema": {
                "type": "object",
                "description": "Input required to update an app.",
                "properties": {
                    "app_id": {
                        "type": "string",
                        "description": "Unique identifier of the app to update."
                    },
                    "name": {
                        "type": "string",
                        "description": "New name for the app."
                    },
                    "description": {
                        "type": "string",
                        "description": "New description for the app."
                    },
                    "configuration": {
                        "type": "object",
                        "description": "Updated configuration settings for the app."
                    }
                },
                "required": [
                    "app_id"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Find Groups",
            "description": "Retrieve a list of user groups within the organization along with their membership details.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/groups",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "GET",
            "sampleResponse": {
                "groups": [
                    {
                        "id": "group_001",
                        "name": "Admins",
                        "members": [
                            "user_001",
                            "user_002"
                        ]
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Optional search criteria for finding groups.",
                "properties": {
                    "search": {
                        "type": "string",
                        "description": "Optional query to filter groups by name."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Create Resource",
            "description": "Add a new resource connection such as a database or API to the Retool organization.",
            "type": "action",
            "documentation": "https://docs.retool.com/org-users/guides/retool-api/authentication",
            "endpointUrl": "/resources",
            "apiBaseUrl": "https://<organization_name>.retool.com/api/v1",
            "method": "POST",
            "sampleResponse": {
                "id": "res_002",
                "name": "New API Service",
                "type": "api",
                "configuration": {}
            },
            "inputSchema": {
                "type": "object",
                "description": "Input required to create a new resource connection.",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the resource."
                    },
                    "type": {
                        "type": "string",
                        "description": "Type of the resource (e.g., postgres, mysql, api)."
                    },
                    "configuration": {
                        "type": "object",
                        "description": "Configuration settings and credentials for the resource."
                    }
                },
                "required": [
                    "name",
                    "type",
                    "configuration"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        }
    ],
    "authentication": {
        "type": "apiKey",
        "authUrl": "https://<organization_name>.retool.com/api/v1/auth",
        "tokenUrl": "https://<organization_name>.retool.com/api/v1/token",
        "profileInfoUrl": "https://<organization_name>.retool.com/api/v1/users/me"
    },
    "serviceJson": {
        "name": "retool",
        "label": "Retool",
        "category": "applications",
        "description": "Integration component for Retool, a platform for building internal tools and applications, providing endpoints for core app management, user management, resource integration, and query execution.",
        "version": "1.0.0",
        "icon": "https://assets.retool.com/logo.svg"
    }
}