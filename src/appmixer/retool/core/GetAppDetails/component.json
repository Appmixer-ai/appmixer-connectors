{
    "name": "appmixer.retool.core.GetAppDetails",
    "description": "Retrieve detailed information about a specific Retool application including its configuration, version info, and metadata.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:retool"
    },
    "quota": {
        "manager": "appmixer:retool",
        "resources": ["requests"],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "appId": {
                        "type": "string",
                        "title": "App ID"
                    }
                },
                "required": ["appId"]
            },
            "inspector": {
                "inputs": {
                    "appId": {
                        "type": "text",
                        "index": 1,
                        "label": "App ID",
                        "tooltip": "The unique identifier of the Retool application"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "App ID", "value": "id" },
                { "label": "App Name", "value": "name" },
                { "label": "App Description", "value": "description" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "App Type", "value": "app_type" },
                { "label": "Is Public", "value": "is_public" },
                { "label": "Owner ID", "value": "owner_id" },
                { "label": "Folder ID", "value": "folder_id" },
                { "label": "App JSON", "value": "app_json" },
                { "label": "Version", "value": "version" }
            ]
        }
    ],
    "icon": "https://www.svgrepo.com/show/354310/retool.svg"
}