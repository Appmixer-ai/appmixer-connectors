{
    "name": "appmixer.figma.core.PostComment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Posts a comment to a specified Figma file.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:figma"
    },
    "quota": {
        "manager": "appmixer:figma",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "message"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the Figma file where the comment should be posted.",
                        "label": "File Id",
                        "index": 0
                    },
                    "message": {
                        "type": "text",
                        "tooltip": "The text content of the comment to be posted.",
                        "label": "Message",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string",
                        "example": "Please review the spacing on this frame."
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-06-15T10:30:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}