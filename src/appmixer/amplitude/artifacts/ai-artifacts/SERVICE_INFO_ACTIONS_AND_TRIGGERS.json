{
    "actions": [
        {
            "title": "SendEvent",
            "description": "Send a single custom event to Amplitude to track user behavior. EU data residency customers should use api.eu.amplitude.com.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/http-v2-api",
            "endpointUrl": "/2/httpapi",
            "apiBaseUrl": "https://api.amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "code": 200,
                "events_ingested": 1,
                "payload_size_bytes": 420,
                "server_upload_time": 1700000000000,
                "throttled": 0
            },
            "inputSchema": {
                "type": "object",
                "description": "HTTP V2 API request body. Authentication is recommended via Basic Auth using API Key (username) and Secret Key (password). If Basic Auth is used, api_key in the body is optional.",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "description": "Project API Key. Optional when using HTTP Basic Auth."
                    },
                    "events": {
                        "type": "array",
                        "description": "Array of event objects to ingest. For single-event use, send an array with one item.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "event_type": {
                                    "type": "string",
                                    "description": "Required. Name of the event (e.g., \"Button Clicked\")."
                                },
                                "user_id": {
                                    "type": "string",
                                    "description": "Unique identifier for the user. Required if device_id is not provided."
                                },
                                "device_id": {
                                    "type": "string",
                                    "description": "Unique identifier for the device. Required if user_id is not provided."
                                },
                                "time": {
                                    "type": "integer",
                                    "description": "Event time in milliseconds since epoch. If omitted, Amplitude sets server time."
                                },
                                "event_properties": {
                                    "type": "object",
                                    "description": "Custom key/value properties for the event."
                                },
                                "user_properties": {
                                    "type": "object",
                                    "description": "User properties to set at event time (merged with Identify)."
                                },
                                "groups": {
                                    "type": "object",
                                    "description": "Group names mapped to group values (e.g., {\"company\": \"acme\"})."
                                },
                                "group_properties": {
                                    "type": "object",
                                    "description": "Group properties to set for the specified groups."
                                },
                                "app_version": {
                                    "type": "string",
                                    "description": "App version."
                                },
                                "platform": {
                                    "type": "string",
                                    "description": "Platform (e.g., iOS, Android, Web)."
                                },
                                "os_name": {
                                    "type": "string",
                                    "description": "Operating system name."
                                },
                                "os_version": {
                                    "type": "string",
                                    "description": "Operating system version."
                                },
                                "device_brand": {
                                    "type": "string",
                                    "description": "Device brand."
                                },
                                "device_manufacturer": {
                                    "type": "string",
                                    "description": "Device manufacturer."
                                },
                                "device_model": {
                                    "type": "string",
                                    "description": "Device model."
                                },
                                "carrier": {
                                    "type": "string",
                                    "description": "Mobile carrier."
                                },
                                "country": {
                                    "type": "string",
                                    "description": "Country."
                                },
                                "region": {
                                    "type": "string",
                                    "description": "Region."
                                },
                                "city": {
                                    "type": "string",
                                    "description": "City."
                                },
                                "dma": {
                                    "type": "string",
                                    "description": "Designated Market Area."
                                },
                                "language": {
                                    "type": "string",
                                    "description": "Language (e.g., en)."
                                },
                                "price": {
                                    "type": "number",
                                    "description": "Price for revenue tracking."
                                },
                                "quantity": {
                                    "type": "integer",
                                    "description": "Quantity for revenue tracking."
                                },
                                "revenue": {
                                    "type": "number",
                                    "description": "Revenue amount for the event."
                                },
                                "product_id": {
                                    "type": "string",
                                    "description": "Product ID associated with the event."
                                },
                                "revenue_type": {
                                    "type": "string",
                                    "description": "Type of revenue (e.g., purchase, refund)."
                                },
                                "location_lat": {
                                    "type": "number",
                                    "description": "Latitude associated with the event."
                                },
                                "location_lng": {
                                    "type": "number",
                                    "description": "Longitude associated with the event."
                                },
                                "ip": {
                                    "type": "string",
                                    "description": "IP address of the user."
                                },
                                "idfa": {
                                    "type": "string",
                                    "description": "Identifier for Advertisers (iOS)."
                                },
                                "idfv": {
                                    "type": "string",
                                    "description": "Identifier for Vendors (iOS)."
                                },
                                "adid": {
                                    "type": "string",
                                    "description": "Advertising ID (Android)."
                                },
                                "android_id": {
                                    "type": "string",
                                    "description": "Android device ID."
                                },
                                "event_id": {
                                    "type": "integer",
                                    "description": "Integer identifier for deduplication and ordering."
                                },
                                "session_id": {
                                    "type": "integer",
                                    "description": "Session identifier in milliseconds since epoch; -1 to indicate out of session."
                                },
                                "insert_id": {
                                    "type": "string",
                                    "description": "Unique identifier for event deduplication (recommended)."
                                },
                                "plan": {
                                    "type": "object",
                                    "description": "Ingestion plan metadata.",
                                    "properties": {
                                        "branch": {
                                            "type": "string",
                                            "description": "Branch or environment (e.g., prod, staging)."
                                        },
                                        "source": {
                                            "type": "string",
                                            "description": "Source of the event (e.g., \"server\")."
                                        },
                                        "version": {
                                            "type": "string",
                                            "description": "Schema or app version for the plan."
                                        }
                                    }
                                },
                                "ingestion_metadata": {
                                    "type": "object",
                                    "description": "Metadata about the ingestion source.",
                                    "properties": {
                                        "source_name": {
                                            "type": "string",
                                            "description": "Name of the source integration."
                                        },
                                        "source_version": {
                                            "type": "string",
                                            "description": "Version of the source integration."
                                        }
                                    }
                                }
                            },
                            "required": [
                                "event_type"
                            ]
                        }
                    },
                    "options": {
                        "type": "object",
                        "description": "Optional ingestion options.",
                        "properties": {
                            "min_id_length": {
                                "type": "integer",
                                "description": "Minimum allowed length for user_id, device_id, and event/insert IDs (default 5)."
                            }
                        }
                    }
                },
                "required": [
                    "events"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "BatchUploadEvents",
            "description": "Upload multiple events in a single request for efficient ingestion. EU customers: use api.eu.amplitude.com.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/http-v2-api#keys-for-the-http-v2-api",
            "endpointUrl": "/2/httpapi",
            "apiBaseUrl": "https://api.amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "code": 200,
                "events_ingested": 25,
                "payload_size_bytes": 18000,
                "server_upload_time": 1700000000000,
                "throttled": 0
            },
            "inputSchema": {
                "type": "object",
                "description": "Same schema as SendEvent; send multiple event objects in the events array.",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "description": "Project API Key. Optional when using HTTP Basic Auth."
                    },
                    "events": {
                        "type": "array",
                        "description": "Array of event objects to ingest (recommended maximum depends on plan; commonly up to 2000 events/request, < 1 MB payload).",
                        "items": {
                            "$ref": "#/actions/0/inputSchema/properties/events/items"
                        }
                    },
                    "options": {
                        "type": "object",
                        "properties": {
                            "min_id_length": {
                                "type": "integer",
                                "description": "Minimum allowed length for IDs."
                            }
                        }
                    }
                },
                "required": [
                    "events"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "UpdateUserProperties",
            "description": "Update user properties without sending an event using the Identify API.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/identify-api",
            "endpointUrl": "/identify",
            "apiBaseUrl": "https://api.amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "code": 200,
                "num_processed": 1,
                "server_upload_time": 1700000000000
            },
            "inputSchema": {
                "type": "object",
                "description": "Identify API request. Authentication via Basic Auth (API Key + Secret Key) recommended. If using Basic Auth, api_key in body is optional.",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "description": "Project API Key. Optional when using HTTP Basic Auth."
                    },
                    "identification": {
                        "type": "array",
                        "description": "Array of identify instructions to apply to users.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "user_id": {
                                    "type": "string",
                                    "description": "User identifier. Required if device_id is not provided."
                                },
                                "device_id": {
                                    "type": "string",
                                    "description": "Device identifier. Required if user_id is not provided."
                                },
                                "user_properties": {
                                    "type": "object",
                                    "description": "Identify operations for user properties.",
                                    "properties": {
                                        "$set": {
                                            "type": "object",
                                            "description": "Set properties to specific values."
                                        },
                                        "$setOnce": {
                                            "type": "object",
                                            "description": "Set properties only if they are not already set."
                                        },
                                        "$add": {
                                            "type": "object",
                                            "description": "Numerically add to properties."
                                        },
                                        "$append": {
                                            "type": "object",
                                            "description": "Append values to list-type properties."
                                        },
                                        "$prepend": {
                                            "type": "object",
                                            "description": "Prepend values to list-type properties."
                                        },
                                        "$unset": {
                                            "type": "array",
                                            "description": "List of property keys to remove.",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "$remove": {
                                            "type": "object",
                                            "description": "Remove values from list-type properties (key to value map)."
                                        }
                                    }
                                },
                                "groups": {
                                    "type": "object",
                                    "description": "Groups to associate with the user (e.g., {\"company\": \"acme\"})."
                                },
                                "group_properties": {
                                    "type": "object",
                                    "description": "Group properties identify operations to apply to the groups."
                                }
                            },
                            "required": []
                        }
                    }
                },
                "required": [
                    "identification"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "IdentifyUser",
            "description": "Associate a user_id with a device_id and/or update identification attributes using the Identify API.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/identify-api#keys-for-the-identify-api",
            "endpointUrl": "/identify",
            "apiBaseUrl": "https://api.amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "code": 200,
                "num_processed": 1
            },
            "inputSchema": {
                "type": "object",
                "description": "Lightweight identify usage to map identities and set basic attributes.",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "description": "Project API Key. Optional when using HTTP Basic Auth."
                    },
                    "identification": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "user_id": {
                                    "type": "string",
                                    "description": "User identifier. Required if device_id is not provided."
                                },
                                "device_id": {
                                    "type": "string",
                                    "description": "Device identifier. Required if user_id is not provided."
                                },
                                "user_properties": {
                                    "type": "object",
                                    "description": "Properties to set via $set / $setOnce.",
                                    "properties": {
                                        "$set": {
                                            "type": "object",
                                            "description": "Set properties to values."
                                        },
                                        "$setOnce": {
                                            "type": "object",
                                            "description": "Set properties if not already set."
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "required": [
                    "identification"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "ListCohorts",
            "description": "Retrieve all behavioral cohorts available in the project.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/behavioral-cohorts-api#list-cohorts",
            "endpointUrl": "/api/3/cohorts",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "cohorts": [
                    {
                        "id": "coh_abc123",
                        "name": "Active Users 30d",
                        "description": "Users with activity in last 30 days",
                        "size": 12345,
                        "project_id": 123456,
                        "created_at": "2024-01-15T12:00:00Z",
                        "modified_at": "2024-02-01T18:30:00Z",
                        "is_system": false,
                        "owner_id": 7890
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "No request body. Authentication via HTTP Basic Auth.",
                "properties": {}
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "cohorts"
            }
        },
        {
            "title": "GetCohort",
            "description": "Request a downloadable export for a specific cohort by ID and retrieve its status/result URL.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/behavioral-cohorts-api#download-cohort",
            "endpointUrl": "/api/5/cohorts/request/{id}",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "cohort_id": "coh_abc123",
                "job_id": "job_xyz789",
                "status": "succeeded",
                "result": {
                    "url": "https://amplitude-data-downloads.s3.amazonaws.com/exports/cohort/coh_abc123_20240201.csv",
                    "expires_at": "2024-02-02T00:00:00Z"
                },
                "size": 12345
            },
            "inputSchema": {
                "type": "object",
                "description": "Path parameter identifies the cohort. Response may be a job status; if still processing, poll until status is \"succeeded\".",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Cohort ID to export (path parameter)."
                    },
                    "format": {
                        "type": "string",
                        "description": "Desired export format. Defaults to CSV if omitted.",
                        "enum": [
                            "csv",
                            "json"
                        ]
                    }
                },
                "required": [
                    "id"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "CreateCohort",
            "description": "Create a new cohort by uploading a list of user identifiers (user_ids or amplitude_ids).",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/behavioral-cohorts-api#upload-cohort",
            "endpointUrl": "/api/3/cohorts/upload",
            "apiBaseUrl": "https://amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "cohort_id": "coh_new123",
                "name": "VIP Customers",
                "message": "success"
            },
            "inputSchema": {
                "type": "object",
                "description": "Upload a cohort definition by sending explicit members.",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Name of the cohort to create."
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional description for the cohort."
                    },
                    "id_type": {
                        "type": "string",
                        "description": "Type of identifiers provided in members.",
                        "enum": [
                            "user_id",
                            "amplitude_id"
                        ]
                    },
                    "members": {
                        "type": "array",
                        "description": "List of user identifiers (strings) to include in the cohort.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "action": {
                        "type": "string",
                        "description": "Insert to add members to an existing cohort name, or replace to set exactly the provided set for the cohort name.",
                        "enum": [
                            "insert",
                            "replace"
                        ]
                    }
                },
                "required": [
                    "name",
                    "id_type",
                    "members"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "UpdateCohortMembership",
            "description": "Incrementally add or remove users from an existing cohort.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/behavioral-cohorts-api#update-cohort-membership",
            "endpointUrl": "/api/3/cohorts/membership",
            "apiBaseUrl": "https://amplitude.com",
            "method": "POST",
            "sampleResponse": {
                "cohort_id": "coh_abc123",
                "added": 10,
                "removed": 3,
                "message": "success"
            },
            "inputSchema": {
                "type": "object",
                "description": "Specify the cohort and which members to add or remove.",
                "properties": {
                    "cohort_id": {
                        "type": "string",
                        "description": "Existing cohort ID to update."
                    },
                    "id_type": {
                        "type": "string",
                        "description": "Type of identifiers for members.",
                        "enum": [
                            "user_id",
                            "amplitude_id"
                        ]
                    },
                    "adds": {
                        "type": "array",
                        "description": "Identifiers to add to the cohort.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "removes": {
                        "type": "array",
                        "description": "Identifiers to remove from the cohort.",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "cohort_id",
                    "id_type"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "ExportEventData",
            "description": "Export raw event data for a specified time range. Returns a gzipped archive (binary).",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/export-api",
            "endpointUrl": "/api/2/export",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "message": "Binary gzip stream (application/gzip). The response body is a file download."
            },
            "inputSchema": {
                "type": "object",
                "description": "Start and end must be in YYYYMMDDTHH format (UTC hours).",
                "properties": {
                    "start": {
                        "type": "string",
                        "description": "Start time in format YYYYMMDDTHH (e.g., 20240101T00)."
                    },
                    "end": {
                        "type": "string",
                        "description": "End time in format YYYYMMDDTHH (e.g., 20240102T00)."
                    }
                },
                "required": [
                    "start",
                    "end"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "GetUserProfile",
            "description": "Retrieve a comprehensive user profile (properties, cohorts, and metadata) for a specific user.",
            "type": "action",
            "documentation": "https://developers.amplitude.com/docs/user-profile-api",
            "endpointUrl": "/api/2/userprofile",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "user_id": "user_123",
                "amplitude_id": 987654321,
                "device_id": null,
                "user_properties": {
                    "plan": "Pro",
                    "country": "US"
                },
                "cohorts": [
                    {
                        "id": "coh_abc123",
                        "name": "Active Users 30d"
                    }
                ],
                "last_event_time": "2024-02-01T12:34:56Z"
            },
            "inputSchema": {
                "type": "object",
                "description": "Provide exactly one of user_id, device_id, or amplitude_id.",
                "properties": {
                    "user_id": {
                        "type": "string",
                        "description": "Amplitude user_id value to look up."
                    },
                    "device_id": {
                        "type": "string",
                        "description": "Device ID to look up."
                    },
                    "amplitude_id": {
                        "type": "integer",
                        "description": "Internal Amplitude user identifier."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "NewEventReceived",
            "description": "Trigger when new events are available within a moving time window. Implemented via polling the Export API and de-duplicating insert_id.",
            "type": "trigger",
            "documentation": "https://developers.amplitude.com/docs/export-api",
            "endpointUrl": "/api/2/export",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "message": "Polling returns a gzip archive containing JSON lines of events. The trigger emits each new event object."
            },
            "inputSchema": {
                "type": "object",
                "description": "Polling configuration for the export window.",
                "properties": {
                    "start": {
                        "type": "string",
                        "description": "Start time (YYYYMMDDTHH) computed from last poll."
                    },
                    "end": {
                        "type": "string",
                        "description": "End time (YYYYMMDDTHH) computed from current poll."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "CohortUpdated",
            "description": "Trigger when a cohort’s metadata or membership changes. Polls cohort list and compares modified_at/size.",
            "type": "trigger",
            "documentation": "https://developers.amplitude.com/docs/behavioral-cohorts-api#list-cohorts",
            "endpointUrl": "/api/3/cohorts",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "message": "Trigger emits the cohort object that changed.",
                "cohort": {
                    "id": "coh_abc123",
                    "name": "Active Users 30d",
                    "size": 12345,
                    "modified_at": "2024-02-01T18:30:00Z"
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "No request body; trigger maintains state to detect changes.",
                "properties": {}
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "UserPropertyChanged",
            "description": "Trigger when user properties change. Polls for Identify updates using the Export API and emits $identify records as changes.",
            "type": "trigger",
            "documentation": "https://developers.amplitude.com/docs/export-api",
            "endpointUrl": "/api/2/export",
            "apiBaseUrl": "https://amplitude.com",
            "method": "GET",
            "sampleResponse": {
                "message": "Trigger emits an object describing the changed user properties ($identify).",
                "identify": {
                    "user_id": "user_123",
                    "user_properties": {
                        "$set": {
                            "plan": "Pro"
                        }
                    },
                    "time": 1700000000000
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "Polling configuration; filtering for $identify records is done after download.",
                "properties": {
                    "start": {
                        "type": "string",
                        "description": "Start time (YYYYMMDDTHH) computed from last poll."
                    },
                    "end": {
                        "type": "string",
                        "description": "End time (YYYYMMDDTHH) computed from current poll."
                    }
                }
            },
            "outputType": {
                "outputType": "object"
            }
        }
    ],
    "authentication": {
        "type": "apiKey",
        "authUrl": "",
        "tokenUrl": "",
        "profileInfoUrl": ""
    },
    "serviceJson": {
        "name": "appmixer.amplitude",
        "label": "Amplitude",
        "category": "applications",
