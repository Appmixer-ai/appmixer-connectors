{
    "name": "appmixer.amplitude.core.NewEventReceived",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Trigger when new events are available within a moving time window. Implemented via polling the Export API and de-duplicating insert_id.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:amplitude"
    },
    "quota": {
        "manager": "appmixer:amplitude",
        "resources": "requests"
    },
    "trigger": true,
    "tick": true,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "project_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "project_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "project_id": {
                        "type": "text",
                        "tooltip": "Your Amplitude project ID.",
                        "label": "Project ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Event ID",
                    "value": "event_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Event Type",
                    "value": "event_type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "User ID",
                    "value": "user_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Time",
                    "value": "time",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Event Properties",
                    "value": "event_properties",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "User Properties",
                    "value": "user_properties",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Insert ID",
                    "value": "insert_id",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}