{
    "name": "appmixer.amplitude.core.UpdateUserProperties",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update user properties without sending an event using the Identify API.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:amplitude"
    },
    "quota": {
        "manager": "appmixer:amplitude",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string"
                    },
                    "deviceId": {
                        "type": "string"
                    },
                    "userPropertiesSet": {
                        "type": "object"
                    },
                    "userPropertiesSetOnce": {
                        "type": "object"
                    },
                    "userPropertiesAdd": {
                        "type": "object"
                    },
                    "userPropertiesAppend": {
                        "type": "object"
                    },
                    "userPropertiesPrepend": {
                        "type": "object"
                    },
                    "userPropertiesUnset": {
                        "type": "array"
                    },
                    "userPropertiesRemove": {
                        "type": "object"
                    },
                    "groups": {
                        "type": "object"
                    },
                    "groupProperties": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "text",
                        "tooltip": "User identifier. Required if device_id is not provided.",
                        "label": "User ID",
                        "index": 1
                    },
                    "deviceId": {
                        "type": "text",
                        "tooltip": "Device identifier. Required if user_id is not provided.",
                        "label": "Device ID",
                        "index": 2
                    },
                    "userPropertiesSet": {
                        "type": "text",
                        "tooltip": "Set properties to specific values (JSON object).",
                        "label": "Set",
                        "index": 3
                    },
                    "userPropertiesSetOnce": {
                        "type": "text",
                        "tooltip": "Set properties only if they are not already set (JSON object).",
                        "label": "Set Once",
                        "index": 4
                    },
                    "userPropertiesAdd": {
                        "type": "text",
                        "tooltip": "Numerically add to properties (JSON object).",
                        "label": "Add",
                        "index": 5
                    },
                    "userPropertiesAppend": {
                        "type": "text",
                        "tooltip": "Append values to list-type properties (JSON object).",
                        "label": "Append",
                        "index": 6
                    },
                    "userPropertiesPrepend": {
                        "type": "text",
                        "tooltip": "Prepend values to list-type properties (JSON object).",
                        "label": "Prepend",
                        "index": 7
                    },
                    "userPropertiesUnset": {
                        "type": "text",
                        "tooltip": "List of property keys to remove (JSON array of strings).",
                        "label": "Unset",
                        "index": 8
                    },
                    "userPropertiesRemove": {
                        "type": "text",
                        "tooltip": "Remove values from list-type properties (JSON object).",
                        "label": "Remove",
                        "index": 9
                    },
                    "groups": {
                        "type": "text",
                        "tooltip": "Groups to associate with the user (JSON object, e.g., {\"company\": \"acme\"}).",
                        "label": "Groups",
                        "index": 10
                    },
                    "groupProperties": {
                        "type": "text",
                        "tooltip": "Group properties identify operations to apply to the groups (JSON object).",
                        "label": "Group Properties",
                        "index": 11
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Code",
                    "value": "code",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Num Processed",
                    "value": "num_processed",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Server Upload Time",
                    "value": "server_upload_time",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PD94"
}