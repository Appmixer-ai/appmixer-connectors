{
    "name": "appmixer.amplitude.core.SendEvent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a single custom event to Amplitude to track user behavior. EU data residency customers should use api.eu.amplitude.com.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:amplitude"
    },
    "quota": {
        "manager": "appmixer:amplitude",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "eventType": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "deviceId": {
                        "type": "string"
                    },
                    "eventProperties": {
                        "type": "string"
                    }
                },
                "required": [
                    "eventType"
                ],
                "oneOf": [
                    {
                        "required": [
                            "userId"
                        ]
                    },
                    {
                        "required": [
                            "deviceId"
                        ]
                    }
                ]
            },
            "inspector": {
                "inputs": {
                    "eventType": {
                        "type": "text",
                        "tooltip": "Name of the event (e.g., 'Button Clicked').",
                        "label": "Event Type",
                        "index": 0
                    },
                    "userId": {
                        "type": "text",
                        "tooltip": "Unique identifier for the user. Required if Device ID is not provided.",
                        "label": "User ID",
                        "index": 1
                    },
                    "deviceId": {
                        "type": "text",
                        "tooltip": "A device-specific identifier, such as the Identifier for Vendor on iOS. If a Device ID isn't sent with the event, then it's set to a hashed version of the User ID",
                        "label": "Device ID",
                        "index": 2
                    },
                    "eventProperties": {
                        "type": "key-value",
                        "tooltip": "Custom key/value properties for the event.",
                        "label": "Event Properties",
                        "index": 3,
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add event",
                        "removeLabel": "Remove event"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Code",
                    "value": "code",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Events Ingested",
                    "value": "events_ingested",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Payload Size Bytes",
                    "value": "payload_size_bytes",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Server Upload Time",
                    "value": "server_upload_time",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
