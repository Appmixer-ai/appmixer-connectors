{
    "name": "appmixer.amplitude.core.UpdateCohortMembership",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Incrementally add or remove users from an existing cohort.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:amplitude"
    },
    "quota": {
        "manager": "appmixer:amplitude",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "cohort_id": {
                        "type": "string"
                    },
                    "id_type": {
                        "type": "string"
                    },
                    "adds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "removes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "cohort_id",
                    "id_type"
                ]
            },
            "inspector": {
                "inputs": {
                    "cohort_id": {
                        "type": "text",
                        "tooltip": "Existing cohort ID to update.",
                        "label": "Cohort ID",
                        "index": 0
                    },
                    "id_type": {
                        "type": "select",
                        "tooltip": "Type of identifiers for members.",
                        "label": "ID Type",
                        "options": [
                            {
                                "label": "user_id",
                                "value": "user_id"
                            },
                            {
                                "label": "amplitude_id",
                                "value": "amplitude_id"
                            }
                        ],
                        "index": 1
                    },
                    "adds": {
                        "type": "textarea",
                        "tooltip": "Comma-separated identifiers to add to the cohort (e.g., user123,user456)",
                        "label": "Adds",
                        "index": 2
                    },
                    "removes": {
                        "type": "textarea",
                        "tooltip": "Comma-separated identifiers to remove from the cohort (e.g., user123,user456)",
                        "label": "Removes",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Cohort ID",
                    "value": "cohort_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Added",
                    "value": "added",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Removed",
                    "value": "removed",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Message",
                    "value": "message",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}