{
    "name": "appmixer.amplitude.core.CreateCohort",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new cohort by uploading a list of user identifiers (user_ids or amplitude_ids).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:amplitude"
    },
    "quota": {
        "manager": "appmixer:amplitude",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "appId": {
                        "type": "string"
                    },
                    "idType": {
                        "type": "string"
                    },
                    "ids": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string"
                    },
                    "published": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name",
                    "appId",
                    "idType",
                    "ids",
                    "owner",
                    "published"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "A name for the cohort.",
                        "index": 0
                    },
                    "appId": {
                        "type": "text",
                        "label": "Project ID (App ID)",
                        "tooltip": "An identifier for the Amplitude project containing the cohort. Can be found in Organization settings -> Projects.",
                        "index": 1
                    },
                    "idType": {
                        "type": "select",
                        "label": "ID Type",
                        "tooltip": "The kind of ID sent in the IDs field.",
                        "options": [
                            {
                                "label": "By User ID",
                                "value": "BY_USER_ID"
                            },
                            {
                                "label": "By Amplitude ID",
                                "value": "BY_AMP_ID"
                            }
                        ],
                        "index": 2
                    },
                    "ids": {
                        "type": "textarea",
                        "label": "IDs",
                        "tooltip": "One or more user or Amplitude IDs to include in the cohort (separated by commas). Select the ID type in the ID Type field. Both type of IDs can be found at User Profiles",
                        "index": 3
                    },
                    "owner": {
                        "type": "text",
                        "label": "Owner",
                        "tooltip": "The login email of the cohort's owner in Amplitude.",
                        "index": 4
                    },
                    "published": {
                        "type": "toggle",
                        "label": "Published",
                        "tooltip": "Whether the cohort is discoverable or hidden.",
                        "index": 5,
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Cohort ID",
                    "value": "cohortId",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Project ID (App ID)",
                    "value": "appId",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Archived",
                    "value": "archived",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Finished",
                    "value": "finished",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Published",
                    "value": "published",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Modified",
                    "value": "lastMod",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Last Computed",
                    "value": "lastComputed",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Hidden",
                    "value": "hidden",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "View Count",
                    "value": "view_count",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Popularity",
                    "value": "popularity",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Last Viewed",
                    "value": "last_viewed",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Chart ID",
                    "value": "chart_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Edit ID",
                    "value": "edit_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Is Predictive",
                    "value": "is_predictive",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Is Official Content",
                    "value": "is_official_content",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Location ID",
                    "value": "location_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Cohort Definition Type",
                    "value": "cohort_definition_type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Cohort Output Type",
                    "value": "cohort_output_type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Is Generated Content",
                    "value": "is_generated_content",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Owners",
                    "value": "owners",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Viewers",
                    "value": "viewers",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Definition",
                    "value": "definition",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Shortcut IDs",
                    "value": "shortcut_ids",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Per App Metadata",
                    "value": "per_app_metadata",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Include Data App Types",
                    "value": "include_data_app_types",
                    "schema": {
                        "type": "array"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
