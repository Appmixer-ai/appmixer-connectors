{
    "name": "appmixer.pipedrive.crm.UpdateDeal",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action updates deal.",
    "inPorts": [
        {
            "name": "deal",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "number" },
                    "title": { "type": "string" },
                    "value": { "type": "string" },
                    "currency": { "type": "string" },
                    "user_id": { "type": "number" },
                    "org_id": { "type": "number" },
                    "person_id": { "type": "number" },
                    "stage_id": { "type": "number" },
                    "status": {
                        "enum": [
                            "open",
                            "won",
                            "lost",
                            "deleted"
                        ]
                    },
                    "visible_to": {}
                },
                "required": ["id"]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Deal Id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the deal." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListDeals?outPort=out",
                            "data": {
                                "transform": "./transformers#dealsToSelectArray"
                            }
                        }
                    },
                    "title": {
                        "type": "text",
                        "group": "transformation",
                        "index": 2,
                        "label": "Title",
                        "attrs": {
                            "label": { "data-tooltip": "Deal title." }
                        }
                    },
                    "value": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Value",
                        "attrs": {
                            "label": { "data-tooltip": "Value of the deal." }
                        }
                    },
                    "currency": {
                        "type": "text",
                        "group": "transformation",
                        "index": 4,
                        "label": "Currency",
                        "attrs": {
                            "label": { "data-tooltip": "Currency of the deal. Accepts a 3-character currency code." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListCurrencies?outPort=out",
                            "data": {
                                "transform": "./transformers#currenciesToSelectArray"
                            }
                        }
                    },
                    "user_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 5,
                        "label": "User id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the user who will be marked as the owner of this deal." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray"
                            }
                        }
                    },
                    "org_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 6,
                        "label": "Organization id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the organization this deal will be associated with." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListOrganizations?outPort=out",
                            "data": {
                                "transform": "./transformers#organizationsToSelectArray"
                            }
                        }
                    },
                    "person_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 7,
                        "label": "Person id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the person this deal will be associated with." }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListPeople?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./transformers#peopleToSelectArray"
                            }
                        }
                    },
                    "stage_id": {
                        "type": "text",
                        "group": "transformation",
                        "index": 8,
                        "label": "Stage id",
                        "attrs": {
                            "label": { "data-tooltip": "Id of the stage this deal will be placed in a pipeline" }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListStages?outPort=out",
                            "data": {
                                "transform": "./transformers#stagesToSelectArray"
                            }
                        }
                    },
                    "status": {
                        "type": "select",
                        "options": [
                            {
                                "value": "open",
                                "content": "Open"
                            },
                            {
                                "value": "won",
                                "content": "Won"
                            },
                            {
                                "value": "lost",
                                "content": "Lost"
                            },
                            {
                                "value": "deleted",
                                "content": "Deleted"
                            }
                        ],
                        "group": "transformation",
                        "index": 9,
                        "label": "Status",
                        "attrs": {
                            "label": { "data-tooltip": "Value of the deal." }
                        }
                    },
                    "visible_to": {
                        "type": "select",
                        "group": "transformation",
                        "index": 10,
                        "label": "visible_to",
                        "options": [
                            { "content": "Owner & followers (private)", "value": 1 },
                            { "content": "Entire company (shared)", "value": 3 }
                        ]
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "updatedDeal",
            "options": [
                { "label": "id", "value": "id" },
                { "label": "active", "value": "active" },
                { "label": "activities_count", "value": "activities_count" },
                { "label": "add_time", "value": "add_time" },
                { "label": "cc_email", "value": "cc_email" },
                { "label": "close_time", "value": "close_time" },
                { "label": "creator_user_id", "value": "creator_user_id" },
                { "label": "currency", "value": "currency" },
                { "label": "deleted", "value": "deleted" },
                { "label": "done_activities_count", "value": "done_activities_count" },
                { "label": "email_messages_count", "value": "email_messages_count" },
                { "label": "expected_close_date", "value": "expected_close_date" },
                { "label": "files_count", "value": "files_count" },
                { "label": "first_won_time", "value": "first_won_time" },
                { "label": "followers_count", "value": "followers_count" },
                { "label": "formatted_value", "value": "formatted_value" },
                { "label": "formatted_weighted_value", "value": "formatted_weighted_value" },
                { "label": "last_activity_date", "value": "last_activity_date" },
                { "label": "last_activity_id", "value": "last_activity_id" },
                { "label": "last_incoming_mail_time", "value": "last_incoming_mail_time" },
                { "label": "last_outgoing_mail_time", "value": "last_outgoing_mail_time" },
                { "label": "lost_reason", "value": "lost_reason" },
                { "label": "lost_time", "value": "lost_time" },
                { "label": "next_activity_date", "value": "next_activity_date" },
                { "label": "next_activity_duration", "value": "next_activity_duration" },
                { "label": "next_activity_id", "value": "next_activity_id" },
                { "label": "next_activity_note", "value": "next_activity_note" },
                { "label": "next_activity_subject", "value": "next_activity_subject" },
                { "label": "next_activity_time", "value": "next_activity_time" },
                { "label": "next_activity_type", "value": "next_activity_type" },
                { "label": "notes_count", "value": "notes_count" },
                { "label": "org_hidden", "value": "org_hidden" },
                { "label": "org_id", "value": "org_id" },
                { "label": "org_name", "value": "org_name" },
                { "label": "owner_name", "value": "owner_nameparticipants_count" },
                { "label": "participants_count", "value": "participants_count" },
                { "label": "person_hidden", "value": "person_hidden" },
                { "label": "person_id", "value": "person_id" },
                { "label": "person_name", "value": "person_name" },
                { "label": "pipeline_id", "value": "pipeline_id" },
                { "label": "products_count", "value": "products_count" },
                { "label": "reference_activities_count", "value": "reference_activities_count" },
                { "label": "rotten_time", "value": "rotten_time" },
                { "label": "stage_change_time", "value": "stage_change_time" },
                { "label": "stage_id", "value": "stage_id" },
                { "label": "stage_order_nr", "value": "stage_order_nr" },
                { "label": "status", "value": "status" },
                { "label": "title", "value": "title" },
                { "label": "undone_activities_count", "value": "undone_activities_count" },
                { "label": "update_time", "value": "update_time" },
                { "label": "user_id", "value": "user_id" },
                { "label": "value", "value": "value" },
                { "label": "visible_to", "value": "visible_to" },
                { "label": "weighted_value", "value": "weighted_value" },
                { "label": "won_time", "value": "won_time" }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "properties": {},
    "icon": "data:image/svg+xml;base64,"
}
