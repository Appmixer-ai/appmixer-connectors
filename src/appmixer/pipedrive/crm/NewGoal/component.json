{
    "name": "appmixer.pipedrive.crm.NewGoal",
    "author": "Pawel Putko <pawel.putko@neoteric.eu>",
    "description": "This trigger fires any time a new goal is added to Pipedrive.",
    "tick": true,
    "private": true,
    "outPorts": [
        {
            "name": "goal",
            "options": [
                { "label": "id", "value": "id" },
                { "label": "active_flag", "value": "active_flag" },
                { "label": "active_goal_id", "value": "active_goal_id" },
                { "label": "add_time", "value": "add_time" },
                { "label": "company_id", "value": "company_id" },
                { "label": "created_by_user_id", "value": "created_by_user_id" },
                { "label": "currency", "value": "currency" },
                { "label": "delivered", "value": "delivered" },
                { "label": "delivered_sum", "value": "delivered_sum" },
                { "label": "expected", "value": "expected" },
                { "label": "expected_sum", "value": "expected_sum" },
                { "label": "expected_type", "value": "expected_type" },
                { "label": "goal_type", "value": "goal_type" },
                { "label": "master_expected", "value": "master_expected" },
                { "label": "period", "value": "period" },
                { "label": "period_end", "value": "period_end" },
                { "label": "period_start", "value": "period_start" },
                { "label": "pipeline_id", "value": "pipeline_id" },
                { "label": "stage_id", "value": "stage_id" },
                { "label": "user_id", "value": "user_id" },
                { "label": "user_name", "value": "user_name" }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },    
    "properties": {},
    "icon": "data:image/svg+xml;base64,"
}
