{
    "name": "appmixer.pipedrive.crm.NewProduct",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires any time a new product is added to Pipedrive.",
    "tick": true,
    "outPorts": [
        {
            "name": "product",
            "options": [
                { "label": "id", "value": "id" },
                { "label": "active_flag", "value": "active_flag" },
                { "label": "add_time", "value": "add_time" },
                { "label": "code", "value": "code" },
                { "label": "files_count", "value": "files_count" },
                { "label": "first_char", "value": "first_char" },
                { "label": "followers_count", "value": "followers_count" },
                { "label": "name", "value": "name" },
                { "label": "owner_id", "value": "owner_id" },
                { "label": "closed_deals_count", "value": "closed_deals_count" },
                { "label": "prices.[0].cost", "value": "prices.[0].cost" },
                { "label": "prices.[0].currency", "value": "prices.[0].currency" },
                { "label": "prices.[0].id", "value": "prices.[0].id" },
                { "label": "prices.[0].overhead_cost", "value": "prices.[0].cost" },
                { "label": "prices.[0].price", "value": "prices.[0].price" },
                { "label": "prices.[0].product_id", "value": "prices.[0].product_id" },
                { "label": "selectable", "value": "selectable" },
                { "label": "tax", "value": "tax" },
                { "label": "unit", "value": "unit" },
                { "label": "update_time", "value": "update_time" },
                { "label": "visible_to", "value": "visible_to" }
            ]
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
