{
    "name": "appmixer.pipedrive.crm.FindDeal",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action finds deal.",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "term": {
                        "type": "string",
                        "minLength": 2
                    },
                    "orgId": {
                        "type": "number"
                    },
                    "personId": {
                        "type": "number"
                    },
                    "status": {
                        "type": "string"
                    },
                    "exactMatch": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "term"
                ]
            },
            "inspector": {
                "inputs": {
                    "term": {
                        "type": "text",
                        "index": 0,
                        "label": "Term to search for",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The term should contain at least 2 characters."
                            }
                        }
                    },
                    "orgId": {
                        "type": "text",
                        "index": 1,
                        "label": "Organization ID",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Persons's organization ID"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListOrganizations?outPort=out",
                            "data": {
                                "transform": "./transformers#organizationsToSelectArray"
                            }
                        }
                    },
                    "personId": {
                        "type": "text",
                        "index": 2,
                        "label": "Person ID",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Persons's ID"
                            }
                        },
                        "source": {
                            "url": "/component/appmixer/pipedrive/crm/ListPeople?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./transformers#peopleToSelectArray"
                            }
                        }
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Filter deals by the provided specific status.",
                        "options": [
                            {
                                "label": "Open",
                                "value": "open"
                            },
                            {
                                "label": "Won",
                                "value": "won"
                            },
                            {
                                "label": "Lost",
                                "value": "lost"
                            }
                        ],
                        "index": 3
                    },
                    "exactMatch": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Full exact match",
                        "tooltip": "When enabled, only full exact matches against the given term are returned. It is <strong>not</strong> case sensitive."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 5,
                        "defaultValue": "first",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file. For large datasets, streaming the rows to a file is the most efficient method.",
                        "options": [
                            {
                                "label": "First Found",
                                "value": "first"
                            },
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One at a time",
                                "value": "object"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/pipedrive/crm/FindDeal?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/term": "abc"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
