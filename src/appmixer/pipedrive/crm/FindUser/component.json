{
    "name": "appmixer.pipedrive.crm.FindUser",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action finds person.",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "term": {
                        "type": "string",
                        "minLength": 2
                    },
                    "searchEmail": {
                        "type": "boolean"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "term"
                ]
            },
            "inspector": {
                "inputs": {
                    "term": {
                        "type": "text",
                        "index": 0,
                        "label": "Term to search for",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The term should contain at least 2 characters."
                            }
                        }
                    },
                    "searchEmail": {
                        "type": "toggle",
                        "index": 1,
                        "label": "Search email only",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Toggle switch. If switched on, application searches ONLY through emails to match the term."
                            }
                        }
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "first",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file. For large datasets, streaming the rows to a file is the most efficient method.",
                        "options": [
                            {
                                "label": "First Found",
                                "value": "first"
                            },
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One at a time",
                                "value": "object"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/pipedrive/crm/FindUser?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/term": "abc"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "auth": {
        "service": "appmixer:pipedrive"
    },
    "quota": {
        "manager": "appmixer:pipedrive",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}
