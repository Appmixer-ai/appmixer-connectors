{
    "name": "appmixer.unkey.core.UpdateKeyRemaining",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update the remaining verifications for a key. Use this to increment or decrement the number of times a key can be used.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "keyId": {
                        "type": "string"
                    },
                    "op": {
                        "type": "string"
                    },
                    "value": {
                        "type": "integer"
                    }
                },
                "required": ["keyId", "op", "value"]
            },
            "inspector": {
                "inputs": {
                    "keyId": {
                        "type": "text",
                        "label": "Key ID",
                        "index": 1,
                        "tooltip": "The ID of the key to update"
                    },
                    "op": {
                        "type": "select",
                        "label": "Operation",
                        "index": 2,
                        "options": [
                            { "label": "Set", "value": "set" },
                            { "label": "Increment", "value": "increment" },
                            { "label": "Decrement", "value": "decrement" }
                        ],
                        "tooltip": "The operation to perform on the remaining count"
                    },
                    "value": {
                        "type": "number",
                        "label": "Value",
                        "index": 3,
                        "tooltip": "The value to set, increment, or decrement"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Remaining", "value": "remaining" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
