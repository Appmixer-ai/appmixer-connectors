{
    "name": "appmixer.unkey.core.VerifyKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Verify an API key and check if it's valid and enabled. Returns key information if valid.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "keys.verify",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "apiId": {
                        "type": "string"
                    }
                },
                "required": ["key"]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "API Key",
                        "index": 1,
                        "tooltip": "The API key to verify"
                    },
                    "apiId": {
                        "type": "text",
                        "label": "API ID",
                        "index": 2,
                        "tooltip": "Optional API ID to verify the key belongs to a specific API"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "valid",
            "options": [
                { "label": "Valid", "value": "valid" },
                { "label": "Key ID", "value": "keyId" },
                { "label": "Owner ID", "value": "ownerId" },
                { "label": "Meta", "value": "meta" },
                { "label": "Remaining", "value": "remaining" },
                { "label": "Enabled", "value": "enabled" }
            ]
        },
        {
            "name": "invalid"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
