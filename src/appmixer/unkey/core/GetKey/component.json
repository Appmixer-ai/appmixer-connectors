{
    "name": "appmixer.unkey.core.GetKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve information about a specific API key by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "keyId": {
                        "type": "string"
                    }
                },
                "required": ["keyId"]
            },
            "inspector": {
                "inputs": {
                    "keyId": {
                        "type": "text",
                        "label": "Key ID",
                        "index": 1,
                        "tooltip": "The ID of the key to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Key ID", "value": "id" },
                { "label": "API ID", "value": "apiId" },
                { "label": "Workspace ID", "value": "workspaceId" },
                { "label": "Name", "value": "name" },
                { "label": "Start", "value": "start" },
                { "label": "Owner ID", "value": "ownerId" },
                { "label": "Meta", "value": "meta" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" },
                { "label": "Deleted At", "value": "deletedAt" },
                { "label": "Expires", "value": "expires" },
                { "label": "Rate Limit", "value": "ratelimit" },
                { "label": "Remaining", "value": "remaining" },
                { "label": "Enabled", "value": "enabled" },
                { "label": "Environment", "value": "environment" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
