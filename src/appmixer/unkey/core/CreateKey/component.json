{
    "name": "appmixer.unkey.core.CreateKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new API key in Unkey. You can specify properties like prefix, metadata, rate limits, and expiration.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "keys.create",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "apiId": {
                        "type": "string"
                    },
                    "prefix": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "byteLength": {
                        "type": "integer"
                    },
                    "ownerId": {
                        "type": "string"
                    },
                    "meta": {
                        "type": "string"
                    },
                    "expires": {
                        "type": "integer"
                    },
                    "ratelimitType": {
                        "type": "string"
                    },
                    "ratelimitLimit": {
                        "type": "integer"
                    },
                    "ratelimitRefillRate": {
                        "type": "integer"
                    },
                    "ratelimitRefillInterval": {
                        "type": "integer"
                    },
                    "remaining": {
                        "type": "integer"
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                },
                "required": ["apiId"]
            },
            "inspector": {
                "inputs": {
                    "apiId": {
                        "type": "text",
                        "label": "API ID",
                        "index": 1,
                        "tooltip": "The ID of the API this key belongs to"
                    },
                    "prefix": {
                        "type": "text",
                        "label": "Key Prefix",
                        "index": 2,
                        "tooltip": "Optional prefix for the key (e.g., 'sk')"
                    },
                    "name": {
                        "type": "text",
                        "label": "Key Name",
                        "index": 3,
                        "tooltip": "A name to identify the key"
                    },
                    "byteLength": {
                        "type": "number",
                        "label": "Byte Length",
                        "index": 4,
                        "tooltip": "Length of the key in bytes (default: 16)"
                    },
                    "ownerId": {
                        "type": "text",
                        "label": "Owner ID",
                        "index": 5,
                        "tooltip": "The ID of the user who owns this key"
                    },
                    "meta": {
                        "type": "textarea",
                        "label": "Metadata (JSON)",
                        "index": 6,
                        "tooltip": "JSON object with custom metadata for the key"
                    },
                    "expires": {
                        "type": "number",
                        "label": "Expires (milliseconds)",
                        "index": 7,
                        "tooltip": "Time in milliseconds until the key expires"
                    },
                    "ratelimitType": {
                        "type": "select",
                        "label": "Rate Limit Type",
                        "index": 8,
                        "options": [
                            { "label": "None", "value": "" },
                            { "label": "Fast", "value": "fast" },
                            { "label": "Consistent", "value": "consistent" }
                        ],
                        "tooltip": "Type of rate limiting algorithm to use"
                    },
                    "ratelimitLimit": {
                        "type": "number",
                        "label": "Rate Limit",
                        "index": 9,
                        "tooltip": "Maximum number of requests allowed in the interval"
                    },
                    "ratelimitRefillRate": {
                        "type": "number",
                        "label": "Refill Rate",
                        "index": 10,
                        "tooltip": "Number of tokens to refill"
                    },
                    "ratelimitRefillInterval": {
                        "type": "number",
                        "label": "Refill Interval (ms)",
                        "index": 11,
                        "tooltip": "Interval in milliseconds for refilling tokens"
                    },
                    "remaining": {
                        "type": "number",
                        "label": "Remaining Uses",
                        "index": 12,
                        "tooltip": "Number of times this key can be used before expiring"
                    },
                    "enabled": {
                        "type": "toggle",
                        "label": "Enabled",
                        "index": 13,
                        "defaultValue": true,
                        "tooltip": "Whether the key is enabled"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Key ID", "value": "keyId" },
                { "label": "Key", "value": "key" },
                { "label": "API ID", "value": "apiId" },
                { "label": "Name", "value": "name" },
                { "label": "Owner ID", "value": "ownerId" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
