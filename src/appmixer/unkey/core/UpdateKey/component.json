{
    "name": "appmixer.unkey.core.UpdateKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update key properties including name, external ID, expiration, and enabled status.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "keyId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "externalId": {
                        "type": "string"
                    },
                    "expires": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                },
                "required": ["keyId"]
            },
            "inspector": {
                "inputs": {
                    "keyId": {
                        "type": "text",
                        "label": "Key ID",
                        "index": 1,
                        "tooltip": "The ID of the key to update"
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "Human-readable name for the key"
                    },
                    "externalId": {
                        "type": "text",
                        "label": "External ID",
                        "index": 3,
                        "tooltip": "Links the key to a user or entity in your system"
                    },
                    "expires": {
                        "type": "date-time",
                        "label": "Expires",
                        "index": 4,
                        "tooltip": "Date and time when the key will expire"
                    },
                    "enabled": {
                        "type": "toggle",
                        "label": "Enabled",
                        "index": 5,
                        "tooltip": "Enable or disable the key"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
