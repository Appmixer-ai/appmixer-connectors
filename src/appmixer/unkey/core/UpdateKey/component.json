{
    "name": "appmixer.unkey.core.UpdateKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update properties of an existing API key.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "keyId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "ownerId": {
                        "type": "string"
                    },
                    "meta": {
                        "type": "string"
                    },
                    "expires": {
                        "type": "integer"
                    },
                    "ratelimitType": {
                        "type": "string"
                    },
                    "ratelimitLimit": {
                        "type": "integer"
                    },
                    "ratelimitRefillRate": {
                        "type": "integer"
                    },
                    "ratelimitRefillInterval": {
                        "type": "integer"
                    },
                    "enabled": {
                        "type": "boolean"
                    }
                },
                "required": ["keyId"]
            },
            "inspector": {
                "inputs": {
                    "keyId": {
                        "type": "text",
                        "label": "Key ID",
                        "index": 1,
                        "tooltip": "The ID of the key to update"
                    },
                    "name": {
                        "type": "text",
                        "label": "Key Name",
                        "index": 2,
                        "tooltip": "New name for the key"
                    },
                    "ownerId": {
                        "type": "text",
                        "label": "Owner ID",
                        "index": 3,
                        "tooltip": "New owner ID for the key"
                    },
                    "meta": {
                        "type": "textarea",
                        "label": "Metadata (JSON)",
                        "index": 4,
                        "tooltip": "JSON object with updated metadata"
                    },
                    "expires": {
                        "type": "number",
                        "label": "Expires (milliseconds)",
                        "index": 5,
                        "tooltip": "New expiration time in milliseconds"
                    },
                    "ratelimitType": {
                        "type": "select",
                        "label": "Rate Limit Type",
                        "index": 6,
                        "options": [
                            { "label": "None", "value": "" },
                            { "label": "Fast", "value": "fast" },
                            { "label": "Consistent", "value": "consistent" }
                        ],
                        "tooltip": "Type of rate limiting algorithm"
                    },
                    "ratelimitLimit": {
                        "type": "number",
                        "label": "Rate Limit",
                        "index": 7,
                        "tooltip": "Maximum number of requests"
                    },
                    "ratelimitRefillRate": {
                        "type": "number",
                        "label": "Refill Rate",
                        "index": 8,
                        "tooltip": "Number of tokens to refill"
                    },
                    "ratelimitRefillInterval": {
                        "type": "number",
                        "label": "Refill Interval (ms)",
                        "index": 9,
                        "tooltip": "Interval for refilling tokens"
                    },
                    "enabled": {
                        "type": "toggle",
                        "label": "Enabled",
                        "index": 10,
                        "tooltip": "Enable or disable the key"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
