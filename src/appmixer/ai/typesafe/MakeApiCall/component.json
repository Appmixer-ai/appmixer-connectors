{
    "name": "appmixer.ai.typesafe.MakeApiCall",
    "label": "Make API Call",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Performs an arbitrary authorized call to the TypeSafe API, for example <code>POST /v1/systemone</code> with a request you build yourself.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:typesafe"
    },
    "quota": {
        "manager": "appmixer:ai:typesafe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "headers": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint Path",
                        "tooltip": "Enter the API endpoint path, for example <code>/v1/models</code> or <code>/v1/systemone</code>, or a full <code>https://api.typesafe.ai</code> URL. Endpoints on other hosts are rejected."
                    },
                    "method": {
                        "type": "select",
                        "index": 2,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "tooltip": "Select the HTTP method for the API call.",
                        "options": [
                            { "label": "GET", "value": "GET" },
                            { "label": "POST", "value": "POST" },
                            { "label": "PUT", "value": "PUT" },
                            { "label": "PATCH", "value": "PATCH" },
                            { "label": "DELETE", "value": "DELETE" }
                        ]
                    },
                    "parameters": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Query Parameters",
                        "index": 3,
                        "tooltip": "Optional query parameters."
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Request Body",
                        "tooltip": "Enter the request body as a JSON object (supports nested objects, arrays, and non-string values)."
                    },
                    "headers": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "label": "Request Headers",
                        "index": 5,
                        "tooltip": "Optional additional request headers. The Authorization header is always set from the connected account."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "integer",
                        "title": "Status Code",
                        "example": 200
                    },
                    "headers": {
                        "type": "object",
                        "title": "Response Headers",
                        "example": { "content-type": "application/json" }
                    },
                    "body": {
                        "type": "object",
                        "title": "Response Body",
                        "example": {
                            "model": "jev-1.13.0",
                            "answers": {},
                            "usage": { "input_tokens": 392, "output_tokens": 65 }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
