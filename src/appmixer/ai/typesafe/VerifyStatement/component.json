{
    "name": "appmixer.ai.typesafe.VerifyStatement",
    "label": "Verify Statement",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Check whether a statement is true for the content, using the TypeSafe Jev decision model. Returns the probability that the statement holds and a true/false result against your threshold. Works best with English content.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:typesafe"
    },
    "quota": {
        "manager": "appmixer:ai:typesafe",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "state": {},
                    "statement": {},
                    "trueCriteria": {},
                    "falseCriteria": {},
                    "threshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "model": {
                        "type": "string"
                    }
                },
                "required": [
                    "state",
                    "statement"
                ]
            },
            "inspector": {
                "inputs": {
                    "state": {
                        "type": "textarea",
                        "label": "Content",
                        "index": 1,
                        "tooltip": "The text to check, for example a customer message or a document. A JSON object or array mapped from a variable is sent as structured data. Text only, up to about 32k tokens."
                    },
                    "statement": {
                        "type": "text",
                        "label": "Statement",
                        "index": 2,
                        "tooltip": "The statement to verify, for example <code>The message conveys urgency or time-sensitivity</code>."
                    },
                    "trueCriteria": {
                        "type": "text",
                        "label": "When True",
                        "index": 3,
                        "tooltip": "Optional. Describe what makes the statement true."
                    },
                    "falseCriteria": {
                        "type": "text",
                        "label": "When False",
                        "index": 4,
                        "tooltip": "Optional. Describe what makes the statement false."
                    },
                    "threshold": {
                        "type": "number",
                        "label": "Threshold",
                        "index": 5,
                        "defaultValue": 0.5,
                        "min": 0,
                        "max": 1,
                        "step": 0.05,
                        "tooltip": "The Result output is true when the probability is greater than or equal to this value (0 to 1). Defaults to 0.5."
                    },
                    "model": {
                        "type": "text",
                        "label": "Model",
                        "index": 6,
                        "defaultValue": "jev-latest",
                        "tooltip": "Model name or alias. <code>jev-latest</code> is the stable alias, <code>jev-preview</code> the preview build; a version such as <code>jev-1.13.0</code> pins the model.",
                        "source": {
                            "url": "/component/appmixer/ai/typesafe/ListModels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListModels#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "probability": {
                        "type": "number",
                        "title": "Probability",
                        "example": 0.97
                    },
                    "result": {
                        "type": "boolean",
                        "title": "Result",
                        "example": true
                    },
                    "model": {
                        "type": "string",
                        "title": "Model",
                        "example": "jev-1.13.0"
                    },
                    "usage": {
                        "type": "object",
                        "title": "Usage",
                        "properties": {
                            "inputTokens": {
                                "type": "integer",
                                "title": "Usage.Input Tokens",
                                "example": 392
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
