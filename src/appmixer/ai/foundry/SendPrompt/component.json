{
    "name": "appmixer.ai.foundry.SendPrompt",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Send a prompt to a Large Language Model and receive a response.",
    "auth": {
        "service": "appmixer:ai:foundry"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "instructions": {
                        "type": "string"
                    },
                    "prompt": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    },
                    "temperature": {
                        "type": "number"
                    },
                    "maxTokens": {
                        "type": "integer"
                    },
                    "topP": {
                        "type": "number"
                    },
                    "frequencyPenalty": {
                        "type": "number"
                    },
                    "presencePenalty": {
                        "type": "number"
                    }
                },
                "required": [
                    "model",
                    "prompt"
                ]
            },
            "inspector": {
                "inputs": {
                    "instructions": {
                        "label": "Instructions",
                        "type": "textarea",
                        "index": 1,
                        "tooltip": "The system instructions that the model follows. For example 'You are a personal math tutor.'. Defaults to 'You are a helpful assistant.'."
                    },
                    "prompt": {
                        "label": "Prompt",
                        "type": "textarea",
                        "index": 2
                    },
                    "model": {
                        "type": "text",
                        "index": 3,
                        "label": "Deployment",
                        "tooltip": "Name of the model deployment in your Azure AI Foundry resource (Deployments in the Foundry portal), e.g. <code>gpt-4o-prod</code>. The list offers the models known to the resource; when your deployment name differs from the model name, type the deployment name.",
                        "source": {
                            "url": "/component/appmixer/ai/foundry/ListModels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListModels#toSelectOptions"
                            }
                        }
                    },
                    "temperature": {
                        "group": "advanced",
                        "type": "number",
                        "index": 4,
                        "label": "Temperature",
                        "tooltip": "A value between 0 and 2 controlling the randomness of the model. Lower values make the output more focused and deterministic, higher values more creative. Leave empty to use the model default."
                    },
                    "maxTokens": {
                        "group": "advanced",
                        "type": "number",
                        "index": 5,
                        "label": "Max Tokens",
                        "tooltip": "The maximum number of tokens the model may generate for the answer. Leave empty to let the model generate until it stops on its own or reaches the context window limit."
                    },
                    "topP": {
                        "group": "advanced",
                        "type": "number",
                        "index": 6,
                        "label": "Top P",
                        "tooltip": "The nucleus sampling threshold, a value between 0 and 1. The model considers only the tokens with the top P probability mass. We recommend altering either Temperature or Top P, but not both. Leave empty to use the model default."
                    },
                    "frequencyPenalty": {
                        "group": "advanced",
                        "type": "number",
                        "index": 7,
                        "label": "Frequency Penalty",
                        "tooltip": "A value between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. Leave empty to use the model default."
                    },
                    "presencePenalty": {
                        "group": "advanced",
                        "type": "number",
                        "index": 8,
                        "label": "Presence Penalty",
                        "tooltip": "A value between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. Leave empty to use the model default."
                    }
                },
                "groups": {
                    "advanced": {
                        "label": "Advanced",
                        "closed": true,
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Answer",
                    "value": "answer",
                    "schema": {
                        "type": "string",
                        "example": "The capital of France is Paris."
                    }
                },
                {
                    "label": "Prompt",
                    "value": "prompt",
                    "schema": {
                        "type": "string",
                        "example": "What is the capital of France?"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,",
    "version": "1.0.0"
}
