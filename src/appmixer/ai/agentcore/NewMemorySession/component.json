{
    "name": "appmixer.ai.agentcore.NewMemorySession",
    "description": "Triggers when a new memory session appears for an actor in an Amazon Bedrock AgentCore Memory resource. Polls ListSessions with the given Memory ID and Actor ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:agentcore"
    },
    "trigger": true,
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "memoryId": { "type": "string" },
                "actorId": { "type": "string" }
            },
            "required": ["memoryId", "actorId"]
        },
        "inspector": {
            "inputs": {
                "memoryId": {
                    "type": "text",
                    "label": "Memory ID",
                    "index": 1,
                    "tooltip": "The identifier of the AgentCore Memory resource to watch."
                },
                "actorId": {
                    "type": "text",
                    "label": "Actor ID",
                    "index": 2,
                    "tooltip": "The identifier of the actor whose sessions to watch."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "sessionId": { "type": "string", "title": "Session ID", "example": "session-1234567890abcdef" },
                    "actorId": { "type": "string", "title": "Actor ID", "example": "user-123" },
                    "createdAt": { "type": "string", "format": "date-time", "title": "Created At", "example": "2025-01-15T10:30:00Z" }
                }
            }
        }
    ]
}
