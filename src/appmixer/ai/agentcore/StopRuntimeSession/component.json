{
    "name": "appmixer.ai.agentcore.StopRuntimeSession",
    "description": "Stop a running session in an Amazon Bedrock AgentCore Runtime.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:agentcore"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "agentRuntimeArn": { "type": "string" },
                    "runtimeSessionId": { "type": "string" },
                    "qualifier": { "type": "string" }
                },
                "required": ["agentRuntimeArn", "runtimeSessionId"]
            },
            "inspector": {
                "inputs": {
                    "agentRuntimeArn": {
                        "type": "text",
                        "label": "Agent Runtime ARN",
                        "index": 1,
                        "tooltip": "The ARN of the agent runtime that contains the session to stop."
                    },
                    "runtimeSessionId": {
                        "type": "text",
                        "label": "Runtime Session ID",
                        "index": 2,
                        "tooltip": "The identifier of the session to stop. Must be 33-256 characters long."
                    },
                    "qualifier": {
                        "type": "text",
                        "label": "Qualifier (Endpoint)",
                        "index": 3,
                        "tooltip": "Optional endpoint name. Defaults to the DEFAULT endpoint."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ]
}
