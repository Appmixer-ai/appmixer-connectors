{
    "name": "appmixer.ai.agentcore.DeleteMemoryRecord",
    "description": "Permanently delete a memory record from an Amazon Bedrock AgentCore Memory resource.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:agentcore"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "memoryId": { "type": "string" },
                    "memoryRecordId": { "type": "string" }
                },
                "required": ["memoryId", "memoryRecordId"]
            },
            "inspector": {
                "inputs": {
                    "memoryId": {
                        "type": "text",
                        "label": "Memory ID",
                        "index": 1,
                        "tooltip": "The identifier of the AgentCore Memory resource containing the record."
                    },
                    "memoryRecordId": {
                        "type": "text",
                        "label": "Memory Record ID",
                        "index": 2,
                        "tooltip": "The identifier of the memory record to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object"
            }
        }
    ]
}
