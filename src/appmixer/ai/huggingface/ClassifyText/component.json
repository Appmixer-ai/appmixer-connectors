{
    "name": "appmixer.ai.huggingface.ClassifyText",
    "label": "Classify Text",
    "description": "Classify a piece of text with a text-classification model served by Hugging Face Inference Providers, for example sentiment, topic or toxicity. Returns the highest scoring label plus all scored labels.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:huggingface"
    },
    "quota": {
        "manager": "appmixer:ai:huggingface",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "topK": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "model",
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "text",
                        "index": 1,
                        "label": "Model",
                        "defaultValue": "distilbert/distilbert-base-uncased-finetuned-sst-2-english",
                        "tooltip": "Repository ID of a text-classification model, e.g. <code>distilbert/distilbert-base-uncased-finetuned-sst-2-english</code> for sentiment."
                    },
                    "text": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "The text to classify."
                    },
                    "topK": {
                        "type": "number",
                        "index": 3,
                        "label": "Top K",
                        "tooltip": "Return only this many highest scoring labels. Leave empty to return all of them."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "title": "Model",
                        "example": "distilbert/distilbert-base-uncased-finetuned-sst-2-english"
                    },
                    "label": {
                        "type": "string",
                        "title": "Top Label",
                        "example": "POSITIVE"
                    },
                    "score": {
                        "type": "number",
                        "title": "Top Score",
                        "example": 0.9998
                    },
                    "labels": {
                        "type": "array",
                        "title": "All Labels",
                        "items": {
                            "type": "object",
                            "properties": {
                                "label": {
                                    "type": "string",
                                    "title": "Label",
                                    "example": "POSITIVE"
                                },
                                "score": {
                                    "type": "number",
                                    "title": "Score",
                                    "example": 0.9998
                                }
                            }
                        },
                        "example": [
                            {
                                "label": "POSITIVE",
                                "score": 0.9998
                            },
                            {
                                "label": "NEGATIVE",
                                "score": 0.0002
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
