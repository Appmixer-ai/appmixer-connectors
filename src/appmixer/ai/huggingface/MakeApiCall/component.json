{
    "name": "appmixer.ai.huggingface.MakeApiCall",
    "label": "Make API Call",
    "description": "Perform an arbitrary authorized API call to Hugging Face. Choose the Hub API or the Inference Providers router, then provide a path (or full URL), method, headers, query parameters and body. The access token is added automatically.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:huggingface"
    },
    "quota": {
        "manager": "appmixer:ai:huggingface",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "api": {
                        "type": "string",
                        "enum": [
                            "hub",
                            "router"
                        ]
                    },
                    "url": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "PATCH",
                            "DELETE"
                        ]
                    },
                    "headers": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "url",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint Path",
                        "tooltip": "A path relative to the selected API, for example <code>/api/models</code> or <code>/v1/chat/completions</code>. A full URL is accepted only when it points at <code>https://huggingface.co</code> or <code>https://router.huggingface.co</code>; any other host is rejected so your token is never sent elsewhere."
                    },
                    "method": {
                        "type": "select",
                        "index": 2,
                        "label": "HTTP Method",
                        "defaultValue": "GET",
                        "tooltip": "The HTTP method for the API call. Hub read endpoints are GET, inference endpoints are POST.",
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            },
                            {
                                "label": "PUT",
                                "value": "PUT"
                            },
                            {
                                "label": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "label": "DELETE",
                                "value": "DELETE"
                            }
                        ]
                    },
                    "parameters": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "index": 3,
                        "label": "Query Parameters",
                        "tooltip": "Optional query parameters."
                    },
                    "body": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Request Body",
                        "tooltip": "Optional JSON request body."
                    },
                    "headers": {
                        "type": "key-value",
                        "keyLabel": "Key",
                        "valueLabel": "Value",
                        "addLabel": "Add item",
                        "removeLabel": "Remove item",
                        "index": 5,
                        "label": "Request Headers",
                        "tooltip": "Optional additional headers. The Authorization header is set automatically."
                    },
                    "api": {
                        "type": "select",
                        "index": 6,
                        "label": "API Host",
                        "defaultValue": "hub",
                        "tooltip": "Which Hugging Face host a relative path is resolved against. Ignored when a full URL is given.",
                        "options": [
                            {
                                "label": "Hub API (huggingface.co)",
                                "value": "hub"
                            },
                            {
                                "label": "Inference Providers (router.huggingface.co)",
                                "value": "router"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": "integer",
                        "title": "Status Code",
                        "example": 200
                    },
                    "headers": {
                        "type": "object",
                        "title": "Response Headers",
                        "properties": {}
                    },
                    "body": {
                        "type": "object",
                        "title": "Response Body",
                        "properties": {}
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
