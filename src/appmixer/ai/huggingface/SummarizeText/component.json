{
    "name": "appmixer.ai.huggingface.SummarizeText",
    "label": "Summarize Text",
    "description": "Condense a long piece of text into a short summary using a summarization model served by Hugging Face Inference Providers.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ai:huggingface"
    },
    "quota": {
        "manager": "appmixer:ai:huggingface",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "truncation": {
                        "type": "string"
                    }
                },
                "required": [
                    "model",
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "text",
                        "index": 1,
                        "label": "Model",
                        "defaultValue": "facebook/bart-large-cnn",
                        "tooltip": "Repository ID of a summarization model, e.g. <code>facebook/bart-large-cnn</code> or <code>google/pegasus-xsum</code>."
                    },
                    "text": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "The text to summarize."
                    },
                    "truncation": {
                        "type": "select",
                        "index": 3,
                        "label": "Truncation",
                        "tooltip": "How to handle text longer than the model's context window. Leave empty for the model default.",
                        "options": [
                            {
                                "label": "Do not truncate",
                                "value": "do_not_truncate"
                            },
                            {
                                "label": "Longest first",
                                "value": "longest_first"
                            },
                            {
                                "label": "Only first",
                                "value": "only_first"
                            },
                            {
                                "label": "Only second",
                                "value": "only_second"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "title": "Model",
                        "example": "facebook/bart-large-cnn"
                    },
                    "summary": {
                        "type": "string",
                        "title": "Summary",
                        "example": "The Eiffel Tower is a wrought-iron lattice tower in Paris, completed in 1889."
                    },
                    "inputLength": {
                        "type": "integer",
                        "title": "Input Length",
                        "example": 1842
                    },
                    "summaryLength": {
                        "type": "integer",
                        "title": "Summary Length",
                        "example": 78
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
