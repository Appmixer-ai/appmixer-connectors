{
    "name": "appmixer.ai.grok.ReasoningCompletion",
    "description": "Generate responses with step-by-step reasoning using Grok mini reasoning models.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ai:grok"
    },
    "quota": {
        "manager": "appmixer:ai:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "messages": {
                        "type": "object"
                    },
                    "reasoningEffort": {
                        "type": "string",
                        "default": "medium"
                    },
                    "temperature": {
                        "type": "number"
                    },
                    "topP": {
                        "type": "number"
                    },
                    "maxTokens": {
                        "type": "integer"
                    },
                    "stream": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "model",
                    "messages"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "Reasoning-capable model (e.g., grok-3-mini-latest, grok-3-mini-fast-latest).",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messages": {
                        "type": "expression",
                        "tooltip": "Array of message objects with role and content.",
                        "label": "Messages",
                        "index": 1,
                        "levels": ["ADD"],
                        "fields": {
                            "role": {
                                "type": "select",
                                "label": "Role",
                                "tooltip": "The role of the message author.",
                                "index": 1,
                                "options": [
                                    {
                                        "label": "System",
                                        "value": "system"
                                    },
                                    {
                                        "label": "User",
                                        "value": "user"
                                    },
                                    {
                                        "label": "Assistant",
                                        "value": "assistant"
                                    }
                                ]
                            },
                            "content": {
                                "type": "text",
                                "label": "Content",
                                "tooltip": "The content of the message.",
                                "index": 2
                            }
                        }
                    },
                    "reasoningEffort": {
                        "type": "select",
                        "tooltip": "Amount of compute spent in reasoning.",
                        "label": "Reasoning Effort",
                        "options": [
                            {
                                "label": "Low",
                                "value": "low"
                            },
                            {
                                "label": "Medium",
                                "value": "medium"
                            },
                            {
                                "label": "High",
                                "value": "high"
                            }
                        ],
                        "index": 2
                    },
                    "temperature": {
                        "type": "number",
                        "tooltip": "What sampling temperature to use, between 0 and 2.",
                        "label": "Temperature",
                        "index": 3
                    },
                    "topP": {
                        "type": "number",
                        "tooltip": "An alternative to sampling with temperature.",
                        "label": "Top P",
                        "index": 4
                    },
                    "maxTokens": {
                        "type": "number",
                        "tooltip": "The maximum number of tokens to generate.",
                        "label": "Max Tokens",
                        "index": 5
                    },
                    "stream": {
                        "type": "toggle",
                        "tooltip": "Whether to stream the results.",
                        "label": "Stream",
                        "index": 6,
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Reasoning Completion ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Choices.Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Message.Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Message.Content"
                                        },
                                        "reasoning_content": {
                                            "type": "string",
                                            "title": "Message.Reasoning Content"
                                        },
                                        "refusal": {
                                            "type": "string",
                                            "title": "Message.Refusal"
                                        }
                                    },
                                    "title": "Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Finish Reason"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Total Tokens"
                            },
                            "prompt_tokens_details": {
                                "type": "object",
                                "properties": {
                                    "text_tokens": {
                                        "type": "number",
                                        "title": "Prompt Tokens Details.Text Tokens"
                                    },
                                    "audio_tokens": {
                                        "type": "number",
                                        "title": "Prompt Tokens Details.Audio Tokens"
                                    },
                                    "image_tokens": {
                                        "type": "number",
                                        "title": "Prompt Tokens Details.Image Tokens"
                                    },
                                    "cached_tokens": {
                                        "type": "number",
                                        "title": "Prompt Tokens Details.Cached Tokens"
                                    }
                                },
                                "title": "Prompt Tokens Details"
                            },
                            "completion_tokens_details": {
                                "type": "object",
                                "properties": {
                                    "reasoning_tokens": {
                                        "type": "number",
                                        "title": "Completion Tokens Details.Reasoning Tokens"
                                    },
                                    "audio_tokens": {
                                        "type": "number",
                                        "title": "Completion Tokens Details.Audio Tokens"
                                    },
                                    "accepted_prediction_tokens": {
                                        "type": "number",
                                        "title": "Completion Tokens Details.Accepted Prediction Tokens"
                                    },
                                    "rejected_prediction_tokens": {
                                        "type": "number",
                                        "title": "Completion Tokens Details.Rejected Prediction Tokens"
                                    }
                                },
                                "title": "Completion Tokens Details"
                            },
                            "num_sources_used": {
                                "type": "number",
                                "title": "Number of Sources Used"
                            }
                        }
                    }
                },
                {
                    "label": "System Fingerprint",
                    "value": "system_fingerprint",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
