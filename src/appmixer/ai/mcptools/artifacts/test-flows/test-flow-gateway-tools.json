{
    "name": "E2E MCPGateway - gateway-tools",
    "description": "E2E test: MCPGateway registers with ToolStart tools, webhook tool call returns ToolOutput response. This flow requires external orchestration (script) to test webhook calling.",
    "customFields": {
        "category": "E2E_test_flow"
    },
    "flow": {
        "mcp-gateway": {
            "type": "appmixer.ai.mcptools.MCPGateway",
            "label": "MCPGateway",
            "x": 300,
            "y": 200,
            "source": {},
            "config": {}
        },
        "tool-start-echo": {
            "type": "appmixer.ai.agenttools.ToolStart",
            "label": "EchoTool",
            "x": 300,
            "y": 400,
            "source": {
                "in": {
                    "mcp-gateway": ["tools"]
                }
            },
            "config": {
                "properties": {
                    "description": "A simple echo tool that returns whatever message it receives",
                    "parameters": {
                        "ADD": [
                            {
                                "name": "message",
                                "description": "The message to echo back",
                                "type": "string"
                            }
                        ]
                    }
                }
            }
        },
        "tool-output-echo": {
            "type": "appmixer.ai.agenttools.ToolOutput",
            "label": "EchoOutput",
            "x": 500,
            "y": 400,
            "source": {
                "in": {
                    "tool-start-echo": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "tool-start-echo": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "output": {
                                        "msg-var": {
                                            "variable": "$.tool-start-echo.out.args.message",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "output": "echo: {{{msg-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "tool-start-greet": {
            "type": "appmixer.ai.agenttools.ToolStart",
            "label": "GreetTool",
            "x": 300,
            "y": 600,
            "source": {
                "in": {
                    "mcp-gateway": ["tools"]
                }
            },
            "config": {
                "properties": {
                    "description": "Greets a person by name",
                    "parameters": {
                        "ADD": [
                            {
                                "name": "name",
                                "description": "Name of the person to greet",
                                "type": "string"
                            }
                        ]
                    }
                }
            }
        },
        "tool-output-greet": {
            "type": "appmixer.ai.agenttools.ToolOutput",
            "label": "GreetOutput",
            "x": 500,
            "y": 600,
            "source": {
                "in": {
                    "tool-start-greet": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "tool-start-greet": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "output": {
                                        "name-var": {
                                            "variable": "$.tool-start-greet.out.args.name",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "output": "Hello, {{{name-var}}}!"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
