{
    "name": "appmixer.clerk.core.GetUser",
    "label": "Get User",
    "description": "Retrieves details for a specific user from your Clerk application.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "icon": "https://clerk.com/favicon/favicon.svg",
    "auth": {
        "service": "appmixer:clerk"
    },
    "quota": {
        "manager": "appmixer:clerk",
        "resources": "default",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string",
                        "title": "User ID",
                        "description": "ID of the user to retrieve"
                    }
                },
                "required": ["userId"]
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "text",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "firstName": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "lastName": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "username": {
                        "type": "string",
                        "title": "Username"
                    },
                    "emailAddresses": {
                        "type": "array",
                        "title": "Email Addresses",
                        "items": {
                            "type": "object"
                        }
                    },
                    "phoneNumbers": {
                        "type": "array",
                        "title": "Phone Numbers",
                        "items": {
                            "type": "object"
                        }
                    },
                    "externalAccounts": {
                        "type": "array",
                        "title": "External Accounts",
                        "items": {
                            "type": "object"
                        }
                    },
                    "publicMetadata": {
                        "type": "object",
                        "title": "Public Metadata"
                    },
                    "privateMetadata": {
                        "type": "object",
                        "title": "Private Metadata"
                    },
                    "createdAt": {
                        "type": "number",
                        "title": "Created At"
                    },
                    "updatedAt": {
                        "type": "number",
                        "title": "Updated At"
                    }
                }
            }
        }
    ]
}
