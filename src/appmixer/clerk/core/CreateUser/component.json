{
    "name": "appmixer.clerk.core.CreateUser",
    "label": "Create User",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new user with the provided information.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:clerk"
    },
    "quota": {
        "manager": "appmixer:clerk",
        "resources": "users.create"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "emailAddress": {
                        "type": "string",
                        "title": "Email Address",
                        "description": "Email address of the new user"
                    },
                    "firstName": {
                        "type": "string",
                        "title": "First Name",
                        "description": "First name of the new user"
                    },
                    "lastName": {
                        "type": "string",
                        "title": "Last Name",
                        "description": "Last name of the new user"
                    },
                    "password": {
                        "type": "string",
                        "title": "Password",
                        "description": "Password for the new user"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "title": "Phone Number",
                        "description": "Phone number for the new user"
                    },
                    "username": {
                        "type": "string",
                        "title": "Username",
                        "description": "Username for the new user"
                    },
                    "publicMetadata": {
                        "type": "object",
                        "title": "Public Metadata",
                        "description": "Public metadata for the user"
                    },
                    "privateMetadata": {
                        "type": "object",
                        "title": "Private Metadata",
                        "description": "Private metadata for the user"
                    },
                    "skipPasswordChecks": {
                        "type": "boolean",
                        "title": "Skip Password Checks",
                        "description": "Skip password policy checks",
                        "default": false
                    }
                },
                "required": ["emailAddress"]
            },
            "inspector": {
                "inputs": {
                    "emailAddress": {
                        "type": "text",
                        "index": 1
                    },
                    "firstName": {
                        "type": "text",
                        "index": 2
                    },
                    "lastName": {
                        "type": "text",
                        "index": 3
                    },
                    "password": {
                        "type": "password",
                        "index": 4
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 5
                    },
                    "username": {
                        "type": "text",
                        "index": 6
                    },
                    "publicMetadata": {
                        "type": "code",
                        "index": 7
                    },
                    "privateMetadata": {
                        "type": "code",
                        "index": 8
                    },
                    "skipPasswordChecks": {
                        "type": "checkbox",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name"
                    },
                    "email_addresses": {
                        "type": "array",
                        "title": "Email Addresses",
                        "items": {
                            "type": "object"
                        }
                    }
                }
            }
        }
    ],
    "icon": "https://clerk.com/favicon/favicon.svg"
}