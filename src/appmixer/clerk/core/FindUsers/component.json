{
    "name": "appmixer.clerk.core.FindUsers",
    "label": "Find Users",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a list of users with optional search criteria.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:clerk"
    },
    "quota": {
        "manager": "appmixer:clerk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limit": {
                        "type": "number",
                        "title": "Limit",
                        "description": "Maximum number of users to return (1-500)",
                        "default": 10
                    },
                    "offset": {
                        "type": "number",
                        "title": "Offset",
                        "description": "Number of users to skip",
                        "default": 0
                    },
                    "emailAddress": {
                        "type": "string",
                        "title": "Email Address",
                        "description": "Filter users by email address"
                    },
                    "username": {
                        "type": "string",
                        "title": "Username",
                        "description": "Filter users by username"
                    },
                    "phoneNumber": {
                        "type": "string",
                        "title": "Phone Number",
                        "description": "Filter users by phone number"
                    },
                    "userId": {
                        "type": "string",
                        "title": "User ID",
                        "description": "Filter users by user ID"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "limit": {
                        "type": "number",
                        "index": 1
                    },
                    "offset": {
                        "type": "number",
                        "index": 2
                    },
                    "emailAddress": {
                        "type": "text",
                        "index": 3
                    },
                    "username": {
                        "type": "text",
                        "index": 4
                    },
                    "phoneNumber": {
                        "type": "text",
                        "index": 5
                    },
                    "userId": {
                        "type": "text",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "title": "Users",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "ID"
                                },
                                "first_name": {
                                    "type": "string",
                                    "title": "First Name"
                                },
                                "last_name": {
                                    "type": "string",
                                    "title": "Last Name"
                                },
                                "email_addresses": {
                                    "type": "array",
                                    "title": "Email Addresses"
                                }
                            }
                        }
                    },
                    "total_count": {
                        "type": "number",
                        "title": "Total Count"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
