{
    "name": "appmixer.teavaro.googleads.CustomerMatchUpload",
    "description": "Upload Customer Match data to Google Ads audiences. Processes CSV files and uploads hashed emails to Google Ads User Lists.",
    "author": "Teavaro Team - David Clavijo Castro <david.castro@teavaro.com>",
    "version": "2.2.8",
    "private": false,
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "oneOf": [
                            {"type": "string"},
                            {"type": "object"}
                        ],
                        "description": "CSV file: Appmixer file ID (string) OR file content from previous component (object)"
                    },
                    "developerToken": {
                        "type": "string",
                        "description": "Google Ads API Developer Token"
                    },
                    "loginCustomerId": {
                        "type": "string",
                        "description": "Google Ads Login Customer ID (manager account)"
                    },
                    "customerId": {
                        "type": "string",
                        "description": "Google Ads Customer ID (ad account to upload to)"
                    },
                    "segmentToUserList": {
                        "type": "string",
                        "description": "JSON mapping of segment names to User List IDs"
                    },
                    "uploadMode": {
                        "type": "string",
                        "description": "Upload mode: REPLACE (clear existing data first) or ADD (append to existing data)"
                    },
                    "batchSize": {
                        "type": "number",
                        "description": "Batch size for Google Ads API operations (default: 10000, max: 100000). Lower values use less memory."
                    },
                    "adPersonalization": {
                        "type": "string",
                        "description": "Consent status for ad personalization: GRANTED or DENIED"
                    },
                    "adUserData": {
                        "type": "string",
                        "description": "Consent status for ad user data: GRANTED or DENIED"
                    }
                },
                "required": ["fileId", "developerToken", "customerId", "segmentToUserList"]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "index": 0,
                        "type": "filepicker",
                        "label": "CSV File or Content",
                        "tooltip": "CSV file from Appmixer storage OR direct file content from Google Drive. Supports large files (1GB+)."
                    },
                    "developerToken": {
                        "index": 1,
                        "type": "text",
                        "label": "Developer Token",
                        "tooltip": "Google Ads API Developer Token"
                    },
                    "loginCustomerId": {
                        "index": 2,
                        "type": "text",
                        "label": "Login Customer ID (Optional)",
                        "tooltip": "Google Ads Manager Account ID (without dashes). Only required if accessing through a Manager/MCC account. Leave empty for direct access."
                    },
                    "customerId": {
                        "index": 3,
                        "type": "text",
                        "label": "Customer ID",
                        "tooltip": "Google Ads Customer Account ID (without dashes)"
                    },
                    "segmentToUserList": {
                        "index": 4,
                        "type": "textarea",
                        "label": "Segment to User List Mapping",
                        "tooltip": "JSON object mapping segment names to User List IDs, e.g. {\"segment1\": \"123456\", \"segment2\": \"789012\"}. NO trailing commas!"
                    },
                    "uploadMode": {
                        "index": 5,
                        "type": "select",
                        "label": "Upload Mode",
                        "tooltip": "REPLACE: Clear existing audience data before upload. ADD: Append to existing audience data.",
                        "options": [
                            {"label": "Replace (Clear First)", "value": "REPLACE"},
                            {"label": "Add (Append)", "value": "ADD"}
                        ],
                        "defaultValue": "REPLACE"
                    },
                    "batchSize": {
                        "index": 6,
                        "type": "number",
                        "label": "Batch Size",
                        "tooltip": "Number of users per Google Ads API batch. Max: 100000. Lower values use less memory. Default: 10000",
                        "defaultValue": 10000
                    },
                    "adPersonalization": {
                        "index": 7,
                        "type": "select",
                        "label": "Ad Personalization Consent (Advanced)",
                        "tooltip": "REQUIRED by Google Ads API for GDPR compliance. Leave as GRANTED unless you have specific privacy requirements.",
                        "options": [
                            {"label": "Granted", "value": "GRANTED"},
                            {"label": "Denied", "value": "DENIED"}
                        ],
                        "defaultValue": "GRANTED"
                    },
                    "adUserData": {
                        "index": 8,
                        "type": "select",
                        "label": "Ad User Data Consent (Advanced)",
                        "tooltip": "REQUIRED by Google Ads API for GDPR compliance. Leave as GRANTED unless you have specific privacy requirements.",
                        "options": [
                            {"label": "Granted", "value": "GRANTED"},
                            {"label": "Denied", "value": "DENIED"}
                        ],
                        "defaultValue": "GRANTED"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Total Jobs", "value": "totalJobs" },
                { "label": "Total Users", "value": "totalUsers" },
                { "label": "Jobs By Segment", "value": "jobsBySegment" },
                { "label": "Errors", "value": "errors" },
                { "label": "Internal Errors", "value": "internalErrors" },
                { "label": "Success", "value": "success" }
            ]
        },
        {
            "name": "progress",
            "options": [
                { "label": "Segment", "value": "segment" },
                { "label": "Current Batch", "value": "currentBatch" },
                { "label": "Total Batches", "value": "totalBatches" },
                { "label": "Uploaded So Far", "value": "uploadedSoFar" },
                { "label": "Total Users", "value": "totalUsers" },
                { "label": "Progress %", "value": "progress" },
                { "label": "Elapsed Seconds", "value": "elapsedSeconds" },
                { "label": "ETA Seconds", "value": "etaSeconds" },
                { "label": "Status", "value": "status" },
                { "label": "Message", "value": "message" },
                { "label": "Concurrency Limit", "value": "concurrencyLimit" },
                { "label": "Concurrency Active", "value": "concurrencyActive" },
                { "label": "Concurrency Queued", "value": "concurrencyQueued" },
                { "label": "Retry Attempt", "value": "retryAttempt" },
                { "label": "Max Retries", "value": "maxRetries" },
                { "label": "Retry Reason", "value": "retryReason" },
                { "label": "Retry Message", "value": "retryMessage" },
                { "label": "Waiting Seconds", "value": "waitingSeconds" }
            ]
        }
    ],
    "dependencies": {
        "google-ads-api": "^21.0.1",
        "csv-parse": "^5.3.10"
    },
    "icon": "data:image/svg+xml;base64,"
}
