                    "in": {
                        "9002e507-91d8-4401-8190-6cd8792d03b6": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "url": {
                                        "40dc252d-3ac6-4f85-a5d0-4d9edfd79086": {
                                            "functions": [
                                                { "name": "g_webhookUrl" },
                                                { "name": "g_replace", "params": [{ "value": "/flows/" }, { "value": "/plugins/appmixer/google/youtube/trigger/" }] },
                                                { "name": "g_replace", "params": [{ "value": "/components/95a7b015-16d3-4ef1-b99f-9e8f2c7d0518" }, { "value": "/component/fd454672-8e6c-40e3-8227-a389a76ccda0" }] }
                                            ]
                                        }
                                    },
                                    "headers": {},
                                    "bodyType": {},
                                    "body": {}
                                },
                                "lambda": {
                                    "url": "{{{40dc252d-3ac6-4f85-a5d0-4d9edfd79086}}}",
                                    "headers": "{\"Content-Type\": \"application/atom+xml\"}",
                                    "bodyType": "raw",
                                    "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><feed xmlns:yt=\"http://www.youtube.com/xml/schemas/2015\" xmlns=\"http://www.w3.org/2005/Atom\"><link rel=\"hub\" href=\"https://pubsubhubbub.appspot.com\"/><link rel=\"self\" href=\"https://www.youtube.com/xml/feeds/videos.xml?channel_id=UC_x5XG1OV2P6uZZ5FSM9Ttw\"/><title>YouTube video feed</title><updated>2026-11-06T10:00:05+00:00</updated><entry><id>yt:video:e2eVideo0001</id><yt:videoId>e2eVideo0001</yt:videoId><yt:channelId>UC_x5XG1OV2P6uZZ5FSM9Ttw</yt:channelId><title>E2E synthetic video</title><link rel=\"alternate\" href=\"https://www.youtube.com/watch?v=e2eVideo0001\"/><author><name>E2E Channel</name><uri>https://www.youtube.com/channel/UC_x5XG1OV2P6uZZ5FSM9Ttw</uri></author><published>2026-11-06T10:00:00+00:00</published><updated>2026-11-06T10:00:05+00:00</updated></entry></feed>"
                                }
                            }
                        }
                    }
                }
            },
            "errorHandling": { "autoRetry": false, "onError": "stopFlow" }
        },
