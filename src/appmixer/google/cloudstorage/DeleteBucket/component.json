{
    "name": "appmixer.google.cloudstorage.DeleteBucket",
    "label": "Delete Bucket",
    "description": "Delete an empty bucket. The request fails when the bucket still contains objects.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/devstorage.read_write"
        ]
    },
    "quota": {
        "manager": "appmixer:google:cloudstorage",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "bucket": {
                        "type": "string"
                    }
                },
                "required": [
                    "bucket"
                ]
            },
            "inspector": {
                "inputs": {
                    "bucket": {
                        "type": "text",
                        "index": 1,
                        "label": "Bucket",
                        "tooltip": "Name of the empty bucket to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
