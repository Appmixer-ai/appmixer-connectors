{
    "name": "appmixer.google.cloudstorage.UpdateObjectMetadata",
    "label": "Update Object Metadata",
    "description": "Update the metadata of an object: content type, caching and custom metadata. Fields left empty are not changed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/devstorage.read_write"
        ]
    },
    "quota": {
        "manager": "appmixer:google:cloudstorage",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "bucket": {
                        "type": "string"
                    },
                    "objectName": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string"
                    },
                    "cacheControl": {
                        "type": "string"
                    },
                    "contentDisposition": {
                        "type": "string"
                    },
                    "contentEncoding": {
                        "type": "string"
                    },
                    "contentLanguage": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "string"
                    }
                },
                "required": [
                    "bucket",
                    "objectName"
                ]
            },
            "inspector": {
                "inputs": {
                    "bucket": {
                        "type": "text",
                        "index": 1,
                        "label": "Bucket",
                        "tooltip": "Name of the bucket, for example <code>my-bucket</code>."
                    },
                    "objectName": {
                        "type": "text",
                        "index": 2,
                        "label": "Object Name",
                        "tooltip": "Full name of the object including its folder path, for example <code>reports/2026/summary.csv</code>."
                    },
                    "contentType": {
                        "type": "text",
                        "index": 3,
                        "label": "Content Type",
                        "tooltip": "MIME type of the object, for example <code>application/pdf</code>."
                    },
                    "cacheControl": {
                        "type": "text",
                        "index": 4,
                        "label": "Cache Control",
                        "tooltip": "Cache-Control header served with the object, for example <code>public, max-age=3600</code>."
                    },
                    "contentDisposition": {
                        "type": "text",
                        "index": 5,
                        "label": "Content Disposition",
                        "tooltip": "Content-Disposition header served with the object, for example <code>attachment; filename=\"report.pdf\"</code>."
                    },
                    "contentEncoding": {
                        "type": "text",
                        "index": 6,
                        "label": "Content Encoding",
                        "tooltip": "Content-Encoding header served with the object, for example <code>gzip</code>."
                    },
                    "contentLanguage": {
                        "type": "text",
                        "index": 7,
                        "label": "Content Language",
                        "tooltip": "Content-Language of the object, an ISO 639-1 code such as <code>en</code>."
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 8,
                        "label": "Custom Metadata",
                        "tooltip": "JSON object of custom metadata, for example <code>{\"department\": \"finance\"}</code>. Keys are added or replaced; a key set to <code>null</code> is removed."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
