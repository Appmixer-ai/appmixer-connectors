{
    "name": "appmixer.google.cloudstorage.NewBucket",
    "label": "New Bucket",
    "description": "Fires when a bucket is created in a Google Cloud project. Checks the project periodically.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/devstorage.read_write"
        ]
    },
    "quota": {
        "manager": "appmixer:google:cloudstorage",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "projectId": {
                    "type": "string"
                }
            },
            "required": [
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "projectId": {
                    "type": "text",
                    "index": 1,
                    "label": "Project ID",
                    "tooltip": "ID of the Google Cloud project, for example <code>my-project-123456</code>. Find it in the Google Cloud console project selector."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "location",
                    "storageClass",
                    "timeCreated",
                    "updated"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "my-bucket"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "my-bucket"
                    },
                    "projectNumber": {
                        "type": "string",
                        "title": "Project Number",
                        "example": "123456789012"
                    },
                    "location": {
                        "type": "string",
                        "title": "Location",
                        "example": "US-CENTRAL1"
                    },
                    "locationType": {
                        "type": "string",
                        "title": "Location Type",
                        "example": "region"
                    },
                    "storageClass": {
                        "type": "string",
                        "title": "Storage Class",
                        "example": "STANDARD"
                    },
                    "metageneration": {
                        "type": "string",
                        "title": "Metageneration",
                        "example": "1"
                    },
                    "etag": {
                        "type": "string",
                        "title": "ETag",
                        "example": "CAE="
                    },
                    "timeCreated": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Time Created",
                        "example": "2026-11-20T10:30:00.123Z"
                    },
                    "updated": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated",
                        "example": "2026-11-20T10:30:00.123Z"
                    },
                    "selfLink": {
                        "type": "string",
                        "title": "Self Link",
                        "example": "https://www.googleapis.com/storage/v1/b/my-bucket"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
