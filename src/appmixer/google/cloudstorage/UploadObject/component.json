{
    "name": "appmixer.google.cloudstorage.UploadObject",
    "label": "Upload Object",
    "description": "Upload a file to a bucket as an object. An existing object with the same name is replaced.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/devstorage.read_write"
        ]
    },
    "quota": {
        "manager": "appmixer:google:cloudstorage",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "bucket": {
                        "type": "string"
                    },
                    "fileId": {
                        "type": "string"
                    },
                    "objectName": {
                        "type": "string"
                    },
                    "contentType": {
                        "type": "string"
                    }
                },
                "required": [
                    "bucket",
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "bucket": {
                        "type": "text",
                        "index": 1,
                        "label": "Bucket",
                        "tooltip": "Name of the bucket, for example <code>my-bucket</code>."
                    },
                    "fileId": {
                        "type": "filepicker",
                        "index": 2,
                        "label": "File",
                        "tooltip": "Select an existing file or upload a new one. Its content is uploaded to the bucket."
                    },
                    "objectName": {
                        "type": "text",
                        "index": 3,
                        "label": "Object Name",
                        "tooltip": "Name of the new object including its folder path, for example <code>reports/2026/summary.csv</code>. Defaults to the file name."
                    },
                    "contentType": {
                        "type": "text",
                        "index": 4,
                        "label": "Content Type",
                        "tooltip": "MIME type of the object, for example <code>text/csv</code>. Defaults to the type of the file."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "bucket",
                    "generation",
                    "metageneration",
                    "size",
                    "timeCreated",
                    "updated"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "my-bucket/reports/2026/summary.csv/1763635200123456"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "reports/2026/summary.csv"
                    },
                    "bucket": {
                        "type": "string",
                        "title": "Bucket",
                        "example": "my-bucket"
                    },
                    "generation": {
                        "type": "string",
                        "title": "Generation",
                        "example": "1763635200123456"
                    },
                    "metageneration": {
                        "type": "string",
                        "title": "Metageneration",
                        "example": "1"
                    },
                    "contentType": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "text/csv"
                    },
                    "size": {
                        "type": "string",
                        "title": "Size (Bytes)",
                        "example": "2048"
                    },
                    "md5Hash": {
                        "type": "string",
                        "title": "MD5 Hash",
                        "example": "XrY7u+Ae7tCTyyK7j1rNww=="
                    },
                    "crc32c": {
                        "type": "string",
                        "title": "CRC32C",
                        "example": "yZRlqg=="
                    },
                    "etag": {
                        "type": "string",
                        "title": "ETag",
                        "example": "CMDj8pvMm5EDEAE="
                    },
                    "storageClass": {
                        "type": "string",
                        "title": "Storage Class",
                        "example": "STANDARD"
                    },
                    "cacheControl": {
                        "type": "string",
                        "title": "Cache Control",
                        "example": "no-cache"
                    },
                    "contentDisposition": {
                        "type": "string",
                        "title": "Content Disposition",
                        "example": "attachment; filename=\"summary.csv\""
                    },
                    "contentEncoding": {
                        "type": "string",
                        "title": "Content Encoding",
                        "example": "gzip"
                    },
                    "contentLanguage": {
                        "type": "string",
                        "title": "Content Language",
                        "example": "en"
                    },
                    "metadata": {
                        "type": "object",
                        "title": "Custom Metadata",
                        "properties": {},
                        "example": {
                            "department": "finance"
                        }
                    },
                    "timeCreated": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Time Created",
                        "example": "2026-11-20T10:30:00.123Z"
                    },
                    "updated": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated",
                        "example": "2026-11-20T10:30:00.123Z"
                    },
                    "mediaLink": {
                        "type": "string",
                        "title": "Media Link",
                        "example": "https://storage.googleapis.com/download/storage/v1/b/my-bucket/o/reports%2F2026%2Fsummary.csv?generation=1763635200123456&alt=media"
                    },
                    "selfLink": {
                        "type": "string",
                        "title": "Self Link",
                        "example": "https://www.googleapis.com/storage/v1/b/my-bucket/o/reports%2F2026%2Fsummary.csv"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
