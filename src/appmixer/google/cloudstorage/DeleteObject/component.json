{
    "name": "appmixer.google.cloudstorage.DeleteObject",
    "label": "Delete Object",
    "description": "Delete an object. In a bucket with object versioning the object becomes a noncurrent version.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:google",
        "scope": [
            "https://www.googleapis.com/auth/devstorage.read_write"
        ]
    },
    "quota": {
        "manager": "appmixer:google:cloudstorage",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "bucket": {
                        "type": "string"
                    },
                    "objectName": {
                        "type": "string"
                    }
                },
                "required": [
                    "bucket",
                    "objectName"
                ]
            },
            "inspector": {
                "inputs": {
                    "bucket": {
                        "type": "text",
                        "index": 1,
                        "label": "Bucket",
                        "tooltip": "Name of the bucket, for example <code>my-bucket</code>."
                    },
                    "objectName": {
                        "type": "text",
                        "index": 2,
                        "label": "Object Name",
                        "tooltip": "Full name of the object including its folder path, for example <code>reports/2026/summary.csv</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
