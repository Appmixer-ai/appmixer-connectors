{
    "name": "appmixer.freshdesk.tickets.NewConversation",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when a new conversation (reply or private note) is added to a ticket.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "tickets.polling",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "ignoreAgents": {
                    "type": ["array", "string"]
                },
                "include": {
                    "type": ["array", "string"]
                }
            }
        },
        "inspector": {
            "inputs": {
                "include": {
                    "type": "multiselect",
                    "label": "Include",
                    "index": 1,
                    "defaultValue": ["conversations", "notes"],
                    "tooltip": "Choose which types of conversations to detect. <b>Conversations</b> are public replies; <b>Notes</b> are private notes. Both are selected by default.",
                    "options": [
                        { "label": "Conversations (replies)", "value": "conversations" },
                        { "label": "Notes (private)", "value": "notes" }
                    ]
                },
                "ignoreAgents": {
                    "type": "multiselect",
                    "label": "Ignore Agents",
                    "index": 2,
                    "tooltip": "If the new conversation was added by any of these agents, the trigger will not fire.",
                    "source": {
                        "url": "/component/appmixer/freshdesk/agents/ListAgents?outPort=agents",
                        "data": {
                            "transform": "./ListAgents#agentsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Conversation",
                    "value": "conversation",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "number", "title": "ID" },
                            "body": { "type": "string", "title": "Body (HTML)" },
                            "body_text": { "type": "string", "title": "Body (Text)" },
                            "ticket_id": { "type": "number", "title": "Ticket ID" },
                            "user_id": { "type": "number", "title": "User ID" },
                            "private": { "type": "boolean", "title": "Private" },
                            "source": { "type": "number", "title": "Source" },
                            "created_at": { "type": "string", "title": "Created At" },
                            "updated_at": { "type": "string", "title": "Updated At" }
                        }
                    }
                },
                {
                    "label": "Conversation Type",
                    "value": "conversationType",
                    "schema": { "type": "string" }
                },
                {
                    "label": "All Conversations",
                    "value": "conversationsList",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "number", "title": "ID" },
                                "body": { "type": "string", "title": "Body (HTML)" },
                                "body_text": { "type": "string", "title": "Body (Text)" },
                                "ticket_id": { "type": "number", "title": "Ticket ID" },
                                "user_id": { "type": "number", "title": "User ID" },
                                "private": { "type": "boolean", "title": "Private" },
                                "source": { "type": "number", "title": "Source" },
                                "created_at": { "type": "string", "title": "Created At" },
                                "updated_at": { "type": "string", "title": "Updated At" }
                            }
                        }
                    }
                },
                {
                    "label": "Ticket",
                    "value": "ticket",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "number", "title": "ID" },
                            "subject": { "type": "string", "title": "Subject" },
                            "status": { "type": "number", "title": "Status" },
                            "priority": { "type": "number", "title": "Priority" },
                            "type": { "type": "string", "title": "Type" },
                            "responder_id": { "type": "number", "title": "Agent ID" },
                            "requester_id": { "type": "number", "title": "Requester ID" },
                            "group_id": { "type": "number", "title": "Group ID" },
                            "due_by": { "type": "string", "title": "Due By" },
                            "created_at": { "type": "string", "title": "Created At" },
                            "updated_at": { "type": "string", "title": "Updated At" }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
