{
    "name": "appmixer.freshdesk.tickets.CreateReply",
    "author": "Camilo Manrique <camilo@client.io>",
    "description": "Add a reply to a Freshdesk ticket.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "tickets.conversation.reply",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "number"
                    },
                    "body": {
                        "type": "string"
                    },
                    "agentId": {
                        "type": "number"
                    },
                    "ccEmails": {
                        "type": "string"
                    },
                    "bccEmails": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId",
                    "body"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "index": 1
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body",
                        "index": 2
                    },
                    "agentId": {
                        "type": "select",
                        "label": "Agent",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/freshdesk/agents/ListAgents?outPort=agents",
                            "data": {
                                "transform": "./ListAgents#agentsToSelectArray"
                            }
                        }
                    },
                    "ccEmails": {
                        "type": "text",
                        "label": "CC Emails",
                        "tooltip": "Comma-separated email addresses to CC",
                        "index": 4
                    },
                    "bccEmails": {
                        "type": "text",
                        "label": "BCC Emails",
                        "tooltip": "Comma-separated email addresses to BCC",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "newReply",
            "options": [
                {
                    "label": "Reply ID",
                    "value": "id"
                },
                {
                    "label": "Ticket ID",
                    "value": "ticketId"
                },
                {
                    "label": "Body (HTML)",
                    "value": "body"
                },
                {
                    "label": "Body (Text)",
                    "value": "bodyText"
                },
                {
                    "label": "Agent ID",
                    "value": "agentId"
                },
                {
                    "label": "Created At",
                    "value": "createdAt"
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}