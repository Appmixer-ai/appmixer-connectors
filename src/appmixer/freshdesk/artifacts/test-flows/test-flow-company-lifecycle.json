{
    "name": "E2E Freshdesk - Company Lifecycle",
    "description": "End-to-end test for Freshdesk connector - tests Company CRUD lifecycle (Create, Find, Get, Update, Delete)",
    "customFields": {
        "category": "E2E_test_flow"
    },
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "companyName",
                                                "text": "E2E Test Company"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedName",
                                                "text": "E2E Test Company Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-company": {
            "type": "appmixer.freshdesk.companies.CreateCompany",
            "x": 640,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {
                                        "var-name": {
                                            "variable": "$.set-variables.out.companyName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "name": "{{{var-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "find-companies": {
            "type": "appmixer.freshdesk.companies.FindCompanies",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-company": [
                        "company"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-company": {
                            "company": {
                                "type": "json2new",
                                "modifiers": {
                                    "searchName": {
                                        "var-search": {
                                            "variable": "$.set-variables.out.companyName",
                                            "functions": []
                                        }
                                    },
                                    "outputType": {}
                                },
                                "lambda": {
                                    "searchName": "{{{var-search}}}",
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-company": {
            "type": "appmixer.freshdesk.companies.GetCompany",
            "x": 1024,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-companies": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-companies": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "companyId": {
                                        "var-id": {
                                            "variable": "$.create-company.company.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "companyId": "{{{var-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-company": {
            "type": "appmixer.freshdesk.companies.UpdateCompany",
            "x": 1216,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-company": [
                        "company"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-company": {
                            "company": {
                                "type": "json2new",
                                "modifiers": {
                                    "companyId": {
                                        "var-id": {
                                            "variable": "$.create-company.company.id",
                                            "functions": []
                                        }
                                    },
                                    "name": {
                                        "var-updated-name": {
                                            "variable": "$.set-variables.out.updatedName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "companyId": "{{{var-id}}}",
                                    "name": "{{{var-updated-name}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1408,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-company": [
                        "company"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-company": {
                            "company": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "id": {
                                            "variable": "$.create-company.company.id",
                                            "functions": []
                                        },
                                        "name": {
                                            "variable": "$.create-company.company.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.companyName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-find": {
            "type": "appmixer.utils.test.Assert",
            "x": 1408,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-companies": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-companies": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "found-id": {
                                            "variable": "$.find-companies.out.id",
                                            "functions": []
                                        },
                                        "expected-id": {
                                            "variable": "$.create-company.company.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{found-id}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-id}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 1408,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-company": [
                        "company"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-company": {
                            "company": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "name": {
                                            "variable": "$.get-company.company.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.companyName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1408,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-company": [
                        "company"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-company": {
                            "company": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "name": {
                                            "variable": "$.update-company.company.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.updatedName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1600,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-find": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-company": {
            "type": "appmixer.freshdesk.companies.DeleteCompany",
            "x": 1792,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "companyId": {
                                        "var-id": {
                                            "variable": "$.create-company.company.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "companyId": "{{{var-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1984,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-company": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "69cd26f6e2b144c4b022fd1e",
                    "failedStoreId": "69cd26f6e92e34e939fd2d1a"
                },
                "transform": {
                    "in": {
                        "delete-company": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Freshdesk - Company Lifecycle",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}