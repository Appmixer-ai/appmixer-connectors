{
    "name": "appmixer.freshdesk.solutionFolders.UpdateFolder",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update a solution folder in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "visibility": {
                        "type": "number"
                    }
                },
                "required": [
                    "folderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "index": 1,
                        "tooltip": "ID of the solution folder to update. Required."
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "New name of the solution folder."
                    },
                    "description": {
                        "type": "text",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "New description of the solution folder."
                    },
                    "visibility": {
                        "type": "select",
                        "label": "Visibility",
                        "index": 4,
                        "tooltip": "Who can see this folder.",
                        "options": [
                            {
                                "label": "Public",
                                "value": 0
                            },
                            {
                                "label": "Logged-in Users",
                                "value": 1
                            },
                            {
                                "label": "Agents Only",
                                "value": 2
                            },
                            {
                                "label": "Bots",
                                "value": 3
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "folder",
            "options": [
                {
                    "label": "Folder ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Description",
                    "value": "description"
                },
                {
                    "label": "Category ID",
                    "value": "categoryId"
                },
                {
                    "label": "Visibility",
                    "value": "visibility"
                },
                {
                    "label": "Company IDs",
                    "value": "companyIds"
                },
                {
                    "label": "Position",
                    "value": "position"
                },
                {
                    "label": "Created At",
                    "value": "createdAt"
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt"
                }
            ]
        }
    ]
}