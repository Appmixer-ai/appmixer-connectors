{
    "name": "appmixer.freshdesk.companies.FindCompanies",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Search and filter companies in Freshdesk.",
    "private": false,
    "auth": { "service": "appmixer:freshdesk" },
    "quota": { "manager": "appmixer:freshdesk", "resources": "contacts.polling", "scope": { "userId": "{{userId}}" } },
    "properties": {
        "schema": {
            "properties": { "generateOutputPortOptions": { "type": "boolean" } }
        }
    },
    "inPorts": [{
        "name": "in",
        "schema": {
            "type": "object",
            "properties": {
                "searchName": { "type": "string" },
                "query": { "type": "string" },
                "page": { "type": "number" },
                "outputType": { "type": "string" }
            }
        },
        "inspector": {
            "inputs": {
                "outputType": {
                    "type": "select",
                    "label": "Output Type",
                    "index": 0,
                    "defaultValue": "array",
                    "tooltip": "Choose whether you want to receive the result set as one complete list, the first item only, one item at a time, or stream the items to a file.",
                    "options": [
                        { "label": "First Item Only", "value": "first" },
                        { "label": "All items at once", "value": "array" },
                        { "label": "One item at a time", "value": "object" },
                        { "label": "Store to CSV file", "value": "file" }
                    ]
                },
                "searchName": {
                    "type": "text",
                    "label": "Search by Name",
                    "index": 1,
                    "group": "nameSearch",
                    "tooltip": "Search for companies by name using the autocomplete endpoint. The search is case-insensitive and supports prefix matching. Returns limited fields (ID and Name only) — use <b>GetCompany</b> for the full record. If provided, the fields below are ignored."
                },
                "query": {
                    "type": "text",
                    "label": "Search Query",
                    "index": 1,
                    "group": "filter",
                    "tooltip": "Filter companies using Freshdesk's search syntax: <b>keyword:'value'</b>. Spaces around <b>AND</b> / <b>OR</b> are mandatory. The query will be automatically wrapped in double quotes. If provided, the Page field is ignored. See <a href=\"https://developers.freshdesk.com/api/#filter_companies\" target=\"_blank\">Freshdesk API docs</a> for full reference."
                },
                "page": {
                    "type": "number",
                    "label": "Page",
                    "index": 2,
                    "group": "filter",
                    "tooltip": "Page number for pagination when listing all companies (30 per page).",
                    "defaultValue": 1
                }
            },
            "groups": {
                "nameSearch": { "label": "Search by Name", "index": 1 },
                "filter": { "label": "Filter by Fields", "index": 2 }
            }
        }
    }],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/freshdesk/companies/FindCompanies?outPort=out",
                "data": {
                    "properties": { "generateOutputPortOptions": true },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/searchName": "inputs/in/searchName"
                    }
                }
            }
        },
        { "name": "notFound" }
    ],
    "icon": "data:image/svg+xml;base64,"
}
