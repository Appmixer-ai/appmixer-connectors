{
    "name": "appmixer.freshdesk.solutionArticles.GetArticle",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a solution article from Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "articleId": {
                        "type": "string"
                    }
                },
                "required": [
                    "articleId"
                ]
            },
            "inspector": {
                "inputs": {
                    "articleId": {
                        "type": "text",
                        "label": "Article ID",
                        "index": 1,
                        "tooltip": "ID of the solution article. Required."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "article",
            "options": [
                {
                    "label": "Article ID",
                    "value": "id"
                },
                {
                    "label": "Title",
                    "value": "title"
                },
                {
                    "label": "Description",
                    "value": "description"
                },
                {
                    "label": "Article Type",
                    "value": "articleType"
                },
                {
                    "label": "Folder ID",
                    "value": "folderId"
                },
                {
                    "label": "Category ID",
                    "value": "categoryId"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Agent ID",
                    "value": "agentId"
                },
                {
                    "label": "Tags",
                    "value": "tags"
                },
                {
                    "label": "Created At",
                    "value": "createdAt"
                },
                {
                    "label": "Updated At",
                    "value": "updatedAt"
                }
            ]
        }
    ]
}