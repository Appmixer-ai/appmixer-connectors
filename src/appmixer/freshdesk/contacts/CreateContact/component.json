{
    "name": "appmixer.freshdesk.contacts.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new contact in Freshdesk.",
    "private": false,
    "auth": {
        "service": "appmixer:freshdesk"
    },
    "quota": {
        "manager": "appmixer:freshdesk",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "phone": { "type": "string" },
                    "mobile": { "type": "string" },
                    "twitterId": { "type": "string" },
                    "uniqueExternalId": { "type": "string" },
                    "otherEmails": { "type": "string" },
                    "companyId": { "type": "number" },
                    "viewAllTickets": { "type": "boolean" },
                    "description": { "type": "string" },
                    "jobTitle": { "type": "string" },
                    "tags": { "type": "string" },
                    "address": { "type": "string" }
                },
                "required": ["name"],
                "anyOf": [
                    { "required": ["email"] },
                    { "required": ["phone"] },
                    { "required": ["mobile"] },
                    { "required": ["twitterId"] },
                    { "required": ["uniqueExternalId"] }
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Full Name",
                        "index": 1,
                        "group": "basic",
                        "tooltip": "Full name of the contact. Required."
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "index": 2,
                        "group": "basic",
                        "tooltip": "Primary email address of the contact."
                    },
                    "phone": {
                        "type": "text",
                        "label": "Phone",
                        "index": 3,
                        "group": "basic",
                        "tooltip": "Telephone number of the contact."
                    },
                    "mobile": {
                        "type": "text",
                        "label": "Mobile",
                        "index": 4,
                        "group": "basic",
                        "tooltip": "Mobile number of the contact."
                    },
                    "twitterId": {
                        "type": "text",
                        "label": "Twitter Handle",
                        "index": 5,
                        "group": "basic",
                        "tooltip": "Twitter handle of the contact."
                    },
                    "uniqueExternalId": {
                        "type": "text",
                        "label": "Unique External ID",
                        "index": 6,
                        "group": "basic",
                        "tooltip": "External ID to identify the contact uniquely in another system."
                    },
                    "otherEmails": {
                        "type": "text",
                        "label": "Other Emails",
                        "index": 7,
                        "group": "basic",
                        "tooltip": "Comma-separated list of additional email addresses."
                    },
                    "jobTitle": {
                        "type": "text",
                        "label": "Job Title",
                        "index": 1,
                        "group": "details",
                        "tooltip": "Job title of the contact."
                    },
                    "companyId": {
                        "type": "number",
                        "label": "Company ID",
                        "index": 2,
                        "group": "details",
                        "tooltip": "ID of the company to associate with this contact."
                    },
                    "viewAllTickets": {
                        "type": "toggle",
                        "label": "View All Tickets",
                        "index": 3,
                        "group": "details",
                        "tooltip": "Set to true if the contact can see all tickets from their company."
                    },
                    "address": {
                        "type": "text",
                        "label": "Address",
                        "index": 4,
                        "group": "details",
                        "tooltip": "Address of the contact."
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 5,
                        "group": "details",
                        "tooltip": "A short description of the contact."
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "index": 6,
                        "group": "details",
                        "tooltip": "Comma-separated tags for this contact."
                    }
                },
                "groups": {
                    "basic": {
                        "label": "Basic Info",
                        "index": 1
                    },
                    "details": {
                        "label": "Additional Details",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "contact",
            "options": [
                { "label": "Contact ID", "value": "id" },
                { "label": "Name", "value": "name" },
                { "label": "Email", "value": "email" },
                { "label": "Phone", "value": "phone" },
                { "label": "Mobile", "value": "mobile" },
                { "label": "Twitter Handle", "value": "twitterId" },
                { "label": "Unique External ID", "value": "uniqueExternalId" },
                { "label": "Company ID", "value": "companyId" },
                { "label": "View All Tickets", "value": "viewAllTickets" },
                { "label": "Job Title", "value": "jobTitle" },
                { "label": "Description", "value": "description" },
                { "label": "Address", "value": "address" },
                { "label": "Tags", "value": "tags" },
                { "label": "Active", "value": "active" },
                { "label": "Created At", "value": "createdAt" },
                { "label": "Updated At", "value": "updatedAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
