{
    "name": "appmixer.replicate.core.CreatePrediction",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new machine learning prediction using a specified model version or official model.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:replicate"
    },
    "quota": {
        "manager": "appmixer:replicate",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "version": {
                        "type": "string"
                    },
                    "input": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "version": {
                        "type": "text",
                        "tooltip": "Model version identifier or official model name.",
                        "label": "Version",
                        "index": 0
                    },
                    "input": {
                        "type": "textarea",
                        "tooltip": "Object containing model-specific input parameters, such as prompt, file URL, etc. Provide as JSON object.",
                        "label": "Input",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
