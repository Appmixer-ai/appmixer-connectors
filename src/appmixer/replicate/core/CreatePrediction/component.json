{
    "name": "appmixer.replicate.core.CreatePrediction",
    "description": "Creates a new machine learning prediction using a specified model version or official model.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:replicate"
    },
    "quota": {
        "manager": "appmixer:replicate",
        "resources": "predictions"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "version": {
                        "type": "string"
                    },
                    "input": {
                        "type": "object"
                    },
                    "webhook": {
                        "type": "string"
                    },
                    "webhook_events_filter": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": ["version", "input"]
            },
            "inspector": {
                "inputs": {
                    "version": {
                        "type": "text",
                        "label": "Version",
                        "index": 1,
                        "tooltip": "Model version identifier (e.g., 'stability-ai/stable-diffusion:27b93a2413e7f36cd83da926f3656280b2931564ff050bf9575f1fdf9bcd7478') or official model name."
                    },
                    "input": {
                        "type": "textarea",
                        "label": "Input",
                        "index": 2,
                        "tooltip": "Object containing model-specific input parameters, such as prompt, file URL, etc. Provide as JSON object or string."
                    },
                    "webhook": {
                        "type": "text",
                        "label": "Webhook URL",
                        "index": 3,
                        "tooltip": "Optional webhook URL to receive notifications when the prediction status changes."
                    },
                    "webhook_events_filter": {
                        "type": "textarea",
                        "label": "Webhook Events Filter",
                        "index": 4,
                        "tooltip": "Optional array of events to filter webhook notifications (e.g., [\"start\", \"output\", \"completed\"]). Provide as JSON array."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Version",
                    "value": "version",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Input",
                    "value": "input",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Output",
                    "value": "output",
                    "schema": {
                        "type": "object"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                {
                    "label": "Started At",
                    "value": "started_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                {
                    "label": "Completed At",
                    "value": "completed_at",
                    "schema": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                {
                    "label": "URLs",
                    "value": "urls",
                    "schema": {
                        "type": "object"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
