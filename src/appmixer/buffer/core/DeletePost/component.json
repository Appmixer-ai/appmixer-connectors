{
    "name": "appmixer.buffer.core.DeletePost",
    "label": "Delete Post",
    "description": "Delete a post from Buffer. A post already published on the social network stays there.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:buffer"
    },
    "quota": {
        "manager": "appmixer:buffer",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "postId": {
                        "type": "string"
                    }
                },
                "required": [
                    "postId"
                ]
            },
            "inspector": {
                "inputs": {
                    "postId": {
                        "type": "text",
                        "index": 1,
                        "label": "Post ID",
                        "tooltip": "The ID of the post to delete. Use Find Posts to look it up."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
