{
    "name": "appmixer.buffer.core.GetChannel",
    "label": "Get Channel",
    "description": "Retrieve a channel (a connected social profile) by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:buffer"
    },
    "quota": {
        "manager": "appmixer:buffer",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channelId": {
                        "type": "string"
                    }
                },
                "required": [
                    "channelId"
                ]
            },
            "inspector": {
                "inputs": {
                    "channelId": {
                        "type": "text",
                        "index": 1,
                        "label": "Channel",
                        "tooltip": "Pick a channel (a connected social profile), or type its Channel ID.",
                        "source": {
                            "url": "/component/appmixer/buffer/core/ListChannels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListChannels#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Channel ID",
                        "example": "5f8e1c2b3a4d5e6f7a8b9c0d"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "acme"
                    },
                    "displayName": {
                        "type": "string",
                        "title": "Display Name",
                        "example": "Acme Inc."
                    },
                    "service": {
                        "type": "string",
                        "title": "Service",
                        "example": "linkedin"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "page"
                    },
                    "descriptor": {
                        "type": "string",
                        "title": "Descriptor",
                        "example": "LinkedIn Page"
                    },
                    "avatar": {
                        "type": "string",
                        "title": "Avatar",
                        "example": "https://example.com/avatars/acme.png"
                    },
                    "organizationId": {
                        "type": "string",
                        "title": "Organization ID",
                        "example": "5e7a1b2c3d4e5f6a7b8c9d0e"
                    },
                    "timezone": {
                        "type": "string",
                        "title": "Timezone",
                        "example": "Europe/London"
                    },
                    "isDisconnected": {
                        "type": "boolean",
                        "title": "Is Disconnected",
                        "example": false
                    },
                    "isLocked": {
                        "type": "boolean",
                        "title": "Is Locked",
                        "example": false
                    },
                    "isQueuePaused": {
                        "type": "boolean",
                        "title": "Is Queue Paused",
                        "example": false
                    },
                    "externalLink": {
                        "type": "string",
                        "title": "External Link",
                        "example": "https://www.linkedin.com/company/acme"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2025-01-15T10:30:00.000Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At",
                        "example": "2026-02-01T08:00:00.000Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
