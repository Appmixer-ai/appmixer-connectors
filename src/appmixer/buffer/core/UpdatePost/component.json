{
    "name": "appmixer.buffer.core.UpdatePost",
    "label": "Update Post",
    "description": "Edit a post that has not been sent yet. Only the fields you fill in are changed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:buffer"
    },
    "quota": {
        "manager": "appmixer:buffer",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "postId": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "mode": {
                        "type": "string"
                    },
                    "dueAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "imageUrls": {
                        "type": "string"
                    }
                },
                "required": [
                    "postId"
                ]
            },
            "inspector": {
                "inputs": {
                    "postId": {
                        "type": "text",
                        "index": 1,
                        "label": "Post ID",
                        "tooltip": "The ID of the post to edit. Use Find Posts to look it up."
                    },
                    "text": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "New text of the post. Leave empty to keep the current text."
                    },
                    "mode": {
                        "type": "select",
                        "index": 3,
                        "label": "Mode",
                        "tooltip": "Change how the post is scheduled. Leave empty to keep the current schedule; filling in Due At alone reschedules it to that time.",
                        "options": [
                            {
                                "label": "Keep current",
                                "value": ""
                            },
                            {
                                "label": "Add to Queue",
                                "value": "addToQueue"
                            },
                            {
                                "label": "Share Next",
                                "value": "shareNext"
                            },
                            {
                                "label": "Share Now",
                                "value": "shareNow"
                            },
                            {
                                "label": "Custom Scheduled",
                                "value": "customScheduled"
                            }
                        ]
                    },
                    "dueAt": {
                        "type": "date-time",
                        "index": 4,
                        "label": "Due At",
                        "tooltip": "New publishing time. Required when Mode is Custom Scheduled."
                    },
                    "imageUrls": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Image URLs",
                        "tooltip": "Replace the images of the post, one public URL per line (or comma separated). Leave empty to keep the current images."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
