{
    "name": "appmixer.chartquery.core.CreateQrCode",
    "label": "Create QR Code",
    "description": "Generate a QR code and return a public link to the image.",
    "author": "ChartQuery <josselin@chartquery.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:chartquery"
    },
    "quota": {
        "manager": "appmixer:chartquery",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "string"
                    },
                    "format": {
                        "type": "string"
                    },
                    "size": {
                        "type": "number"
                    }
                },
                "required": [
                    "data"
                ]
            },
            "inspector": {
                "inputs": {
                    "data": {
                        "type": "text",
                        "index": 1,
                        "label": "Data",
                        "tooltip": "Text or URL to encode."
                    },
                    "format": {
                        "type": "select",
                        "index": 2,
                        "label": "Format",
                        "tooltip": "Image format.",
                        "defaultValue": "svg",
                        "options": [
                            {
                                "label": "SVG",
                                "value": "svg"
                            },
                            {
                                "label": "PNG",
                                "value": "png"
                            }
                        ]
                    },
                    "size": {
                        "type": "number",
                        "index": 3,
                        "label": "Size",
                        "tooltip": "Size in pixels (default 200)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "cq-e49a4481"
                    },
                    "render_url": {
                        "type": "string",
                        "title": "Image URL",
                        "example": "https://api.chartquery.com/v1/qrcode/render/cq-e49a4481"
                    },
                    "view_url": {
                        "type": "string",
                        "title": "View URL",
                        "example": "https://api.chartquery.com/v1/qrcode/view/cq-e49a4481"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
