{
    "name": "appmixer.snowflake.db.ListColumns",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "List the columns of a table.",
    "private": false,
    "auth": {
        "service": "appmixer:snowflake"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "schema": {
                        "type": "string"
                    },
                    "table": {
                        "type": "string"
                    }
                },
                "required": [
                    "schema",
                    "table"
                ]
            },
            "inspector": {
                "inputs": {
                    "schema": {
                        "type": "text",
                        "label": "Schema",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/snowflake/db/ListSchemas?outPort=schemas",
                            "data": {
                                "transform": "./ListSchemas#schemasToSelectArray"
                            }
                        },
                        "tooltip": "Select a schema."
                    },
                    "table": {
                        "type": "text",
                        "label": "Table",
                        "index": 2,
                        "tooltip": "Provide a table name.",
                        "source": {
                            "url": "/component/appmixer/snowflake/db/ListTables?outPort=tables",
                            "data": {
                                "messages": {
                                    "in/schema": "inputs/in/schema"
                                },
                                "properties": {
                                    "sendWholeArray": true
                                },
                                "transform": "./ListTables#tablesToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Columns",
                    "value": "columns",
                    "schema": { "type": "array", "example": [{ "column_name": "ID", "data_type": "NUMBER" }, { "column_name": "NAME", "data_type": "VARCHAR" }] }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}