{
    "name": "appmixer.snowflake.db.UpdatedRow",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Triggers when a row in a Snowflake table is updated.",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:snowflake"
    },
    "state": {
        "persistent": true
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "schema": {
                    "type": "string"
                },
                "table": {
                    "type": "string"
                }
            },
            "required": [
                "schema",
                "table"
            ]
        },
        "inspector": {
            "inputs": {
                "schema": {
                    "type": "text",
                    "label": "Schema",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/snowflake/db/ListSchemas?outPort=schemas",
                        "data": {
                            "properties": {
                                "sendWholeArray": true
                            },
                            "transform": "./ListSchemas#schemasToSelectArray"
                        }
                    },
                    "tooltip": "The schema of the table. Pick one or type its name."
                },
                "table": {
                    "type": "text",
                    "label": "Table",
                    "index": 2,
                    "tooltip": "The table to watch. Pick one or type its name. The connector creates a stream on it when the flow starts.",
                    "source": {
                        "url": "/component/appmixer/snowflake/db/ListTables?outPort=tables",
                        "data": {
                            "messages": {
                                "in/schema": "properties/schema"
                            },
                            "properties": {
                                "sendWholeArray": true
                            },
                            "transform": "./ListTables#tablesToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Old Row",
                    "value": "oldRow",
                    "schema": { "type": "object", "example": { "ID": 1, "NAME": "John Doe", "EMAIL": "john@example.com" } }
                },
                {
                    "label": "Updated Row",
                    "value": "updatedRow",
                    "schema": { "type": "object", "example": { "ID": 1, "NAME": "Jane Doe", "EMAIL": "jane@example.com" } }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}