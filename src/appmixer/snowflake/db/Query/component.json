{
    "name": "appmixer.snowflake.db.Query",
    "author": "Harsha Surisetty <harsha@client.io>",
    "description": "Run an arbitrary query against your Snowflake database.",
    "private": false,
    "auth": {
        "service": "appmixer:snowflake"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "row",
                            "rows",
                            "file"
                        ],
                        "outputTypeModes": {
                            "row": "item",
                            "rows": "array",
                            "file": "file"
                        }
                    },
                    "parameters": {
                        "type": "object"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "textarea",
                        "index": 0,
                        "label": "Query",
                        "tooltip": "The SQL statement to run. Use <code>?</code> placeholders for values that come from the flow and fill them in <b>Parameters</b>, for example <code>SELECT * FROM PUBLIC.USERS WHERE EMAIL = ?</code>. Refer to tables as <code>SCHEMA.TABLE</code>; the database comes from the connected account."
                    },
                    "parameters": {
                        "type": "expression",
                        "index": 1,
                        "label": "Parameters",
                        "levels": [
                            "ADD"
                        ],
                        "fields": {
                            "value": {
                                "type": "text",
                                "label": "Value",
                                "tooltip": "Bound to the next <code>?</code> placeholder in the query. The value is sent separately from the SQL text, so quotes in it cannot break the statement."
                            }
                        },
                        "tooltip": "Values for the <code>?</code> placeholders in the query, in order. Use them instead of putting flow variables into the query text."
                    },
                    "outputType": {
                        "type": "select",
                        "options": [
                            {
                                "content": "One row at a time",
                                "value": "row"
                            },
                            {
                                "content": "All rows at once",
                                "value": "rows"
                            },
                            {
                                "content": "Stream to file",
                                "value": "file"
                            }
                        ],
                        "defaultValue": "file",
                        "index": 2,
                        "label": "Output Type",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one row at a time or stream the rows to a file. For large datasets, streaming the rows to a file is the most efficient method."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/snowflake/db/Query?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/query": "inputs/in/query"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}