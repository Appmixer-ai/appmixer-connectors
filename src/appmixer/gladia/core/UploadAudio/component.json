{
    "name": "appmixer.gladia.core.UploadAudio",
    "label": "Upload Audio",
    "description": "Upload an audio or video file to Gladia and return a hosted audio URL that can be passed to the Transcribe Audio component.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:gladia"
    },
    "quota": {
        "manager": "appmixer:gladia",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string" }
                },
                "required": ["fileId"]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "index": 0,
                        "label": "Audio File",
                        "tooltip": "The audio or video file to upload to Gladia for transcription."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "audio_url": {
                        "type": "string",
                        "title": "Audio URL",
                        "example": "https://api.gladia.io/file/6c09400e-23d2-4bd2-be55-96a5ececfa3b"
                    },
                    "audio_metadata": {
                        "type": "object",
                        "title": "Audio Metadata",
                        "properties": {
                            "id": { "type": "string", "title": "ID", "example": "6c09400e-23d2-4bd2-be55-96a5ececfa3b" },
                            "filename": { "type": "string", "title": "Filename", "example": "meeting.mp3" },
                            "extension": { "type": "string", "title": "Extension", "example": "mp3" },
                            "size": { "type": "integer", "title": "Size (bytes)", "example": 2048576 },
                            "audio_duration": { "type": "number", "title": "Audio Duration (seconds)", "example": 128.5 },
                            "number_of_channels": { "type": "integer", "title": "Number Of Channels", "example": 2 }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
