{
    "name": "appmixer.deepgram.core.NewRequest",
    "label": "New Request",
    "description": "Triggers when a new API request is logged for the selected Deepgram project. Polls the project request log and deduplicates by request ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "projectId": { "type": "string" }
            },
            "required": [
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "projectId": {
                    "type": "text",
                    "index": 1,
                    "label": "Project",
                    "tooltip": "The Deepgram project to monitor. Start typing to pick from your projects, or enter a project ID manually.",
                    "source": {
                        "url": "/component/appmixer/deepgram/core/ListProjects?outPort=out",
                        "data": {
                            "transform": "./ListProjects#toSelectArray",
                            "messages": {
                                "in/outputType": "array",
                                "in/isSource": true
                            }
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" },
                    "project_uuid": { "type": "string", "title": "Project UUID", "example": "bb9e3a1c-1f4e-4c2a-9c3d-2b7f5a6e8d10" },
                    "created": { "type": "string", "format": "date-time", "title": "Created", "example": "2026-01-15T10:30:00Z" },
                    "path": { "type": "string", "title": "Path", "example": "/v1/listen" },
                    "code": { "type": "integer", "title": "Response Code", "example": 200 },
                    "callback": { "type": "string", "title": "Callback", "example": "" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
