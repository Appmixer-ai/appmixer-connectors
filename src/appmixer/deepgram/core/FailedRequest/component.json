{
    "name": "appmixer.deepgram.core.FailedRequest",
    "label": "Failed Request",
    "description": "Triggers when a request fails in the selected Deepgram project (e.g. 402 out of credits, 429 rate limit, 504 timeout). Useful for surfacing failures in async pipelines that would otherwise be invisible.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "projectId": { "type": "string" }
            },
            "required": [
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "projectId": {
                    "type": "text",
                    "index": 1,
                    "label": "Project",
                    "tooltip": "The Deepgram project to monitor. Start typing to pick from your projects, or enter a project ID manually.",
                    "source": {
                        "url": "/component/appmixer/deepgram/core/ListProjects?outPort=out",
                        "data": {
                            "transform": "./ListProjects#toSelectArray",
                            "messages": {
                                "in/outputType": "array"
                            }
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" },
                    "created": { "type": "string", "format": "date-time", "title": "Created", "example": "2026-01-15T10:30:00Z" },
                    "path": { "type": "string", "title": "Path", "example": "/v1/listen" },
                    "code": { "type": "integer", "title": "Response Code", "example": 504 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
