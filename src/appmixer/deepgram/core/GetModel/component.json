{
    "name": "appmixer.deepgram.core.GetModel",
    "label": "Get Model",
    "description": "Retrieves metadata for a single Deepgram model by its UUID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "modelId": {
                        "type": "string"
                    }
                },
                "required": [
                    "modelId"
                ]
            },
            "inspector": {
                "inputs": {
                    "modelId": {
                        "type": "text",
                        "index": 1,
                        "label": "Model ID",
                        "tooltip": "The UUID of the model. Use the List Models component to obtain model UUIDs."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Nova 3"
                    },
                    "canonical_name": {
                        "type": "string",
                        "title": "Canonical Name",
                        "example": "nova-3"
                    },
                    "architecture": {
                        "type": "string",
                        "title": "Architecture",
                        "example": "nova-3"
                    },
                    "languages": {
                        "type": "array",
                        "title": "Languages",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "en",
                            "es"
                        ]
                    },
                    "version": {
                        "type": "string",
                        "title": "Version",
                        "example": "2024-01-09.0"
                    },
                    "uuid": {
                        "type": "string",
                        "title": "UUID",
                        "example": "aa274f3c-e8b3-456a-ac08-dfd797d45fb6"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
