{
    "name": "appmixer.deepgram.core.GetRequest",
    "label": "Get Request",
    "description": "Retrieves a single request-log entry and its stored result by request ID. This is how the transcript of an asynchronous (callback) transcription is collected without a webhook.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    },
                    "requestId": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId",
                    "requestId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "label": "Project",
                        "tooltip": "The Deepgram project the request belongs to. Start typing to pick from your projects, or enter a project ID manually.",
                        "source": {
                            "url": "/component/appmixer/deepgram/core/ListProjects?outPort=out",
                            "data": {
                                "transform": "./ListProjects#toSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "requestId": {
                        "type": "text",
                        "index": 2,
                        "label": "Request ID",
                        "tooltip": "The request ID returned by Transcribe Audio (Async) or listed by Find Requests."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": {
                        "type": "string",
                        "title": "Request ID",
                        "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d"
                    },
                    "created": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created",
                        "example": "2026-01-15T10:30:00Z"
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "/v1/listen"
                    },
                    "code": {
                        "type": "integer",
                        "title": "Response Code",
                        "example": 200
                    },
                    "response": {
                        "type": "object",
                        "title": "Response",
                        "example": {
                            "results": {
                                "channels": [
                                    {
                                        "alternatives": [
                                            {
                                                "transcript": "Hello world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
