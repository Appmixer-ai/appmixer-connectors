{
    "name": "appmixer.deepgram.core.TranscriptionCompleted",
    "label": "Transcription Completed",
    "description": "Triggers when a transcription (/v1/listen) request succeeds in the selected Deepgram project. Optionally re-fetches the full stored result for each new request. The practical partner to Transcribe Audio (Async).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "projectId": { "type": "string" },
                "includeResult": { "type": "boolean" }
            },
            "required": [
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "projectId": {
                    "type": "text",
                    "index": 1,
                    "label": "Project",
                    "tooltip": "The Deepgram project to monitor. Start typing to pick from your projects, or enter a project ID manually.",
                    "source": {
                        "url": "/component/appmixer/deepgram/core/ListProjects?outPort=out",
                        "data": {
                            "transform": "./ListProjects#toSelectArray",
                            "messages": {
                                "in/outputType": "array",
                                "in/isSource": true
                            }
                        }
                    }
                },
                "includeResult": {
                    "type": "toggle",
                    "index": 2,
                    "label": "Include Full Result",
                    "defaultValue": true,
                    "tooltip": "When on, the full stored transcript is fetched via Get Request for each new completed transcription."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" },
                    "created": { "type": "string", "format": "date-time", "title": "Created", "example": "2026-01-15T10:30:00Z" },
                    "path": { "type": "string", "title": "Path", "example": "/v1/listen" },
                    "code": { "type": "integer", "title": "Response Code", "example": 200 },
                    "response": { "type": "object", "title": "Response", "example": { "results": { "channels": [{ "alternatives": [{ "transcript": "Hello world." }] }] } } }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
