{
    "name": "appmixer.deepgram.core.GetProject",
    "label": "Get Project",
    "description": "Retrieves a single Deepgram project by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "label": "Project",
                        "tooltip": "The Deepgram project to retrieve. Start typing to pick from your projects, or enter a project ID manually.",
                        "source": {
                            "url": "/component/appmixer/deepgram/core/ListProjects?outPort=out",
                            "data": {
                                "transform": "./ListProjects#toSelectArray",
                                "messages": {
                                    "in/outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "project_id": { "type": "string", "title": "Project ID", "example": "bb9e3a1c-1f4e-4c2a-9c3d-2b7f5a6e8d10" },
                    "name": { "type": "string", "title": "Name", "example": "My First Project" },
                    "company": { "type": "string", "title": "Company", "example": "Acme Inc." }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
