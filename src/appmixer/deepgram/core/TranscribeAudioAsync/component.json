{
    "name": "appmixer.deepgram.core.TranscribeAudioAsync",
    "label": "Transcribe Audio (Async)",
    "description": "Submits pre-recorded audio for asynchronous transcription and returns a request ID immediately (NOT the transcript). Deepgram POSTs the finished transcript to your Callback URL later. This is the correct path for long recordings that would exceed the 10-minute synchronous timeout. Collect the result with the Get Request component or a transcription trigger.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepgram"
    },
    "quota": {
        "manager": "appmixer:deepgram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "audioUrl": { "type": "string" },
                    "fileId": { "type": "string" },
                    "callback": { "type": "string" },
                    "callbackMethod": { "type": "string" },
                    "model": { "type": "string" },
                    "language": { "type": "string" },
                    "detectLanguage": { "type": "boolean" },
                    "smartFormat": { "type": "boolean" },
                    "punctuate": { "type": "boolean" },
                    "diarize": { "type": "boolean" },
                    "summarize": { "type": "boolean" },
                    "sentiment": { "type": "boolean" },
                    "topics": { "type": "boolean" },
                    "intents": { "type": "boolean" },
                    "extraParams": { "type": "array" }
                },
                "required": [
                    "callback"
                ]
            },
            "inspector": {
                "inputs": {
                    "audioUrl": {
                        "type": "text",
                        "index": 1,
                        "label": "Audio URL",
                        "tooltip": "Publicly accessible URL of the audio file to transcribe. Provide either this or a File below."
                    },
                    "fileId": {
                        "type": "filepicker",
                        "index": 2,
                        "label": "File",
                        "tooltip": "Audio file to transcribe (max 2 GB). Provide either this or an Audio URL above."
                    },
                    "callback": {
                        "type": "text",
                        "index": 3,
                        "label": "Callback URL",
                        "tooltip": "URL that Deepgram will POST the finished transcript to. IMPORTANT: only ports 80, 443, 8080 and 8443 are permitted."
                    },
                    "callbackMethod": {
                        "type": "select",
                        "index": 4,
                        "label": "Callback Method",
                        "defaultValue": "POST",
                        "tooltip": "HTTP method Deepgram uses to deliver the callback.",
                        "options": [
                            { "label": "POST", "value": "POST" },
                            { "label": "PUT", "value": "PUT" }
                        ]
                    },
                    "model": {
                        "type": "text",
                        "index": 5,
                        "label": "Model",
                        "defaultValue": "nova-3",
                        "tooltip": "Speech-to-text model, e.g. <code>nova-3</code> (default). Use the List Models component to see all options."
                    },
                    "language": {
                        "type": "text",
                        "index": 6,
                        "label": "Language",
                        "tooltip": "BCP-47 language code, e.g. <code>en</code>. Leave empty to use the model default."
                    },
                    "detectLanguage": {
                        "type": "toggle",
                        "index": 7,
                        "label": "Detect Language",
                        "tooltip": "Automatically detect the spoken language."
                    },
                    "smartFormat": {
                        "type": "toggle",
                        "index": 8,
                        "label": "Smart Format",
                        "tooltip": "Apply formatting to dates, times, numbers, etc."
                    },
                    "punctuate": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Punctuate",
                        "tooltip": "Add punctuation and capitalization."
                    },
                    "diarize": {
                        "type": "toggle",
                        "index": 10,
                        "label": "Diarize",
                        "tooltip": "Recognize and label distinct speakers."
                    },
                    "summarize": {
                        "type": "toggle",
                        "index": 11,
                        "label": "Summarize",
                        "tooltip": "Generate a summary (Audio Intelligence)."
                    },
                    "sentiment": {
                        "type": "toggle",
                        "index": 12,
                        "label": "Sentiment",
                        "tooltip": "Analyze sentiment (Audio Intelligence)."
                    },
                    "topics": {
                        "type": "toggle",
                        "index": 13,
                        "label": "Topics",
                        "tooltip": "Detect topics (Audio Intelligence)."
                    },
                    "intents": {
                        "type": "toggle",
                        "index": 14,
                        "label": "Intents",
                        "tooltip": "Detect intents (Audio Intelligence)."
                    },
                    "extraParams": {
                        "type": "key-value",
                        "index": 15,
                        "keyLabel": "Parameter",
                        "valueLabel": "Value",
                        "addLabel": "Add parameter",
                        "removeLabel": "Remove parameter",
                        "label": "Additional Query Parameters",
                        "tooltip": "Any additional Deepgram query parameters (e.g. redact, keyterm, search, replace)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "request_id": { "type": "string", "title": "Request ID", "example": "b1f4a0c2-9d3e-4a7b-8c1d-2e5f6a7b8c9d" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
