{
    "name": "appmixer.telegram.core.SendMessage",
    "label": "Send Message",
    "description": "Sends a text message to a Telegram chat, group or channel. Telegram caps a single message at 4096 characters; longer text is rejected with a 400.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:telegram"
    },
    "quota": {
        "manager": "appmixer:telegram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "chatId": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "parseMode": {
                        "type": "string"
                    },
                    "disableWebPagePreview": {
                        "type": "boolean"
                    },
                    "disableNotification": {
                        "type": "boolean"
                    },
                    "protectContent": {
                        "type": "boolean"
                    },
                    "messageThreadId": {
                        "type": "integer"
                    },
                    "replyToMessageId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "chatId",
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "chatId": {
                        "type": "text",
                        "index": 1,
                        "label": "Chat ID",
                        "tooltip": "Numeric chat ID (for example <i>-1002345678901</i> for a group or channel) or a public <i>@channelusername</i>. The bot must be a member of the chat. Chat IDs are emitted by the New Message trigger."
                    },
                    "text": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "The message body. Up to 4096 characters."
                    },
                    "parseMode": {
                        "type": "select",
                        "index": 3,
                        "label": "Parse Mode",
                        "tooltip": "How to interpret formatting in the text or caption.",
                        "options": [
                            {
                                "label": "Plain text",
                                "value": ""
                            },
                            {
                                "label": "HTML",
                                "value": "HTML"
                            },
                            {
                                "label": "MarkdownV2",
                                "value": "MarkdownV2"
                            },
                            {
                                "label": "Markdown (legacy)",
                                "value": "Markdown"
                            }
                        ],
                        "defaultValue": ""
                    },
                    "disableWebPagePreview": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Disable Link Preview",
                        "tooltip": "Do not render a preview card for links contained in the text."
                    },
                    "disableNotification": {
                        "type": "toggle",
                        "index": 5,
                        "label": "Disable Notification",
                        "tooltip": "Deliver the message silently - recipients get no sound notification."
                    },
                    "protectContent": {
                        "type": "toggle",
                        "index": 6,
                        "label": "Protect Content",
                        "tooltip": "Block forwarding and saving of the sent message."
                    },
                    "messageThreadId": {
                        "type": "number",
                        "index": 7,
                        "label": "Thread ID",
                        "tooltip": "Target a specific topic in a forum supergroup."
                    },
                    "replyToMessageId": {
                        "type": "number",
                        "index": 8,
                        "label": "Reply To Message ID",
                        "tooltip": "Send this message as a reply to an existing message in the same chat."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "message_id": {
                        "type": "integer",
                        "title": "Message ID",
                        "example": 1042
                    },
                    "message_thread_id": {
                        "type": "integer",
                        "title": "Thread ID",
                        "example": 12
                    },
                    "from": {
                        "type": "object",
                        "title": "From",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "User ID",
                                "example": 6412345678
                            },
                            "is_bot": {
                                "type": "boolean",
                                "title": "Is Bot",
                                "example": false
                            },
                            "first_name": {
                                "type": "string",
                                "title": "First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Last Name",
                                "example": "Novakova"
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "example": "jana_novakova"
                            },
                            "language_code": {
                                "type": "string",
                                "title": "Language Code",
                                "example": "cs"
                            }
                        },
                        "example": {
                            "id": 6412345678,
                            "is_bot": false,
                            "first_name": "Jana",
                            "username": "jana_novakova"
                        }
                    },
                    "chat": {
                        "type": "object",
                        "title": "Chat",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Chat ID",
                                "example": -1002345678901
                            },
                            "type": {
                                "type": "string",
                                "title": "Chat Type",
                                "example": "supergroup"
                            },
                            "title": {
                                "type": "string",
                                "title": "Title",
                                "example": "Product Team"
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "example": "product_team"
                            },
                            "first_name": {
                                "type": "string",
                                "title": "First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Last Name",
                                "example": "Novakova"
                            }
                        },
                        "example": {
                            "id": -1002345678901,
                            "type": "supergroup",
                            "title": "Product Team"
                        }
                    },
                    "date": {
                        "type": "integer",
                        "title": "Date (Unix Time)",
                        "example": 1756200000
                    },
                    "edit_date": {
                        "type": "integer",
                        "title": "Edit Date (Unix Time)",
                        "example": 1756200600
                    },
                    "text": {
                        "type": "string",
                        "title": "Text",
                        "example": "Hello from your workflow!"
                    },
                    "caption": {
                        "type": "string",
                        "title": "Caption",
                        "example": "Quarterly report"
                    },
                    "photo": {
                        "type": "array",
                        "title": "Photo Sizes",
                        "items": {
                            "type": "object",
                            "properties": {
                                "file_id": {
                                    "type": "string",
                                    "title": "File ID"
                                },
                                "file_unique_id": {
                                    "type": "string",
                                    "title": "File Unique ID"
                                },
                                "width": {
                                    "type": "integer",
                                    "title": "Width"
                                },
                                "height": {
                                    "type": "integer",
                                    "title": "Height"
                                },
                                "file_size": {
                                    "type": "integer",
                                    "title": "File Size"
                                }
                            }
                        },
                        "example": [
                            {
                                "file_id": "AgACAgIAAxkBAAIB",
                                "file_unique_id": "AQADr8gxG9c",
                                "width": 1280,
                                "height": 720,
                                "file_size": 84213
                            }
                        ]
                    },
                    "document": {
                        "type": "object",
                        "title": "Document",
                        "properties": {
                            "file_id": {
                                "type": "string",
                                "title": "File ID"
                            },
                            "file_unique_id": {
                                "type": "string",
                                "title": "File Unique ID"
                            },
                            "file_name": {
                                "type": "string",
                                "title": "File Name"
                            },
                            "mime_type": {
                                "type": "string",
                                "title": "MIME Type"
                            },
                            "file_size": {
                                "type": "integer",
                                "title": "File Size"
                            }
                        },
                        "example": {
                            "file_id": "BQACAgIAAxkBAAIB",
                            "file_unique_id": "AgADr8gxG9c",
                            "file_name": "report.pdf",
                            "mime_type": "application/pdf",
                            "file_size": 24518
                        }
                    },
                    "reply_to_message": {
                        "type": "object",
                        "title": "Reply To Message",
                        "properties": {
                            "message_id": {
                                "type": "integer",
                                "title": "Message ID"
                            },
                            "text": {
                                "type": "string",
                                "title": "Text"
                            }
                        },
                        "example": {
                            "message_id": 1041,
                            "text": "What is the status?"
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
