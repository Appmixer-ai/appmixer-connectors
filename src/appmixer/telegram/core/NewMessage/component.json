{
    "name": "appmixer.telegram.core.NewMessage",
    "label": "New Message",
    "description": "Triggers when the bot receives a message. Telegram allows only one webhook per bot, so every Telegram trigger of the same bot shares one registration created on flow start; stopping a flow leaves it in place because sibling flows may still need it. In groups the bot only sees messages addressed to it unless privacy mode is turned off in @BotFather.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "appmixer:telegram"
    },
    "quota": {
        "manager": "appmixer:telegram",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "chatId": {
                    "type": "string"
                },
                "includeEdited": {
                    "type": "boolean"
                },
                "includeChannelPosts": {
                    "type": "boolean"
                }
            }
        },
        "inspector": {
            "inputs": {
                "chatId": {
                    "type": "text",
                    "index": 1,
                    "label": "Chat ID",
                    "tooltip": "Only emit messages from this chat. Leave empty to receive messages from every chat the bot is in. Numeric ID or @channelusername."
                },
                "includeEdited": {
                    "type": "toggle",
                    "index": 2,
                    "label": "Include Edited Messages",
                    "tooltip": "Also fire when an existing message is edited."
                },
                "includeChannelPosts": {
                    "type": "toggle",
                    "index": 3,
                    "label": "Include Channel Posts",
                    "tooltip": "Also fire for posts published in channels the bot administers."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "message_id": {
                        "type": "integer",
                        "title": "Message ID",
                        "example": 1042
                    },
                    "message_thread_id": {
                        "type": "integer",
                        "title": "Thread ID",
                        "example": 12
                    },
                    "from": {
                        "type": "object",
                        "title": "From",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "User ID",
                                "example": 6412345678
                            },
                            "is_bot": {
                                "type": "boolean",
                                "title": "Is Bot",
                                "example": false
                            },
                            "first_name": {
                                "type": "string",
                                "title": "First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Last Name",
                                "example": "Novakova"
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "example": "jana_novakova"
                            },
                            "language_code": {
                                "type": "string",
                                "title": "Language Code",
                                "example": "cs"
                            }
                        },
                        "example": {
                            "id": 6412345678,
                            "is_bot": false,
                            "first_name": "Jana",
                            "username": "jana_novakova"
                        }
                    },
                    "chat": {
                        "type": "object",
                        "title": "Chat",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Chat ID",
                                "example": -1002345678901
                            },
                            "type": {
                                "type": "string",
                                "title": "Chat Type",
                                "example": "supergroup"
                            },
                            "title": {
                                "type": "string",
                                "title": "Title",
                                "example": "Product Team"
                            },
                            "username": {
                                "type": "string",
                                "title": "Username",
                                "example": "product_team"
                            },
                            "first_name": {
                                "type": "string",
                                "title": "First Name",
                                "example": "Jana"
                            },
                            "last_name": {
                                "type": "string",
                                "title": "Last Name",
                                "example": "Novakova"
                            }
                        },
                        "example": {
                            "id": -1002345678901,
                            "type": "supergroup",
                            "title": "Product Team"
                        }
                    },
                    "date": {
                        "type": "integer",
                        "title": "Date (Unix Time)",
                        "example": 1756200000
                    },
                    "edit_date": {
                        "type": "integer",
                        "title": "Edit Date (Unix Time)",
                        "example": 1756200600
                    },
                    "text": {
                        "type": "string",
                        "title": "Text",
                        "example": "Hello from your workflow!"
                    },
                    "caption": {
                        "type": "string",
                        "title": "Caption",
                        "example": "Quarterly report"
                    },
                    "photo": {
                        "type": "array",
                        "title": "Photo Sizes",
                        "items": {
                            "type": "object",
                            "properties": {
                                "file_id": {
                                    "type": "string",
                                    "title": "File ID"
                                },
                                "file_unique_id": {
                                    "type": "string",
                                    "title": "File Unique ID"
                                },
                                "width": {
                                    "type": "integer",
                                    "title": "Width"
                                },
                                "height": {
                                    "type": "integer",
                                    "title": "Height"
                                },
                                "file_size": {
                                    "type": "integer",
                                    "title": "File Size"
                                }
                            }
                        },
                        "example": [
                            {
                                "file_id": "AgACAgIAAxkBAAIB",
                                "file_unique_id": "AQADr8gxG9c",
                                "width": 1280,
                                "height": 720,
                                "file_size": 84213
                            }
                        ]
                    },
                    "document": {
                        "type": "object",
                        "title": "Document",
                        "properties": {
                            "file_id": {
                                "type": "string",
                                "title": "File ID"
                            },
                            "file_unique_id": {
                                "type": "string",
                                "title": "File Unique ID"
                            },
                            "file_name": {
                                "type": "string",
                                "title": "File Name"
                            },
                            "mime_type": {
                                "type": "string",
                                "title": "MIME Type"
                            },
                            "file_size": {
                                "type": "integer",
                                "title": "File Size"
                            }
                        },
                        "example": {
                            "file_id": "BQACAgIAAxkBAAIB",
                            "file_unique_id": "AgADr8gxG9c",
                            "file_name": "report.pdf",
                            "mime_type": "application/pdf",
                            "file_size": 24518
                        }
                    },
                    "reply_to_message": {
                        "type": "object",
                        "title": "Reply To Message",
                        "properties": {
                            "message_id": {
                                "type": "integer",
                                "title": "Message ID"
                            },
                            "text": {
                                "type": "string",
                                "title": "Text"
                            }
                        },
                        "example": {
                            "message_id": 1041,
                            "text": "What is the status?"
                        }
                    },
                    "update_id": {
                        "type": "integer",
                        "title": "Update ID",
                        "example": 987654321
                    },
                    "update_kind": {
                        "type": "string",
                        "title": "Update Kind",
                        "example": "message"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
