{
    "name": "appmixer.pandadoc.core.NewDocument",
    "label": "New Document",
    "description": "Triggers when a document is created in the workspace. The trigger checks for new documents periodically.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:pandadoc"
    },
    "quota": {
        "manager": "appmixer:pandadoc",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "status",
                    "date_created",
                    "date_modified"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Document ID",
                        "example": "msFYActMfJHqNTKH8YSvF1"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Quote for Acme Inc."
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "document.draft"
                    },
                    "date_created": {
                        "type": "string",
                        "title": "Date Created",
                        "example": "2026-11-20T09:15:00.000000Z",
                        "format": "date-time"
                    },
                    "date_modified": {
                        "type": "string",
                        "title": "Date Modified",
                        "example": "2026-11-20T09:15:04.000000Z",
                        "format": "date-time"
                    },
                    "date_sent": {
                        "type": "string",
                        "title": "Date Sent",
                        "example": "2026-11-20T09:20:31.000000Z",
                        "format": "date-time"
                    },
                    "date_completed": {
                        "type": "string",
                        "title": "Date Completed",
                        "example": "2026-11-21T14:02:11.000000Z",
                        "format": "date-time"
                    },
                    "expiration_date": {
                        "type": "string",
                        "title": "Expiration Date",
                        "example": "2027-01-19T09:15:00.000000Z",
                        "format": "date-time"
                    },
                    "version": {
                        "type": "string",
                        "title": "Version",
                        "example": "2"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
