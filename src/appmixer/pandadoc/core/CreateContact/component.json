{
    "name": "appmixer.pandadoc.core.CreateContact",
    "label": "Create Contact",
    "description": "Create a contact in PandaDoc.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:pandadoc"
    },
    "quota": {
        "manager": "appmixer:pandadoc",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "company": {
                        "type": "string"
                    },
                    "jobTitle": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "streetAddress": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "index": 1,
                        "label": "Email",
                        "tooltip": "Email of the contact."
                    },
                    "firstName": {
                        "type": "text",
                        "index": 2,
                        "label": "First Name",
                        "tooltip": "First name of the contact."
                    },
                    "lastName": {
                        "type": "text",
                        "index": 3,
                        "label": "Last Name",
                        "tooltip": "Last name of the contact."
                    },
                    "company": {
                        "type": "text",
                        "index": 4,
                        "label": "Company",
                        "tooltip": "Company name."
                    },
                    "jobTitle": {
                        "type": "text",
                        "index": 5,
                        "label": "Job Title",
                        "tooltip": "Job title."
                    },
                    "phone": {
                        "type": "text",
                        "index": 6,
                        "label": "Phone",
                        "tooltip": "Phone number, e.g. +14842634627."
                    },
                    "country": {
                        "type": "text",
                        "index": 7,
                        "label": "Country",
                        "tooltip": "Country name."
                    },
                    "state": {
                        "type": "text",
                        "index": 8,
                        "label": "State",
                        "tooltip": "State name."
                    },
                    "streetAddress": {
                        "type": "text",
                        "index": 9,
                        "label": "Street Address",
                        "tooltip": "Street address."
                    },
                    "city": {
                        "type": "text",
                        "index": 10,
                        "label": "City",
                        "tooltip": "City name."
                    },
                    "postalCode": {
                        "type": "text",
                        "index": 11,
                        "label": "Postal Code",
                        "tooltip": "Postal code."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "email"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Contact ID",
                        "example": "BCUWJhZm3k7grUNFAz6cD2"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "john.smith@example.com"
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "John"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Smith"
                    },
                    "company": {
                        "type": "string",
                        "title": "Company",
                        "example": "Acme Inc."
                    },
                    "job_title": {
                        "type": "string",
                        "title": "Job Title",
                        "example": "CTO"
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "+14842634627"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "USA"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "Texas"
                    },
                    "street_address": {
                        "type": "string",
                        "title": "Street Address",
                        "example": "1313 Mockingbird Lane"
                    },
                    "city": {
                        "type": "string",
                        "title": "City",
                        "example": "Austin"
                    },
                    "postal_code": {
                        "type": "string",
                        "title": "Postal Code",
                        "example": "75001"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
