{
    "name": "appmixer.pandadoc.core.UpdateContact",
    "label": "Update Contact",
    "description": "Update a contact. Only the fields you fill in are changed. PandaDoc does not allow changing the email or the country of a contact.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:pandadoc"
    },
    "quota": {
        "manager": "appmixer:pandadoc",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "company": {
                        "type": "string"
                    },
                    "jobTitle": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "streetAddress": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "postalCode": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "index": 1,
                        "label": "Contact ID",
                        "tooltip": "The ID of the contact. Use Find Contacts to look it up by email."
                    },
                    "firstName": {
                        "type": "text",
                        "index": 2,
                        "label": "First Name",
                        "tooltip": "First name of the contact."
                    },
                    "lastName": {
                        "type": "text",
                        "index": 3,
                        "label": "Last Name",
                        "tooltip": "Last name of the contact."
                    },
                    "company": {
                        "type": "text",
                        "index": 4,
                        "label": "Company",
                        "tooltip": "Company name."
                    },
                    "jobTitle": {
                        "type": "text",
                        "index": 5,
                        "label": "Job Title",
                        "tooltip": "Job title."
                    },
                    "phone": {
                        "type": "text",
                        "index": 6,
                        "label": "Phone",
                        "tooltip": "Phone number, e.g. +14842634627."
                    },
                    "state": {
                        "type": "text",
                        "index": 7,
                        "label": "State",
                        "tooltip": "State name."
                    },
                    "streetAddress": {
                        "type": "text",
                        "index": 8,
                        "label": "Street Address",
                        "tooltip": "Street address."
                    },
                    "city": {
                        "type": "text",
                        "index": 9,
                        "label": "City",
                        "tooltip": "City name."
                    },
                    "postalCode": {
                        "type": "text",
                        "index": 10,
                        "label": "Postal Code",
                        "tooltip": "Postal code."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
