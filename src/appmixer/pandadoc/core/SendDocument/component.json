{
    "name": "appmixer.pandadoc.core.SendDocument",
    "label": "Send Document",
    "description": "Send a draft document to its recipients for viewing, approval or signature. Returns the document with the recipients' signing links.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:pandadoc"
    },
    "quota": {
        "manager": "appmixer:pandadoc",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "documentId": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "silent": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "documentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of a document in the draft status."
                    },
                    "subject": {
                        "type": "text",
                        "index": 2,
                        "label": "Subject",
                        "tooltip": "Subject of the email sent to the recipients."
                    },
                    "message": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Message",
                        "tooltip": "Message of the email sent to the recipients."
                    },
                    "silent": {
                        "type": "toggle",
                        "index": 4,
                        "label": "Silent",
                        "tooltip": "When on, PandaDoc sends no email notifications (sent, viewed, completed) to the recipients and the sender. Use the signing links instead.",
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "status",
                    "recipients"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Document ID",
                        "example": "msFYActMfJHqNTKH8YSvF1"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Quote for Acme Inc."
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "document.sent"
                    },
                    "date_created": {
                        "type": "string",
                        "title": "Date Created",
                        "example": "2026-11-20T09:15:00.000000Z",
                        "format": "date-time"
                    },
                    "date_modified": {
                        "type": "string",
                        "title": "Date Modified",
                        "example": "2026-11-20T09:15:04.000000Z",
                        "format": "date-time"
                    },
                    "date_completed": {
                        "type": "string",
                        "title": "Date Completed",
                        "example": "2026-11-21T14:02:11.000000Z",
                        "format": "date-time"
                    },
                    "expiration_date": {
                        "type": "string",
                        "title": "Expiration Date",
                        "example": "2027-01-19T09:15:00.000000Z",
                        "format": "date-time"
                    },
                    "version": {
                        "type": "string",
                        "title": "Version",
                        "example": "2"
                    },
                    "recipients": {
                        "type": "array",
                        "title": "Recipients",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "first_name": {
                                    "type": "string"
                                },
                                "last_name": {
                                    "type": "string"
                                },
                                "email": {
                                    "type": "string"
                                },
                                "recipient_type": {
                                    "type": "string"
                                },
                                "role": {
                                    "type": "string"
                                },
                                "has_completed": {
                                    "type": "boolean"
                                },
                                "signing_order": {
                                    "type": "integer"
                                },
                                "shared_link": {
                                    "type": "string"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "8KAZvGRL3W4u44a4fyDoeH",
                                "first_name": "John",
                                "last_name": "Smith",
                                "email": "john.smith@example.com",
                                "recipient_type": "signer",
                                "role": "Client",
                                "has_completed": false,
                                "signing_order": null,
                                "shared_link": "https://app.pandadoc.com/document/15d4b481384b652a298530ddc7023bfc07a67d59"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
