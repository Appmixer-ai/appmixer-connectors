{
    "name": "appmixer.pandadoc.core.DownloadDocument",
    "label": "Download Document",
    "description": "Download a document as a PDF file.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:pandadoc"
    },
    "quota": {
        "manager": "appmixer:pandadoc",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "documentId": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "documentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of the document."
                    },
                    "fileName": {
                        "type": "text",
                        "index": 2,
                        "label": "File Name",
                        "tooltip": "Name of the stored file. Defaults to the document ID with the .pdf extension."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "fileId",
                    "fileName"
                ],
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File ID",
                        "example": "5f8b1d7e6c3a2b0012345678"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "msFYActMfJHqNTKH8YSvF1.pdf"
                    },
                    "contentType": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "application/pdf"
                    },
                    "size": {
                        "type": "integer",
                        "title": "Size",
                        "example": 48213
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
