{
    "name": "appmixer.hubbi.core.NewHubEvent",
    "author": "Appmixer <info@appmixer.com>",
    "label": "New Hub Event",
    "description": "Trigger that fires when a hub event is received via webhook.",
    "private": false,
    "webhook": true,
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:hubbi"
    },
    "quota": {
        "manager": "appmixer:hubbi",
        "resources": "requests"
    },
    "properties": {
        "schema": {
            "properties": {
                "generateInspector": {
                    "type": "boolean"
                },
                "conversionKey": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "webhookUrl": {
                    "type": "text",
                    "index": 0,
                    "source": {
                        "url": "/component/appmixer/hubbi/core/NewHubEvent?outPort=out",
                        "data": {
                            "properties": {
                                "generateInspector": true
                            }
                        }
                    }
                },
                "conversionKey": {
                    "type": "select",
                    "label": "Hub",
                    "tooltip": "Select the hub to listen for events from.",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/hubbi/core/ListTargetHubs?outPort=out",
                        "data": {
                            "messages": {
                                "in/outputType": "array"
                            },
                            "transform": "./ListTargetHubs#toSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/hubbi/core/NewHubEvent?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true,
                        "conversionKey": "properties/conversionKey"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
