{
    "name": "appmixer.hubbi.core.GetSourceFields",
    "label": "Get Source Fields",
    "description": "Load the source field definitions of a hub.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:hubbi"
    },
    "quota": {
        "manager": "appmixer:hubbi",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "conversionKey": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "conversionKey"
                ]
            },
            "inspector": {
                "inputs": {
                    "conversionKey": {
                        "type": "select",
                        "label": "Hub",
                        "tooltip": "Select the hub to load the source field definitions from.",
                        "index": 0,
                        "source": {
                            "url": "/component/appmixer/hubbi/core/ListSourceHubsWithPostData?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "messages": {
                                    "in/outputType": "array"
                                },
                                "transform": "./ListSourceHubsWithPostData#toSelectArray"
                            }
                        }
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "index": 1,
                        "defaultValue": "array",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                },
                "groups": {
                    "required": {
                        "label": "Required",
                        "index": 1,
                        "fields": [
                            "conversionKey"
                        ]
                    },
                    "settings": {
                        "label": "Settings",
                        "index": 2,
                        "fields": [
                            "outputType"
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/hubbi/core/GetSourceFields?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
