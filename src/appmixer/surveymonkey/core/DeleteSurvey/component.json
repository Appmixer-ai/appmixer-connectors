{
    "name": "appmixer.surveymonkey.core.DeleteSurvey",
    "label": "Delete Survey",
    "description": "Delete a survey together with its collectors and responses. This cannot be undone.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:surveymonkey"
    },
    "quota": {
        "manager": "appmixer:surveymonkey",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "surveyId": {
                        "type": "string"
                    }
                },
                "required": [
                    "surveyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "surveyId": {
                        "type": "text",
                        "index": 1,
                        "label": "Survey",
                        "tooltip": "The survey to delete. Pick a survey, or type its Survey ID.",
                        "source": {
                            "url": "/component/appmixer/surveymonkey/core/ListSurveys?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListSurveys#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
