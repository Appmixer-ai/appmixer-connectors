{
    "name": "appmixer.requesty.core.CreateEmbedding",
    "label": "Create Embedding",
    "description": "Creates an embedding vector representing the input text using a Requesty-routed embedding model.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:requesty"
    },
    "quota": {
        "manager": "appmixer:requesty",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "input": {
                        "type": "string"
                    },
                    "encodingFormat": {
                        "type": "string",
                        "enum": [
                            "float",
                            "base64"
                        ]
                    }
                },
                "required": [
                    "model",
                    "input"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "index": 1,
                        "label": "Model",
                        "tooltip": "The provider-prefixed embedding model identifier to use (for example <code>openai/text-embedding-3-small</code>). The list is populated from your account's available models.",
                        "source": {
                            "url": "/component/appmixer/requesty/core/ListModels?outPort=out&ignoreAuth=true",
                            "data": {
                                "transform": "./ListModels#toSelectArray"
                            }
                        }
                    },
                    "input": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Input",
                        "tooltip": "The text to generate an embedding for."
                    },
                    "encodingFormat": {
                        "type": "select",
                        "index": 3,
                        "label": "Encoding Format",
                        "tooltip": "The format to return the embeddings in.",
                        "options": [
                            {
                                "label": "Float",
                                "value": "float"
                            },
                            {
                                "label": "Base64",
                                "value": "base64"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string",
                        "example": "openai/text-embedding-3-small"
                    }
                },
                {
                    "label": "Embedding",
                    "value": "embedding",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "example": [0.0023064255, -0.009327292, 0.015797347]
                    }
                },
                {
                    "label": "Prompt Tokens",
                    "value": "usage.prompt_tokens",
                    "schema": {
                        "type": "number",
                        "example": 8
                    }
                },
                {
                    "label": "Total Tokens",
                    "value": "usage.total_tokens",
                    "schema": {
                        "type": "number",
                        "example": 8
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='256'%20height='256'%20viewBox='0%200%20256%20256'%3E%3Crect%20width='256'%20height='256'%20rx='56'%20fill='rgb(90,79,243)'/%3E%3Cpath%20d='M84%2064h56c30%200%2050%2018%2050%2046%200%2020-11%2035-29%2042l34%2040h-44l-30-37h-23v37H84V64zm33%2067h22c12%200%2019-7%2019-18s-7-18-19-18h-22v36z'%20fill='rgb(255,255,255)'/%3E%3C/svg%3E"
}
