{
    "name": "E2E Requesty - Create Embedding",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 48,
            "y": 320,
            "source": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 240,
            "y": 320,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "model",
                                                "text": "openai/text-embedding-3-small"
                                            },
                                            {
                                                "type": "text",
                                                "name": "input",
                                                "text": "The quick brown fox jumps over the lazy dog."
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 432,
            "y": 320,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            }
        },
        "create-embedding": {
            "type": "appmixer.requesty.core.CreateEmbedding",
            "x": 624,
            "y": 320,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "model": {
                                        "var-model": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.model"
                                        }
                                    },
                                    "input": {
                                        "var-input": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.input"
                                        }
                                    }
                                },
                                "lambda": {
                                    "model": "{{{var-model}}}",
                                    "input": "{{{var-input}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create-embedding": {
            "type": "appmixer.utils.test.Assert",
            "x": 816,
            "y": 320,
            "source": {
                "in": {
                    "create-embedding": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-embedding": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "var-model": {
                                            "functions": [],
                                            "variable": "$.create-embedding.out.model"
                                        },
                                        "var-tokens": {
                                            "functions": [],
                                            "variable": "$.create-embedding.out.usage.total_tokens"
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-model}}}"
                                            },
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-tokens}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1008,
            "y": 320,
            "source": {
                "in": {
                    "assert-create-embedding": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 180
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1200,
            "y": 320,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Requesty - Create Embedding",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "notes": {},
    "wizard": {
        "fields": []
    }
}
