{
    "name": "E2E Requesty - Make API Call",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 48,
            "y": 320,
            "source": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 240,
            "y": 320,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "url",
                                                "text": "/v1/models"
                                            },
                                            {
                                                "type": "text",
                                                "name": "method",
                                                "text": "GET"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 432,
            "y": 320,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            }
        },
        "make-api-call": {
            "type": "appmixer.requesty.core.MakeApiCall",
            "x": 624,
            "y": 320,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "url": {
                                        "var-url": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.url"
                                        }
                                    },
                                    "method": {
                                        "var-method": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.method"
                                        }
                                    }
                                },
                                "lambda": {
                                    "url": "{{{var-url}}}",
                                    "method": "{{{var-method}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-make-api-call": {
            "type": "appmixer.utils.test.Assert",
            "x": 816,
            "y": 320,
            "source": {
                "in": {
                    "make-api-call": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "make-api-call": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "var-status": {
                                            "functions": [],
                                            "variable": "$.make-api-call.out.status"
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-status}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1008,
            "y": 320,
            "source": {
                "in": {
                    "assert-make-api-call": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 180
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1200,
            "y": 320,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Requesty - Make API Call",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "notes": {},
    "wizard": {
        "fields": []
    }
}
