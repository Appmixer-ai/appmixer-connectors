{
    "name": "E2E Requesty - List Models",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 48,
            "y": 320,
            "source": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 240,
            "y": 320,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "outputType",
                                                "text": "first"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 432,
            "y": 320,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            }
        },
        "list-models": {
            "type": "appmixer.requesty.core.ListModels",
            "x": 624,
            "y": 320,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "first"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-models": {
            "type": "appmixer.utils.test.Assert",
            "x": 816,
            "y": 320,
            "source": {
                "in": {
                    "list-models": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-models": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "var-id": {
                                            "functions": [],
                                            "variable": "$.list-models.out.id"
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-id}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1008,
            "y": 320,
            "source": {
                "in": {
                    "assert-list-models": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 180
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1200,
            "y": 320,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Requesty - List Models",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "notes": {},
    "wizard": {
        "fields": []
    }
}
