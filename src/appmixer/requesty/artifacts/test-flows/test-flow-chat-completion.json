{
    "name": "E2E Requesty - Chat Completion",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 48,
            "y": 320,
            "source": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 240,
            "y": 320,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "model",
                                                "text": "openai/gpt-4o-mini"
                                            },
                                            {
                                                "type": "text",
                                                "name": "prompt",
                                                "text": "Respond with the single word: PONG"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "before-all": {
            "type": "appmixer.utils.test.BeforeAll",
            "x": 432,
            "y": 320,
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            }
        },
        "chat-completion": {
            "type": "appmixer.requesty.core.ChatCompletion",
            "x": 624,
            "y": 320,
            "source": {
                "in": {
                    "before-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "before-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "model": {
                                        "var-model": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.model"
                                        }
                                    },
                                    "prompt": {
                                        "var-prompt": {
                                            "functions": [],
                                            "variable": "$.set-variables.out.prompt"
                                        }
                                    }
                                },
                                "lambda": {
                                    "model": "{{{var-model}}}",
                                    "prompt": "{{{var-prompt}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-chat-completion": {
            "type": "appmixer.utils.test.Assert",
            "x": 816,
            "y": 320,
            "source": {
                "in": {
                    "chat-completion": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "chat-completion": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "var-id": {
                                            "functions": [],
                                            "variable": "$.chat-completion.out.id"
                                        },
                                        "var-content": {
                                            "functions": [],
                                            "variable": "$.chat-completion.out.choices.message.content"
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-id}}}"
                                            },
                                            {
                                                "assertion": "notEmpty",
                                                "field": "{{{var-content}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1008,
            "y": 320,
            "source": {
                "in": {
                    "assert-chat-completion": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 180
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1200,
            "y": 320,
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "functions": [],
                                            "variable": "$.after-all.out"
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.com",
                                    "testCase": "E2E Requesty - Chat Completion",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "notes": {},
    "wizard": {
        "fields": []
    }
}
