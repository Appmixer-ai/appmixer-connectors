{
    "name": "appmixer.superoffice.core.CreateSale",
    "label": "Create Sale",
    "description": "Create a sale (an opportunity) for a company.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:superoffice"
    },
    "quota": {
        "manager": "appmixer:superoffice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "heading": {
                        "type": "string"
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "personId": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "saleDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "probability": {
                        "type": "integer"
                    },
                    "saleTypeId": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "Open",
                            "Sold",
                            "Lost",
                            "Stalled"
                        ]
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "heading",
                    "companyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "heading": {
                        "type": "text",
                        "index": 1,
                        "label": "Heading",
                        "tooltip": "Short description of the sale."
                    },
                    "companyId": {
                        "type": "text",
                        "index": 2,
                        "label": "Company ID",
                        "tooltip": "The company the sale is for. Use Find Companies to look it up."
                    },
                    "personId": {
                        "type": "text",
                        "index": 3,
                        "label": "Person ID",
                        "tooltip": "The contact person of the sale. Use Find Persons to look it up."
                    },
                    "projectId": {
                        "type": "text",
                        "index": 4,
                        "label": "Project ID",
                        "tooltip": "The project the sale belongs to. Use Find Projects to look it up."
                    },
                    "amount": {
                        "type": "number",
                        "index": 5,
                        "label": "Amount",
                        "tooltip": "Total sale amount."
                    },
                    "saleDate": {
                        "type": "date-time",
                        "index": 6,
                        "label": "Sale Date",
                        "tooltip": "Expected (or won/lost) date of the sale."
                    },
                    "probability": {
                        "type": "number",
                        "index": 7,
                        "label": "Probability",
                        "tooltip": "Probability in percent, 0 to 100."
                    },
                    "saleTypeId": {
                        "type": "text",
                        "index": 8,
                        "label": "Sale Type",
                        "tooltip": "Pick a sale type, or type its ID.",
                        "source": {
                            "url": "/component/appmixer/superoffice/core/ListListItems?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true,
                                    "listName": "SaleType"
                                },
                                "transform": "./ListListItems#toSelectArray"
                            }
                        }
                    },
                    "status": {
                        "type": "select",
                        "index": 9,
                        "label": "Status",
                        "tooltip": "Status of the new sale. SuperOffice uses Open when empty.",
                        "options": [
                            {
                                "label": "Open",
                                "value": "Open"
                            },
                            {
                                "label": "Sold",
                                "value": "Sold"
                            },
                            {
                                "label": "Lost",
                                "value": "Lost"
                            },
                            {
                                "label": "Stalled",
                                "value": "Stalled"
                            }
                        ]
                    },
                    "description": {
                        "type": "textarea",
                        "index": 10,
                        "label": "Description",
                        "tooltip": "Text describing the sale."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Sale ID",
                        "example": 57
                    },
                    "heading": {
                        "type": "string",
                        "title": "Heading",
                        "example": "50 licences"
                    },
                    "amount": {
                        "type": "number",
                        "title": "Amount",
                        "example": 12500
                    },
                    "saleDate": {
                        "type": "string",
                        "title": "Sale Date",
                        "example": "2026-12-15T00:00:00"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "Open"
                    },
                    "probability": {
                        "type": "integer",
                        "title": "Probability",
                        "example": 50
                    },
                    "saleType": {
                        "type": "string",
                        "title": "Sale Type",
                        "example": "New business"
                    },
                    "companyId": {
                        "type": "integer",
                        "title": "Company ID",
                        "example": 125
                    },
                    "companyName": {
                        "type": "string",
                        "title": "Company Name",
                        "example": "Acme Inc."
                    },
                    "personId": {
                        "type": "integer",
                        "title": "Person ID",
                        "example": 342
                    },
                    "personName": {
                        "type": "string",
                        "title": "Person Name",
                        "example": "Jane Doe"
                    },
                    "projectId": {
                        "type": "integer",
                        "title": "Project ID",
                        "example": 12
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Renewal of the yearly licence."
                    },
                    "createdDate": {
                        "type": "string",
                        "title": "Created Date",
                        "example": "2026-11-16T10:30:00"
                    },
                    "updatedDate": {
                        "type": "string",
                        "title": "Updated Date",
                        "example": "2026-11-17T08:15:00"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
