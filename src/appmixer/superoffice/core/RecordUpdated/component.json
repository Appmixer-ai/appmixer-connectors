{
    "name": "appmixer.superoffice.core.RecordUpdated",
    "label": "Record Updated",
    "description": "Triggers when a company, person, sale, project, follow-up or ticket is updated, optionally only when a field has a value or changes to it (for example a ticket closed, a milestone reached or a follow-up completed). Checks SuperOffice every minute; it does not need the webhook licence.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:superoffice"
    },
    "quota": {
        "manager": "appmixer:superoffice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "trigger": true,
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "object": {
                    "type": "string",
                    "enum": [
                        "company",
                        "person",
                        "sale",
                        "project",
                        "appointment",
                        "ticket"
                    ]
                },
                "conditionField": {
                    "type": "string"
                },
                "conditionOperator": {
                    "type": "string",
                    "enum": [
                        "changedTo",
                        "equals",
                        "notEquals",
                        "changed"
                    ]
                },
                "conditionValue": {
                    "type": "string"
                }
            },
            "required": [
                "object"
            ]
        },
        "inspector": {
            "inputs": {
                "object": {
                    "type": "select",
                    "index": 1,
                    "label": "Object",
                    "tooltip": "The kind of record to watch.",
                    "options": [
                        {
                            "label": "Company",
                            "value": "company"
                        },
                        {
                            "label": "Person",
                            "value": "person"
                        },
                        {
                            "label": "Sale",
                            "value": "sale"
                        },
                        {
                            "label": "Project",
                            "value": "project"
                        },
                        {
                            "label": "Follow-up (appointment or task)",
                            "value": "appointment"
                        },
                        {
                            "label": "Ticket (request)",
                            "value": "ticket"
                        }
                    ]
                },
                "conditionField": {
                    "type": "text",
                    "index": 2,
                    "label": "Only When Field",
                    "tooltip": "Optional. Fire only for updates where this field meets the condition below, for example Base Status of a ticket, Completed of a follow-up or a custom field. Pick a field, or type its key.",
                    "source": {
                        "url": "/component/appmixer/superoffice/core/ListFields?outPort=out",
                        "data": {
                            "messages": {
                                "in/object": "properties/object",
                                "in/outputType": "array"
                            },
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListFields#toSelectArray"
                        }
                    }
                },
                "conditionOperator": {
                    "type": "select",
                    "index": 3,
                    "label": "Condition",
                    "defaultValue": "changedTo",
                    "tooltip": "Changes to: the field has the value now and had another one when the trigger last saw the record (a record the trigger has not seen since it started counts as changed). Equals / does not equal: every update while the field has (not) the value. Changes: the field value differs from the last one seen.",
                    "options": [
                        {
                            "label": "Changes to",
                            "value": "changedTo"
                        },
                        {
                            "label": "Equals",
                            "value": "equals"
                        },
                        {
                            "label": "Does not equal",
                            "value": "notEquals"
                        },
                        {
                            "label": "Changes",
                            "value": "changed"
                        }
                    ]
                },
                "conditionValue": {
                    "type": "text",
                    "index": 4,
                    "label": "Value",
                    "tooltip": "The value to compare with, case-insensitive, for example Closed for the Base Status of a ticket or Completed for a follow-up. For Status ID or a status list the dropdown offers the status values of the object.",
                    "source": {
                        "url": "/component/appmixer/superoffice/core/ListStatuses?outPort=out",
                        "data": {
                            "messages": {
                                "in/object": "properties/object",
                                "in/outputType": "array"
                            },
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListStatuses#toSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/superoffice/core/GetRecord?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/object": "properties/object",
                        "in/recordId": "dummy"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
