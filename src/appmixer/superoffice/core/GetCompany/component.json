{
    "name": "appmixer.superoffice.core.GetCompany",
    "label": "Get Company",
    "description": "Get a company by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:superoffice"
    },
    "quota": {
        "manager": "appmixer:superoffice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "companyId": {
                        "type": "string"
                    },
                    "timeZone": {
                        "type": "string"
                    }
                },
                "required": [
                    "companyId"
                ]
            },
            "inspector": {
                "inputs": {
                    "companyId": {
                        "type": "text",
                        "index": 1,
                        "label": "Company ID",
                        "tooltip": "The ID of the company. Use Find Companies to look it up."
                    },
                    "timeZone": {
                        "type": "text",
                        "index": 2,
                        "label": "Time Zone",
                        "tooltip": "Optional. The time zone of your SuperOffice tenant, for example Europe/Oslo. SuperOffice keeps date-times in the local time of the tenant; the time zone is detected automatically (reliably for European tenants) and this setting overrides it. Date-times the component returns are always in UTC.",
                        "source": {
                            "url": "/component/appmixer/superoffice/core/ListTimeZones?outPort=out",
                            "data": {
                                "transform": "./ListTimeZones#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Company ID",
                        "example": 125
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Acme Inc."
                    },
                    "department": {
                        "type": "string",
                        "title": "Department",
                        "example": "Sales"
                    },
                    "orgNr": {
                        "type": "string",
                        "title": "Organization Number",
                        "example": "987654321"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "example": "Customer"
                    },
                    "business": {
                        "type": "string",
                        "title": "Business",
                        "example": "IT"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "Norway"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email",
                        "example": "info@acme.example"
                    },
                    "phone": {
                        "type": "string",
                        "title": "Phone",
                        "example": "+47 22 00 00 00"
                    },
                    "website": {
                        "type": "string",
                        "title": "Website",
                        "example": "https://acme.example"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "Reseller for the Nordic market."
                    },
                    "createdDate": {
                        "type": "string",
                        "title": "Created Date",
                        "example": "2026-11-16T10:30:00Z"
                    },
                    "updatedDate": {
                        "type": "string",
                        "title": "Updated Date",
                        "example": "2026-11-17T08:15:00Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
