{
    "name": "appmixer.superoffice.core.UpdateProject",
    "label": "Update Project",
    "description": "Update a project. Only the fields you fill in are changed.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:superoffice"
    },
    "quota": {
        "manager": "appmixer:superoffice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "projectTypeId": {
                        "type": "string"
                    },
                    "projectStatusId": {
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "label": "Project ID",
                        "tooltip": "The ID of the project. Use Find Projects to look it up."
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The project name."
                    },
                    "projectTypeId": {
                        "type": "text",
                        "index": 3,
                        "label": "Project Type",
                        "tooltip": "Pick a project type, or type its ID.",
                        "source": {
                            "url": "/component/appmixer/superoffice/core/ListListItems?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true,
                                    "listName": "ProjectType"
                                },
                                "transform": "./ListListItems#toSelectArray"
                            }
                        }
                    },
                    "projectStatusId": {
                        "type": "text",
                        "index": 4,
                        "label": "Project Status",
                        "tooltip": "Pick a project status, or type its ID.",
                        "source": {
                            "url": "/component/appmixer/superoffice/core/ListListItems?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true,
                                    "listName": "ProjectStatus"
                                },
                                "transform": "./ListListItems#toSelectArray"
                            }
                        }
                    },
                    "startDate": {
                        "type": "date-time",
                        "index": 5,
                        "label": "Start Date"
                    },
                    "endDate": {
                        "type": "date-time",
                        "index": 6,
                        "label": "End Date"
                    },
                    "description": {
                        "type": "textarea",
                        "index": 7,
                        "label": "Description",
                        "tooltip": "Text describing the project."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
