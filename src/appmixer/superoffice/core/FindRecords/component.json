{
    "name": "appmixer.superoffice.core.FindRecords",
    "label": "Find Records",
    "description": "Find companies, persons, sales, projects, follow-ups or tickets, newest first, each read in full with its owner and custom fields. Returns at most 100 records.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:superoffice"
    },
    "quota": {
        "manager": "appmixer:superoffice",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "object": {
                        "type": "string",
                        "enum": [
                            "company",
                            "person",
                            "sale",
                            "project",
                            "appointment",
                            "ticket"
                        ]
                    },
                    "companyId": {
                        "type": "string"
                    },
                    "personId": {
                        "type": "string"
                    },
                    "ownerId": {
                        "type": "string"
                    },
                    "filter": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "first",
                            "array",
                            "object",
                            "file"
                        ]
                    }
                },
                "required": [
                    "object"
                ]
            },
            "inspector": {
                "inputs": {
                    "object": {
                        "type": "select",
                        "index": 1,
                        "label": "Object",
                        "tooltip": "The kind of records to find.",
                        "options": [
                            {
                                "label": "Company",
                                "value": "company"
                            },
                            {
                                "label": "Person",
                                "value": "person"
                            },
                            {
                                "label": "Sale",
                                "value": "sale"
                            },
                            {
                                "label": "Project",
                                "value": "project"
                            },
                            {
                                "label": "Follow-up (appointment or task)",
                                "value": "appointment"
                            },
                            {
                                "label": "Ticket (request)",
                                "value": "ticket"
                            }
                        ]
                    },
                    "companyId": {
                        "type": "text",
                        "index": 2,
                        "label": "Company ID",
                        "tooltip": "Records of this company. Not available for projects."
                    },
                    "personId": {
                        "type": "text",
                        "index": 3,
                        "label": "Person ID",
                        "tooltip": "Records of this person. Not available for companies and projects."
                    },
                    "ownerId": {
                        "type": "text",
                        "index": 4,
                        "label": "Owner",
                        "tooltip": "Only records owned by this user (our contact, ticket owner). Pick a user, or type the associate ID.",
                        "source": {
                            "url": "/component/appmixer/superoffice/core/ListUsers?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListUsers#toSelectArray"
                            }
                        }
                    },
                    "filter": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Additional Filter",
                        "tooltip": "Optional SuperOffice OData filter on the archive columns of the object, added with \"and\". For example follow-ups dated before a day: <code>date before '2026-11-19'</code>; tickets of a status: <code>ticketStatusId eq 2</code>. See the archive provider reference in the SuperOffice documentation."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/superoffice/core/FindRecords?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/object": "inputs/in/object"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
