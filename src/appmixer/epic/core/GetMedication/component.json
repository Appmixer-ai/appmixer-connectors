{
    "name": "appmixer.epic.core.GetMedication",
    "label": "Get Medication",
    "description": "Retrieve a single Medication resource from Epic by its FHIR ID. The Medication ID is typically taken from a Medication Request's medicationReference.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:epic"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "medicationId": { "type": "string" }
                },
                "required": ["medicationId"]
            },
            "inspector": {
                "inputs": {
                    "medicationId": {
                        "type": "text",
                        "label": "Medication ID",
                        "index": 1,
                        "tooltip": "The FHIR ID of the Medication resource."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "resourceType": { "type": "string", "title": "Resource Type", "example": "Medication" },
                    "id": { "type": "string", "title": "Medication ID", "example": "eXYZ1234567890" },
                    "status": { "type": "string", "title": "Status", "example": "active" },
                    "code": { "type": "object", "title": "Code", "example": { "text": "Lisinopril 10 MG Oral Tablet" } },
                    "manufacturer": { "type": "object", "title": "Manufacturer", "example": { "display": "Acme Pharmaceuticals" } },
                    "form": { "type": "object", "title": "Form", "example": { "text": "Oral Tablet" } },
                    "ingredient": { "type": "array", "title": "Ingredient", "example": [{ "itemCodeableConcept": { "text": "Lisinopril" } }] }
                }
            }
        }
    ]
}
