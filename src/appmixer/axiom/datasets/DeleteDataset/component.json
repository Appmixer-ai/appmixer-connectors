{
    "name": "appmixer.axiom.datasets.DeleteDataset",
    "label": "Delete Dataset",
    "description": "Delete a dataset from Axiom.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the dataset to delete"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}