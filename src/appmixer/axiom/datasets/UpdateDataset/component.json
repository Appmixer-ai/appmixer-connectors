{
    "name": "appmixer.axiom.datasets.UpdateDataset",
    "label": "Update Dataset",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing dataset in Axiom.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the dataset to update"
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "index": 2,
                        "tooltip": "New name for the dataset"
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 3,
                        "tooltip": "New description for the dataset"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}