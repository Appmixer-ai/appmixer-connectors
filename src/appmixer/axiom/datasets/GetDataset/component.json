{
    "name": "appmixer.axiom.datasets.GetDataset",
    "label": "Get Dataset",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get details about a specific dataset by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the dataset to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dataset ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created By",
                    "value": "who",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Kind",
                    "value": "kind",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Retention Days",
                    "value": "retentionDays",
                    "schema": {
                        "type": "integer"
                    }
                },
                {
                    "label": "Use Retention Period",
                    "value": "useRetentionPeriod",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Can Write",
                    "value": "canWrite",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Map Fields",
                    "value": "mapFields",
                    "schema": {
                        "type": "null"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}