{
    "name": "appmixer.axiom.datasets.IngestEvents",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Ingest events into an Axiom dataset. Events should be provided as a JSON array.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "ingest",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "events": {
                        "type": "string"
                    }
                },
                "required": ["datasetId", "events"]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the dataset to ingest events into"
                    },
                    "events": {
                        "type": "textarea",
                        "label": "Events",
                        "index": 2,
                        "tooltip": "JSON array of events to ingest. Example: [{\"message\": \"Hello\", \"level\": \"info\"}]"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Ingested Count", "value": "ingested" },
                { "label": "Failed Count", "value": "failed" },
                { "label": "Failures", "value": "failures" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
