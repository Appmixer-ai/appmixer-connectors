{
    "name": "appmixer.axiom.monitors.CreateMonitor",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new monitor in Axiom to alert on specific conditions in your data.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "query": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "threshold": {
                        "type": "number"
                    }
                },
                "required": ["name", "query", "operator", "threshold"]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Monitor Name",
                        "index": 1,
                        "tooltip": "The name of the monitor"
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 2,
                        "tooltip": "Optional description of the monitor"
                    },
                    "query": {
                        "type": "textarea",
                        "label": "APL Query",
                        "index": 3,
                        "tooltip": "APL query to monitor. Example: ['my-dataset'] | where severity == 'error' | count"
                    },
                    "operator": {
                        "type": "select",
                        "label": "Operator",
                        "index": 4,
                        "tooltip": "Comparison operator for the threshold",
                        "options": [
                            { "label": "Above", "value": "above" },
                            { "label": "Below", "value": "below" },
                            { "label": "Above or Equal", "value": "aboveOrEqual" },
                            { "label": "Below or Equal", "value": "belowOrEqual" }
                        ]
                    },
                    "threshold": {
                        "type": "number",
                        "label": "Threshold",
                        "index": 5,
                        "tooltip": "Numeric threshold value to trigger the monitor"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Monitor ID", "value": "id" },
                { "label": "Name", "value": "name" },
                { "label": "Description", "value": "description" },
                { "label": "Query", "value": "query" },
                { "label": "Operator", "value": "operator" },
                { "label": "Threshold", "value": "threshold" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
