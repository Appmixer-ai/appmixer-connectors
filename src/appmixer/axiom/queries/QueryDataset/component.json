{
    "name": "appmixer.axiom.queries.QueryDataset",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Execute an APL query against an Axiom dataset. APL (Axiom Processing Language) is the query language used by Axiom.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:axiom"
    },
    "quota": {
        "manager": "appmixer:axiom",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "startTime": {
                        "type": "string"
                    },
                    "endTime": {
                        "type": "string"
                    }
                },
                "required": ["query"]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "textarea",
                        "label": "APL Query",
                        "index": 1,
                        "tooltip": "APL query to execute. Example: ['my-dataset'] | where severity == 'error' | limit 100"
                    },
                    "startTime": {
                        "type": "date-time",
                        "label": "Start Time",
                        "index": 2,
                        "tooltip": "Optional start time for the query (ISO 8601 format)"
                    },
                    "endTime": {
                        "type": "date-time",
                        "label": "End Time",
                        "index": 3,
                        "tooltip": "Optional end time for the query (ISO 8601 format)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Status", "value": "status" },
                { "label": "Matches", "value": "matches" },
                { "label": "Buckets", "value": "buckets" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
