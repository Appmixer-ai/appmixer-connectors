                                    "datasetName": "{{{var-ingest-name}}}",
                                    "data": "[{\"message\":\"E2E test event 1\",\"level\":\"info\"},{\"message\":\"E2E test event 2\",\"level\":\"warning\"}]",
                                    "dataFormat": "json"
                                }
