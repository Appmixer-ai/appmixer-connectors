                                        "expected-name": {
                                            "variable": "$.set-variables.out.datasetName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-name}}}",
