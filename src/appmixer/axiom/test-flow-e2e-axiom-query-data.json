{
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "datasetName",
                                                "text": "e2e-axiom-test-{{{g_timestamp()}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "ingestData",
                                                "text": "[{\"message\":\"E2E test event\",\"level\":\"info\",\"source\":\"appmixer-e2e\"}]"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-dataset": {
            "type": "appmixer.axiom.datasets.CreateDataset",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {
                                        "var-dataset-name": {
                                            "variable": "$.set-variables.out.datasetName",
                                            "functions": []
                                        }
                                    },
                                    "description": {}
                                },
                                "lambda": {
                                    "name": "{{{var-dataset-name}}}",
                                    "description": "E2E test dataset created by Appmixer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "ingest-data": {
            "type": "appmixer.axiom.datasets.IngestData",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetName": {
                                        "var-dataset-name": {
                                            "variable": "$.create-dataset.out.name",
                                            "functions": []
                                        }
                                    },
                                    "data": {
                                        "var-ingest-data": {
                                            "variable": "$.set-variables.out.ingestData",
                                            "functions": []
                                        }
                                    },
                                    "dataFormat": {}
                                },
                                "lambda": {
                                    "datasetName": "{{{var-dataset-name}}}",
                                    "data": "{{{var-ingest-data}}}",
                                    "dataFormat": "json"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-ingest": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "ingest-data": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "ingest-data": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "ingested-count": {
                                            "variable": "$.ingest-data.out.ingested",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{ingested-count}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "query-dataset": {
            "type": "appmixer.axiom.queries.QueryDataset",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "ingest-data": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "ingest-data": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetName": {
                                        "var-dataset-name": {
                                            "variable": "$.create-dataset.out.name",
                                            "functions": []
                                        }
                                    },
                                    "startTime": {},
                                    "endTime": {},
                                    "resolution": {}
                                },
                                "lambda": {
                                    "datasetName": "{{{var-dataset-name}}}",
                                    "startTime": "now-1h",
                                    "endTime": "now",
                                    "resolution": "auto"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-query": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "query-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "query-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "status-field": {
                                            "variable": "$.query-dataset.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{status-field}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 208,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-ingest": [
                        "out"
                    ],
                    "assert-query": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-dataset": {
            "type": "appmixer.axiom.datasets.DeleteDataset",
            "x": 1584,
            "y": 208,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-dataset-id": {
                                            "variable": "$.create-dataset.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "datasetId": "{{{var-dataset-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1776,
            "y": 208,
            "version": "1.0.1",
            "source": {
                "in": {
                    "delete-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "delete-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E Axiom - Query Data",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "name": "E2E Axiom - Query Data",
    "type": "automation",
    "notes": {}
}