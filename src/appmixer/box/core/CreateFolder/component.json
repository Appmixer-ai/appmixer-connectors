{
    "name": "appmixer.box.core.CreateFolder",
    "description": "Creates a new folder in the specified parent.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "label": "Create Folder",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Name of the new folder.",
                        "index": 1
                    },
                    "parentId": {
                        "type": "text",
                        "label": "Parent Folder ID",
                        "tooltip": "ID of the parent folder where the new folder will be created. If not specified, the folder will be created in the root directory.",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "folder"
                    }
                },
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Project Documents"
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "example": {
                            "type": "folder",
                            "id": "0",
                            "name": "All Files",
                            "sequence_id": null,
                            "etag": null
                        },
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Parent.Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "Parent.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Parent.Name"
                            },
                            "sequence_id": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "title": "Parent.Sequence Id"
                            },
                            "etag": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "title": "Parent.Etag"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}