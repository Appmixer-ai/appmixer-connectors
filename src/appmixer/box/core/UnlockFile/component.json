{
    "name": "appmixer.box.core.UnlockFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Removes a lock from a file, allowing other users to modify the file. This endpoint is used to unlock files that were previously locked.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the file to unlock",
                        "label": "File ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "Etag",
                    "value": "etag",
                    "schema": {
                        "type": "string",
                        "example": "5"
                    }
                },
                {
                    "label": "Lock",
                    "value": "lock",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "contract-draft.docx"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Draft of the Q1 contract for review"
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number",
                        "example": 524288
                    }
                },
                {
                    "label": "File Version",
                    "value": "file_version",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "55667788",
                            "type": "file_version"
                        },
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "File Version.Id"
                            },
                            "type": {
                                "type": "string",
                                "title": "File Version.Type"
                            }
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T09:00:00-08:00"
                    }
                },
                {
                    "label": "Modified By",
                    "value": "modified_by",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "33224455",
                            "type": "user",
                            "login": "john.smith@example.com",
                            "name": "John Smith"
                        },
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Modified By.Id"
                            },
                            "type": {
                                "type": "string",
                                "title": "Modified By.Type"
                            },
                            "login": {
                                "type": "string",
                                "title": "Modified By.Login"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Owned By",
                    "value": "owned_by",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "33224455",
                            "type": "user",
                            "login": "john.smith@example.com",
                            "name": "John Smith"
                        },
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Owned By.Id"
                            },
                            "type": {
                                "type": "string",
                                "title": "Owned By.Type"
                            },
                            "login": {
                                "type": "string",
                                "title": "Owned By.Login"
                            },
                            "name": {
                                "type": "string",
                                "title": "Owned By.Name"
                            }
                        }
                    }
                },
                {
                    "label": "Shared Link",
                    "value": "shared_link",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "11446498",
                            "type": "folder"
                        },
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Parent.Id"
                            },
                            "type": {
                                "type": "string",
                                "title": "Parent.Type"
                            }
                        }
                    }
                },
                {
                    "label": "Path Collection",
                    "value": "path_collection",
                    "schema": {
                        "type": "object",
                        "example": {
                            "total_count": 2,
                            "entries": [
                                { "id": "0", "type": "folder", "name": "All Files" },
                                { "id": "11446498", "type": "folder", "name": "Contracts" }
                            ]
                        },
                        "properties": {
                            "total_count": {
                                "type": "number",
                                "title": "Path Collection.Total Count"
                            },
                            "entries": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Id"
                                        },
                                        "type": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Type"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Name"
                                        }
                                    }
                                },
                                "title": "Path Collection.Entries"
                            }
                        }
                    }
                },
                {
                    "label": "Trashed At",
                    "value": "trashed_at",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Purged At",
                    "value": "purged_at",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Content Created At",
                    "value": "content_created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Content Modified At",
                    "value": "content_modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-02-20T14:45:00-08:00"
                    }
                },
                {
                    "label": "Is Externally Owned",
                    "value": "is_externally_owned",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Has Collaborations",
                    "value": "has_collaborations",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Is Package",
                    "value": "is_package",
                    "schema": {
                        "type": "boolean",
                        "example": false
                    }
                },
                {
                    "label": "Comment Count",
                    "value": "comment_count",
                    "schema": {
                        "type": "number",
                        "example": 0
                    }
                },
                {
                    "label": "Permissions",
                    "value": "permissions",
                    "schema": {
                        "type": "null",
                        "example": null
                    }
                },
                {
                    "label": "Tags",
                    "value": "tags",
                    "schema": {
                        "type": "array",
                        "example": [],
                        "items": {}
                    }
                },
                {
                    "label": "SHA1",
                    "value": "sha1",
                    "schema": {
                        "type": "string",
                        "example": "da39a3ee5e6b4b0d3255bfef95601890afd80709"
                    }
                },
                {
                    "label": "Version Number",
                    "value": "version_number",
                    "schema": {
                        "type": "string",
                        "example": "3"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}