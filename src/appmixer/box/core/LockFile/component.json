{
    "name": "appmixer.box.core.LockFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Lock a file to prevent other users from modifying it. When a file is locked, only the user who locked it can make changes to the file until the lock is released.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "lockExpiresAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the file to lock. This is a required parameter that identifies which file should be locked.",
                        "label": "File ID",
                        "index": 0
                    },
                    "lockExpiresAt": {
                        "type": "date-time",
                        "tooltip": "The ISO 8601 formatted date and time when the lock will automatically expire. Optional parameter. If not provided, the lock will remain until manually released.",
                        "label": "Lock Expires At",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "file"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "contract-draft.docx"
                    }
                },
                {
                    "label": "File Version",
                    "value": "file_version",
                    "schema": {
                        "type": "object",
                        "example": {
                            "id": "55667788",
                            "type": "file_version"
                        },
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "File Version ID"
                            },
                            "type": {
                                "type": "string",
                                "title": "File Version Type"
                            }
                        }
                    }
                },
                {
                    "label": "Lock",
                    "value": "lock",
                    "schema": {
                        "type": "object",
                        "example": {
                            "type": "lock",
                            "id": "77889900",
                            "created_by": {
                                "type": "user",
                                "id": "33224455",
                                "name": "John Smith",
                                "login": "john.smith@example.com"
                            },
                            "created_at": "2024-03-01T09:00:00-08:00",
                            "expires_at": "2024-03-08T09:00:00-08:00"
                        },
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Lock Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "Lock ID"
                            },
                            "created_by": {
                                "type": "object",
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "title": "Lock Created By Type"
                                    },
                                    "id": {
                                        "type": "string",
                                        "title": "Lock Created By ID"
                                    },
                                    "name": {
                                        "type": "string",
                                        "title": "Lock Created By Name"
                                    },
                                    "login": {
                                        "type": "string",
                                        "title": "Lock Created By Login"
                                    }
                                },
                                "title": "Lock Created By"
                            },
                            "created_at": {
                                "type": "string",
                                "title": "Lock Created At"
                            },
                            "expires_at": {
                                "type": "string",
                                "title": "Lock Expires At"
                            }
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-01-15T10:30:00-08:00"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-01T09:00:00-08:00"
                    }
                },
                {
                    "label": "Modified By",
                    "value": "modified_by",
                    "schema": {
                        "type": "object",
                        "example": {
                            "type": "user",
                            "id": "33224455",
                            "name": "John Smith",
                            "login": "john.smith@example.com"
                        },
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Modified By Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "Modified By ID"
                            },
                            "name": {
                                "type": "string",
                                "title": "Modified By Name"
                            },
                            "login": {
                                "type": "string",
                                "title": "Modified By Login"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}