{
    "name": "appmixer.box.core.DeleteFolder",
    "description": "Deletes a folder by ID. Use recursive=true to delete non-empty folders.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "recursive": {
                        "type": "boolean"
                    },
                    "ifMatch": {
                        "type": "string"
                    }
                },
                "required": [
                    "folderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "index": 0,
                        "label": "Folder ID",
                        "tooltip": "The ID of the folder to delete."
                    },
                    "recursive": {
                        "type": "toggle",
                        "index": 1,
                        "label": "Recursive",
                        "defaultValue": true,
                        "tooltip": "If true, deletes the folder and all items within it."
                    },
                    "ifMatch": {
                        "type": "text",
                        "index": 2,
                        "label": "If Match",
                        "tooltip": "Optional ETag to conditionally delete. Sent as If-Match header."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}