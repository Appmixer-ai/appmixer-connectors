        "send-document": {
            "type": "appmixer.whatsapp.messages.SendDocumentMessage",
            "x": 448,
            "y": 400,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "phoneNumberId": {
                                        "phone-number-id-var-4": {
                                            "variable": "$.set-variables.out.phoneNumberId",
                                            "functions": []
