                                "lambda": {
                                    "phoneNumberId": "{{{phone-number-id-var-4}}}",
                                    "to": "{{{recipient-var-4}}}",
                                    "link": "{{{document-url-var}}}",
                                    "filename": "e2e-test-sample.pdf",
                                    "caption": "E2E Test - Document Message"
