                                    "link": "{{{audio-url-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-audio": {
            "type": "appmixer.utils.test.Assert",
            "x": 704,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-audio": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-audio": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "audio-message-id": {
                                            "variable": "$.send-audio.out.messageId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
