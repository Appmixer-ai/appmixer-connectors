{
    "name": "E2E Whatsapp - Send Media Messages",
    "description": "End-to-end test for Whatsapp connector - tests SendImageMessage, SendAudioMessage, SendVideoMessage, and SendDocumentMessage components",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "phoneNumberId",
                                                "text": "{{E2E_WHATSAPP_PHONE_NUMBER_ID}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "recipientPhone",
                                                "text": "{{E2E_WHATSAPP_RECIPIENT_PHONE}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "imageUrl",
                                                "text": "https://www.gstatic.com/webp/gallery/1.jpg"
                                            },
                                            {
                                                "type": "text",
                                                "name": "audioUrl",
                                                "text": "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"
                                            },
                                            {
                                                "type": "text",
                                                "name": "videoUrl",
                                                "text": "https://www.w3schools.com/html/mov_bbb.mp4"
                                            },
                                            {
                                                "type": "text",
                                                "name": "documentUrl",
                                                "text": "https://www.w3.org/WAI/WCAG21/Techniques/pdf/sample.pdf"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "send-image": {
            "type": "appmixer.whatsapp.messages.SendImageMessage",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "phoneNumberId": {
                                        "phone-number-id-var": {
                                            "variable": "$.set-variables.out.phoneNumberId",
                                            "functions": []
                                        }
                                    },
                                    "to": {
                                        "recipient-var": {
                                            "variable": "$.set-variables.out.recipientPhone",
                                            "functions": []
                                        }
                                    },
                                    "link": {
                                        "image-url-var": {
                                            "variable": "$.set-variables.out.imageUrl",
                                            "functions": []
                                        }
                                    },
                                    "caption": {}
                                },
                                "lambda": {
                                    "phoneNumberId": "{{{phone-number-id-var}}}",
                                    "to": "{{{recipient-var}}}",
                                    "link": "{{{image-url-var}}}",
                                    "caption": "E2E Test - Image Message"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-image": {
            "type": "appmixer.utils.test.Assert",
            "x": 704,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-image": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-image": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "image-message-id": {
                                            "variable": "$.send-image.out.messageId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{image-message-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "send-audio": {
            "type": "appmixer.whatsapp.messages.SendAudioMessage",
            "x": 448,
            "y": 144,
            "version": "1.0.0",
