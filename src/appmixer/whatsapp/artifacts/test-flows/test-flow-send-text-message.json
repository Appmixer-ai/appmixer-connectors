{
    "name": "E2E Whatsapp - Send Text Message",
    "description": "End-to-end test for Whatsapp connector - tests SendTextMessage action and MessageStatusUpdated trigger",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "recipientPhone",
                                                "text": "+15550000000"
                                            },
                                            {
                                                "type": "text",
                                                "name": "messageText",
                                                "text": "E2E Test Message - WhatsApp"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "send-text-message": {
            "type": "appmixer.whatsapp.messages.SendTextMessage",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "to": {
                                        "var-to": {
                                            "variable": "$.set-variables.out.recipientPhone",
                                            "functions": []
                                        }
                                    },
                                    "text": {
                                        "var-text": {
                                            "variable": "$.set-variables.out.messageText",
                                            "functions": []
                                        }
                                    },
                                    "phoneNumberId": {}
                                },
                                "lambda": {
                                    "to": "{{{var-to}}}",
                                    "text": "{{{var-text}}}",
                                    "phoneNumberId": "YOUR_PHONE_NUMBER_ID"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-send": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "send-text-message": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "send-text-message": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-message-id": {
                                            "variable": "$.send-text-message.out.messageId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-message-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "message-status-updated": {
            "type": "appmixer.whatsapp.notifications.MessageStatusUpdated",
            "x": 448,
            "y": 144,
            "version": "1.0.0",
            "source": {},
            "config": {}
        },
        "assert-status": {
            "type": "appmixer.utils.test.Assert",
            "x": 832,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "message-status-updated": [
                        "status"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "message-status-updated": {
                            "status": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-status-id": {
                                            "variable": "$.message-status-updated.status.id",
                                            "functions": []
                                        },
                                        "field-status-value": {
                                            "variable": "$.message-status-updated.status.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-status-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{field-status-value}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1024,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-send": [
                        "out"
                    ],
                    "assert-status": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 60
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1216,
            "y": 80,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Whatsapp - Send Text Message",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}