{
    "name": "appmixer.xero.accounting.UpdateManualJournal",
    "description": "Update a manual journal.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:xero",
        "scope": [
            "accounting.transactions"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "tenantId": {
                        "type": "string"
                    },
                    "ManualJournalID": {
                        "type": "string"
                    },
                    "Narration": {
                        "type": "string"
                    },
                    "Date": {
                        "type": "string",
                        "format": "date"
                    },
                    "Status": {
                        "type": "string"
                    },
                    "LineAmountTypes": {
                        "type": "string"
                    },
                    "Url": {
                        "type": "string"
                    },
                    "ShowOnCashBasisReports": {
                        "type": "boolean"
                    },
                    "JournalLines": {
                        "type": "string"
                    }
                },
                "required": [
                    "tenantId",
                    "ManualJournalID",
                    "Narration",
                    "JournalLines"
                ]
            },
            "inspector": {
                "inputs": {
                    "tenantId": {
                        "type": "select",
                        "label": "Tenant ID",
                        "tooltip": "Select the Xero organisation (tenant) containing the manual journal.",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/xero/accounting/ListTenants?outPort=tenants",
                            "data": {
                                "transform": "./transformers#tenantsToSelectArray"
                            }
                        }
                    },
                    "ManualJournalID": {
                        "type": "text",
                        "label": "Manual Journal ID",
                        "tooltip": "The Xero identifier for the manual journal to update.",
                        "index": 2
                    },
                    "Narration": {
                        "type": "text",
                        "label": "Narration",
                        "tooltip": "Description of the journal being posted.",
                        "index": 3
                    },
                    "JournalLines": {
                        "type": "textarea",
                        "label": "Journal Lines",
                        "tooltip": "JSON array of journal lines. Each line must have LineAmount and AccountCode. Debits are positive, credits are negative. Total debits must equal total credits. Example: [{\"LineAmount\":100,\"AccountCode\":\"400\",\"Description\":\"Debit\"},{\"LineAmount\":-100,\"AccountCode\":\"200\",\"Description\":\"Credit\"}]",
                        "index": 4
                    },
                    "Date": {
                        "type": "date-time",
                        "config": {
                            "format": "YYYY-MM-DD",
                            "enableTime": false
                        },
                        "label": "Date",
                        "tooltip": "Date journal was posted – YYYY-MM-DD.",
                        "index": 5
                    },
                    "Status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Manual journal status.",
                        "index": 6,
                        "options": [
                            {
                                "clearItem": true,
                                "label": "-- No change --"
                            },
                            {
                                "label": "Draft",
                                "value": "DRAFT"
                            },
                            {
                                "label": "Posted",
                                "value": "POSTED"
                            },
                            {
                                "label": "Voided",
                                "value": "VOIDED"
                            }
                        ]
                    },
                    "LineAmountTypes": {
                        "type": "select",
                        "label": "Line Amount Types",
                        "tooltip": "Line amounts are exclusive of tax by default.",
                        "index": 7,
                        "options": [
                            {
                                "clearItem": true,
                                "label": "-- No change --"
                            },
                            {
                                "label": "Exclusive",
                                "value": "Exclusive"
                            },
                            {
                                "label": "Inclusive",
                                "value": "Inclusive"
                            },
                            {
                                "label": "No Tax",
                                "value": "NoTax"
                            }
                        ]
                    },
                    "Url": {
                        "type": "text",
                        "label": "URL",
                        "tooltip": "URL link to a source document.",
                        "index": 8
                    },
                    "ShowOnCashBasisReports": {
                        "type": "toggle",
                        "label": "Show On Cash Basis Reports",
                        "tooltip": "Defaults to true if not specified.",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Manual Journal ID",
                    "value": "ManualJournalID"
                },
                {
                    "label": "Narration",
                    "value": "Narration"
                },
                {
                    "label": "Date",
                    "value": "Date"
                },
                {
                    "label": "Status",
                    "value": "Status"
                },
                {
                    "label": "Line Amount Types",
                    "value": "LineAmountTypes"
                },
                {
                    "label": "Journal Lines",
                    "value": "JournalLines",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "LineAmount": {
                                    "type": "number"
                                },
                                "AccountCode": {
                                    "type": "string"
                                },
                                "AccountID": {
                                    "type": "string"
                                },
                                "Description": {
                                    "type": "string"
                                },
                                "TaxType": {
                                    "type": "string"
                                },
                                "TaxAmount": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "URL",
                    "value": "Url"
                },
                {
                    "label": "Show On Cash Basis Reports",
                    "value": "ShowOnCashBasisReports"
                },
                {
                    "label": "Has Attachments",
                    "value": "HasAttachments"
                },
                {
                    "label": "Updated Date UTC",
                    "value": "UpdatedDateUTC"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}