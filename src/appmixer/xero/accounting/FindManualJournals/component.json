{
    "name": "appmixer.xero.accounting.FindManualJournals",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Find manual journals. Optionally filter by status.",
    "private": false,
    "auth": {
        "service": "appmixer:xero",
        "scope": [
            "accounting.transactions.read"
        ]
    },
    "quota": {
        "manager": "appmixer:xero:accounting",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "tenantId": {
                        "type": "string"
                    },
                    "Status": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "tenantId"
                ]
            },
            "inspector": {
                "inputs": {
                    "tenantId": {
                        "type": "select",
                        "label": "Tenant ID",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/xero/accounting/ListTenants?outPort=tenants",
                            "data": {
                                "transform": "./transformers#tenantsToSelectArray"
                            }
                        }
                    },
                    "Status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Filter by manual journal status.",
                        "index": 2,
                        "options": [
                            {
                                "label": "-- All --",
                                "value": ""
                            },
                            {
                                "label": "DRAFT",
                                "value": "DRAFT"
                            },
                            {
                                "label": "POSTED",
                                "value": "POSTED"
                            },
                            {
                                "label": "DELETED",
                                "value": "DELETED"
                            },
                            {
                                "label": "VOIDED",
                                "value": "VOIDED"
                            },
                            {
                                "label": "ARCHIVED",
                                "value": "ARCHIVED"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 3,
                        "defaultValue": "items",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file. For large datasets, streaming the rows to a file is the most efficient method.",
                        "options": [
                            {
                                "label": "All at once",
                                "value": "items"
                            },
                            {
                                "label": "One at a time",
                                "value": "item"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/xero/accounting/FindManualJournals?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/tenantId": "inputs/in/tenantId"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}