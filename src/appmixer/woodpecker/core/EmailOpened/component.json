{
    "name": "appmixer.woodpecker.core.EmailOpened",
    "label": "Email Opened",
    "description": "Triggers when a prospect opens a tracked email. Open tracking must be enabled on the campaign.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "event": { "type": "string", "title": "Event", "example": "email_opened" },
                    "company_id": { "type": "integer", "title": "Company ID", "example": 33221 },
                    "campaign_id": { "type": "integer", "title": "Campaign ID", "example": 12345 },
                    "prospect": {
                        "type": "object",
                        "title": "Prospect",
                        "properties": {
                            "id": { "type": "integer", "title": "ID", "example": 987654 },
                            "email": { "type": "string", "title": "Email", "example": "john@acme.com" },
                            "first_name": { "type": "string", "title": "First Name", "example": "John" },
                            "last_name": { "type": "string", "title": "Last Name", "example": "Smith" },
                            "company": { "type": "string", "title": "Company", "example": "Acme Inc." }
                        }
                    },
                    "timestamp": { "type": "string", "title": "Timestamp", "example": "2025-01-15T10:30:00Z" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
