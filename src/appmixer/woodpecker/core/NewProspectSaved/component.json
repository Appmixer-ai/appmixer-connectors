{
    "name": "appmixer.woodpecker.core.NewProspectSaved",
    "label": "New Prospect Saved",
    "description": "Triggers when a new prospect is saved or updated.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "webhook": true,
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "properties": {},
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "event": { "type": "string", "title": "Event", "example": "prospect_saved" },
                    "company_id": { "type": "integer", "title": "Company ID", "example": 33221 },
                    "campaign_id": { "type": "integer", "title": "Campaign ID", "example": 12345 },
                    "prospect": {
                        "type": "object",
                        "title": "Prospect",
                        "properties": {
                            "id": { "type": "integer", "title": "ID", "example": 987654 },
                            "email": { "type": "string", "title": "Email", "example": "john@acme.com" },
                            "first_name": { "type": "string", "title": "First Name", "example": "John" },
                            "last_name": { "type": "string", "title": "Last Name", "example": "Smith" },
                            "company": { "type": "string", "title": "Company", "example": "Acme Inc." }
                        }
                    },
                    "timestamp": { "type": "string", "title": "Timestamp", "example": "2025-01-15T10:30:00Z" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2212%22%20fill%3D%22%231A1A2E%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2245%22%20font-size%3D%2240%22%20font-family%3D%22Arial%2C%20sans-serif%22%20font-weight%3D%22bold%22%20fill%3D%22%23E94560%22%20text-anchor%3D%22middle%22%3EW%3C%2Ftext%3E%3C%2Fsvg%3E"
}
