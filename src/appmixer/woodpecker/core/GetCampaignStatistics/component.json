{
    "name": "appmixer.woodpecker.core.GetCampaignStatistics",
    "label": "Get Campaign Statistics",
    "description": "Retrieve statistics for a single campaign by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": {
                        "type": "string"
                    }
                },
                "required": [
                    "campaignId"
                ]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1,
                        "tooltip": "The ID of the campaign to retrieve statistics for."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Campaign ID",
                        "example": 12345
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Q1 Outreach"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "RUNNING"
                    },
                    "prospects": {
                        "type": "integer",
                        "title": "Prospects",
                        "example": 120
                    },
                    "sent": {
                        "type": "integer",
                        "title": "Sent",
                        "example": 100
                    },
                    "delivery": {
                        "type": "integer",
                        "title": "Delivered",
                        "example": 98
                    },
                    "opened": {
                        "type": "integer",
                        "title": "Opened",
                        "example": 54
                    },
                    "clicked": {
                        "type": "integer",
                        "title": "Clicked",
                        "example": 9
                    },
                    "replied": {
                        "type": "integer",
                        "title": "Replied",
                        "example": 8
                    },
                    "interested": {
                        "type": "integer",
                        "title": "Interested",
                        "example": 3
                    },
                    "bounced": {
                        "type": "integer",
                        "title": "Bounced",
                        "example": 1
                    },
                    "invalid": {
                        "type": "integer",
                        "title": "Invalid",
                        "example": 1
                    },
                    "optout": {
                        "type": "integer",
                        "title": "Opted Out",
                        "example": 1
                    },
                    "queue": {
                        "type": "integer",
                        "title": "In Queue",
                        "example": 10
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}