{
    "name": "appmixer.woodpecker.core.GetCampaignStatistics",
    "label": "Get Campaign Statistics",
    "description": "Retrieve statistics for a single campaign by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": { "type": "string" }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1,
                        "tooltip": "The ID of the campaign to retrieve statistics for."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "sent": { "type": "integer", "title": "Sent", "example": 1200 },
                    "opened": { "type": "integer", "title": "Opened", "example": 540 },
                    "replied": { "type": "integer", "title": "Replied", "example": 80 },
                    "bounced": { "type": "integer", "title": "Bounced", "example": 12 },
                    "clicked": { "type": "integer", "title": "Clicked", "example": 95 },
                    "opt_outs": { "type": "integer", "title": "Opt Outs", "example": 3 },
                    "delivered": { "type": "integer", "title": "Delivered", "example": 1188 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
