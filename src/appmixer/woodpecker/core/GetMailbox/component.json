{
    "name": "appmixer.woodpecker.core.GetMailbox",
    "label": "Get Mailbox",
    "description": "Get a single mailbox from your Woodpecker account by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["mailboxId"],
                "properties": {
                    "mailboxId": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "mailboxId": {
                        "type": "text",
                        "label": "Mailbox ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "title": "Mailbox ID", "example": 4455 },
                    "email": { "type": "string", "title": "Email", "example": "outreach@acme.com" },
                    "from_name": { "type": "string", "title": "From Name", "example": "Jane Doe" },
                    "signature": { "type": "string", "title": "Signature", "example": "Best, Jane" },
                    "daily_limit": { "type": "integer", "title": "Daily Limit", "example": 50 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2212%22%20fill%3D%22%231A1A2E%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2245%22%20font-size%3D%2240%22%20font-family%3D%22Arial%2C%20sans-serif%22%20font-weight%3D%22bold%22%20fill%3D%22%23E94560%22%20text-anchor%3D%22middle%22%3EW%3C%2Ftext%3E%3C%2Fsvg%3E"
}
