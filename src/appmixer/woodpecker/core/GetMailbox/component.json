{
    "name": "appmixer.woodpecker.core.GetMailbox",
    "label": "Get Mailbox",
    "description": "Get a single mailbox from your Woodpecker account by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["mailboxId"],
                "properties": {
                    "mailboxId": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "mailboxId": {
                        "type": "text",
                        "label": "Mailbox ID",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "title": "Mailbox ID", "example": 4455 },
                    "email": { "type": "string", "title": "Email", "example": "outreach@acme.com" },
                    "from_name": { "type": "string", "title": "From Name", "example": "Jane Doe" },
                    "signature": { "type": "string", "title": "Signature", "example": "Best, Jane" },
                    "daily_limit": { "type": "integer", "title": "Daily Limit", "example": 50 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
