{
    "name": "appmixer.woodpecker.core.GetCampaign",
    "label": "Get Campaign",
    "description": "Retrieve a single campaign by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "campaignId": { "type": "string" }
                },
                "required": ["campaignId"]
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1,
                        "tooltip": "The ID of the campaign to retrieve."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer", "title": "Campaign ID", "example": 12345 },
                    "name": { "type": "string", "title": "Name", "example": "Q1 Outreach" },
                    "status": { "type": "string", "title": "Status", "example": "RUNNING" },
                    "created": { "type": "string", "title": "Created", "example": "2025-01-15T10:30:00Z" },
                    "from_name": { "type": "string", "title": "From Name", "example": "Jane Doe" },
                    "timezone": { "type": "string", "title": "Timezone", "example": "America/New_York" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
