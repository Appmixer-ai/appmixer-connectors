{
    "name": "appmixer.woodpecker.core.AddProspectsToCampaign",
    "label": "Add Prospects to Campaign",
    "description": "Add prospects to a campaign in your Woodpecker account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["campaignId"],
                "properties": {
                    "campaignId": { "type": "string" },
                    "prospects": { "type": "string" },
                    "force": { "type": "boolean" }
                }
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1
                    },
                    "prospects": {
                        "type": "textarea",
                        "label": "Prospects (JSON array)",
                        "index": 2,
                        "tooltip": "A JSON array of prospect objects, each with at least an email."
                    },
                    "force": {
                        "type": "toggle",
                        "label": "Force Upsert",
                        "index": 3,
                        "tooltip": "If enabled, existing prospects are updated."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": { "type": "string", "title": "Status", "example": "OK" },
                    "prospects_added": { "type": "integer", "title": "Prospects Added", "example": 25 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2212%22%20fill%3D%22%231A1A2E%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2245%22%20font-size%3D%2240%22%20font-family%3D%22Arial%2C%20sans-serif%22%20font-weight%3D%22bold%22%20fill%3D%22%23E94560%22%20text-anchor%3D%22middle%22%3EW%3C%2Ftext%3E%3C%2Fsvg%3E"
}
