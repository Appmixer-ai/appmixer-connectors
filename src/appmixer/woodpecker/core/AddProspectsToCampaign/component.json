{
    "name": "appmixer.woodpecker.core.AddProspectsToCampaign",
    "label": "Add Prospects to Campaign",
    "description": "Add prospects to a campaign in your Woodpecker account.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:woodpecker"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["campaignId"],
                "properties": {
                    "campaignId": { "type": "string" },
                    "prospects": { "type": "string" },
                    "force": { "type": "boolean" }
                }
            },
            "inspector": {
                "inputs": {
                    "campaignId": {
                        "type": "text",
                        "label": "Campaign ID",
                        "index": 1
                    },
                    "prospects": {
                        "type": "textarea",
                        "label": "Prospects (JSON array)",
                        "index": 2,
                        "tooltip": "A JSON array of prospect objects, each with at least an email."
                    },
                    "force": {
                        "type": "toggle",
                        "label": "Force Upsert",
                        "index": 3,
                        "tooltip": "If enabled, existing prospects are updated."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "status": { "type": "string", "title": "Status", "example": "OK" },
                    "prospects_added": { "type": "integer", "title": "Prospects Added", "example": 25 }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
