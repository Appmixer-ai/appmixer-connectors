{
    "name": "appmixer.zoom.meeting.GetMeeting",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve detailed information for a specific meeting using its meeting ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:zoom",
        "scope": [
            "meeting:read:meeting"
        ]
    },
    "quota": {
        "manager": "appmixer:zoom",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "meetingId": {
                        "type": "string"
                    }
                },
                "required": [
                    "meetingId"
                ]
            },
            "inspector": {
                "inputs": {
                    "meetingId": {
                        "type": "text",
                        "tooltip": "The unique identifier for the meeting",
                        "label": "Meeting ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Meeting ID",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "85746065234"
                    }
                },
                {
                    "label": "UUID",
                    "value": "uuid",
                    "schema": {
                        "type": "string",
                        "example": "4OByyXGQR6Kzla9H5pYGMA=="
                    }
                },
                {
                    "label": "Host Id",
                    "value": "host_id",
                    "schema": {
                        "type": "string",
                        "example": "abcDE1f2GHijKL3m"
                    }
                },
                {
                    "label": "Topic",
                    "value": "topic",
                    "schema": {
                        "type": "string",
                        "example": "Weekly Team Standup"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "integer",
                        "example": 2
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "waiting"
                    }
                },
                {
                    "label": "Start Time",
                    "value": "start_time",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-15T10:00:00Z"
                    }
                },
                {
                    "label": "Duration",
                    "value": "duration",
                    "schema": {
                        "type": "integer",
                        "example": 60
                    }
                },
                {
                    "label": "Timezone",
                    "value": "timezone",
                    "schema": {
                        "type": "string",
                        "example": "America/New_York"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2024-03-10T14:30:00Z"
                    }
                },
                {
                    "label": "Join URL",
                    "value": "join_url",
                    "schema": {
                        "type": "string",
                        "example": "https://us04web.zoom.us/j/85746065234?pwd=abc123"
                    }
                },
                {
                    "label": "Password",
                    "value": "password",
                    "schema": {
                        "type": "string",
                        "example": "abc123"
                    }
                },
                {
                    "label": "Agenda",
                    "value": "agenda",
                    "schema": {
                        "type": "string",
                        "example": "Discuss Q2 planning and review action items"
                    }
                },
                {
                    "label": "Settings",
                    "value": "settings",
                    "schema": {
                        "type": "object",
                        "example": { "host_video": true, "participant_video": false, "join_before_host": false, "mute_upon_entry": true, "auto_recording": "none" }
                    }
                },
                {
                    "label": "Recurrence",
                    "value": "recurrence",
                    "schema": {
                        "type": "object",
                        "example": { "type": 2, "repeat_interval": 1, "weekly_days": "2,4", "end_times": 10 }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
