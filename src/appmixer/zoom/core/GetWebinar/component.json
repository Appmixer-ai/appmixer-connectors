{
    "name": "appmixer.zoom.core.GetWebinar",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve detailed information about a specific webinar using its ID.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:zoom",
        "scope": [
            "webinar:read:webinar"
        ]
    },
    "quota": {
        "manager": "appmixer:zoom",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "webinarId": {
                        "type": "string"
                    }
                },
                "required": ["webinarId"]
            },
            "inspector": {
                "inputs": {
                    "webinarId": {
                        "type": "text",
                        "tooltip": "The unique identifier of the webinar to retrieve",
                        "label": "Webinar ID",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Webinar ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "UUID",
                    "value": "uuid",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Host Id",
                    "value": "host_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Topic",
                    "value": "topic",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Start Time",
                    "value": "start_time",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Duration",
                    "value": "duration",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Timezone",
                    "value": "timezone",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Join URL",
                    "value": "join_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Registration URL",
                    "value": "registration_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Agenda",
                    "value": "agenda",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Occurrences",
                    "value": "occurrences",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "occurrence_id": { "type": "string" },
                                "start_time": { "type": "string" },
                                "duration": { "type": "number" },
                                "status": { "type": "string" }
                            }
                        }
                    }
                },
                {
                    "label": "Settings",
                    "value": "settings",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "host_video": { "type": "boolean" },
                            "panelists_video": { "type": "boolean" },
                            "practice_session": { "type": "boolean" },
                            "hd_video": { "type": "boolean" },
                            "approval_type": { "type": "number" },
                            "registration_type": { "type": "number" },
                            "audio": { "type": "string" },
                            "auto_recording": { "type": "string" },
                            "alternative_hosts": { "type": "string" }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
