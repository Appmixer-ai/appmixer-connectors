{
    "name": "appmixer.zoom.core.CreateWebinar",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new webinar for a user. Accepts details such as topic, start time, duration, agenda, and additional settings.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:zoom"
    },
    "quota": {
        "manager": "appmixer:zoom",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string"
                    },
                    "topic": {
                        "type": "string"
                    },
                    "start_time": {
                        "type": "string"
                    },
                    "duration": {
                        "type": "number"
                    },
                    "agenda": {
                        "type": "string"
                    },
                    "settings": {
                        "type": "object"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "text",
                        "tooltip": "The ID of the user creating the webinar",
                        "label": "User Id",
                        "index": 0
                    },
                    "topic": {
                        "type": "text",
                        "tooltip": "The topic or title of the webinar",
                        "label": "Topic",
                        "index": 1
                    },
                    "start_time": {
                        "type": "text",
                        "tooltip": "The start time of the webinar in ISO8601 format",
                        "label": "Start Time",
                        "index": 2
                    },
                    "duration": {
                        "type": "number",
                        "tooltip": "The duration of the webinar in minutes",
                        "label": "Duration",
                        "index": 3
                    },
                    "agenda": {
                        "type": "text",
                        "tooltip": "The agenda or a brief description of the webinar",
                        "label": "Agenda",
                        "index": 4
                    },
                    "settings": {
                        "type": "text",
                        "tooltip": "Additional settings for the webinar (e.g., Q&A options, panelists)",
                        "label": "Settings",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Topic",
                    "value": "topic",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Start Time",
                    "value": "start_time",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Join Url",
                    "value": "join_url",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}