    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:assemblyai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transcriptId": { "type": "string" }
                },
                "required": ["transcriptId"]
            },
            "inspector": {
                "inputs": {
                    "transcriptId": {
                        "type": "text",
                        "index": 1,
                        "label": "Transcript ID",
                        "tooltip": "The id of the transcript to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": []
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
