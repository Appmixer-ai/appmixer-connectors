{
    "name": "appmixer.assemblyai.core.UploadFile",
    "label": "Upload File",
    "description": "Upload an audio or video file from file storage to AssemblyAI and get back an upload URL to pass to Transcribe Audio. The file is streamed, so large recordings are supported. Note: a file uploaded with one API key can only be transcribed with a key from the same project/region.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:assemblyai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": { "type": "string" }
                },
                "required": ["fileId"]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "index": 1,
                        "label": "File",
                        "tooltip": "The audio or video file to upload and transcribe."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "upload_url": { "type": "string", "title": "Upload URL", "example": "https://cdn.assemblyai.com/upload/463ce27f-0922-4ea9-9ce4-3353771c46f2" }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
