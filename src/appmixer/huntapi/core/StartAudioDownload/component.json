{
    "name": "appmixer.huntapi.core.StartAudioDownload",
    "label": "Start Audio Download",
    "description": "Start extracting the audio of a public media URL. Returns a job ID: use Get Download Job until the job completes to get the download link.",
    "author": "HuntAPI <josselin@huntapi.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:huntapi"
    },
    "quota": {
        "manager": "appmixer:huntapi",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    },
                    "audioFormat": {
                        "type": "string"
                    }
                },
                "required": [
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "Media URL",
                        "tooltip": "Public URL of the video or audio."
                    },
                    "audioFormat": {
                        "type": "text",
                        "index": 2,
                        "label": "Audio Format",
                        "tooltip": "Output format, for example <code>mp3</code> (default) or <code>m4a</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "job_id": {
                        "type": "string",
                        "title": "Job ID",
                        "example": "01a1c71d-153b-117e-781c-b8fe35fb9824"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
