{
    "name": "appmixer.prestashop.core.ListOrderStatuses",
    "label": "List Order Statuses",
    "description": "List the order states (statuses) defined in the shop. Used to fill the Order Status dropdown.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:prestashop"
    },
    "quota": {
        "manager": "appmixer:prestashop",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "isSource": {
                    "type": "boolean"
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "result": {
                        "type": "array",
                        "title": "Order Statuses",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Order State ID"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": "4",
                                "name": "Shipped"
                            },
                            {
                                "id": "5",
                                "name": "Delivered"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
