{
    "name": "appmixer.slack.messages.ScheduleMessage",
    "label": "Schedule Message",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Schedule a message to a channel for a future time (up to 120 days ahead). Slack posts it at that time; at most 30 messages can be scheduled to the same channel within 5 minutes.",
    "private": false,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "channels:read",
            "chat:write"
        ]
    },
    "quota": {
        "manager": "appmixer:slack:list",
        "resources": "postMessage",
        "maxWait": 30000,
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channel": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "postAt": {
                        "type": "string"
                    },
                    "blocks": {
                        "type": "string"
                    },
                    "threadTs": {
                        "type": "string"
                    },
                    "replyBroadcast": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "channel",
                    "text",
                    "postAt"
                ]
            },
            "inspector": {
                "inputs": {
                    "channel": {
                        "type": "text",
                        "label": "Channel",
                        "index": 1,
                        "tooltip": "Public or private channel, or a DM channel ID. Select a channel or enter its ID (e.g. C0123456789).",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                            "data": {
                                "transform": "ListChannels#channelsToSelectArray"
                            }
                        }
                    },
                    "text": {
                        "type": "textarea",
                        "label": "Message",
                        "index": 2,
                        "tooltip": "Message text. When Blocks are set, this is the fallback text shown in notifications."
                    },
                    "postAt": {
                        "type": "date-time",
                        "label": "Post At",
                        "index": 3,
                        "tooltip": "When Slack should post the message. Must be in the future and at most 120 days ahead."
                    },
                    "blocks": {
                        "type": "textarea",
                        "label": "Blocks",
                        "index": 4,
                        "tooltip": "Optional Block Kit layout as a JSON array, e.g. [{\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": \"*Hello*\"}}]. Design it in the <a href=\"https://app.slack.com/block-kit-builder\" target=\"_blank\">Block Kit Builder</a>. When blocks are set, Message is the fallback text shown in notifications."
                    },
                    "threadTs": {
                        "type": "text",
                        "label": "Thread Message ID",
                        "index": 5,
                        "tooltip": "Provide another message's ts value to post this message in a thread. Avoid using a reply's ts value; use its parent's value instead."
                    },
                    "replyBroadcast": {
                        "type": "toggle",
                        "label": "Broadcast reply",
                        "index": 6,
                        "tooltip": "Used in conjunction with Thread Message ID: when enabled, the reply is also posted to the channel."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "channel",
                    "scheduled_message_id",
                    "post_at"
                ],
                "properties": {
                    "channel": {
                        "type": "string",
                        "title": "Channel",
                        "example": "C0ABC12345"
                    },
                    "scheduled_message_id": {
                        "type": "string",
                        "title": "Scheduled Message ID",
                        "example": "Q1298393284"
                    },
                    "post_at": {
                        "type": [
                            "string",
                            "integer"
                        ],
                        "title": "Post At",
                        "example": "1737028200"
                    },
                    "message": {
                        "type": "object",
                        "title": "Message",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Message.Type",
                                "example": "delayed_message"
                            },
                            "subtype": {
                                "type": "string",
                                "title": "Message.Subtype",
                                "example": "bot_message"
                            },
                            "text": {
                                "type": "string",
                                "title": "Message.Text",
                                "example": "Standup starts in 15 minutes."
                            },
                            "user": {
                                "type": "string",
                                "title": "Message.User",
                                "example": "U0ABC12345"
                            },
                            "bot_id": {
                                "type": "string",
                                "title": "Message.Bot ID",
                                "example": "B0ABC12345"
                            },
                            "team": {
                                "type": "string",
                                "title": "Message.Team",
                                "example": "T0ABC12345"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
