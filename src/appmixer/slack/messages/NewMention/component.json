{
    "name": "appmixer.slack.messages.NewMention",
    "label": "New Mention",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when someone mentions the Slack app (@app-name) in a channel the app is a member of. Invite the app to the channel first. Requires the app_mention event in the Slack app's event subscriptions.",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "app_mentions:read",
            "channels:read",
            "groups:read"
        ]
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "channelId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "channelId": {
                    "type": "text",
                    "label": "Channel",
                    "index": 1,
                    "tooltip": "Optional. Fire only for mentions in this channel. Leave empty for mentions in any channel the app is in.",
                    "source": {
                        "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                        "data": {
                            "transform": "ListChannels#channelsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "mention",
            "schema": {
                "type": "object",
                "required": [
                    "type",
                    "user",
                    "text",
                    "ts",
                    "channel"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "title": "Event Type",
                        "example": "app_mention"
                    },
                    "user": {
                        "type": "string",
                        "title": "User ID",
                        "example": "U0DEF67890"
                    },
                    "text": {
                        "type": "string",
                        "title": "Text",
                        "example": "<@U0BOT12345> create a ticket for the checkout outage"
                    },
                    "ts": {
                        "type": "string",
                        "title": "Message Timestamp",
                        "example": "1737024600.654321"
                    },
                    "thread_ts": {
                        "type": "string",
                        "title": "Thread Timestamp",
                        "example": "1737024500.111222"
                    },
                    "channel": {
                        "type": "string",
                        "title": "Channel ID",
                        "example": "C0ABC12345"
                    },
                    "team": {
                        "type": "string",
                        "title": "Team ID",
                        "example": "T0ABC12345"
                    },
                    "event_ts": {
                        "type": "string",
                        "title": "Event Timestamp",
                        "example": "1737024600.654321"
                    },
                    "blocks": {
                        "type": "array",
                        "title": "Blocks",
                        "example": [
                            {
                                "type": "rich_text",
                                "block_id": "Xk9pQ"
                            }
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Blocks.Type",
                                    "example": "rich_text"
                                },
                                "block_id": {
                                    "type": "string",
                                    "title": "Blocks.Block ID",
                                    "example": "Xk9pQ"
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
