{
    "name": "appmixer.slack.reactions.NewReaction",
    "label": "New Reaction",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Triggers when someone adds an emoji reaction to a message in a channel you can see, optionally only for one emoji or one channel. Requires the reaction_added event in the Slack app's event subscriptions.",
    "private": false,
    "webhook": true,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "reactions:read",
            "channels:read",
            "groups:read"
        ]
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "reaction": {
                    "type": "string"
                },
                "channelId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "reaction": {
                    "type": "text",
                    "label": "Reaction Name",
                    "index": 1,
                    "tooltip": "Optional. Fire only for this emoji, without colons, e.g. ticket or white_check_mark. Leave empty for any reaction."
                },
                "channelId": {
                    "type": "text",
                    "label": "Channel",
                    "index": 2,
                    "tooltip": "Optional. Fire only for reactions in this channel. Leave empty for any channel.",
                    "source": {
                        "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                        "data": {
                            "transform": "ListChannels#channelsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "reaction",
            "schema": {
                "type": "object",
                "required": [
                    "type",
                    "user",
                    "reaction",
                    "item"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "title": "Event Type",
                        "example": "reaction_added"
                    },
                    "user": {
                        "type": "string",
                        "title": "User ID",
                        "example": "U0DEF67890"
                    },
                    "reaction": {
                        "type": "string",
                        "title": "Reaction Name",
                        "example": "ticket"
                    },
                    "item_user": {
                        "type": "string",
                        "title": "Message Author ID",
                        "example": "U0ABC12345"
                    },
                    "item": {
                        "type": "object",
                        "title": "Item",
                        "required": [
                            "type"
                        ],
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Item.Type",
                                "example": "message"
                            },
                            "channel": {
                                "type": "string",
                                "title": "Item.Channel",
                                "example": "C0ABC12345"
                            },
                            "ts": {
                                "type": "string",
                                "title": "Item.Message Timestamp",
                                "example": "1737024600.333444"
                            }
                        }
                    },
                    "event_ts": {
                        "type": "string",
                        "title": "Event Timestamp",
                        "example": "1737024804.083113"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
