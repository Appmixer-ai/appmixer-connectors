{
    "name": "appmixer.slack.list.FindThreadReplies",
    "label": "Find Thread Replies",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Find the messages of a thread: the parent message first, then its replies, oldest first. Returns at most 1000 messages (one page); Slack returns at most 15 messages and allows one request per minute for apps not approved for the Slack Marketplace.",
    "private": false,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "channels:read",
            "groups:read",
            "channels:history",
            "groups:history"
        ]
    },
    "quota": {
        "manager": "appmixer:slack:list",
        "resources": "request",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channel": {
                        "type": "string"
                    },
                    "ts": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "channel",
                    "ts"
                ]
            },
            "inspector": {
                "inputs": {
                    "channel": {
                        "type": "text",
                        "label": "Channel",
                        "index": 1,
                        "tooltip": "Channel containing the thread. Select a channel or enter its ID (e.g. C0123456789).",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                            "data": {
                                "transform": "ListChannels#channelsToSelectArray"
                            }
                        }
                    },
                    "ts": {
                        "type": "text",
                        "label": "Thread Message ID",
                        "index": 2,
                        "tooltip": "The ts value of the thread's parent message (e.g. 1737024600.333444). A message without replies returns just that message."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 3,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, one item at a time or stream the items to a file. For large datasets, streaming the rows to a file is the most efficient method.",
                        "options": [
                            {
                                "label": "First Found",
                                "value": "first"
                            },
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One at a time",
                                "value": "object"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/slack/list/FindThreadReplies?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/channel": "dummy",
                        "in/ts": "dummy",
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "channel": {
                        "type": "string",
                        "title": "Channel",
                        "example": "C0ABC12345"
                    },
                    "ts": {
                        "type": "string",
                        "title": "Thread Message ID",
                        "example": "1737024600.333444"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
