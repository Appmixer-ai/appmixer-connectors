{
    "name": "appmixer.slack.list.InviteUsersToChannel",
    "label": "Invite Users To Channel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Invite one or more users (up to 1000) to a public or private channel. You must be a member of the channel.",
    "private": false,
    "auth": {
        "service": "appmixer:slack",
        "scope": [
            "channels:write",
            "groups:write",
            "users:read"
        ]
    },
    "quota": {
        "manager": "appmixer:slack:list",
        "resources": "request",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "channel": {
                        "type": "string"
                    },
                    "users": {},
                    "force": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "channel",
                    "users"
                ]
            },
            "inspector": {
                "inputs": {
                    "channel": {
                        "type": "text",
                        "label": "Channel",
                        "index": 1,
                        "tooltip": "Public or private channel to invite the users to. Select a channel or enter its ID (e.g. C0123456789).",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListChannels?outPort=channels",
                            "data": {
                                "transform": "ListChannels#channelsToSelectArray"
                            }
                        }
                    },
                    "users": {
                        "type": "multiselect",
                        "label": "Users",
                        "index": 2,
                        "tooltip": "Users to invite (up to 1000). Select users or map a comma-separated list of user IDs, e.g. from Find User By Email.",
                        "source": {
                            "url": "/component/appmixer/slack/list/ListUsers?outPort=out",
                            "data": {
                                "transform": "./transformers#usersToSelectArray",
                                "messages": {
                                    "in/outputType": "array",
                                    "in/isSource": true
                                }
                            }
                        }
                    },
                    "force": {
                        "type": "toggle",
                        "label": "Skip Invalid Users",
                        "index": 3,
                        "defaultValue": false,
                        "tooltip": "When several users are given, invite the valid ones and skip invalid IDs instead of failing the whole request."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Channel ID",
                        "example": "C0GHI11223"
                    },
                    "name": {
                        "type": "string",
                        "title": "Channel Name",
                        "example": "incident-2041"
                    },
                    "is_channel": {
                        "type": "boolean",
                        "title": "Is Channel",
                        "example": true
                    },
                    "is_group": {
                        "type": "boolean",
                        "title": "Is Group",
                        "example": false
                    },
                    "is_private": {
                        "type": "boolean",
                        "title": "Is Private",
                        "example": false
                    },
                    "is_archived": {
                        "type": "boolean",
                        "title": "Is Archived",
                        "example": false
                    },
                    "is_general": {
                        "type": "boolean",
                        "title": "Is General",
                        "example": false
                    },
                    "is_member": {
                        "type": "boolean",
                        "title": "Is Member",
                        "example": true
                    },
                    "created": {
                        "type": "integer",
                        "title": "Created",
                        "example": 1757493000
                    },
                    "creator": {
                        "type": "string",
                        "title": "Creator",
                        "example": "U0ABC12345"
                    },
                    "name_normalized": {
                        "type": "string",
                        "title": "Name Normalized",
                        "example": "incident-2041"
                    },
                    "topic": {
                        "type": "object",
                        "title": "Topic",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Topic.Value",
                                "example": "Checkout outage"
                            },
                            "creator": {
                                "type": "string",
                                "title": "Topic.Creator",
                                "example": "U0ABC12345"
                            },
                            "last_set": {
                                "type": "integer",
                                "title": "Topic.Last Set",
                                "example": 1757493000
                            }
                        }
                    },
                    "purpose": {
                        "type": "object",
                        "title": "Purpose",
                        "properties": {
                            "value": {
                                "type": "string",
                                "title": "Purpose.Value",
                                "example": "Incident war room"
                            },
                            "creator": {
                                "type": "string",
                                "title": "Purpose.Creator",
                                "example": "U0ABC12345"
                            },
                            "last_set": {
                                "type": "integer",
                                "title": "Purpose.Last Set",
                                "example": 1757493000
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
