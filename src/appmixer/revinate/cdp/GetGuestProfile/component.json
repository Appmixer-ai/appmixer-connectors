{
    "name": "appmixer.revinate.cdp.GetGuestProfile",
    "label": "Get Guest Profile",
    "description": "Get one Rich Guest Profile by its ID: name, contact details with subscription status, loyalty memberships, stay and revenue totals and the IDs of the source profiles it was merged from. Revinate can change the ID of a profile when profiles are merged; the External References identify the guest reliably.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:revinate:cdp"
    },
    "quota": {
        "manager": "appmixer:revinate:cdp",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "profileId": {
                        "type": "string"
                    },
                    "sourceSystemId": {
                        "type": "string"
                    },
                    "accountId": {
                        "type": "string"
                    }
                },
                "required": [
                    "profileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "profileId": {
                        "type": "text",
                        "index": 1,
                        "label": "Profile ID",
                        "tooltip": "The Rich Guest Profile ID, as returned by Find Guest Profiles, Find Reservations or a trigger."
                    },
                    "sourceSystemId": {
                        "type": "text",
                        "index": 2,
                        "label": "Source System ID",
                        "tooltip": "Optional. Sent to Revinate as the sourceSystemId header, to read the profile in the context of one source system (for example your PMS)."
                    },
                    "accountId": {
                        "type": "text",
                        "index": 3,
                        "label": "Account ID",
                        "tooltip": "Read from this Revinate Account ID instead of the one of the connected account. It must be an account your credentials are authorized for, for example one hotel of your chain. Leave empty to use the connected account's Account ID."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "revinate_rich_guest_profile_id"
                ],
                "properties": {
                    "revinate_rich_guest_profile_id": {
                        "type": "string",
                        "title": "Profile ID",
                        "example": "6c31eaa6-d33a-4a8f-a80d-fd18b2af5cc7"
                    },
                    "revinate_rich_guest_profile_url": {
                        "type": "string",
                        "title": "Profile URL",
                        "example": "/guests/13317578/6c31eaa6-d33a-4a8f-a80d-fd18b2af5cc7"
                    },
                    "revinate_last_modified_at": {
                        "type": "string",
                        "title": "Last Modified At",
                        "format": "date-time",
                        "example": "2025-02-04T17:18:21.321Z"
                    },
                    "emails": {
                        "type": "array",
                        "title": "Emails",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "john.doe@example.com"
                        ]
                    },
                    "phones": {
                        "type": "array",
                        "title": "Phones",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "(702)-234-5566"
                        ]
                    },
                    "external_references": {
                        "type": "array",
                        "title": "External References",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "profile_id": {
                                    "account_id": "1928376",
                                    "source_system_profile_id": "4565445",
                                    "source_system_id": 0
                                },
                                "profile_revinate_uuid": "e99a2e9b-5276-4a8f-a639-6088b9203ea0"
                            }
                        ]
                    },
                    "name_salutation": {
                        "type": "string",
                        "title": "Salutation",
                        "example": "Dear Dr."
                    },
                    "name_prefix": {
                        "type": "string",
                        "title": "Name Prefix",
                        "example": "Mr."
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "example": "John"
                    },
                    "middle_name": {
                        "type": "string",
                        "title": "Middle Name",
                        "example": "Lee"
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "example": "Doe"
                    },
                    "name_suffix": {
                        "type": "string",
                        "title": "Name Suffix",
                        "example": "Senior"
                    },
                    "gender": {
                        "type": "string",
                        "title": "Gender",
                        "example": "PROFILE_GENDER_MALE"
                    },
                    "date_of_birth_day": {
                        "type": "integer",
                        "title": "Date Of Birth Day",
                        "example": 10
                    },
                    "date_of_birth_month": {
                        "type": "integer",
                        "title": "Date Of Birth Month",
                        "example": 2
                    },
                    "date_of_birth_year": {
                        "type": "integer",
                        "title": "Date Of Birth Year",
                        "example": 1990
                    },
                    "nationality": {
                        "type": "string",
                        "title": "Nationality",
                        "example": "American"
                    },
                    "company_name": {
                        "type": "string",
                        "title": "Company Name",
                        "example": "ACME Inc."
                    },
                    "vip_status": {
                        "type": "string",
                        "title": "VIP Status",
                        "example": "Regular Guest"
                    },
                    "primary_languages": {
                        "type": "array",
                        "title": "Primary Languages",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "en-US"
                        ]
                    },
                    "contact_info": {
                        "type": "object",
                        "title": "Contact Info",
                        "properties": {
                            "email_addresses": {
                                "type": "array",
                                "title": "Contact Info.Email Addresses",
                                "items": {
                                    "type": "object"
                                },
                                "example": [
                                    {
                                        "email_address_reference": {
                                            "email_address_id": {
                                                "email_address": "john.doe@example.com"
                                            },
                                            "email_address_revinate_uuid": "1226a6d8-d63b-4fd3-932e-26c0914e57f2"
                                        },
                                        "subscription_status_all_sources": {
                                            "subscription_status": "CONTACT_METHOD_SUBSCRIPTION_STATUS_EXPLICIT_CONSENT",
                                            "subscription_source": "CONTACT_METHOD_SUBSCRIPTION_SOURCE_PROPERTY_MANAGEMENT_SYSTEM",
                                            "is_subscription_double_opt_in": false,
                                            "subscription_recorded_at": "2025-02-24T04:18:41.736Z"
                                        }
                                    }
                                ]
                            },
                            "phone_numbers": {
                                "type": "array",
                                "title": "Contact Info.Phone Numbers",
                                "items": {
                                    "type": "object"
                                },
                                "example": [
                                    {
                                        "phone_number_reference": {
                                            "phone_number_id": {
                                                "phone_number": "(702)-234-5566"
                                            },
                                            "phone_number_revinate_uuid": "28ff9160-153b-4445-a89d-12796daab874"
                                        },
                                        "is_primary_messaging": true,
                                        "is_primary_voice": true
                                    }
                                ]
                            },
                            "postal_addresses": {
                                "type": "array",
                                "title": "Contact Info.Postal Addresses",
                                "items": {
                                    "type": "object"
                                },
                                "example": [
                                    {
                                        "postal_address_reference": {
                                            "postal_address_id": {
                                                "line_1": "249 Sullivan St",
                                                "line_2": "Building 3",
                                                "locality": "San Francisco",
                                                "region": "California",
                                                "country": "US",
                                                "postal_code": "94124"
                                            },
                                            "postal_address_revinate_uuid": "f28e17cf-dcee-4e72-a3b2-7468e5a2740a"
                                        },
                                        "is_primary": true
                                    }
                                ]
                            },
                            "primary_geo_location": {
                                "type": "object",
                                "title": "Contact Info.Primary Geo Location",
                                "properties": {
                                    "id": {
                                        "type": "object",
                                        "title": "Contact Info.Primary Geo Location.ID",
                                        "properties": {
                                            "latitude": {
                                                "type": "number",
                                                "title": "Contact Info.Primary Geo Location.ID.Latitude",
                                                "example": 37.774929
                                            },
                                            "longitude": {
                                                "type": "number",
                                                "title": "Contact Info.Primary Geo Location.ID.Longitude",
                                                "example": -122.419418
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "memberships": {
                        "type": "array",
                        "title": "Memberships",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "loyalty_number": "5968788744",
                                "program_code": "Inner Circle",
                                "level_code": "Platinum",
                                "expiration_date_day": 21,
                                "expiration_date_month": 12,
                                "expiration_date_year": 2026
                            }
                        ]
                    },
                    "user_defined_fields": {
                        "type": "array",
                        "title": "User Defined Fields",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "name": "sub_market_segment",
                                "value": "Leisure Domestic"
                            }
                        ]
                    },
                    "room_reservation_number_of_stays": {
                        "type": "integer",
                        "title": "Room Stays",
                        "example": 3
                    },
                    "room_reservation_number_of_valid_stays": {
                        "type": "integer",
                        "title": "Valid Room Stays",
                        "example": 2
                    },
                    "room_reservation_number_of_invalid_stays": {
                        "type": "integer",
                        "title": "Invalid Room Stays",
                        "example": 1
                    },
                    "room_reservation_number_of_nights": {
                        "type": "integer",
                        "title": "Room Nights",
                        "example": 12
                    },
                    "room_reservation_number_of_valid_nights": {
                        "type": "integer",
                        "title": "Valid Room Nights",
                        "example": 9
                    },
                    "room_reservation_number_of_invalid_nights": {
                        "type": "integer",
                        "title": "Invalid Room Nights",
                        "example": 3
                    },
                    "room_reservation_number_of_properties_with_a_stay": {
                        "type": "integer",
                        "title": "Properties With A Stay",
                        "example": 2
                    },
                    "room_reservation_number_of_properties_with_a_valid_stay": {
                        "type": "integer",
                        "title": "Properties With A Valid Stay",
                        "example": 2
                    },
                    "room_reservation_number_of_properties_with_an_invalid_stay": {
                        "type": "integer",
                        "title": "Properties With An Invalid Stay",
                        "example": 1
                    },
                    "room_reservation_revenue_from_rate_in_account_currency_property": {
                        "type": "string",
                        "title": "Room Revenue (Property Currency)",
                        "example": "1200"
                    },
                    "room_reservation_revenue_from_rate_in_account_currency_group": {
                        "type": "string",
                        "title": "Room Revenue (Group Currency)",
                        "example": "1200"
                    },
                    "spa_reservation_number_of_treatments": {
                        "type": "integer",
                        "title": "Spa Treatments",
                        "example": 1
                    },
                    "spa_reservation_revenue_from_rate_in_account_currency_property": {
                        "type": "string",
                        "title": "Spa Revenue (Property Currency)",
                        "example": "150"
                    },
                    "spa_reservation_revenue_from_rate_in_account_currency_group": {
                        "type": "string",
                        "title": "Spa Revenue (Group Currency)",
                        "example": "150"
                    },
                    "golf_reservation_number_of_tee_times": {
                        "type": "integer",
                        "title": "Golf Tee Times",
                        "example": 2
                    },
                    "golf_reservation_revenue_from_rate_in_account_currency_property": {
                        "type": "string",
                        "title": "Golf Revenue (Property Currency)",
                        "example": "350"
                    },
                    "golf_reservation_revenue_from_rate_in_account_currency_group": {
                        "type": "string",
                        "title": "Golf Revenue (Group Currency)",
                        "example": "350"
                    },
                    "restaurant_reservation_number_of_reservations": {
                        "type": "integer",
                        "title": "Restaurant Reservations",
                        "example": 4
                    },
                    "restaurant_reservation_revenue_in_account_currency_property": {
                        "type": "string",
                        "title": "Restaurant Revenue (Property Currency)",
                        "example": "800"
                    },
                    "restaurant_reservation_revenue_in_account_currency_group": {
                        "type": "string",
                        "title": "Restaurant Revenue (Group Currency)",
                        "example": "800"
                    },
                    "total_revenue_in_account_currency_property": {
                        "type": "string",
                        "title": "Total Revenue (Property Currency)",
                        "example": "3500"
                    },
                    "total_revenue_in_account_currency_group": {
                        "type": "string",
                        "title": "Total Revenue (Group Currency)",
                        "example": "3500"
                    },
                    "loyalty_tier_id": {
                        "type": "string",
                        "title": "Loyalty Tier ID",
                        "example": "14855987"
                    },
                    "loyalty_tier_association_date": {
                        "type": "string",
                        "title": "Loyalty Tier Association Date",
                        "format": "date-time",
                        "example": "2025-02-27T00:38:02.019Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
