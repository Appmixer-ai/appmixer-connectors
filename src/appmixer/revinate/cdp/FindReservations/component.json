{
    "name": "appmixer.revinate.cdp.FindReservations",
    "label": "Find Reservations",
    "description": "Find room, spa, restaurant and golf reservations of a Revinate account by guest profile or by the time they were last modified. Returns at most one page of the API, requested with a page size of 100; narrow the filters, for example the modification period, if the reservation you need is not among them.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:revinate:cdp"
    },
    "quota": {
        "manager": "appmixer:revinate:cdp",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "profileIds": {
                        "type": "string"
                    },
                    "modifiedFrom": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "modifiedTo": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "reservationTypes": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "accountId": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "profileIds": {
                        "type": "text",
                        "index": 1,
                        "label": "Profile IDs",
                        "tooltip": "Find only reservations of these Rich Guest Profiles. One Profile ID, or several separated by commas."
                    },
                    "modifiedFrom": {
                        "type": "date-time",
                        "index": 2,
                        "label": "Modified From",
                        "tooltip": "Find only reservations that were last modified from this moment on."
                    },
                    "modifiedTo": {
                        "type": "date-time",
                        "index": 3,
                        "label": "Modified To",
                        "tooltip": "Find only reservations that were last modified up to this moment."
                    },
                    "reservationTypes": {
                        "type": "multiselect",
                        "index": 4,
                        "label": "Reservation Types",
                        "tooltip": "Return only reservations of these types. Leave empty for all types.",
                        "options": [
                            {
                                "label": "Room",
                                "value": "room"
                            },
                            {
                                "label": "Spa",
                                "value": "spa"
                            },
                            {
                                "label": "Restaurant",
                                "value": "restaurant"
                            },
                            {
                                "label": "Golf",
                                "value": "golf"
                            }
                        ]
                    },
                    "accountId": {
                        "type": "text",
                        "index": 5,
                        "label": "Account ID",
                        "tooltip": "Read from this Revinate Account ID instead of the one of the connected account. It must be an account your credentials are authorized for, for example one hotel of your chain. Leave empty to use the connected account's Account ID."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 6,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/revinate/cdp/FindReservations?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": []
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
