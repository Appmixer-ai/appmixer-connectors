{
    "name": "appmixer.revinate.reputation.FindReviews",
    "label": "Find Reviews",
    "description": "Find guest reviews and survey responses of all your hotels or of one hotel, by rating, feedback, management response, review site, language and date. Returns at most 100 reviews (one page); narrow the filters, for example the date range, if the review you need is not among them. Review content from this API is licensed for analysis, not for public display.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:revinate:reputation"
    },
    "quota": {
        "manager": "appmixer:revinate:reputation",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string"
                    },
                    "ratings": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "feedback": {
                        "type": "string",
                        "enum": [
                            "positive",
                            "neutral",
                            "negative"
                        ]
                    },
                    "response": {
                        "type": "string",
                        "enum": [
                            "none",
                            "posted"
                        ]
                    },
                    "reviewSiteSlug": {
                        "type": "string"
                    },
                    "languageSlug": {
                        "type": "string"
                    },
                    "collectedFrom": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "collectedTo": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedFrom": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedTo": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sortBy": {
                        "type": "string",
                        "enum": [
                            "dateCollected",
                            "dateReview",
                            "updatedAt",
                            "rating"
                        ]
                    },
                    "sortDirection": {
                        "type": "string",
                        "enum": [
                            "DESC",
                            "ASC"
                        ],
                        "default": "DESC"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "hotelId": {
                        "type": "text",
                        "index": 1,
                        "label": "Hotel",
                        "tooltip": "Find only reviews of this hotel. Pick a hotel, or type its Hotel ID. Leave empty for all hotels of the connected account.",
                        "source": {
                            "url": "/component/appmixer/revinate/reputation/FindHotels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindHotels#toSelectArray"
                            }
                        }
                    },
                    "ratings": {
                        "type": "multiselect",
                        "index": 2,
                        "label": "Ratings",
                        "tooltip": "Find only reviews with one of these ratings. Leave empty for all ratings.",
                        "options": [
                            {
                                "label": "1 star",
                                "value": "1"
                            },
                            {
                                "label": "2 stars",
                                "value": "2"
                            },
                            {
                                "label": "3 stars",
                                "value": "3"
                            },
                            {
                                "label": "4 stars",
                                "value": "4"
                            },
                            {
                                "label": "5 stars",
                                "value": "5"
                            }
                        ]
                    },
                    "feedback": {
                        "type": "select",
                        "index": 3,
                        "label": "Feedback",
                        "tooltip": "Find only reviews Revinate classifies as positive, neutral or negative. Leave empty for all.",
                        "options": [
                            {
                                "label": "Positive",
                                "value": "positive"
                            },
                            {
                                "label": "Neutral",
                                "value": "neutral"
                            },
                            {
                                "label": "Negative",
                                "value": "negative"
                            }
                        ]
                    },
                    "response": {
                        "type": "select",
                        "index": 4,
                        "label": "Management Response",
                        "tooltip": "Find only reviews that have, or do not have, a management response. Leave empty for all.",
                        "options": [
                            {
                                "label": "No response yet",
                                "value": "none"
                            },
                            {
                                "label": "Response posted",
                                "value": "posted"
                            }
                        ]
                    },
                    "reviewSiteSlug": {
                        "type": "text",
                        "index": 5,
                        "label": "Review Site",
                        "tooltip": "Find only reviews from this review site. Pick a site, or type its slug, for example tripadvisor.",
                        "source": {
                            "url": "/component/appmixer/revinate/reputation/ListReviewSites?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListReviewSites#toSelectArray"
                            }
                        }
                    },
                    "languageSlug": {
                        "type": "text",
                        "index": 6,
                        "label": "Language",
                        "tooltip": "Find only reviews written in this language. Pick a language, or type its slug, for example en.",
                        "source": {
                            "url": "/component/appmixer/revinate/reputation/ListLanguages?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "collectedFrom": {
                        "type": "date-time",
                        "index": 7,
                        "label": "Collected From",
                        "tooltip": "Find only reviews Revinate collected from this moment on."
                    },
                    "collectedTo": {
                        "type": "date-time",
                        "index": 8,
                        "label": "Collected To",
                        "tooltip": "Find only reviews Revinate collected up to this moment."
                    },
                    "updatedFrom": {
                        "type": "date-time",
                        "index": 9,
                        "label": "Updated From",
                        "tooltip": "Find only reviews that changed from this moment on, for example because a management response was posted."
                    },
                    "updatedTo": {
                        "type": "date-time",
                        "index": 10,
                        "label": "Updated To",
                        "tooltip": "Find only reviews that changed up to this moment."
                    },
                    "sortBy": {
                        "type": "select",
                        "index": 11,
                        "label": "Sort By",
                        "tooltip": "Sort the reviews by this field. Leave empty for Revinate's own order. Revinate sorts only for API keys that are enabled for sorting and answers with an error otherwise.",
                        "options": [
                            {
                                "label": "Date collected",
                                "value": "dateCollected"
                            },
                            {
                                "label": "Review date",
                                "value": "dateReview"
                            },
                            {
                                "label": "Updated at",
                                "value": "updatedAt"
                            },
                            {
                                "label": "Rating",
                                "value": "rating"
                            }
                        ]
                    },
                    "sortDirection": {
                        "type": "select",
                        "index": 12,
                        "label": "Sort Direction",
                        "tooltip": "Used together with Sort By.",
                        "defaultValue": "DESC",
                        "options": [
                            {
                                "label": "Descending (newest or highest first)",
                                "value": "DESC"
                            },
                            {
                                "label": "Ascending (oldest or lowest first)",
                                "value": "ASC"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "index": 13,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/revinate/reputation/FindReviews?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": []
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
