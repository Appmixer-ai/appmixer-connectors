{
    "name": "appmixer.revinate.reputation.NewReview",
    "label": "New Review",
    "description": "Triggers when Revinate collects a new guest review or survey response for your hotels. Revinate has no webhooks, so the reviews are polled: every 15 minutes by default, up to 1000 reviews per check. Reviews that existed before the flow was started do not trigger. Review content from this API is licensed for analysis, not for public display.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "appmixer:revinate:reputation"
    },
    "quota": {
        "manager": "appmixer:revinate:reputation",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "hotelId": {
                    "type": "string"
                },
                "ratings": {
                    "type": [
                        "array",
                        "string"
                    ]
                },
                "feedback": {
                    "type": "string",
                    "enum": [
                        "positive",
                        "neutral",
                        "negative"
                    ]
                },
                "response": {
                    "type": "string",
                    "enum": [
                        "none",
                        "posted"
                    ]
                },
                "reviewSiteSlug": {
                    "type": "string"
                },
                "languageSlug": {
                    "type": "string"
                },
                "pollingInterval": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440,
                    "default": 15
                }
            }
        },
        "inspector": {
            "inputs": {
                "hotelId": {
                    "type": "text",
                    "index": 1,
                    "label": "Hotel",
                    "tooltip": "Watch only reviews of this hotel. Pick a hotel, or type its Hotel ID. Leave empty to watch all hotels of the connected account.",
                    "source": {
                        "url": "/component/appmixer/revinate/reputation/FindHotels?outPort=out",
                        "data": {
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./FindHotels#toSelectArray"
                        }
                    }
                },
                "ratings": {
                    "type": "multiselect",
                    "index": 2,
                    "label": "Ratings",
                    "tooltip": "Trigger for only reviews with one of these ratings. Leave empty for all ratings.",
                    "options": [
                        {
                            "label": "1 star",
                            "value": "1"
                        },
                        {
                            "label": "2 stars",
                            "value": "2"
                        },
                        {
                            "label": "3 stars",
                            "value": "3"
                        },
                        {
                            "label": "4 stars",
                            "value": "4"
                        },
                        {
                            "label": "5 stars",
                            "value": "5"
                        }
                    ]
                },
                "feedback": {
                    "type": "select",
                    "index": 3,
                    "label": "Feedback",
                    "tooltip": "Trigger for only reviews Revinate classifies as positive, neutral or negative. Leave empty for all.",
                    "options": [
                        {
                            "label": "Positive",
                            "value": "positive"
                        },
                        {
                            "label": "Neutral",
                            "value": "neutral"
                        },
                        {
                            "label": "Negative",
                            "value": "negative"
                        }
                    ]
                },
                "response": {
                    "type": "select",
                    "index": 4,
                    "label": "Management Response",
                    "tooltip": "Trigger for only reviews that have, or do not have, a management response. Leave empty for all.",
                    "options": [
                        {
                            "label": "No response yet",
                            "value": "none"
                        },
                        {
                            "label": "Response posted",
                            "value": "posted"
                        }
                    ]
                },
                "reviewSiteSlug": {
                    "type": "text",
                    "index": 5,
                    "label": "Review Site",
                    "tooltip": "Trigger for only reviews from this review site. Pick a site, or type its slug, for example tripadvisor.",
                    "source": {
                        "url": "/component/appmixer/revinate/reputation/ListReviewSites?outPort=out",
                        "data": {
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListReviewSites#toSelectArray"
                        }
                    }
                },
                "languageSlug": {
                    "type": "text",
                    "index": 6,
                    "label": "Language",
                    "tooltip": "Trigger for only reviews written in this language. Pick a language, or type its slug, for example en.",
                    "source": {
                        "url": "/component/appmixer/revinate/reputation/ListLanguages?outPort=out",
                        "data": {
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListLanguages#toSelectArray"
                        }
                    }
                },
                "pollingInterval": {
                    "type": "number",
                    "index": 7,
                    "label": "Check Every (Minutes)",
                    "defaultValue": 15,
                    "tooltip": "How often Revinate is asked for changes, 1 to 1440 minutes. Revinate has no webhooks, and its API quota is agreed per customer, so keep this as long as your flow allows."
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "links"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Review ID",
                        "example": 482930112
                    },
                    "hotelId": {
                        "type": "integer",
                        "title": "Hotel ID",
                        "example": 10470
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "example": "Lovely stay near the old town"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "The room was spotless and the front desk team went out of their way to help us."
                    },
                    "author": {
                        "type": "string",
                        "title": "Author",
                        "example": "Jane D"
                    },
                    "authorLocation": {
                        "type": "string",
                        "title": "Author Location",
                        "example": "Portland, Oregon"
                    },
                    "dateReview": {
                        "type": "integer",
                        "title": "Review Date (Unix Time)",
                        "example": 1795305600
                    },
                    "dateCollected": {
                        "type": "integer",
                        "title": "Date Collected (Unix Time)",
                        "example": 1795392000
                    },
                    "updatedAt": {
                        "type": "integer",
                        "title": "Updated At (Unix Time)",
                        "example": 1795478400
                    },
                    "rating": {
                        "type": "number",
                        "title": "Rating",
                        "example": 4
                    },
                    "nps": {
                        "type": "integer",
                        "title": "NPS",
                        "example": 9
                    },
                    "reviewSite": {
                        "type": "object",
                        "title": "Review Site",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Review Site.ID",
                                "example": 3
                            },
                            "name": {
                                "type": "string",
                                "title": "Review Site.Name",
                                "example": "TripAdvisor"
                            },
                            "mainUrl": {
                                "type": "string",
                                "title": "Review Site.Main URL",
                                "example": "http://www.tripadvisor.com"
                            },
                            "slug": {
                                "type": "string",
                                "title": "Review Site.Slug",
                                "example": "tripadvisor"
                            },
                            "links": {
                                "type": "array",
                                "title": "Review Site.Links",
                                "items": {
                                    "type": "object"
                                },
                                "example": [
                                    {
                                        "rel": "self",
                                        "href": "https://porter.revinate.com/reviewsites/3"
                                    }
                                ]
                            }
                        }
                    },
                    "language": {
                        "type": "object",
                        "title": "Language",
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Language.ID",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "title": "Language.Name",
                                "example": "English"
                            },
                            "englishName": {
                                "type": "string",
                                "title": "Language.English Name",
                                "example": "English"
                            },
                            "slug": {
                                "type": "string",
                                "title": "Language.Slug",
                                "example": "en"
                            },
                            "links": {
                                "type": "array",
                                "title": "Language.Links",
                                "items": {
                                    "type": "object"
                                },
                                "example": [
                                    {
                                        "rel": "self",
                                        "href": "https://porter.revinate.com/languages/1"
                                    }
                                ]
                            }
                        }
                    },
                    "crawledUrl": {
                        "type": "string",
                        "title": "Review URL",
                        "example": "https://www.tripadvisor.com/ShowUserReviews-g60950-d123456-r482930112.html"
                    },
                    "subratings": {
                        "type": "object",
                        "title": "Subratings",
                        "example": {
                            "Cleanliness": 5,
                            "Service": 4,
                            "Rooms": 4
                        }
                    },
                    "tripType": {
                        "type": "string",
                        "title": "Trip Type",
                        "example": "Couples"
                    },
                    "guestStay": {
                        "type": "object",
                        "title": "Guest Stay",
                        "properties": {
                            "checkinDate": {
                                "type": "string",
                                "title": "Guest Stay.Check-in Date",
                                "format": "date-time",
                                "example": "2026-11-12T00:00:00.000Z"
                            },
                            "checkoutDate": {
                                "type": "string",
                                "title": "Guest Stay.Check-out Date",
                                "format": "date-time",
                                "example": "2026-11-15T00:00:00.000Z"
                            },
                            "loyaltyId": {
                                "type": "string",
                                "title": "Guest Stay.Loyalty ID",
                                "example": "5968788744"
                            },
                            "confirmationCode": {
                                "type": "string",
                                "title": "Guest Stay.Confirmation Code",
                                "example": "R589665"
                            },
                            "bookingChannel": {
                                "type": "string",
                                "title": "Guest Stay.Booking Channel",
                                "example": "Direct"
                            },
                            "roomType": {
                                "type": "string",
                                "title": "Guest Stay.Room Type",
                                "example": "DLX"
                            },
                            "roomNumber": {
                                "type": "string",
                                "title": "Guest Stay.Room Number",
                                "example": "409"
                            },
                            "rate": {
                                "type": "string",
                                "title": "Guest Stay.Rate",
                                "example": "189.00"
                            },
                            "rateCurrency": {
                                "type": "string",
                                "title": "Guest Stay.Rate Currency",
                                "example": "USD"
                            },
                            "ratePlanCode": {
                                "type": "string",
                                "title": "Guest Stay.Rate Plan Code",
                                "example": "BAR"
                            },
                            "checkedInBy": {
                                "type": "string",
                                "title": "Guest Stay.Checked In By",
                                "example": "mlee"
                            },
                            "checkedOutBy": {
                                "type": "string",
                                "title": "Guest Stay.Checked Out By",
                                "example": "tnguyen"
                            },
                            "groupName": {
                                "type": "string",
                                "title": "Guest Stay.Group Name",
                                "example": "Smith Wedding"
                            },
                            "guest": {
                                "type": "object",
                                "title": "Guest Stay.Guest",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Title",
                                        "example": "Ms."
                                    },
                                    "firstName": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.First Name",
                                        "example": "Jane"
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Last Name",
                                        "example": "Doe"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Phone",
                                        "example": "+1 503 555 0142"
                                    },
                                    "email": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Email",
                                        "example": "jane.doe@example.com"
                                    },
                                    "address": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Address",
                                        "example": "249 Sullivan St"
                                    },
                                    "address2": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Address 2",
                                        "example": "Apt 3"
                                    },
                                    "city": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.City",
                                        "example": "Portland"
                                    },
                                    "state": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.State",
                                        "example": "OR"
                                    },
                                    "country": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Country",
                                        "example": "US"
                                    },
                                    "postalCode": {
                                        "type": "string",
                                        "title": "Guest Stay.Guest.Postal Code",
                                        "example": "97205"
                                    },
                                    "links": {
                                        "type": "array",
                                        "title": "Guest Stay.Guest.Links",
                                        "items": {
                                            "type": "object"
                                        },
                                        "example": []
                                    }
                                }
                            },
                            "links": {
                                "type": "array",
                                "title": "Guest Stay.Links",
                                "items": {
                                    "type": "object"
                                },
                                "example": []
                            }
                        }
                    },
                    "surveyTopics": {
                        "type": "array",
                        "title": "Survey Topics",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "name": "Overall",
                                "questionAnswers": [
                                    {
                                        "question": {
                                            "name": "How likely are you to recommend us?",
                                            "type": "NPS"
                                        },
                                        "ratingAnswer": 9
                                    }
                                ]
                            }
                        ]
                    },
                    "response": {
                        "type": "object",
                        "title": "Response",
                        "properties": {
                            "body": {
                                "type": "string",
                                "title": "Response.Body",
                                "example": "Thank you for staying with us, Jane. We hope to welcome you back soon."
                            },
                            "author": {
                                "type": "string",
                                "title": "Response.Author",
                                "example": "General Manager"
                            },
                            "date": {
                                "type": "integer",
                                "title": "Response.Date (Unix Time)",
                                "example": 1795478400
                            }
                        }
                    },
                    "links": {
                        "type": "array",
                        "title": "Links",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "rel": "self",
                                "href": "https://porter.revinate.com/reviews/482930112"
                            },
                            {
                                "rel": "hotel",
                                "href": "https://porter.revinate.com/hotels/10470"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
