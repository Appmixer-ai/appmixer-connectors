{
    "name": "appmixer.revinate.reputation.GetSurveyEmailStats",
    "label": "Get Survey Email Stats",
    "description": "Get the statistics of the guest survey e-mails of one hotel for a period: sent, delivered, opens, clicks, bounces, spam reports and unsubscribes.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:revinate:reputation"
    },
    "quota": {
        "manager": "appmixer:revinate:reputation",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "hotelId"
                ]
            },
            "inspector": {
                "inputs": {
                    "hotelId": {
                        "type": "text",
                        "index": 1,
                        "label": "Hotel",
                        "tooltip": "Pick a hotel, or type its Hotel ID.",
                        "source": {
                            "url": "/component/appmixer/revinate/reputation/FindHotels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindHotels#toSelectArray"
                            }
                        }
                    },
                    "startDate": {
                        "type": "date-time",
                        "index": 2,
                        "label": "Start Date",
                        "tooltip": "The start of the period. Leave Start Date and End Date empty for Revinate's default period."
                    },
                    "endDate": {
                        "type": "date-time",
                        "index": 3,
                        "label": "End Date",
                        "tooltip": "The end of the period. Defaults to now when only Start Date is set."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "requests": {
                        "type": "integer",
                        "title": "Requests",
                        "example": 520
                    },
                    "sent": {
                        "type": "integer",
                        "title": "Sent",
                        "example": 512
                    },
                    "delivered": {
                        "type": "integer",
                        "title": "Delivered",
                        "example": 498
                    },
                    "uniqueOpens": {
                        "type": "integer",
                        "title": "Unique Opens",
                        "example": 231
                    },
                    "uniqueViews": {
                        "type": "integer",
                        "title": "Unique Views",
                        "example": 120
                    },
                    "uniqueClicks": {
                        "type": "integer",
                        "title": "Unique Clicks",
                        "example": 87
                    },
                    "bounces": {
                        "type": "integer",
                        "title": "Bounces",
                        "example": 9
                    },
                    "bounceDrops": {
                        "type": "integer",
                        "title": "Bounce Drops",
                        "example": 3
                    },
                    "invalidEmails": {
                        "type": "integer",
                        "title": "Invalid Emails",
                        "example": 2
                    },
                    "spamReports": {
                        "type": "integer",
                        "title": "Spam Reports",
                        "example": 0
                    },
                    "unsubscribes": {
                        "type": "integer",
                        "title": "Unsubscribes",
                        "example": 4
                    },
                    "links": {
                        "type": "array",
                        "title": "Links",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "rel": "self",
                                "href": "https://porter.revinate.com/hotels/10470/surveyemailstats?date=1792713600..1795392000"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
