{
    "name": "appmixer.revinate.reputation.GetHotel",
    "label": "Get Hotel",
    "description": "Get one hotel by its ID: name, address, website, TripAdvisor ID and account type.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:revinate:reputation"
    },
    "quota": {
        "manager": "appmixer:revinate:reputation",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "hotelId": {
                        "type": "string"
                    }
                },
                "required": [
                    "hotelId"
                ]
            },
            "inspector": {
                "inputs": {
                    "hotelId": {
                        "type": "text",
                        "index": 1,
                        "label": "Hotel",
                        "tooltip": "Pick a hotel, or type its Hotel ID.",
                        "source": {
                            "url": "/component/appmixer/revinate/reputation/FindHotels?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./FindHotels#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "links"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Hotel ID",
                        "example": 10470
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Harbor View Hotel"
                    },
                    "slug": {
                        "type": "string",
                        "title": "Slug",
                        "example": "harbor-view-hotel"
                    },
                    "logo": {
                        "type": "string",
                        "title": "Logo",
                        "example": "https://example.com/harbor-view/logo.png"
                    },
                    "url": {
                        "type": "string",
                        "title": "Website",
                        "example": "https://www.harborview.example.com"
                    },
                    "address1": {
                        "type": "string",
                        "title": "Address 1",
                        "example": "12 Quay Street"
                    },
                    "address2": {
                        "type": "string",
                        "title": "Address 2",
                        "example": "Suite 4"
                    },
                    "city": {
                        "type": "string",
                        "title": "City",
                        "example": "Portland"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "OR"
                    },
                    "postalCode": {
                        "type": "string",
                        "title": "Postal Code",
                        "example": "97205"
                    },
                    "country": {
                        "type": "string",
                        "title": "Country",
                        "example": "US"
                    },
                    "tripAdvisorId": {
                        "type": "integer",
                        "title": "TripAdvisor ID",
                        "example": 123456
                    },
                    "revinatePurchaseUri": {
                        "type": "string",
                        "title": "Revinate Purchase URI",
                        "example": "https://www.revinate.com/purchase/harbor-view-hotel"
                    },
                    "revinateLoginUri": {
                        "type": "string",
                        "title": "Revinate Login URI",
                        "example": "https://app.revinate.com/login"
                    },
                    "accountType": {
                        "type": "string",
                        "title": "Account Type",
                        "example": "CUSTOMER"
                    },
                    "links": {
                        "type": "array",
                        "title": "Links",
                        "items": {
                            "type": "object"
                        },
                        "example": [
                            {
                                "rel": "self",
                                "href": "https://porter.revinate.com/hotels/10470"
                            },
                            {
                                "rel": "reviews",
                                "href": "https://porter.revinate.com/hotels/10470/reviews{?page,size,sort}",
                                "templated": true
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
