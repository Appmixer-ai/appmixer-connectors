{
    "name": "appmixer.todoist.core.GetProject",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a project by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "select",
                        "label": "Project",
                        "tooltip": "The project to retrieve.",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color"
                    },
                    "parent_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Parent ID"
                    },
                    "order": {
                        "type": "integer",
                        "title": "Order"
                    },
                    "comment_count": {
                        "type": "integer",
                        "title": "Comment Count"
                    },
                    "is_shared": {
                        "type": "boolean",
                        "title": "Is Shared"
                    },
                    "is_favorite": {
                        "type": "boolean",
                        "title": "Is Favorite"
                    },
                    "is_inbox_project": {
                        "type": "boolean",
                        "title": "Is Inbox Project"
                    },
                    "is_team_inbox": {
                        "type": "boolean",
                        "title": "Is Team Inbox"
                    },
                    "view_style": {
                        "type": "string",
                        "title": "View Style"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL"
                    }
                },
                "example": {
                    "id": "2365437921",
                    "name": "Marketing Campaign",
                    "color": "blue",
                    "parent_id": "2365437900",
                    "order": 1,
                    "comment_count": 0,
                    "is_shared": false,
                    "is_favorite": true,
                    "is_inbox_project": false,
                    "is_team_inbox": false,
                    "view_style": "list",
                    "url": "https://app.todoist.com/app/project/abc123"
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
