{
    "name": "appmixer.todoist.core.DeleteLabel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Delete a label.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "labelId": {
                        "type": "string"
                    }
                },
                "required": [
                    "labelId"
                ]
            },
            "inspector": {
                "inputs": {
                    "labelId": {
                        "type": "text",
                        "label": "Label ID",
                        "tooltip": "The ID of the label to delete.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}