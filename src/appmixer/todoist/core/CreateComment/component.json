{
    "name": "appmixer.todoist.core.CreateComment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new comment on a task or project.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "string"
                    },
                    "taskId": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "content": {
                        "type": "textarea",
                        "label": "Content",
                        "tooltip": "The content of the comment. May contain markdown-formatted text and hyperlinks.",
                        "index": 1
                    },
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "tooltip": "The ID of the task to comment on. Either Task ID or Project ID is required.",
                        "index": 2
                    },
                    "projectId": {
                        "type": "select",
                        "label": "Project",
                        "tooltip": "The project to comment on. Either Task ID or Project ID is required.",
                        "index": 3,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "task_id": {
                        "type": "string",
                        "title": "Task ID"
                    },
                    "project_id": {
                        "type": "string",
                        "title": "Project ID"
                    },
                    "posted_at": {
                        "type": "string",
                        "title": "Posted At"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content"
                    },
                    "attachment": {
                        "type": "object",
                        "title": "Attachment",
                        "properties": {
                            "file_name": {
                                "type": "string",
                                "title": "Attachment File Name"
                            },
                            "file_type": {
                                "type": "string",
                                "title": "Attachment File Type"
                            },
                            "file_url": {
                                "type": "string",
                                "title": "Attachment File URL"
                            },
                            "resource_type": {
                                "type": "string",
                                "title": "Attachment Resource Type"
                            }
                        }
                    }
                },
                "example": {
                    "id": "3947969952",
                    "task_id": "9907445074",
                    "project_id": "2365437921",
                    "posted_at": "2026-01-12T08:02:29Z",
                    "content": "Please review this section",
                    "attachment": {
                        "file_name": "report.pdf",
                        "file_type": "application/pdf",
                        "file_url": "https://cdn.todoist.com/attachments/report.pdf",
                        "resource_type": "file"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
