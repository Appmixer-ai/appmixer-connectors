{
    "name": "appmixer.todoist.core.CreateLabel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new personal label.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "order": {
                        "type": "integer"
                    },
                    "color": {
                        "type": "string"
                    },
                    "isFavorite": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "The name of the label.",
                        "index": 1
                    },
                    "order": {
                        "type": "number",
                        "label": "Order",
                        "tooltip": "The order of the label. Defines the position of the label among all labels.",
                        "index": 2
                    },
                    "color": {
                        "type": "select",
                        "label": "Color",
                        "tooltip": "The color of the label.",
                        "index": 3,
                        "options": [
                            {
                                "label": "Berry Red",
                                "value": "berry_red"
                            },
                            {
                                "label": "Red",
                                "value": "red"
                            },
                            {
                                "label": "Orange",
                                "value": "orange"
                            },
                            {
                                "label": "Yellow",
                                "value": "yellow"
                            },
                            {
                                "label": "Olive Green",
                                "value": "olive_green"
                            },
                            {
                                "label": "Lime Green",
                                "value": "lime_green"
                            },
                            {
                                "label": "Green",
                                "value": "green"
                            },
                            {
                                "label": "Mint Green",
                                "value": "mint_green"
                            },
                            {
                                "label": "Teal",
                                "value": "teal"
                            },
                            {
                                "label": "Sky Blue",
                                "value": "sky_blue"
                            },
                            {
                                "label": "Light Blue",
                                "value": "light_blue"
                            },
                            {
                                "label": "Blue",
                                "value": "blue"
                            },
                            {
                                "label": "Grape",
                                "value": "grape"
                            },
                            {
                                "label": "Violet",
                                "value": "violet"
                            },
                            {
                                "label": "Lavender",
                                "value": "lavender"
                            },
                            {
                                "label": "Magenta",
                                "value": "magenta"
                            },
                            {
                                "label": "Salmon",
                                "value": "salmon"
                            },
                            {
                                "label": "Charcoal",
                                "value": "charcoal"
                            },
                            {
                                "label": "Grey",
                                "value": "grey"
                            },
                            {
                                "label": "Taupe",
                                "value": "taupe"
                            }
                        ]
                    },
                    "isFavorite": {
                        "type": "toggle",
                        "label": "Is Favorite",
                        "tooltip": "Whether the label is marked as a favorite.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color"
                    },
                    "order": {
                        "type": "integer",
                        "title": "Order"
                    },
                    "is_favorite": {
                        "type": "boolean",
                        "title": "Is Favorite"
                    }
                },
                "example": {
                    "id": "2182738508",
                    "name": "Work",
                    "color": "blue",
                    "order": 1,
                    "is_favorite": true
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
