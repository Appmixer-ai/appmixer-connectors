{
    "name": "appmixer.todoist.core.CreateProject",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new project in Todoist.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "color": {
                        "type": "string"
                    },
                    "isFavorite": {
                        "type": "boolean"
                    },
                    "viewStyle": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "The name of the project.",
                        "index": 1
                    },
                    "parentId": {
                        "type": "select",
                        "label": "Parent Project",
                        "tooltip": "The parent project to create under.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    },
                    "color": {
                        "type": "select",
                        "label": "Color",
                        "tooltip": "The color of the project.",
                        "index": 3,
                        "options": [
                            {
                                "label": "Berry Red",
                                "value": "berry_red"
                            },
                            {
                                "label": "Red",
                                "value": "red"
                            },
                            {
                                "label": "Orange",
                                "value": "orange"
                            },
                            {
                                "label": "Yellow",
                                "value": "yellow"
                            },
                            {
                                "label": "Olive Green",
                                "value": "olive_green"
                            },
                            {
                                "label": "Lime Green",
                                "value": "lime_green"
                            },
                            {
                                "label": "Green",
                                "value": "green"
                            },
                            {
                                "label": "Mint Green",
                                "value": "mint_green"
                            },
                            {
                                "label": "Teal",
                                "value": "teal"
                            },
                            {
                                "label": "Sky Blue",
                                "value": "sky_blue"
                            },
                            {
                                "label": "Light Blue",
                                "value": "light_blue"
                            },
                            {
                                "label": "Blue",
                                "value": "blue"
                            },
                            {
                                "label": "Grape",
                                "value": "grape"
                            },
                            {
                                "label": "Violet",
                                "value": "violet"
                            },
                            {
                                "label": "Lavender",
                                "value": "lavender"
                            },
                            {
                                "label": "Magenta",
                                "value": "magenta"
                            },
                            {
                                "label": "Salmon",
                                "value": "salmon"
                            },
                            {
                                "label": "Charcoal",
                                "value": "charcoal"
                            },
                            {
                                "label": "Grey",
                                "value": "grey"
                            },
                            {
                                "label": "Taupe",
                                "value": "taupe"
                            }
                        ]
                    },
                    "isFavorite": {
                        "type": "toggle",
                        "label": "Is Favorite",
                        "tooltip": "Whether the project is marked as a favorite.",
                        "index": 4
                    },
                    "viewStyle": {
                        "type": "select",
                        "label": "View Style",
                        "tooltip": "The view style for the project.",
                        "index": 5,
                        "options": [
                            {
                                "label": "List",
                                "value": "list"
                            },
                            {
                                "label": "Board",
                                "value": "board"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "color": {
                        "type": "string",
                        "title": "Color"
                    },
                    "parent_id": {
                        "type": "string",
                        "title": "Parent ID"
                    },
                    "order": {
                        "type": "integer",
                        "title": "Order"
                    },
                    "comment_count": {
                        "type": "integer",
                        "title": "Comment Count"
                    },
                    "is_shared": {
                        "type": "boolean",
                        "title": "Is Shared"
                    },
                    "is_favorite": {
                        "type": "boolean",
                        "title": "Is Favorite"
                    },
                    "is_inbox_project": {
                        "type": "boolean",
                        "title": "Is Inbox Project"
                    },
                    "is_team_inbox": {
                        "type": "boolean",
                        "title": "Is Team Inbox"
                    },
                    "view_style": {
                        "type": "string",
                        "title": "View Style"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description"
                    }
                },
                "example": {
                    "id": "2365437921",
                    "name": "Marketing Campaign",
                    "color": "blue",
                    "parent_id": "2365437900",
                    "order": 1,
                    "comment_count": 0,
                    "is_shared": false,
                    "is_favorite": true,
                    "is_inbox_project": false,
                    "is_team_inbox": false,
                    "view_style": "list",
                    "url": "https://app.todoist.com/app/project/abc123",
                    "description": "Project for marketing tasks"
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
