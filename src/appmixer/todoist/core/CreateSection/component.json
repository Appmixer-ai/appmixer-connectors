{
    "name": "appmixer.todoist.core.CreateSection",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new section in a project.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "order": {
                        "type": "number"
                    }
                },
                "required": [
                    "name",
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "The name of the section.",
                        "index": 1
                    },
                    "projectId": {
                        "type": "select",
                        "label": "Project",
                        "tooltip": "The project to add the section to.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    },
                    "order": {
                        "type": "number",
                        "label": "Order",
                        "tooltip": "The order of the section. Defines the position of the section among other sections.",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "ID"
                    },
                    "project_id": {
                        "type": "string",
                        "title": "Project ID"
                    },
                    "order": {
                        "type": "number",
                        "title": "Order"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    }
                },
                "example": {
                    "id": "212068467",
                    "project_id": "2365437921",
                    "order": 1,
                    "name": "To Do"
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
