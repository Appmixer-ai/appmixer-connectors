{
    "name": "appmixer.todoist.core.ListTasks",
    "description": "List tasks with optional filters. Retrieves all available tasks from Todoist, up to the maximum page size.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    },
                    "sectionId": {
                        "type": "string"
                    },
                    "labelId": {
                        "type": "string"
                    },
                    "filter": {
                        "type": "string"
                    },
                    "lang": {
                        "type": "string"
                    },
                    "ids": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "select",
                        "label": "Project",
                        "tooltip": "Filter tasks by project.",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    },
                    "sectionId": {
                        "type": "select",
                        "label": "Section",
                        "tooltip": "Filter tasks by section.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListSectionsSelect?outPort=out",
                            "data": {
                                "messages": {
                                    "in/projectId": "inputs/in/projectId"
                                },
                                "transform": "./transformers#sectionsToSelectArray"
                            }
                        }
                    },
                    "labelId": {
                        "type": "text",
                        "label": "Label",
                        "tooltip": "Filter tasks by label name.",
                        "index": 3
                    },
                    "filter": {
                        "type": "text",
                        "label": "Filter",
                        "tooltip": "Filter by any Todoist filter query, e.g., 'today', 'p1', 'overdue'.",
                        "index": 4
                    },
                    "lang": {
                        "type": "select",
                        "label": "Language",
                        "tooltip": "Language for parsing filter.",
                        "index": 5,
                        "options": [
                            {
                                "label": "English",
                                "value": "en"
                            },
                            {
                                "label": "Danish",
                                "value": "da"
                            },
                            {
                                "label": "German",
                                "value": "de"
                            },
                            {
                                "label": "Spanish",
                                "value": "es"
                            },
                            {
                                "label": "French",
                                "value": "fr"
                            },
                            {
                                "label": "Italian",
                                "value": "it"
                            },
                            {
                                "label": "Japanese",
                                "value": "ja"
                            },
                            {
                                "label": "Korean",
                                "value": "ko"
                            },
                            {
                                "label": "Dutch",
                                "value": "nl"
                            },
                            {
                                "label": "Polish",
                                "value": "pl"
                            },
                            {
                                "label": "Portuguese",
                                "value": "pt"
                            },
                            {
                                "label": "Russian",
                                "value": "ru"
                            },
                            {
                                "label": "Swedish",
                                "value": "sv"
                            },
                            {
                                "label": "Turkish",
                                "value": "tr"
                            },
                            {
                                "label": "Chinese",
                                "value": "zh"
                            }
                        ]
                    },
                    "ids": {
                        "type": "text",
                        "label": "Task IDs",
                        "tooltip": "Comma-separated list of task IDs to retrieve.",
                        "index": 6
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, first item only, one item at a time, or stream to a file.",
                        "index": 7,
                        "defaultValue": "array",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/todoist/core/ListTasks?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}