{
    "name": "appmixer.todoist.core.UpdateReminder",
    "label": "Update Reminder",
    "description": "Update an existing reminder by setting its type and due date or minute offset.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "reminderId": {
                        "type": "string",
                        "title": "Reminder ID"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type"
                    },
                    "dueString": {
                        "type": "string",
                        "title": "Due String"
                    },
                    "dueDatetime": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Due Datetime"
                    },
                    "minuteOffset": {
                        "type": "number",
                        "title": "Minute Offset"
                    }
                },
                "required": [
                    "reminderId"
                ]
            },
            "inspector": {
                "inputs": {
                    "reminderId": {
                        "type": "text",
                        "index": 1,
                        "label": "Reminder ID",
                        "tooltip": "The unique identifier of the reminder to update."
                    },
                    "type": {
                        "type": "select",
                        "index": 2,
                        "label": "Type",
                        "tooltip": "The type of reminder: relative (before task due time) or absolute (specific date/time).",
                        "options": [
                            {
                                "label": "Relative",
                                "value": "relative"
                            },
                            {
                                "label": "Absolute",
                                "value": "absolute"
                            }
                        ]
                    },
                    "dueString": {
                        "type": "text",
                        "index": 3,
                        "label": "Due String",
                        "tooltip": "Human-readable due date for absolute reminders (e.g., 'tomorrow at 10:00', 'Dec 25')."
                    },
                    "dueDatetime": {
                        "type": "date-time",
                        "index": 4,
                        "label": "Due Datetime",
                        "tooltip": "Specific date and time for absolute reminders (ISO 8601 format)."
                    },
                    "minuteOffset": {
                        "type": "number",
                        "index": 5,
                        "label": "Minute Offset",
                        "tooltip": "Number of minutes before the task's due time for relative reminders."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}