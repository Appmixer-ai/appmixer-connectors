{
    "name": "appmixer.paddle.core.FindProducts",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Search and list products. Returns an array of products. The API returns a maximum of 200 products per request.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "type": ["array", "string"]
                    },
                    "tax_category": {
                        "type": ["array", "string"]
                    },
                    "type": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "tooltip": "Return only products with the specified IDs. Use comma-separated list for multiple IDs.",
                        "label": "Product IDs",
                        "index": 0
                    },
                    "status": {
                        "type": "multiselect",
                        "tooltip": "Filter by product status. Select multiple statuses.",
                        "label": "Status",
                        "index": 1,
                        "options": [
                            {
                                "label": "Active",
                                "value": "active"
                            },
                            {
                                "label": "Archived", 
                                "value": "archived"
                            }
                        ]
                    },
                    "tax_category": {
                        "type": "multiselect",
                        "tooltip": "Filter by tax category. Select multiple categories.",
                        "label": "Tax Category",
                        "index": 2,
                        "options": [
                            {
                                "label": "Digital Goods",
                                "value": "digital-goods"
                            },
                            {
                                "label": "eBooks",
                                "value": "ebooks"
                            },
                            {
                                "label": "Implementation Services",
                                "value": "implementation-services"
                            },
                            {
                                "label": "Professional Services",
                                "value": "professional-services"
                            },
                            {
                                "label": "SaaS",
                                "value": "saas"
                            },
                            {
                                "label": "Software Programming Services",
                                "value": "software-programming-services"
                            },
                            {
                                "label": "Standard",
                                "value": "standard"
                            },
                            {
                                "label": "Training Services",
                                "value": "training-services"
                            },
                            {
                                "label": "Website Hosting",
                                "value": "website-hosting"
                            }
                        ]
                    },
                    "type": {
                        "type": "select",
                        "tooltip": "Filter by product type.",
                        "label": "Type",
                        "index": 3,
                        "options": [
                            {
                                "label": "Standard",
                                "value": "standard"
                            },
                            {
                                "label": "Custom",
                                "value": "custom"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 4,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/paddle/core/FindProducts?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}