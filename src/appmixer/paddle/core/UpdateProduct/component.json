{
    "name": "appmixer.paddle.core.UpdateProduct",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing product. Only provided fields will be updated.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "product_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "tax_category": {
                        "type": "string"
                    },
                    "image_url": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "product_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "product_id": {
                        "type": "text",
                        "tooltip": "The unique product ID.",
                        "label": "Product Id",
                        "index": 0
                    },
                    "name": {
                        "type": "text",
                        "tooltip": "New product name.",
                        "label": "Name",
                        "index": 1
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "New product description.",
                        "label": "Description",
                        "index": 2
                    },
                    "type": {
                        "type": "select",
                        "tooltip": "Type of item. Standard items are part of your catalog; custom items are non-catalog.",
                        "label": "Type",
                        "index": 3,
                        "options": [
                            {
                                "label": "Standard",
                                "value": "standard"
                            },
                            {
                                "label": "Custom",
                                "value": "custom"
                            }
                        ]
                    },
                    "tax_category": {
                        "type": "select",
                        "tooltip": "Tax category for this product.",
                        "label": "Tax Category",
                        "index": 4,
                        "options": [
                            {
                                "label": "Digital Goods",
                                "value": "digital-goods"
                            },
                            {
                                "label": "Ebooks",
                                "value": "ebooks"
                            },
                            {
                                "label": "Implementation Services",
                                "value": "implementation-services"
                            },
                            {
                                "label": "Professional Services",
                                "value": "professional-services"
                            },
                            {
                                "label": "SaaS",
                                "value": "saas"
                            },
                            {
                                "label": "Software Programming Services",
                                "value": "software-programming-services"
                            },
                            {
                                "label": "Standard",
                                "value": "standard"
                            },
                            {
                                "label": "Training Services",
                                "value": "training-services"
                            },
                            {
                                "label": "Website Hosting",
                                "value": "website-hosting"
                            }
                        ]
                    },
                    "image_url": {
                        "type": "text",
                        "tooltip": "Image URL for this product. Should be a valid URI.",
                        "label": "Image URL",
                        "index": 5
                    },
                    "metadata": {
                        "type": "text",
                        "tooltip": "Custom data as JSON object.",
                        "label": "Metadata",
                        "index": 6
                    },
                    "status": {
                        "type": "select",
                        "options": [
                            {
                                "label": "Active",
                                "value": "active"
                            },
                            {
                                "label": "Archived",
                                "value": "archived"
                            }
                        ],
                        "tooltip": "Whether this product can be used in Paddle.",
                        "label": "Status",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Product Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "pro_01h2t3k4m5n6p7"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Premium Monthly Plan"
                    }
                },
                {
                    "label": "Tax Category",
                    "value": "tax_category",
                    "schema": {
                        "type": "string",
                        "example": "saas"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "standard"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Access to all premium features billed monthly"
                    }
                },
                {
                    "label": "Image Url",
                    "value": "image_url",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/images/premium-plan.png"
                    }
                },
                {
                    "label": "Custom Data",
                    "value": "custom_data",
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "example": {}
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                },
                {
                    "label": "Import Meta",
                    "value": "import_meta",
                    "schema": {
                        "type": "null",
                        "example": ""
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-02-20T14:45:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}