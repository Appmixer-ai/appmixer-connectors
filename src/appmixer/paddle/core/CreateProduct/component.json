{
    "name": "appmixer.paddle.core.CreateProduct",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new product.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "taxCategory": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "object"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Product display name.",
                        "label": "Name",
                        "index": 0
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "Product description.",
                        "label": "Description",
                        "index": 1
                    },
                    "taxCategory": {
                        "type": "text",
                        "tooltip": "Tax category to apply to this product.",
                        "label": "Tax Category",
                        "index": 2
                    },
                    "metadata": {
                        "type": "text",
                        "tooltip": "Arbitrary key/value metadata to attach to the product (JSON object).",
                        "label": "Metadata",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Product ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Description",
                    "value": "description"
                },
                {
                    "label": "Tax Category",
                    "value": "tax_category"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Updated At",
                    "value": "updated_at"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}