{
    "name": "appmixer.paddle.core.CreateProduct",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new product.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "taxCategory": {
                        "type": "string",
                        "enum": [
                            "digital-goods",
                            "ebooks",
                            "implementation-services",
                            "professional-services",
                            "saas",
                            "software-programming-services",
                            "standard",
                            "training-services",
                            "website-hosting"
                        ]
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "custom",
                            "standard"
                        ],
                        "default": "standard"
                    },
                    "imageUrl": {
                        "type": "string"
                    },
                    "metadata": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "taxCategory"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "Product display name.",
                        "label": "Name",
                        "index": 0
                    },
                    "description": {
                        "type": "textarea",
                        "tooltip": "Product description.",
                        "label": "Description",
                        "index": 1
                    },
                    "taxCategory": {
                        "type": "select",
                        "tooltip": "Tax category for this product. Used for charging the correct rate of tax. Selected tax category must be enabled on your Paddle account.",
                        "label": "Tax Category",
                        "index": 2,
                        "options": [
                            {
                                "label": "Digital Goods - Non-customizable digital files or media (not software)",
                                "value": "digital-goods"
                            },
                            {
                                "label": "eBooks - Digital books and educational material with permanent rights",
                                "value": "ebooks"
                            },
                            {
                                "label": "Implementation Services - Remote configuration, set-up, and integrating software",
                                "value": "implementation-services"
                            },
                            {
                                "label": "Professional Services - Application of expertise and specialized knowledge",
                                "value": "professional-services"
                            },
                            {
                                "label": "SaaS - Online or cloud-based applications over the Internet",
                                "value": "saas"
                            },
                            {
                                "label": "Software Programming Services - Customize and white label software products",
                                "value": "software-programming-services"
                            },
                            {
                                "label": "Standard - Pre-written software that can be downloaded and installed",
                                "value": "standard"
                            },
                            {
                                "label": "Training Services - Training and education services for software products",
                                "value": "training-services"
                            },
                            {
                                "label": "Website Hosting - Cloud storage service for information and assets",
                                "value": "website-hosting"
                            }
                        ]
                    },
                    "type": {
                        "type": "select",
                        "tooltip": "Type of item. Standard items are part of your catalog and shown in the Paddle dashboard. Custom items are for specific transactions and not shown in dashboard.",
                        "label": "Item Type",
                        "index": 3,
                        "defaultValue": "standard",
                        "options": [
                            {
                                "label": "Standard - Part of catalog, reusable across transactions",
                                "value": "standard"
                            },
                            {
                                "label": "Custom - Non-catalog item for specific transactions",
                                "value": "custom"
                            }
                        ]
                    },
                    "imageUrl": {
                        "type": "text",
                        "tooltip": "Image URL for this product. Included in the checkout and on some customer documents.",
                        "label": "Image URL",
                        "index": 4
                    },
                    "metadata": {
                        "type": "text",
                        "tooltip": "Arbitrary key/value metadata to attach to the product (JSON object).",
                        "label": "Metadata",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Product Id",
                    "value": "id",
                    "schema": {
                        "type": "string",
                        "example": "pro_01h2t3k4m5n6p7"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string",
                        "example": "Premium Monthly Plan"
                    }
                },
                {
                    "label": "Tax Category",
                    "value": "tax_category",
                    "schema": {
                        "type": "string",
                        "example": "saas"
                    }
                },
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string",
                        "example": "standard"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string",
                        "example": "Access to all premium features billed monthly"
                    }
                },
                {
                    "label": "Image Url",
                    "value": "image_url",
                    "schema": {
                        "type": "string",
                        "example": "https://example.com/images/premium-plan.png"
                    }
                },
                {
                    "label": "Custom Data",
                    "value": "custom_data",
                    "schema": {
                        "type": "null",
                        "example": ""
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string",
                        "example": "active"
                    }
                },
                {
                    "label": "Import Meta",
                    "value": "import_meta",
                    "schema": {
                        "type": "null",
                        "example": ""
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string",
                        "example": "2026-01-15T10:30:00Z"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}