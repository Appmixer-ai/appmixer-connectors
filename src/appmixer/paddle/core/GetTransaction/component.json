{
    "name": "appmixer.paddle.core.GetTransaction",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a transaction by its unique identifier.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "transaction_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "transaction_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "transaction_id": {
                        "type": "text",
                        "label": "Transaction Id",
                        "tooltip": "The unique transaction ID (txn_...).",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Data.Id"
                            },
                            "status": {
                                "type": "string",
                                "title": "Data.Status"
                            },
                            "customer_id": {
                                "type": "string",
                                "title": "Data.Customer Id"
                            },
                            "created_at": {
                                "type": "string",
                                "title": "Data.Created At"
                            },
                            "items": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "price_id": {
                                            "type": "string",
                                            "title": "Data.Items.Price Id"
                                        },
                                        "quantity": {
                                            "type": "number",
                                            "title": "Data.Items.Quantity"
                                        }
                                    }
                                },
                                "title": "Data.Items"
                            },
                            "currency_code": {
                                "type": "string",
                                "title": "Data.Currency Code"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}