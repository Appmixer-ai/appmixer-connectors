{
    "name": "appmixer.paddle.core.CreateTransaction",
    "description": "Create a new transaction for one-time charges. Provide at least one line item with a price ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paddle"
    },
    "quota": {
        "manager": "appmixer:paddle",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "customer_id": {
                        "type": "string"
                    },
                    "price_id": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "number",
                        "minimum": 1,
                        "default": 1
                    },
                    "currency_code": {
                        "type": "string"
                    }
                },
                "required": [
                    "customer_id",
                    "price_id"
                ],
                "additionalProperties": false
            },
            "inspector": {
                "inputs": {
                    "customer_id": {
                        "type": "text",
                        "label": "Customer ID",
                        "index": 0,
                        "tooltip": "The customer to bill (cus_...)."
                    },
                    "price_id": {
                        "type": "text",
                        "label": "Price ID",
                        "index": 1,
                        "tooltip": "The price ID (pri_...) to charge."
                    },
                    "quantity": {
                        "type": "number",
                        "label": "Quantity",
                        "index": 2,
                        "tooltip": "Quantity for the price."
                    },
                    "currency_code": {
                        "type": "text",
                        "label": "Currency Code",
                        "index": 3,
                        "tooltip": "ISO 4217 currency code for the transaction."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Data.Id"
                            },
                            "status": {
                                "type": "string",
                                "title": "Data.Status"
                            },
                            "customer_id": {
                                "type": "string",
                                "title": "Data.Customer Id"
                            },
                            "created_at": {
                                "type": "string",
                                "title": "Data.Created At"
                            },
                            "items": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "price_id": {
                                            "type": "string",
                                            "title": "Data.Items.Price Id"
                                        },
                                        "quantity": {
                                            "type": "number",
                                            "title": "Data.Items.Quantity"
                                        }
                                    }
                                },
                                "title": "Data.Items"
                            },
                            "currency_code": {
                                "type": "string",
                                "title": "Data.Currency Code"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}