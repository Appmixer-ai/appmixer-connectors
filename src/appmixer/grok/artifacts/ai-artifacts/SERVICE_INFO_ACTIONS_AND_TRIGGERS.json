        {
            "title": "ImageGeneration",
            "description": "Generate images from text prompts.",
            "type": "action",
            "documentation": "https://docs.x.ai/docs/images",
            "endpointUrl": "https://api.x.ai/v1/images/generations",
            "apiBaseUrl": "https://api.x.ai/v1",
            "method": "POST",
            "sampleResponse": {
                "created": 1730850000,
                "data": [
                    {
                        "b64_json": "<base64-image>",
                        "revised_prompt": "A red fox in a pine forest at sunrise"
                    }
                ]
            },
            "inputSchema": {
                "type": "object",
                "description": "Create one or more images from a text prompt.",
                "properties": {
                    "model": {
                        "type": "string",
                        "description": "Image generation model.",
                        "enum": [
                            "grok-2-image-latest"
                        ]
                    },
                    "prompt": {
                        "type": "string",
                        "description": "Natural language description of the desired image."
                    },
                    "n": {
                        "type": "integer",
                        "description": "Number of images to generate (1-10).",
                        "minimum": 1,
                        "maximum": 10,
                        "default": 1
                    },
                    "size": {
                        "type": "string",
                        "description": "Image size.",
                        "enum": [
                            "256x256",
                            "512x512",
                            "1024x1024"
                        ]
                    },
                    "response_format": {
                        "type": "string",
                        "description": "Choose URL or base64 JSON response.",
                        "enum": [
                            "url",
                            "b64_json"
                        ],
                        "default": "b64_json"
                    },
                    "user": {
                        "type": "string",
                        "description": "Unique end-user identifier for monitoring/abuse detection."
                    }
                },
                "required": [
                    "model",
                    "prompt"
                ]
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "data"
            }
        },
