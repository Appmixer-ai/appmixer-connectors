{
    "actions": [
        {
            "title": "ChatCompletion",
            "description": "Generate text responses using Grok models with conversational context.",
            "type": "action",
            "documentation": "https://docs.x.ai/docs/chat-completions",
            "endpointUrl": "https://api.x.ai/v1/chat/completions",
            "apiBaseUrl": "https://api.x.ai/v1",
            "method": "POST",
            "sampleResponse": {
                "id": "chatcmpl-abc123",
                "object": "chat.completion",
                "created": 1730850000,
                "model": "grok-3-latest",
                "choices": [
                    {
                        "index": 0,
                        "message": {
                            "role": "assistant",
                            "content": "Hello! How can I help you today?"
                        },
                        "finish_reason": "stop"
                    }
                ],
                "usage": {
                    "prompt_tokens": 12,
                    "completion_tokens": 34,
                    "total_tokens": 46
                },
                "system_fingerprint": "fp_example_123"
            },
            "inputSchema": {
                "type": "object",
                "description": "Inputs for creating a chat completion. Compatible with OpenAI-style requests.",
                "properties": {
                    "model": {
                        "type": "string",
                        "description": "Model to use. Examples: grok-3-latest, grok-3-fast-latest, grok-3-mini-latest, grok-3-mini-fast-latest, grok-2-latest.",
                        "enum": [
                            "grok-3-latest",
                            "grok-3-fast-latest",
                            "grok-3-mini-latest",
                            "grok-3-mini-fast-latest",
                            "grok-2-latest"
                        ]
                    },
                    "messages": {
                        "type": "array",
                        "description": "Conversation messages. Supports text and multimodal content (text + image_url).",
                        "items": {
                            "type": "object",
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "description": "Message role.",
                                    "enum": [
                                        "system",
                                        "user",
                                        "assistant",
                                        "tool"
                                    ]
                                },
                                "content": {
                                    "description": "Message content as a string or structured parts for multimodal.",
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "text",
                                                            "image_url"
                                                        ]
                                                    },
                                                    "text": {
                                                        "type": "string",
                                                        "description": "Text content if type=text."
                                                    },
                                                    "image_url": {
                                                        "type": "object",
                                                        "description": "Image reference if type=image_url.",
                                                        "properties": {
                                                            "url": {
                                                                "type": "string",
                                                                "description": "Public URL or data URL (base64) of the image."
                                                            },
                                                            "detail": {
                                                                "type": "string",
                                                                "description": "Image detail level.",
                                                                "enum": [
                                                                    "low",
                                                                    "high",
                                                                    "auto"
                                                                ]
                                                            }
                                                        },
                                                        "required": [
                                                            "url"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "type"
                                                ]
                                            }
                                        }
                                    ]
                                },
                                "name": {
                                    "type": "string",
                                    "description": "Tool name if role=tool."
                                },
                                "tool_call_id": {
                                    "type": "string",
                                    "description": "Tool call ID if applicable."
                                }
                            },
                            "required": [
                                "role",
                                "content"
                            ]
                        }
                    },
                    "temperature": {
                        "type": "number",
                        "description": "Sampling temperature. Higher values produce more random output."
                    },
                    "top_p": {
                        "type": "number",
                        "description": "Nucleus sampling probability mass."
                    },
                    "max_tokens": {
                        "type": "integer",
                        "description": "Maximum tokens to generate in the completion."
                    },
                    "presence_penalty": {
                        "type": "number",
                        "description": "Penalty for introducing new tokens."
                    },
                    "frequency_penalty": {
                        "type": "number",
                        "description": "Penalty for repeating tokens."
                    },
                    "stop": {
                        "description": "Sequences where the API will stop generating further tokens.",
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    },
                    "n": {
                        "type": "integer",
                        "description": "Number of completions to generate for each prompt."
                    },
                    "stream": {
                        "type": "boolean",
                        "description": "If true, returns tokens via server-sent events (SSE).",
                        "default": false
                    },
                    "user": {
                        "type": "string",
                        "description": "A unique identifier representing your end-user for monitoring/abuse detection."
                    }
                },
                "required": [
                    "model",
                    "messages"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "ReasoningCompletion",
            "description": "Generate responses with step-by-step reasoning using Grok mini reasoning models.",
            "type": "action",
            "documentation": "https://docs.x.ai/docs/chat-completions",
            "endpointUrl": "https://api.x.ai/v1/chat/completions",
            "apiBaseUrl": "https://api.x.ai/v1",
            "method": "POST",
            "sampleResponse": {
                "id": "chatcmpl-xyz987",
                "object": "chat.completion",
                "created": 1730850000,
                "model": "grok-3-mini-latest",
                "choices": [
                    {
                        "index": 0,
                        "message": {
                            "role": "assistant",
                            "content": "The answer is 42."
                        },
                        "finish_reason": "stop",
                        "reasoning": {
                            "summary": "Computed result using multi-step reasoning.",
                            "steps": [
                                "Parsed problem",
                                "Applied constraints",
                                "Calculated result"
                            ]
                        }
                    }
                ],
                "usage": {
                    "prompt_tokens": 55,
                    "completion_tokens": 87,
                    "total_tokens": 142
                }
            },
            "inputSchema": {
                "type": "object",
                "description": "Same as ChatCompletion with additional reasoning_effort parameter. Use grok-3-mini* models.",
                "properties": {
                    "model": {
                        "type": "string",
                        "description": "Reasoning-capable model (e.g., grok-3-mini-latest, grok-3-mini-fast-latest).",
                        "enum": [
                            "grok-3-mini-latest",
                            "grok-3-mini-fast-latest"
                        ]
                    },
                    "messages": {
                        "type": "array",
                        "description": "Conversation messages.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "enum": [
                                        "system",
                                        "user",
                                        "assistant",
                                        "tool"
                                    ]
                                },
                                "content": {
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "text",
                                                            "image_url"
                                                        ]
                                                    },
                                                    "text": {
                                                        "type": "string"
                                                    },
                                                    "image_url": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": "string"
                                                            },
                                                            "detail": {
                                                                "type": "string",
                                                                "enum": [
                                                                    "low",
                                                                    "high",
                                                                    "auto"
                                                                ]
                                                            }
                                                        },
                                                        "required": [
                                                            "url"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "type"
                                                ]
                                            }
                                        }
                                    ]
                                },
                                "name": {
                                    "type": "string"
                                },
                                "tool_call_id": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "role",
                                "content"
                            ]
                        }
                    },
                    "reasoning_effort": {
                        "type": "string",
                        "description": "Amount of compute spent in reasoning.",
                        "enum": [
                            "low",
                            "medium",
                            "high"
                        ],
                        "default": "medium"
                    },
                    "temperature": {
                        "type": "number"
                    },
                    "top_p": {
                        "type": "number"
                    },
                    "max_tokens": {
                        "type": "integer"
                    },
                    "stream": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": [
                    "model",
                    "messages"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
