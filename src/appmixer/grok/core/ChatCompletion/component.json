{
    "name": "appmixer.grok.core.ChatCompletion",
    "description": "Generate text responses using Grok models with conversational context.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "title": "Model"
                    },
                    "messagesRole": {
                        "type": "string",
                        "title": "Messages Role"
                    },
                    "messagesContent": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "text",
                                                "image_url"
                                            ]
                                        },
                                        "text": {
                                            "type": "string",
                                            "description": "Text content if type=text."
                                        },
                                        "image_url": {
                                            "type": "object",
                                            "description": "Image reference if type=image_url.",
                                            "properties": {
                                                "url": {
                                                    "type": "string",
                                                    "description": "Public URL or data URL (base64) of the image."
                                                },
                                                "detail": {
                                                    "type": "string",
                                                    "description": "Image detail level.",
                                                    "enum": [
                                                        "low",
                                                        "high",
                                                        "auto"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "url"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            }
                        ],
                        "title": "Messages Content"
                    },
                    "messagesName": {
                        "type": "string",
                        "title": "Messages Name"
                    },
                    "messagesToolCallId": {
                        "type": "string",
                        "title": "Messages Tool Call ID"
                    },
                    "temperature": {
                        "type": "number",
                        "title": "Temperature"
                    },
                    "topP": {
                        "type": "number",
                        "title": "Top P"
                    },
                    "maxTokens": {
                        "type": "integer",
                        "title": "Max Tokens"
                    },
                    "presencePenalty": {
                        "type": "number",
                        "title": "Presence Penalty"
                    },
                    "frequencyPenalty": {
                        "type": "number",
                        "title": "Frequency Penalty"
                    },
                    "stop": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ],
                        "title": "Stop"
                    },
                    "n": {
                        "type": "integer",
                        "title": "N"
                    },
                    "stream": {
                        "type": "boolean",
                        "default": false,
                        "title": "Stream"
                    },
                    "user": {
                        "type": "string",
                        "title": "User"
                    }
                },
                "required": [
                    "model",
                    "messagesRole",
                    "messagesContent"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "Model to use. Examples: grok-3-latest, grok-3-fast-latest, grok-3-mini-latest, grok-3-mini-fast-latest, grok-2-latest.",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-latest",
                                "value": "grok-3-latest"
                            },
                            {
                                "label": "grok-3-fast-latest",
                                "value": "grok-3-fast-latest"
                            },
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            },
                            {
                                "label": "grok-2-latest",
                                "value": "grok-2-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messagesRole": {
                        "type": "select",
                        "tooltip": "Message role.",
                        "label": "Messages Role",
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ],
                        "index": 1,
                        "required": true
                    },
                    "messagesContent": {
                        "type": "textarea",
                        "tooltip": "Message content as a string or structured parts for multimodal.",
                        "label": "Messages Content",
                        "index": 2,
                        "required": true
                    },
                    "messagesName": {
                        "type": "text",
                        "tooltip": "Tool name if role=tool.",
                        "label": "Messages Name",
                        "index": 3
                    },
                    "messagesToolCallId": {
                        "type": "text",
                        "tooltip": "Tool call ID if applicable.",
                        "label": "Messages Tool Call ID",
                        "index": 4
                    },
                    "temperature": {
                        "type": "number",
                        "tooltip": "Sampling temperature. Higher values produce more random output.",
                        "label": "Temperature",
                        "index": 5
                    },
                    "topP": {
                        "type": "number",
                        "tooltip": "Nucleus sampling probability mass.",
                        "label": "Top P",
                        "index": 6
                    },
                    "maxTokens": {
                        "type": "number",
                        "tooltip": "Maximum tokens to generate in the completion.",
                        "label": "Max Tokens",
                        "index": 7
                    },
                    "presencePenalty": {
                        "type": "number",
                        "tooltip": "Penalty for introducing new tokens.",
                        "label": "Presence Penalty",
                        "index": 8
                    },
                    "frequencyPenalty": {
                        "type": "number",
                        "tooltip": "Penalty for repeating tokens.",
                        "label": "Frequency Penalty",
                        "index": 9
                    },
                    "stop": {
                        "type": "text",
                        "tooltip": "Sequences where the API will stop generating further tokens.",
                        "label": "Stop",
                        "index": 10
                    },
                    "n": {
                        "type": "number",
                        "tooltip": "Number of completions to generate for each prompt.",
                        "label": "N",
                        "index": 11
                    },
                    "stream": {
                        "type": "toggle",
                        "tooltip": "If true, returns tokens via server-sent events (SSE).",
                        "label": "Stream",
                        "index": 12
                    },
                    "user": {
                        "type": "text",
                        "tooltip": "A unique identifier representing your end-user for monitoring/abuse detection.",
                        "label": "User",
                        "index": 13
                    }
                }
            }
        },
        {
            "name": "stream",
            "schema": {
                "type": "object"
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Content"
                                        }
                                    },
                                    "title": "Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Finish Reason"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Total Tokens"
                            }
                        }
                    }
                },
                {
                    "label": "System Fingerprint",
                    "value": "system_fingerprint",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}