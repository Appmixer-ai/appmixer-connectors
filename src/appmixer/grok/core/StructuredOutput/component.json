{
    "name": "appmixer.grok.core.StructuredOutput",
    "description": "Generate responses constrained to a JSON schema using response_format.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "responseFormatType": {
                        "type": "string"
                    },
                    "jsonSchema": {
                        "type": "object"
                    },
                    "strict": {
                        "type": "boolean"
                    },
                    "maxTokens": {
                        "type": "integer"
                    }
                },
                "required": [
                    "model",
                    "role",
                    "content",
                    "responseFormatType",
                    "jsonSchema"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "label": "Model",
                        "index": 0,
                        "options": [
                            {
                                "label": "grok-3-latest",
                                "value": "grok-3-latest"
                            },
                            {
                                "label": "grok-3-fast-latest",
                                "value": "grok-3-fast-latest"
                            },
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            },
                            {
                                "label": "grok-2-latest",
                                "value": "grok-2-latest"
                            }
                        ]
                    },
                    "role": {
                        "type": "select",
                        "label": "Role",
                        "index": 1,
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ]
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Content",
                        "index": 2
                    },
                    "responseFormatType": {
                        "type": "select",
                        "label": "Response Format Type",
                        "index": 3,
                        "tooltip": "Set to json_schema to enable schema-constrained outputs.",
                        "options": [
                            {
                                "label": "json_schema",
                                "value": "json_schema"
                            }
                        ]
                    },
                    "jsonSchema": {
                        "type": "textarea",
                        "label": "JSON Schema",
                        "index": 4,
                        "tooltip": "JSON Schema the model must follow."
                    },
                    "strict": {
                        "type": "toggle",
                        "label": "Strict",
                        "index": 5,
                        "tooltip": "If true, enforces strict schema adherence."
                    },
                    "maxTokens": {
                        "type": "number",
                        "label": "Max Tokens",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string"
                                        },
                                        "content": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "finishReason": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "promptTokens": {
                                "type": "number"
                            },
                            "completionTokens": {
                                "type": "number"
                            },
                            "totalTokens": {
                                "type": "number"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}