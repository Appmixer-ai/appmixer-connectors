{
    "name": "appmixer.grok.core.StructuredOutput",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Generate responses constrained to a JSON schema using response_format.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "messages|role": {
                        "type": "string"
                    },
                    "messages|content": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "text",
                                                "image_url"
                                            ]
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "image_url": {
                                            "type": "object",
                                            "properties": {
                                                "url": {
                                                    "type": "string"
                                                },
                                                "detail": {
                                                    "type": "string",
                                                    "enum": [
                                                        "low",
                                                        "high",
                                                        "auto"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "url"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            }
                        ]
                    },
                    "response_format|type": {
                        "type": "string"
                    },
                    "response_format|json_schema": {
                        "type": "object"
                    },
                    "response_format|strict": {
                        "type": "boolean"
                    },
                    "max_tokens": {
                        "type": "integer"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-latest",
                                "value": "grok-3-latest"
                            },
                            {
                                "label": "grok-3-fast-latest",
                                "value": "grok-3-fast-latest"
                            },
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            },
                            {
                                "label": "grok-2-latest",
                                "value": "grok-2-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messages|role": {
                        "type": "select",
                        "tooltip": "",
                        "label": "Messages|role",
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ],
                        "index": 1
                    },
                    "messages|content": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Messages|content",
                        "index": 2
                    },
                    "response_format|type": {
                        "type": "select",
                        "tooltip": "Set to json_schema to enable schema-constrained outputs.",
                        "label": "Response Format|type",
                        "options": [
                            {
                                "label": "json_schema",
                                "value": "json_schema"
                            }
                        ],
                        "index": 3
                    },
                    "response_format|json_schema": {
                        "type": "text",
                        "tooltip": "JSON Schema the model must follow.",
                        "label": "Response Format|json Schema",
                        "index": 4
                    },
                    "response_format|strict": {
                        "type": "toggle",
                        "tooltip": "If true, enforces strict schema adherence.",
                        "label": "Response Format|strict",
                        "index": 5
                    },
                    "max_tokens": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Max Tokens",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Choices.Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Choices.Message.Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Choices.Message.Content"
                                        }
                                    },
                                    "title": "Choices.Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Choices.Finish Reason"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Usage.Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Usage.Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Usage.Total Tokens"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}