{
    "name": "appmixer.grok.core.ReasoningCompletion",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Generate responses with step-by-step reasoning using Grok mini reasoning models.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "messages|role": {
                        "type": "string"
                    },
                    "messages|content": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "text",
                                                "image_url"
                                            ]
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "image_url": {
                                            "type": "object",
                                            "properties": {
                                                "url": {
                                                    "type": "string"
                                                },
                                                "detail": {
                                                    "type": "string",
                                                    "enum": [
                                                        "low",
                                                        "high",
                                                        "auto"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "url"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            }
                        ]
                    },
                    "messages|name": {
                        "type": "string"
                    },
                    "messages|tool_call_id": {
                        "type": "string"
                    },
                    "reasoning_effort": {
                        "type": "string",
                        "default": "medium"
                    },
                    "temperature": {
                        "type": "number"
                    },
                    "top_p": {
                        "type": "number"
                    },
                    "max_tokens": {
                        "type": "integer"
                    },
                    "stream": {
                        "type": "boolean",
                        "default": false
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "Reasoning-capable model (e.g., grok-3-mini-latest, grok-3-mini-fast-latest).",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messages|role": {
                        "type": "select",
                        "tooltip": "",
                        "label": "Messages|role",
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ],
                        "index": 1
                    },
                    "messages|content": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Messages|content",
                        "index": 2
                    },
                    "messages|name": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Messages|name",
                        "index": 3
                    },
                    "messages|tool_call_id": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Messages|tool Call Id",
                        "index": 4
                    },
                    "reasoning_effort": {
                        "type": "select",
                        "tooltip": "Amount of compute spent in reasoning.",
                        "label": "Reasoning Effort",
                        "options": [
                            {
                                "label": "low",
                                "value": "low"
                            },
                            {
                                "label": "medium",
                                "value": "medium"
                            },
                            {
                                "label": "high",
                                "value": "high"
                            }
                        ],
                        "index": 5
                    },
                    "temperature": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Temperature",
                        "index": 6
                    },
                    "top_p": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Top P",
                        "index": 7
                    },
                    "max_tokens": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Max Tokens",
                        "index": 8
                    },
                    "stream": {
                        "type": "toggle",
                        "tooltip": "",
                        "label": "Stream",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Choices.Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Choices.Message.Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Choices.Message.Content"
                                        }
                                    },
                                    "title": "Choices.Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Choices.Finish Reason"
                                },
                                "reasoning": {
                                    "type": "object",
                                    "properties": {
                                        "summary": {
                                            "type": "string",
                                            "title": "Choices.Reasoning.Summary"
                                        },
                                        "steps": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "title": "Choices.Reasoning.Steps"
                                        }
                                    },
                                    "title": "Choices.Reasoning"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Usage.Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Usage.Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Usage.Total Tokens"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}