{
    "name": "appmixer.grok.core.ReasoningCompletion",
    "description": "Generate responses with step-by-step reasoning using Grok mini reasoning models.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "title": "Model"
                    },
                    "messages": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "title": "Role"
                                },
                                "content": {
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "text",
                                                            "image_url"
                                                        ]
                                                    },
                                                    "text": {
                                                        "type": "string"
                                                    },
                                                    "image_url": {
                                                        "type": "object",
                                                        "properties": {
                                                            "url": {
                                                                "type": "string"
                                                            },
                                                            "detail": {
                                                                "type": "string",
                                                                "enum": [
                                                                    "low",
                                                                    "high",
                                                                    "auto"
                                                                ]
                                                            }
                                                        },
                                                        "required": [
                                                            "url"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "type"
                                                ]
                                            }
                                        }
                                    ],
                                    "title": "Content"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name"
                                },
                                "tool_call_id": {
                                    "type": "string",
                                    "title": "Tool Call Id"
                                }
                            },
                            "required": [
                                "role",
                                "content"
                            ]
                        },
                        "title": "Messages"
                    },
                    "reasoning_effort": {
                        "type": "string",
                        "default": "medium",
                        "title": "Reasoning Effort"
                    },
                    "temperature": {
                        "type": "number",
                        "title": "Temperature"
                    },
                    "top_p": {
                        "type": "number",
                        "title": "Top P"
                    },
                    "max_tokens": {
                        "type": "integer",
                        "title": "Max Tokens"
                    },
                    "stream": {
                        "type": "boolean",
                        "default": false,
                        "title": "Stream"
                    }
                },
                "required": [
                    "model",
                    "messages"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "Reasoning-capable model (e.g., grok-3-mini-latest, grok-3-mini-fast-latest).",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messages": {
                        "type": "text",
                        "tooltip": "Array of message objects with role and content.",
                        "label": "Messages",
                        "index": 1
                    },
                    "reasoning_effort": {
                        "type": "select",
                        "tooltip": "Amount of compute spent in reasoning.",
                        "label": "Reasoning Effort",
                        "options": [
                            {
                                "label": "low",
                                "value": "low"
                            },
                            {
                                "label": "medium",
                                "value": "medium"
                            },
                            {
                                "label": "high",
                                "value": "high"
                            }
                        ],
                        "index": 2
                    },
                    "temperature": {
                        "type": "number",
                        "tooltip": "What sampling temperature to use, between 0 and 2.",
                        "label": "Temperature",
                        "index": 3
                    },
                    "top_p": {
                        "type": "number",
                        "tooltip": "An alternative to sampling with temperature.",
                        "label": "Top P",
                        "index": 4
                    },
                    "max_tokens": {
                        "type": "number",
                        "tooltip": "The maximum number of tokens to generate.",
                        "label": "Max Tokens",
                        "index": 5
                    },
                    "stream": {
                        "type": "toggle",
                        "tooltip": "Whether to stream the results.",
                        "label": "Stream",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Choices.Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Message.Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Message.Content"
                                        }
                                    },
                                    "title": "Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Finish Reason"
                                },
                                "reasoning": {
                                    "type": "object",
                                    "properties": {
                                        "summary": {
                                            "type": "string",
                                            "title": "Reasoning.Summary"
                                        },
                                        "steps": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "title": "Reasoning.Steps"
                                        }
                                    },
                                    "title": "Reasoning"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Total Tokens"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}