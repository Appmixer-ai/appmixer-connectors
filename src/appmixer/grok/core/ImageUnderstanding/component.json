{
    "name": "appmixer.grok.core.ImageUnderstanding",
    "description": "Analyze and understand images by sending them as inputs in chat completions.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": "string"
                    },
                    "imageDetail": {
                        "type": "string"
                    },
                    "maxTokens": {
                        "type": "integer"
                    }
                },
                "required": [
                    "model",
                    "imageUrl"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "label": "Model",
                        "tooltip": "Vision-capable model.",
                        "options": [
                            {
                                "label": "grok-2-vision-latest",
                                "value": "grok-2-vision-latest"
                            },
                            {
                                "label": "grok-vision-beta",
                                "value": "grok-vision-beta"
                            }
                        ],
                        "index": 0
                    },
                    "text": {
                        "type": "textarea",
                        "label": "Text",
                        "tooltip": "User text prompt or question about the image.",
                        "index": 1
                    },
                    "imageUrl": {
                        "type": "text",
                        "label": "Image URL",
                        "tooltip": "Public URL or base64 data URL of the image.",
                        "index": 2
                    },
                    "imageDetail": {
                        "type": "select",
                        "label": "Image Detail",
                        "tooltip": "Controls vision detail level.",
                        "options": [
                            {
                                "label": "low",
                                "value": "low"
                            },
                            {
                                "label": "high",
                                "value": "high"
                            },
                            {
                                "label": "auto",
                                "value": "auto"
                            }
                        ],
                        "index": 3
                    },
                    "maxTokens": {
                        "type": "number",
                        "label": "Max Tokens",
                        "tooltip": "Max tokens for the textual response.",
                        "index": 4
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Image Understanding ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Object",
                    "value": "object",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created",
                    "value": "created",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Choices",
                    "value": "choices",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "index": {
                                    "type": "number",
                                    "title": "Choices.Index"
                                },
                                "message": {
                                    "type": "object",
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "title": "Choices.Message.Role"
                                        },
                                        "content": {
                                            "type": "string",
                                            "title": "Choices.Message.Content"
                                        },
                                        "refusal": {
                                            "type": "string",
                                            "title": "Choices.Message.Refusal"
                                        }
                                    },
                                    "title": "Choices.Message"
                                },
                                "finish_reason": {
                                    "type": "string",
                                    "title": "Choices.Finish Reason"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Usage",
                    "value": "usage",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "prompt_tokens": {
                                "type": "number",
                                "title": "Usage.Prompt Tokens"
                            },
                            "completion_tokens": {
                                "type": "number",
                                "title": "Usage.Completion Tokens"
                            },
                            "total_tokens": {
                                "type": "number",
                                "title": "Usage.Total Tokens"
                            },
                            "prompt_tokens_details": {
                                "type": "object",
                                "properties": {
                                    "text_tokens": {
                                        "type": "number",
                                        "title": "Usage.Prompt Tokens Details.Text Tokens"
                                    },
                                    "audio_tokens": {
                                        "type": "number",
                                        "title": "Usage.Prompt Tokens Details.Audio Tokens"
                                    },
                                    "image_tokens": {
                                        "type": "number",
                                        "title": "Usage.Prompt Tokens Details.Image Tokens"
                                    },
                                    "cached_tokens": {
                                        "type": "number",
                                        "title": "Usage.Prompt Tokens Details.Cached Tokens"
                                    }
                                },
                                "title": "Usage.Prompt Tokens Details"
                            },
                            "completion_tokens_details": {
                                "type": "object",
                                "properties": {
                                    "reasoning_tokens": {
                                        "type": "number",
                                        "title": "Usage.Completion Tokens Details.Reasoning Tokens"
                                    },
                                    "audio_tokens": {
                                        "type": "number",
                                        "title": "Usage.Completion Tokens Details.Audio Tokens"
                                    },
                                    "accepted_prediction_tokens": {
                                        "type": "number",
                                        "title": "Usage.Completion Tokens Details.Accepted Prediction Tokens"
                                    },
                                    "rejected_prediction_tokens": {
                                        "type": "number",
                                        "title": "Usage.Completion Tokens Details.Rejected Prediction Tokens"
                                    }
                                },
                                "title": "Usage.Completion Tokens Details"
                            },
                            "num_sources_used": {
                                "type": "number",
                                "title": "Usage.Num Sources Used"
                            }
                        }
                    }
                },
                {
                    "label": "System Fingerprint",
                    "value": "system_fingerprint",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
