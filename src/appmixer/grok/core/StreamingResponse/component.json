{
    "name": "appmixer.grok.core.StreamingResponse",
    "label": "Streaming Response",
    "description": "Get real-time token streaming for chat completions using SSE.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string",
                        "title": "Model"
                    },
                    "role": {
                        "type": "string",
                        "title": "Role"
                    },
                    "content": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "text",
                                                "image_url"
                                            ]
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "image_url": {
                                            "type": "object",
                                            "properties": {
                                                "url": {
                                                    "type": "string"
                                                },
                                                "detail": {
                                                    "type": "string",
                                                    "enum": [
                                                        "low",
                                                        "high",
                                                        "auto"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "url"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            }
                        ],
                        "title": "Content"
                    },
                    "stream": {
                        "type": "boolean",
                        "default": true,
                        "title": "Stream"
                    },
                    "temperature": {
                        "type": "number",
                        "title": "Temperature"
                    },
                    "max_tokens": {
                        "type": "integer",
                        "title": "Max Tokens"
                    }
                },
                "required": [
                    "model",
                    "role",
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "label": "Model",
                        "tooltip": "Select the AI model to use",
                        "index": 0,
                        "options": [
                            {
                                "label": "grok-3-latest",
                                "value": "grok-3-latest"
                            },
                            {
                                "label": "grok-3-fast-latest",
                                "value": "grok-3-fast-latest"
                            },
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            },
                            {
                                "label": "grok-2-latest",
                                "value": "grok-2-latest"
                            }
                        ]
                    },
                    "role": {
                        "type": "select",
                        "label": "Role",
                        "tooltip": "Specify the role for the message",
                        "index": 1,
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ]
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Content",
                        "tooltip": "The message content to send",
                        "index": 2
                    },
                    "stream": {
                        "type": "toggle",
                        "label": "Stream",
                        "tooltip": "Enable SSE streaming for real-time token responses",
                        "index": 3
                    },
                    "temperature": {
                        "type": "number",
                        "label": "Temperature",
                        "tooltip": "Control randomness of responses (0.0 to 2.0)",
                        "index": 4
                    },
                    "max_tokens": {
                        "type": "number",
                        "label": "Max Tokens",
                        "tooltip": "Maximum number of tokens to generate",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "string"
            }
        }
    ],
    "icon": "data:image/png;base64,"
}