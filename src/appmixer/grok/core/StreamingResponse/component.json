{
    "name": "appmixer.grok.core.StreamingResponse",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get real-time token streaming for chat completions using SSE.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:grok"
    },
    "quota": {
        "manager": "appmixer:grok",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "messages|role": {
                        "type": "string"
                    },
                    "messages|content": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "text",
                                                "image_url"
                                            ]
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "image_url": {
                                            "type": "object",
                                            "properties": {
                                                "url": {
                                                    "type": "string"
                                                },
                                                "detail": {
                                                    "type": "string",
                                                    "enum": [
                                                        "low",
                                                        "high",
                                                        "auto"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "url"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ]
                                }
                            }
                        ]
                    },
                    "stream": {
                        "type": "boolean",
                        "default": true
                    },
                    "temperature": {
                        "type": "number"
                    },
                    "max_tokens": {
                        "type": "integer"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "model": {
                        "type": "select",
                        "tooltip": "",
                        "label": "Model",
                        "options": [
                            {
                                "label": "grok-3-latest",
                                "value": "grok-3-latest"
                            },
                            {
                                "label": "grok-3-fast-latest",
                                "value": "grok-3-fast-latest"
                            },
                            {
                                "label": "grok-3-mini-latest",
                                "value": "grok-3-mini-latest"
                            },
                            {
                                "label": "grok-3-mini-fast-latest",
                                "value": "grok-3-mini-fast-latest"
                            },
                            {
                                "label": "grok-2-latest",
                                "value": "grok-2-latest"
                            }
                        ],
                        "index": 0
                    },
                    "messages|role": {
                        "type": "select",
                        "tooltip": "",
                        "label": "Messages|role",
                        "options": [
                            {
                                "label": "system",
                                "value": "system"
                            },
                            {
                                "label": "user",
                                "value": "user"
                            },
                            {
                                "label": "assistant",
                                "value": "assistant"
                            },
                            {
                                "label": "tool",
                                "value": "tool"
                            }
                        ],
                        "index": 1
                    },
                    "messages|content": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Messages|content",
                        "index": 2
                    },
                    "stream": {
                        "type": "toggle",
                        "tooltip": "Enable SSE streaming.",
                        "label": "Stream",
                        "index": 3
                    },
                    "temperature": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Temperature",
                        "index": 4
                    },
                    "max_tokens": {
                        "type": "number",
                        "tooltip": "",
                        "label": "Max Tokens",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sse Example",
                    "value": "sse_example",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}