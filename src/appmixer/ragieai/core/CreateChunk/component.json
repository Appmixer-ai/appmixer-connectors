{
    "name": "appmixer.ragieai.core.CreateChunk",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new chunk in RagieAI.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["documentId", "text"],
                "properties": {
                    "documentId": {
                        "type": "string",
                        "description": "The ID of the document this chunk belongs to"
                    },
                    "text": {
                        "type": "string",
                        "description": "The text content of the chunk"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Optional metadata for the chunk"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of the document this chunk belongs to"
                    },
                    "text": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Text",
                        "tooltip": "The text content of the chunk"
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Metadata",
                        "tooltip": "Optional metadata for the chunk (JSON object)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Chunk ID",
                    "value": "id"
                },
                {
                    "label": "Document ID",
                    "value": "document_id"
                },
                {
                    "label": "Text",
                    "value": "text"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
