{
    "name": "appmixer.ragieai.core.GetDocumentSummary",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a LLM generated summary of the document. The summary is created when the document is first created or updated. Documents of types ['xls', 'xlsx', 'csv', 'json'] are not supported for summarization. Documents greater than 1M in token length are not supported. This feature is in beta and may change in the future.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ragieai"
    },
    "quota": {
        "manager": "appmixer:ragieai",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "documentId": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "tooltip": "The id of the document.",
                        "label": "Document Id",
                        "index": 0
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Document Id",
                    "value": "document_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Summary",
                    "value": "summary",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}