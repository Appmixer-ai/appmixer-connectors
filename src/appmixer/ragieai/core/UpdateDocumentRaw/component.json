{
    "name": "appmixer.ragieai.core.UpdateDocumentRaw",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update a document with raw data in text or JSON format.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ragieai"
    },
    "quota": {
        "manager": "appmixer:ragieai",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "document_id": {
                        "type": "string"
                    },
                    "data": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "document_id",
                    "data"
                ]
            },
            "inspector": {
                "inputs": {
                    "document_id": {
                        "type": "text",
                        "label": "Document Id",
                        "tooltip": "The id of the document.",
                        "index": 0
                    },
                    "data": {
                        "type": "textarea",
                        "label": "Data",
                        "tooltip": "Document data in a text or JSON format.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}