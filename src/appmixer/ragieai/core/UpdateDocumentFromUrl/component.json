{
    "name": "appmixer.ragieai.core.UpdateDocumentFromUrl",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Updates a document from a publicly accessible URL. The document goes through processing steps (pending, partitioning, partitioned, refined, chunked, indexed, summary_indexed, keyword_indexed, ready, failed) before it is ready for retrieval. PDF files over 2000 pages are not supported in hi_res mode.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "quota": {
        "manager": "appmixer:ragieai",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "documentId": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "mode": {
                        "type": "string",
                        "default": "fast"
                    }
                },
                "required": [
                    "documentId",
                    "url"
                ]
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "tooltip": "The id of the document to update",
                        "label": "Document Id",
                        "index": 0
                    },
                    "url": {
                        "type": "text",
                        "tooltip": "Url of the file to download. Must be publicly accessible and HTTP or HTTPS scheme",
                        "label": "Url",
                        "index": 1
                    },
                    "mode": {
                        "type": "select",
                        "tooltip": "Partition strategy for the document. Different strategies exist for textual, audio and video file types. For textual documents: 'hi_res' (extracts images and tables, ~20x slower) or 'fast' (text only, default). For audio: true/false. For video: 'audio_only', 'video_only', 'audio_video'. Use 'all' for highest quality processing of all media types",
                        "label": "Mode",
                        "index": 2,
                        "options": [
                            {
                                "label": "fast",
                                "value": "fast"
                            },
                            {
                                "label": "hi_res",
                                "value": "hi_res"
                            },
                            {
                                "label": "all",
                                "value": "all"
                            },
                            {
                                "label": "audio_only",
                                "value": "audio_only"
                            },
                            {
                                "label": "video_only",
                                "value": "video_only"
                            },
                            {
                                "label": "audio_video",
                                "value": "audio_video"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}