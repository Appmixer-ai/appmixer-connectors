{
    "name": "appmixer.ragieai.core.UpdateDocument",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Updates a document's metadata in RagieAI.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["documentId"],
                "properties": {
                    "documentId": {
                        "type": "string",
                        "description": "The ID of the document to update"
                    },
                    "name": {
                        "type": "string",
                        "description": "New name for the document"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "New metadata for the document"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of the document to update"
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Document Name",
                        "tooltip": "New name for the document"
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Metadata",
                        "tooltip": "New metadata for the document (JSON object)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
