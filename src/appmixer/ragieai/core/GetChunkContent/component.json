{
    "name": "appmixer.ragieai.core.GetChunkContent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves the content of a chunk from RagieAI.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["chunkId"],
                "properties": {
                    "chunkId": {
                        "type": "string",
                        "description": "The ID of the chunk"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "chunkId": {
                        "type": "text",
                        "index": 1,
                        "label": "Chunk ID",
                        "tooltip": "The ID of the chunk"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Chunk ID",
                    "value": "id"
                },
                {
                    "label": "Content",
                    "value": "content"
                },
                {
                    "label": "Document ID",
                    "value": "document_id"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
