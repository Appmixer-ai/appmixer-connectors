{
    "name": "appmixer.ragieai.core.CreateDocumentFromUrl",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new document in RagieAI from a URL.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "url"
                ],
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "The URL to fetch the document from"
                    },
                    "name": {
                        "type": "string",
                        "description": "Optional name for the document. If not provided, will be derived from URL"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Optional metadata for the document"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "url": {
                        "type": "text",
                        "index": 1,
                        "label": "Document URL",
                        "tooltip": "The URL to fetch the document from"
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Document Name",
                        "tooltip": "Optional name for the document. If not provided, will be derived from URL"
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Metadata",
                        "tooltip": "Optional metadata for the document (JSON object)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Document ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At"
                    },
                    "metadata": {
                        "type": "object",
                        "title": "Metadata"
                    }
                }
            },
            "options": [
                {
                    "label": "Document ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "URL",
                    "value": "url"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
