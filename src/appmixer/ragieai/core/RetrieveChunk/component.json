{
    "name": "appmixer.ragieai.core.RetrieveChunk",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves a chunk from RagieAI by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["chunkId"],
                "properties": {
                    "chunkId": {
                        "type": "string",
                        "description": "The ID of the chunk to retrieve"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "chunkId": {
                        "type": "text",
                        "index": 1,
                        "label": "Chunk ID",
                        "tooltip": "The ID of the chunk to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Chunk ID",
                    "value": "id"
                },
                {
                    "label": "Document ID",
                    "value": "document_id"
                },
                {
                    "label": "Text",
                    "value": "text"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                },
                {
                    "label": "Score",
                    "value": "score"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
