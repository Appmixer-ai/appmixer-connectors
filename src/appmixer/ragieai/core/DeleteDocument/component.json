{
    "name": "appmixer.ragieai.core.DeleteDocument",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Deletes a document from RagieAI by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": [
                    "documentId"
                ],
                "properties": {
                    "documentId": {
                        "type": "string",
                        "description": "The ID of the document to delete"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of the document to delete"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
