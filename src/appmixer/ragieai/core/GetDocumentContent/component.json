{
    "name": "appmixer.ragieai.core.GetDocumentContent",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get the content of a document. The media_type parameter can be used to request the content in a different format. When requesting as application/json, additional metadata about the document will be included. If the original document contained content such as images or other non-textual media, this response will include a text description of that media instead of the original file data. Using mime types such as audio/mpeg or video/mp4 will stream the file in a format that can be provided to an audio/video player.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:ragieai"
    },
    "quota": {
        "manager": "appmixer:ragieai",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "document_id": {
                        "type": "string"
                    },
                    "media_type": {
                        "type": "string"
                    },
                    "download": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "document_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "document_id": {
                        "type": "text",
                        "tooltip": "The id of the document.",
                        "label": "Document Id",
                        "index": 0
                    },
                    "media_type": {
                        "type": "text",
                        "tooltip": "The desired media type of the content to return described as a mime type. An error will be returned if the requested media type is not supported for the document's type.",
                        "label": "Media Type",
                        "index": 1
                    },
                    "download": {
                        "type": "toggle",
                        "tooltip": "Whether to return the content as a file download or a raw stream. If set to true, the content will be returned as a named file for download.",
                        "label": "Download",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Updated At",
                    "value": "updated_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Metadata",
                    "value": "metadata",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Partition",
                    "value": "partition",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Content",
                    "value": "content",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}