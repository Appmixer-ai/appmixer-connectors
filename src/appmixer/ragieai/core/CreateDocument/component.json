{
    "name": "appmixer.ragieai.core.CreateDocument",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new document in RagieAI from text content.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["name", "content"],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the document"
                    },
                    "content": {
                        "type": "string",
                        "description": "The text content of the document"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Optional metadata for the document"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "index": 1,
                        "label": "Document Name",
                        "tooltip": "The name of the document"
                    },
                    "content": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Content",
                        "tooltip": "The text content of the document"
                    },
                    "metadata": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Metadata",
                        "tooltip": "Optional metadata for the document (JSON object)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Document ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
