{
    "name": "appmixer.ragieai.core.GetDocument",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieves a document from RagieAI by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:ragieai"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "required": ["documentId"],
                "properties": {
                    "documentId": {
                        "type": "string",
                        "description": "The ID of the document to retrieve"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "index": 1,
                        "label": "Document ID",
                        "tooltip": "The ID of the document to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Document ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "URL",
                    "value": "url"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Metadata",
                    "value": "metadata"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
