{
    "name": "appmixer.workday.core.RunWQLQuery",
    "label": "Run WQL Query",
    "description": "Run a Workday Query Language (WQL) query, e.g. <code>SELECT firstName, location FROM allWorkers</code>. The API client needs the System scope and the account access to the Workday Query Language domain.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:workday"
    },
    "quota": {
        "manager": "appmixer:workday",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Query",
                        "tooltip": "The WQL query, up to 16,000 characters. Use data source and field aliases, e.g. <code>SELECT firstName, location FROM allWorkers</code>."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "result",
                    "count",
                    "total"
                ],
                "properties": {
                    "result": {
                        "type": "array",
                        "title": "Rows",
                        "items": {
                            "type": "object",
                            "properties": {}
                        },
                        "example": [
                            {
                                "firstName": "Logan",
                                "location": {
                                    "descriptor": "San Francisco",
                                    "id": "5403216f5ef810381796f3bb216504f5"
                                }
                            }
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "title": "Rows Count",
                        "example": 1
                    },
                    "total": {
                        "type": "integer",
                        "title": "Total",
                        "example": 152
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
