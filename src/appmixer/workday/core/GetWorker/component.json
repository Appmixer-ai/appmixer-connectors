{
    "name": "appmixer.workday.core.GetWorker",
    "label": "Get Worker",
    "description": "Retrieve a worker by Workday ID or reference ID (for example Employee_ID=21005).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:workday"
    },
    "quota": {
        "manager": "appmixer:workday",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "workerId": {
                        "type": "string"
                    }
                },
                "required": [
                    "workerId"
                ]
            },
            "inspector": {
                "inputs": {
                    "workerId": {
                        "type": "text",
                        "index": 1,
                        "label": "Worker ID",
                        "tooltip": "The Workday ID (WID) of the worker, or a reference ID such as <code>Employee_ID=21005</code>. Use List Workers or Find Workers to get it."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "id",
                    "descriptor"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Worker ID",
                        "example": "3aa5550b7fe348b98d7b5741afc65534"
                    },
                    "descriptor": {
                        "type": "string",
                        "title": "Name",
                        "example": "Logan McNeil"
                    },
                    "href": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://wd2-impl-services1.workday.com/api/common/v1/acme/workers/3aa5550b7fe348b98d7b5741afc65534"
                    },
                    "workerId": {
                        "type": "string",
                        "title": "Employee ID",
                        "example": "21001"
                    },
                    "businessTitle": {
                        "type": "string",
                        "title": "Business Title",
                        "example": "Vice President, Human Resources"
                    },
                    "isManager": {
                        "type": "boolean",
                        "title": "Is Manager",
                        "example": true
                    },
                    "primaryWorkEmail": {
                        "type": "string",
                        "title": "Primary Work Email",
                        "example": "lmcneil@workday.net"
                    },
                    "primaryWorkPhone": {
                        "type": "string",
                        "title": "Primary Work Phone",
                        "example": "+1 (925) 951-9000"
                    },
                    "primarySupervisoryOrganization": {
                        "type": "object",
                        "title": "Primary Supervisory Organization",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Primary Supervisory Organization.ID",
                                "example": "0d2d6a1c8e5c4d6b9a6c5e8f2b1a3c4d"
                            },
                            "descriptor": {
                                "type": "string",
                                "title": "Primary Supervisory Organization.Name",
                                "example": "Human Resources"
                            },
                            "href": {
                                "type": "string",
                                "title": "Primary Supervisory Organization.URL",
                                "example": "https://wd2-impl-services1.workday.com/api/common/v1/acme/supervisoryOrganizations/0d2d6a1c8e5c4d6b9a6c5e8f2b1a3c4d"
                            }
                        }
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
