{
    "name": "appmixer.triggerdev.core.CancelRun",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Cancels a running task by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:triggerdev"
    },
    "quota": {
        "manager": "appmixer:triggerdev",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "runId": {
                        "type": "string"
                    }
                },
                "required": ["runId"]
            },
            "inspector": {
                "inputs": {
                    "runId": {
                        "type": "text",
                        "label": "Run ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the run to cancel"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
