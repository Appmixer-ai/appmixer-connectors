{
    "name": "appmixer.triggerdev.core.CreateBatchTrigger",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a batch trigger to run multiple tasks.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:triggerdev"
    },
    "quota": {
        "manager": "appmixer:triggerdev",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskIdentifier": {
                        "type": "string"
                    },
                    "items": {
                        "type": "string"
                    }
                },
                "required": ["taskIdentifier", "items"]
            },
            "inspector": {
                "inputs": {
                    "taskIdentifier": {
                        "type": "text",
                        "label": "Task Identifier",
                        "index": 1,
                        "tooltip": "The identifier of the task to trigger"
                    },
                    "items": {
                        "type": "textarea",
                        "label": "Items (JSON Array)",
                        "index": 2,
                        "tooltip": "JSON array of items to process. Each item will trigger the task with its data as payload."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Batch ID", "value": "id" },
                { "label": "Status", "value": "status" },
                { "label": "Created At", "value": "createdAt" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
