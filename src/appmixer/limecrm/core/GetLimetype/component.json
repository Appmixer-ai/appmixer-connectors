{
    "name": "appmixer.limecrm.core.GetLimetype",
    "label": "Get Limetype",
    "description": "Get a limetype of the Lime CRM data model with its properties (API name, type, local name, required flag and the keys of option properties). Use it to find the property names for Create Object, Update Object, Find Objects and queries.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limetype": {
                        "type": "string"
                    }
                },
                "required": [
                    "limetype"
                ]
            },
            "inspector": {
                "inputs": {
                    "limetype": {
                        "type": "text",
                        "label": "Limetype",
                        "index": 1,
                        "tooltip": "Pick a limetype or type its API name, e.g. <code>company</code>, <code>person</code> or <code>deal</code>.",
                        "source": {
                            "url": "/component/appmixer/limecrm/core/ListLimetypes?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLimetypes#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "company"
                    },
                    "label": {
                        "type": "string",
                        "title": "Label",
                        "example": "company"
                    },
                    "localNameSingular": {
                        "type": "string",
                        "title": "Local Name (Singular)",
                        "example": "Company"
                    },
                    "localNamePlural": {
                        "type": "string",
                        "title": "Local Name (Plural)",
                        "example": "Companies"
                    },
                    "properties": {
                        "type": "array",
                        "title": "Properties",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string"
                                },
                                "label": {
                                    "type": "string"
                                },
                                "required": {
                                    "type": "boolean"
                                },
                                "readonly": {
                                    "type": "boolean"
                                },
                                "options": {
                                    "type": "array"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "name",
                                "type": "string",
                                "label": "Company name",
                                "required": true,
                                "readonly": false,
                                "options": []
                            },
                            {
                                "name": "buyingstatus",
                                "type": "option",
                                "label": "Buying status",
                                "required": false,
                                "readonly": false,
                                "options": [
                                    {
                                        "key": "prospect",
                                        "text": "Prospect"
                                    },
                                    {
                                        "key": "active",
                                        "text": "Active"
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
