{
    "name": "appmixer.limecrm.core.GetFile",
    "label": "Get File",
    "description": "Get the metadata of a file (name, size, content type).",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limeFileId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "limeFileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "limeFileId": {
                        "type": "number",
                        "label": "File ID",
                        "index": 1,
                        "tooltip": "The ID of the file in Lime CRM, e.g. the value of a document's file property."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "File ID",
                        "example": 2001
                    },
                    "filename": {
                        "type": "string",
                        "title": "File Name",
                        "example": "offer.pdf"
                    },
                    "extension": {
                        "type": "string",
                        "title": "Extension",
                        "example": "pdf"
                    },
                    "size": {
                        "type": "integer",
                        "title": "Size",
                        "example": 48213
                    },
                    "content_type": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "application/pdf"
                    },
                    "last_modified": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Modified",
                        "example": "2026-11-16T09:30:00+01:00"
                    },
                    "locked_by": {
                        "type": "integer",
                        "title": "Locked By",
                        "example": 1002
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
