{
    "name": "appmixer.limecrm.core.DownloadFile",
    "label": "Download File",
    "description": "Download a file from Lime CRM and store it as a file for later steps of the flow.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limeFileId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "limeFileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "limeFileId": {
                        "type": "number",
                        "label": "File ID",
                        "index": 1,
                        "tooltip": "The ID of the file in Lime CRM, e.g. the value of a document's file property."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string",
                        "title": "File ID",
                        "example": "5f9b1c2e8a1d4e0012345678"
                    },
                    "fileName": {
                        "type": "string",
                        "title": "File Name",
                        "example": "offer.pdf"
                    },
                    "fileSize": {
                        "type": "integer",
                        "title": "File Size",
                        "example": 48213
                    },
                    "contentType": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "application/pdf"
                    },
                    "limeFileId": {
                        "type": "integer",
                        "title": "Lime File ID",
                        "example": 2001
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
