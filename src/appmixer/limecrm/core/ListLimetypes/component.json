{
    "name": "appmixer.limecrm.core.ListLimetypes",
    "label": "List Limetypes",
    "description": "Lists the limetypes the API user can see. Used as a source for the Limetype fields.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "title": "Limetypes",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "company"
                                },
                                "label": {
                                    "type": "string",
                                    "title": "Label",
                                    "example": "company"
                                },
                                "localNameSingular": {
                                    "type": "string",
                                    "title": "Local Name (Singular)",
                                    "example": "Company"
                                },
                                "localNamePlural": {
                                    "type": "string",
                                    "title": "Local Name (Plural)",
                                    "example": "Companies"
                                }
                            }
                        },
                        "example": [
                            {
                                "name": "company",
                                "label": "company",
                                "localNameSingular": "Company",
                                "localNamePlural": "Companies"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
