{
    "name": "appmixer.limecrm.core.GetObjectSchema",
    "label": "Get Object Schema",
    "description": "Builds the output variables of a limeobject port from the limetype's properties. Used by the output ports of the object components and triggers.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limetype": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    },
                    "variant": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "limetype": {
                        "type": "text",
                        "label": "Limetype",
                        "index": 1
                    },
                    "outputType": {
                        "type": "text",
                        "label": "Output Type",
                        "index": 2
                    },
                    "variant": {
                        "type": "text",
                        "label": "Variant",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
