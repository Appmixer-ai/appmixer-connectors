{
    "name": "appmixer.limecrm.core.UploadFile",
    "label": "Upload File",
    "description": "Upload a file to Lime CRM. To attach it to a document, set the document's file property to the returned File ID with Create Object or Update Object.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "filepicker",
                        "label": "File",
                        "index": 1,
                        "tooltip": "Select a file or map a file ID from a previous component."
                    },
                    "fileName": {
                        "type": "text",
                        "label": "File Name",
                        "index": 2,
                        "tooltip": "The name of the file in Lime CRM. Defaults to the name of the selected file."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "File ID",
                        "example": 2001
                    },
                    "filename": {
                        "type": "string",
                        "title": "File Name",
                        "example": "offer.pdf"
                    },
                    "extension": {
                        "type": "string",
                        "title": "Extension",
                        "example": "pdf"
                    },
                    "size": {
                        "type": "integer",
                        "title": "Size",
                        "example": 48213
                    },
                    "content_type": {
                        "type": "string",
                        "title": "Content Type",
                        "example": "application/pdf"
                    },
                    "last_modified": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Last Modified",
                        "example": "2026-11-16T09:30:00+01:00"
                    },
                    "locked_by": {
                        "type": "integer",
                        "title": "Locked By",
                        "example": 1002
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
