{
    "name": "appmixer.limecrm.core.DeleteFile",
    "label": "Delete File",
    "description": "Delete a file from Lime CRM. Deleting a document object does not delete its file.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limeFileId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "limeFileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "limeFileId": {
                        "type": "number",
                        "label": "File ID",
                        "index": 1,
                        "tooltip": "The ID of the file to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
