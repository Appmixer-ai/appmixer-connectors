{
    "name": "appmixer.limecrm.core.DeleteObject",
    "label": "Delete Object",
    "description": "Delete an object by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "limetype": {
                        "type": "string"
                    },
                    "objectId": {
                        "type": "integer"
                    }
                },
                "required": [
                    "limetype",
                    "objectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "limetype": {
                        "type": "text",
                        "label": "Limetype",
                        "index": 1,
                        "tooltip": "Pick a limetype or type its API name, e.g. <code>company</code>, <code>person</code> or <code>deal</code>.",
                        "source": {
                            "url": "/component/appmixer/limecrm/core/ListLimetypes?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLimetypes#toSelectArray"
                            }
                        }
                    },
                    "objectId": {
                        "type": "number",
                        "label": "Object ID",
                        "index": 2,
                        "tooltip": "The ID of the object to delete."
                    }
                }
            }
        }
    ],
    "outPorts": [
        "out"
    ],
    "icon": "data:image/svg+xml;base64,"
}
