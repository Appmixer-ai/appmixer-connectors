{
    "name": "appmixer.limecrm.core.NewObject",
    "label": "New Object",
    "description": "Triggers when an object of the selected limetype is created. Needs Lime Webhooks on the Lime CRM server (included in Lime CRM Cloud) and an API user that is an administrator or a member of the Webhook Users group.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:limecrm"
    },
    "quota": {
        "manager": "appmixer:limecrm",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "trigger": true,
    "webhook": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "limetype": {
                    "type": "string"
                }
            },
            "required": [
                "limetype"
            ]
        },
        "inspector": {
            "inputs": {
                "limetype": {
                    "type": "text",
                    "label": "Limetype",
                    "index": 1,
                    "tooltip": "Pick a limetype or type its API name, e.g. <code>company</code>, <code>person</code> or <code>deal</code>.",
                    "source": {
                        "url": "/component/appmixer/limecrm/core/ListLimetypes?outPort=out",
                        "data": {
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListLimetypes#toSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/limecrm/core/GetObjectSchema?outPort=out",
                "data": {
                    "messages": {
                        "in/limetype": "properties/limetype"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
