            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "profileId": {
                        "type": "string",
                        "description": "Filter by profile ID (partners/multi-profile)."
                    },
                    "testmode": {
                        "type": "boolean",
                        "description": "Set true to list test mode payments (if your key supports it)."
                    },
                    "status": {
                        "type": "string",
                        "description": "Filter by payment status.",
                        "enum": [
                            "open",
                            "pending",
                            "authorized",
                            "paid",
                            "canceled",
                            "expired",
                            "failed"
                        ]
                    },
                    "method": {
                        "type": "string",
                        "description": "Filter by payment method.",
                        "enum": [
                            "bancontact",
                            "banktransfer",
                            "belfius",
                            "creditcard",
                            "directdebit",
                            "eps",
                            "giftcard",
                            "giropay",
                            "ideal",
                            "kbc",
                            "klarnapaylater",
                            "klarnasliceit",
                            "mybank",
                            "paypal",
                            "paysafecard",
                            "przelewy24",
                            "sofort",
                            "trustly"
                        ]
                    },
                    "sequenceType": {
                        "type": "string",
                        "description": "Filter by sequence type.",
                        "enum": [
                            "oneoff",
                            "first",
                            "recurring"
                        ]
                    },
                    "customerId": {
                        "type": "string",
                        "description": "Filter payments created for a specific customer."
                    }
                }
            },
            "outputType": {
                "outputType": "array",
                "arrayPropertyValue": "_embedded.payments"
            }
        },
        {
            "title": "Create Payment Refund",
            "description": "Creates a refund for a specific payment. Critical for handling returns and customer service.",
            "type": "action",
            "documentation": "https://docs.mollie.com/reference/v2/refunds-api/create-refund",
            "endpointUrl": "https://api.mollie.com/v2/payments/{paymentId}/refunds",
            "apiBaseUrl": "https://api.mollie.com",
            "method": "POST",
            "sampleResponse": {
                "resource": "refund",
                "id": "re_4qqhO89gsT",
                "amount": {
                    "value": "5.00",
                    "currency": "EUR"
                },
                "status": "pending",
                "createdAt": "2023-06-25T10:12:00+00:00",
                "description": "Refund for Order #12345",
                "metadata": {
                    "reason": "Returned item"
                },
                "paymentId": "tr_7UhSN1zuXS",
                "_links": {
                    "self": {
                        "href": "https://api.mollie.com/v2/refunds/re_4qqhO89gsT",
                        "type": "application/hal+json"
                    },
                    "payment": {
                        "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                        "type": "application/hal+json"
                    }
                }
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "paymentId": {
                        "type": "string",
                        "description": "The ID of the original payment to refund (e.g., tr_7UhSN1zuXS)."
                    },
                    "amount": {
                        "type": "object",
                        "description": "Amount to refund. Omit to refund full amount.",
                        "properties": {
                            "currency": {
                                "type": "string",
                                "description": "ISO 4217 currency code of the refund amount."
                            },
                            "value": {
                                "type": "string",
                                "description": "Refund amount as a string with 2 decimals, e.g. \"5.00\"."
                            }
                        },
                        "required": []
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional description for the refund."
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Arbitrary data you can attach to the refund."
                    }
                },
                "required": [
                    "paymentId"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Create Customer",
