                            }
                        },
                        {
                            "resource": "payment",
                            "id": "tr_gj2x8VqS8M",
                            "amount": {
                                "value": "25.50",
                                "currency": "EUR"
                            },
                            "description": "Order #12346",
                            "status": "open",
                            "_links": {
                                "self": {
                                    "href": "https://api.mollie.com/v2/payments/tr_gj2x8VqS8M",
