{
    "actions": [
        {
            "title": "Create Payment",
            "description": "Creates a new payment with Mollie. This is the core functionality for processing payments.",
            "type": "action",
            "documentation": "https://docs.mollie.com/reference/v2/payments-api/create-payment",
            "endpointUrl": "https://api.mollie.com/v2/payments",
            "apiBaseUrl": "https://api.mollie.com",
            "method": "POST",
            "sampleResponse": {
                "resource": "payment",
                "id": "tr_7UhSN1zuXS",
                "mode": "test",
                "createdAt": "2023-06-25T09:44:37+00:00",
                "amount": {
                    "value": "10.00",
                    "currency": "EUR"
                },
                "description": "Order #12345",
                "method": "ideal",
                "status": "open",
                "isCancelable": false,
                "metadata": {
                    "orderId": "12345"
                },
                "locale": "nl_NL",
                "countryCode": "NL",
                "profileId": "pfl_3RkSN1zuWE",
                "sequenceType": "oneoff",
                "redirectUrl": "https://example.org/return",
                "webhookUrl": "https://example.org/webhook",
                "_links": {
                    "self": {
                        "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                        "type": "application/hal+json"
                    },
                    "checkout": {
                        "href": "https://www.mollie.com/payscreen/select-method/7UhSN1zuXS",
                        "type": "text/html"
                    }
                }
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "object",
                        "description": "The amount to charge the customer.",
                        "properties": {
                            "currency": {
                                "type": "string",
                                "description": "ISO 4217 currency code, e.g. EUR, USD."
                            },
                            "value": {
                                "type": "string",
                                "description": "Amount as a string with 2 decimals, e.g. \"10.00\"."
                            }
                        },
                        "required": [
                            "currency",
                            "value"
                        ]
                    },
                    "description": {
                        "type": "string",
                        "description": "A description of the payment. This will be shown to the consumer and on statements."
                    },
                    "redirectUrl": {
                        "type": "string",
                        "description": "The URL the customer will be redirected to after the payment process."
                    },
                    "webhookUrl": {
                        "type": "string",
                        "description": "Set the webhook URL where Mollie will send payment status updates."
                    },
                    "method": {
                        "type": "string",
                        "description": "Preferred payment method. If omitted, the customer can choose.",
                        "enum": [
                            "bancontact",
                            "banktransfer",
                            "belfius",
                            "creditcard",
                            "directdebit",
                            "eps",
                            "giftcard",
                            "giropay",
                            "ideal",
                            "kbc",
                            "klarnapaylater",
                            "klarnasliceit",
                            "mybank",
                            "paypal",
                            "paysafecard",
                            "przelewy24",
                            "sofort",
                            "trustly"
                        ]
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Arbitrary data you can attach to the payment (for your internal reference)."
                    },
                    "locale": {
                        "type": "string",
                        "description": "Locale to be used in the hosted payment pages, e.g. nl_NL, en_US."
                    },
                    "sequenceType": {
                        "type": "string",
                        "description": "Indicates the type of payment for recurring: oneoff, first or recurring.",
                        "enum": [
                            "oneoff",
                            "first",
                            "recurring"
                        ]
                    },
                    "customerId": {
                        "type": "string",
                        "description": "ID of the customer for which the payment is created (required for recurring)."
                    },
                    "mandateId": {
                        "type": "string",
                        "description": "ID of the mandate to use for recurring/direct debit payments."
                    },
                    "profileId": {
                        "type": "string",
                        "description": "Use this profile to create the payment (for partners/multi-profile setups)."
                    },
                    "applicationFee": {
                        "type": "object",
                        "description": "Application fee details for Mollie Connect apps.",
                        "properties": {
                            "amount": {
                                "type": "object",
                                "description": "Application fee amount to charge.",
                                "properties": {
                                    "currency": {
                                        "type": "string",
                                        "description": "Currency of the fee."
                                    },
                                    "value": {
                                        "type": "string",
                                        "description": "Fee amount as a string with 2 decimals."
                                    }
                                },
                                "required": [
                                    "currency",
                                    "value"
                                ]
                            },
                            "description": {
                                "type": "string",
                                "description": "Description for the application fee."
                            }
                        }
                    }
                },
                "required": [
                    "amount",
                    "description",
                    "redirectUrl"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "Get Payment",
            "description": "Retrieves a specific payment by its payment ID. Essential for checking payment status and details.",
            "type": "action",
            "documentation": "https://docs.mollie.com/reference/v2/payments-api/get-payment",
            "endpointUrl": "https://api.mollie.com/v2/payments/{paymentId}",
            "apiBaseUrl": "https://api.mollie.com",
            "method": "GET",
            "sampleResponse": {
                "resource": "payment",
                "id": "tr_7UhSN1zuXS",
                "mode": "test",
                "createdAt": "2023-06-25T09:44:37+00:00",
                "amount": {
                    "value": "10.00",
                    "currency": "EUR"
                },
                "description": "Order #12345",
                "method": "ideal",
                "status": "paid",
                "paidAt": "2023-06-25T09:46:12+00:00",
                "isCancelable": false,
                "metadata": {
                    "orderId": "12345"
                },
                "locale": "nl_NL",
                "countryCode": "NL",
                "profileId": "pfl_3RkSN1zuWE",
                "sequenceType": "oneoff",
                "redirectUrl": "https://example.org/return",
                "webhookUrl": "https://example.org/webhook",
                "_links": {
                    "self": {
                        "href": "https://api.mollie.com/v2/payments/tr_7UhSN1zuXS",
                        "type": "application/hal+json"
                    }
                }
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "paymentId": {
                        "type": "string",
                        "description": "The ID of the payment to retrieve (e.g., tr_7UhSN1zuXS)."
                    }
                },
                "required": [
                    "paymentId"
                ]
            },
            "outputType": {
                "outputType": "object"
            }
        },
        {
            "title": "List Payments",
            "description": "Retrieves all payments created with the current website profile. Supports internal pagination. Returns array inside _embedded.payments.",
            "type": "action",
