{
    "name": "appmixer.mollie.core.MakeAPICall",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Performs an arbitrary authorized API call. Provides flexibility for advanced integrations and accessing any Mollie API endpoint not covered by other components.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:mollie"
    },
    "quota": {
        "manager": "appmixer:mollie",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "method": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "headers": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "path",
                    "method"
                ]
            },
            "inspector": {
                "inputs": {
                    "method": {
                        "type": "select",
                        "tooltip": "HTTP method to use.",
                        "label": "Method",
                        "index": 0,
                        "options": [
                            {
                                "label": "GET",
                                "value": "GET"
                            },
                            {
                                "label": "POST",
                                "value": "POST"
                            },
                            {
                                "label": "PUT",
                                "value": "PUT"
                            },
                            {
                                "label": "PATCH",
                                "value": "PATCH"
                            },
                            {
                                "label": "DELETE",
                                "value": "DELETE"
                            }
                        ],
                        "defaultValue": "GET"
                    },
                    "path": {
                        "type": "text",
                        "index": 1,
                        "label": "API Endpoint Path",
                        "tooltip": "Enter the endpoint path (e.g. <code>/v2/payments</code>) or a full URL like <code>https://api.mollie.com/v2/payments?limit=5</code>."
                    },
                    "headers": {
                        "type": "text",
                        "tooltip": "Optional additional headers to send as a JSON object.",
                        "label": "Headers",
                        "index": 3
                    },
                    "parameters": {
                        "type": "textarea",
                        "index": 4,
                        "label": "Query Parameters",
                        "tooltip": "Optional query parameters as a JSON object (e.g. <code>{\"limit\": 10, \"offset\": 0}</code>)."
                    },
                    "body": {
                        "type": "textarea",
                        "tooltip": "Optional JSON request body (for POST/PUT/PATCH).",
                        "label": "Body",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status Code",
                    "value": "status"
                },
                {
                    "label": "Response Headers",
                    "value": "headers"
                },
                {
                    "label": "Response Body",
                    "value": "body",
                    "schema": {
                        "type": "object",
                        "properties": {}
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}