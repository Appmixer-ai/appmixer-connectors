                        "index": 0
                    },
                    "currency": {
                        "type": "text",
                        "tooltip": "Three-letter ISO currency code, e.g. EUR.",
                        "label": "Currency",
                        "index": 1
                    },
                    "description": {
                        "type": "text",
                        "tooltip": "A description shown to the customer.",
                        "label": "Description",
                        "index": 2
                    },
