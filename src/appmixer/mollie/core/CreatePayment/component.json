                        "tooltip": "Sequence type: oneoff, first, recurring.",
                        "label": "Sequence Type",
                        "index": 8
                    },
                    "customerId": {
                        "type": "text",
                        "tooltip": "Customer ID for customer-specific payments (cst_...).",
                        "label": "Customer ID",
                        "index": 9
                    },
                    "mandateId": {
                        "type": "text",
                        "tooltip": "Mandate ID for recurring payments (mdt_...).",
                        "label": "Mandate ID",
                        "index": 10
                    },
                    "testmode": {
                        "type": "toggle",
                        "tooltip": "Set to true to target test data.",
                        "label": "Test Mode",
                        "index": 11
                    }
