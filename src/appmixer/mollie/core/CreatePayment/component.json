                        "index": 5
                    },
                    "metadata": {
                        "type": "text",
                        "tooltip": "Custom metadata (JSON object).",
                        "label": "Metadata",
                        "index": 6
                    },
                    "locale": {
                        "type": "text",
                        "tooltip": "Locale, e.g. nl_NL, en_US.",
                        "label": "Locale",
                        "index": 7
                    },
                    "sequenceType": {
