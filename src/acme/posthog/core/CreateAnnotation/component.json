{
    "name": "acme.posthog.core.CreateAnnotation",
    "description": "Create an annotation in a PostHog project. Annotations mark important moments (releases, campaigns) on analytics charts.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "acme:posthog"
    },
    "quota": {
        "manager": "acme:posthog",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "dateMarker": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "scope": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId",
                    "content"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "label": "Project",
                        "tooltip": "Pick a project, or type the numeric Project ID directly.",
                        "source": {
                            "url": "/component/acme/posthog/core/ListProjects?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListProjects#toSelectArray"
                            }
                        }
                    },
                    "content": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Content",
                        "tooltip": "Text of the annotation, e.g. 'Released v2.3.0'."
                    },
                    "dateMarker": {
                        "type": "date-time",
                        "index": 3,
                        "label": "Date Marker",
                        "tooltip": "Date and time the annotation refers to. Defaults to now."
                    },
                    "scope": {
                        "type": "select",
                        "index": 4,
                        "label": "Scope",
                        "defaultValue": "project",
                        "tooltip": "Whether the annotation is visible in the project or across the whole organization.",
                        "options": [
                            {
                                "label": "Project",
                                "value": "project"
                            },
                            {
                                "label": "Organization",
                                "value": "organization"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Annotation ID",
                        "example": 789
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "Released v2.3.0"
                    },
                    "date_marker": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Date Marker",
                        "example": "2025-01-15T10:30:00Z"
                    },
                    "scope": {
                        "type": "string",
                        "title": "Scope",
                        "example": "project"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2025-01-15T10:30:00Z"
                    }
                }
            }
        }
    ]
}
