{
    "name": "acme.posthog.core.NewActionEvent",
    "description": "Triggers when PostHog delivers a matched event to this component's webhook URL. Setup: start the flow, copy the webhook URL from the flow log, then in PostHog create a realtime destination (Data pipelines → Destinations → HTTP Webhook) pointing to that URL, optionally filtered by an action.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "webhook": true,
    "auth": {
        "service": "acme:posthog"
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "event": {
                        "type": "string",
                        "title": "Event Name",
                        "example": "$pageview"
                    },
                    "distinct_id": {
                        "type": "string",
                        "title": "Distinct ID",
                        "example": "user-42"
                    },
                    "uuid": {
                        "type": "string",
                        "title": "Event UUID",
                        "example": "018e3b3c-7c3e-0000-8a2a-56d9b1a2c3d4"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Timestamp",
                        "example": "2025-01-15T10:30:00Z"
                    },
                    "properties": {
                        "type": "object",
                        "title": "Event Properties",
                        "example": {
                            "$current_url": "https://example.com/pricing"
                        }
                    },
                    "person": {
                        "type": "object",
                        "title": "Person",
                        "example": {
                            "id": "018e3b3c-7c3e-0000-8a2a-56d9b1a2c3d4",
                            "properties": {
                                "email": "jane@example.com"
                            }
                        }
                    }
                }
            }
        }
    ]
}
