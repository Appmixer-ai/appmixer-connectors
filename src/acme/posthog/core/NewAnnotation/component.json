{
    "name": "acme.posthog.core.NewAnnotation",
    "description": "Triggers when a new annotation is created in a PostHog project.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "trigger": true,
    "tick": true,
    "auth": {
        "service": "acme:posthog"
    },
    "quota": {
        "manager": "acme:posthog",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string"
                }
            },
            "required": [
                "projectId"
            ]
        },
        "inspector": {
            "inputs": {
                "projectId": {
                    "type": "text",
                    "index": 1,
                    "label": "Project",
                    "tooltip": "Pick a project, or type the numeric Project ID directly.",
                    "source": {
                        "url": "/component/acme/posthog/core/ListProjects?outPort=out",
                        "data": {
                            "properties": {
                                "isSource": true
                            },
                            "transform": "./ListProjects#toSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Annotation ID",
                        "example": 789
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "Released v2.3.0"
                    },
                    "date_marker": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Date Marker",
                        "example": "2025-01-15T10:30:00Z"
                    },
                    "scope": {
                        "type": "string",
                        "title": "Scope",
                        "example": "project"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At",
                        "example": "2025-01-15T10:30:00Z"
                    }
                }
            }
        }
    ]
}
