{
  "name": "linear-connector-tests",
  "version": "1.0.0",
  "description": "Test suite for Linear Appmixer connector with OAuth2 authentication",
  "scripts": {
    "test": "mocha *.test.js --timeout 30000 --recursive",
    "test:issues": "mocha *Issue*.test.js --timeout 30000",
    "test:comments": "mocha *Comment*.test.js --timeout 30000",
    "test:graphql": "mocha ExecuteGraphQLQuery.test.js --timeout 30000",
    "test:find": "mocha Find*.test.js --timeout 30000",
    "test:crud": "mocha Create*.test.js Get*.test.js Update*.test.js Delete*.test.js --timeout 30000",
    "test:safe": "mocha --grep 'should (find|get|create)' --timeout 30000",
    "test:destructive": "LINEAR_ENABLE_DESTRUCTIVE_TESTS=true mocha Delete*.test.js --timeout 30000",
    "test:verbose": "mocha *.test.js --timeout 30000 --reporter spec",
    "test:watch": "mocha *.test.js --timeout 30000 --watch"
  },
  "keywords": [
    "linear",
    "appmixer",
    "oauth2",
    "graphql",
    "connector",
    "test"
  ],
  "author": "Appmixer",
  "license": "MIT",
  "devDependencies": {
    "mocha": "^10.0.0",
    "axios": "^1.0.0",
    "dotenv": "^16.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
